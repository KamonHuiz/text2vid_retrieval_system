# Copy thành .env rồi `source .env` trước khi chạy scripts/ingest_*.py hoặc uvicorn.
# Đường dẫn dưới đây giả định layout chuẩn:
#   MAIN/
#     UTOTS_SYSTEM/   <- bạn đang ở đây
#     keyframes/
#     model_package/package_4models_export/
export UTOTS_KEYFRAME_ROOT=$(realpath ../keyframes)
export UTOTS_MODEL_PACKAGE=$(realpath ../model_package/package_4models_export)
export UTOTS_QDRANT_URL=http://localhost:6335
export UTOTS_TYPESENSE_URL=http://localhost:8109
export UTOTS_TYPESENSE_KEY=utots-local-key
export UTOTS_DEVICES=cuda:0,cuda:1
