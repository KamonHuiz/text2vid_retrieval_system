        "000192.webp",
        "000229.webp",
        "000230.webp",
        "000292.webp",
        "000355.webp",
        "000356.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Một năm vừa qua tôi đã phải hái lộc vàng cho người dân rồi mà vẫn không đủ.",
      "start": 14.24,
      "end": 22.84,
      "n_words": 18,
      "start_frame": 356,
      "end_frame": 571,
      "keyframes": [
        "000356.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Năm mới sắp đến, không biết tôi lấy lộc vàng đâu để đi lì xì chúc Tết cho mọi người đây? Tôi có cách giúp ông, lên núi tìm sơn hải lộc theo Thổ Địa nè.",
      "start": 22.84,
      "end": 43.8,
      "n_words": 36,
      "start_frame": 571,
      "end_frame": 1095,
      "keyframes": [
        "000735.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hô biến!",
      "start": 43.8,
      "end": 48.4,
      "n_words": 2,
      "start_frame": 1095,
      "end_frame": 1210,
      "keyframes": [
        "001115.webp",
        "001116.webp"
      ],
      "keyframe_count": 2
    },
