  "sentences": [
    {
      "text": "Thần Tài, Thần Tài, năm nay Canh Thìn chắc nhộn nhịp vậy ha.",
      "start": 4.44,
      "end": 14.24,
      "n_words": 13,
      "start_frame": 111,
      "end_frame": 356,
      "keyframes": [
        "000155.webp",
