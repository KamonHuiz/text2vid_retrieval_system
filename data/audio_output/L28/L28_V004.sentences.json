      "keyframes": [
        "021839.webp",
        "021840.webp",
        "021981.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Có hai cù lao là cù lao Ông Chưởng và cù lao Diên.",
      "start": 879.44,
      "end": 884.96,
      "n_words": 13,
      "start_frame": 21986,
      "end_frame": 22124,
      "keyframes": [
        "022123.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cù lao Diên nằm giữa sông Tiền có chiều dài 12 km và chiều rộng 7 km.",
