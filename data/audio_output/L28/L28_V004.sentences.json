        "003844.webp",
        "003920.webp",
        "003996.webp",
        "003997.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nói tới cù lao Ông Trưởng có nhiều cá tôm.",
      "start": 161.4,
      "end": 167.12,
      "n_words": 10,
      "start_frame": 4035,
      "end_frame": 4178,
      "keyframes": [
        "004049.webp",
        "004102.webp",
        "004103.webp",
        "004135.webp",
        "004168.webp",
        "004169.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đó là câu chuyện của đất cù lao Ông Trưởng.",
      "start": 167.12,
      "end": 169.96,
      "n_words": 10,
      "start_frame": 4178,
      "end_frame": 4249,
      "keyframes": [
        "004226.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Từ nhiều năm trước, thiên nhiên hào phóng ban tặng con người muôn sản vật phong phú.",
      "start": 169.96,
      "end": 176.88,
      "n_words": 17,
      "start_frame": 4249,
      "end_frame": 4422,
      "keyframes": [
        "004283.webp",
        "004284.webp",
        "004343.webp",
        "004402.webp",
        "004403.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tuy nhiên trước sự tận diệt của con người, sự hào phóng nào cũng có giới hạn, cá tôm dần vắng trên sông.",
      "start": 176.88,
      "end": 185.68,
      "n_words": 23,
      "start_frame": 4422,
      "end_frame": 4642,
      "keyframes": [
        "004447.webp",
        "004491.webp",
        "004516.webp",
        "004577.webp",
        "004639.webp",
        "004640.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Giữa những dòng trăn trở đau đáu với nỗi đau của thiên nhiên thời cuộc, dọc theo chuyến thủy trình, chúng tôi cảm thấy may mắn vì gặp được những con người rất đặc biệt.",
      "start": 185.68,
      "end": 203.6,
      "n_words": 35,
      "start_frame": 4642,
      "end_frame": 5090,
      "keyframes": [
        "004714.webp",
        "004788.webp",
        "004813.webp",
        "004848.webp",
        "004884.webp",
        "004885.webp",
        "004923.webp",
        "004961.webp",
        "004962.webp",
        "005022.webp",
        "005082.webp",
        "005083.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Bến cá này nằm ngay cửa sông Vòng Nao nhìn ra sông Tiền bên bờ Kiến An huyện Chợ Mới.",
      "start": 203.6,
      "end": 211.6,
      "n_words": 20,
      "start_frame": 5090,
      "end_frame": 5290,
      "keyframes": [
        "005175.webp",
        "005267.webp",
        "005268.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng tôi gọi là bến cá vì với chúng tôi, bến không chỉ là nơi neo đậu còn là điểm dừng trạm đầu và trạm cuối của một hành trình, là nơi bao hàm cả sự bình yên, an toàn và có thể nương tựa, như cái cách mà đàn cá thiên nhiên nơi đây có duyên gắn bó.",
      "start": 211.6,
      "end": 233.0,
      "n_words": 59,
      "start_frame": 5290,
      "end_frame": 5825,
      "keyframes": [
        "005305.webp",
        "005343.webp",
        "005344.webp",
        "005390.webp",
        "005437.webp",
        "005438.webp",
        "005491.webp",
        "005544.webp",
        "005545.webp",
        "005729.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Gắn bó với bến sông này từ 4 năm trước, từ khi lão nông Nguyễn Văn Út đã quyết định cưỡng mang đàn cá thiên nhiên, xem chúng như những đứa con cưng của mình.",
      "start": 233.0,
      "end": 252.6,
      "n_words": 35,
      "start_frame": 5825,
      "end_frame": 6315,
      "keyframes": [
        "005914.webp",
        "005915.webp",
        "006019.webp",
        "006124.webp",
        "006125.webp",
        "006246.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nè, chỗ thả cá nhiều lắm, cá bắt thiệt quá đi\".",
      "start": 252.84,
      "end": 263.16,
      "n_words": 11,
      "start_frame": 6321,
      "end_frame": 6579,
      "keyframes": [
        "006367.webp",
        "006368.webp",
        "006462.webp",
        "006556.webp",
        "006557.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Với ông Ba thì nói: \"Thôi cá ở đây con nuôi cho đẹp\".",
      "start": 263.16,
      "end": 272.92,
      "n_words": 13,
      "start_frame": 6579,
      "end_frame": 6823,
      "keyframes": [
        "006599.webp",
        "006641.webp",
        "006642.webp",
        "006741.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Từ nửa tháng sau, cá chim với cá kèo về giao đất này, đàn cá cứ kéo nhau tìm về như một nơi trú ngụ an toàn và yêu thương nhất.",
      "start": 272.92,
      "end": 290.92,
      "n_words": 31,
      "start_frame": 6823,
      "end_frame": 7273,
      "keyframes": [
        "006840.webp",
        "006841.webp",
        "006897.webp",
        "006953.webp",
        "006954.webp",
        "007054.webp",
        "007154.webp",
        "007155.webp",
        "007196.webp",
        "007238.webp",
        "007239.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Mặc cho ngoài kia, ngay dòng nước sau lưng người ta vẫn đang nhắc hoài về việc nguồn cá thiên nhiên ngày càng cạn kiệt, đau đáu về chuyện thiên biến vạn hóa.",
      "start": 290.92,
      "end": 300.96,
      "n_words": 33,
      "start_frame": 7273,
      "end_frame": 7524,
      "keyframes": [
        "007287.webp",
        "007336.webp",
        "007337.webp",
        "007395.webp",
        "007454.webp",
        "007455.webp",
        "007523.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Của ông đông đến mức chỉ có thể tính bằng tấn với hàng chục loại từ cá tra, cá trê, cá lóc, cá he, cá rô, đến giờ ăn cá chim chúc nhau rộn ràng cả một khoảng sông.",
      "start": 305.0,
      "end": 319.28,
      "n_words": 39,
      "start_frame": 7625,
      "end_frame": 7982,
      "keyframes": [
        "007677.webp",
