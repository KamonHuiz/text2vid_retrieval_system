        "003100.webp",
        "003140.webp",
        "003181.webp",
        "003182.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trên chặng đường rong ruổi, nếu gặp phải vùng đất cứng khó soi phá, có khi sông ngoặt sang hướng khác, cũng có khi sông rẽ thành hai dòng chảy cặp theo hai bên để rồi sau đó nhập lại.",
      "start": 127.44,
      "end": 142.72,
      "n_words": 40,
      "start_frame": 3186,
      "end_frame": 3568,
      "keyframes": [
        "003228.webp",
