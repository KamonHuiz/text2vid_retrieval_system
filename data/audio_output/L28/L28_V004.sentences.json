        "002843.webp",
        "002948.webp",
        "002973.webp"
      ],
      "keyframe_count": 20
    },
    {
      "text": "Cả sông Tiền và sông Hậu đều tự theo đuổi hành trình riêng của mình, mỗi nhánh sông tự tìm lối riêng cho dòng nước.",
      "start": 119.92,
      "end": 127.44,
      "n_words": 25,
      "start_frame": 2998,
      "end_frame": 3186,
      "keyframes": [
        "003036.webp",
