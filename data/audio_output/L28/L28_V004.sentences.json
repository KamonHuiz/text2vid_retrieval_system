        "010341.webp",
        "010382.webp",
        "010383.webp",
        "010455.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Phải chăng đó cũng là một cách mà họ muốn trả nợ cho đời, cho sông?",
      "start": 420.96,
      "end": 428.08,
      "n_words": 16,
