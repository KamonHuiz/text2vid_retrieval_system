        "003461.webp",
        "003559.webp",
        "003560.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Vùng đất ấy trở thành những bãi bồi cù lao, để rồi từ đó những lớp phù sa cứ cần mẫn đắp bồi cho nơi này đồng bãi tốt tươi, nét xanh bờ rau, ruộng lúa ba phen quả.",
      "start": 142.72,
      "end": 161.4,
      "n_words": 39,
      "start_frame": 3568,
      "end_frame": 4035,
      "keyframes": [
        "003654.webp",
