        "007927.webp",
        "007972.webp",
        "007973.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đó là chưa kể những loại cá khủng như chim trắng ước tính trên 15 kg, các loại cá dài trên 1 mét.",
      "start": 319.28,
      "end": 343.96,
      "n_words": 23,
      "start_frame": 7982,
      "end_frame": 8599,
      "keyframes": [
        "008049.webp",
        "008125.webp",
        "008126.webp",
        "008190.webp",
        "008254.webp",
        "008255.webp",
        "008320.webp",
        "008386.webp",
        "008387.webp",
        "008480.webp",
        "008574.webp",
        "008575.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Rất nhiều người cho rằng ông Út là người gàn dở, là người làm chuyện bao đồng khi bỏ thời gian, tiền bạc và sức khỏe chỉ vì những chú cá từ khắp nơi tìm về.",
      "start": 343.96,
      "end": 355.72,
      "n_words": 36,
      "start_frame": 8599,
      "end_frame": 8893,
      "keyframes": [
        "008617.webp",
        "008659.webp",
        "008660.webp",
        "008776.webp",
        "008892.webp",
        "008893.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ông vẫn cười hề cho qua, vẫn cặm cụi chở hàng chục tấn thức ăn mỗi ngày, vốn bỏ hàng chục triệu đồng làm kè bảo vệ, mua món này sắm món kia phục vụ quá trình chăm sóc cá.",
      "start": 355.72,
      "end": 369.96,
      "n_words": 40,
      "start_frame": 8893,
      "end_frame": 9249,
      "keyframes": [
        "008893.webp",
        "008920.webp",
        "008947.webp",
        "008948.webp",
        "008989.webp",
        "009030.webp",
        "009031.webp",
        "009084.webp",
        "009138.webp",
        "009139.webp",
        "009227.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "\"Mình thấy người ta sát hại sinh vật thì mình thương, giờ mình muốn bảo tồn cho nó để nó sống ở đây, sống được ngày nào đỡ ngày nấy.",
      "start": 369.96,
      "end": 379.28,
      "n_words": 30,
      "start_frame": 9249,
      "end_frame": 9482,
      "keyframes": [
        "009316.webp",
        "009317.webp",
        "009445.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chú nguyện hết cuộc đời này chú lo cho đàn cá, nếu mà sau này chú lỡ theo Phật thì con cháu nó làm tiếp được.",
      "start": 379.28,
      "end": 389.12,
      "n_words": 26,
      "start_frame": 9482,
      "end_frame": 9728,
      "keyframes": [
        "009573.webp",
        "009574.webp",
        "009662.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Là nói ai có khả năng lại đây bảo quản cá này thì chú giao lại hết\".",
      "start": 389.12,
      "end": 395.88,
      "n_words": 17,
      "start_frame": 9728,
      "end_frame": 9897,
      "keyframes": [
        "009751.webp",
        "009752.webp",
        "009804.webp",
        "009857.webp",
        "009858.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ở miền sông nước này, những câu chuyện chí hiệp mang đậm những giá trị nhân văn như thế cũng không phải là hiếm.",
      "start": 395.88,
      "end": 403.4,
      "n_words": 24,
      "start_frame": 9897,
      "end_frame": 10085,
      "keyframes": [
        "009914.webp",
        "009970.webp",
        "009971.webp",
        "010028.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Người ta nói đi dọc theo sông Tiền, sông Hậu hay sông Phàm Đao, Phàm Đao vẫn có thể thỉnh thoảng bắt gặp những bến cá như thế này, những con người bằng chút sức lực nhỏ nhoi của mình muốn dang tay ôm lấy cá tôm, xoa dịu nỗi đau của thiên nhiên.",
      "start": 403.4,
      "end": 420.96,
      "n_words": 54,
      "start_frame": 10085,
      "end_frame": 10524,
      "keyframes": [
        "010086.webp",
        "010087.webp",
        "010111.webp",
        "010136.webp",
