        "024395.webp",
        "024434.webp",
        "024435.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nếu ngày xưa có tao đàn Chiêu Anh Các thì ngày sau có thi sĩ Đông Hồ và nữ sĩ Mộng Tuyết, đều là những người con ưu tú của vùng đất Hà Tiên.",
      "start": 978.48,
      "end": 987.04,
      "n_words": 34,
      "start_frame": 24462,
      "end_frame": 24676,
      "keyframes": [
        "024473.webp",
