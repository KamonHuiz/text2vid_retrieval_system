        "002492.webp",
        "002578.webp",
        "002664.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Mà đối với người Hà Tiên, dòng sông còn là người bạn hiền hòa chứng kiến biết bao đổi thay của vùng đất này.",
      "start": 107.2,
      "end": 115.6,
      "n_words": 24,
      "start_frame": 2680,
      "end_frame": 2890,
      "keyframes": [
        "002689.webp",
        "002730.webp",
        "002771.webp",
        "002794.webp",
        "002823.webp",
        "002852.webp",
        "002877.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Sông Giang Thành chịu ảnh hưởng của dòng thủy lưu ven bờ Vịnh Thái Lan cộng hưởng với sự thay đổi địa chất đã tạo nên những đầm nước mặn.",
      "start": 115.6,
      "end": 125.28,
      "n_words": 30,
      "start_frame": 2890,
      "end_frame": 3132,
      "keyframes": [
        "003000.webp",
        "003123.webp",
        "003124.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Xưa kia, vùng đất Hà Tiên có nhiều đầm mặn như Đông Hồ.",
      "start": 125.28,
      "end": 129.24,
      "n_words": 13,
      "start_frame": 3132,
      "end_frame": 3231,
      "keyframes": [
        "003181.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ngày nay, một số nhà khoa học nghiên cứu quá trình biển thoái đã cho rằng đầm nước mặn ở Hà Tiên đã hình thành từ xưa, sớm hơn thời kỳ dòng sông Mê Công chia thành hai nhánh sông Tiền và sông Hậu, nghĩa là đầm nước mặn ở Hà Tiên thuộc thời kỳ 6.000 năm trước.",
      "start": 129.24,
      "end": 147.12,
      "n_words": 58,
      "start_frame": 3231,
      "end_frame": 3678,
      "keyframes": [
        "003239.webp",
        "003264.webp",
        "003345.webp",
        "003427.webp",
        "003452.webp",
        "003501.webp",
        "003550.webp",
        "003575.webp",
        "003620.webp",
        "003666.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Trải qua những biến thiên của hiện tượng địa chất theo từng thời kỳ cho đến ngày nay, Hà Tiên vẫn còn hiện hữu một đầm nước mặn Đông Hồ.",
      "start": 147.12,
      "end": 161.04,
      "n_words": 30,
      "start_frame": 3678,
      "end_frame": 4026,
      "keyframes": [
        "003691.webp",
        "003840.webp",
        "003989.webp",
        "003990.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thời xưa, thuyền từ các nước về Hà Tiên đều neo đậu trong đầm Đông Hồ.",
      "start": 161.04,
      "end": 166.64,
      "n_words": 16,
      "start_frame": 4026,
      "end_frame": 4166,
      "keyframes": [
        "004077.webp",
        "004164.webp",
        "004165.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Do vậy, Mạc Cửu đã mở kênh mương đào và rạch ụ bên cạnh đầm Đông Hồ để tạo điều kiện thuận lợi cho các tàu thuyền đưa hàng hóa lên bến.",
      "start": 166.64,
      "end": 176.72,
      "n_words": 32,
      "start_frame": 4166,
      "end_frame": 4418,
      "keyframes": [
        "004174.webp",
        "004184.webp",
        "004185.webp",
        "004245.webp",
        "004306.webp",
        "004307.webp",
        "004359.webp",
        "004411.webp",
        "004412.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Điều đó cho thấy từ hàng trăm năm trước, đầm Đông Hồ đã đóng một vai trò quan trọng trong nền kinh tế bản địa.",
      "start": 176.72,
      "end": 186.72,
      "n_words": 25,
      "start_frame": 4418,
      "end_frame": 4668,
      "keyframes": [
        "004506.webp",
        "004601.webp",
        "004626.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hằng năm, dòng nước từ kinh Vĩnh Tế và sông Giang Thành đổ ra đầm Đông Hồ đều mang theo một khối phù sa rất lớn.",
      "start": 186.72,
      "end": 194.8,
      "n_words": 26,
      "start_frame": 4668,
      "end_frame": 4870,
      "keyframes": [
        "004707.webp",
        "004789.webp",
        "004815.webp",
        "004864.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khi phù sa ra khỏi vàm sông gặp nước mặn sẽ lắng tụ tạo thành cồn cát.",
      "start": 194.8,
      "end": 200.92,
      "n_words": 17,
      "start_frame": 4870,
      "end_frame": 5023,
      "keyframes": [
        "004913.webp",
        "004938.webp",
        "005017.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trải qua thời gian, cồn cát ngày càng dâng cao, cây cối mọc lên và trở thành cù lao tách biệt giữa đầm, hay còn được gọi là Cừ Đức.",
      "start": 200.92,
      "end": 212.2,
      "n_words": 30,
      "start_frame": 5023,
      "end_frame": 5305,
      "keyframes": [
        "005097.webp",
        "005098.webp",
        "005145.webp",
        "005192.webp",
        "005193.webp",
        "005236.webp",
        "005279.webp",
        "005296.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Khi dân cư tụ họp về đây sinh sống, ấp Cừ Đức từ đó cũng được hình thành.",
      "start": 212.2,
      "end": 251.44,
      "n_words": 18,
      "start_frame": 5305,
      "end_frame": 6286,
      "keyframes": [
        "005332.webp",
        "005369.webp",
        "005370.webp",
        "005420.webp",
        "005471.webp",
        "005472.webp",
        "005525.webp",
        "005578.webp",
        "005579.webp",
        "005622.webp",
        "005666.webp",
        "005667.webp",
        "005695.webp",
        "005724.webp",
        "005725.webp",
        "005752.webp",
        "005780.webp",
        "005781.webp",
        "005863.webp",
        "005945.webp",
        "005946.webp",
        "006097.webp",
        "006248.webp",
        "006249.webp"
      ],
      "keyframe_count": 24
    },
    {
      "text": "Ở ấp Cừ Đức, mọc men theo dải cồn cát là cánh rừng dừa nước xanh bát ngát đã tô điểm cho cảnh quan thiên nhiên của đầm Đông Hồ thêm nên thơ hữu tình.",
      "start": 251.44,
      "end": 269.08,
      "n_words": 35,
      "start_frame": 6286,
      "end_frame": 6727,
      "keyframes": [
        "006334.webp",
        "006420.webp",
        "006421.webp",
        "006513.webp",
        "006605.webp",
        "006606.webp",
        "006664.webp",
        "006723.webp",
        "006724.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hiện nay, diện tích dừa nước mọc hoang và được trồng mới tại đầm Đông Hồ chiếm khoảng gần 400 ha.",
      "start": 269.08,
      "end": 275.44,
      "n_words": 21,
      "start_frame": 6727,
      "end_frame": 6886,
      "keyframes": [
        "006807.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dừa nước đóng vai trò chủ đạo trong việc cân bằng giữ gìn hệ sinh thái, là vùng lá chắn phòng hộ và hạn chế xâm nhập mặn, không chỉ tạo nguồn lợi thủy sản mà còn là kế mưu sinh cho bà con nơi đây.",
      "start": 276.24,
      "end": 300.24,
      "n_words": 46,
      "start_frame": 6906,
      "end_frame": 7506,
      "keyframes": [
        "006915.webp",
        "006968.webp",
        "007021.webp",
        "007022.webp",
        "007065.webp",
        "007109.webp",
        "007110.webp",
        "007166.webp",
        "007222.webp",
        "007223.webp",
        "007372.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Dừa nước có sức sống bền bỉ, sinh trưởng nhanh nên nguồn nguyên liệu cho nghề trồng lá rất dồi dào, công việc đốn lá cũng có thu nhập đều đặn quanh năm.",
      "start": 300.24,
      "end": 315.76,
      "n_words": 33,
      "start_frame": 7506,
      "end_frame": 7894,
      "keyframes": [
        "007522.webp",
        "007523.webp",
        "007548.webp",
        "007574.webp",
        "007575.webp",
        "007617.webp",
        "007660.webp",
        "007661.webp",
        "007705.webp",
        "007750.webp",
        "007751.webp",
        "007786.webp",
        "007821.webp",
        "007822.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "- Trung bình thì cái cây dừa nước này mình trồng khoảng mấy tháng mình mới thu hoạch được? - Anh, nó tới 6 năm lận.",
      "start": 315.76,
      "end": 323.72,
      "n_words": 26,
      "start_frame": 7894,
      "end_frame": 8093,
      "keyframes": [
        "007914.webp",
        "008006.webp",
        "008007.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "6 năm rồi 6 năm nó mới thu hoạch được.",
      "start": 323.72,
      "end": 328.04,
      "n_words": 10,
      "start_frame": 8093,
      "end_frame": 8201,
      "keyframes": [
        "008096.webp",
        "008186.webp",
        "008187.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì cái lá nó chọn cái lá nó như thế nào để mà mình thu hoạch?",
      "start": 328.04,
      "end": 334.24,
      "n_words": 16,
      "start_frame": 8201,
      "end_frame": 8356,
      "keyframes": [
        "008233.webp",
        "008279.webp",
        "008280.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chứ mình muốn lá tốt thì như nó không có te như vậy nè, nó không có te là lá nó tốt.",
      "start": 334.24,
      "end": 342.2,
      "n_words": 22,
      "start_frame": 8356,
      "end_frame": 8555,
      "keyframes": [
        "008518.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Lá mà nó te á là lá dở lắm, nó mau dột.",
      "start": 342.2,
      "end": 350.96,
      "n_words": 12,
      "start_frame": 8555,
      "end_frame": 8774,
      "keyframes": [
        "008756.webp",
        "008757.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trong ngày thì mình chặt về nước vậy giờ 7:00 mới đi đốn lá, 7:00 đốn nó 11:00 vậy đó.",
      "start": 350.96,
      "end": 358.32,
      "n_words": 20,
      "start_frame": 8774,
      "end_frame": 8958,
      "keyframes": [
        "008893.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đổ về nó xé tới 23:00 rồi đi. Mình khoảng cỡ mấy chuyến?",
      "start": 358.32,
      "end": 364.72,
      "n_words": 13,
      "start_frame": 8958,
      "end_frame": 9118,
      "keyframes": [
        "009030.webp",
        "009031.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Hai chuyến, chuyến mình được cỡ như tàu vậy, 300 tàu có 350, có lá bự lá nhỏ.",
      "start": 364.72,
      "end": 373.76,
      "n_words": 19,
      "start_frame": 9118,
      "end_frame": 9344,
      "keyframes": [
        "009126.webp",
        "009221.webp",
        "009222.webp",
        "009311.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "- Ủa anh làm chỉ có mình ngoài cái lợp lá mình có phân loại ra không? - Anh có, nó tới hai loại lợp.",
      "start": 373.76,
      "end": 387.2,
      "n_words": 25,
      "start_frame": 9344,
      "end_frame": 9680,
      "keyframes": [
        "009401.webp",
        "009402.webp",
        "009485.webp",
        "009568.webp",
        "009569.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Là chặt về vậy nè, cái mình xé mình bó lại là cái đó là kêu một lá tàu.",
      "start": 387.2,
      "end": 392.8,
      "n_words": 19,
      "start_frame": 9680,
      "end_frame": 9820,
      "keyframes": [
        "009738.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Còn lá mà mình chặt về nguyên tàu vậy nè, cái mình đổ ra, đổ ra mình trầm đó kêu bằng lá trầm đó.",
      "start": 392.8,
      "end": 400.84,
      "n_words": 24,
      "start_frame": 9820,
      "end_frame": 10021,
      "keyframes": [
        "009908.webp",
        "009909.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thì cái lá nào nó cái lợi nhuận nó cao hơn? - Mình làm nó khỏe hơn em, cái lá này nó khỏe hơn.",
      "start": 400.84,
      "end": 407.96,
      "n_words": 24,
      "start_frame": 10021,
      "end_frame": 10199,
      "keyframes": [
        "010066.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Lá trầm lợi nhuận khá không anh hay là sao?",
      "start": 407.96,
      "end": 411.96,
      "n_words": 10,
      "start_frame": 10199,
      "end_frame": 10299,
      "keyframes": [
        "010224.webp",
        "010225.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Nó dư nó không dư thiếu, nó thiếu như đủ ăn đủ xài, nó đỡ hơn đi làm mướn người ta. - Chỗ thị trường tiêu thụ bây giờ là mình ở Hà Tiên hay là các tỉnh khác?",
      "start": 411.96,
      "end": 423.6,
      "n_words": 40,
      "start_frame": 10299,
      "end_frame": 10590,
      "keyframes": [
        "010333.webp",
        "010442.webp",
        "010443.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Ở Hà Tiên, Hà Tiên người ta mua người ta chuyển đi ra Phú Quốc này nọ, chuyển chỗ này chỗ kia, An Giang nữa chuyển tùm lum chỗ luôn á.",
      "start": 423.6,
      "end": 430.76,
      "n_words": 32,
      "start_frame": 10590,
      "end_frame": 10769,
      "keyframes": [
        "010605.webp",
        "010768.webp",
        "010769.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì người ta đặt mình cái bình bằng rồi người ta qua ta chở, người ta chuyển đâu chuyển mình không biết, điều người ta chuyển Phú Quốc nhiều nghe.",
      "start": 430.76,
      "end": 472.76,
      "n_words": 30,
      "start_frame": 10769,
      "end_frame": 11819,
      "keyframes": [
        "010769.webp",
        "010823.webp",
        "010877.webp",
