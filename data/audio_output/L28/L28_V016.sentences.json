      "end_frame": 25309,
      "keyframes": [
        "025131.webp",
        "025193.webp",
        "025194.webp",
        "025240.webp",
        "025286.webp",
        "025287.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thi sĩ Đông Hồ tên thật là Lâm Tấn Phát, ông vừa là nhà văn, nhà thơ vừa là thầy giáo, chính vì vậy căn nhà này từng là Trí Đức học xá cũ, nơi đầu tiên dạy chữ quốc ngữ cho con em vùng đất Hà Tiên.",
      "start": 1012.36,
      "end": 1034.24,
      "n_words": 48,
      "start_frame": 25309,
      "end_frame": 25856,
      "keyframes": [
