        "023064.webp",
        "023176.webp",
        "023201.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Qua mắt trữ tình của thi nhân, Đông Hồ ứng nguyệt được ví như một vùng phong cảnh giữa hồng quang, là một trong 10 cảnh đẹp của xứ Hà Tiên.",
      "start": 928.68,
      "end": 938.8,
      "n_words": 31,
      "start_frame": 23217,
      "end_frame": 23470,
      "keyframes": [
        "023328.webp",
        "023456.webp",
        "023457.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tương truyền cách đây 300 năm, ông Mạc Thiên Tích vẫn thường hội tụ các thi nhân trong tao đàn Chiêu Anh Các đến đầm Đông Hồ ngắm trăng vịnh thơ.",
      "start": 938.8,
      "end": 950.08,
      "n_words": 31,
      "start_frame": 23470,
      "end_frame": 23752,
      "keyframes": [
        "023586.webp",
        "023716.webp",
        "023739.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đàn Chiêu Anh Các là tao đàn thứ hai trong tiến trình văn học Việt Nam sau tao đàn Nhị Thập Bát Tú do vua Lý Thánh Tông sáng lập.",
      "start": 950.08,
      "end": 959.68,
      "n_words": 30,
      "start_frame": 23752,
      "end_frame": 23992,
      "keyframes": [
        "023829.webp",
        "023920.webp",
        "023944.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Qua những bài thơ được lưu truyền lại, minh chứng rằng tao đàn Chiêu Anh Các đã đặt nền móng cho tiến trình phát triển văn hóa ở Kiên Giang, khai mở lịch sử văn chương vùng đất Nam Bộ.",
      "start": 959.68,
      "end": 978.48,
      "n_words": 40,
      "start_frame": 23992,
      "end_frame": 24462,
      "keyframes": [
