        "022106.webp",
        "022228.webp",
        "022229.webp",
        "022321.webp",
        "022414.webp",
        "022439.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Lẻo lẻo tiết thu quang giữa có phần trăng nổi rõ ràng, đáy nước chân mây in một sắc ả hằng tố ló đôi phương rạng thanh đã hứng thuyền tu tử lạnh lẽo càng đau kiến nhạt xương cảnh một mà tình người dễ một kẻ thì ngã ngớn kẻ sầu thương.",
      "start": 898.56,
      "end": 928.68,
      "n_words": 53,
      "start_frame": 22464,
      "end_frame": 23217,
      "keyframes": [
        "022552.webp",
        "022665.webp",
        "022690.webp",
        "022730.webp",
        "022771.webp",
