      "n_words": 39,
      "start_frame": 21850,
      "end_frame": 22184,
      "keyframes": [
        "021920.webp",
        "021996.webp",
        "021997.webp",
        "022079.webp",
        "022162.webp",
        "022163.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Để mua được cá nguyên liệu giá rẻ, vợ chồng anh Tám Vô tranh thủ thu mua cá người dân đánh bắt được vào mùa nước nổi.",
      "start": 887.36,
