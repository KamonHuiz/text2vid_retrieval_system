      ],
      "keyframe_count": 32
    },
    {
      "text": "Giồng Riềng là một huyện có nhiều sông ngòi kênh rạch, diện tích tự nhiên 93.936 ha với 18 xã và một thị trấn.",
      "start": 66.6,
      "end": 75.76,
      "n_words": 24,
      "start_frame": 1665,
      "end_frame": 1894,
      "keyframes": [
        "001727.webp",
