      "keyframes": [
        "018440.webp",
        "018441.webp",
        "018579.webp",
        "018718.webp",
        "018719.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đó là cơ ngơi của gia đình anh Trương Văn Vô (Tám Vô), hộ nghèo vươn lên khá giả nhờ làm mắm truyền thống.",
      "start": 751.52,
      "end": 764.16,
      "n_words": 24,
      "start_frame": 18788,
      "end_frame": 19104,
      "keyframes": [
        "018901.webp",
        "019084.webp",
        "019085.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cũng là mắm cá đồng, nhưng mắm của vợ chồng anh Trương Văn Vô (Tám Vô) ở ấp Đường Lát, xã Ngọc Thuận, huyện Giồng Riềng, Kiên Giang lại khác biệt hơn ở chỗ vì không quá mặn, vừa ăn, chinh phục được cả những thực khách khó tính.",
      "start": 764.16,
      "end": 778.88,
      "n_words": 49,
      "start_frame": 19104,
      "end_frame": 19472,
      "keyframes": [
        "019136.webp",
        "019188.webp",
        "019189.webp",
        "019239.webp",
        "019289.webp",
        "019290.webp",
        "019336.webp",
        "019382.webp",
        "019383.webp",
        "019427.webp",
        "019471.webp",
        "019472.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Mỗi năm, một mùa nước nổi cũng là lúc cơ sở mắm Tám Vô có được nguồn cá đồng tươi ngon để làm nên món mắm đồng.",
      "start": 778.88,
      "end": 788.16,
      "n_words": 27,
      "start_frame": 19472,
      "end_frame": 19704,
      "keyframes": [
        "019472.webp",
        "019517.webp",
        "019563.webp",
        "019564.webp",
        "019626.webp",
        "019689.webp",
        "019690.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Phải là cá đồng tươi thì làm mắm mới ngon, ướp cá mới ăn muối để khi chao thính mới có mắm ngon.",
      "start": 788.16,
      "end": 797.92,
      "n_words": 23,
      "start_frame": 19704,
      "end_frame": 19948,
      "keyframes": [
        "019748.webp",
        "019806.webp",
        "019807.webp",
        "019852.webp",
        "019897.webp",
        "019898.webp",
        "019943.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "\"Từ khi năm 2000 làm là cũng bỡ ngỡ là em làm cho để ăn thôi, rồi cái làm ngon rồi cái mới cho xóm giềng ta ăn, ăn xong người ta thấy ngon ta mới kêu làm bán đi, mắm em làm ngon lắm, rồi em mới làm bán tới giờ luôn, bán tới giờ luôn.",
      "start": 797.92,
      "end": 814.44,
      "n_words": 57,
      "start_frame": 19948,
      "end_frame": 20361,
      "keyframes": [
        "019988.webp",
        "019989.webp",
        "020169.webp",
        "020350.webp",
        "020351.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Lúc đầu tiên thì mình làm thì chỉ ăn được thôi nhưng bây giờ nhiều năm vô trong làm nghề mắm này thì có kinh nghiệm rồi, mình rút kinh nghiệm từ từ bắt đầu bây giờ là làm nó ngon, nó đạt tới cái độ ngon nhất là ở huyện này.\"",
      "start": 814.88,
      "end": 840.08,
      "n_words": 52,
      "start_frame": 20372,
      "end_frame": 21002,
      "keyframes": [
        "020398.webp",
        "020445.webp",
        "020446.webp",
        "020625.webp",
        "020804.webp",
        "020805.webp",
        "020813.webp",
        "020822.webp",
        "020863.webp",
        "020954.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Từ câu chuyện khởi đầu kiếm đồng ra đồng vô lo cho kinh tế gia đình, lúc khó khăn với 3 kg mắm tự làm vừa đem ra chào hàng xóm đã có người đến mua, ngày hôm sau gia đình tiếp 10 kg mắm còn lại bán ra chợ và tiếp tục bán hết chỉ trong buổi sáng.",
      "start": 840.08,
      "end": 856.92,
      "n_words": 59,
      "start_frame": 21002,
      "end_frame": 21423,
      "keyframes": [
        "021046.webp",
        "021047.webp",
        "021067.webp",
        "021088.webp",
        "021089.webp",
        "021172.webp",
        "021255.webp",
        "021256.webp",
        "021336.webp",
        "021417.webp",
        "021418.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Những năm sau đó, năm nào vợ chồng anh Tám Vô cũng giăng lưới cắm câu làm mắm bán kiếm thêm thu nhập.",
      "start": 856.92,
      "end": 863.52,
      "n_words": 23,
      "start_frame": 21423,
      "end_frame": 21588,
      "keyframes": [
        "021476.webp",
        "021535.webp",
        "021536.webp",
        "021582.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Số lượng mắm cá gia đình chị làm mỗi năm ngày một tăng, từ một khạp ban đầu dần dà tăng lên 20 rồi 50 khạp, làm ăn nở nồi.",
      "start": 863.52,
      "end": 874.0,
      "n_words": 30,
      "start_frame": 21588,
      "end_frame": 21850,
      "keyframes": [
        "021629.webp",
