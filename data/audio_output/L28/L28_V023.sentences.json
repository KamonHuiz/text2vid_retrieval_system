        "001803.webp",
        "001867.webp",
        "001886.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Vùng đất đặc thù sông nước như các vùng Tây Nam Bộ khác, cho nên tiềm năng chính là sản xuất nông nghiệp với diện tích đất sản xuất nông nghiệp chiếm 89% và nằm ở vùng tây sông Hậu có nhiều kênh rạch tạo nguồn nước ngọt quanh năm.",
      "start": 75.76,
      "end": 90.48,
      "n_words": 50,
      "start_frame": 1894,
      "end_frame": 2262,
      "keyframes": [
        "001958.webp",
        "002031.webp",
        "002056.webp",
        "002116.webp",
        "002177.webp",
        "002178.webp",
        "002213.webp",
        "002248.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Huyện Giồng Riềng có thế mạnh sản xuất nông nghiệp, nuôi trồng thủy hải sản và trồng cây ăn trái.",
      "start": 90.76,
      "end": 97.12,
      "n_words": 20,
      "start_frame": 2269,
      "end_frame": 2428,
      "keyframes": [
        "002336.webp",
        "002409.webp",
        "002410.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đến nay, Giồng Riềng trở thành một trong những vùng sản xuất lúa trọng điểm nói riêng và sản xuất nông nghiệp nói chung của tỉnh Kiên Giang.",
      "start": 97.12,
      "end": 107.12,
      "n_words": 28,
      "start_frame": 2428,
      "end_frame": 2678,
      "keyframes": [
        "002527.webp",
        "002645.webp",
        "002646.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Được thành lập vào năm 2002, Bàn Thạch là xã vùng sâu của huyện Giồng Riềng, tỉnh Kiên Giang.",
      "start": 107.12,
      "end": 113.6,
      "n_words": 19,
      "start_frame": 2678,
      "end_frame": 2840,
      "keyframes": [
        "002738.webp",
        "002831.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Địa phận xã Bàn Thạch có diện tích tự nhiên 2.127 ha, trong đó diện tích đất nông nghiệp là 399 ha.",
      "start": 113.6,
      "end": 119.68,
      "n_words": 22,
      "start_frame": 2840,
      "end_frame": 2992,
      "keyframes": [
        "002856.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Toàn xã có 2.420 hộ dân, trong đó dân tộc Khmer chiếm 56.7%, tức 1.364 hộ.",
      "start": 120.92,
      "end": 131.28,
      "n_words": 16,
      "start_frame": 3023,
      "end_frame": 3282,
      "keyframes": [
        "003045.webp",
        "003235.webp",
        "003260.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đồng bào dân tộc Khmer cùng với cộng đồng các dân tộc thiểu số của Việt Nam là bộ phận không thể tách rời trong khối đại đoàn kết dân tộc tại tỉnh Kiên Giang.",
      "start": 131.28,
      "end": 143.16,
      "n_words": 35,
      "start_frame": 3282,
      "end_frame": 3579,
      "keyframes": [
        "003394.webp",
        "003528.webp",
        "003529.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đồng bào dân tộc Khmer chiếm hơn 13%, là địa phương có đồng bào dân tộc Khmer sinh sống đứng thứ ba vùng đồng bằng sông Cửu Long sau tỉnh Sóc Trăng và Trà Vinh.",
      "start": 143.16,
      "end": 154.64,
      "n_words": 35,
      "start_frame": 3579,
      "end_frame": 3866,
      "keyframes": [
        "003690.webp",
        "003851.webp",
        "003852.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Những năm gần đây, nhất là từ khi có chương trình mục tiêu quốc gia về phát triển kinh tế xã hội vùng đồng bào dân tộc thiểu số và miền núi giai đoạn 2021 đến 2030 được triển khai, đời sống của bà con đồng bào dân tộc Khmer trên địa bàn Kiên Giang có nhiều đổi thay.",
      "start": 154.64,
      "end": 197.6,
      "n_words": 59,
      "start_frame": 3866,
      "end_frame": 4940,
      "keyframes": [
        "003893.webp",
        "003935.webp",
        "003936.webp",
        "003967.webp",
        "003999.webp",
        "004000.webp",
        "004067.webp",
        "004135.webp",
        "004136.webp",
        "004172.webp",
        "004209.webp",
        "004210.webp",
        "004252.webp",
        "004295.webp",
        "004296.webp",
        "004380.webp",
        "004464.webp",
        "004465.webp",
        "004577.webp",
        "004689.webp",
        "004690.webp",
        "004750.webp",
        "004810.webp",
        "004811.webp",
        "004890.webp"
      ],
      "keyframe_count": 25
    },
    {
      "text": "Huyện Giồng Riềng cũng là một huyện có đông đồng bào dân tộc Khmer sinh sống, đặc biệt là tập trung nhiều ở xã Bàn Thạch, Tân Định, Vĩnh Phú, Vĩnh Thạnh và Ngọc Trúc.",
      "start": 198.32,
      "end": 211.36,
      "n_words": 35,
      "start_frame": 4958,
      "end_frame": 5284,
      "keyframes": [
        "004969.webp",
        "004970.webp",
        "004982.webp",
        "004994.webp",
        "004995.webp",
        "005151.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Riêng đối với xã Bàn Thạch là một cái xã vùng nông thôn có đông đồng bào dân tộc Khmer chiếm tỷ lệ là 58.67%.",
      "start": 212.84,
      "end": 219.76,
      "n_words": 25,
      "start_frame": 5321,
      "end_frame": 5494,
      "keyframes": [
        "005369.webp",
        "005429.webp",
        "005430.webp",
        "005488.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đa số trên địa bàn thì điều kiện sinh sống của bà con nhân dân là sống chủ yếu vào cái nghề sản xuất nông nghiệp là chính, và bên cạnh đó thì bà con cũng có trồng trọt chăn nuôi để phát triển ổn định cuộc sống.",
      "start": 221.8,
      "end": 243.04,
      "n_words": 48,
      "start_frame": 5545,
      "end_frame": 6076,
      "keyframes": [
        "005546.webp",
        "005547.webp",
        "005716.webp",
        "005885.webp",
        "005886.webp",
        "005967.webp",
        "006048.webp",
        "006049.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Từ khi mới thành lập, Bàn Thạch là xã khó khăn nhất của huyện Giồng Riềng, bà con sinh sống chủ yếu dựa vào sản xuất nông nghiệp.",
      "start": 243.04,
      "end": 250.56,
      "n_words": 28,
      "start_frame": 6076,
      "end_frame": 6264,
      "keyframes": [
        "006080.webp",
        "006111.webp",
        "006112.webp",
        "006150.webp",
        "006189.webp",
        "006190.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Điều kiện canh tác khó khăn, chỉ trồng một vụ lúa với nếp, làm được bao nhiêu ăn bấy nhiêu.",
      "start": 250.56,
      "end": 257.28,
      "n_words": 20,
      "start_frame": 6264,
      "end_frame": 6432,
      "keyframes": [
        "006308.webp",
        "006426.webp",
        "006427.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Không những thế, cơ sở hạ tầng giao thông yếu kém, trục đường chính là đường đất, địa hình nhiều kênh rạch nhỏ, việc di chuyển và giao thương gặp nhiều khó khăn.",
      "start": 257.28,
      "end": 271.04,
      "n_words": 33,
      "start_frame": 6432,
      "end_frame": 6776,
      "keyframes": [
        "006467.webp",
        "006508.webp",
        "006509.webp",
        "006563.webp",
        "006617.webp",
        "006618.webp",
        "006682.webp",
        "006746.webp",
        "006747.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Người dân cho biết do cuộc sống kinh tế khó khăn nên nhiều gia đình tại xã Bàn Thạch, huyện Giồng Riềng, Kiên Giang đã lấy ngó riềng mang bán ở chợ như một loại rau đồng để mưu sinh.",
      "start": 271.04,
      "end": 286.64,
      "n_words": 40,
      "start_frame": 6776,
      "end_frame": 7166,
      "keyframes": [
        "006797.webp",
        "006847.webp",
        "006848.webp",
        "006905.webp",
        "006963.webp",
        "006964.webp",
        "007035.webp",
        "007106.webp",
        "007131.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ban đầu do ăn chưa quen nên lượng tiêu thụ ít, lâu dần thị trường tiêu thụ nhiều hơn, các hộ dân đã tận dụng đất trồng quanh nhà sau vườn để trồng riềng.",
      "start": 286.64,
      "end": 301.52,
      "n_words": 34,
      "start_frame": 7166,
      "end_frame": 7538,
      "keyframes": [
        "007189.webp",
        "007248.webp",
        "007249.webp",
        "007282.webp",
        "007315.webp",
        "007316.webp",
        "007386.webp",
        "007457.webp",
        "007458.webp",
        "007536.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Riềng là loại cây thường được đào lấy củ làm gia vị.",
      "start": 301.52,
      "end": 305.0,
      "n_words": 12,
      "start_frame": 7538,
      "end_frame": 7625,
      "keyframes": [
        "007614.webp",
        "007615.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Người dân xã Bàn Thạch tận dụng thân cây riềng còn non để tách vỏ lấy phần ngó non để ăn sống cùng món mắm kho hoặc xào luộc.",
      "start": 305.0,
      "end": 352.64,
      "n_words": 29,
      "start_frame": 7625,
      "end_frame": 8816,
      "keyframes": [
        "007667.webp",
        "007720.webp",
        "007721.webp",
        "007752.webp",
        "007783.webp",
        "007784.webp",
        "007835.webp",
        "007886.webp",
        "007887.webp",
        "007939.webp",
        "007991.webp",
        "007992.webp",
        "008057.webp",
        "008122.webp",
        "008123.webp",
        "008198.webp",
        "008274.webp",
        "008275.webp",
        "008304.webp",
        "008334.webp",
        "008357.webp",
        "008381.webp",
        "008405.webp",
        "008406.webp",
        "008491.webp",
        "008576.webp",
        "008577.webp",
        "008652.webp",
        "008727.webp",
        "008750.webp",
        "008810.webp"
      ],
      "keyframe_count": 31
    },
    {
      "text": "Cây riềng chỉ cần chiếc củ sau đó cắm vào đất là cây có thể phát triển.",
      "start": 352.64,
      "end": 357.32,
      "n_words": 17,
      "start_frame": 8816,
      "end_frame": 8933,
      "keyframes": [
        "008871.webp",
        "008872.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mùa mưa là thời điểm tốt nhất để riềng phát triển, thu hoạch ngó riềng lúc này sẽ non và giòn ngọt hơn mùa nắng hạn.",
      "start": 357.32,
      "end": 366.64,
      "n_words": 26,
      "start_frame": 8933,
      "end_frame": 9166,
      "keyframes": [
        "008939.webp",
        "009006.webp",
        "009007.webp",
        "009076.webp",
        "009145.webp",
        "009146.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đặc biệt, riềng ít bị sâu bệnh, không cần sử dụng phân bón thuốc trừ sâu cây vẫn cho năng suất cao và chất lượng ngó thơm ngon.",
      "start": 366.64,
      "end": 377.04,
      "n_words": 28,
      "start_frame": 9166,
      "end_frame": 9426,
      "keyframes": [
        "009219.webp",
        "009293.webp",
        "009294.webp",
        "009347.webp",
        "009401.webp",
        "009402.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Được biết, trồng khoảng 7 đến 8 tháng sẽ được lựa chọn cây nào có 2 đến 3 lá nhổ lấy ngó.",
      "start": 377.04,
      "end": 383.96,
      "n_words": 22,
      "start_frame": 9426,
      "end_frame": 9599,
      "keyframes": [
        "009473.webp",
        "009545.webp",
        "009546.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thông thường để bán ngó phải lột tách phần vỏ thân cây bên ngoài, đây là việc mất nhiều thời gian, phải thật khéo léo để ngó không gãy.",
      "start": 383.96,
      "end": 392.32,
      "n_words": 29,
      "start_frame": 9599,
      "end_frame": 9808,
      "keyframes": [
        "009621.webp",
        "009696.webp",
        "009697.webp",
        "009753.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Người làm thành thục có thể lột được từ 5 đến 6 kg ngó mỗi ngày.",
      "start": 392.32,
      "end": 401.36,
      "n_words": 16,
      "start_frame": 9808,
      "end_frame": 10034,
      "keyframes": [
        "009809.webp",
        "009810.webp",
        "009861.webp",
        "009913.webp",
        "009914.webp",
        "010002.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hiện tại, trên địa bàn xã thì có trên 30 hộ tham gia trồng ngó riềng với diện tích gần 2 ha.",
      "start": 401.36,
      "end": 407.84,
      "n_words": 22,
      "start_frame": 10034,
      "end_frame": 10196,
      "keyframes": [
        "010090.webp",
        "010091.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "\"Thì nói chung là những hộ mà tham gia trồng riềng này, thứ nhất là một cái loại sản phẩm mới, thành ra là so với ban đầu thì hiện nay trồng gần 2 ha thì rất nhiều.",
      "start": 408.96,
      "end": 424.04,
      "n_words": 38,
      "start_frame": 10224,
      "end_frame": 10601,
      "keyframes": [
        "010325.webp",
        "010326.webp",
        "010393.webp",
        "010460.webp",
        "010485.webp",
        "010568.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ngày xưa thì chỉ có trồng một hai bụi để bà con mình tận dụng làm gia vị rồi nấu các món ăn, chỉ tận dụng cái củ đó thôi.",
      "start": 424.04,
      "end": 435.96,
      "n_words": 30,
      "start_frame": 10601,
      "end_frame": 10899,
      "keyframes": [
        "010651.webp",
        "010652.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nhưng mà đến hiện tại, qua một thời gian cung ứng ra thị trường thì bà con cũng nhận thấy là cái sản phẩm này có thể đưa ra thị trường rồi, có thể cung ứng ra các chuỗi nhà hàng quán ăn, rồi bên cạnh đó thì cũng tạo nhiều cái thu nhập cho bà con.\"",
      "start": 435.96,
      "end": 460.52,
      "n_words": 57,
      "start_frame": 10899,
      "end_frame": 11513,
      "keyframes": [
        "010985.webp",
        "011318.webp",
        "011319.webp",
        "011382.webp",
        "011446.webp",
        "011447.webp",
        "011499.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Quan niệm giản đơn của người nông dân, cây riềng khá dễ trồng, không cần vốn đầu tư chăm sóc.",
      "start": 460.52,
      "end": 465.16,
      "n_words": 20,
      "start_frame": 11513,
      "end_frame": 11629,
      "keyframes": [
        "011552.webp",
        "011553.webp",
        "011602.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Từ đó, ngò riềng non đã giúp cho gia đình có thêm nguồn thu nhập thứ hai, có đồng ra đồng vô hàng ngày.",
      "start": 466.28,
      "end": 475.92,
      "n_words": 24,
      "start_frame": 11657,
      "end_frame": 11898,
      "keyframes": [
        "011735.webp",
        "011818.webp",
        "011819.webp",
        "011879.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Từ chỗ chỉ dùng trong bữa ăn gia đình, hiện ngó riềng đã hiện diện trên các bàn ăn tại một số nhà hàng trong tỉnh.",
      "start": 475.92,
      "end": 484.84,
      "n_words": 26,
      "start_frame": 11898,
      "end_frame": 12121,
      "keyframes": [
        "011939.webp",
        "011964.webp",
        "011988.webp",
        "012012.webp",
        "012013.webp",
        "012090.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "\"Xưa tới giờ gia đình tôi làm ruộng, rồi thấy bây giờ nó cũng chuyển, nó cũng có người ta cũng thấy nó ăn nhiều rồi cũng trồng thêm, thấy nó cũng đỡ để trong sinh hoạt hàng ngày.",
      "start": 484.84,
      "end": 505.28,
      "n_words": 39,
      "start_frame": 12121,
      "end_frame": 12632,
      "keyframes": [
        "012168.webp",
        "012169.webp",
        "012378.webp",
        "012587.webp",
        "012588.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cái này nó dễ trồng mà nó cứ để nó vậy là nó sống tự nhiên, không có phân bón gì, thuốc lá gì đó, không có chăm sóc gì mấy đâu.\"",
      "start": 505.64,
      "end": 519.08,
      "n_words": 32,
      "start_frame": 12641,
      "end_frame": 12977,
      "keyframes": [
        "012659.webp",
        "012730.webp",
        "012731.webp",
        "012823.webp",
        "012915.webp",
        "012916.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Sự trợ giúp của chính quyền giúp cho bà con từ bước đầu cách chăm sóc và cả khâu đóng gói hút chân không ngó riềng thành phẩm để khách tiện mua dùng và làm quà tặng.",
      "start": 519.08,
      "end": 529.48,
      "n_words": 37,
      "start_frame": 12977,
      "end_frame": 13237,
      "keyframes": [
        "012992.webp",
        "013068.webp",
        "013069.webp",
        "013120.webp",
        "013172.webp",
        "013173.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bên cạnh đó, xã Bàn Thạch cũng đã chọn ngó riềng để đăng ký phát triển và được công nhận là sản phẩm OCOP, khẳng định được công sức và giá trị của ngó riềng Bàn Thạch trên thị trường.",
      "start": 529.48,
      "end": 540.6,
      "n_words": 40,
      "start_frame": 13237,
      "end_frame": 13515,
      "keyframes": [
        "013289.webp",
        "013406.webp",
        "013407.webp",
        "013513.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "\"Thuở ban đầu đến năm 2021 thì thực hiện theo cái chủ trương của huyện ủy, UBND, thực hiện theo các tiêu chí nông thôn mới thì đảm bảo là mỗi xã là phải có một sản phẩm OCOP trở lên.",
      "start": 540.6,
      "end": 560.16,
      "n_words": 41,
      "start_frame": 13515,
      "end_frame": 14004,
      "keyframes": [
        "013619.webp",
        "013620.webp",
        "013777.webp",
        "013872.webp",
        "013934.webp",
        "013935.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thì lúc đó chính quyền địa phương cũng có bàn bạc là thống nhất lấy cái sản phẩm ngó riềng là một trong những sản phẩm đặc trưng của địa bàn để đăng ký công nhận là sản phẩm OCOP.",
      "start": 560.16,
      "end": 572.64,
      "n_words": 40,
      "start_frame": 14004,
      "end_frame": 14316,
      "keyframes": [
        "014030.webp",
        "014125.webp",
        "014126.webp",
        "014224.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thì lúc đó cũng được chính quyền chọn sản phẩm này, rồi dần dần để mà hoàn thiện cái sản phẩm này để làm sao mà đủ điều kiện để được công nhận cái sản phẩm OCOP 3 sao.",
      "start": 573.12,
      "end": 588.4,
      "n_words": 39,
      "start_frame": 14328,
      "end_frame": 14710,
      "keyframes": [
        "014357.webp",
