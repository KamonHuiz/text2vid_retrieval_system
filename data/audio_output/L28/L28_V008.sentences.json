        "025280.webp",
        "025327.webp",
        "025328.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cái tên được gắn với dòng kênh trước cả khi kênh T5 mang tên là kênh Võ Văn Kiệt trên giấy tờ văn bản.",
      "start": 1013.28,
      "end": 1023.2,
      "n_words": 24,
      "start_frame": 25332,
      "end_frame": 25580,
      "keyframes": [
        "025440.webp",
        "025553.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bia tưởng niệm vị cố Thủ tướng cũng được dựng lên ở ngay đầu tuyến kênh Võ Văn Kiệt, dòng kênh có tính chất khai mở cho cả vùng đất này.",
      "start": 1023.2,
      "end": 1032.12,
      "n_words": 31,
      "start_frame": 25580,
      "end_frame": 25803,
      "keyframes": [
        "025583.webp",
        "025680.webp",
        "025778.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó cũng là một cách để nhắc nhở thế hệ hôm nay không quên công ơn của ông, một con người như tượng đài sừng sững trong lòng dân xứ này.",
      "start": 1032.12,
      "end": 1040.56,
      "n_words": 31,
      "start_frame": 25803,
      "end_frame": 26014,
      "keyframes": [
        "025808.webp",
        "025826.webp",
        "025844.webp",
        "025865.webp",
        "025885.webp",
        "025906.webp",
        "025936.webp",
        "025969.webp",
        "026003.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Các bậc tiền nhân như Thoại Ngọc Hầu có công đào kênh Vĩnh Tế thì hậu thế như là Võ Văn Kiệt là một vị đã nối tiếp con đường quốc sách của tiền nhân để xẻ những cái dòng kênh tiếp tục đem nước ngọt vào sâu hơn trong những cánh đồng.",
      "start": 1040.56,
      "end": 1062.88,
      "n_words": 53,
      "start_frame": 26014,
      "end_frame": 26572,
      "keyframes": [
        "026026.webp",
        "026057.webp",
        "026089.webp",
        "026090.webp",
        "026132.webp",
        "026175.webp",
        "026176.webp",
        "026210.webp",
        "026245.webp",
        "026246.webp",
        "026307.webp",
        "026368.webp",
        "026369.webp",
        "026447.webp",
        "026526.webp",
        "026556.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Chiều dần tắt trên mảnh đất biên viễn phương Nam, những đứa trẻ đang nô đùa nơi công viên văn hóa Võ Văn Kiệt, công viên được tọa lạc nơi đầu nguồn kênh bên cánh đồng Lạc Quế với những bông hoa được ươm mầm rồi hé nở từ đất ngọt.",
      "start": 1062.88,
      "end": 1078.4,
      "n_words": 51,
      "start_frame": 26572,
      "end_frame": 26960,
      "keyframes": [
        "026579.webp",
        "026602.webp",
        "026603.webp",
        "026627.webp",
        "026651.webp",
        "026652.webp",
        "026678.webp",
        "026704.webp",
        "026705.webp",
        "026717.webp",
        "026729.webp",
        "026730.webp",
        "026833.webp",
        "026936.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Chúng tôi nghĩ về sự bền vững, về sự hòa quyện của xưa và nay, về quá khứ và tương lai, về sự tiếp nối về khát vọng phồn vinh hơn của một vùng đất hiền hòa mà khát khao vươn mình mãnh liệt.",
      "start": 1078.4,
