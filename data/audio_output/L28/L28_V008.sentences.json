        "019637.webp",
        "019686.webp",
        "019687.webp",
        "019744.webp",
        "019802.webp",
        "019803.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Thì kinh này coi như là ai cũng, người dân là thấy là mừng mừng sao, tại vì thoát phèn, ngõ phèn rồi mặn mới có ăn.",
      "start": 792.88,
      "end": 803.44,
      "n_words": 27,
      "start_frame": 19822,
      "end_frame": 20086,
      "keyframes": [
        "019860.webp",
        "019917.webp",
        "019918.webp",
        "020058.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chứ hồi trước không có kinh này mần không được, có ai vô đây rừng không, đi lún lầy\".",
      "start": 803.44,
      "end": 816.08,
      "n_words": 19,
      "start_frame": 20086,
      "end_frame": 20402,
      "keyframes": [
        "020198.webp",
        "020199.webp",
        "020266.webp",
        "020333.webp",
        "020334.webp",
        "020378.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ông Trần Văn thuộc một trong số những lão nông tri điền đặt chân lên mảnh đất Lạc Quế này từ những ngày vùng này còn là vùng bưng biển hoang vắng nhiễm phèn đỏ quạch.",
      "start": 816.08,
      "end": 829.44,
      "n_words": 36,
      "start_frame": 20402,
      "end_frame": 20736,
      "keyframes": [
        "020422.webp",
        "020423.webp",
        "020501.webp",
        "020580.webp",
        "020581.webp",
        "020642.webp",
        "020704.webp",
        "020734.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "82 tuổi dường như ký ức của ông về những ngày ban đầu khai phá vẫn vẹn nguyên: \"Là vùng này là trước đây nước phèn, nước phèn không coi mình nhìn xuống dưới kinh thì nó trong xanh thấy đáy cá lội thì mình thấy hết, tại vì nó phèn.",
      "start": 829.44,
      "end": 847.44,
      "n_words": 51,
      "start_frame": 20736,
      "end_frame": 21186,
      "keyframes": [
        "020779.webp",
        "020825.webp",
        "020826.webp",
        "020870.webp",
        "020915.webp",
        "020933.webp",
        "020961.webp",
        "020989.webp",
        "020990.webp",
        "021049.webp",
        "021109.webp",
        "021110.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Mà nước phèn như vậy thì hồi xưa mình trồng lúa sao chứ khó lắm, có mần cũng nghĩa là thua không?",
      "start": 847.44,
      "end": 856.72,
      "n_words": 22,
      "start_frame": 21186,
      "end_frame": 21418,
      "keyframes": [
        "021224.webp",
        "021338.webp",
        "021339.webp",
        "021374.webp",
        "021409.webp",
        "021410.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đó coi như là mần có vụ mà còn không, bị chuột nó thiệt hại rồi mần coi như là khổ khổ lắm.",
      "start": 856.72,
      "end": 866.36,
      "n_words": 23,
      "start_frame": 21418,
      "end_frame": 21659,
      "keyframes": [
        "021437.webp",
        "021464.webp",
        "021465.webp",
        "021509.webp",
        "021554.webp",
        "021555.webp",
        "021598.webp",
        "021642.webp",
        "021643.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Mần kiếm ăn mà nó không có ăn mặn mấy chục công khi được có mấy bao lúa à, bao lúa à\".",
      "start": 866.36,
      "end": 875.6,
      "n_words": 22,
      "start_frame": 21659,
      "end_frame": 21890,
      "keyframes": [
        "021678.webp",
