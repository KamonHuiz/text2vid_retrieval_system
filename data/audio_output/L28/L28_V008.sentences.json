        "001390.webp",
        "001447.webp",
        "001448.webp"
      ],
      "keyframe_count": 35
    },
    {
      "text": "Vĩnh Tế, Vĩnh Tế biển Hà Tiên, ghe thuyền xuôi ngược bán muôn dập nhiều kênh.",
      "start": 59.04,
      "end": 68.36,
      "n_words": 16,
      "start_frame": 1476,
      "end_frame": 1709,
      "keyframes": [
        "001539.webp",
        "001631.webp",
        "001632.webp",
        "001646.webp",
        "001660.webp",
        "001687.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vĩnh Tế - con đường thủy huyết mạch của miền Tây Nam Bộ, con kênh thoát nước đổ ngọt và bồi đắp phù sa cho vùng tứ giác Long Xuyên, thủy sản Hà Tiên.",
      "start": 68.36,
      "end": 79.72,
      "n_words": 34,
      "start_frame": 1709,
      "end_frame": 1993,
      "keyframes": [
        "001749.webp",
        "001811.webp",
        "001812.webp",
        "001846.webp",
        "001880.webp",
        "001881.webp",
        "001913.webp",
        "001946.webp",
        "001947.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ngược dòng Vĩnh Tế để đi đến Tri Tôn, Châu Đốc, gia súc lúa gạo, trái cây vân vân từ vùng Bảy Núi theo kênh Vĩnh Tế để xuôi dòng về xứ biển Hà Tiên.",
      "start": 79.72,
      "end": 94.32,
      "n_words": 35,
      "start_frame": 1993,
      "end_frame": 2358,
      "keyframes": [
        "002008.webp",
        "002070.webp",
        "002071.webp",
        "002103.webp",
        "002135.webp",
        "002136.webp",
        "002237.webp",
        "002338.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng tôi xuôi dòng kênh Vĩnh Tế, con kênh mang trong mình sứ mạng là đại sứ giao thương vận tải đường thủy, an ninh quốc phòng.",
      "start": 94.32,
      "end": 103.84,
      "n_words": 27,
      "start_frame": 2358,
      "end_frame": 2596,
      "keyframes": [
        "002363.webp",
        "002435.webp",
        "002508.webp",
        "002536.webp",
        "002567.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Con kênh lặng lẽ yên bình chạy theo tuyến biên cương giữa Việt Nam và Campuchia.",
      "start": 103.84,
      "end": 119.08,
      "n_words": 16,
      "start_frame": 2596,
      "end_frame": 2977,
      "keyframes": [
        "002598.webp",
        "002640.webp",
        "002690.webp",
        "002741.webp",
        "002775.webp",
        "002829.webp",
        "002884.webp",
        "002914.webp",
        "002959.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng tôi xuôi miệt Cửu Long đúng thời điểm mà vùng quê sông nước phải đối mặt với nhiều vấn đề mang tính khó khăn và cấp bách.",
      "start": 119.08,
      "end": 129.72,
      "n_words": 28,
      "start_frame": 2977,
      "end_frame": 3243,
      "keyframes": [
        "003005.webp",
        "003035.webp",
        "003107.webp",
        "003180.webp",
        "003181.webp",
        "003208.webp",
        "003236.webp",
        "003237.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng tôi mang theo cả những tâm tư về sự biết ơn lẫn những bồi hồi thổn thức khi hòa vào nhịp thở của dòng kênh 200 tuổi chạy dọc biên giới Tây Nam.",
      "start": 129.72,
      "end": 141.12,
      "n_words": 34,
      "start_frame": 3243,
      "end_frame": 3528,
      "keyframes": [
        "003303.webp",
        "003369.webp",
        "003370.webp",
        "003405.webp",
        "003441.webp",
        "003472.webp",
        "003527.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Kênh Vĩnh Tế được tiền nhân cố công tạo lập như một phòng tuyến lợi hại giúp cho công tác tuần tra biên giới được dễ dàng hơn.",
      "start": 141.12,
      "end": 156.16,
      "n_words": 28,
      "start_frame": 3528,
      "end_frame": 3904,
      "keyframes": [
        "003583.webp",
        "003612.webp",
        "003668.webp",
        "003724.webp",
        "003753.webp",
        "003778.webp",
        "003804.webp",
        "003805.webp",
        "003839.webp",
        "003873.webp",
        "003874.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Nơi chúng tôi đang đứng bây giờ là đập tràn Tha Lạc.",
      "start": 156.16,
      "end": 160.04,
      "n_words": 12,
      "start_frame": 3904,
      "end_frame": 4001,
      "keyframes": [
        "003906.webp",
        "003939.webp",
        "003940.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đây là một trong hai con đập quan trọng đóng vai trò cửa ngõ kiểm soát lưu lượng dòng chảy, giảm áp lực nước đối với vùng thượng nguồn, cung cấp phù sa và góp phần tháo chua rửa mặn, vệ sinh đồng ruộng.",
      "start": 160.04,
      "end": 173.6,
      "n_words": 44,
      "start_frame": 4001,
      "end_frame": 4340,
      "keyframes": [
        "004041.webp",
        "004143.webp",
        "004144.webp",
        "004240.webp",
        "004337.webp",
        "004338.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nơi đây có thể trọn vẹn thưởng lãm con kênh huyền thoại.",
      "start": 173.6,
      "end": 177.08,
      "n_words": 12,
      "start_frame": 4340,
      "end_frame": 4427,
      "keyframes": [
        "004370.webp",
        "004403.webp",
        "004404.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Con kênh dài 87 km nằm sát quốc lộ N1 thẳng tắp như kẻ chỉ.",
      "start": 177.08,
      "end": 183.24,
      "n_words": 15,
      "start_frame": 4427,
      "end_frame": 4581,
      "keyframes": [
        "004434.webp",
        "004465.webp",
        "004466.webp",
        "004520.webp",
        "004574.webp",
        "004575.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Có thể tưởng tượng con kênh huyền thoại được xem là quy mô nhất thời phong kiến này lại chỉ được đào bằng tay với cuốc, huy động hơn chín vạn dân binh người Việt lẫn người Khmer năm năm, gần 3.5 triệu ngày công, hơn 2.8 triệu mét khối đất được đào.",
      "start": 183.56,
      "end": 202.44,
      "n_words": 53,
      "start_frame": 4589,
      "end_frame": 5061,
      "keyframes": [
        "004687.webp",
        "004800.webp",
        "004801.webp",
        "004848.webp",
        "004895.webp",
        "004896.webp",
        "004934.webp",
        "004973.webp",
        "004974.webp",
        "005010.webp",
        "005046.webp",
        "005047.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Từ đó đã tạo tác nên hình nên dạng con kênh có tổng chiều dài là 91 km, rộng 35 m và có độ sâu trung bình 3.5 m.",
      "start": 202.44,
      "end": 211.36,
      "n_words": 29,
      "start_frame": 5061,
      "end_frame": 5284,
      "keyframes": [
        "005191.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tuy các nơi bồi lắng nhưng nhìn khoảng mênh mông trước mắt, chúng tôi dự đoán con kênh hiện giờ rộng đến hơn 40 m ngang.",
      "start": 212.08,
      "end": 221.0,
      "n_words": 26,
      "start_frame": 5302,
      "end_frame": 5525,
      "keyframes": [
        "005335.webp",
        "005365.webp",
        "005443.webp",
        "005522.webp",
        "005523.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Có lẽ trải qua 200 năm dưới sự tác động của sức nước, ghe xuồng nên dòng kênh đã rộng thêm ra.",
      "start": 221.0,
      "end": 228.84,
      "n_words": 22,
      "start_frame": 5525,
      "end_frame": 5721,
      "keyframes": [
        "005608.webp",
        "005694.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nam Kỳ biết mấy rạch kinh, một kinh Vĩnh Tế có danh rộng dài, lịch sử có thể dễ dàng đếm được số lượng kênh đào tại Việt Nam nhưng chỉ duy nhất hình tượng kênh đào Vĩnh Tế vinh dự được vua Minh Mạng cho chạm khắc lên cao đỉnh một trong Cửu Đỉnh đặt tại Hoàng thành Huế vào năm 1835 nhằm ghi nhận những cống hiến quan trọng mà thành tựu thủy nông này mang lại.",
      "start": 228.84,
      "end": 257.52,
      "n_words": 79,
      "start_frame": 5721,
      "end_frame": 6438,
      "keyframes": [
        "005724.webp",
        "005792.webp",
        "005860.webp",
        "005891.webp",
        "006153.webp",
        "006415.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bởi lẽ thời kỳ đó miền Tây Nam tổ quốc là nơi lam sơn chướng khí, nước độc rừng thiêng, sông sâu lội dập dìu, trên bờ thì còn beo rắn độc mũi như trấu.",
      "start": 257.52,
      "end": 271.08,
      "n_words": 35,
      "start_frame": 6438,
      "end_frame": 6777,
      "keyframes": [
        "006445.webp",
        "006521.webp",
        "006598.webp",
        "006631.webp",
        "006682.webp",
        "006734.webp",
        "006765.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Trong hoàn cảnh như thế, dân công binh lính phải dãi nắng dầm mưa đào kinh suốt nhiều năm, chắc chắn không tránh khỏi thương vong.",
      "start": 271.08,
      "end": 281.28,
      "n_words": 26,
      "start_frame": 6777,
      "end_frame": 7032,
      "keyframes": [
        "006831.webp",
        "006898.webp",
        "006929.webp",
        "006958.webp",
        "006987.webp",
        "007017.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trong các tư liệu còn lưu giữ được, người ta chú ý nhiều đến văn tế nghĩa trùng do Nguyễn Văn Thoại soạn.",
      "start": 281.28,
      "end": 288.68,
      "n_words": 23,
      "start_frame": 7032,
      "end_frame": 7217,
      "keyframes": [
        "007088.webp",
        "007160.webp",
        "007161.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó là áng văn cảm động chiêu hồn những người hy sinh khi đào con kênh chiến lược ở chốn biên cương này: \"Đào kênh trước mấy kỳ khó nhớ, quát nhung y chống đỡ biên cương, xông pha máu nhuộm chiến trường, bọc thay da ngựa gửi xương xứ này\".",
      "start": 288.68,
      "end": 311.84,
      "n_words": 51,
      "start_frame": 7217,
      "end_frame": 7796,
      "keyframes": [
        "007289.webp",
        "007417.webp",
        "007447.webp",
        "007567.webp",
        "007687.webp",
        "007688.webp",
        "007727.webp",
        "007767.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Phải chăng Thoại Ngọc Hầu ắt hẳn là người sống rất nghĩa tình?",
      "start": 311.84,
      "end": 316.44,
      "n_words": 13,
      "start_frame": 7796,
      "end_frame": 7911,
      "keyframes": [
        "007797.webp",
        "007841.webp",
        "007885.webp",
        "007886.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Phải chăng trong suốt thời gian lãnh mệnh phụ trách đào kênh Vĩnh Tế, kênh Thoại Hà, kênh Vĩnh An, mỗi khi nghe tin báo về chuyện thương vong của dân công binh sĩ, hẳn cụ Thoại phải là người xót xa nhất?",
      "start": 316.44,
      "end": 332.76,
      "n_words": 43,
      "start_frame": 7911,
      "end_frame": 8319,
      "keyframes": [
        "008074.webp",
        "008263.webp",
        "008293.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Để rồi từ ngày đó, bên dòng kênh huyền thoại những đồng lúa đã mọc lên xanh rì và cũng từ ngày đó nhiều người đã chọn vùng đất lúa phèn ven kênh Vĩnh Tế làm quê hương.",
      "start": 332.76,
      "end": 344.0,
      "n_words": 38,
      "start_frame": 8319,
      "end_frame": 8600,
      "keyframes": [
        "008361.webp",
        "008429.webp",
        "008459.webp",
        "008527.webp",
        "008596.webp",
        "008597.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Những ngôi làng đã mọc lên, niềm vui đã về trên cánh đồng mà trước đây vốn dĩ rất là khô cằn, hoang hóa.",
      "start": 344.0,
      "end": 351.52,
      "n_words": 24,
      "start_frame": 8600,
      "end_frame": 8788,
      "keyframes": [
        "008626.webp",
        "008655.webp",
        "008656.webp",
        "008713.webp",
        "008771.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Kênh Vĩnh Tế không chỉ mang nước ngọt kèm phù sa vun đắp cho ruộng đồng An Giang mà cho cả vùng tứ giác Long Xuyên, còn mang về nguồn sản vật phong phú.",
      "start": 351.52,
      "end": 362.56,
      "n_words": 34,
      "start_frame": 8788,
      "end_frame": 9064,
      "keyframes": [
        "008801.webp",
        "008918.webp",
        "009036.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Kênh Vĩnh Tế đầu nguồn này như cái túi cá, nước tới đâu cá tới đó, tha hồ đánh bắt.",
      "start": 362.56,
      "end": 368.64,
      "n_words": 20,
      "start_frame": 9064,
      "end_frame": 9216,
      "keyframes": [
        "009066.webp",
        "009133.webp",
        "009201.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tùy theo mực nước cao thấp, người ta sẽ chọn hình thức đánh bắt khác nhau, tìm các loại cá khác nhau.",
      "start": 368.64,
      "end": 375.04,
      "n_words": 22,
      "start_frame": 9216,
      "end_frame": 9376,
      "keyframes": [
        "009231.webp",
        "009262.webp",
        "009293.webp",
        "009294.webp",
        "009332.webp",
        "009370.webp",
        "009371.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Nước bể chút thì giăng câu, đặt lờ, giăng lưới thưa ba màng.",
      "start": 375.04,
      "end": 379.36,
      "n_words": 13,
      "start_frame": 9376,
      "end_frame": 9484,
      "keyframes": [
        "009453.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nước rút là thời điểm cá đổ ngược ra kinh sau bao ngày xao sôi nảy nở trong đồng ruộng, lúc này cá nhiều vô số kể nên phải tận dụng mọi ngư cụ có được để đánh bắt.",
      "start": 379.36,
      "end": 391.76,
      "n_words": 39,
      "start_frame": 9484,
      "end_frame": 9794,
      "keyframes": [
        "009535.webp",
        "009536.webp",
        "009618.webp",
        "009700.webp",
        "009701.webp",
        "009745.webp",
        "009790.webp",
        "009791.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Vào những ngày cá ra kinh Vĩnh Tế và các nhánh kinh phụ như Trà Sư, Tha Lạc, bốn tám thuyền bè đông như trảy hội.",
      "start": 391.76,
      "end": 407.84,
      "n_words": 26,
      "start_frame": 9794,
      "end_frame": 10196,
      "keyframes": [
        "009920.webp",
        "010050.webp",
        "010080.webp",
        "010115.webp",
        "010150.webp",
        "010180.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Là đập Trà Sư, một trong hai con đập mà chúng tôi vừa nhắc đến.",
      "start": 407.84,
      "end": 412.16,
      "n_words": 15,
      "start_frame": 10196,
      "end_frame": 10304,
      "keyframes": [
        "010232.webp",
        "010284.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đập Trà Sư cùng với đập Tha Lạc đóng vai trò cửa ngõ quan trọng với mục đích kiểm soát lưu lượng dòng chảy.",
      "start": 412.16,
      "end": 419.2,
      "n_words": 24,
      "start_frame": 10304,
      "end_frame": 10480,
      "keyframes": [
        "010314.webp",
        "010365.webp",
        "010416.webp",
        "010417.webp",
        "010451.webp"
      ],
      "keyframe_count": 5
    },
    {
