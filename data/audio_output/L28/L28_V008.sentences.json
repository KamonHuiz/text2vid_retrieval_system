    },
    {
      "text": "Đang tìm đến một con kênh hết sức đặc biệt, con kênh mang tên một vị nguyên thủ quốc gia: kinh T5, hay còn được gọi kinh Võ Văn Kiệt.",
      "start": 756.08,
      "end": 767.16,
      "n_words": 30,
      "start_frame": 18902,
      "end_frame": 19179,
      "keyframes": [
        "019003.webp",
        "019140.webp",
        "019170.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nhìn cánh đồng lúaCần Giuộc ven biên bạc ngàn một màu xanh như thế này, khó ai có thể hình dung nơi đây ba mươi năm trước từng được mệnh danh là vùng túi phèn đất hoang vu.",
      "start": 767.16,
      "end": 781.92,
      "n_words": 38,
      "start_frame": 19179,
      "end_frame": 19548,
      "keyframes": [
        "019190.webp",
        "019210.webp",
