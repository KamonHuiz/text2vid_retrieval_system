        "019430.webp",
        "019431.webp",
        "019478.webp",
        "019525.webp",
        "019526.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "\"Đó, ông bà cũ hồi trước mở sạ lúa mùa, còn bây giờ kinh này coi như đây là của dân ba trúc không à.",
      "start": 782.2,
      "end": 792.88,
      "n_words": 25,
      "start_frame": 19555,
      "end_frame": 19822,
      "keyframes": [
        "019556.webp",
