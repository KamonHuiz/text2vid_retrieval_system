        "021784.webp",
        "021812.webp",
        "021813.webp",
        "021842.webp",
        "021871.webp",
        "021872.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Tháng 7 năm 1996, Thủ tướng Võ Văn Kiệt quyết định mở tuyến kênh T5, con kênh với chiều dài 48 km, gần 40 m sau từ 3.5 đến 4 m.",
      "start": 875.6,
      "end": 889.36,
      "n_words": 31,
      "start_frame": 21890,
      "end_frame": 22234,
      "keyframes": [
        "021911.webp",
        "021950.webp",
        "021951.webp",
        "021995.webp",
        "022040.webp",
        "022070.webp",
        "022136.webp",
        "022202.webp",
        "022226.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Điểm đầu tuyến kênh này tiếp giáp với kênh Vĩnh Tế tại phàm T5 và kết thúc tại cống Tuần Thống tỉnh Kiên Giang.",
      "start": 889.36,
      "end": 897.24,
      "n_words": 24,
      "start_frame": 22234,
      "end_frame": 22431,
      "keyframes": [
        "022265.webp",
        "022304.webp",
        "022335.webp",
        "022372.webp",
        "022409.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nhiệm vụ đặt ra là phải hoàn thành trước khi nước lũ đầu nguồn đổ về, một khối lượng công việc khổng lồ nhưng phải hoàn thành trong thời gian bốn tháng.",
      "start": 897.24,
      "end": 906.68,
      "n_words": 32,
      "start_frame": 22431,
      "end_frame": 22667,
      "keyframes": [
        "022438.webp",
        "022536.webp",
        "022635.webp",
        "022665.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "\"Mần ruộng phải có kinh dân mừng dữ dằn lắm.",
      "start": 906.68,
      "end": 910.32,
      "n_words": 10,
      "start_frame": 22667,
      "end_frame": 22758,
      "keyframes": [
        "022708.webp",
        "022752.webp",
        "022753.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Coi như là đi phèn, nhờ có mưa gọi đầu phèn ở trên gõ xuống mình mần mới được có ăn chứ là không có kinh cũng mần không giờ có ăn được.",
      "start": 910.32,
      "end": 923.36,
      "n_words": 33,
      "start_frame": 22758,
      "end_frame": 23084,
      "keyframes": [
        "022797.webp",
        "022841.webp",
        "022842.webp",
        "022964.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khi đào kinh mở ra đó chú như vậy thì cánh đồng mình ở đây mỗi năm có thể làm được mấy vụ?",
      "start": 923.36,
      "end": 928.4,
      "n_words": 23,
      "start_frame": 23084,
      "end_frame": 23210,
      "keyframes": [
        "023087.webp",
        "023088.webp",
        "023126.webp",
        "023165.webp",
        "023166.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hiện nay thì coi như là coi như là ba vụ.",
      "start": 928.4,
      "end": 930.8,
      "n_words": 11,
      "start_frame": 23210,
      "end_frame": 23270,
      "keyframes": [
        "023214.webp",
        "023262.webp",
        "023263.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ hiện nay mần thì một vụ cắt một công từ một tấn ăn lên tấn hai có tiền nữa mà con lớn lên mần mới là mình mới có mua thêm\".",
      "start": 930.8,
      "end": 945.64,
      "n_words": 33,
      "start_frame": 23270,
      "end_frame": 23641,
      "keyframes": [
        "023306.webp",
        "023349.webp",
        "023350.webp",
        "023396.webp",
        "023442.webp",
        "023443.webp",
        "023499.webp",
        "023555.webp",
        "023556.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Con kênh Hoàng Thành dòng nước kinh tế chạy băng băng vào Tây Nam bộ tỉnh Kiên Giang rồi rủ ra biển Tây, cú sức sống mới đã bừng lên trên vùng đất biên cương vốn là túi phèn.",
      "start": 945.64,
      "end": 956.96,
      "n_words": 39,
      "start_frame": 23641,
      "end_frame": 23924,
      "keyframes": [
        "023677.webp",
        "023798.webp",
        "023828.webp",
        "023846.webp",
        "023865.webp",
        "023866.webp",
        "023888.webp",
        "023911.webp",
        "023912.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Khoan quá dùng kênh ba nước ngọt về biến vùng đất chua thành bờ xôi ruộng mật, từ đó mở ra cuộc sống tươi đẹp cho người dân xứ này.",
      "start": 956.96,
      "end": 966.68,
      "n_words": 30,
      "start_frame": 23924,
      "end_frame": 24167,
      "keyframes": [
        "023952.webp",
        "023993.webp",
        "023994.webp",
        "024035.webp",
        "024076.webp",
        "024077.webp",
        "024106.webp",
        "024136.webp",
        "024137.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "\"Thì ổng đứng ra ổng kêu làm thì kêu kinh của ổng luôn chứ sao.",
      "start": 966.68,
      "end": 972.44,
      "n_words": 15,
      "start_frame": 24167,
      "end_frame": 24311,
      "keyframes": [
        "024184.webp",
        "024231.webp",
        "024232.webp",
        "024276.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Giờ cái dòng nước này nè dẫn về rồi mới kinh nhỏ kinh độ chia ra đó, rồi cái mới khai thác nó rút phèn.",
      "start": 972.44,
      "end": 980.24,
      "n_words": 25,
      "start_frame": 24311,
      "end_frame": 24506,
      "keyframes": [
        "024320.webp",
        "024321.webp",
        "024408.webp",
        "024495.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Có con kinh này lên đất phèn lại trở thành đồng ruộng hết, quá mừng là có dòng nước ngọt\".",
      "start": 980.24,
      "end": 986.48,
      "n_words": 20,
      "start_frame": 24506,
      "end_frame": 24662,
      "keyframes": [
        "024524.webp",
        "024572.webp",
        "024620.webp",
        "024621.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cái dân tứ xứ đó, khu này dân giàu không, tứ giác Long Xuyên cũng từ đó đã vươn vai trở thành một trong hai vùng trọng điểm sản xuất lúa của đồng bằng sông Cửu Long.",
      "start": 986.48,
      "end": 1004.72,
      "n_words": 37,
      "start_frame": 24662,
      "end_frame": 25118,
      "keyframes": [
        "024709.webp",
        "024798.webp",
        "024799.webp",
        "024837.webp",
        "024875.webp",
        "024876.webp",
        "024925.webp",
        "024975.webp",
        "024976.webp",
        "025030.webp",
        "025085.webp",
        "025116.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Người nhờ đất để sống, đất nhờ người có tên.",
      "start": 1004.72,
      "end": 1008.92,
      "n_words": 10,
      "start_frame": 25118,
      "end_frame": 25223,
      "keyframes": [
        "025140.webp",
        "025165.webp",
        "025166.webp",
        "025199.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Người dân đất này đã thương quý gọi kênh T5 là kênh Ông Kiệt.",
      "start": 1008.92,
      "end": 1013.28,
      "n_words": 14,
      "start_frame": 25223,
      "end_frame": 25332,
      "keyframes": [
        "025232.webp",
