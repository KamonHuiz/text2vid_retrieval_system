        "001862.webp",
        "001863.webp",
        "001896.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thất Sơn nổi tiếng với những nét văn hóa đặc thù của người dân.",
      "start": 76.0,
      "end": 81.52,
