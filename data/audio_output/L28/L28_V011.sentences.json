        "006185.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Còn đây cũng là một trái cây đặc trưng chỉ có ở vùng Bảy Núi An Giang.",
      "start": 263.52,
      "end": 268.84,
      "n_words": 17,
      "start_frame": 6588,
      "end_frame": 6721,
