        "007207.webp",
        "007248.webp",
        "007249.webp"
      ],
      "keyframe_count": 24
    },
    {
      "text": "Những ngày đầu mùa mưa này, đi dọc các con đường ở Tri Tôn, những con đường vòng quanh núi, không khó để bắt gặp hình ảnh những cây trầm trĩu cành.",
      "start": 290.72,
      "end": 302.36,
      "n_words": 32,
      "start_frame": 7268,
      "end_frame": 7559,
      "keyframes": [
