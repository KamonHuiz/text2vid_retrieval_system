      "start_frame": 5740,
      "end_frame": 5944,
      "keyframes": [
        "005820.webp",
        "005913.webp",
        "005914.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Biệt của loại trái gia vị này đã làm nên nhiều món ăn đặc sản của vùng Bảy Núi.",
      "start": 238.72,
      "end": 248.48,
