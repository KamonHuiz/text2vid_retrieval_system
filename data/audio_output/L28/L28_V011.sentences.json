      "start_frame": 11205,
      "end_frame": 11496,
      "keyframes": [
        "011254.webp",
        "011307.webp",
        "011308.webp",
        "011376.webp",
        "011444.webp",
        "011445.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng tôi xuôi về thị trấn Ba Chúc, một thị trấn nằm nép mình dưới chân Ngọa Long Sơn.",
      "start": 459.84,
