        "007745.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Một trong những yếu tố góp phần để lưu dân đến và định cư lại vùng Bảy Núi Tri Tôn này, một phần là họ khai thác những sản vật từ núi.",
      "start": 310.92,
      "end": 322.8,
      "n_words": 32,
