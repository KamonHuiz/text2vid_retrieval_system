      ],
      "keyframe_count": 5
    },
    {
      "text": "Thất Sơn còn được biết đến những dấu ấn lịch sử cùng những truyền thuyết kỳ bí.",
      "start": 81.52,
      "end": 88.16,
      "n_words": 17,
