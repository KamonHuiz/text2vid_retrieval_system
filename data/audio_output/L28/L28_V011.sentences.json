        "027665.webp",
        "027666.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Từ đó hình thành những tính cách đặc biệt của con người: bao dung, hào hiệp, trượng nghĩa.",
      "start": 1106.92,
