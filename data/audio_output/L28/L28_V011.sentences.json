        "022289.webp",
        "022360.webp",
        "022385.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng nó lùa người dân ra đồng trống sau đó tha hồ bắn giết hết thế này tới thế khác.",
      "start": 895.92,
      "end": 903.88,
      "n_words": 20,
      "start_frame": 22398,
      "end_frame": 22597,
      "keyframes": [
        "022515.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đánh đuổi chúng xong bà con cố gắng thu gom hài cốt người vô tội nhưng không xuể, mùa nước nổi tràn về rồi rút xuống, nhìn cánh đồng như ruộng dưa hấu sắp đến ngày thu hoạch nhưng chẳng phải dưa hấu gì đâu.",
      "start": 903.88,
