        "025955.webp",
        "025994.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Từ khi có chùa, người dân bắt đầu đổ về sinh sống, nơi này trở nên đông vui.",
      "start": 1040.24,
