        "021934.webp",
        "021979.webp",
        "022025.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nhưng rồi mỗi cái hang cũng bị phát hiện ra.",
      "start": 881.44,
      "end": 884.64,
      "n_words": 10,
      "start_frame": 22036,
      "end_frame": 22116,
      "keyframes": [
        "022050.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Núi yêu thương dân mình, núi ra sức chở che cho dân mình nhưng núi bất lực trước sự hung tợn của bầy quỷ dữ.",
      "start": 884.64,
