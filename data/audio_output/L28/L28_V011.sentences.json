      "n_words": 19,
      "start_frame": 11496,
      "end_frame": 11648,
      "keyframes": [
        "011539.webp",
        "011633.webp",
        "011634.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngọn núi được gọi với cái tên gần gũi Núi Tượng.",
      "start": 465.92,
      "end": 471.2,
      "n_words": 11,
      "start_frame": 11648,
      "end_frame": 11780,
      "keyframes": [
        "011690.webp",
        "011747.webp",
        "011748.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Người dân Ba Chúc đa phần theo đạo Tứ Ân Hiếu Nghĩa là một tôn giáo bản địa do Đức Bổn Sư Ngô Lợi sáng lập vào cuối thế kỷ 19.",
      "start": 471.2,
      "end": 480.28,
      "n_words": 31,
      "start_frame": 11780,
      "end_frame": 12007,
      "keyframes": [
        "011818.webp",
        "011889.webp",
        "011890.webp",
        "011951.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ông là sĩ phu của phong trào Cần Vương bị giặc truy đuổi, ông chạy vào vùng Thất Sơn để ẩn thân.",
      "start": 481.6,
      "end": 491.44,
      "n_words": 22,
      "start_frame": 12040,
      "end_frame": 12286,
      "keyframes": [
        "012066.webp",
        "012119.webp",
        "012120.webp",
        "012192.webp",
        "012265.webp",
        "012266.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tứ Ân Hiếu Nghĩa là chi phái tôn giáo ảnh hưởng của Phật giáo và Đạo giáo với tôn chỉ tôn nhân học Phật và đường hướng hành đạo hành tứ ân, sống hiếu nghĩa.",
      "start": 491.44,
      "end": 506.2,
      "n_words": 35,
      "start_frame": 12286,
