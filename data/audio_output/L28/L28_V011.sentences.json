        "008055.webp",
        "008056.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trước đây thì người ta làm ruộng rất khó khăn cho nên bà con sống ở đây là họ đi rừng đi núi để hái măng, để bẻ những trái cây, để hái rau và những sản vật đó giúp cho họ có thể sống qua ngày.",
      "start": 322.8,
      "end": 338.08,
      "n_words": 47,
      "start_frame": 8070,
      "end_frame": 8452,
      "keyframes": [
        "008083.webp",
