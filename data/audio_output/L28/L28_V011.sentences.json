        "008903.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "So với các tỉnh trong vùng đồng bằng sông Cửu Long, An Giang sở hữu vị trí địa lý vô cùng đặc biệt.",
      "start": 359.44,
      "end": 365.68,
      "n_words": 23,
      "start_frame": 8986,
      "end_frame": 9142,
      "keyframes": [
        "009015.webp",
        "009128.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thiên nhiên đã ban tặng cho vùng đất đầu nguồn này rất nhiều ngọn núi lớn nhỏ giữa vùng đồng bằng châu thổ.",
      "start": 365.68,
      "end": 372.76,
      "n_words": 23,
