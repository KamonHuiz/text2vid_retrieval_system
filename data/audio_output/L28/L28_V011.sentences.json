        "018049.webp",
        "018126.webp",
        "018338.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Có lẽ trước biến cố sinh tồn, niềm tin tôn giáo đã trỗi dậy trong tâm thức người dân.",
      "start": 735.04,
      "end": 740.76,
      "n_words": 19,
      "start_frame": 18376,
      "end_frame": 18519,
      "keyframes": [
        "018395.webp",
        "018482.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Họ kéo nhau vào chùa rất đông với mong muốn Đức Phật sẽ chở che cho họ.",
      "start": 740.76,
      "end": 746.08,
      "n_words": 17,
      "start_frame": 18519,
      "end_frame": 18652,
      "keyframes": [
        "018569.webp",
        "018570.webp",
        "018626.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thế nhưng chùa Phi Lai là một trong những địa điểm bị phá hủy nặng nề nhất, nơi đây bọn Pol Pot đã giết gần 300 người dân vô tội.",
      "start": 746.08,
      "end": 760.76,
      "n_words": 30,
      "start_frame": 18652,
      "end_frame": 19019,
      "keyframes": [
        "018683.webp",
        "018684.webp",
        "018728.webp",
        "018772.webp",
        "018773.webp",
        "018830.webp",
        "018888.webp",
        "018889.webp",
        "018928.webp",
        "018967.webp",
        "018968.webp",
        "019010.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Ta nói nghĩ giặc chiến tranh không có giết dân, thành ra tao không có đi giặc không giết dân giặc đánh giặc nhau giết dân mà là chú đi vô Tri Tôn trước đúng một ngày luôn, hả chú nói dắt bò đi bán bò đi.",
      "start": 760.76,
      "end": 780.84,
      "n_words": 47,
      "start_frame": 19019,
      "end_frame": 19521,
      "keyframes": [
        "019052.webp",
        "019053.webp",
        "019125.webp",
        "019198.webp",
        "019199.webp",
        "019274.webp",
        "019349.webp",
        "019350.webp",
        "019378.webp",
        "019406.webp",
        "019407.webp",
        "019445.webp",
        "019484.webp",
        "019485.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Ngồi cùng chúng tôi nơi chùa Phi Lai lúc này những người may mắn thoát chết trong cuộc thảm sát của 12 ngày đêm địa ngục năm ấy.",
      "start": 780.84,
      "end": 789.88,
      "n_words": 28,
      "start_frame": 19521,
      "end_frame": 19747,
      "keyframes": [
        "019547.webp",
        "019610.webp",
        "019611.webp",
        "019677.webp",
        "019744.webp",
        "019745.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đó là những ngày tháng mà mỗi một con người xứ này đều không ai quên được.",
      "start": 789.88,
      "end": 795.28,
      "n_words": 17,
      "start_frame": 19747,
      "end_frame": 19882,
      "keyframes": [
        "019857.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ngày ấy các ông chỉ hơn 20 tuổi quánh vô đây, hàng rào đánh mưa pháo vô lê chia quánh vô tấn công ngày 23 giác rồi chạy xuống Tri Tôn chạy đi chạy đi, có nơi nương tựa thì sống được, à không có chết mà người không có nương tựa thì bắt buộc phải trở về đây.",
      "start": 795.28,
      "end": 821.8,
      "n_words": 59,
      "start_frame": 19882,
      "end_frame": 20545,
      "keyframes": [
        "019969.webp",
        "019970.webp",
        "020049.webp",
        "020128.webp",
        "020129.webp",
        "020213.webp",
        "020297.webp",
        "020298.webp",
        "020366.webp",
        "020435.webp",
        "020436.webp",
        "020479.webp",
        "020522.webp",
        "020523.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Thời gian rồi trở về cũng đâu có tháng gì thì ra người ta cũng thu gọn chiến trường hết rồi, đốt còn về còn về tới thì tiêu điều, mấy người chạy trên núi mà nó vẫn lên nó giết, có lỡ lên săn lùng trên núi tới đâu là giết tới đó.",
      "start": 821.8,
