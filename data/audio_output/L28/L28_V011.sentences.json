      "n_words": 40,
      "start_frame": 10767,
      "end_frame": 11205,
      "keyframes": [
        "010813.webp",
        "010871.webp",
        "010872.webp",
        "010903.webp",
        "010935.webp",
        "010936.webp",
        "010962.webp",
