        "007525.webp",
        "007541.webp",
        "007558.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Sức sống khá cao, dù ở các vùng đất khô cằn vẫn có thể sinh trưởng và phát triển tốt.",
      "start": 304.12,
