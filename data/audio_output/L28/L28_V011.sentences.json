        "016173.webp",
        "016211.webp",
        "016212.webp",
        "016286.webp",
        "016360.webp",
        "016361.webp",
        "016390.webp",
        "016420.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Những con số biết nói, mỗi con số là một người con của đất này đã ra đi trong những ngày tháng đó.",
      "start": 657.24,
      "end": 666.44,
      "n_words": 23,
      "start_frame": 16431,
      "end_frame": 16661,
      "keyframes": [
        "016446.webp",
        "016466.webp",
        "016487.webp",
        "016513.webp",
        "016633.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Không thể định danh, chỉ có thể phân loại bằng độ tuổi, cũng có khi không thể phân loại bằng độ tuổi, cũng có lúc số tuổi được tính bằng ngày.",
      "start": 666.44,
      "end": 685.24,
      "n_words": 31,
      "start_frame": 16661,
      "end_frame": 17131,
      "keyframes": [
        "016754.webp",
        "016779.webp",
        "016816.webp",
        "016854.webp",
        "016879.webp",
        "016960.webp",
        "017042.webp",
        "017043.webp",
        "017078.webp",
        "017113.webp",
        "017114.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Ở chùa Phi Lai có những vết máu hình bàn tay, bàn tay của đứa trẻ sơ sinh.",
      "start": 685.24,
      "end": 690.8,
      "n_words": 18,
      "start_frame": 17131,
      "end_frame": 17270,
      "keyframes": [
        "017158.webp",
        "017203.webp",
        "017228.webp",
        "017259.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Còn đau khổ những bàn tay nhỏ xíu như đang bóp nghẹt trái tim ta.",
      "start": 690.8,
      "end": 695.92,
      "n_words": 15,
      "start_frame": 17270,
      "end_frame": 17398,
      "keyframes": [
        "017291.webp",
        "017317.webp",
        "017392.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Có lẽ vì thế mà nhà thơ Trịnh Hữu Hoài Sinh thời đã không nén nổi nước mắt và viết bài thơ: \"Dệt máu hình bàn tay khi giếng chùa Phi Lai trước mặt mình, sao ngỡ trong mơ những dệt máu hình bàn tay trẻ nhỏ, em đâu rồi mà bàn tay còn đó, ôi bàn tay xinh xắn để nâng niu để dỗ reo vui để thả cánh diều, chợt giật đến bàn tay em ướt máu\".",
      "start": 695.92,
      "end": 735.04,
      "n_words": 79,
      "start_frame": 17398,
      "end_frame": 18376,
      "keyframes": [
        "017468.webp",
        "017494.webp",
        "017614.webp",
        "017735.webp",
        "017760.webp",
