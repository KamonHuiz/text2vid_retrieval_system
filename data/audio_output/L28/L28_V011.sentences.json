        "012501.webp",
        "012556.webp",
        "012557.webp",
        "012597.webp",
        "012637.webp",
        "012638.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Trong đó, Tứ Đại Trọng Ân có nghĩa là ân tổ tiên cha mẹ, ân quốc vương thủy thổ, ân tam bảo bao gồm Phật, Pháp, Tăng, ân đồng bào và nhân loại.",
      "start": 506.2,
      "end": 518.96,
      "n_words": 33,
      "start_frame": 12655,
      "end_frame": 12974,
      "keyframes": [
        "012698.webp",
        "012759.webp",
        "012784.webp",
        "012843.webp",
        "012903.webp",
        "012929.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Còn hiếu là hiếu thảo với ông bà tổ tiên, nghĩa là nghĩa vụ với đức, nghĩa vụ với đất nước đồng bào.",
      "start": 518.96,
      "end": 527.8,
      "n_words": 23,
      "start_frame": 12974,
      "end_frame": 13195,
      "keyframes": [
        "012982.webp",
        "013035.webp",
        "013060.webp",
        "013117.webp",
        "013175.webp",
        "013176.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chùa Tam Bửu, cái nôi của đạo Tứ Ân Hiếu Nghĩa nép mình sát chân núi Tượng tại thị trấn Ba Chúc, huyện Tri Tôn, tỉnh An Giang.",
      "start": 527.8,
      "end": 537.96,
      "n_words": 28,
      "start_frame": 13195,
      "end_frame": 13449,
      "keyframes": [
        "013254.webp",
        "013332.webp",
        "013333.webp",
        "013386.webp",
        "013439.webp",
        "013440.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đây là một trong bốn di tích thuộc cụm di tích kiến trúc lịch sử cấp quốc gia được công nhận vào năm 1980 bao gồm chùa Tam Bửu, núi Tượng, chùa Phi Lai và nhà mồ tập thể nạn nhân của bọn diệt chủng Pol Pot.",
      "start": 537.96,
      "end": 555.68,
      "n_words": 47,
      "start_frame": 13449,
      "end_frame": 13892,
      "keyframes": [
        "013558.webp",
        "013676.webp",
        "013677.webp",
        "013775.webp",
        "013874.webp",
        "013875.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cụm quần thể Ba Chúc cũng là một địa điểm mà khi vừa đặt chân đến chúng tôi đã bị cảm xúc đau buồn xâm chiếm, nỗi buồn dường như lan đến tận mao mạch tâm trạng.",
      "start": 555.68,
      "end": 576.8,
      "n_words": 37,
      "start_frame": 13892,
      "end_frame": 14420,
      "keyframes": [
        "013972.webp",
        "014069.webp",
        "014070.webp",
        "014089.webp",
        "014109.webp",
        "014134.webp",
        "014147.webp",
        "014160.webp",
        "014236.webp",
        "014249.webp",
        "014262.webp",
        "014287.webp",
        "014300.webp",
        "014313.webp",
        "014340.webp",
        "014375.webp",
        "014410.webp",
        "014411.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Nỗi buồn của bất kỳ một người con Việt Nam nào khi đặt chân lên vùng này cũng đều cảm thấy.",
      "start": 576.8,
      "end": 581.88,
      "n_words": 21,
      "start_frame": 14420,
      "end_frame": 14547,
      "keyframes": [
        "014447.webp",
        "014484.webp",
        "014509.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong chiến tranh biên giới Tây Nam, vùng Ba Chúc gắn với lịch sử đau thương trong 12 ngày chiếm đóng Ba Chúc.",
      "start": 588.04,
      "end": 595.2,
      "n_words": 23,
      "start_frame": 14701,
      "end_frame": 14880,
      "keyframes": [
        "014752.webp",
        "014777.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Từ ngày 18 đến 30/04/1978, quân diệt chủng Pol Pot đã giết hại 3.157 dân thường vô tội, đa phần là tín đồ của đạo Tứ Ân Hiếu Nghĩa.",
      "start": 595.2,
      "end": 614.0,
      "n_words": 29,
      "start_frame": 14880,
      "end_frame": 15350,
      "keyframes": [
        "014917.webp",
        "015057.webp",
        "015082.webp",
        "015179.webp",
        "015276.webp",
        "015277.webp",
        "015319.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tôi đã rất nhiều lần về Ba Chúc.",
      "start": 614.0,
      "end": 618.88,
      "n_words": 8,
      "start_frame": 15350,
      "end_frame": 15472,
      "keyframes": [
        "015362.webp",
        "015386.webp",
        "015413.webp",
        "015441.webp",
        "015466.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bước vào cái khu vực nhà mồ, nhìn thấy những hình ảnh tư liệu mà còn lưu lại phải nói là sở gai ốc.",
      "start": 619.84,
      "end": 628.6,
      "n_words": 24,
      "start_frame": 15496,
      "end_frame": 15715,
      "keyframes": [
        "015503.webp",
        "015541.webp",
        "015542.webp",
        "015588.webp",
        "015635.webp",
        "015636.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Điểm nhấn công trình nhà mồ Ba Chúc hiện tại được thiết kế hình hoa sen úp ngược với tám cánh hoa sen được sơn màu trắng.",
      "start": 628.6,
      "end": 636.84,
      "n_words": 27,
      "start_frame": 15715,
      "end_frame": 15921,
      "keyframes": [
        "015739.webp",
        "015842.webp",
        "015867.webp",
        "015902.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mỗi cánh hoa sen là nơi trưng bày một nhóm hài cốt, nhóm hài cốt theo độ tuổi, giới tính khác nhau, cảm thấy hết sức là khủng khiếp, hết sức là kinh hoàng, không nghĩ là con người với nhau mà họ có thể đối xử một cách tàn bạo đến vậy.",
      "start": 636.84,
      "end": 657.24,
      "n_words": 53,
      "start_frame": 15921,
      "end_frame": 16431,
      "keyframes": [
        "015938.webp",
        "015963.webp",
        "016013.webp",
        "016063.webp",
        "016064.webp",
