        "021683.webp",
        "021684.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Người dân nơi đây xem hang đá trên rừng núi Tượng như ngôi nhà thứ hai của họ.",
      "start": 867.52,
      "end": 872.92,
