      "keyframe_count": 24
    },
    {
      "text": "Dường như trong mạch sống của rừng núi vùng biên giới Tây Nam tổ quốc đã sản sinh ra nhiều sản vật đậm đà bản sắc, từ đó tiếp tục tạo nên một tinh hoa văn hóa ẩm thực.",
      "start": 213.36,
      "end": 229.6,
      "n_words": 39,
