        "005858.webp",
        "005887.webp",
        "005916.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ông và những ca khúc của mình mang đến cho chúng ta bức tranh của vùng quê sông nước hiền hòa với góc nhìn lát cắt đầy chất thơ.",
      "start": 237.24,
      "end": 245.44,
      "n_words": 29,
      "start_frame": 5931,
      "end_frame": 6136,
      "keyframes": [
        "005946.webp",
        "006068.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Vùng đất ở trung tâm châu thổ sông Cửu Long như tấm lòng người mẹ chở.",
      "start": 245.44,
      "end": 258.88,
      "n_words": 16,
      "start_frame": 6136,
      "end_frame": 6472,
      "keyframes": [
        "006191.webp",
        "006221.webp",
        "006279.webp",
        "006338.webp",
        "006339.webp",
        "006388.webp",
        "006438.webp",
        "006468.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trên tổng chiều dài hơn 235 km, đoạn sông Hậu ghé qua Hậu Giang chỉ vỏn vẹn 8 km nhưng đã mang đến cho nơi này một diện mạo rất riêng.",
      "start": 258.88,
      "end": 271.52,
      "n_words": 31,
      "start_frame": 6472,
      "end_frame": 6788,
      "keyframes": [
        "006599.webp",
        "006731.webp",
        "006757.webp",
        "006781.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nằm bên bờ Hậu Giang, khu công nghiệp Sông Hậu nơi sông mẹ chảy qua có cảng Vinalines Hậu Giang là cảng biển quốc tế đóng vai trò quan trọng trong kết nối logistics của toàn vùng Tây Nam Bộ.",
      "start": 271.52,
      "end": 286.4,
      "n_words": 40,
      "start_frame": 6788,
      "end_frame": 7160,
      "keyframes": [
        "006805.webp",
        "006835.webp",
        "006893.webp",
        "006951.webp",
        "006952.webp",
        "007005.webp",
        "007058.webp",
        "007059.webp",
        "007091.webp",
        "007124.webp",
        "007154.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Tận dụng và khai thác những yếu tố thiên thời địa lợi mà sông Hậu mang đến, Hậu Giang đã phát huy tối đa tiềm năng để phát triển công nghiệp, lấy công nghiệp làm bệ đỡ cho nông nghiệp phát triển, đòn bẩy để thúc đẩy phát triển kinh tế xã hội ở địa phương.",
      "start": 286.4,
      "end": 301.6,
      "n_words": 56,
      "start_frame": 7160,
      "end_frame": 7540,
      "keyframes": [
        "007215.webp",
        "007277.webp",
        "007278.webp",
        "007319.webp",
        "007360.webp",
        "007361.webp",
        "007404.webp",
        "007447.webp",
        "007448.webp",
        "007492.webp",
        "007536.webp",
        "007537.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Đó cũng là một trong những lý do sau hơn 20 năm thành lập, Hậu Giang từ một tỉnh thiếu thốn về hạ tầng kỹ thuật, nguồn nhân lực đã bứt phá trở thành địa phương có tốc độ tăng trưởng kinh tế đứng thứ hai cả nước theo số liệu thống kê năm 2023.",
      "start": 301.6,
      "end": 315.0,
      "n_words": 55,
      "start_frame": 7540,
      "end_frame": 7875,
      "keyframes": [
        "007577.webp",
        "007618.webp",
