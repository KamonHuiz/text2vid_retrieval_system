        "002876.webp",
        "002909.webp",
        "002938.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Sông tiếp tục bước vào tỉnh Hậu Giang.",
      "start": 118.4,
      "end": 124.72,
      "n_words": 8,
      "start_frame": 2960,
