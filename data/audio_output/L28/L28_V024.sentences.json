        "003547.webp",
        "003604.webp",
        "003634.webp",
        "003671.webp",
        "003709.webp",
        "003740.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Hậu Giang nằm ở trung tâm tiểu vùng Tây sông Hậu, tỉnh nhỏ luôn nuôi khát vọng lớn.",
      "start": 149.92,
      "end": 159.04,
      "n_words": 18,
      "start_frame": 3748,
      "end_frame": 3976,
      "keyframes": [
        "003777.webp",
        "003814.webp",
        "003844.webp",
        "003889.webp",
        "003935.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "20 năm vươn mình phát triển, Hậu Giang luôn là nguồn cảm hứng để nhiều văn nghệ sĩ tài hoa sáng tác nên nhiều tác phẩm đặc sắc, những tác phẩm về tình yêu quê hương, về những danh thắng, những nội lực của một vùng quê sông nước căng tràn sức sống.",
      "start": 159.04,
      "end": 175.28,
      "n_words": 53,
      "start_frame": 3976,
      "end_frame": 4382,
      "keyframes": [
        "003999.webp",
        "004030.webp",
        "004061.webp",
        "004062.webp",
        "004103.webp",
        "004144.webp",
        "004145.webp",
        "004262.webp",
        "004379.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Sức sống Hậu Giang là một địa bàn sông nước chằng chịt, các con sông, con kênh đều nối nhau phục vụ cho việc đi lại cũng như hoạt động sản xuất của người dân.",
      "start": 175.28,
      "end": 187.84,
      "n_words": 35,
      "start_frame": 4382,
      "end_frame": 4696,
      "keyframes": [
        "004442.webp",
        "004479.webp",
        "004517.webp",
        "004518.webp",
        "004600.webp",
        "004683.webp",
        "004684.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Mái chèo khua nhịp nhạc khoan trên dòng kênh sáng, những đêm trăng về in bóng, đó là những cảm xúc mà tôi viết ca khúc này để giới thiệu với bạn bè một miền đất con người Hậu Giang đoàn kết, nghĩa tình thủy chung, năng động.",
      "start": 187.84,
      "end": 208.96,
      "n_words": 48,
      "start_frame": 4696,
      "end_frame": 5224,
      "keyframes": [
        "004755.webp",
        "004826.webp",
        "004991.webp",
        "005041.webp",
        "005092.webp",
        "005093.webp",
        "005127.webp",
        "005162.webp",
        "005163.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Xuất phát điểm từng là Chi cục trưởng Chi cục Kiểm lâm Hậu Giang và hiện cũng đang là phân hội phó phân hội âm nhạc thuộc Hội Văn học Nghệ thuật tỉnh, nhạc sĩ Nguyễn Vĩnh Phúc mỗi nơi đi qua đều là những điều quý báu được ông chắt chiu mang vào những sáng tác của mình, những sản phẩm âm nhạc mang đầy hơi thở của quê hương.",
      "start": 208.96,
      "end": 231.12,
      "n_words": 71,
      "start_frame": 5224,
      "end_frame": 5778,
      "keyframes": [
        "005304.webp",
        "005445.webp",
        "005480.webp",
        "005533.webp",
        "005587.webp",
        "005588.webp",
        "005662.webp",
        "005736.webp",
        "005766.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nhạc sĩ Nguyễn Vĩnh Phúc cũng chính là người sẽ kể cho chúng tôi những câu chuyện về quê hương Hậu Giang.",
      "start": 231.12,
      "end": 237.24,
      "n_words": 22,
      "start_frame": 5778,
      "end_frame": 5931,
      "keyframes": [
        "005797.webp",
