        "008680.webp",
        "008696.webp",
        "008726.webp"
      ],
      "keyframe_count": 24
    },
    {
      "text": "Tôi tìm đến chợ nổi Ngã Bảy, ngôi chợ nổi lớn nhất nhì vùng đồng bằng sông Cửu Long.",
      "start": 350.12,
      "end": 356.16,
      "n_words": 19,
      "start_frame": 8753,
