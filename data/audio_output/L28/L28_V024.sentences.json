        "009735.webp",
        "009778.webp",
        "009779.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nói chung là nó hình thành một cái văn hóa truyền thống rất là đẹp, đặc trưng của miền sông nước Tây Nam Bộ.",
      "start": 396.12,
      "end": 403.32,
      "n_words": 24,
      "start_frame": 9903,
