      "keyframes": [
        "008766.webp",
        "008807.webp",
        "008808.webp",
        "008846.webp",
        "008884.webp",
        "008885.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ngôi chợ trăm tuổi này được hình thành từ bảy nhánh kênh đào tỏa đi bảy ngã, đây cũng là nơi từng được gọi là kinh đô sông nước, là ngôi sao Phụng Hiệp và cũng là đầu mối giao thông thủy lớn nhất Nam Kỳ.",
      "start": 356.16,
      "end": 369.24,
      "n_words": 46,
