      ],
      "keyframe_count": 25
    },
    {
      "text": "Sông Hậu đổ vào Việt Nam tại xã Long Bình, huyện An Phú, tỉnh An Giang.",
      "start": 99.12,
      "end": 105.0,
      "n_words": 16,
