      "n_words": 22,
      "start_frame": 9452,
      "end_frame": 9622,
      "keyframes": [
        "009570.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nếu mà khoảng chừng bốn năm giờ sáng là chúng ta thấy ghe xuồng, bởi vì Ngã Bảy đây là từ bảy hướng: từ Cà Mau, Bạc Liêu lên Sóc Trăng qua rồi Kiên Giang xuống Cần Thơ.",
      "start": 384.88,
      "end": 396.12,
      "n_words": 38,
      "start_frame": 9622,
      "end_frame": 9903,
      "keyframes": [
        "009691.webp",
