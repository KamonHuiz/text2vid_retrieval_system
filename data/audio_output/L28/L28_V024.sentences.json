      "keyframes": [
        "009923.webp",
        "010067.webp",
        "010068.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ghe nhóm sông cầu, đầu cầu đậu một hai trăm chiếc xuồng á, mua đồ nhảy xuồng bơi về.",
      "start": 403.32,
      "end": 414.04,
      "n_words": 19,
      "start_frame": 10083,
      "end_frame": 10351,
      "keyframes": [
        "010171.webp",
        "010274.webp",
        "010275.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cháu có xuồng, cháu có ghe thì hồi đó ngày cũng đông rồi, xèo người ta dữ lắm.",
      "start": 414.04,
