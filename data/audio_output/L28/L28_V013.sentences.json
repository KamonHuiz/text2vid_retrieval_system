        "014283.webp",
        "014347.webp",
        "014348.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nơi này từng được biết đến với tên gọi \"Cồn Năm Không\" hay ấp 5 không: điện không, nước không, đường không, trường không, trạm không.",
      "start": 574.04,
      "end": 584.0,
      "n_words": 26,
      "start_frame": 14351,
      "end_frame": 14600,
      "keyframes": [
        "014372.webp",
        "014397.webp",
        "014398.webp",
        "014420.webp",
        "014443.webp",
        "014444.webp",
        "014517.webp",
        "014590.webp",
        "014591.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đó cũng là lý do giữa bốn bề sông nước này, cái nghề duy nhất nuôi sống người dân nơi đây là cái nghề đánh bắt con cá, con tôm.",
      "start": 584.0,
      "end": 592.84,
      "n_words": 30,
      "start_frame": 14600,
      "end_frame": 14821,
      "keyframes": [
        "014709.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Thầy ông ngoại, ông ngoại tới bà già rồi sống chung là cái con của bà này không chung là đó giờ sống nghề sông nước không à, cha truyền ông nối.",
      "start": 592.84,
      "end": 602.8,
      "n_words": 33,
      "start_frame": 14821,
      "end_frame": 15070,
      "keyframes": [
        "014827.webp",
        "014828.webp",
        "014907.webp",
        "014986.webp",
        "014987.webp",
        "015055.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Lập gia đình rồi có cái xuồng cột đuôi nè bơi ngang sông nè, giăng chài sáng đêm vậy đó; Còn từ từ dành dụm, dành dụm mua được cái ghe lặn ở dưới đó.",
      "start": 602.8,
      "end": 612.2,
      "n_words": 35,
      "start_frame": 15070,
      "end_frame": 15305,
      "keyframes": [
        "015124.webp",
        "015125.webp",
        "015240.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó, chài ghe Long Xuyên ngày ấy ở trên thì phố thị cũng khá là tấp nập, nhưng mà chỉ cần nhìn về hướng dòng sông Hậu thì chúng ta lập tức thấy được một cái ngư trường rất là nhộn nhịp của bà con làm nghề đánh bắt thủy sản.",
      "start": 612.2,
      "end": 627.24,
      "n_words": 51,
      "start_frame": 15305,
      "end_frame": 15681,
      "keyframes": [
        "015355.webp",
