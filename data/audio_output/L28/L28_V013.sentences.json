        "016277.webp",
        "016313.webp",
        "016350.webp",
        "016351.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cá linh, cá thiểu nhiều mất giống hết trơn luôn.",
      "start": 654.8,
      "end": 657.52,
      "n_words": 10,
      "start_frame": 16370,
