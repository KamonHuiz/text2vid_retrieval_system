        "016984.webp",
        "017014.webp",
        "017038.webp",
        "017063.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Vẫn còn sông, vẫn còn người, những vui buồn, những câu chuyện hờn trách vẫn là những bùi ngùi thổn thức.",
      "start": 683.6,
      "end": 692.56,
      "n_words": 21,
      "start_frame": 17090,
      "end_frame": 17314,
      "keyframes": [
        "017093.webp",
        "017101.webp",
        "017109.webp",
        "017138.webp",
        "017144.webp",
        "017150.webp",
