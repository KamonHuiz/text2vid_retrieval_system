        "010222.webp",
        "010243.webp",
        "010265.webp",
        "010295.webp",
        "010471.webp",
        "010648.webp",
        "010678.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Nằm trên dòng sông Hậu, giữa hai bờ Long Xuyên và Chợ Mới, cù lao Ông Hổ là nơi sinh ra người cộng sản kiên trung, nhà lãnh đạo kiệt xuất, người con ưu tú của quê hương An Giang - Chủ tịch Tôn Đức Thắng.",
      "start": 428.12,
      "end": 443.84,
      "n_words": 46,
      "start_frame": 10703,
      "end_frame": 11096,
      "keyframes": [
        "010734.webp",
