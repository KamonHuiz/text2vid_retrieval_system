        "012638.webp",
        "012664.webp",
        "012691.webp",
        "012720.webp",
        "012868.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "- Sông rất là rộng rồi phân ra những cái nhánh sông ôm ấp những cái cồn đất, và trước đây thì cái điều kiện tự nhiên đó nó làm cho cá mắm xanh sôi nảy nở rất là nhiều, và có những cái đoạn sông sâu ở đây thì người ta đánh bắt được những con cá rất là lớn và trở thành những cái huyền thoại.",
      "start": 515.56,
      "end": 533.08,
      "n_words": 68,
      "start_frame": 12889,
      "end_frame": 13327,
      "keyframes": [
        "013016.webp",
        "013017.webp",
        "013163.webp",
        "013309.webp",
        "013310.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nếu nói Mỹ Hòa Hưng là một cù lao xanh mát trong lòng phố thì Mỹ Thạnh, hay còn gọi là Cồn Phó Ba, lại là cù lao trong lòng cù lao.",
      "start": 533.08,
      "end": 544.92,
      "n_words": 32,
      "start_frame": 13327,
      "end_frame": 13623,
      "keyframes": [
        "013357.webp",
