        "012370.webp",
        "012392.webp",
        "012393.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Nơi đây chúng tôi tìm thấy được sự hiền hòa bình an ngay giữa nhịp thở ồn ào của sông.",
      "start": 496.32,
      "end": 502.48,
      "n_words": 20,
      "start_frame": 12408,
      "end_frame": 12562,
      "keyframes": [
        "012425.webp",
        "012457.webp",
        "012458.webp",
        "012498.webp",
        "012539.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng tôi có thể ngắm một góc sông Hậu, nhìn phố thị Long Xuyên sầm uất năng động, một sự giao thoa thú vị giữa miệt vườn sông nước hiền hòa và thành phố văn minh phát triển.",
      "start": 502.48,
      "end": 515.56,
      "n_words": 38,
      "start_frame": 12562,
      "end_frame": 12889,
      "keyframes": [
        "012569.webp",
