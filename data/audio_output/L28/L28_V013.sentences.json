        "018153.webp",
        "018154.webp",
        "018208.webp"
      ],
      "keyframe_count": 34
    },
    {
      "text": "- Ở sông mình cá này nhiều không?",
      "start": 729.28,
      "end": 731.96,
      "n_words": 8,
      "start_frame": 18232,
      "end_frame": 18299,
      "keyframes": [
        "018263.webp",
        "018264.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mỗi lần mà bắt con cá tra dầu này là con bự nhất khoảng mấy ký?",
      "start": 731.96,
      "end": 735.72,
      "n_words": 16,
      "start_frame": 18299,
      "end_frame": 18393,
      "keyframes": [
        "018318.webp",
        "018372.webp",
        "018373.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Chú lại không vậy hả? À cái giống cá nó vậy ha. - Còn cá bự ở sông mình là có loại cá gì hả?",
      "start": 735.72,
      "end": 747.04,
      "n_words": 26,
      "start_frame": 18393,
      "end_frame": 18676,
      "keyframes": [
        "018406.webp",
        "018439.webp",
        "018440.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Dạ đó giờ câu lưới ở dòng này chú có bắt được con cá hô nào đó, bắt cá hô mấy chục ký lô hả?",
