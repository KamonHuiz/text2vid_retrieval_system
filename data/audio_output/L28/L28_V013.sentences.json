        "020038.webp",
        "020039.webp",
        "020085.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Đó là những cụm từ thường được nghe thường xuyên khi nói về sự cạn kiệt thủy sản.",
      "start": 804.6,
