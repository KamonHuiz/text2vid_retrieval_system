      "keyframes": [
        "011938.webp",
        "011939.webp",
        "012017.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vì Chủ tịch đáng kính, chúng tôi ôm trọn một vòng Cù lao Ông Hổ, cảm nhận được sự xanh mát bình yên của vùng cù lao biệt lập nằm trong lòng đô thị Long Xuyên sôi động.",
      "start": 481.4,
      "end": 496.32,
      "n_words": 38,
      "start_frame": 12035,
      "end_frame": 12408,
      "keyframes": [
        "012095.webp",
