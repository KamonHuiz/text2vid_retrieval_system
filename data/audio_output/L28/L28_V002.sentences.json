        "004963.webp",
        "004987.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Trước mắt chúng tôi bây giờ là bức tranh nông thôn bình dị, đẹp đến nao lòng.",
      "start": 199.6,
      "end": 206.8,
