        "005424.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bức tranh nông thôn như được nhuộm một màu vàng rực nên thơ và lãng mạn.",
      "start": 217.68,
      "end": 224.08,
      "n_words": 16,
      "start_frame": 5442,
      "end_frame": 5602,
      "keyframes": [
        "005449.webp",
        "005509.webp",
        "005569.webp",
        "005594.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Những hạt lúa vàng ươm săn chắc, phải chăng những hạt vượt sa mạc đã vượt vạn dặm đường để đến được nơi này?",
      "start": 224.08,
