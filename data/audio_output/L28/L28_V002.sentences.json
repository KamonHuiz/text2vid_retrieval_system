        "005077.webp",
        "005167.webp",
        "005168.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cánh đồng Bảy Xã trải rộng ngút ngàn tưởng như chạm đến chân mây.",
      "start": 206.8,
      "end": 217.68,
      "n_words": 14,
