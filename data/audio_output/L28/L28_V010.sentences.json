        "002861.webp",
        "002905.webp",
        "002949.webp",
        "002950.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Dù ở đâu, tràm vẫn tươi xanh, chắt chiu phù sa vươn lên mạnh mẽ, như người dân miền sông nước này vẫn chịu khó chịu thương giữa muôn trùng khó khăn.",
      "start": 118.4,
      "end": 132.24,
      "n_words": 32,
      "start_frame": 2960,
      "end_frame": 3306,
      "keyframes": [
        "002962.webp",
