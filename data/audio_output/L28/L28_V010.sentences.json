        "023867.webp",
        "023888.webp",
        "023889.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "không quá khi đồng nhất hình ảnh cây thốt nốt Bảy Núi với chính người dân Khmer sinh sống nơi đây, tuy quanh năm phải bám vào những mảnh đồng đắng cháy, mùa màng thất bát nhưng họ vẫn lạc quan hài lòng với cuộc sống.",
      "start": 958.0,
      "end": 971.12,
      "n_words": 46,
      "start_frame": 23950,
      "end_frame": 24278,
      "keyframes": [
        "024168.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tự bao đời họ chắt chiu từng giọt nước nơi đáy giếng, hướng từng giọt mưa rơi để tắm táp đồng khô để sinh tồn trong sự hòa hợp với thiên nhiên khắc nghiệt.",
      "start": 971.12,
      "end": 981.52,
      "n_words": 34,
      "start_frame": 24278,
      "end_frame": 24538,
      "keyframes": [
        "024448.webp",
        "024461.webp",
        "024532.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cũng như cây thốt nốt dù mọc trên mảnh đất củi cằn nhưng vẫn kiên trì bám đất, vẫn đứng sừng sững mặc cho tạo hóa biến thiên.",
      "start": 981.52,
      "end": 996.2,
      "n_words": 28,
      "start_frame": 24538,
      "end_frame": 24905,
      "keyframes": [
        "024603.webp",
        "024616.webp",
        "024751.webp",
        "024887.webp",
        "024888.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Như một món quà quý giá của mẹ thiên nhiên ban tặng cho vùng đất Bảy Núi, thốt nốt sinh sôi nơi này không chỉ giúp cho sản vật nơi đây thêm phong phú mà còn mang lại một vẻ đẹp rất đặc trưng nên thơ.",
      "start": 996.2,
      "end": 1010.52,
      "n_words": 46,
