        "023117.webp",
        "023162.webp",
        "023163.webp"
      ],
      "keyframe_count": 24
    },
    {
      "text": "Để rồi từ đó, yêu thích hương vị ngọt ngào ấn tượng của thốt nốt, người dân An Giang đã sáng tạo và chế biến ra nhiều món ăn từ chất liệu quê hương.",
      "start": 926.56,
      "end": 935.68,
      "n_words": 34,
      "start_frame": 23164,
      "end_frame": 23392,
      "keyframes": [
        "023206.webp",
