        "002575.webp",
        "002633.webp",
        "002692.webp",
        "002693.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thân gỗ tràm sống bình dị tại các bãi bồi cửa sông cửa biển hay thành những tán rừng ngập mặn.",
      "start": 109.8,
      "end": 118.4,
      "n_words": 21,
