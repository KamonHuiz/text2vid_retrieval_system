        "023355.webp",
        "023374.webp",
        "023387.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Những sản phẩm được nghiên cứu và chắt lọc từ rất nhiều yêu thương.",
      "start": 935.68,
      "end": 945.48,
      "n_words": 14,
      "start_frame": 23392,
      "end_frame": 23637,
      "keyframes": [
