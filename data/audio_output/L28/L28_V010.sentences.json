        "002397.webp",
        "002458.webp",
        "002459.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tràm vốn chẳng có gì xa lạ với người dân miền Tây Nam Bộ, gắn bó với người dân miền sông nước từ thuở khai hoang mở cõi.",
      "start": 99.2,
      "end": 108.8,
      "n_words": 28,
      "start_frame": 2480,
      "end_frame": 2720,
      "keyframes": [
        "002516.webp",
