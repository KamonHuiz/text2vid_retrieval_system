        "025626.webp",
        "025703.webp",
        "025780.webp",
        "025781.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Trong ráng chiều, cụm bảy cây thốt nốt với những tán lá ghép lại tựa như trái tim nổi bật giữa đồng lúa mênh mông.",
      "start": 1032.56,
      "end": 1042.92,
      "n_words": 25,
      "start_frame": 25814,
      "end_frame": 26073,
      "keyframes": [
        "025923.webp",
        "026065.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng tôi nghĩ về trái tim miền viễn, về nhịp đập về mạch nguồn của nơi này, về sự tinh tế của thiên nhiên khi ban tặng những sản vật quý báu cho mảnh đất vùng biên, vì sự chắt chiu gom góp mà sản vật đã hiến tặng con người.",
      "start": 1042.92,
      "end": 1062.84,
      "n_words": 51,
      "start_frame": 26073,
      "end_frame": 26571,
      "keyframes": [
