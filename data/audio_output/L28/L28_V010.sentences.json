      "keyframes": [
        "001557.webp",
        "001640.webp",
        "001641.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong quá trình đi tìm chất liệu cho sự sáng tạo, là nơi những tinh hoa tinh túy được nuôi dưỡng, chắt lọc và hình thành từ những mạch nguồn của quê hương.",
      "start": 65.64,
      "end": 90.2,
      "n_words": 33,
      "start_frame": 1641,
      "end_frame": 2255,
      "keyframes": [
        "001641.webp",
