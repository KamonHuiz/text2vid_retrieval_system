        "003157.webp",
        "003208.webp",
        "003260.webp",
        "003261.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Rừng tràm Trà Sư là một trong những khu rừng ngập mặn nổi tiếng với hệ động thực vật phong phú và đa dạng, nằm ở khu vực Thất Sơn hùng vĩ thuộc xã Văn Giáo, huyện Tịnh Biên, tỉnh An Giang.",
      "start": 132.24,
      "end": 144.72,
      "n_words": 42,
      "start_frame": 3306,
      "end_frame": 3618,
      "keyframes": [
        "003437.webp",
        "003614.webp",
        "003615.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Có thể gọi rừng tràm Trà Sư là một thư viện sinh thái khổng lồ, hệ sinh thái của vùng ngập nước phía tây sông Hậu với diện tích 845 ha vùng lõi và 643 ha vùng đệm.",
      "start": 144.72,
      "end": 158.72,
      "n_words": 38,
      "start_frame": 3618,
      "end_frame": 3968,
      "keyframes": [
        "003663.webp",
        "003711.webp",
        "003712.webp",
        "003763.webp",
        "003815.webp",
        "003816.webp",
        "003885.webp",
        "003955.webp",
        "003956.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nơi đây cũng nằm trong hệ thống các khu rừng đặc dụng của Việt Nam.",
      "start": 158.72,
      "end": 164.0,
      "n_words": 15,
      "start_frame": 3968,
      "end_frame": 4100,
      "keyframes": [
        "004034.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bước vào rừng tràm Trà Sư như lạc vào thế giới của màu xanh: màu xanh của cây của lá đến màu xanh của nước của bèo và cả của mây trời.",
      "start": 164.0,
      "end": 175.0,
      "n_words": 32,
      "start_frame": 4100,
      "end_frame": 4375,
      "keyframes": [
        "004112.webp",
        "004113.webp",
        "004151.webp",
        "004190.webp",
        "004191.webp",
        "004234.webp",
        "004278.webp",
        "004279.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "\"Chị làm đây chị thấy mùa nào là khách du lịch đến rừng Trà Sư mình nhiều?\"",
      "start": 178.76,
      "end": 183.04,
      "n_words": 17,
      "start_frame": 4469,
      "end_frame": 4576,
      "keyframes": [
        "004522.webp",
        "004523.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "\"Chị, tháng mùa nước, tháng tám, tháng 9 âm lịch, mùa nước nổi đẹp phục vụ khách du lịch như vậy.",
      "start": 183.04,
      "end": 189.6,
      "n_words": 21,
      "start_frame": 4576,
      "end_frame": 4740,
      "keyframes": [
        "004584.webp",
        "004646.webp",
        "004647.webp",
        "004689.webp",
        "004732.webp",
        "004733.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Xuồng vậy là khu rừng của mình là được nhiều bên bến xuồng của mình là tổng cộng hết là 37 người nam với nữ.\"",
      "start": 189.6,
      "end": 198.4,
      "n_words": 25,
      "start_frame": 4740,
      "end_frame": 4960,
      "keyframes": [
        "004774.webp",
        "004815.webp",
        "004816.webp",
        "004878.webp",
        "004941.webp",
        "004942.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "\"Cái rừng tràm Trà Sư mình là nó có những loại chim cò gì là phổ biến vậy?\"",
      "start": 198.4,
      "end": 202.56,
      "n_words": 18,
      "start_frame": 4960,
      "end_frame": 5064,
      "keyframes": [
        "005002.webp",
        "005062.webp",
        "005063.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "\"Chủ yếu nhất là cò với dạc với cồng cọc, chip cồ, chip ché Ấn Độ như vạc đồ thì nó cũng có, vậy nhưng mà cả tuần vạc nó mới có về đây một lần.\"",
      "start": 202.56,
      "end": 220.08,
      "n_words": 36,
      "start_frame": 5064,
      "end_frame": 5502,
      "keyframes": [
        "005121.webp",
