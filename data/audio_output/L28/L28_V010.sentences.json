        "001886.webp",
        "001889.webp",
        "001890.webp",
        "002112.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Mắm trước sau, tràm theo sát, hàng dừa nước, mái nhà ai.",
      "start": 90.2,
      "end": 99.2,
      "n_words": 12,
      "start_frame": 2255,
      "end_frame": 2480,
      "keyframes": [
        "002335.webp",
