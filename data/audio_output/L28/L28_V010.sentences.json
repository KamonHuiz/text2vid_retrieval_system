        "005462.webp",
        "005488.webp",
        "005489.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Khu rừng tràm nguyên sinh này không chỉ mang những đặc tính đa dạng sinh học quan trọng.",
      "start": 220.08,
      "end": 224.72,
      "n_words": 18,
      "start_frame": 5502,
      "end_frame": 5618,
      "keyframes": [
        "005513.webp",
        "005537.webp",
        "005538.webp",
        "005585.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rừng tràm Trà Sư là môi trường sống và là nơi bảo tồn của nhiều loài thực vật với 140 loài cá, 81 loài chim, muôn loài chim muôn thú rừng và bò sát vân vân, đặc biệt có hai loài nằm trong Sách Đỏ Việt Nam là cò Ấn Độ và điên điển.",
      "start": 225.72,
      "end": 244.6,
      "n_words": 54,
      "start_frame": 5643,
      "end_frame": 6115,
      "keyframes": [
        "005668.webp",
