        "015121.webp",
        "015122.webp",
        "015162.webp",
        "015203.webp",
        "015204.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Có sử dụng cái công nghệ làm được, nó thủ công, phải làm thủ công tại vì cái chất liệu này nó không có đưa vô máy làm được, đưa vô máy nó bể hết.",
      "start": 608.6,
      "end": 623.2,
      "n_words": 35,
      "start_frame": 15215,
      "end_frame": 15580,
      "keyframes": [
        "015252.webp",
