        "014310.webp",
        "014533.webp",
        "014757.webp",
        "014758.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Huyền thô thì là loại huyền mình chưa có khó làm ra thành phẩm, nó còn nguyên cái hình thể như thế này.",
      "start": 590.32,
      "end": 596.96,
      "n_words": 23,
      "start_frame": 14758,
      "end_frame": 14924,
      "keyframes": [
        "014758.webp",
        "014815.webp",
        "014873.webp",
        "014874.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đây là miếng đất nhỏ mình tuyển ra để mình làm mẫu cho cô bác mình xem thôi và nó là một cái loại trầm tích phải từ trên 2.000 năm mình mới sử dụng được cái này đâu.",
      "start": 596.96,
