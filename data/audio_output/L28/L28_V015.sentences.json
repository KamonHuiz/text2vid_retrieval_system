        "018347.webp",
        "018354.webp",
        "018379.webp",
        "018473.webp",
        "018567.webp",
        "018568.webp",
        "018721.webp",
        "018874.webp",
        "018875.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Vì yêu thích cảnh trí của rạch Vượt, ông Mạc Thiên Tích đã từng cất một tiểu đình ở đây để làm nơi buông câu thư giãn ngâm thơ.",
      "start": 756.72,
      "end": 768.32,
      "n_words": 29,
      "start_frame": 18918,
      "end_frame": 19208,
      "keyframes": [
        "019015.webp",
        "019156.webp",
        "019182.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "\"Bến Vượt nhà ngư chật mấy tuần trong nhàn riêng, có việc lăng xăng lưới chài phơi trải đầy trời hạ, gõi rượu hê ha toại nghiệp hằng nghề thuấn hãy truyền bền trác trác vốn nghiêu còn thấy đủ răng răng sau đây mười cảnh thanh hoa lạ cảnh đào nguyên mới sánh chăng.\"",
      "start": 768.32,
      "end": 802.0,
      "n_words": 55,
      "start_frame": 19208,
      "end_frame": 20050,
      "keyframes": [
        "019343.webp",
        "019505.webp",
        "019530.webp",
        "019647.webp",
        "019765.webp",
        "019786.webp",
        "019894.webp",
        "020002.webp",
        "020003.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nếu ngày xưa ông Mạc Thiên Tích gọi đây là \"lư khê\", chữ \"lư\" ý nói đến loài cá vượt hay còn được gọi là cá chẽm, \"khê\" là khe nước, thì ngày nay dòng nước vẫn sâu, trong vắt và nhiều cá nhưng loài cá vượt nay cũng không còn nữa.",
      "start": 802.0,
      "end": 823.4,
      "n_words": 52,
      "start_frame": 20050,
      "end_frame": 20585,
      "keyframes": [
        "020079.webp",
        "020155.webp",
        "020156.webp",
        "020181.webp",
        "020206.webp",
        "020207.webp",
        "020247.webp",
