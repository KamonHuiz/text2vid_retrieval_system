        "001420.webp",
        "001421.webp",
        "001503.webp"
      ],
      "keyframe_count": 23
    },
    {
      "text": "Chúng tôi đi dọc tuyến Quốc lộ 1, xuôi theo dòng kênh Vĩnh Tế để về với biển Tây.",
      "start": 60.76,
      "end": 68.56,
      "n_words": 19,
      "start_frame": 1519,
      "end_frame": 1714,
      "keyframes": [
        "001585.webp",
        "001598.webp",
        "001648.webp",
        "001699.webp",
        "001714.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dòng kênh huyền thoại bao năm qua vẫn chăm chỉ đem nguồn nước ngọt mát lành của sông Cửu Long tháo chua rửa phèn cho ruộng đồng thêm màu mỡ. Kênh Vĩnh Tế trải dài suốt đoạn đường gần 100 km rồi kết thúc hành trình của mình khi tiếp giáp với sông Giang Thành.",
      "start": 68.56,
      "end": 89.2,
      "n_words": 55,
      "start_frame": 1714,
      "end_frame": 2230,
      "keyframes": [
        "001714.webp",
        "001851.webp",
        "001989.webp",
        "002014.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Con sông bắt nguồn từ cao nguyên Bentamis và khu núi Linh Quỳnh tỉnh Kampot của Campuchia rồi chảy vào địa phận Việt Nam tại tỉnh Kiên Giang, nơi ngã ba sông cả hai dòng nước gặp nhau thật hiền hòa và yên ả.",
      "start": 89.2,
      "end": 110.8,
      "n_words": 44,
      "start_frame": 2230,
      "end_frame": 2770,
      "keyframes": [
        "002262.webp",
        "002511.webp",
        "002536.webp",
        "002655.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Từ đây, sông Giang Thành tiếp tục chuyến đi đem nguồn nước phục vụ đời sống cho người dân xứ Hà Tiên.",
      "start": 110.8,
      "end": 117.08,
      "n_words": 22,
      "start_frame": 2770,
      "end_frame": 2927,
      "keyframes": [
        "002774.webp",
        "002775.webp",
        "002860.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dòng sông cuối cùng đổ ra cửa biển tại cầu Tô Châu Kay, cầu mang tên quê hương của ông Mạc Cửu, nối nhịp hai bờ sông Giang Thành cũng chính là tuyến đường huyết mạch, cửa ngõ duy nhất dẫn vào thành phố Hà Tiên, vùng đất biên thùy cực Nam của Tổ quốc.",
      "start": 117.08,
      "end": 145.6,
      "n_words": 55,
      "start_frame": 2927,
      "end_frame": 3640,
      "keyframes": [
        "002945.webp",
        "002970.webp",
        "003012.webp",
        "003055.webp",
        "003056.webp",
        "003121.webp",
        "003187.webp",
        "003188.webp",
        "003294.webp",
        "003400.webp",
        "003425.webp",
        "003460.webp",
        "003495.webp",
        "003520.webp",
        "003551.webp",
        "003583.webp",
        "003584.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Theo sử sách ghi chép lại, hơn 300 năm trước có một chàng thanh niên tên là Mạc Cửu, quê gốc ở Quảng Đông, vì không thuần phục nhà Thanh đã dong buồm xuôi thuyền về phương Nam tìm vùng đất mới.",
      "start": 145.6,
      "end": 160.0,
      "n_words": 42,
      "start_frame": 3640,
      "end_frame": 4000,
      "keyframes": [
        "003677.webp",
        "003771.webp",
        "003796.webp",
        "003985.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khi đến đây, với góc nhìn của một thương gia, ông chọn khai phá vùng đất này làm nơi dựng nghiệp.",
      "start": 160.0,
      "end": 168.32,
      "n_words": 21,
      "start_frame": 4000,
      "end_frame": 4208,
      "keyframes": [
        "004174.webp",
        "004199.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Vào mùa thu năm Mậu Tý 1708, Mạc Cửu đem Mang Khảm dâng cho chúa Nguyễn và xin thuần phục chúa Nguyễn.",
      "start": 168.32,
      "end": 176.88,
      "n_words": 22,
      "start_frame": 4208,
      "end_frame": 4422,
      "keyframes": [
        "004350.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chúa Nguyễn Phúc Chu phong cho Mạc Cửu làm Tổng binh và ông đã đặt tên mới cho Mang Khảm là trấn Hà Tiên.",
      "start": 176.88,
      "end": 188.6,
      "n_words": 24,
      "start_frame": 4422,
      "end_frame": 4715,
      "keyframes": [
        "004501.webp",
        "004526.webp",
        "004636.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Kể từ thời điểm này, cùng với Gia Định và Đồng Nai, Hà Tiên trở thành một trong ba nơi tạo thành thế đứng chiến lược trong công cuộc khai mở của người Việt ở phương Nam.",
      "start": 188.6,
      "end": 204.04,
      "n_words": 37,
      "start_frame": 4715,
      "end_frame": 5101,
      "keyframes": [
        "004747.webp",
        "004770.webp",
        "004908.webp",
        "005047.webp",
        "005048.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Với lợi thế của Hà Tiên có biển, sông, hồ, Mạc Cửu đã cho mở những tuyến giao thương đường thủy tới những quốc gia lân cận, giúp cho vùng đất này mau chóng trở nên trù phú thịnh vượng.",
      "start": 204.04,
      "end": 219.4,
      "n_words": 40,
      "start_frame": 5101,
      "end_frame": 5485,
      "keyframes": [
        "005189.webp",
        "005330.webp",
        "005331.webp",
        "005403.webp",
        "005476.webp",
        "005477.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hà Tiên từng nổi tiếng là thương cảng buôn bán sầm uất phồn vinh tại vùng Vịnh Thái Lan, điểm giao thương hàng hóa đến các nước trong khu vực Đông Nam Á.",
      "start": 219.4,
      "end": 244.16,
      "n_words": 33,
      "start_frame": 5485,
      "end_frame": 6104,
      "keyframes": [
        "005545.webp",
        "005614.webp",
        "005615.webp",
        "005649.webp",
        "005683.webp",
        "005684.webp",
        "005772.webp",
        "005860.webp",
        "005885.webp",
        "005925.webp",
        "005965.webp",
        "005990.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "\"Một bước càng thêm một thú yêu, lầu cây vách đá vẽ hay thêu, mây tùng khói liễu chập đàn suối, ca chim thắp lại cáo mạc thiên tích\" là miêu tả cảnh đẹp của núi Bình San trong Hà Tiên thập vịnh qua bài thơ Bình San điệp thúy.",
      "start": 244.16,
      "end": 267.04,
      "n_words": 50,
      "start_frame": 6104,
      "end_frame": 6676,
      "keyframes": [
        "006213.webp",
        "006437.webp",
        "006461.webp",
        "006559.webp",
        "006657.webp",
        "006658.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ngọn núi như bức bình phong che chắn gần hết mặt phía Tây thành Hà Tiên.",
      "start": 267.04,
      "end": 271.64,
      "n_words": 16,
      "start_frame": 6676,
      "end_frame": 6791,
      "keyframes": [
        "006737.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "\"Xưa điệp thúy\" có nghĩa là ngút ngàn lớp lớp một màu xanh chập trùng.",
      "start": 271.64,
      "end": 278.12,
      "n_words": 15,
      "start_frame": 6791,
      "end_frame": 6953,
      "keyframes": [
        "006817.webp",
        "006818.webp",
        "006933.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngày nay, núi Bình San là di tích lịch sử văn hóa quốc gia.",
      "start": 278.12,
      "end": 282.4,
      "n_words": 14,
      "start_frame": 6953,
      "end_frame": 7060,
      "keyframes": [
        "007049.webp",
        "007050.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Dưới chân núi Bình San là Mạc Công Miếu, khu đền thờ của dòng họ Mạc.",
      "start": 282.4,
      "end": 289.28,
      "n_words": 16,
      "start_frame": 7060,
      "end_frame": 7232,
      "keyframes": [
        "007121.webp",
        "007193.webp",
        "007215.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phía trước có ao sen Bảo Ngọc, Liên Bảo Ngọc Liên Trì.",
      "start": 289.28,
      "end": 292.92,
      "n_words": 12,
      "start_frame": 7232,
      "end_frame": 7323,
      "keyframes": [
        "007243.webp",
        "007272.webp",
        "007290.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tương truyền xưa kia ông Mạc Cửu đào ao sen này để trữ nước ngọt cho bà con quanh vùng sử dụng vào mùa khô hạn.",
      "start": 292.92,
      "end": 302.0,
      "n_words": 26,
      "start_frame": 7323,
      "end_frame": 7550,
      "keyframes": [
        "007340.webp",
        "007391.webp",
        "007416.webp",
        "007468.webp",
        "007520.webp",
        "007521.webp",
        "007532.webp",
        "007544.webp",
        "007545.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ngày nay, ao sen vẫn được chăm sóc và gìn giữ không chỉ làm tô điểm thêm cho vẻ đẹp của nơi đây mà còn thể hiện tấm lòng của người dân Hà Tiên dành cho dòng họ Mạc đời đời tưởng nhớ tôn thờ.",
      "start": 302.0,
      "end": 318.8,
      "n_words": 45,
      "start_frame": 7550,
      "end_frame": 7970,
      "keyframes": [
        "007602.webp",
        "007660.webp",
        "007685.webp",
        "007734.webp",
        "007784.webp",
        "007809.webp",
        "007865.webp",
        "007922.webp",
        "007923.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Mạc Công Miếu được xây dựng theo kiến trúc ba gian với cổng tam quan ở phía trước.",
      "start": 318.8,
      "end": 324.08,
      "n_words": 18,
      "start_frame": 7970,
      "end_frame": 8102,
      "keyframes": [
        "007988.webp",
        "008053.webp",
        "008054.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hai bên là hai câu đối mà chúa Nguyễn đã ban tặng cho dòng họ Mạc: \"Nhất môn trung nghĩa danh tinh trọng, thất dịp phiên hàn quốc lũng vinh\", tạm dịch là: Một nhà trung nghĩa danh thơm cả họ, bảy lá dẫu tre cả nước mến yêu.",
      "start": 324.08,
      "end": 350.64,
      "n_words": 49,
      "start_frame": 8102,
      "end_frame": 8766,
      "keyframes": [
        "008148.webp",
        "008242.webp",
        "008243.webp",
        "008289.webp",
        "008335.webp",
        "008360.webp",
        "008399.webp",
        "008439.webp",
        "008440.webp",
        "008508.webp",
        "008576.webp",
        "008577.webp",
        "008654.webp",
        "008731.webp",
        "008756.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Đền tuy không lớn nhưng là một công trình kiến trúc có tính nghệ thuật cao với cách bố trí hài hòa và lối chạm trổ tinh vi sắc sảo.",
      "start": 350.64,
      "end": 363.72,
      "n_words": 30,
      "start_frame": 8766,
      "end_frame": 9093,
      "keyframes": [
        "008820.webp",
        "008884.webp",
        "008885.webp",
        "008976.webp",
        "009067.webp",
        "009068.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mạc Cửu mất năm Ất Mão 1735, ông được triều đình nhà Nguyễn phong tặng Khai trấn Thượng trụ Quốc đại tướng quân Vũ nhị công tức Cửu Ngọc hầu.",
      "start": 363.72,
      "end": 380.4,
      "n_words": 30,
      "start_frame": 9093,
      "end_frame": 9510,
      "keyframes": [
        "009242.webp",
        "009417.webp",
        "009429.webp",
        "009500.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Hiện nay, những sắc phong của các triều nhà Nguyễn vẫn còn được lưu giữ chính là bằng chứng ghi nhận công lao to lớn của dòng họ Mạc khai mở, phát triển vùng đất Hà Tiên.",
      "start": 380.4,
      "end": 393.84,
      "n_words": 37,
      "start_frame": 9510,
      "end_frame": 9846,
      "keyframes": [
        "009571.webp",
        "009596.webp",
        "009664.webp",
        "009732.webp",
        "009757.webp",
        "009816.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng tôi đến dâng hương đúng vào thời điểm người dân quanh vùng đang tất bật chuẩn bị cho ngày lễ giỗ lần thứ 189 của đức khai trấn Mạc Cửu.",
      "start": 393.84,
      "end": 406.52,
      "n_words": 31,
      "start_frame": 9846,
      "end_frame": 10163,
      "keyframes": [
        "009876.webp",
        "009894.webp",
        "009988.webp",
        "010083.webp",
        "010084.webp",
        "010121.webp",
        "010158.webp",
        "010159.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Hàng năm, cứ đến ngày 26 và 27 tháng 5 âm lịch, không chỉ có người dân Hà Tiên mà du khách gần xa đều tề tựu về đây hành hương dự lễ.",
      "start": 406.52,
      "end": 416.8,
      "n_words": 33,
      "start_frame": 10163,
      "end_frame": 10420,
      "keyframes": [
        "010210.webp",
        "010261.webp",
        "010262.webp",
        "010301.webp",
        "010340.webp",
        "010341.webp",
        "010374.webp",
        "010408.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Từ lâu, lễ hội đã trở thành nét văn hóa truyền thống là dịp để thế hệ mai sau ghi nhớ công ơn khai sinh lập đất của bậc tiền nhân.",
      "start": 416.8,
      "end": 431.84,
      "n_words": 31,
      "start_frame": 10420,
      "end_frame": 10796,
      "keyframes": [
        "010423.webp",
        "010460.webp",
        "010497.webp",
        "010518.webp",
        "010630.webp",
        "010742.webp",
        "010767.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Núi Bình San còn có tên gọi khác là núi Lăng.",
      "start": 431.84,
      "end": 435.56,
      "n_words": 11,
      "start_frame": 10796,
      "end_frame": 10889,
      "keyframes": [
        "010874.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Giữa rừng cây xanh mát là quần thể lăng mộ của dòng họ Mạc.",
      "start": 435.56,
      "end": 439.72,
      "n_words": 14,
      "start_frame": 10889,
      "end_frame": 10993,
      "keyframes": [
        "010982.webp",
        "010983.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khi ông Mạc Cửu mất, con trai của ông là Mạc Thiên Tích đã đưa ông an táng tại đỉnh núi Bình San này.",
      "start": 439.72,
      "end": 449.84,
      "n_words": 24,
      "start_frame": 10993,
      "end_frame": 11246,
      "keyframes": [
        "011087.webp",
        "011191.webp",
        "011192.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngôi mộ được đúc bằng đá vôi, cát đường và nhựa ô dước, có hình bán nguyệt khoét sâu vào núi tựa như một con trâu đang nằm, hay còn được gọi là thế tọa ngưu, tả có thanh long, hữu có bạch hổ.",
      "start": 449.84,
      "end": 465.2,
      "n_words": 44,
      "start_frame": 11246,
      "end_frame": 11630,
      "keyframes": [
        "011279.webp",
        "011366.webp",
        "011367.webp",
        "011468.webp",
        "011569.webp",
        "011570.webp",
        "011623.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tại đây, ông Nguyễn Văn C, người con của vùng đất Hà Tiên, đã có hơn 20 năm làm việc gắn bó và coi nơi này là nhà, đã kể một câu chuyện thú vị về cây bạch mai, loại cây rất hiếm gặp ở Việt Nam đã được mẹ của ông Mạc Cửu đem giống về đây trồng.",
      "start": 468.4,
      "end": 486.16,
      "n_words": 59,
      "start_frame": 11710,
      "end_frame": 12154,
      "keyframes": [
        "011714.webp",
        "011752.webp",
