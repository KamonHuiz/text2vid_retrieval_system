        "016690.webp",
        "016691.webp",
        "016745.webp",
        "016800.webp",
        "016801.webp",
        "016836.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Như thế nhưng thật tiếc, nay sản phẩm huyền ngày càng khan hiếm và nghề huyền cũng dần lụi tàn.",
      "start": 674.56,
      "end": 685.6,
      "n_words": 20,
      "start_frame": 16864,
      "end_frame": 17140,
      "keyframes": [
        "016871.webp",
