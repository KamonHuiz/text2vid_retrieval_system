        "013589.webp",
        "013644.webp",
        "013699.webp",
        "013700.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Thủ công độc đáo gắn liền với lịch sử phát triển và văn hóa của vùng đất Hà Tiên.",
      "start": 548.64,
      "end": 554.52,
