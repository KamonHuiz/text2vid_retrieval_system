        "020667.webp",
        "020735.webp",
        "020803.webp",
        "020804.webp",
        "020869.webp",
        "020935.webp",
        "020936.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Với sự phát triển của kinh tế xã hội, mạng lưới giao thông đường bộ được mở rộng, một nhánh của rạch Vượt giờ đây đã không còn đổ ra biển nữa vì bị Quốc lộ 80 chắn ngang.",
      "start": 840.92,
      "end": 852.8,
      "n_words": 39,
      "start_frame": 21023,
      "end_frame": 21320,
      "keyframes": [
        "021056.webp",
