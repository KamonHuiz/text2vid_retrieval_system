        "017499.webp",
        "017568.webp",
        "017569.webp",
        "017613.webp",
        "017657.webp",
        "017658.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Tự hào và dành cả đời với tình yêu nghề huyền truyền thống mà cha ông đã để lại, ông Chí Thông vẫn đau đáu mong mỏi tìm được truyền nhân, chỉ sợ rằng mai đây nghề huyền Hà Tiên chỉ còn là chuyện xưa tích cũ.",
      "start": 706.52,
      "end": 730.96,
      "n_words": 47,
      "start_frame": 17663,
      "end_frame": 18274,
      "keyframes": [
        "017698.webp",
        "017738.webp",
        "017739.webp",
        "017815.webp",
        "017891.webp",
        "017892.webp",
        "017960.webp",
        "018028.webp",
        "018029.webp",
        "018101.webp",
        "018173.webp",
        "018198.webp",
        "018261.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Tạm biệt người nghệ nhân hiền hòa hiếu khách với nỗi niềm trăn trở, chúng tôi tiếp tục chuyến hành trình của mình tìm về xã Thuận Yên, cách Tô Châu hơn bốn dặm về phía đông, nơi có con rạch Vượt nổi tiếng từng được Mạc Thiên Tích ví là \"lư khê ngư bạc\", nghĩa là thuyền ngư đổ bến, một trong 10 cảnh đẹp của xứ Hà Tiên kia.",
      "start": 730.96,
      "end": 756.72,
      "n_words": 71,
      "start_frame": 18274,
      "end_frame": 18918,
      "keyframes": [
        "018325.webp",
