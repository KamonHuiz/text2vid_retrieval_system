        "015301.webp",
        "015417.webp",
        "015533.webp",
        "015534.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Làm nghề này nó cực cực lắm, mình lấy công làm lời không à thì mình yêu nghề mình cứ theo đuổi mình làm.",
      "start": 623.2,
      "end": 639.28,
      "n_words": 24,
      "start_frame": 15580,
      "end_frame": 15982,
      "keyframes": [
        "015677.webp",
        "015820.webp",
        "015821.webp",
        "015895.webp",
        "015969.webp",
        "015970.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Lời kể của ông Trần Chí Thông, người nghệ nhân duy nhất vẫn lưu giữ và gắn bó với nghề.",
      "start": 639.28,
      "end": 645.44,
      "n_words": 20,
      "start_frame": 15982,
      "end_frame": 16136,
      "keyframes": [
        "016054.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hà Tiên là nơi duy nhất ở Việt Nam có nghề huyền xuất hiện từ khoảng thế kỷ 18.",
      "start": 645.44,
      "end": 650.8,
      "n_words": 19,
      "start_frame": 16136,
      "end_frame": 16270,
      "keyframes": [
        "016139.webp",
        "016140.webp",
        "016208.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trải qua thời gian, nghề huyền từng có thời kỳ hoàng kim, nhu cầu tiêu thụ sản phẩm rất lớn.",
      "start": 651.52,
      "end": 659.24,
      "n_words": 20,
      "start_frame": 16288,
      "end_frame": 16481,
      "keyframes": [
        "016373.webp",
        "016469.webp",
        "016470.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Từ khi địa giới trấn Hà Tiên và Gia Định thành nối liền một dãy, sản phẩm mỹ nghệ huyền Hà Tiên theo đường sông rạch đến các vùng nông thôn xa xôi đã từng trở nên gần gũi và gắn bó với mọi tầng lớp người dân trên khắp đồng bằng sông Cửu Long.",
      "start": 659.24,
      "end": 674.56,
      "n_words": 55,
      "start_frame": 16481,
      "end_frame": 16864,
      "keyframes": [
        "016519.webp",
