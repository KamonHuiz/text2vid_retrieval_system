        "020495.webp",
        "020532.webp",
        "020533.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Theo ông Trương Minh Đạt, nhà nghiên cứu Hà Tiên, \"lư khê ngư bạc\" ngày nay còn mà như mất, mất mà như còn, bởi con rạch vẫn còn đó nhưng cảnh đã khác xưa.",
      "start": 823.4,
      "end": 840.92,
      "n_words": 35,
      "start_frame": 20585,
      "end_frame": 21023,
      "keyframes": [
        "020599.webp",
