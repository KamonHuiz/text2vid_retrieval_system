        "000419.webp",
        "000467.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đời người, đời sông yêu thương và hào sảng, trân trọng và biết ơn.",
      "start": 19.8,
      "end": 60.76,
