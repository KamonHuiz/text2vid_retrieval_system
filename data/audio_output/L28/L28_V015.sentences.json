        "021178.webp",
        "021246.webp",
        "021314.webp",
        "021315.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tuy nhiên, nhiều ngư dân vẫn quen về đây neo đậu những ngày thuyền nằm bờ không đi biển.",
      "start": 852.8,
      "end": 861.36,
      "n_words": 19,
      "start_frame": 21320,
      "end_frame": 21534,
      "keyframes": [
        "021405.webp",
        "021496.webp",
        "021497.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh Lợi, một ngư dân sinh ra và lớn lên tại đây, đã dẫn chúng tôi đi dọc theo nhánh còn lại của rạch Vượt để ra đầm Đông Hồ.",
      "start": 861.36,
