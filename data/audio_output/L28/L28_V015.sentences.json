        "016967.webp",
        "016968.webp",
        "017017.webp",
        "017066.webp",
        "017067.webp",
        "017113.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chất liệu huyền phách khá đặc biệt là một loại khoáng sản dạng than đá có nguồn gốc thực vật nên kết cấu giòn và dễ vỡ, để chế tác huyền chỉ có thể làm thủ công, đòi hỏi người nghệ nhân cần phải tỉ mỉ và kiên trì.",
      "start": 685.6,
      "end": 706.52,
      "n_words": 49,
      "start_frame": 17140,
      "end_frame": 17663,
      "keyframes": [
        "017160.webp",
        "017161.webp",
        "017244.webp",
        "017328.webp",
        "017329.webp",
        "017379.webp",
        "017430.webp",
