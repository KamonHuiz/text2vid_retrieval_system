        "023412.webp",
        "023463.webp",
        "023464.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nếu mà cái nồi vẫn còn đen là mình để mưa nữa và gáo là nó chưa có độ chín cái nồi.",
      "start": 938.64,
