        "001459.webp",
        "001482.webp",
        "001483.webp"
      ],
      "keyframe_count": 22
    },
    {
      "text": "Tạm biệt huyện Kiên Lương về thăm Hòn Đất, chúng tôi lại gặp dòng kênh Tri Tôn với chiều dài 63 km.",
      "start": 59.48,
      "end": 67.68,
      "n_words": 22,
      "start_frame": 1487,
      "end_frame": 1692,
      "keyframes": [
        "001536.webp",
        "001590.webp",
        "001615.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dòng kênh Tri Tôn đã chuyên chở nguồn nước ngọt từ sông Hậu chảy qua hai tỉnh An Giang và Kiên Giang.",
      "start": 68.8,
      "end": 76.28,
      "n_words": 22,
      "start_frame": 1720,
      "end_frame": 1907,
      "keyframes": [
        "001807.webp",
        "001832.webp",
        "001860.webp",
        "001889.webp",
        "001890.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Những nhánh kênh nhỏ được phân chia như bàn cờ, lấy nguồn nước từ kênh Tri Tôn chảy sâu vào trong nội đồng.",
      "start": 76.28,
      "end": 84.4,
      "n_words": 23,
      "start_frame": 1907,
      "end_frame": 2110,
      "keyframes": [
        "001986.webp",
        "002083.webp",
        "002106.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dòng kênh Tri Tôn đã kết thúc cuộc hành trình của mình khi nhập dòng với con kênh Rạch Giá - Hà Tiên tại thị trấn Hòn Đất.",
      "start": 84.4,
      "end": 101.88,
      "n_words": 28,
      "start_frame": 2110,
      "end_frame": 2547,
      "keyframes": [
        "002204.webp",
        "002302.webp",
        "002327.webp",
        "002367.webp",
        "002408.webp",
        "002409.webp",
        "002493.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Từ đây, kênh Rạch Giá - Hà Tiên lại tiếp tục nhiệm vụ của mình, chia nguồn nước cho con kênh Hòn Sóc và nhiều tuyến kênh khác trước khi đổ ra Biển Tây.",
      "start": 101.88,
      "end": 120.48,
      "n_words": 34,
      "start_frame": 2547,
      "end_frame": 3012,
      "keyframes": [
        "002578.webp",
        "002579.webp",
        "002618.webp",
        "002658.webp",
        "002659.webp",
        "002752.webp",
        "002845.webp",
        "002846.webp",
        "002887.webp",
        "002929.webp",
        "002930.webp",
        "002993.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Sau hơn 30 năm khai phá vùng Tứ giác Long Xuyên, những cánh đồng hoang hóa của huyện Hòn Đất đã trở thành vùng sản xuất lúa gạo trọng điểm với sản lượng đứng đầu toàn tỉnh, cùng với hệ thống thủy lợi được đầu tư xây dựng, đảm bảo cho sản xuất nông nghiệp, giúp nhiều hộ nông dân an tâm trồng trọt, ổn định kinh tế.",
      "start": 120.48,
      "end": 147.36,
      "n_words": 68,
      "start_frame": 3012,
      "end_frame": 3684,
      "keyframes": [
        "003057.webp",
        "003058.webp",
        "003102.webp",
        "003146.webp",
        "003147.webp",
        "003210.webp",
        "003273.webp",
        "003274.webp",
        "003320.webp",
        "003366.webp",
        "003367.webp",
        "003407.webp",
        "003448.webp",
        "003449.webp",
        "003515.webp",
        "003581.webp",
        "003582.webp",
        "003631.webp",
        "003680.webp",
        "003681.webp"
      ],
      "keyframe_count": 20
    },
    {
      "text": "Cuộc sống của người dân trên địa bàn huyện cũng ngày một đổi thay, phát triển như gia đình anh Huỳnh Văn Nghĩa đã sống ở ấp từ rất lâu đời.",
      "start": 147.36,
      "end": 168.32,
      "n_words": 31,
      "start_frame": 3684,
      "end_frame": 4208,
      "keyframes": [
        "003708.webp",
        "003735.webp",
        "003736.webp",
        "003790.webp",
        "003844.webp",
        "003845.webp",
        "003970.webp",
        "004096.webp",
        "004097.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Sinh ra và lớn lên tại nơi này, anh đã chứng kiến biết bao đổi thay trên mảnh đất quê hương mình.",
      "start": 168.32,
      "end": 175.28,
      "n_words": 22,
      "start_frame": 4208,
      "end_frame": 4382,
      "keyframes": [
        "004224.webp",
        "004351.webp",
        "004352.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Người dân xứ Hòn bao đời nay vẫn kiên cường vươn lên từ trong gian khó, bằng đôi tay lao động cần cù, gia đình anh giờ đây đã có được cuộc sống đủ đầy hơn.",
      "start": 175.28,
      "end": 186.2,
      "n_words": 36,
      "start_frame": 4382,
      "end_frame": 4655,
      "keyframes": [
        "004405.webp",
        "004458.webp",
        "004533.webp",
        "004587.webp",
        "004642.webp",
        "004643.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "\"Sống ở đây là cũng qua ba đời, là khoảng cỡ mấy chục năm nay rồi.",
      "start": 186.2,
      "end": 191.4,
      "n_words": 16,
      "start_frame": 4655,
      "end_frame": 4785,
      "keyframes": [
        "004666.webp",
        "004690.webp",
        "004691.webp",
        "004710.webp",
        "004730.webp",
        "004731.webp",
        "004776.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Thì hồi trước kia thì vùng đất này thì làm lúa mà cấy, rồi từ năm mà khoảng 90 mấy tới giờ thiệt cầu là mới quay về mà làm lúa ngắn ngày nè, là lúa mà hai vụ.",
      "start": 191.4,
      "end": 206.64,
      "n_words": 39,
      "start_frame": 4785,
      "end_frame": 5166,
      "keyframes": [
        "004821.webp",
        "004822.webp",
        "004840.webp",
        "004859.webp",
        "004860.webp",
        "004898.webp",
        "004937.webp",
        "004938.webp",
        "005052.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Lúc mà nó chưa có cái cống ngăn mặn thì ở đây thì làm nó hơi khó khăn, nhưng mà từ lúc có làm cống ngăn mặn tới giờ thì nói chung là lúa ở đây chung là mần là có nước ngọt được quanh năm.",
      "start": 206.64,
      "end": 216.92,
      "n_words": 46,
      "start_frame": 5166,
      "end_frame": 5423,
      "keyframes": [
        "005167.webp",
        "005168.webp",
        "005220.webp",
        "005272.webp",
        "005273.webp",
        "005353.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thì ở đây chung là tôi thì có được 3 ha dừa, thì nói chung là cũng dễ, mình chỉ cuốc cái rãnh lên bờ bao cầu là mình trồng xung quanh vậy thôi, trồng dừa để có nguồn thu nhập thêm.",
      "start": 216.92,
      "end": 229.72,
      "n_words": 42,
      "start_frame": 5423,
      "end_frame": 5743,
      "keyframes": [
        "005434.webp",
        "005435.webp",
        "005467.webp",
        "005500.webp",
        "005501.webp",
        "005595.webp",
        "005690.webp",
        "005691.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Nói chung là lúa một năm mới chỉ có 2 vụ mà mỗi một vụ mình tính bình quân ra cũng như là nó cách nhau sáu tháng, thành ra nó có thời gian ngắn cách xa quá, thành ra mình muốn trồng dừa để xen vô, trên một tháng mình thu hoạch được lần để mình vẽ mình phụ thêm cho kinh tế gia đình ngày nông.",
      "start": 229.72,
      "end": 246.24,
      "n_words": 68,
      "start_frame": 5743,
      "end_frame": 6156,
      "keyframes": [
        "005746.webp",
        "005802.webp",
        "005803.webp",
        "005896.webp",
        "005989.webp",
        "005990.webp",
        "006032.webp",
        "006074.webp",
        "006075.webp",
        "006110.webp",
        "006145.webp",
        "006146.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Nói chung là bình bình thì phát triển cũng được, thì cuộc sống nói chung là cũng bình thường vậy thôi.",
      "start": 246.24,
      "end": 261.16,
      "n_words": 21,
      "start_frame": 6156,
      "end_frame": 6529,
      "keyframes": [
        "006233.webp",
        "006320.webp",
        "006321.webp",
        "006388.webp",
        "006456.webp",
        "006480.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hòn Đất còn có dòng kinh Ba Thê chảy từ An Giang đổ về Rạch Giá - Hà Tiên.",
      "start": 261.16,
      "end": 266.8,
      "n_words": 19,
      "start_frame": 6529,
      "end_frame": 6670,
      "keyframes": [
        "006572.webp",
        "006665.webp",
        "006666.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đây cũng là tuyến đường để nhà khảo cổ học người Pháp Louis Malleret tiến hành cuộc khảo sát vào năm 1944 và nhận định di tích nền chùa tại huyện Hòn Đất là di chỉ thuộc nền văn hóa Óc Eo.",
      "start": 266.8,
      "end": 284.76,
      "n_words": 42,
      "start_frame": 6670,
      "end_frame": 7119,
      "keyframes": [
        "006759.webp",
        "006853.webp",
        "006854.webp",
        "006895.webp",
        "006937.webp",
        "006938.webp",
        "007003.webp",
        "007069.webp",
        "007070.webp",
        "007119.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Hiện nay diện tích nền chùa nằm tại nơi giao nhau giữa kinh Lung lớn và rạch Ông Chạy hay còn gọi là kinh Thầy Thông.",
      "start": 284.76,
      "end": 291.24,
      "n_words": 26,
      "start_frame": 7119,
      "end_frame": 7281,
      "keyframes": [
        "007119.webp",
        "007169.webp",
        "007170.webp",
        "007255.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Kinh Thầy Thông thuộc xã Mỹ Phước.",
      "start": 291.24,
      "end": 293.84,
      "n_words": 7,
      "start_frame": 7281,
      "end_frame": 7346,
      "keyframes": [
        "007341.webp",
        "007342.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Từ cuộc khai quật đã đưa lên khỏi lòng đất một số lượng cực kỳ phong phú đa dạng các loại hình di vật, trong đó nhiều nhất là đồ gốm đã minh chứng rõ ràng và thuyết phục về đặc điểm tính chất của văn hóa Óc Eo là bộ phận biển của vương quốc Phù Nam, với không gian phân bố chủ yếu trên miền đất ngập nước thuộc hạ lưu châu thổ sông Mekong mà chủ yếu là miền Tây sông Hậu được UNESCO xem xét công nhận nền văn hóa là di sản văn hóa thế giới.",
      "start": 293.84,
      "end": 328.48,
      "n_words": 101,
      "start_frame": 7346,
      "end_frame": 8212,
      "keyframes": [
        "007411.webp",
        "007481.webp",
        "007482.webp",
        "007542.webp",
        "007603.webp",
        "007604.webp",
        "007679.webp",
        "007755.webp",
        "007756.webp",
        "007844.webp",
        "007932.webp",
        "007933.webp",
        "008039.webp",
        "008145.webp",
        "008146.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Từng chồng đá chất lên cao, đá mà bảo đất người, sao lạ đời chói lòa, trang sử sáng ngời, nổi danh chỉ sứ một thời liệt oanh.",
      "start": 328.48,
      "end": 344.92,
      "n_words": 28,
      "start_frame": 8212,
      "end_frame": 8623,
      "keyframes": [
        "008369.webp",
        "008592.webp",
        "008593.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nhìn cảnh sắc hôm nay, những cánh đồng trù phú bao quanh núi đồi như một bức tranh, như một bức tranh sơn thủy hữu tình, có ai ngờ rằng huyện Hòn Đất năm xưa từng là một trong những chiến trường oanh liệt, khu căn cứ địa cách mạng của tỉnh Kiên Giang.",
      "start": 344.92,
      "end": 360.08,
      "n_words": 54,
      "start_frame": 8623,
      "end_frame": 9002,
      "keyframes": [
        "008791.webp",
        "008989.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Căn cứ Ba Hòn thuộc xã Thổ Sơn là tên gọi chung của quần thể di tích gồm Hòn Đất, Hòn Me, Hòn Quéo.",
      "start": 360.08,
      "end": 367.96,
      "n_words": 24,
      "start_frame": 9002,
      "end_frame": 9199,
      "keyframes": [
        "009014.webp",
        "009102.webp",
        "009190.webp",
        "009191.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ngày nay, khu di tích Hòn Đất được tôn tạo và xây dựng trang nghiêm có diện tích rộng 22.000 m², nằm dưới chân núi Hòn Me.",
      "start": 367.96,
      "end": 379.0,
      "n_words": 27,
      "start_frame": 9199,
      "end_frame": 9475,
      "keyframes": [
        "009310.webp",
        "009430.webp",
        "009431.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trung tâm của khu di tích là phần mộ của nữ anh hùng lực lượng vũ trang nhân dân Phan Thị Ràng.",
      "start": 379.0,
      "end": 385.24,
      "n_words": 22,
      "start_frame": 9475,
      "end_frame": 9631,
      "keyframes": [
        "009520.webp",
        "009610.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chị chính là nguyên mẫu để nhà văn Anh Đức xây dựng nhân vật chị Sứ trong tiểu thuyết Hòn Đất.",
      "start": 385.24,
      "end": 392.92,
      "n_words": 21,
      "start_frame": 9631,
      "end_frame": 9823,
      "keyframes": [
        "009633.webp",
        "009713.webp",
        "009794.webp",
        "009813.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chị Sứ yêu Hòn Đất bằng cái tình yêu hồn nhiên như là máu thịt.",
      "start": 392.92,
      "end": 396.84,
      "n_words": 15,
      "start_frame": 9823,
      "end_frame": 9921,
      "keyframes": [
        "009860.webp",
        "009907.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chị thương ngôi nhà sàn lâu năm có cái bậc thang nơi mà bất cứ lúc nào đứng đó chị cũng có thể nhìn thấy sóng biển, thấy xóm nhà xen lẫn trong vườn cây, thấy ruộng đồng, thấy núi Ba Thê vòi vọi xanh lam, cứ mỗi buổi hoàng hôn lại hiện trắng những cánh cò.",
      "start": 396.84,
      "end": 417.44,
      "n_words": 57,
      "start_frame": 9921,
      "end_frame": 10436,
      "keyframes": [
        "009923.webp",
        "009957.webp",
        "009991.webp",
        "010009.webp",
        "010092.webp",
        "010175.webp",
        "010200.webp",
        "010310.webp",
        "010420.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Tham gia hoạt động cách mạng từ năm 1950 khi đó chị mới 13 tuổi, đến năm 1962 chị bị bắt trên đường làm nhiệm vụ, bị tra tấn rồi hy sinh.",
      "start": 417.44,
      "end": 430.52,
      "n_words": 32,
      "start_frame": 10436,
      "end_frame": 10763,
      "keyframes": [
        "010445.webp",
        "010501.webp",
        "010558.webp",
        "010559.webp",
        "010630.webp",
        "010702.webp",
        "010703.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chị Sứ đã trở thành biểu tượng tiêu biểu cho người phụ nữ miền Nam kiên cường, anh dũng.",
      "start": 430.52,
      "end": 435.4,
      "n_words": 19,
      "start_frame": 10763,
      "end_frame": 10885,
      "keyframes": [
        "010794.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hơn 30 năm kháng chiến trường kỳ gian khổ, Hòn Đất được xem là pháo đài của lòng kiên trung, ý chí bất khuất, tinh thần yêu nước của quân và dân xứ Ba Hòn.",
