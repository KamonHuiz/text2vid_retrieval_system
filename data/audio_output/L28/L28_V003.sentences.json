        "001716.webp",
        "001717.webp",
        "001743.webp",
        "001769.webp",
        "001770.webp",
        "001808.webp",
        "001846.webp",
        "001847.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Cách thượng nguồn sông Tiền hơn 50 km, cách thượng nguồn sông Hậu gần 80 km, sông Vàm Nao nối vào sông Tiền và sông Hậu như một dấu gạch nối nhẹ nhàng vắt ngang hai con sông mẹ.",
      "start": 75.04,
      "end": 91.2,
      "n_words": 39,
      "start_frame": 1876,
      "end_frame": 2280,
      "keyframes": [
        "001890.webp",
        "001933.webp",
        "001957.webp",
        "001992.webp",
        "002027.webp",
        "002052.webp",
        "002098.webp",
        "002145.webp",
        "002146.webp",
        "002179.webp",
        "002212.webp",
        "002226.webp",
        "002245.webp",
        "002264.webp",
        "002280.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Đây cũng là dòng sông được mệnh danh có nhiều cái nhất: dòng sông ngắn nhất Việt Nam với 6.5 km, dòng sông nguy hiểm nhất nơi có những loài cá nước ngọt to lớn nhất và cũng là nơi có nhiều truyền thuyết nhất.",
      "start": 91.2,
      "end": 122.36,
      "n_words": 45,
      "start_frame": 2280,
      "end_frame": 3059,
      "keyframes": [
        "002280.webp",
        "002295.webp",
        "002310.webp",
        "002311.webp",
        "002341.webp",
        "002372.webp",
        "002373.webp",
        "002415.webp",
