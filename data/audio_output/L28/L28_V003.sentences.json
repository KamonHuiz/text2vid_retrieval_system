        "004059.webp",
        "004084.webp",
        "004146.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Sông Vàm Nao chỉ dài độ 6.5 km, hầu như nằm gọn trong xã Tân Trung, huyện Phú Tân, thuộc xã Kiến An, huyện Chợ Mới, tỉnh An Giang.",
      "start": 166.28,
      "end": 179.2,
      "n_words": 29,
      "start_frame": 4157,
      "end_frame": 4480,
      "keyframes": [
        "004208.webp",
        "004232.webp",
        "004299.webp",
        "004366.webp",
        "004367.webp",
        "004422.webp",
        "004477.webp",
        "004478.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đó là cái chiều dài địa lý của Vàm Nao.",
      "start": 179.2,
      "end": 182.44,
      "n_words": 10,
      "start_frame": 4480,
      "end_frame": 4561,
      "keyframes": [
        "004505.webp",
        "004533.webp",
        "004534.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dân nơi này thường không quan tâm con sông dài bao nhiêu, chỉ biết nó bắt đầu từ Vàm Cái Đầm ngay chợ Tân Hòa và kết thúc ở Vàm Cây Mít gần chợ Đình thuộc thị trấn Phú Mỹ.",
      "start": 182.44,
      "end": 194.84,
      "n_words": 40,
      "start_frame": 4561,
      "end_frame": 4871,
      "keyframes": [
        "004597.webp",
        "004660.webp",
        "004672.webp",
        "004710.webp",
        "004749.webp",
        "004778.webp",
        "004853.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Hiện nay dân nơi đây đo con sông bằng ký ức, bằng kỷ niệm; Bởi vậy con sông cứ đằng đẵng bạt ngàn.",
      "start": 194.84,
      "end": 206.32,
      "n_words": 23,
      "start_frame": 4871,
      "end_frame": 5158,
      "keyframes": [
        "004929.webp",
        "004930.webp",
        "004982.webp",
        "005034.webp",
        "005035.webp",
        "005089.webp",
        "005143.webp",
        "005144.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Theo ngôn ngữ dân gian Nam Bộ, \"vàm\" là cửa của một con sông nhỏ giao với một con sông lớn, là nơi bắt đầu của một con kênh, một con rạch dẫn nước từ sông lớn về nơi có dòng chảy nhỏ hơn.",
      "start": 206.32,
      "end": 220.0,
      "n_words": 44,
      "start_frame": 5158,
      "end_frame": 5500,
      "keyframes": [
        "005231.webp",
        "005318.webp",
        "005319.webp",
        "005410.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ấy vậy mà khi đến đây, ngay tại cửa sông Tiền nối với sông Vàm Nao, chúng tôi không khỏi bất ngờ khi sông cũng bao la kiêu hãnh không khác gì sông mẹ.",
      "start": 220.0,
      "end": 233.0,
      "n_words": 34,
      "start_frame": 5500,
      "end_frame": 5825,
      "keyframes": [
        "005502.webp",
        "005503.webp",
        "005728.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tương truyền thuở xa xưa, sông này là con đường của những đàn voi và trâu rừng.",
      "start": 233.0,
      "end": 239.32,
      "n_words": 17,
      "start_frame": 5825,
      "end_frame": 5983,
      "keyframes": [
        "005954.webp",
        "005955.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ngày trước mực nước sông Tiền cao hơn sông Hậu gần nửa thước, khi vào đến Vàm Nao, sông Tiền sang bớt nước cho sông Hậu, nước chảy xiết, xoáy cuộn như thác.",
      "start": 239.32,
      "end": 252.8,
      "n_words": 33,
      "start_frame": 5983,
      "end_frame": 6320,
      "keyframes": [
        "006024.webp",
        "006093.webp",
        "006118.webp",
        "006174.webp",
        "006230.webp",
        "006255.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Áp lực của nước đã khiến bờ sông Vàm Nao mở rộng, Vàm Nao từ con rạch nhỏ đã trở thành một con sông rộng lớn dữ dội.",
      "start": 252.8,
      "end": 263.2,
      "n_words": 28,
      "start_frame": 6320,
      "end_frame": 6580,
      "keyframes": [
        "006342.webp",
        "006429.webp",
        "006430.webp",
        "006452.webp",
        "006475.webp",
        "006499.webp",
        "006528.webp",
        "006557.webp",
        "006558.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Người dân nơi đây nói rằng sở dĩ con sông này có chữ \"vàm\" là bởi vì cái vàm này hung dữ lắm, ghe xuồng đi ngang đều bị nhấn chìm; Người ta đặt \"vàm\" có nghĩa là chỗ nhấn nước, là vòng xoáy nước dữ dội.",
      "start": 263.2,
      "end": 278.2,
      "n_words": 47,
      "start_frame": 6580,
      "end_frame": 6955,
      "keyframes": [
        "006626.webp",
        "006694.webp",
        "006718.webp",
        "006769.webp",
        "006820.webp",
        "006821.webp",
        "006945.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Khi tới đó con người bất an sợ hãi nao lòng nên gọi là Nao.",
      "start": 278.2,
      "end": 284.0,
      "n_words": 15,
      "start_frame": 6955,
      "end_frame": 7100,
      "keyframes": [
        "007069.webp",
        "007096.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cũng có người nói Vàm Nao còn gọi là xoáy hồi oa vì nước chảy cuộn xoáy dữ tợn đến nỗi rắn bơi qua bị xoáy nước cuốn vào và vặn đứt đuôi.",
      "start": 284.0,
      "end": 297.6,
      "n_words": 33,
      "start_frame": 7100,
      "end_frame": 7440,
      "keyframes": [
        "007155.webp",
        "007215.webp",
        "007216.webp",
        "007275.webp",
        "007335.webp",
        "007336.webp",
        "007375.webp",
        "007415.webp",
        "007416.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Truyền thuyết còn kể dưới đáy sông có loài cá dữ rình rập, người bơi qua sông lật ghe lật thuyền để ăn thịt.",
      "start": 297.6,
      "end": 304.56,
      "n_words": 24,
      "start_frame": 7440,
      "end_frame": 7614,
      "keyframes": [
        "007476.webp",
        "007536.webp",
        "007537.webp",
        "007589.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Người ta cũng nói rằng nơi đây có ông Năm Chèo tức ông Xà Thần năm chân trong truyền thuyết nằm sám hối dưới ngã ba Vàm Nao, nơi mà ghe thuyền nào cũng phải ngang qua.",
      "start": 304.56,
      "end": 319.08,
      "n_words": 37,
      "start_frame": 7614,
      "end_frame": 7977,
      "keyframes": [
        "007641.webp",
        "007642.webp",
        "007683.webp",
        "007724.webp",
        "007725.webp",
        "007777.webp",
        "007829.webp",
        "007830.webp",
        "007862.webp",
        "007895.webp",
        "007896.webp",
        "007932.webp",
        "007968.webp",
        "007969.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Người ta nói ông nằm ẩn mình, lâu lâu trồi lên há miệng rất to đón lỏng ghe tàu, gặp người hiền thì ông độ, gặp người dữ thì trừ.",
      "start": 319.08,
      "end": 330.56,
      "n_words": 30,
      "start_frame": 7977,
      "end_frame": 8264,
      "keyframes": [
        "008048.webp",
        "008128.webp",
        "008129.webp",
        "008190.webp",
        "008251.webp",
        "008252.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các thương hồ ngán Vàm Nao nhưng muốn xuôi ngược tứ xứ hay lên Nam Vang, Campuchia thì không còn đường nào khác buộc phải qua đây, bởi thế mới có câu: \"Bắp non mà đứng cửa lò đố ai ve được con đò Vàm Nao\".",
      "start": 330.56,
      "end": 352.6,
      "n_words": 46,
      "start_frame": 8264,
      "end_frame": 8815,
      "keyframes": [
        "008317.webp",
        "008382.webp",
        "008383.webp",
        "008449.webp",
        "008515.webp",
        "008516.webp",
        "008571.webp",
        "008627.webp",
        "008628.webp",
        "008682.webp",
        "008737.webp",
        "008738.webp",
        "008778.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Sách kể rằng năm 1700, khi Lễ hành hầu Nguyễn Hữu Cảnh phụng mệnh Chúa Nguyễn mở mang bờ cõi về phương Nam, đến đây với mong muốn giảm thiểu thủy nạn trên con sông này nên đã đặt cho Vàm Nao cái tên Thuận Vàm và con sông này là Thuận Giang.",
      "start": 352.6,
      "end": 372.2,
      "n_words": 53,
      "start_frame": 8815,
      "end_frame": 9305,
      "keyframes": [
        "008818.webp",
        "008975.webp",
        "009014.webp",
        "009053.webp",
        "009078.webp",
        "009110.webp",
        "009143.webp",
        "009144.webp",
        "009203.webp",
        "009262.webp",
        "009263.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Gần 100 năm sau, Bùi Hữu Nghĩa một vị quan của triều Nguyễn trên đường bị lưu đầy về vùng Châu Đốc, khi đi ngang qua vùng Thoại Sơn, Vàm Nao đã cảm khái: \"Núi sập sấm rền vang tiếng mũi Vàm Nao, nước chảy đứt đuôi xà Vàm Nao\".",
      "start": 372.2,
      "end": 392.64,
      "n_words": 50,
      "start_frame": 9305,
      "end_frame": 9816,
      "keyframes": [
        "009316.webp",
        "009370.webp",
        "009371.webp",
        "009424.webp",
        "009477.webp",
        "009478.webp",
        "009513.webp",
        "009549.webp",
        "009603.webp",
        "009683.webp",
        "009764.webp",
        "009790.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Dòng sông nổi tiếng linh thiêng này cũng là nơi xảy ra trận thủy chiến khốc liệt giữa quân ta và quân Xiêm vào cuối năm 1833 khiến kẻ thù phải kinh hồn bạt vía.",
      "start": 392.64,
      "end": 403.96,
      "n_words": 35,
      "start_frame": 9816,
      "end_frame": 10099,
      "keyframes": [
        "009844.webp",
        "009898.webp",
        "009941.webp",
        "010070.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Sau gần 200 năm, vạn vật biến thiên nhưng những câu chuyện về Vàm Nao vẫn còn được truyền miệng trong dân gian.",
      "start": 403.96,
      "end": 412.4,
      "n_words": 23,
      "start_frame": 10099,
      "end_frame": 10310,
      "keyframes": [
        "010200.webp",
        "010201.webp",
        "010238.webp",
        "010275.webp",
        "010276.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bởi dù là một nhánh của Mê Công êm đềm nhưng khi nhắc đến Vàm Nao, người ta lại nhớ đến con sông có cái nếp chảy cuộn tròn khác biệt và hung hãn.",
      "start": 412.4,
      "end": 423.04,
      "n_words": 34,
      "start_frame": 10310,
      "end_frame": 10576,
      "keyframes": [
        "010355.webp",
        "010434.webp",
        "010435.webp",
        "010507.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bao nhiêu năm trôi qua, mặc dù đã có thêm những thủy danh như Thuận Vàm, Thuận Cảng hay cái tên Thuận Giang vẫn còn tồn tại đến ngày nay nhưng người ta vẫn gọi tên dòng sông này là Vàm Nao bằng tất cả sự kính cẩn yêu thương dành cho một dòng sông huyền bí.",
      "start": 423.04,
      "end": 442.68,
      "n_words": 57,
      "start_frame": 10576,
      "end_frame": 11067,
      "keyframes": [
        "010579.webp",
        "010580.webp",
        "010620.webp",
        "010661.webp",
        "010688.webp",
        "010753.webp",
        "010819.webp",
        "010820.webp",
        "010885.webp",
        "010950.webp",
        "010951.webp",
        "010999.webp",
        "011047.webp",
        "011048.webp",
        "011064.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "\"Vàm Nao là cái nơi cửa sông nước chảy làm đau lòng người ta mà thôi, là khi ngó dòng nước khi chiều tà bóng xế coi buồn đứt ruột đứt gan chứ chẳng chơi\".",
      "start": 442.68,
      "end": 455.44,
      "n_words": 35,
      "start_frame": 11067,
      "end_frame": 11386,
      "keyframes": [
        "011081.webp",
