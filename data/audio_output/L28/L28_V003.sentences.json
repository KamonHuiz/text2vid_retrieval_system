        "001127.webp",
        "001139.webp"
      ],
      "keyframe_count": 28
    },
    {
      "text": "Bước vào lãnh thổ Việt Nam, sông Tiền mang nhịp sống năng động mạnh mẽ, trong khi sông Hậu vẫn là dòng chảy hiền hòa, lãng mạn nhẹ nhàng.",
      "start": 49.84,
      "end": 59.8,
      "n_words": 29,
      "start_frame": 1246,
      "end_frame": 1495,
      "keyframes": [
        "001258.webp",
        "001378.webp",
        "001379.webp",
        "001445.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Hai con sông lặng lẽ chảy song song, cơ hồ như hai đứa con của mẹ Cửu Long, bất hòa chẳng thèm chạm mặt nhau đến nỗi phải có một Vàm Nao kết giao hai dòng nước.",
      "start": 59.8,
      "end": 75.04,
      "n_words": 37,
      "start_frame": 1495,
      "end_frame": 1876,
      "keyframes": [
        "001512.webp",
