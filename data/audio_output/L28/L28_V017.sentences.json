      "end_frame": 24412,
      "keyframes": [
        "024093.webp",
        "024094.webp",
        "024235.webp",
        "024376.webp",
        "024377.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chỉ khi đứng ở đỉnh núi Bà Đen nhìn xuống ta mới cảm nhận được cảnh sắc thiên nhiên mà Mạc Thiên Tích đã vịnh trong bài thơ Lộc Trĩ.",
      "start": 976.48,
      "end": 985.44,
      "n_words": 30,
      "start_frame": 24412,
      "end_frame": 24636,
      "keyframes": [
        "024468.webp",
        "024559.webp",
        "024560.webp",
        "024610.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thôn cư Lộc Trĩ trĩ ý tả, một mõm núi nhô ra mặt biển, nếu ai đi thuyền từ ngoài biển nhìn vào sẽ cảm thấy hình dáng giống như đầu của một con nai đang nằm.",
      "start": 985.44,
      "end": 997.28,
      "n_words": 37,
      "start_frame": 24636,
      "end_frame": 24932,
      "keyframes": [
        "024660.webp",
