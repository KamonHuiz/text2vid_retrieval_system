        "004366.webp",
        "004437.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Hồi xưa là hầu như cái con này được đánh bắt vô chủ yếu là chế biến như dạng như là mình xào khóm.\"",
      "start": 179.52,
      "end": 185.84,
      "n_words": 24,
