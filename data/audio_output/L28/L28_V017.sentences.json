      ],
      "keyframe_count": 12
    },
    {
      "text": "\"Món đặc biệt đây.",
      "start": 838.2,
      "end": 840.32,
      "n_words": 4,
      "start_frame": 20955,
      "end_frame": 21008,
      "keyframes": [
        "020957.webp",
        "020995.webp",
        "020996.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hấp dẫn quá vậy món đặc biệt là món gì?\"",
      "start": 840.32,
      "end": 843.4,
      "n_words": 10,
      "start_frame": 21008,
      "end_frame": 21085,
      "keyframes": [
        "021062.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "\"Món gà đốt đó, ta ở chỗ năm là tết Củ Chi.\"",
      "start": 843.4,
      "end": 851.88,
      "n_words": 12,
      "start_frame": 21085,
      "end_frame": 21297,
      "keyframes": [
        "021128.webp",
