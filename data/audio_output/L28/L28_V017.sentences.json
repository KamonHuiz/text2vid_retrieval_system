        "020246.webp",
        "020303.webp",
        "020304.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "\"Hai đứa ăn chừa bụng nha chị, bụng nha chị còn cái món đặc biệt nữa đó.\" \"Còn món đặc biệt nữa?",
      "start": 812.24,
      "end": 817.88,
      "n_words": 22,
      "start_frame": 20306,
      "end_frame": 20447,
      "keyframes": [
        "020346.webp",
        "020389.webp",
        "020390.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Em ăn nãy giờ muốn ngất đi đây.\"",
      "start": 817.88,
      "end": 838.2,
      "n_words": 8,
      "start_frame": 20447,
      "end_frame": 20955,
