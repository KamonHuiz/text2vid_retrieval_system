        "023325.webp",
        "023373.webp",
        "023374.webp",
        "023461.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tạm biệt gia đình chị Mỹ Loan với bữa cơm thật ngon, không chỉ được thưởng thức đặc sản của người Khmer mà còn là hương vị ấm áp nghĩa tình hiền hòa mến khách của người dân xứ Hà Tiên.",
      "start": 939.68,
      "end": 960.84,
      "n_words": 41,
      "start_frame": 23492,
      "end_frame": 24021,
      "keyframes": [
        "023549.webp",
