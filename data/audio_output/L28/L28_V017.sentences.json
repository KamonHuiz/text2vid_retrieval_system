        "006488.webp",
        "006516.webp",
        "006517.webp",
        "006583.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Theo chân bác Ba đi dọc con đường mòn lên núi, vườn tiêu của gia đình bác đang trong giai đoạn vun xới cho đất tơi xốp rồi bón phân trước khi đón những cơn mưa đầu mùa.",
      "start": 265.68,
      "end": 278.24,
      "n_words": 38,
      "start_frame": 6642,
      "end_frame": 6956,
      "keyframes": [
        "006649.webp",
        "006650.webp",
        "006740.webp",
        "006831.webp",
        "006832.webp",
        "006896.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vì điều kiện canh tác trên núi cao, thổ nhưỡng khí hậu đặc biệt nên cách trồng và chăm sóc cũng có những khác biệt.",
      "start": 278.24,
      "end": 286.96,
      "n_words": 25,
      "start_frame": 6956,
      "end_frame": 7174,
      "keyframes": [
        "006960.webp",
        "006961.webp",
        "006987.webp",
        "007014.webp",
        "007015.webp",
        "007042.webp",
        "007070.webp",
        "007071.webp",
        "007134.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "\"Giống tiêu này theo đúng từ hồi xưa tới giờ thời ông. Phải nói gần đây, nói gần đây đâu, nó quá lâu.",
      "start": 286.96,
      "end": 292.6,
      "n_words": 23,
      "start_frame": 7174,
      "end_frame": 7315,
      "keyframes": [
        "007197.webp",
        "007198.webp",
        "007257.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đất núi nó dốc mà mình phải kể đá cuốc lại cho nó bằng mới trồng được.",
      "start": 292.6,
      "end": 296.04,
      "n_words": 17,
      "start_frame": 7315,
      "end_frame": 7401,
      "keyframes": [
        "007316.webp",
        "007317.webp",
        "007328.webp",
        "007340.webp",
        "007341.webp",
        "007396.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phải đào hố xuống, khoảng thí dụ như mình cắt tới bảy mắt lận, bảy mắt mình lắp xuống năm mắt, trừ lại hai mắt lên nó mọc, nó mọc hai tượng, hai tượng lên đó.",
      "start": 296.04,
      "end": 305.44,
      "n_words": 36,
      "start_frame": 7401,
      "end_frame": 7636,
      "keyframes": [
        "007452.webp",
        "007453.webp",
        "007514.webp",
        "007575.webp",
        "007576.webp",
        "007593.webp",
        "007610.webp",
        "007611.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Tới năm sau mình cắt bỏ nó mọc thành bốn năm tượng rồi người ta lấy luôn.",
      "start": 305.44,
      "end": 309.32,
      "n_words": 17,
      "start_frame": 7636,
      "end_frame": 7733,
      "keyframes": [
        "007669.webp",
        "007728.webp",
        "007729.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Năm thứ ba mới được thu hoạch bởi vì nó trồng sông nó để xuống sông nó sống dài, bởi vì tiêu dùng này là có thể nó sống được mấy chục năm luôn, năm 60 năm luôn đó.",
      "start": 309.32,
      "end": 318.48,
      "n_words": 39,
      "start_frame": 7733,
      "end_frame": 7962,
      "keyframes": [
        "007753.webp",
        "007778.webp",
        "007779.webp",
        "007868.webp",
        "007958.webp",
        "007959.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bởi vậy nó cái trái này nó rất là ngon, nó có chất thơm, có chất cay, nó ngon lắm.",
      "start": 318.48,
      "end": 323.04,
      "n_words": 20,
      "start_frame": 7962,
      "end_frame": 8076,
      "keyframes": [
        "008021.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chung tiêu có giá nó ổn định lắm nhưng lúc này thời tiết nó thay đổi rồi bị hạn hán, trên cao mình tiêu nổi mình không có đủ điều kiện thì sao giờ?",
      "start": 323.24,
      "end": 330.76,
      "n_words": 34,
      "start_frame": 8081,
      "end_frame": 8269,
      "keyframes": [
        "008083.webp",
        "008084.webp",
        "008132.webp",
        "008181.webp",
        "008182.webp",
        "008228.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ở vùng này thì mình không làm cái gì rồi mình cố gắng thôi, tới lúc lên giá thì mình có thôi, vậy thôi mình cứ duy trì ra vậy đó, có giá cái mình có thể làm tiếp nữa.\"",
      "start": 330.76,
      "end": 340.88,
      "n_words": 40,
      "start_frame": 8269,
      "end_frame": 8522,
      "keyframes": [
        "008274.webp",
        "008275.webp",
        "008384.webp",
        "008494.webp",
        "008495.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trên vùng đất sỏi lại rất ít giữ nước, sinh trưởng chủ yếu dựa vào thiên nhiên nên hình dáng của cây tiêu nhỏ hơn các vùng khác, hạt tiêu cũng nhỏ hơn nhưng lại cho vị thơm và cay nồng đặc trưng.",
      "start": 340.88,
      "end": 353.8,
      "n_words": 43,
      "start_frame": 8522,
      "end_frame": 8845,
      "keyframes": [
        "008569.webp",
