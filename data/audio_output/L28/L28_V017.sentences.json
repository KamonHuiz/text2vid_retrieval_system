      "start_frame": 18436,
      "end_frame": 18525,
      "keyframes": [
        "018478.webp",
        "018479.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "\"Sao vừa không?",
      "start": 741.0,
      "end": 742.6,
      "n_words": 3,
      "start_frame": 18525,
      "end_frame": 18565,
      "keyframes": [
        "018561.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Còn khi em ăn vô là em cảm nhận được cái vị béo của nước cốt dừa với cái vị nước mắm nhưng mà nó cay quá tại vì em ăn cay không có được.",
      "start": 742.6,
