        "026851.webp",
        "026852.webp",
        "026947.webp",
        "027042.webp",
        "027043.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nếu hồi xưa ví von Hà Tiên có thập vịnh cảnh thì ngày nay sở hữu cảnh quan thiên nhiên trong lành thoáng mát, ngọn núi Đèn đã được người dân khen ngợi là cảnh đẹp thứ 11 của vùng đất này.",
      "start": 1081.92,
      "end": 1099.04,
      "n_words": 42,
      "start_frame": 27048,
      "end_frame": 27476,
      "keyframes": [
        "027128.webp",
