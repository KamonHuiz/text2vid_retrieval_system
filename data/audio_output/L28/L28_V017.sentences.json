        "002373.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chợ Hà Tiên bao năm qua vẫn là ngôi nhà chung của hàng trăm tiểu thương cùng nhau bám trụ mưu sinh.",
      "start": 95.52,
