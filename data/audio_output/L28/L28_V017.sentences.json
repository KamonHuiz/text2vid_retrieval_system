        "004789.webp",
        "004834.webp",
        "004835.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Với tình yêu dành cho sản vật của quê hương, chị Trang đã nghiên cứu và đầu tư quy trình chế biến sản xuất.",
      "start": 194.52,
      "end": 201.6,
      "n_words": 24,
      "start_frame": 4863,
      "end_frame": 5040,
      "keyframes": [
        "004884.webp",
