        "021232.webp",
        "021295.webp",
        "021296.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "thấy hấp dẫn quá, mời ăn thử đi.",
      "start": 852.08,
      "end": 854.2,
      "n_words": 8,
      "start_frame": 21302,
