        "023117.webp",
        "023188.webp",
        "023189.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "\"Mấy đứa đi xuống Hà Tiên, xuống Hà Tiên đi ngang rồi ghé đây nói chị làm còn thêm nhiều món nữa.\"",
      "start": 928.4,
      "end": 939.68,
      "n_words": 22,
