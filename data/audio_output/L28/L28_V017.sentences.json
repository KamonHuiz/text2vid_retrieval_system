        "026197.webp",
        "026259.webp",
        "026260.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Ngọn đèn hải đăng luôn là vị cứu tinh cho tàu thuyền qua lại cập bến mỗi đêm và là cột mốc chủ quyền biển đảo của Việt Nam.",
      "start": 1054.24,
      "end": 1062.48,
      "n_words": 29,
      "start_frame": 26356,
      "end_frame": 26562,
      "keyframes": [
        "026407.webp",
        "026554.webp",
        "026555.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Từ đây phóng tầm mắt ra xa ta có thể thấy thành phố Hà Tiên thu nhỏ, một bên là ngọn núi Tà Ban và bãi biển Mũi Nai, xa xa là vùng biển đảo của Hà Tiên và tuyến đường điện quốc gia dẫn ra quần đảo Tiên Hải.",
      "start": 1062.48,
      "end": 1081.92,
      "n_words": 50,
      "start_frame": 26562,
      "end_frame": 27048,
      "keyframes": [
        "026621.webp",
