        "024713.webp",
        "024765.webp",
        "024766.webp",
        "024844.webp",
        "024923.webp",
        "024924.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mũi Nai như bức tranh sơn thủy hữu tình, sóng biển rì rào khe khẽ, tiếng gió lao xao rì rào cùng bãi cát trắng đã làm say lòng biết bao du khách.",
      "start": 997.28,
      "end": 1021.52,
      "n_words": 33,
      "start_frame": 24932,
      "end_frame": 25538,
      "keyframes": [
        "024960.webp",
