        "018317.webp",
        "018318.webp"
      ],
      "keyframe_count": 26
    },
    {
      "text": "\"Trời nhìn hấp dẫn quá chị, xanh đỏ đủ màu đẹp quá.\"",
      "start": 733.16,
      "end": 737.44,
      "n_words": 12,
