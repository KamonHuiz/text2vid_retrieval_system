        "003569.webp",
        "003570.webp",
        "003664.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "\"Cái nghề truyền thống của nhà mình là xuất phát từ cái đời bà ngoại.",
      "start": 148.4,
      "end": 152.2,
