        "019494.webp",
        "019495.webp",
        "019582.webp"
      ],
      "keyframe_count": 21
    },
    {
      "text": "\"Rồi chị có thêm nước mắm không? Em thấy vậy là vừa ăn.\"",
      "start": 785.16,
      "end": 792.2,
      "n_words": 13,
