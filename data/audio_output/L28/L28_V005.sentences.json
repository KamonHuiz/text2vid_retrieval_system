      "start_frame": 9797,
      "end_frame": 9833,
      "keyframes": [
        "009820.webp",
        "009821.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ký ức mà ông Môn vừa kể là cách đây 40 năm.",
      "start": 393.64,
      "end": 405.28,
      "n_words": 12,
      "start_frame": 9841,
