        "003255.webp",
        "003279.webp",
        "003303.webp",
        "003304.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thì theo Quỳnh, tại sao địa danh này lại được người Cà Mau quan tâm và nhắc nhiều đến như vậy?",
      "start": 132.2,
      "end": 137.36,
      "n_words": 21,
      "start_frame": 3305,
      "end_frame": 3434,
      "keyframes": [
        "003348.webp",
        "003392.webp",
        "003393.webp",
        "003413.webp",
        "003434.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Theo Quỳnh nghĩ, Sông Đốc là một vùng đất mang nhiều giá trị về văn hóa và lịch sử.",
      "start": 137.36,
      "end": 141.88,
      "n_words": 19,
      "start_frame": 3434,
      "end_frame": 3547,
      "keyframes": [
        "003434.webp",
        "003435.webp",
        "003489.webp",
        "003543.webp",
        "003544.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và khi đến với Sông Đốc, thì Quỳnh thấy lễ hội Nghinh Ông Sông Đốc được nhiều người dân tham gia và hưởng ứng.",
      "start": 141.88,
      "end": 148.64,
      "n_words": 24,
      "start_frame": 3547,
      "end_frame": 3716,
      "keyframes": [
        "003572.webp",
        "003601.webp",
        "003602.webp",
        "003639.webp",
        "003676.webp",
        "003677.webp",
        "003713.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Quả thật đúng như là Quỳnh nói, khi đoàn mình đặt chân đến thị trấn Sông Đốc và khi đứng trên cây cầu Sông Đốc này bắc ngang sông, chúng ta thấy được những cái công tác chuẩn bị bắt đầu từ ngày 13 âm lịch.",
      "start": 148.64,
      "end": 161.96,
      "n_words": 46,
      "start_frame": 3716,
      "end_frame": 4049,
      "keyframes": [
        "003749.webp",
