        "006523.webp",
        "006552.webp",
        "006582.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Trong mạch sống của đồng bằng sông Cửu Long, nơi thấm đẫm huyền thoại hơn 300 năm khai hoang mở đất, làm nên một truyền thống văn hóa sông nước mang đậm màu sắc của vùng đất và con người phương Nam.",
      "start": 264.04,
      "end": 278.48,
      "n_words": 42,
      "start_frame": 6601,
      "end_frame": 6962,
      "keyframes": [
        "006612.webp",
