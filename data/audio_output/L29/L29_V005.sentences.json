        "003827.webp",
        "003828.webp",
        "003910.webp",
        "003993.webp",
        "003994.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Những hội thao đã được diễn ra rồi, nào là thi đua bơi xuồng trên sông dễ thương nha, hội thi chèo truyền thống, wow, rất là thú vị luôn, hội thi kéo co và đặc biệt không thể nào mà bỏ quên cái truyền thống lao động của nhân dân mình là hội thi vá lưới, rất là đặc trưng của người dân miền biển.",
      "start": 161.96,
      "end": 183.24,
      "n_words": 66,
      "start_frame": 4049,
      "end_frame": 4581,
      "keyframes": [
        "004054.webp",
