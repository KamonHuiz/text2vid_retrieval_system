        "006881.webp",
        "006911.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Trong lịch sử dựng nước và giữ nước của dân tộc ta, biển cả đóng một vai trò quan trọng trong đời sống lao động sản xuất và đấu tranh sinh tồn của người Việt.",
      "start": 278.48,
      "end": 289.12,
      "n_words": 35,
      "start_frame": 6962,
      "end_frame": 7228,
      "keyframes": [
        "006972.webp",
