        "007115.webp",
        "007167.webp",
        "007168.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ở các địa phương ven biển, làng nghề được hình thành và phát triển từ rất sớm, gắn liền với cuộc sống lao động mưu sinh ở biển khơi, góp phần tạo sinh kế làm ăn của người dân dọc hai bờ sông Đốc.",
      "start": 289.12,
      "end": 305.12,
      "n_words": 44,
      "start_frame": 7228,
      "end_frame": 7628,
      "keyframes": [
        "007259.webp",
