        "005699.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Từ nãy đến giờ là Quỳnh đã rất là muốn rủ mời cùng Quỳnh đi vào không gian lễ hội. Hội.",
      "start": 228.96,
      "end": 233.48,
      "n_words": 21,
      "start_frame": 5724,
      "end_frame": 5837,
      "keyframes": [
        "005742.webp",
        "005743.webp",
        "005792.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Gian lễ hội, dạ thưa quý vị khán giả, xin mời quý vị khán giả cùng mời đi vào không gian văn hóa lễ hội của lễ Nghinh Ông Sông Đốc phương Nam.",
      "start": 233.0,
      "end": 253.56,
      "n_words": 33,
      "start_frame": 5825,
      "end_frame": 6339,
      "keyframes": [
