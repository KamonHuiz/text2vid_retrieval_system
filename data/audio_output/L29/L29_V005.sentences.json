        "004384.webp",
        "004503.webp",
        "004504.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Những cái hoạt động này gắn liền với cái hình ảnh lao động của mọi người hàng ngày, nhưng mà nó cũng tạo nên một cái không khí để chuẩn bị bước vào lễ hội Ông.",
      "start": 183.24,
      "end": 193.08,
      "n_words": 36,
      "start_frame": 4581,
      "end_frame": 4827,
      "keyframes": [
        "004625.webp",
        "004746.webp",
        "004747.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Có lẽ rằng cái ý nghĩa chính của lễ hội Ông là mọi người tạo nên một cái tín ngưỡng, cái niềm tin vào cá Ông, vào Ông đã che chở mọi người, đã giúp đỡ mọi người được sống yên ổn, được những cái chuyến cày lưới thu hoạch thật là đạt hiệu quả tôm cá.",
      "start": 193.08,
      "end": 214.36,
      "n_words": 57,
      "start_frame": 4827,
      "end_frame": 5359,
      "keyframes": [
        "004870.webp",
