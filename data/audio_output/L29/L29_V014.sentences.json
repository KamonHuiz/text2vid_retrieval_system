        "004675.webp",
        "004676.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đây là những sản phẩm mộc mạc nhưng không thể thiếu trong nhà của mỗi người dân quê.",
      "start": 187.64,
