        "009368.webp",
        "009464.webp",
        "009496.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Có ba loại chút: mình loại bự, loại vừa, loại nhỏ.",
      "start": 381.8,
      "end": 386.96,
      "n_words": 11,
      "start_frame": 9545,
      "end_frame": 9674,
