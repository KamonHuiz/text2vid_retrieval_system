      ],
      "keyframe_count": 42
    },
    {
      "text": "Âm nhạc chính là hình thức được lựa chọn để hiện thực hóa mong muốn nhân văn ấy.",
      "start": 85.56,
      "end": 91.84,
      "n_words": 18,
      "start_frame": 2139,
      "end_frame": 2296,
      "keyframes": [
        "002187.webp",
        "002241.webp",
        "002242.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tháng 11 năm 2023, Hợp xướng Đa Dạng vượt qua 112 đoàn đến từ các quốc gia trong cuộc thi hợp xướng quốc tế Inter tổ chức tại Hải Nam, Trung Quốc và đạt huy chương đồng.",
      "start": 91.84,
      "end": 105.2,
      "n_words": 37,
      "start_frame": 2296,
      "end_frame": 2630,
      "keyframes": [
        "002297.webp",
