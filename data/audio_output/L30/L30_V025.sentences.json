        "002910.webp",
        "002923.webp",
        "002924.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Dự án kết hợp với sinh viên các trường đại học để lan tỏa năng lượng tích cực.",
      "start": 117.88,
      "end": 123.32,
      "n_words": 18,
      "start_frame": 2947,
      "end_frame": 3083,
      "keyframes": [
        "002952.webp",
