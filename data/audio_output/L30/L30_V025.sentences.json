  "sentences": [
    {
      "text": "Một không gian biểu diễn ấm cúng trong đêm nhạc ra mắt \"Đồng hát cùng Youli\" vừa diễn ra tại Hà Nội với sự tham gia của những thành viên đến từ nhiều tỉnh thành khác nhau như Hà Nội, Bắc Giang, Quy Nhơn, Thành phố Hồ Chí Minh.",
      "start": 0.04,
      "end": 28.24,
      "n_words": 49,
      "start_frame": 1,
      "end_frame": 706,
      "keyframes": [
        "000075.webp",
