        "004797.webp",
        "004798.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tôi muốn là cái âm nhạc hôm nay nó sẽ lan tỏa đến mọi người để cho mọi người sống vui hơn, tốt hơn và khỏe hơn\".",
      "start": 192.12,
      "end": 233.92,
      "n_words": 27,
      "start_frame": 4803,
      "end_frame": 5848,
      "keyframes": [
        "004904.webp",
