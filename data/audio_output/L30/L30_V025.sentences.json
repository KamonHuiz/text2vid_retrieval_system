        "000863.webp",
        "000927.webp",
        "000928.webp",
        "000962.webp",
        "000996.webp",
        "000997.webp",
        "001071.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Họ là thành viên của một dàn hợp xướng mang tên Đa Dạng.",
      "start": 44.16,
      "end": 48.44,
      "n_words": 13,
      "start_frame": 1104,
      "end_frame": 1211,
      "keyframes": [
        "001146.webp",
        "001147.webp",
        "001193.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cái tên đúng như tính chất đa ngành nghề, lứa tuổi, giới tính của cả nhóm, tôn vinh sự đa dạng, tôn trọng sự khác biệt, sự bình đẳng xã hội, nhất là với những người khuyết tật, những người yếu thế trong xã hội.",
      "start": 48.44,
      "end": 63.24,
      "n_words": 45,
      "start_frame": 1211,
      "end_frame": 1581,
      "keyframes": [
        "001239.webp",
        "001240.webp",
        "001409.webp",
        "001579.webp",
        "001580.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bà Hoàng Thị Thu Hường, người sáng lập Hợp xướng Đa Dạng, cho biết dàn hợp xướng được thành lập vào năm 2018, khởi nguồn từ trăn trở của bà là làm sao xây dựng được một dự án cộng đồng có thể thu hút nhiều thành phần tham gia, cùng chia sẻ một mối quan tâm chung, một niềm hứng khởi, một hoạt động ý nghĩa tạo sự gắn kết.",
      "start": 63.24,
      "end": 85.56,
      "n_words": 71,
      "start_frame": 1581,
      "end_frame": 2139,
