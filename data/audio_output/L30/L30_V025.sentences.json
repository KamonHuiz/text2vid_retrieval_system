        "002583.webp",
        "002621.webp",
        "002622.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Ngoài ra, nhóm thường xuyên biểu diễn trong các chương trình hoạt động vì cộng đồng khác như hòa nhạc \"Vì một Hà Nội đáng sống\", biểu diễn tại trụ sở Liên Hợp Quốc tại Việt Nam nhân ngày Môi trường Thế giới.",
      "start": 105.2,
      "end": 117.16,
      "n_words": 43,
      "start_frame": 2630,
      "end_frame": 2929,
      "keyframes": [
        "002673.webp",
