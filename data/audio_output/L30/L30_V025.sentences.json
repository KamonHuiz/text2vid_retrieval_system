        "000460.webp",
        "000461.webp",
        "000629.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Họ gồm nhiều lứa tuổi, ngành nghề khác nhau như bác sĩ, dược sĩ, kỹ sư, nhân viên văn phòng, nhà báo, bán hàng tạp hóa, sinh viên, học sinh; Trong đó tập trung nhiều nhất là những người già, người khuyết tật.",
      "start": 28.24,
      "end": 44.16,
      "n_words": 43,
      "start_frame": 706,
      "end_frame": 1104,
      "keyframes": [
        "000798.webp",
