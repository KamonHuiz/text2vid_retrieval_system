  "sentences": [
    {
      "text": "Dạo gần đây trên mạng xã hội xuất hiện gánh hàng rong độc lạ và trở nên viral vì bà chủ đêm nào cũng ngủ quên, khách đến mua phải tự trộn bánh tráng.",
      "start": 12.28,
      "end": 21.52,
      "n_words": 34,
      "start_frame": 307,
      "end_frame": 538,
      "keyframes": [
        "000331.webp",
