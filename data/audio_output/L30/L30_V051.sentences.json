        "000464.webp",
        "000506.webp",
        "000513.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chủ của gánh hàng rong độc lạ này là bà Nguyễn Thị Kim Cương, 63 tuổi, quê tỉnh Bình Định, bán hàng rong ở đường Lê Thánh Tôn, Quận 1, Thành phố Hồ Chí Minh.",
      "start": 21.52,
      "end": 30.04,
      "n_words": 35,
      "start_frame": 538,
      "end_frame": 751,
      "keyframes": [
        "000699.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bà Kim Cương được một số bạn trẻ gọi đầy yêu thương là mẹ vì sự hiền lành, dễ thương, dễ mến; Cũng có bạn gọi vui bà là nữ hoàng Canada vì bà có khuôn mặt na ná nữ diễn viên đóng vai này.",
      "start": 30.04,
      "end": 42.56,
      "n_words": 45,
      "start_frame": 751,
      "end_frame": 1064,
      "keyframes": [
        "000885.webp",
        "000886.webp",
        "000930.webp",
        "000975.webp",
        "000976.webp",
        "001013.webp",
        "001050.webp",
        "001051.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bà sinh ra và lớn lên ở Bình Định, 24 năm trước bà rời quê vào Thành phố Hồ Chí Minh mưu sinh.",
      "start": 42.56,
      "end": 48.16,
      "n_words": 23,
      "start_frame": 1064,
      "end_frame": 1204,
      "keyframes": [
        "001096.webp",
        "001142.webp",
        "001143.webp",
        "001190.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bà thuê trọ ở phường Cầu Ông Lãnh.",
      "start": 48.16,
      "end": 50.2,
      "n_words": 8,
      "start_frame": 1204,
      "end_frame": 1255,
      "keyframes": [
        "001237.webp",
        "001238.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ngày cứ 11:00 trưa bà gánh bánh tráng đi bán dạo quanh Quận 1, tới 21:00 tối bà mới ngồi cố định tại đường Lê Thánh Tôn rồi bán đến khoảng 23:00 đêm, 3:00 sáng thì dọn hàng về tới phòng trọ.",
      "start": 50.44,
      "end": 62.6,
      "n_words": 42,
      "start_frame": 1261,
      "end_frame": 1565,
      "keyframes": [
        "001284.webp",
        "001331.webp",
        "001332.webp",
        "001385.webp",
        "001438.webp",
        "001439.webp",
        "001485.webp",
        "001531.webp",
        "001532.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bà ngủ vài tiếng rồi dậy đi mua nguyên liệu sơ chế để chuẩn bị cho một ngày bán mới.",
      "start": 62.6,
      "end": 67.68,
      "n_words": 20,
      "start_frame": 1565,
      "end_frame": 1692,
      "keyframes": [
        "001571.webp",
        "001611.webp",
        "001612.webp",
        "001673.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thức khuya dậy sớm khiến bà luôn trong tình trạng thiếu ngủ nên bà thường ngủ quên khi bán hàng.",
      "start": 67.68,
      "end": 73.12,
      "n_words": 20,
      "start_frame": 1692,
      "end_frame": 1828,
      "keyframes": [
        "001734.webp",
        "001735.webp",
        "001778.webp",
        "001821.webp",
        "001822.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Do có nhiều khách quen lâu năm nên thậm chí có khi bà còn nhờ bán hàng dùm để bà kiếm chỗ ngủ.",
      "start": 73.12,
      "end": 82.32,
      "n_words": 23,
      "start_frame": 1828,
      "end_frame": 2058,
      "keyframes": [
        "001882.webp",
        "001942.webp",
        "001943.webp",
        "001989.webp",
        "002035.webp",
        "002036.webp",
        "002053.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "\"Không biết sao buồn ngủ không, bắt bà quên suy nghĩ gì đâu, hai đứa không biết sao hai đứa nó quen nhau quá, bà quen nhau mà giờ có cô tám tuổi là tới tối nào là nó ra nó ăn bánh tráng, nói chung họ ngày nào nó cũng ăn ngon, nói chung hai đứa nó cũng đàng hoàng.\"",
      "start": 82.32,
      "end": 113.52,
      "n_words": 61,
      "start_frame": 2058,
      "end_frame": 2838,
      "keyframes": [
        "002070.webp",
        "002071.webp",
        "002173.webp",
        "002275.webp",
        "002276.webp",
        "002333.webp",
        "002390.webp",
        "002391.webp",
        "002415.webp",
        "002421.webp",
