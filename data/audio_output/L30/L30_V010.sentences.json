      ],
      "keyframe_count": 6
    },
    {
      "text": "Khác với những lớp học chính quy, tại các lớp học tình thương ở chùa Long Cát, xã Công Hải, huyện Thuận Bắc, không khí không sôi động, không tiếng loa phát thanh, không tiếng trống trường nhưng ngập tràn tình yêu thương.",
      "start": 31.04,
      "end": 43.16,
      "n_words": 43,
      "start_frame": 776,
