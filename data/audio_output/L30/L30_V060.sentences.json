        "002236.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Năm 2020 thì em nhập của Thái rất là nhiều, khoảng 600 màu.",
      "start": 89.48,
      "end": 93.72,
      "n_words": 13,
