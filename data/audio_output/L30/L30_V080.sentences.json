  "total_words": 797,
  "sentences": [
    {
      "text": "Như ở làng Phạm Pháo, huyện Hải Hậu, tỉnh Nam Định có một người đàn ông nổi tiếng với gia tài là gần 2.000 chiếc kèn đồng to nhỏ, lớn bé đủ các thể loại.",
      "start": 0.04,
      "end": 23.04,
      "n_words": 35,
      "start_frame": 1,
      "end_frame": 576,
      "keyframes": [
        "000002.webp",
        "000038.webp",
        "000074.webp",
        "000075.webp",
        "000119.webp",
        "000164.webp",
        "000165.webp",
        "000227.webp",
        "000289.webp",
        "000290.webp",
        "000341.webp",
        "000393.webp",
        "000394.webp",
        "000438.webp",
        "000482.webp",
        "000483.webp",
        "000526.webp",
        "000570.webp",
        "000571.webp"
      ],
      "keyframe_count": 19
    },
    {
      "text": "Đó là ông Nguyễn Văn Cường, người có xưởng chế tác sửa chữa kèn đồng nổi tiếng khắp miền Bắc.",
      "start": 23.04,
      "end": 28.8,
      "n_words": 20,
      "start_frame": 576,
      "end_frame": 720,
      "keyframes": [
        "000612.webp",
        "000654.webp",
        "000655.webp",
        "000700.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đến nay ông đã gắn bó với nghề này được gần 60 năm.",
      "start": 28.8,
      "end": 34.08,
      "n_words": 13,
      "start_frame": 720,
      "end_frame": 852,
      "keyframes": [
        "000745.webp",
        "000746.webp",
        "000800.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "\"Những cái kèn đó là cái kèn người ta thường thường để lâu lâu ngày rồi thì người ta không muốn dùng nữa, ta thanh lý đi.",
      "start": 34.08,
      "end": 41.44,
      "n_words": 27,
      "start_frame": 852,
      "end_frame": 1036,
      "keyframes": [
        "000855.webp",
        "000856.webp",
        "000903.webp",
        "000950.webp",
        "000951.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Như đối với chúng tôi, thanh lý như vậy nhưng bây giờ chúng tôi chỉ thay bộ phím đấy là coi như cái kèn mới tinh, ví mới tinh đấy.",
      "start": 41.44,
      "end": 50.4,
      "n_words": 30,
      "start_frame": 1036,
      "end_frame": 1260,
      "keyframes": [
        "001068.webp",
        "001185.webp",
        "001186.webp",
        "001235.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cho nên là, nhưng mà đến giờ này tại sao chúng tôi không muốn làm kèn?",
      "start": 50.4,
      "end": 54.16,
      "n_words": 16,
      "start_frame": 1260,
      "end_frame": 1354,
      "keyframes": [
        "001285.webp",
        "001286.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mấy nghề chúng tôi làm từ xưa đến giờ là tôi cũng đã làm ra tất cả các loại kèn, gia đình nhà tôi làm cỡ khổ, tôi làm cỡ khổ 20 loại kèn khác nhau.",
      "start": 54.16,
      "end": 61.92,
      "n_words": 36,
      "start_frame": 1354,
      "end_frame": 1548,
      "keyframes": [
        "001468.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nhưng trong bây giờ là vì thời đại bây giờ máy móc họ làm tiên tiến quá, mà mình thì làm tiên tiến máy thì mình không có đủ tiền mình mua những cái máy như vậy nên làm gia công.",
      "start": 61.92,
      "end": 74.6,
      "n_words": 41,
      "start_frame": 1548,
      "end_frame": 1865,
      "keyframes": [
        "001555.webp",
        "001825.webp",
        "001826.webp",
        "001853.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cho nên kỳ sau này chúng tôi bỏ mất, mấy năm nay tôi không sản xuất nữa, chúng tôi chuyển sang sửa chữa và buôn bán kèn đồng.",
      "start": 74.6,
      "end": 85.32,
      "n_words": 28,
      "start_frame": 1865,
      "end_frame": 2133,
      "keyframes": [
        "001880.webp",
        "001881.webp",
        "001933.webp",
        "001985.webp",
        "001986.webp",
        "002033.webp",
        "002081.webp",
        "002082.webp",
        "002129.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ở làng Phạm Pháo, kèn đồng do gia đình ông Cường chế tác có cái riêng là tất cả đều làm thủ công hoàn toàn.",
      "start": 85.32,
      "end": 92.2,
      "n_words": 25,
      "start_frame": 2133,
      "end_frame": 2305,
      "keyframes": [
        "002176.webp",
        "002177.webp",
        "002211.webp",
        "002246.webp",
        "002247.webp",
        "002277.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mỗi chiếc kèn đồng có từ 180 đến 250 chi tiết, trong đó có những bộ phận rất nhỏ và cầu kỳ.",
      "start": 92.2,
      "end": 99.76,
      "n_words": 22,
      "start_frame": 2305,
      "end_frame": 2494,
      "keyframes": [
        "002307.webp",
        "002308.webp",
        "002348.webp",
        "002388.webp",
        "002389.webp",
        "002428.webp",
        "002468.webp",
        "002469.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Với đam mê với những cây kèn đồng, ông đã tự mày mò nghiên cứu và chế tác được 20 loại kèn khác nhau. \"Một người quay tay, một người tiện đến như vậy, đánh bóng cũng thế, nghĩa là cái gì cũng bằng tay hết, tay hết.",
      "start": 99.76,
      "end": 117.6,
      "n_words": 48,
      "start_frame": 2494,
      "end_frame": 2940,
      "keyframes": [
        "002507.webp",
        "002546.webp",
        "002547.webp",
        "002588.webp",
        "002629.webp",
        "002630.webp",
        "002672.webp",
        "002714.webp",
        "002715.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Từ một lá đồng ngày xưa thì chúng tôi gò một cái loa đấy, thì nó cứ miếng đồng dày cứ gò gò dần, gò dần thành ra một cái cây loa một miếng, nhưng đến giờ này tôi không làm kiểu đó nữa.",
      "start": 117.92,
      "end": 131.0,
      "n_words": 44,
      "start_frame": 2948,
      "end_frame": 3275,
      "keyframes": [
        "003143.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đưa lên máy, đặt miếng đồng phẳng đặt lên máy là đưa máy miết miết vào, như là nếu ai họ biết cái miết cái đáy cái nồi đấy đấy là lấy miết đúng như vậy, miết cái loa thành cái loa cái kèn.",
      "start": 131.0,
      "end": 143.76,
      "n_words": 44,
      "start_frame": 3275,
      "end_frame": 3594,
      "keyframes": [
        "003571.webp",
        "003572.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khó nhất thì nếu mà trong kèn, cái phiến tím là phải độ kín cao, như là cái piston xe máy, càng kín bao nhiêu thì càng ít tốn xăng, tiếng nổ tròn đấy, nó giống như đúng như vậy, thì càng kín bao nhiêu thì tiếng kèn càng hay bấy nhiêu.",
      "start": 143.76,
      "end": 162.2,
      "n_words": 52,
      "start_frame": 3594,
      "end_frame": 4055,
      "keyframes": [
        "003654.webp",
        "003736.webp",
        "003737.webp",
        "003790.webp",
        "003843.webp",
        "003844.webp",
        "003899.webp",
        "003955.webp",
        "003956.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Mà nó cộng hưởng thêm là chất liệu đồng, ví dụ chất liệu đồng mà nó pha tạp nhiều quá đấy, cái tiếng kèn nó sẽ kém đi.",
      "start": 162.2,
      "end": 176.04,
      "n_words": 28,
      "start_frame": 4055,
      "end_frame": 4401,
      "keyframes": [
        "004161.webp",
        "004366.webp",
        "004367.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Yêu kèn đồng yêu cả âm thanh của từng chiếc kèn.\"",
      "start": 176.04,
      "end": 179.52,
      "n_words": 11,
      "start_frame": 4401,
      "end_frame": 4488,
      "keyframes": [
        "004423.webp",
        "004479.webp",
        "004480.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bất cứ lúc nào trong ngày, cứ rảnh là ông Cường lại mang kèn ra thổi.",
      "start": 179.52,
      "end": 183.96,
      "n_words": 16,
      "start_frame": 4488,
      "end_frame": 4599,
      "keyframes": [
        "004514.webp",
        "004548.webp",
        "004549.webp",
        "004584.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khi ngồi một mình, ông thích nhất là cây saxophone.",
      "start": 183.96,
      "end": 194.68,
      "n_words": 10,
      "start_frame": 4599,
      "end_frame": 4867,
      "keyframes": [
        "004620.webp",
        "004621.webp",
        "004742.webp",
        "004863.webp",
        "004864.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "\"Thì 40 loại kèn tôi biết chơi hết, loại nào cũng biết chơi vì mình là người sản xuất nên mình phải thổi được nó, mình biết được đích âm được ấy để tìm được cái âm hay nhất, tìm được chất liệu đồng nào để làm chiếc kèn để cho ra âm thanh hay đấy.",
      "start": 194.68,
      "end": 212.12,
      "n_words": 56,
      "start_frame": 4867,
      "end_frame": 5303,
      "keyframes": [
        "004971.webp",
        "005078.webp",
        "005079.webp",
        "005140.webp",
        "005248.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nên là từ đó mình phải biết hết, biết thổi, biết sử dụng nó thì mình mới làm được kèn.",
      "start": 212.32,
      "end": 216.72,
      "n_words": 20,
      "start_frame": 5308,
      "end_frame": 5418,
      "keyframes": [
        "005417.webp",
        "005418.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Từ con cái gáy từ nhỏ đi đã học được nhạc lý, rồi từ các con cho đến đứa nào cũng được học ít nhất là sáu đến bảy tám tháng học nhạc lý xong rồi về làm kèn với bố.",
      "start": 216.72,
      "end": 228.36,
      "n_words": 41,
      "start_frame": 5418,
      "end_frame": 5709,
      "keyframes": [
        "005418.webp",
        "005680.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cứ tầm tuổi cứ 10 tuổi trở lên bắt đầu ở đây học nhạc, bắt đầu thổi kèn, ai cũng thế.",
      "start": 228.56,
      "end": 235.96,
      "n_words": 21,
      "start_frame": 5714,
      "end_frame": 5899,
      "keyframes": [
        "005720.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trong cái làng đây hầu như gia đình nhà tôi như bố tôi là năm bốn con thổi kèn mỗi năm.",
      "start": 235.96,
      "end": 244.0,
      "n_words": 21,
      "start_frame": 5899,
      "end_frame": 6100,
      "keyframes": [
        "005942.webp",
        "005943.webp",
        "005983.webp",
        "006023.webp",
        "006024.webp",
        "006100.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Xưởng sản xuất của gia đình ông Cường chế tác được 10 đến 20 cây kèn.",
      "start": 244.0,
      "end": 248.32,
      "n_words": 16,
      "start_frame": 6100,
      "end_frame": 6208,
      "keyframes": [
        "006100.webp",
        "006176.webp",
        "006177.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các loại kèn hay được khách hàng đặt là clarinet, saxophone.",
      "start": 248.32,
      "end": 253.8,
      "n_words": 11,
      "start_frame": 6208,
      "end_frame": 6345,
      "keyframes": [
        "006234.webp",
        "006292.webp",
        "006293.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Giá sửa kèn thì chỉ từ 50.000 đến 70.000 đồng một cây, còn giá bán dao động từ 100.000 đồng đến vài triệu đồng tùy theo loại kèn.",
      "start": 254.84,
      "end": 263.92,
      "n_words": 28,
      "start_frame": 6371,
      "end_frame": 6598,
      "keyframes": [
        "006426.webp",
        "006427.webp",
        "006473.webp",
        "006519.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đến nay, xưởng kèn đồng nhà ông Cường không chỉ là nơi chế tác sửa chữa kèn đồng mà còn là điểm du lịch được du khách yêu thích mỗi khi đến với Hải Hậu, Nam Định.",
      "start": 263.92,
      "end": 275.24,
      "n_words": 37,
      "start_frame": 6598,
      "end_frame": 6881,
      "keyframes": [
        "006645.webp",
        "006694.webp",
        "006744.webp",
        "006745.webp",
