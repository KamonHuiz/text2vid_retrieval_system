        "005356.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Sách giáo khoa thì của mình rất là đa dạng, nói chung là từ miền Bắc vào đến miền Nam mà qua mỗi giai đoạn thì nó lại có một cái sự khác nhau.",
      "start": 214.84,
      "end": 222.28,
      "n_words": 34,
