        "001363.webp",
        "001417.webp",
        "001418.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Thì đến giờ cũng là gần 15 năm rồi.",
      "start": 56.72,
      "end": 59.32,
      "n_words": 9,
      "start_frame": 1418,
      "end_frame": 1483,
      "keyframes": [
