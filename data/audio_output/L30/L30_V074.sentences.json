      "end_frame": 2982,
      "keyframes": [
        "002879.webp",
        "002880.webp",
        "002962.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Giờ được xem lưu bút của người khác cũng rất là thú vị.",
      "start": 119.28,
      "end": 127.84,
      "n_words": 13,
      "start_frame": 2982,
      "end_frame": 3196,
      "keyframes": [
        "003045.webp",
