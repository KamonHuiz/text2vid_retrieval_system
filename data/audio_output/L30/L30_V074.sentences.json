      "n_words": 28,
      "start_frame": 941,
      "end_frame": 1129,
      "keyframes": [
        "000978.webp",
        "001121.webp",
        "001122.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và sau một thời gian, mình đã tìm được lại những cuốn như vậy thì mình thấy đây là một cái đề tài hay, cho nên mình cứ gặp những cuốn sách giáo khoa hay là vở học sinh lưu bút, hay là sách về các trường lớp ngày xưa thì mình đều sưu tầm.",
      "start": 45.16,
      "end": 56.72,
      "n_words": 55,
      "start_frame": 1129,
      "end_frame": 1418,
