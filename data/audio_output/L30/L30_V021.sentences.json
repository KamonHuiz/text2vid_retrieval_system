      ],
      "keyframe_count": 6
    },
    {
      "text": "Và đây là chuyến công tác ngày 15 tháng 9.",
      "start": 48.28,
      "end": 52.2,
      "n_words": 10,
      "start_frame": 1207,
      "end_frame": 1305,
      "keyframes": [
        "001258.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mọi người đang chung tay để sắp xếp những phần quà lên xe.",
      "start": 52.2,
      "end": 56.68,
      "n_words": 13,
