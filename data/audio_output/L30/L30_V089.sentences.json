        "001438.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Các loại bức tranh sinh học được trồng bởi đa dạng các loại thực vật như là rau, hoa và cây lá, được bố trí theo một bố cục thẩm mỹ để tạo nên một tác phẩm nghệ thuật trang trí độc đáo.",
      "start": 59.12,
      "end": 71.04,
      "n_words": 43,
      "start_frame": 1478,
