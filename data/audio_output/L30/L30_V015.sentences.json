        "002869.webp",
        "002903.webp",
        "002904.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mình vẫn làm mình có làm túi, mình có làm nón.",
      "start": 117.24,
      "end": 119.76,
      "n_words": 11,
      "start_frame": 2931,
      "end_frame": 2994,
