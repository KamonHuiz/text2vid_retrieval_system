      "end_frame": 2530,
      "keyframes": [
        "002381.webp",
        "002528.webp",
        "002529.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngoài bộ này mình ở đây thì mình vẫn làm những cái bộ quần áo như là móc top hoặc là váy.",
      "start": 101.2,
      "end": 108.16,
      "n_words": 22,
      "start_frame": 2530,
      "end_frame": 2704,
      "keyframes": [
        "002588.webp",
        "002648.webp",
        "002649.webp",
        "002698.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Váy thì có nhiều kiểu váy đi biển, cũng có váy mặc thường ngày, cũng có với nhiều phong cách khác nhau, màu sắc cũng có, size cũng có.",
      "start": 108.16,
      "end": 117.24,
      "n_words": 29,
      "start_frame": 2704,
