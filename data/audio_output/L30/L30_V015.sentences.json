        "001565.webp",
        "001566.webp",
        "001648.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "\"Mình bắt đầu móc len từ lúc mình 10 tuổi.",
      "start": 69.04,
      "end": 72.08,
      "n_words": 10,
      "start_frame": 1726,
