      ],
      "keyframe_count": 2
    },
    {
      "text": "Mặc dù dạy miễn phí nhưng chị Thọ cũng như các giáo viên khác của trung tâm lúc nào cũng tận tình với những học viên đặc biệt này.",
      "start": 41.16,
      "end": 48.24,
      "n_words": 29,
