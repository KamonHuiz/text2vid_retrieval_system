        "000527.webp",
        "000560.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khi mới thành lập, trung tâm chủ yếu dạy nhạc cho các em nhỏ.",
      "start": 23.36,
      "end": 26.68,
      "n_words": 14,
