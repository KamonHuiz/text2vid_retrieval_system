        "001710.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Họ là thành viên của Quán trọ Sài Gòn Bao Dung, một quán trọ dành cho các cụ già trên 60 tuổi neo đơn không người nương tựa.",
      "start": 68.48,
      "end": 77.04,
      "n_words": 28,
      "start_frame": 1712,
      "end_frame": 1926,
      "keyframes": [
        "001763.webp",
        "001817.webp",
        "001818.webp",
        "001908.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Quán trọ thuộc Quỹ từ thiện và Bảo trợ xã hội Trăng Khuyết.",
      "start": 77.04,
      "end": 81.16,
      "n_words": 13,
