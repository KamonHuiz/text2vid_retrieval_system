      "keyframes": [
        "000918.webp",
        "000919.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Sau cô bị bệnh đột quỵ rồi, sợ lấy nhà lại rồi cô không có chỗ ở, thành ra cô cũng không có con cái, cũng không có nhà ở.",
      "start": 39.16,
      "end": 50.68,
      "n_words": 30,
