        "002025.webp",
        "002026.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ở quán trọ này hiện có 20 ông bà từ 60 đến 80 tuổi đang sinh sống.",
      "start": 81.16,
      "end": 86.64,
      "n_words": 17,
