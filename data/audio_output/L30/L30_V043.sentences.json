      "end_frame": 1267,
      "keyframes": [
        "001134.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cô hoàn cảnh cuộc sống cô cũng buồn lắm.",
      "start": 50.68,
      "end": 56.0,
      "n_words": 9,
      "start_frame": 1267,
      "end_frame": 1400,
