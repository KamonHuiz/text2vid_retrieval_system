        "002269.webp",
        "002301.webp",
        "002302.webp",
        "002342.webp",
        "002383.webp",
        "002384.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Các suất cháo thịt nóng, cơm ngon này được gói ghém cẩn thận rồi theo xe đi len lỏi theo những con đường nhỏ để tiếp thêm tinh thần cho người lao động có bữa ăn no để đi làm việc mưu sinh.",
      "start": 95.44,
      "end": 111.48,
      "n_words": 43,
      "start_frame": 2386,
      "end_frame": 2787,
      "keyframes": [
        "002420.webp",
        "002457.webp",
        "002458.webp",
        "002501.webp",
        "002544.webp",
        "002545.webp",
        "002583.webp",
        "002622.webp",
