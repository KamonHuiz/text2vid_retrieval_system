        "000436.webp",
        "000437.webp",
        "000464.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Mọi người đều rộn ràng tiếng nói cười hòa lẫn vào tiếng cắt rau củ, thịt cá và vo gạo để kịp nấu ra hơn 2.000 suất cháo cơm nghĩa tình hỗ trợ cho người dân có hoàn cảnh khó khăn ở địa phương.",
      "start": 19.64,
      "end": 35.16,
      "n_words": 44,
      "start_frame": 491,
      "end_frame": 879,
      "keyframes": [
        "000492.webp",
