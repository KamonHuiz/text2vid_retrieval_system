        "002661.webp",
        "002699.webp",
        "002700.webp",
        "002740.webp",
        "002780.webp",
        "002781.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "\"Mừng em vui lắm, vui luôn có cho đứa nhỏ ăn mừng vậy chứ giờ làm không được chị ơi, mưa gió đâu có đi làm, mưa gió đâu có đi làm được đâu.",
      "start": 111.48,
      "end": 119.36,
      "n_words": 34,
      "start_frame": 2787,
      "end_frame": 2984,
      "keyframes": [
        "002926.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đi làm cỏ làm giá mưa này đâu có đi được đâu.",
      "start": 119.36,
      "end": 122.92,
      "n_words": 12,
      "start_frame": 2984,
      "end_frame": 3073,
      "keyframes": [
        "003071.webp",
        "003072.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mình nhận được phần đồ ăn này ở nhà đỡ phần nào á.",
      "start": 122.92,
      "end": 126.0,
      "n_words": 13,
      "start_frame": 3073,
      "end_frame": 3150,
      "keyframes": [
        "003111.webp",
        "003150.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chồng lên biển thì cũng không có tiền á, về bờ thì cũng không có đi làm được tại vì mưa gió bão mà không có đi làm được mà tại vì nói chung nhà cũng đông con, tới bốn đứa con.\"",
      "start": 126.0,
      "end": 136.48,
      "n_words": 42,
      "start_frame": 3150,
      "end_frame": 3412,
      "keyframes": [
        "003150.webp",
        "003151.webp",
        "003283.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ban nhân dân thành phố Phú Quốc cho biết sau hai ngày, ngày 17 đến ngày 18 tháng 9 bị ảnh hưởng mưa kéo dài, Phú Quốc bị ngập cục bộ và có khoảng 430 hộ dân giao thông đi lại khó khăn.",
      "start": 138.76,
      "end": 151.2,
      "n_words": 43,
      "start_frame": 3469,
      "end_frame": 3780,
      "keyframes": [
        "003475.webp",
