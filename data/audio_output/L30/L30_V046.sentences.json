        "005260.webp",
        "005261.webp",
        "005298.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "\"Con tôi là nó đi theo lớp này là từ đầu luôn.",
      "start": 213.32,
      "end": 216.88,
      "n_words": 12,
      "start_frame": 5333,
