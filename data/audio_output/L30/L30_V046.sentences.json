      "keyframe_count": 6
    },
    {
      "text": "Qua một năm các bạn tập luyện thì tôi có nhìn nhận cho các bạn có sự linh hoạt nhanh nhẹn hơn, thì nhờ qua tập những thể thao không riêng bộ môn kinh mà có những bộ môn khác thì các bạn có linh hoạt.",
      "start": 160.48,
      "end": 173.56,
      "n_words": 46,
      "start_frame": 4012,
      "end_frame": 4339,
