      ],
      "keyframe_count": 4
    },
    {
      "text": "Bác sĩ quan tâm, nghèo cũng thương, hộ nghèo được 50.000 cũng mong có bữa cơm trưa\", bà Hộ tại Trung tâm Y tế huyện Bình Sơn chia sẻ.",
      "start": 45.28,
      "end": 63.44,
      "n_words": 29,
      "start_frame": 1132,
      "end_frame": 1586,
      "keyframes": [
        "001162.webp",
