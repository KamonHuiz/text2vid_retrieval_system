        "002651.webp",
        "002652.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cái này đúng tinh thần là không để ai bị bỏ lại phía sau.\"",
      "start": 108.64,
      "end": 113.0,
      "n_words": 14,
      "start_frame": 2716,
