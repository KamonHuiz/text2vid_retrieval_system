        "001594.webp",
        "001595.webp",
        "001625.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Quán cà phê Khuyết hiện tại có 12 thành viên chia nhau theo ca để làm việc trong ngày.",
      "start": 66.08,
      "end": 70.96,
      "n_words": 19,
