        "000952.webp",
        "000953.webp",
        "000966.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Anh Tâm bị tai nạn lao động chấn thương cột sống, di chuyển đều phụ thuộc vào chiếc xe điện.",
      "start": 39.12,
      "end": 44.2,
      "n_words": 20,
      "start_frame": 978,
      "end_frame": 1105,
      "keyframes": [
        "000980.webp",
        "000981.webp",
        "001027.webp",
        "001073.webp",
        "001074.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Anh Tâm giữ vai trò là quản lý, quán xuyến các công việc tại quán cà phê Khuyết.",
      "start": 44.2,
      "end": 48.68,
      "n_words": 18,
      "start_frame": 1105,
      "end_frame": 1217,
      "keyframes": [
        "001138.webp",
        "001202.webp",
        "001203.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngoài ra, trên chiếc xe của mình, anh còn kiêm luôn các công việc khác như sắp xếp, lau dọn và bưng nước cho khách.",
      "start": 48.68,
      "end": 56.64,
      "n_words": 25,
      "start_frame": 1217,
      "end_frame": 1416,
      "keyframes": [
        "001262.webp",
