        "001359.webp",
        "001397.webp",
        "001398.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Những khách hàng đến với cà phê Khuyết không chỉ vì không gian quán thơ mộng, xinh đẹp và mát mẻ mà điều đặc biệt còn chính là ở sự niềm nở của những con người nơi đây.",
      "start": 56.64,
      "end": 66.08,
      "n_words": 38,
      "start_frame": 1416,
      "end_frame": 1652,
      "keyframes": [
        "001419.webp",
