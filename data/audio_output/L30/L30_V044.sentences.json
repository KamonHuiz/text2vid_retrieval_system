        "002272.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trong quá trình làm việc, do hầu hết mọi người đều là người khuyết tật nên mọi việc vận hành khá chậm, song không vì vậy mà khách hàng cảm thấy khó chịu.",
      "start": 91.52,
      "end": 99.92,
