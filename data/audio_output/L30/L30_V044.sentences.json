        "002151.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các anh chị phải tự học hỏi, trau dồi và tích lũy kinh nghiệm qua từng ngày hoạt động của quán.",
      "start": 86.44,
      "end": 91.52,
