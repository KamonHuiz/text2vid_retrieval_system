        "001709.webp",
        "001761.webp",
        "001762.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trong nhóm có một pha chế, còn lại làm giữ xe, bưng, tính tiền và hầu hết mọi người đều đi lại khó khăn.",
      "start": 70.96,
      "end": 78.52,
      "n_words": 24,
      "start_frame": 1774,
