        "000843.webp",
        "000857.webp",
        "000871.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đó là câu chuyện của anh Đinh Văn Tâm và những người cộng sự của mình.",
      "start": 34.84,
      "end": 39.12,
