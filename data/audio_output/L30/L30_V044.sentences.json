        "002444.webp",
        "002480.webp",
        "002481.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ngược lại, họ luôn dành sự thông cảm dành cho những người làm việc tại đây.",
      "start": 99.92,
      "end": 103.44,
