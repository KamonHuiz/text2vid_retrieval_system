        "000554.webp",
        "000631.webp",
        "000632.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Tuy nhiên, một trăn trở vẫn luôn hiện hữu trong tâm trí tôi.",
      "start": 25.72,
      "end": 29.84,
      "n_words": 13,
      "start_frame": 643,
      "end_frame": 746,
      "keyframes": [
        "000690.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ở độ tuổi U40, tôi vẫn chưa thực sự đạt được thành tựu gì to lớn.",
      "start": 29.84,
      "end": 35.2,
      "n_words": 16,
      "start_frame": 746,
      "end_frame": 880,
      "keyframes": [
        "000749.webp",
        "000750.webp",
        "000791.webp",
        "000833.webp",
        "000834.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tìm kiếm lời giải cho trăn trở ấy, tôi quyết định thử áp dụng một phương pháp mà bản thân cũng còn mơ hồ: hãy tập trung vào điều mình giỏi nhất.",
      "start": 35.2,
      "end": 45.56,
      "n_words": 32,
      "start_frame": 880,
      "end_frame": 1139,
      "keyframes": [
        "000884.webp",
        "000935.webp",
        "000936.webp",
        "000977.webp",
        "001018.webp",
        "001019.webp",
        "001074.webp",
        "001129.webp",
        "001130.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Khả năng của tôi nằm ở lĩnh vực viết lách, đặc biệt là viết sáng tạo.",
      "start": 45.56,
      "end": 50.96,
      "n_words": 16,
      "start_frame": 1139,
      "end_frame": 1274,
      "keyframes": [
        "001169.webp",
        "001209.webp",
        "001210.webp",
        "001244.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Do vậy, tôi quyết định thử sức với một lĩnh vực viết mới: sáng tác sách tranh chủ đề \"Em yêu biển đảo, biên giới hải đảo, biên cương\".",
      "start": 50.96,
      "end": 60.68,
      "n_words": 29,
      "start_frame": 1274,
      "end_frame": 1517,
      "keyframes": [
        "001279.webp",
        "001280.webp",
        "001307.webp",
        "001334.webp",
        "001359.webp",
        "001406.webp",
        "001453.webp",
        "001473.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Những câu chuyện, những hình ảnh giản đơn về con người thiếu nhi ở biển đảo, biên cương được tôi và các bạn thành viên trong nhóm truyền tải vào những dòng vần, những bức tranh sinh động.",
      "start": 60.68,
      "end": 74.04,
      "n_words": 38,
      "start_frame": 1517,
      "end_frame": 1851,
      "keyframes": [
        "001530.webp",
        "001587.webp",
        "001612.webp",
        "001677.webp",
        "001742.webp",
        "001743.webp",
        "001780.webp",
        "001817.webp",
        "001818.webp",
        "001849.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Qua những trang sách, các em nhỏ được biết về cuộc sống của những bạn bè đồng trang lứa trên đảo, nơi thiếu thốn về vật chất nhưng luôn tràn đầy tinh thần lạc quan và ý chí vượt khó.",
      "start": 74.04,
      "end": 86.16,
      "n_words": 40,
      "start_frame": 1851,
      "end_frame": 2154,
      "keyframes": [
        "001880.webp",
        "001881.webp",
        "001941.webp",
        "002002.webp",
        "002003.webp",
        "002053.webp",
        "002104.webp",
        "002105.webp",
        "002153.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Các em cũng nhận ra rằng chỉ với hành động nhỏ bé như bỏ tiền vào heo đất mỗi ngày, các em có thể góp phần mang đến những suất học bổng quý giá cho các bạn học sinh vùng biên giới hải đảo.",
      "start": 86.16,
      "end": 98.48,
      "n_words": 44,
      "start_frame": 2154,
      "end_frame": 2462,
      "keyframes": [
        "002202.webp",
        "002203.webp",
        "002253.webp",
        "002304.webp",
        "002305.webp",
        "002339.webp",
        "002374.webp",
        "002375.webp",
        "002413.webp",
        "002452.webp",
        "002453.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Những bạn nhỏ nơi biên cương giữa muôn trùng sóng gió sẽ được tiếp thêm động lực và nguồn năng lượng tích cực để tiếp tục học tập và vươn lên.",
      "start": 98.48,
      "end": 108.68,
      "n_words": 31,
      "start_frame": 2462,
      "end_frame": 2717,
      "keyframes": [
        "002483.webp",
        "002514.webp",
        "002515.webp",
        "002553.webp",
        "002592.webp",
        "002593.webp",
        "002635.webp",
        "002677.webp",
        "002678.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bộ sách \"Em yêu biển đảo biên cương\" đã mở ra cơ hội cho tôi gặp gỡ và giao lưu với những bạn đọc nhỏ tuổi.",
      "start": 108.68,
      "end": 116.32,
      "n_words": 26,
      "start_frame": 2717,
      "end_frame": 2908,
      "keyframes": [
        "002725.webp",
        "002772.webp",
        "002773.webp",
        "002803.webp",
        "002833.webp",
        "002834.webp",
        "002907.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Khi gặp những chủ đề lớn như tình yêu tổ quốc, tình yêu quê hương biển đảo, tôi trăn trở làm thế nào để các em có thể hiểu và thực hiện những điều ý nghĩa.",
      "start": 116.32,
      "end": 127.0,
      "n_words": 36,
      "start_frame": 2908,
      "end_frame": 3175,
      "keyframes": [
        "002981.webp",
        "002982.webp",
        "003047.webp",
        "003113.webp",
        "003114.webp",
        "003160.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Một lần nữa, tôi áp dụng phương pháp từng giúp bản thân vượt qua khó khăn: hướng dẫn các em làm việc lớn lao từ những hành động nhỏ bé.",
      "start": 127.0,
      "end": 137.32,
      "n_words": 30,
      "start_frame": 3175,
      "end_frame": 3433,
      "keyframes": [
        "003206.webp",
        "003207.webp",
        "003251.webp",
        "003296.webp",
        "003297.webp",
        "003363.webp",
        "003430.webp",
        "003431.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Các em nhận ra rằng bản thân có thể thể hiện lòng biết ơn và góp phần xây dựng quê hương giàu đẹp bằng chính năng khiếu của mình.",
      "start": 137.32,
      "end": 146.44,
      "n_words": 29,
      "start_frame": 3433,
      "end_frame": 3661,
      "keyframes": [
        "003471.webp",
