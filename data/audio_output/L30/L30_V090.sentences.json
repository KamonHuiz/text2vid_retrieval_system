        "003625.webp",
        "003655.webp",
        "003656.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Các em có thể vẽ tranh tuyên truyền về những chiến sĩ đang ngày đêm canh gác tổ quốc, sáng tác thơ ca hay bài hát để lan tỏa tinh thần yêu nước.",
      "start": 146.44,
      "end": 156.44,
      "n_words": 33,
      "start_frame": 3661,
      "end_frame": 3911,
      "keyframes": [
        "003682.webp",
        "003709.webp",
        "003710.webp",
        "003808.webp",
        "003906.webp",
        "003907.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Giây phút hòa giọng với các em bài hát \"Em là hải quân nhí\", \"Em yêu Việt Nam\", \"Thưa nhà em nói xa thuyền bao điều yêu\", tôi cảm nhận được nguồn năng lượng tích cực dồi dào trong bản thân và trong ánh mắt lấp lánh của các em.",
      "start": 156.44,
      "end": 179.08,
      "n_words": 50,
      "start_frame": 3911,
      "end_frame": 4477,
      "keyframes": [
        "004045.webp",
