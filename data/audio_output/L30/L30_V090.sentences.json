  "sentences": [
    {
      "text": "Việc ghi nhận những điều nhỏ bé như mua được bộ quần áo ưng ý, tìm thấy quán ăn ngon hay thức dậy đúng giờ đã mang đến cho tôi niềm vui và nguồn năng lượng tích cực dồi dào.",
      "start": 0.04,
      "end": 25.72,
      "n_words": 40,
      "start_frame": 1,
      "end_frame": 643,
      "keyframes": [
        "000075.webp",
        "000119.webp",
