        "001581.webp",
        "001648.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chia sẻ về cái duyên làm từ thiện của mình, cô cho biết mình bắt đầu gắn bó với công việc này từ khi còn làm giáo viên.",
      "start": 66.12,
      "end": 74.56,
      "n_words": 28,
      "start_frame": 1653,
      "end_frame": 1864,
      "keyframes": [
        "001715.webp",
