  "n_sentences": 29,
  "total_words": 983,
  "sentences": [
    {
      "text": "Lò gạch trùng tu hồi sinh lại Thánh địa Mỹ Sơn ở huyện Duy Xuyên, tỉnh Quảng Nam.",
      "start": 0.0,
      "end": 18.52,
      "n_words": 18,
      "start_frame": 0,
      "end_frame": 463,
      "keyframes": [
        "000002.webp",
        "000038.webp",
        "000074.webp",
        "000075.webp",
        "000119.webp",
        "000164.webp",
        "000165.webp",
        "000227.webp",
        "000289.webp",
        "000290.webp",
        "000372.webp",
        "000455.webp",
        "000456.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Vấn đề đau đầu nhất đối với cơ quan quản lý là tìm ra nơi sản xuất loại gạch cổ mà người Chăm Pa từng dùng để tạo ra Mỹ Sơn cả ngàn năm trước.",
      "start": 18.52,
      "end": 27.68,
      "n_words": 35,
      "start_frame": 463,
      "end_frame": 692,
      "keyframes": [
        "000549.webp",
        "000642.webp",
        "000643.webp",
        "000677.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bất ngờ thay, trong cộng đồng dân cư sinh sống ở vùng thánh địa, một người dân đã nắm giữ công thức cổ về loại gạch vô giá này.",
      "start": 27.68,
      "end": 40.48,
      "n_words": 29,
      "start_frame": 692,
      "end_frame": 1012,
      "keyframes": [
        "000711.webp",
        "000712.webp",
        "000778.webp",
        "000845.webp",
        "000846.webp",
        "000902.webp",
        "000959.webp",
        "000960.webp",
        "000998.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Lò gạch cũ cũng là nhà ở của ông Nguyễn Quá, nằm xéo bên đường dẫn từ cầu Giao Thủy vào trung tâm Thánh địa Mỹ Sơn.",
      "start": 40.48,
      "end": 48.8,
      "n_words": 27,
      "start_frame": 1012,
      "end_frame": 1220,
      "keyframes": [
        "001037.webp",
        "001038.webp",
        "001067.webp",
        "001097.webp",
        "001098.webp",
        "001131.webp",
        "001165.webp",
        "001191.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Những năm 2003, khi Mỹ Sơn bắt đầu trùng tu, dù đã tìm đủ cách, thậm chí đưa mẫu gạch gốc vào phân tích đồng vị carbon để tạo ra loại gạch phiên bản y hệt, nhưng các nhà khoa học vẫn bế tắc trước sự đặc biệt của loại gạch mà người xưa đã tạo ra.",
      "start": 48.8,
      "end": 67.48,
      "n_words": 57,
      "start_frame": 1220,
      "end_frame": 1687,
      "keyframes": [
        "001252.webp",
        "001313.webp",
        "001314.webp",
        "001365.webp",
        "001416.webp",
        "001417.webp",
        "001469.webp",
        "001521.webp",
        "001522.webp",
        "001584.webp",
        "001646.webp",
        "001647.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Khi gần như hết hy vọng, các nhà khoa học được mách nước rồi tìm tới lò gốm gặp ông Nguyễn Quá.",
      "start": 67.48,
      "end": 74.76,
      "n_words": 22,
      "start_frame": 1687,
      "end_frame": 1869,
      "keyframes": [
        "001702.webp",
        "001757.webp",
        "001758.webp",
        "001785.webp",
        "001812.webp",
        "001813.webp",
        "001840.webp",
        "001868.webp",
        "001869.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Họ không ngờ rằng đây chính là truyền nhân bí ẩn sẽ giúp tạo ra loại gạch mà lâu nay họ cất công kiếm tìm.",
      "start": 74.76,
      "end": 85.12,
      "n_words": 25,
      "start_frame": 1869,
      "end_frame": 2128,
      "keyframes": [
        "001869.webp",
        "001893.webp",
        "001918.webp",
        "001919.webp",
        "001957.webp",
        "001996.webp",
        "001997.webp",
        "002059.webp",
        "002121.webp",
        "002122.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "\"Trong núi thành quá trình gạch nó muốn gạch nợ xấu bao nhiêu năm rồi qua mấy năm rồi nó vẫn khác, nó vẫn hợp với cái gạch cũ.",
      "start": 85.12,
      "end": 101.04,
      "n_words": 29,
      "start_frame": 2128,
      "end_frame": 2526,
      "keyframes": [
        "002267.webp",
        "002413.webp",
        "002414.webp",
        "002492.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Theo tôi nghĩ là tất cả ai cũng làm được hết nhưng mà do cái duyên của từng người thế thôi, do cái mình có cái duyên nào đó.",
      "start": 101.04,
      "end": 112.84,
      "n_words": 29,
      "start_frame": 2526,
      "end_frame": 2821,
      "keyframes": [
        "002571.webp",
        "002572.webp",
        "002642.webp",
        "002712.webp",
        "002713.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thứ nhất là do cái sự cố gắng, nhiệt tình thôi.\"",
      "start": 112.84,
      "end": 117.4,
      "n_words": 11,
      "start_frame": 2821,
      "end_frame": 2935,
      "keyframes": [
        "002831.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ông Nguyễn Quá kể rằng lâu nay ông không có mối quan hệ nào với người xưa.",
      "start": 117.4,
      "end": 124.48,
      "n_words": 17,
      "start_frame": 2935,
      "end_frame": 3112,
      "keyframes": [
        "002950.webp",
        "002951.webp",
        "002985.webp",
        "003019.webp",
        "003020.webp",
        "003077.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Duyên cơ bất ngờ vào năm 2003, khi các nhà khoa học tìm tới nhà ông và nói rằng họ không thể tìm kiếm nơi đâu hay hỏi được một ai bằng cách nào để tạo ra thứ gạch cổ đã dùng trong Thánh địa Mỹ Sơn, ông Quá đã gật đầu nhận thử thách này.",
      "start": 124.48,
      "end": 142.56,
      "n_words": 56,
      "start_frame": 3112,
      "end_frame": 3564,
      "keyframes": [
        "003134.webp",
        "003135.webp",
        "003159.webp",
        "003184.webp",
        "003185.webp",
        "003256.webp",
        "003327.webp",
        "003328.webp",
        "003355.webp",
        "003382.webp",
        "003383.webp",
        "003429.webp",
        "003476.webp",
        "003477.webp",
        "003518.webp",
        "003559.webp",
        "003560.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Giữa năm 2005, sau bốn lần thử nghiệm các mẻ gạch khác nhau, ông Quá đã làm ra mẻ gạch đạt độ chín trọn vẹn nhất cho các nhà khảo cổ học ở Mỹ Sơn.",
      "start": 142.56,
      "end": 153.92,
      "n_words": 35,
      "start_frame": 3564,
      "end_frame": 3848,
      "keyframes": [
        "003587.webp",
        "003614.webp",
        "003615.webp",
        "003645.webp",
        "003676.webp",
        "003677.webp",
        "003705.webp",
        "003734.webp",
        "003735.webp",
        "003794.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Tất cả đều ngỡ ngàng, nhưng phải tới khi qua nhiều tháng thử nghiệm thành công ở di tích, thấy gạch chịu thời gian, rêu bám lên bề mặt và đặc biệt là không xuất hiện muối trắng - hiện tượng kinh điển khiến giới trùng tu luôn đau đầu.",
      "start": 153.92,
      "end": 175.68,
      "n_words": 50,
      "start_frame": 3848,
      "end_frame": 4392,
      "keyframes": [
        "003853.webp",
        "003854.webp",
        "003956.webp",
        "004059.webp",
        "004060.webp",
        "004096.webp",
        "004132.webp",
        "004133.webp",
        "004167.webp",
        "004202.webp",
        "004203.webp",
        "004254.webp",
        "004306.webp",
        "004307.webp",
        "004311.webp",
        "004316.webp",
        "004317.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "\"Trước khi đưa vào dòng di sản của văn hóa người Chăm thì tôi rất nghiêng về vấn đề tâm linh, cho nên tôi cũng có nhờ người Chăm họ sắm nghi lễ để xin phép được đưa sản phẩm của mình vào dòng di sản văn hóa người Chăm.\"",
      "start": 177.28,
      "end": 201.04,
      "n_words": 50,
      "start_frame": 4432,
      "end_frame": 5026,
      "keyframes": [
        "004655.webp",
        "004660.webp",
        "005003.webp",
        "005004.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Người nghệ nhân lớn tuổi này dành thời gian mỗi cuối ngày để vào thăm thung lũng thánh địa, nơi ông đã là một phần của di sản.",
      "start": 201.04,
      "end": 209.88,
      "n_words": 28,
      "start_frame": 5026,
      "end_frame": 5247,
      "keyframes": [
        "005050.webp",
        "005096.webp",
        "005097.webp",
        "005171.webp",
        "005245.webp",
        "005246.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mỗi lần tới, ông đều trầm ngâm trước dấu tích xưa cũ và linh thiêng, thâm sâu bí ẩn của người xưa khi tạo ra thánh địa.",
      "start": 209.88,
      "end": 219.28,
      "n_words": 27,
      "start_frame": 5247,
      "end_frame": 5482,
      "keyframes": [
        "005300.webp",
        "005355.webp",
        "005356.webp",
        "005412.webp",
        "005468.webp",
        "005469.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các loại gạch của ông đã góp phần dựng lại di sản của người xưa.",
      "start": 219.28,
      "end": 223.48,
      "n_words": 15,
      "start_frame": 5482,
      "end_frame": 5587,
      "keyframes": [
        "005514.webp",
        "005560.webp",
        "005561.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ông là người may mắn duy nhất được chọn để giao phó một sứ mệnh cao cả thiêng liêng là làm ra những viên gạch cổ.",
      "start": 223.48,
      "end": 233.68,
      "n_words": 26,
      "start_frame": 5587,
      "end_frame": 5842,
      "keyframes": [
        "005613.webp",
        "005666.webp",
        "005702.webp",
        "005773.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "\"Sản phẩm của mình làm ra, công thức của mình làm ra di sản, thật là xúc động, rất là tuyệt vời, cảm giác rất lạ.\"",
      "start": 233.68,
      "end": 257.84,
      "n_words": 26,
      "start_frame": 5842,
      "end_frame": 6446,
      "keyframes": [
        "005845.webp",
        "005846.webp",
        "005987.webp",
        "006129.webp",
        "006130.webp",
        "006274.webp",
        "006418.webp",
        "006419.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Giám đốc Ban quản lý di tích văn hóa Mỹ Sơn Nguyễn Công Khí khẳng định suốt 20 năm qua, lò gạch từ bàn tay nghệ nhân Nguyễn Quá đã cung cấp vật liệu chính để dựng lại tháp cổ.",
      "start": 257.84,
      "end": 269.96,
      "n_words": 40,
      "start_frame": 6446,
      "end_frame": 6749,
      "keyframes": [
        "006490.webp",
        "006562.webp",
        "006563.webp",
        "006670.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tuy nhiên, gần đây lò gạch của ông đối diện với một thách thức do toàn bộ quy trình làm từ thủ công nên lò gạch phát sinh khí thải ảnh hưởng môi trường, chính quyền yêu cầu di dời lò gạch này ra bên ngoài.",
      "start": 269.96,
      "end": 283.92,
      "n_words": 46,
      "start_frame": 6749,
      "end_frame": 7098,
      "keyframes": [
        "006777.webp",
        "006778.webp",
        "006845.webp",
        "006912.webp",
        "006913.webp",
        "006983.webp",
        "007054.webp",
        "007055.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Lo lắng cho Mỹ Sơn, lãnh đạo Ban quản lý khu đền tháp đã có những kiến nghị cụ thể để tháo gỡ.",
      "start": 283.92,
      "end": 291.36,
      "n_words": 23,
      "start_frame": 7098,
      "end_frame": 7284,
      "keyframes": [
        "007118.webp",
        "007181.webp",
        "007182.webp",
        "007253.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "\"Thì Ban quản lý di sản văn hóa Mỹ Sơn cũng nhận thức rằng cái việc xây dựng lò gạch để sản xuất gạch tại khu dân cư mà nơi ông Nguyễn Quá đang sinh sống là đương nhiên nó sẽ ảnh hưởng tác động đến môi trường của người dân xung quanh thì vấn đề đó nó ít nhiều nó cũng ảnh hưởng và vi phạm đến quy định của các cấp có thẩm quyền.",
      "start": 291.36,
      "end": 321.52,
      "n_words": 76,
      "start_frame": 7284,
      "end_frame": 8038,
      "keyframes": [
        "007324.webp",
        "007325.webp",
        "007332.webp",
        "007339.webp",
        "007340.webp",
        "007454.webp",
        "007569.webp",
        "007570.webp",
        "007624.webp",
        "007672.webp",
        "007679.webp",
        "007680.webp",
        "007850.webp",
        "008020.webp",
        "008021.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Về góc độ của Ban quản lý mong muốn các cấp có thẩm quyền quan tâm tạo điều kiện để ông Nguyễn Quá chọn một vị trí phù hợp không ảnh hưởng đến môi trường dân cư để ông Nguyễn Quá sản xuất cung cấp nguồn nguyên vật liệu gạch tương thích để trùng tu các khu tháp ở Mỹ Sơn, cụ thể là khu tháp E, F.",
      "start": 321.52,
      "end": 350.28,
      "n_words": 68,
      "start_frame": 8038,
      "end_frame": 8757,
      "keyframes": [
        "008110.webp",
        "008200.webp",
        "008201.webp",
        "008357.webp",
        "008513.webp",
        "008514.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và hiện nay hai chính phủ Ấn Độ và Việt Nam sẽ dự kiến trùng tu từ năm 2025 đến năm 2030.",
      "start": 350.28,
      "end": 358.72,
      "n_words": 22,
      "start_frame": 8757,
      "end_frame": 8968,
      "keyframes": [
        "008947.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nếu không có nguồn nguyên vật liệu gạch của ông Nguyễn Quá thì tôi e rằng có khu tháp ở Mỹ Sơn, cụ thể là F, E và AB sẽ có nguy cơ sụp đổ trong một thời gian sớm nhất.\"",
      "start": 360.52,
      "end": 376.72,
      "n_words": 41,
      "start_frame": 9013,
      "end_frame": 9418,
      "keyframes": [
        "009381.webp",
        "009382.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Có thể nói rằng đôi bàn tay cùng khả năng hiếm có của ông Quá đã góp phần rất lớn trong nỗ lực trùng tu Thánh địa Mỹ Sơn.",
      "start": 376.72,
      "end": 385.32,
      "n_words": 29,
      "start_frame": 9418,
      "end_frame": 9633,
      "keyframes": [
        "009427.webp",
