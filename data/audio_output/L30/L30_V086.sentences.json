        "002774.webp",
        "002775.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Năm 2023, Thiên Ân đem những sản phẩm của mình ra trường quốc tế.",
      "start": 111.88,
      "end": 116.56,
      "n_words": 14,
      "start_frame": 2797,
      "end_frame": 2914,
      "keyframes": [
        "002813.webp",
        "002851.webp",
        "002852.webp",
        "002883.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tác phẩm đầu tay \"Cá chép hóa rồng\" xuất sắc đạt huy chương vàng tại cuộc thi IESA và tại cuộc thi World Pastry Cup 2024 tổ chức tại Malaysia.",
      "start": 116.56,
      "end": 128.2,
      "n_words": 30,
      "start_frame": 2914,
      "end_frame": 3205,
      "keyframes": [
        "002915.webp",
