        "000410.webp",
        "000456.webp",
        "000457.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Anh dành khá nhiều thời gian để tìm hiểu và theo đuổi bộ môn này.",
      "start": 18.6,
      "end": 22.56,
      "n_words": 15,
      "start_frame": 465,
      "end_frame": 564,
      "keyframes": [
        "000507.webp",
        "000558.webp",
        "000559.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mất 3 giờ đồng hồ để tạo ra một chiếc bánh vẽ hình.",
      "start": 22.56,
      "end": 26.08,
      "n_words": 13,
      "start_frame": 564,
      "end_frame": 652,
      "keyframes": [
        "000606.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đối với những tác phẩm cần độ chi tiết, độ tả thực cao, Ân có thể dành cả tháng trời để tạo ra một sản phẩm ưng ý.",
      "start": 26.08,
      "end": 35.16,
      "n_words": 28,
      "start_frame": 652,
      "end_frame": 879,
      "keyframes": [
        "000654.webp",
        "000655.webp",
        "000694.webp",
        "000734.webp",
        "000735.webp",
        "000770.webp",
        "000806.webp",
        "000807.webp",
        "000845.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "\"Đối với một tác phẩm nghệ thuật thì mình sẽ mất khá nhiều thời gian trong việc lên ý tưởng, vẽ một cái bản vẽ phác thảo, canh chừng những cái kích thước của từng chi tiết trên bánh và mình bắt đầu tiến hành là phủ bánh, vẽ hình, tạo hình và điểm thêm những chi tiết để chiếc bánh được hoàn thiện.\"",
      "start": 35.16,
      "end": 59.12,
      "n_words": 64,
      "start_frame": 879,
      "end_frame": 1478,
      "keyframes": [
        "000884.webp",
        "000885.webp",
        "001206.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bánh được hoàn thiện tốt nhất, kẹo mềm fondant và màu thực phẩm là hai nguyên liệu không thể thiếu khi Ân tạo ra các tác phẩm.",
      "start": 59.12,
      "end": 67.92,
      "n_words": 27,
      "start_frame": 1478,
      "end_frame": 1698,
      "keyframes": [
        "001527.webp",
        "001528.webp",
        "001560.webp",
        "001593.webp",
        "001594.webp",
        "001623.webp",
        "001653.webp",
        "001654.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Thời gian đầu, Ân phải tự tìm hiểu tất cả các bước từ trộn bột đến đánh kem, anh chàng cũng tự học cách để vẽ màu lên nền kẹo sao cho đẹp.",
      "start": 67.92,
      "end": 77.16,
      "n_words": 33,
      "start_frame": 1698,
      "end_frame": 1929,
      "keyframes": [
        "001777.webp",
        "001901.webp",
        "001902.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Những tác phẩm Ân tạo ra sống động và chân thực đến độ nếu không được giới thiệu là bánh, nhiều người có thể nhầm tưởng đó là mô hình.",
      "start": 77.16,
      "end": 86.4,
      "n_words": 30,
      "start_frame": 1929,
      "end_frame": 2160,
      "keyframes": [
        "001942.webp",
        "001982.webp",
        "001983.webp",
        "002018.webp",
        "002053.webp",
        "002054.webp",
        "002079.webp",
        "002104.webp",
        "002105.webp",
        "002133.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "\"Mình phải tự tìm tòi và nghiên cứu ra được cái cách vẽ phù hợp, phối hợp giữa nền kẹo mềm fondant và màu thực phẩm thì mình quyết định là cải tiến cái công thức kẹo mềm để đường và màu thực phẩm có độ thẩm thấu nhất định, thì khi bấy giờ màu và đường nó có độ thẩm thấu nhất định thì nó sẽ thể hiện rõ nét được cái hồn của tác phẩm.\"",
      "start": 86.4,
      "end": 111.88,
      "n_words": 77,
      "start_frame": 2160,
      "end_frame": 2797,
      "keyframes": [
        "002162.webp",
