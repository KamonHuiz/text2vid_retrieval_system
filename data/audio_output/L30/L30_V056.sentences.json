        "002100.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Trước mình không có một cái tiền lệ để mà mình tham khảo, không có một cái mẫu để mình so sánh cho nên cái gì nó cũng bắt đầu từ đầu hết.",
      "start": 86.04,
      "end": 96.16,
      "n_words": 33,
      "start_frame": 2151,
      "end_frame": 2404,
      "keyframes": [
        "002155.webp",
