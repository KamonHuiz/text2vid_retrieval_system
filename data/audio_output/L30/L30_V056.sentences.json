      ],
      "keyframe_count": 16
    },
    {
      "text": "Cho nên Xơ Mướp không dám nói là tiên phong, tiên phong nhưng với kỳ vọng rằng sản phẩm Xơ Mướp thành phẩm sẽ là một trong những sản phẩm được nhiều người biết đến, nhiều nước biết đến là một sản phẩm nông nghiệp của Việt Nam.",
      "start": 55.4,
      "end": 86.04,
      "n_words": 48,
      "start_frame": 1385,
      "end_frame": 2151,
      "keyframes": [
        "001403.webp",
