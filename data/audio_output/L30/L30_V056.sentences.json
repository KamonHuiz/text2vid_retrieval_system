        "004218.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thì nó bao gồm có cho tới thời điểm hiện tại thì nó có năm cái nhóm sản phẩm.",
      "start": 169.52,
      "end": 175.04,
      "n_words": 19,
