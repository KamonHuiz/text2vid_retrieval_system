        "004319.webp",
        "004320.webp",
        "004364.webp"
      ],
      "keyframe_count": 23
    },
    {
      "text": "Lại nhờ những cái là nhờ những cái cuộc gặp như vậy mới biết đơn vị cũ ngày xưa.\"",
      "start": 175.16,
      "end": 181.4,
      "n_words": 19,
      "start_frame": 4379,
      "end_frame": 4535,
      "keyframes": [
        "004409.webp",
