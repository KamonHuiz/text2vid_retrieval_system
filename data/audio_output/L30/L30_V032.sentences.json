        "000650.webp",
        "000686.webp",
        "000687.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Tiến mắc căn bệnh lõm ngực bẩm sinh, phải cố định một thanh kim loại dài vào giữa ngực ngăn xương chèn ép phổi em mới thở được bình thường.",
      "start": 28.0,
      "end": 37.96,
      "n_words": 30,
      "start_frame": 700,
      "end_frame": 949,
      "keyframes": [
        "000734.webp",
        "000782.webp",
        "000783.webp",
        "000854.webp",
        "000926.webp",
        "000927.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mẹ Tiến là bà Trần Thị Thùy Trang cũng đang nhập viện để điều trị ung thư vú.",
      "start": 37.96,
      "end": 43.52,
      "n_words": 18,
      "start_frame": 949,
      "end_frame": 1088,
      "keyframes": [
        "000950.webp",
        "000973.webp",
        "000974.webp",
        "001061.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mấy năm nay bệnh viện như căn nhà thứ hai của mẹ con Tiến.",
      "start": 43.52,
      "end": 49.52,
      "n_words": 14,
      "start_frame": 1088,
      "end_frame": 1238,
      "keyframes": [
        "001148.webp",
        "001149.webp",
        "001185.webp",
        "001222.webp",
        "001223.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cậu trai 18 tuổi chỉ nặng hơn 30 ký vì bệnh tật cũng như hoàn cảnh nghèo khó, chẳng mấy khi được ăn ngon.",
      "start": 49.52,
      "end": 57.76,
      "n_words": 24,
      "start_frame": 1238,
      "end_frame": 1444,
      "keyframes": [
        "001269.webp",
        "001315.webp",
        "001316.webp",
        "001350.webp",
        "001385.webp",
        "001386.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Khó là vậy nhưng chẳng đánh gục được em.",
      "start": 57.76,
      "end": 60.76,
      "n_words": 9,
      "start_frame": 1444,
      "end_frame": 1519,
      "keyframes": [
        "001449.webp",
        "001513.webp",
        "001514.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ở trường, Nguyễn Tiến luôn là học sinh giỏi, hàng loạt giấy khen mà em giành được là minh chứng cho điều đó.",
      "start": 60.76,
      "end": 67.4,
      "n_words": 23,
      "start_frame": 1519,
      "end_frame": 1685,
      "keyframes": [
        "001583.webp",
        "001653.webp",
        "001654.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cũng chính nhờ những bằng khen này cộng với quá trình học tập chẳng biết mệt mỏi suốt ba năm ở trường đã giúp Tiến đỗ cùng lúc ba trường đại học hàng đầu về công nghệ thông tin, trong đó có trường Đại học Công nghệ, Đại học Quốc gia Hà Nội - ngôi trường mà em hằng mong ước nhờ điểm đánh giá năng lực.",
      "start": 67.4,
      "end": 85.28,
      "n_words": 67,
      "start_frame": 1685,
      "end_frame": 2132,
      "keyframes": [
        "001720.webp",
        "001787.webp",
        "001788.webp",
        "001891.webp",
        "001994.webp",
        "001995.webp",
        "002064.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Thế nhưng vì hoàn cảnh ngặt nghèo, Tiến quyết định chọn ngành Công nghệ thông tin Trường Đại học Bách khoa, Đại học Đà Nẵng để hiện thực hóa giấc mơ trở thành kỹ sư máy tính của mình và cũng để ở gần mẹ hơn.",
      "start": 85.28,
      "end": 106.28,
      "n_words": 46,
      "start_frame": 2132,
      "end_frame": 2657,
      "keyframes": [
        "002133.webp",
        "002134.webp",
        "002169.webp",
        "002205.webp",
        "002206.webp",
        "002244.webp",
        "002282.webp",
        "002283.webp",
        "002313.webp",
        "002343.webp",
        "002344.webp",
        "002375.webp",
        "002406.webp",
        "002407.webp",
        "002528.webp",
        "002650.webp",
        "002651.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Lý do mà em chọn ngành Công nghệ thông tin là vì đây là niềm đam mê của em và có tương lai để phát triển, kiếm được thu nhập cao để lo cho mẹ chữa bệnh ung thư.",
      "start": 106.28,
      "end": 117.32,
      "n_words": 39,
      "start_frame": 2657,
      "end_frame": 2933,
      "keyframes": [
        "002763.webp",
        "002875.webp",
        "002876.webp",
        "002927.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nếu mà mẹ em không cố gắng chữa bệnh được thì em sẽ gánh vác thay mẹ trong việc lo cho em gái của em tiếp tục được đi học.",
      "start": 119.44,
      "end": 131.84,
      "n_words": 30,
      "start_frame": 2986,
      "end_frame": 3296,
      "keyframes": [
        "003039.webp",
        "003098.webp",
        "003099.webp",
        "003145.webp",
        "003191.webp",
        "003192.webp",
        "003249.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Em mong là sau này em có thể thành đạt để có thể giúp đỡ các bạn khó khăn như em. Tuy nhiên, để đạt được ước mơ trở thành một lập trình viên chuyên nghiệp, Tiến phải đậu tốt nghiệp trung học phổ thông.",
      "start": 131.84,
      "end": 148.4,
      "n_words": 45,
      "start_frame": 3296,
      "end_frame": 3710,
      "keyframes": [
        "003306.webp",
        "003307.webp",
        "003416.webp",
        "003525.webp",
        "003526.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dù em đã chính thức được đậu ba trường đại học, sau khi thi tốt nghiệp xong thì bệnh tình của Tiến cũng trở nặng.",
      "start": 148.4,
      "end": 156.52,
      "n_words": 25,
      "start_frame": 3710,
      "end_frame": 3913,
      "keyframes": [
        "003712.webp",
        "003898.webp",
        "003899.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngày Tiến vào phòng mổ cũng là ngày có điểm thi tốt nghiệp trung học phổ thông.",
      "start": 156.52,
      "end": 160.96,
      "n_words": 17,
      "start_frame": 3913,
      "end_frame": 4024,
      "keyframes": [
        "003931.webp",
        "003964.webp",
        "003965.webp",
        "004001.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tiến tốt nghiệp và chính thức chạm tay vào giấc mơ đại học.",
      "start": 161.24,
      "end": 164.44,
      "n_words": 13,
      "start_frame": 4031,
      "end_frame": 4111,
      "keyframes": [
        "004038.webp",
