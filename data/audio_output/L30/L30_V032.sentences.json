  "sentences": [
    {
      "text": "Ngày nhận tin báo trúng tuyển ba trường đại học, Nguyễn Tiến Lớp 12A3 Trường Trung học phổ thông Hai Bà Trưng, tỉnh Thừa Thiên Huế vẫn đang nằm trong phòng phẫu thuật.",
      "start": 16.32,
      "end": 28.0,
      "n_words": 33,
      "start_frame": 408,
      "end_frame": 700,
      "keyframes": [
        "000426.webp",
