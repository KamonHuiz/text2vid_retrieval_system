  "total_words": 650,
  "sentences": [
    {
      "text": "Nằm sâu trong một con hẻm trên đường Hoàng Hoa Thám của Bình Thạnh, Thành phố Hồ Chí Minh, lớp học làm bánh miễn phí của cô Nguyễn Thị Hồng Hạnh được rất nhiều người yêu thích bộ môn làm bánh biết đến.",
      "start": 11.32,
      "end": 21.0,
      "n_words": 43,
      "start_frame": 283,
      "end_frame": 525,
      "keyframes": [
        "000289.webp",
