        "001115.webp",
        "001188.webp",
        "001189.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trong căn nhà nhỏ giản dị, góc sân của ông Vinh lúc nào cũng đầy ắp những dụng cụ sửa xe, dụng cụ sửa xe gắn bó với ông suốt những năm qua.",
      "start": 54.0,
      "end": 62.96,
      "n_words": 33,
      "start_frame": 1350,
      "end_frame": 1574,
      "keyframes": [
        "001386.webp",
        "001434.webp",
