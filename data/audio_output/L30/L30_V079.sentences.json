        "001478.webp",
        "001521.webp",
        "001522.webp",
        "001553.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bất kể ai gặp sự cố xe cộ, ông đều nhiệt tình giúp đỡ.",
      "start": 62.96,
      "end": 67.32,
      "n_words": 14,
      "start_frame": 1574,
      "end_frame": 1683,
      "keyframes": [
        "001585.webp",
        "001586.webp",
        "001616.webp",
        "001647.webp",
        "001648.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đối với ông Vinh, dù trong hoàn cảnh nào lòng tốt và sự sẻ chia luôn là những giá trị vô giá.",
      "start": 67.32,
      "end": 76.68,
      "n_words": 22,
      "start_frame": 1683,
      "end_frame": 1917,
      "keyframes": [
        "001688.webp",
        "001729.webp",
        "001730.webp",
        "001766.webp",
        "001803.webp",
        "001804.webp",
        "001860.webp",
        "001917.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "\"Hai chục năm nay là ngày đêm vậy đó.",
      "start": 76.68,
      "end": 79.04,
      "n_words": 9,
      "start_frame": 1917,
      "end_frame": 1976,
      "keyframes": [
        "001917.webp",
        "001918.webp",
        "001960.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hai mốt trên hai mốt đi lỡ đường hoặc là người ta lỡ, hai chục mười lăm ngàn, giá ba hai ba lỡ làm cho họ, giúp cho họ.\"",
      "start": 79.04,
      "end": 99.2,
      "n_words": 29,
      "start_frame": 1976,
      "end_frame": 2480,
      "keyframes": [
        "002002.webp",
        "002003.webp",
        "002141.webp",
        "002279.webp",
        "002280.webp",
        "002365.webp",
        "002451.webp",
        "002452.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Dù làm việc vất vả, quần áo lấm lem dầu nhớt nhưng ông Vinh vẫn luôn nở nụ cười hiền hậu lạc quan.",
      "start": 99.2,
      "end": 106.6,
      "n_words": 23,
      "start_frame": 2480,
      "end_frame": 2665,
      "keyframes": [
        "002518.webp",
        "002585.webp",
        "002586.webp",
        "002641.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Niềm vui đơn giản của ông chỉ là khi sửa xong một chiếc xe để ai cũng được về nhà không bị lỡ đường về quê.",
      "start": 106.6,
      "end": 117.2,
      "n_words": 26,
      "start_frame": 2665,
      "end_frame": 2930,
      "keyframes": [
        "002697.webp",
        "002698.webp",
        "002758.webp",
        "002818.webp",
        "002819.webp",
        "002868.webp",
        "002918.webp",
        "002919.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "\"Ta không có tiền về quê, lỡ người ta không có tiền về, xe hư sửa cho họ.\"",
      "start": 117.2,
      "end": 135.0,
      "n_words": 18,
      "start_frame": 2930,
      "end_frame": 3375,
      "keyframes": [
        "003141.webp",
        "003363.webp",
        "003364.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Những câu chuyện nhỏ nhặt hàng ngày, những lời cảm ơn chân thành, tất cả đều trở thành động lực to lớn giúp ông tiếp tục lan tỏa yêu thương và giúp đỡ mọi người.",
      "start": 135.0,
      "end": 145.8,
      "n_words": 35,
      "start_frame": 3375,
      "end_frame": 3645,
      "keyframes": [
        "003418.webp",
        "003473.webp",
        "003474.webp",
        "003556.webp",
        "003638.webp",
        "003639.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tiệm sửa xe của ông Vinh không chỉ sửa chữa những chiếc xe mà còn vá lại những mảnh vỡ trong lòng người, tô điểm cho một góc nhỏ thành phố thêm ấm áp và ý nghĩa hơn.",
