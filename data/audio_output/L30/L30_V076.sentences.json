        "001725.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chỉ tính riêng ba năm trở lại đây, ông đã khám chữa bệnh cho khoảng 300 người dân có hoàn cảnh khó khăn.",
      "start": 70.52,
