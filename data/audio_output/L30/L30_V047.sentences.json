        "005913.webp",
        "005987.webp",
        "005988.webp",
        "006073.webp",
        "006158.webp",
        "006159.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Theo thầy Hùng, lớp sẽ có những bài tập riêng cho các bạn làm quen với nước trước, sau đó mới thực hiện nhiều động tác bơi cơ bản.",
      "start": 247.12,
      "end": 255.36,
      "n_words": 29,
      "start_frame": 6178,
      "end_frame": 6384,
      "keyframes": [
        "006197.webp",
        "006236.webp",
        "006237.webp",
        "006272.webp",
        "006307.webp",
        "006308.webp",
        "006347.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Học sinh sẽ học kỹ thuật bơi ếch trên bờ rồi mới xuống nước thị phạm.",
      "start": 255.36,
      "end": 260.24,
      "n_words": 16,
      "start_frame": 6384,
      "end_frame": 6506,
      "keyframes": [
        "006386.webp",
        "006387.webp",
        "006432.webp",
        "006478.webp",
        "006479.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Em nào học nhanh có thể biết bơi sau 7 đến 8 buổi, chậm nhất thì khoảng 10 đến 14 buổi.",
      "start": 260.24,
      "end": 266.84,
      "n_words": 21,
      "start_frame": 6506,
      "end_frame": 6671,
      "keyframes": [
        "006560.webp",
        "006641.webp",
        "006642.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các em học sinh đa số đều thích thú, còn thầy cô và phụ huynh cũng yên tâm hơn khi thấy học trò con em mình đã biết bơi, ít nhất là có kỹ năng sinh tồn ở vùng sông nước.",
