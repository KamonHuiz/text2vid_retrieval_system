        "000591.webp",
        "000623.webp",
        "000624.webp",
        "000656.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Lớp bơi được tổ chức xuyên suốt năm học kể cả dịp nghỉ hè trong năm.",
      "start": 27.44,
      "end": 32.88,
      "n_words": 16,
      "start_frame": 686,
      "end_frame": 822,
      "keyframes": [
        "000689.webp",
        "000690.webp",
        "000752.webp",
        "000815.webp",
        "000816.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Buổi chiều sau khi học trên lớp xong, học sinh sẽ ở lại thêm một tiếng để học bơi.",
      "start": 32.88,
      "end": 38.24,
      "n_words": 19,
      "start_frame": 822,
      "end_frame": 956,
      "keyframes": [
        "000846.webp",
        "000876.webp",
        "000877.webp",
        "000914.webp",
        "000952.webp",
        "000953.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mỗi tuần lớp sẽ có hai buổi học, mỗi buổi một tiếng với khoảng 25 học sinh.",
      "start": 38.24,
      "end": 43.68,
      "n_words": 17,
      "start_frame": 956,
      "end_frame": 1092,
      "keyframes": [
        "000983.webp",
        "001013.webp",
        "001014.webp",
        "001052.webp",
        "001090.webp",
        "001091.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thầy Nguyễn Văn Hùng, giáo viên môn giáo dục thể chất cho biết, mỗi năm trung tâm văn hóa đều có băng rôn tuyên truyền phòng chống đuối nước cho học sinh dịp hè và trong năm học.",
      "start": 43.68,
      "end": 54.32,
      "n_words": 38,
      "start_frame": 1092,
      "end_frame": 1358,
      "keyframes": [
        "001169.webp",
        "001248.webp",
        "001249.webp",
        "001300.webp",
        "001352.webp",
        "001353.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Lớp gồm hai thầy giáo phụ trách, chủ yếu dạy học sinh ở các khối 3, 4 và 5.",
      "start": 54.32,
      "end": 59.12,
      "n_words": 19,
      "start_frame": 1358,
      "end_frame": 1478,
      "keyframes": [
        "001385.webp",
        "001417.webp",
        "001418.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tuy nhiên, các em khối lớp khác có nhu cầu học vẫn có thể đăng ký.",
      "start": 59.84,
      "end": 65.44,
      "n_words": 16,
      "start_frame": 1496,
      "end_frame": 1636,
      "keyframes": [
        "001525.webp",
        "001633.webp",
        "001634.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "\"Trong đó thì nó sẽ có nhiều cái đoạn từ nâng cao, từ cơ bản đến nâng cao.",
      "start": 65.44,
      "end": 70.12,
      "n_words": 18,
      "start_frame": 1636,
      "end_frame": 1753,
      "keyframes": [
        "001739.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên là các bạn sẽ ở nước trước, sau đó bạn sẽ lướt nước.",
      "start": 70.12,
      "end": 74.0,
      "n_words": 15,
      "start_frame": 1753,
      "end_frame": 1850,
      "keyframes": [
        "001844.webp",
        "001845.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Lướt nước xong đó bạn sẽ thực hiện đối với tôi ở đây dạy kỹ thuật bơi thì nó sẽ đầu tiên là các bạn lướt nước, quạt tay, lướt ở nước sau đó mới chân tập trung lướt, sau đó mới thực hiện kết hợp tay và chân.",
      "start": 74.0,
      "end": 88.68,
      "n_words": 49,
      "start_frame": 1850,
      "end_frame": 2217,
      "keyframes": [
        "001883.webp",
        "001921.webp",
        "001922.webp",
        "002011.webp",
        "002101.webp",
        "002102.webp",
        "002134.webp",
        "002166.webp",
        "002167.webp",
        "002208.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Ở nước là khó nhất, học sinh nó nhiều khi lướt nước được mà lại vô kết hợp với động tác ở nước thì các bạn sẽ bị chìm hoặc các bạn sặc nước không quen.\"",
      "start": 88.68,
      "end": 97.8,
      "n_words": 36,
      "start_frame": 2217,
      "end_frame": 2445,
      "keyframes": [
        "002249.webp",
        "002250.webp",
        "002335.webp",
        "002420.webp",
        "002421.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thường xuyên đưa con đang học lớp một đến lớp bơi, anh Phạm Thanh Thới, phụ huynh học sinh cho hay rằng ở đây chủ yếu dạy bơi các khối 3, 4, 5, tuy nhiên ai có con lớp một muốn đăng ký cho con mình học thì các thầy vẫn dạy bình thường.",
      "start": 97.8,
      "end": 112.8,
      "n_words": 54,
      "start_frame": 2445,
      "end_frame": 2820,
      "keyframes": [
        "002467.webp",
        "002514.webp",
        "002515.webp",
        "002552.webp",
        "002589.webp",
        "002590.webp",
        "002621.webp",
        "002653.webp",
        "002654.webp",
        "002694.webp",
        "002735.webp",
        "002736.webp",
        "002770.webp",
        "002804.webp",
        "002805.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "\"Bởi trước hay sau các cháu đều phải học lý thuyết, nhớ lý thuyết mình.",
      "start": 112.8,
      "end": 117.84,
      "n_words": 15,
      "start_frame": 2820,
      "end_frame": 2946,
      "keyframes": [
        "002863.webp",
        "002921.webp",
        "002922.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ở Cần Giờ nói chung là đa số là ao hồ nhiều nên tầm cho các con bơi nước, thấy các thầy dạy rất là nhiệt tình, dù cũng ráng tranh thủ sắp xếp công chuyện gia đình vô dạy.",
      "start": 117.84,
      "end": 141.12,
      "n_words": 40,
      "start_frame": 2946,
      "end_frame": 3528,
      "keyframes": [
        "003113.webp",
        "003305.webp",
        "003306.webp",
        "003356.webp",
        "003407.webp",
        "003408.webp",
        "003484.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Em một tuần có thể là hai ngày, ba ngày cũng sắp xếp, hè hè là mấy thầy có lịch vô dạy bơi.",
      "start": 141.12,
      "end": 150.68,
      "n_words": 23,
      "start_frame": 3528,
      "end_frame": 3767,
      "keyframes": [
        "003560.webp",
        "003561.webp",
        "003639.webp",
        "003718.webp",
        "003719.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Các em bé học cũng lúc đầu đến giờ thì bé cũng đã biết bơi, thì cũng nói chung cũng bơi cũng ổn, bơi cũng nói chung cơ bản cũng bơi được rồi.",
      "start": 150.68,
      "end": 160.48,
      "n_words": 33,
      "start_frame": 3767,
      "end_frame": 4012,
      "keyframes": [
        "003898.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Có tại vì anh có mấy cái ao á thì rảnh thì có hai ba con thì cũng lên trên ao cho bé bơi tập, thì trong hồ thì bơi nó quen trước từ ao.\"",
      "start": 160.48,
      "end": 176.48,
      "n_words": 35,
      "start_frame": 4012,
      "end_frame": 4412,
      "keyframes": [
        "004077.webp",
        "004078.webp",
        "004227.webp",
        "004376.webp",
        "004377.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nay ở trường đã có khá nhiều học sinh biết bơi, thậm chí bơi giỏi.",
      "start": 176.48,
      "end": 180.84,
      "n_words": 15,
      "start_frame": 4412,
      "end_frame": 4521,
      "keyframes": [
        "004431.webp",
        "004485.webp",
        "004486.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngoài việc có kỹ năng tự cứu mình, nhiều em sau khi biết bơi đã hỗ trợ các thầy dạy lại cho những bạn khác.",
      "start": 180.84,
      "end": 187.8,
      "n_words": 25,
      "start_frame": 4521,
      "end_frame": 4695,
      "keyframes": [
        "004548.webp",
        "004611.webp",
        "004612.webp",
        "004652.webp",
        "004693.webp",
        "004694.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Sau khi học gần một tháng, từ cô bé nghĩ rằng bơi lội rất khó học, giờ đây em Lâm Ngọc Mỹ Khánh đã biết bơi ếch, lướt nước.",
      "start": 187.8,
      "end": 196.88,
      "n_words": 29,
      "start_frame": 4695,
      "end_frame": 4922,
      "keyframes": [
        "004754.webp",
        "004814.webp",
        "004815.webp",
        "004862.webp",
        "004910.webp",
        "004911.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bên cạnh đó, em cho biết càng học càng thấy thích bơi, các thầy dạy cũng khá dễ hiểu.",
      "start": 196.88,
      "end": 206.8,
      "n_words": 19,
      "start_frame": 4922,
      "end_frame": 5170,
      "keyframes": [
        "004943.webp",
        "004976.webp",
        "004977.webp",
        "005005.webp",
        "005034.webp",
        "005035.webp",
        "005098.webp",
        "005162.webp",
        "005163.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "\"Biết bơi lúc đầu khá là dễ, lúc mà con chưa biết bơi con cảm thấy rất là sợ.",
      "start": 206.8,
      "end": 229.48,
      "n_words": 19,
      "start_frame": 5170,
      "end_frame": 5737,
      "keyframes": [
        "005180.webp",
        "005197.webp",
        "005198.webp",
        "005365.webp",
        "005532.webp",
        "005533.webp",
        "005686.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bạn nhỏ tuổi bơi cùng, các bạn rất hòa đồng và có thể là giúp đỡ con, chỉ dẫn lại cho em nhỏ lại.\"",
      "start": 229.48,
      "end": 247.12,
      "n_words": 24,
      "start_frame": 5737,
      "end_frame": 6178,
      "keyframes": [
        "005839.webp",
