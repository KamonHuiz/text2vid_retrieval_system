        "001080.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Hơn 200.000 đồng là tấm lòng sẻ chia của cô bé vùng biên chỉ mới sáu tuổi.",
      "start": 45.28,
      "end": 50.96,
      "n_words": 17,
