        "000618.webp",
        "000619.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Với cô bé Lê Ngô Thiên Ân, học sinh lớp 1B trường tiểu học Phú Thuận A, huyện Hồng Ngự, tỉnh Đồng Tháp cũng thế.",
      "start": 25.04,
      "end": 31.28,
      "n_words": 25,
      "start_frame": 626,
      "end_frame": 782,
      "keyframes": [
        "000653.webp",
        "000687.webp",
        "000688.webp",
        "000720.webp",
        "000753.webp",
        "000754.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Từ những hình ảnh được xem, những câu chuyện được người thân kể nên, khi trường phát động kêu gọi ủng hộ đồng bào miền Bắc khắc phục hậu quả sau bão lũ, Thiên Ân đã đập heo đất gom hết số tiền mà em đã dành dụm trong hai năm để ủng hộ các bạn thiếu nhi miền Bắc.",
      "start": 31.28,
      "end": 45.28,
      "n_words": 60,
      "start_frame": 782,
      "end_frame": 1132,
      "keyframes": [
        "000795.webp",
