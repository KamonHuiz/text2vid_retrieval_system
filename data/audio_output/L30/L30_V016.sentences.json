        "000392.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Khi xem những hình ảnh cũ về mưa lũ ở các tỉnh miền Bắc, không chỉ người lớn mà đến các em nhỏ cũng thấy thương những người đang khổ sở, đau thương vì bão lũ sạt lở.",
      "start": 16.24,
      "end": 25.04,
      "n_words": 38,
      "start_frame": 406,
      "end_frame": 626,
      "keyframes": [
