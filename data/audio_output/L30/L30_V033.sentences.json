        "005983.webp",
        "006034.webp",
        "006035.webp"
      ],
      "keyframe_count": 33
    },
    {
      "text": "Nhưng mà sau đó, không ai cũng làm được thì nhìn kỹ lại nỗi sợ nó từ cái mình không biết.",
      "start": 243.4,
      "end": 258.08,
      "n_words": 21,
      "start_frame": 6085,
      "end_frame": 6452,
      "keyframes": [
        "006107.webp",
        "006179.webp",
