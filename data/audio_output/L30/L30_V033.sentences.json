        "002284.webp",
        "002285.webp",
        "002323.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Thiên nhiên nuôi dưỡng sự sống của ta bao nhiêu triệu năm, chứ không phải là bây giờ.",
      "start": 93.12,
      "end": 102.8,
