      "n_words": 31,
      "start_frame": 1122,
      "end_frame": 1357,
      "keyframes": [
        "001258.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Để chúng tránh khỏi phần chui vào chúng tôi nhưng mà đây là thử thách của hành trình này.",
      "start": 54.28,
