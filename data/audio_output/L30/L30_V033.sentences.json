        "003169.webp",
        "003170.webp",
        "003205.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Xung quanh chúng ta là sự sống, sự tồn tại của chúng ta phụ thuộc vào sự tồn tại của muôn loài khác.",
      "start": 128.72,
      "end": 141.04,
      "n_words": 23,
      "start_frame": 3218,
      "end_frame": 3526,
      "keyframes": [
        "003241.webp",
        "003242.webp",
        "003320.webp",
        "003398.webp",
        "003399.webp",
        "003485.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cho nên nếu mình đủ yêu thương, mình sẽ bảo vệ nơi này và nơi này sẽ bảo vệ mình.",
      "start": 141.04,
      "end": 151.2,
      "n_words": 20,
      "start_frame": 3526,
      "end_frame": 3780,
      "keyframes": [
        "003571.webp",
        "003572.webp",
        "003618.webp",
        "003665.webp",
        "003666.webp",
        "003722.webp",
        "003779.webp",
        "003780.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Tốc độ của tất cả chúng ta là tốc độ của người chậm nhất trong đoàn.",
      "start": 151.2,
      "end": 157.68,
      "n_words": 16,
      "start_frame": 3780,
      "end_frame": 3942,
      "keyframes": [
        "003780.webp",
        "003840.webp",
        "003900.webp",
        "003901.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nếu chúng ta đủ yêu thương, chúng ta chăm sóc cho những người chậm hơn chúng ta thì tốc độ của cả đoàn sẽ được cải thiện.",
      "start": 157.68,
      "end": 171.84,
      "n_words": 27,
      "start_frame": 3942,
      "end_frame": 4296,
      "keyframes": [
        "003957.webp",
        "004014.webp",
        "004015.webp",
        "004101.webp",
        "004187.webp",
        "004188.webp",
        "004268.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Mỗi bước chân của chúng ta đều có giá trị như nhau.",
      "start": 171.84,
      "end": 176.72,
      "n_words": 12,
      "start_frame": 4296,
      "end_frame": 4418,
      "keyframes": [
        "004349.webp",
        "004350.webp",
        "004388.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Để lên được đỉnh núi, bước chân nào cũng góp phần của nó.",
      "start": 176.72,
      "end": 182.64,
      "n_words": 13,
      "start_frame": 4418,
      "end_frame": 4566,
      "keyframes": [
        "004427.webp",
        "004428.webp",
        "004454.webp",
        "004480.webp",
        "004481.webp",
        "004514.webp",
        "004547.webp",
        "004548.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Hãy trọn vẹn với từng bước chân, chỉ có bằng cách đó chúng ta mới biết cách thưởng thức từng giây phút của cuộc sống cũng như thưởng thức từng bước chân nơi đây, cái cảm giác này.",
      "start": 182.64,
