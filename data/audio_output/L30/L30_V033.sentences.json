        "002479.webp",
        "002480.webp",
        "002527.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng con xin nguyện đến đây với tình yêu thương.",
      "start": 102.8,
      "end": 108.88,
      "n_words": 10,
      "start_frame": 2570,
