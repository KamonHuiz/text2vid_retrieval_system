        "002088.webp",
        "002089.webp",
        "002117.webp"
      ],
      "keyframe_count": 24
    },
    {
      "text": "Cho phép các giác quan mình mở rộng để đón nhận thiên nhiên xung quanh ta.",
      "start": 84.68,
      "end": 93.12,
      "n_words": 16,
