        "002797.webp",
        "002829.webp",
        "002862.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đủ yêu thương thì tất cả những nỗi sợ sẽ được hóa giải.",
      "start": 117.76,
      "end": 128.72,
      "n_words": 13,
      "start_frame": 2944,
      "end_frame": 3218,
      "keyframes": [
        "002981.webp",
