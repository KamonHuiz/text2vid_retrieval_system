        "006384.webp",
        "006425.webp",
        "006426.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Mình không biết về những cái thứ mình đang đối diện, mình không biết rõ về nó. Ví dụ tại sao mình lại sợ sống với thiên nhiên? Tại sao phải sợ?",
      "start": 258.08,
      "end": 267.4,
      "n_words": 32,
      "start_frame": 6452,
      "end_frame": 6685,
      "keyframes": [
        "006558.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Thiên nhiên là sự sống mà tại sao mình lại sợ?",
      "start": 267.4,
      "end": 270.36,
      "n_words": 11,
      "start_frame": 6685,
      "end_frame": 6759,
      "keyframes": [
        "006691.webp",
        "006692.webp",
        "006714.webp",
        "006737.webp",
        "006738.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nó chỉ nuôi dưỡng sự sống thôi.",
      "start": 270.36,
      "end": 272.16,
      "n_words": 7,
      "start_frame": 6759,
      "end_frame": 6804,
      "keyframes": [
        "006769.webp",
        "006801.webp",
        "006802.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho nên khi mình ở một mình trong thiên nhiên, mình có cảm giác sợ sợ đó là mình chưa hiểu về, chưa hiểu về cái thế giới này.",
      "start": 272.16,
      "end": 279.16,
      "n_words": 29,
      "start_frame": 6804,
      "end_frame": 6979,
      "keyframes": [
        "006826.webp",
        "006850.webp",
        "006851.webp",
        "006928.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thì bạn hiểu về thế giới này thì bạn thấy à, nó là cái thứ giúp chúng ta tồn tại. Cho nên cái thứ sợ là nó nằm ở trong đầu chúng ta thôi.",
      "start": 279.16,
      "end": 289.44,
      "n_words": 34,
      "start_frame": 6979,
      "end_frame": 7236,
      "keyframes": [
        "007006.webp",
        "007007.webp",
        "007038.webp",
        "007069.webp",
        "007070.webp",
        "007099.webp",
        "007128.webp",
        "007129.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cái mà làm chúng ta sợ là nằm trong đầu chúng ta, nằm trong đầu chúng ta là chúng ta hay suy diễn và có những cái hình ảnh mà nó không đẹp.",
      "start": 289.44,
      "end": 298.56,
      "n_words": 33,
      "start_frame": 7236,
      "end_frame": 7464,
      "keyframes": [
        "007285.webp",
        "007441.webp",
        "007442.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hy vọng là những cái chuyến như thế này, mọi người sẽ vượt qua một chút gì đó ở trong mình, còn cái giới hạn nào đó, nên là sẽ vượt qua giới hạn.",
      "start": 298.56,
      "end": 307.84,
      "n_words": 34,
      "start_frame": 7464,
      "end_frame": 7696,
      "keyframes": [
        "007535.webp",
        "007629.webp",
        "007630.webp",
        "007676.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trở về với thiên nhiên là về với chính mình.",
      "start": 307.84,
      "end": 312.92,
      "n_words": 10,
      "start_frame": 7696,
      "end_frame": 7823,
      "keyframes": [
        "007722.webp",
        "007723.webp",
        "007746.webp",
        "007770.webp",
        "007771.webp",
        "007816.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ở thiên nhiên, chúng ta soi mình với thiên nhiên để sống bao dung hơn, yêu thương nhiều hơn và học cách yêu thương.",
      "start": 312.92,
      "end": 317.84,
      "n_words": 24,
      "start_frame": 7823,
      "end_frame": 7946,
      "keyframes": [
        "007861.webp",
        "007862.webp",
        "007912.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trên núi, thiên nhiên ngắt kết nối công nghệ để kết nối con người và kết nối với chính mình, kết nối với đồng đội và từ đó khám phá ra một bản thể khác, một con người khác.",
      "start": 317.84,
      "end": 326.16,
      "n_words": 39,
      "start_frame": 7946,
      "end_frame": 8154,
      "keyframes": [
        "007962.webp",
        "007963.webp",
        "007990.webp",
        "008018.webp",
        "008019.webp",
        "008071.webp",
        "008124.webp",
        "008125.webp",
        "008154.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Thấy hết vẻ đẹp, sự hùng vĩ của đất nước này, yêu hơn đất nước này và hòa nhịp cùng thiên nhiên sâu.",
