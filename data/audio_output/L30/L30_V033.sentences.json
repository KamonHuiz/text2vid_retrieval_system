        "002707.webp",
        "002708.webp",
        "002721.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta sẽ đi với sự biết ơn, sự trân trọng thiên nhiên xung quanh mình.",
      "start": 108.88,
      "end": 117.76,
