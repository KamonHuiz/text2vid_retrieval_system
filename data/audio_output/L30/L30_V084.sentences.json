        "001793.webp",
        "001835.webp",
        "001836.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Khi mà cái chương trình này phát động thì ai cũng đều rất vui hết trơn, nhất là những người dân nghèo khó khăn có được những bữa cơm trưa vậy nè.",
      "start": 73.44,
      "end": 84.16,
      "n_words": 32,
      "start_frame": 1836,
      "end_frame": 2104,
      "keyframes": [
        "001836.webp",
        "001997.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mà ở đây thì cô nấu rất là ngon, thành ra cái suất ăn của người dân cứ mỗi ngày mỗi tăng lên vậy đó.",
      "start": 84.16,
      "end": 93.28,
      "n_words": 25,
      "start_frame": 2104,
      "end_frame": 2332,
      "keyframes": [
        "002158.webp",
