        "002254.webp",
        "002316.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tại vì cô tham gia theo ở đây thì cô nắm rõ cái trường hợp đó, cho ăn miễn phí giúp đỡ những người nghèo khó khăn đó.",
      "start": 93.28,
      "end": 107.56,
      "n_words": 28,
