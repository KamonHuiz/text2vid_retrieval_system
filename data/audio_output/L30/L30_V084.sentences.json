        "001543.webp",
        "001544.webp",
        "001577.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các cán bộ hội viên Hội Chữ thập đỏ phường Lái Thiêu cũng chung sức với bếp, mỗi người phụ một tay để mỗi bữa cơm thêm ấm áp.",
      "start": 63.96,
      "end": 73.44,
      "n_words": 29,
      "start_frame": 1599,
      "end_frame": 1836,
      "keyframes": [
        "001611.webp",
