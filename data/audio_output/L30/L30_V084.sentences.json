        "001105.webp",
        "001307.webp",
        "001308.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hôm nay bếp phục vụ bánh canh để đổi món cho bà con ăn ngon miệng hơn.",
      "start": 52.88,
      "end": 57.08,
      "n_words": 17,
      "start_frame": 1322,
      "end_frame": 1427,
      "keyframes": [
        "001349.webp",
        "001391.webp",
        "001392.webp",
        "001425.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ở khu vực bếp, sau khi hoàn thành các khâu chế biến, mỗi người tự nhận một việc để kịp giờ mở cửa phục vụ bà con.",
      "start": 57.08,
      "end": 63.96,
      "n_words": 27,
      "start_frame": 1427,
      "end_frame": 1599,
      "keyframes": [
        "001459.webp",
