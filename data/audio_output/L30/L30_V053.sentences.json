        "005848.webp",
        "005883.webp",
        "005884.webp",
        "005919.webp",
        "005954.webp",
        "005955.webp"
      ],
      "keyframe_count": 28
    },
    {
      "text": "Suất cơm trao đi đều kèm với những lời dặn dò sẻ chia đáng quý nhất.",
      "start": 239.56,
      "end": 244.56,
      "n_words": 16,
      "start_frame": 5989,
      "end_frame": 6114,
      "keyframes": [
        "005991.webp",
        "006027.webp",
        "006028.webp",
        "006110.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đối với quán cơm này, không gì hơn là những nụ cười, những lời cảm ơn và sự ấm áp nghĩa tình trao đi.",
      "start": 244.56,
      "end": 252.48,
      "n_words": 24,
      "start_frame": 6114,
      "end_frame": 6312,
      "keyframes": [
        "006193.webp",
        "006194.webp",
        "006261.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Để nhận lại niềm vui từ những người đến lấy cơm cũng chính là động lực để chủ quán tiếp tục giữ lửa và lan tỏa mô hình này.",
      "start": 252.48,
      "end": 261.08,
      "n_words": 29,
      "start_frame": 6312,
      "end_frame": 6527,
      "keyframes": [
        "006328.webp",
        "006329.webp",
        "006522.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Có thể đối với nhiều người một bữa cơm không quá to tát, nhưng với những mảnh đời khó khăn, đó là bữa cơm nghĩa tình ấm áp giúp họ có thêm điểm tựa, niềm vui để vượt qua những khó khăn trong cuộc sống.",
      "start": 261.08,
      "end": 275.56,
      "n_words": 45,
      "start_frame": 6527,
      "end_frame": 6889,
      "keyframes": [
        "006716.webp",
        "006717.webp",
        "006840.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Quán cơm tấm của anh Thành Công là cầu nối, là chứng minh cho nghĩa tình đong đầy yêu thương, sự hào sảng sẻ chia của con người giữa nơi tứ xứ đầy bộn bề lo toan.",
