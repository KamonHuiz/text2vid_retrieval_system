  "n_sentences": 21,
  "total_words": 703,
  "sentences": [
    {
      "text": "Hơn một tháng qua, cứ đều đặn mỗi chiều, người già neo đơn, trẻ em bán vé số hay bất kỳ ai khó khăn đều có thể ghé vào lấy một phần cơm miễn phí tại quán cơm tấm Thanh niên của anh Thành Công nằm trên đường Nguyễn Ảnh Thủ, xã Bà Điểm, huyện Hóc Môn.",
      "start": 11.88,
      "end": 30.08,
      "n_words": 57,
      "start_frame": 297,
      "end_frame": 752,
      "keyframes": [
        "000356.webp",
