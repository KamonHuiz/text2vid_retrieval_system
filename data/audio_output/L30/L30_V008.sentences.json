  "sentences": [
    {
      "text": "Mình tên là Trương Thanh Tùng, thì mình hiện tại là đang là nghiên cứu và chế tác chất liệu pháp lam.",
      "start": 21.92,
      "end": 26.44,
      "n_words": 22,
      "start_frame": 548,
      "end_frame": 661,
      "keyframes": [
        "000549.webp",
        "000550.webp",
        "000628.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì hiện tại mình đang ở Hóc Môn, pháp lam định nghĩa cơ bản đó là tráng men nhiều màu sắc trên nền kim loại và nung ở nhiệt độ cao.",
      "start": 26.44,
      "end": 34.8,
      "n_words": 31,
      "start_frame": 661,
      "end_frame": 870,
      "keyframes": [
        "000706.webp",
