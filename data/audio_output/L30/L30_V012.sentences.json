        "001953.webp",
        "001954.webp",
        "002091.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Và mình khi mà mình té xuống thì máu bầm, tụ máu não và tay trái của mình gần như đứt lìa.",
      "start": 88.88,
