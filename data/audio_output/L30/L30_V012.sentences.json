        "003064.webp",
        "003065.webp",
        "003088.webp",
        "003111.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mỗi cái chặng đường của mình thì những cái khó khăn khác nhau, nhưng mà khó khăn lớn nhất có thể là những cái khoảnh khắc mình đối mặt với tử thần.",
      "start": 125.0,
      "end": 133.96,
      "n_words": 32,
      "start_frame": 3125,
      "end_frame": 3349,
      "keyframes": [
        "003130.webp",
        "003231.webp",
        "003333.webp",
        "003334.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mình cố gắng để giành giật sự sống từ những cái điều nhỏ nhỏ nhất, nhưng mà mình vẫn nuôi một cái niềm tin là chỉ cần còn được sống mình còn có hy vọng.",
      "start": 133.96,
      "end": 146.72,
      "n_words": 35,
      "start_frame": 3349,
      "end_frame": 3668,
      "keyframes": [
        "003448.webp",
        "003563.webp",
        "003564.webp",
        "003614.webp",
        "003665.webp",
        "003666.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Giữa năm 2009 là lúc đó mình đã có tủ sách rồi, thì nhân một cái chuyến sang Việt Nam để chụp ảnh những nạn nhân da cam thì cái anh nhiếp ảnh gia đó, ảnh là người Mỹ thì ảnh có đến Củ Chi để chụp hình tất cả những nạn nhân da cam và trong đó có mình.",
      "start": 146.72,
      "end": 165.36,
      "n_words": 60,
      "start_frame": 3668,
      "end_frame": 4134,
      "keyframes": [
        "003860.webp",
        "004054.webp",
        "004055.webp",
        "004093.webp",
        "004132.webp",
        "004133.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trong cái khuôn hình của ảnh thì đa số những cái hình ảnh của mình là những cái hình ảnh rất là nhí nhảnh.",
      "start": 165.36,
      "end": 170.76,
      "n_words": 24,
      "start_frame": 4134,
      "end_frame": 4269,
      "keyframes": [
        "004172.webp",
        "004212.webp",
        "004237.webp",
        "004254.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thì khi mà ảnh về lại quê hương của ảnh, ảnh có chia sẻ cái câu chuyện, cái câu chuyện hành trình ảnh đến Việt Nam và một trong những người bạn ảnh chia sẻ là chị Alizades thì chị là một đạo diễn làm phim.",
      "start": 170.76,
      "end": 182.96,
      "n_words": 46,
      "start_frame": 4269,
      "end_frame": 4574,
      "keyframes": [
        "004271.webp",
