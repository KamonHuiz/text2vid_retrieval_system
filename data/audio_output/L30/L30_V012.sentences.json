        "000600.webp",
        "000601.webp",
        "000672.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình tên họ đầy đủ là Huỳnh Thanh Thảo.",
      "start": 28.84,
      "end": 32.32,
      "n_words": 9,
      "start_frame": 721,
      "end_frame": 808,
      "keyframes": [
        "000744.webp",
