        "002312.webp",
        "002337.webp",
        "002466.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Sức khỏe của mình lúc đó cực kỳ yếu.",
      "start": 100.64,
      "end": 104.56,
      "n_words": 9,
      "start_frame": 2516,
      "end_frame": 2614,
      "keyframes": [
        "002596.webp",
        "002597.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Sau khi mình cấp cứu rồi mình đi qua rất là nhiều cái bệnh viện khác nhau thì cuối cùng bác sĩ trả về.",
      "start": 104.56,
      "end": 117.12,
      "n_words": 24,
      "start_frame": 2614,
      "end_frame": 2928,
      "keyframes": [
        "002722.webp",
        "002847.webp",
        "002872.webp",
        "002896.webp",
        "002921.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cái lúc mà mình nói rất là ý, mình rất là thản nhiên, mà khi mà tối mình đợi mẹ mình, ba mình ngủ mình khóc nhưng chưa được khóc luôn.",
      "start": 117.12,
      "end": 125.0,
      "n_words": 31,
      "start_frame": 2928,
      "end_frame": 3125,
      "keyframes": [
        "002938.webp",
