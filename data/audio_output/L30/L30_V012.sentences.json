        "000531.webp",
        "000532.webp",
        "000566.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Viết nó như là một cái nơi để mình vào đó để mình trải lòng.",
      "start": 23.6,
      "end": 28.84,
      "n_words": 15,
