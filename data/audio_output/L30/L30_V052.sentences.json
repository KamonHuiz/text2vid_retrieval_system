      ],
      "keyframe_count": 6
    },
    {
      "text": "Tùy vào tình trạng hư hại của sách, Trịnh Quang sẽ tốn từ khoảng vài ngày đến vài tuần để chữa lành cho những trang sách.",
      "start": 121.44,
