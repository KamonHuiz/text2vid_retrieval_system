        "001107.webp",
        "001134.webp",
        "001135.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đến nay, chàng trai 9x đã phục chế hơn 1.000 quyển sách lớn nhỏ.",
      "start": 48.32,
      "end": 54.44,
      "n_words": 14,
