        "003602.webp",
        "003603.webp",
        "003653.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Có nguồn thu nguồn yến ổn định nên gia đình tinh chế luôn thành yến sào.",
      "start": 147.16,
      "end": 151.96,
      "n_words": 16,
