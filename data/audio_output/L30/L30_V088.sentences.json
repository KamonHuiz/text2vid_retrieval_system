        "001848.webp",
        "001889.webp",
        "001930.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Xây nhà hồi đó nó nằm vào cả năm trăm triệu rồi hoàn thiện là vào 1,7 tỷ thôi.",
      "start": 77.4,
      "end": 84.4,
      "n_words": 19,
      "start_frame": 1935,
      "end_frame": 2110,
      "keyframes": [
        "002018.webp",
        "002105.webp",
        "002106.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Năm 2018, bắt đầu là tháng 5/2018 là bắt đầu khởi công xây, đến cuối 2018 là mở máy, là hoàn thiện mở máy đấy.",
      "start": 84.4,
      "end": 97.68,
      "n_words": 25,
      "start_frame": 2110,
      "end_frame": 2442,
      "keyframes": [
        "002154.webp",
