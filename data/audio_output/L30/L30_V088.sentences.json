        "000630.webp",
        "000670.webp",
        "000671.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Gia đình chúng tôi cũng vậy, mất hai năm trời và gấp ba lần số tiền đầu tư ban đầu, chúng tôi mới có thể thu hái được lộc của trời.",
      "start": 28.16,
      "end": 36.68,
      "n_words": 31,
      "start_frame": 704,
      "end_frame": 917,
      "keyframes": [
        "000710.webp",
