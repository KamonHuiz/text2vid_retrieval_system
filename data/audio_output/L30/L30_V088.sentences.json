        "000794.webp",
        "000838.webp",
        "000839.webp",
        "000874.webp",
        "000909.webp",
        "000910.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nếu như không kiên trì, không chịu bỏ vốn đầu tư làm lại thì có lẽ gia đình chúng tôi đã phải gánh một khoản nợ khổng lồ vì nuôi yến.",
      "start": 36.68,
      "end": 45.4,
      "n_words": 31,
      "start_frame": 917,
      "end_frame": 1135,
      "keyframes": [
        "000959.webp",
        "001008.webp",
        "001009.webp",
        "001036.webp",
        "001064.webp",
        "001065.webp",
        "001102.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Miền đất đỏ quê tôi rộ lên phong trào nuôi yến độ khoảng chục năm nay.",
      "start": 45.4,
      "end": 49.72,
      "n_words": 16,
      "start_frame": 1135,
      "end_frame": 1243,
      "keyframes": [
        "001140.webp",
        "001141.webp",
        "001192.webp",
        "001243.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Từ độ người ta thấy từng đàn yến bay rợp trời vào mỗi buổi chiều, yến làm tổ vạ trên tầng hai, tầng ba của một số ngôi nhà, thế là mọi người bắt đầu vay tiền để cất nhà nuôi yến.",
      "start": 49.72,
      "end": 61.12,
      "n_words": 42,
      "start_frame": 1243,
      "end_frame": 1528,
      "keyframes": [
        "001243.webp",
        "001244.webp",
        "001280.webp",
        "001316.webp",
        "001317.webp",
        "001351.webp",
