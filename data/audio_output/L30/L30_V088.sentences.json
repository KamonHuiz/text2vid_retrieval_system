  "sentences": [
    {
      "text": "Kiên trì mới thu hái được lộc của trời.",
      "start": 15.88,
      "end": 18.48,
      "n_words": 9,
      "start_frame": 397,
      "end_frame": 462,
      "keyframes": [
        "000440.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ở xã Thống Nhất, huyện Bù Đăng, tỉnh Bình Phước, Của chúng tôi có hơn 50 nóc nhà cao tầng nuôi yến nhưng chỉ có độ hơn 10 nhà có yến đến làm tổ.",
      "start": 18.48,
      "end": 28.16,
      "n_words": 34,
      "start_frame": 462,
      "end_frame": 704,
      "keyframes": [
        "000507.webp",
