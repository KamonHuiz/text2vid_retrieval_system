        "001431.webp",
        "001476.webp",
        "001477.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Nhà thì thuê công ty chuyên thiết kế thi công nhà yến để xây, cũng có nhà tự đi sang tỉnh khác nhìn xem người ta xây nhà thế nào rồi về học hỏi và làm lại.",
      "start": 61.12,
      "end": 71.36,
      "n_words": 37,
      "start_frame": 1528,
      "end_frame": 1784,
      "keyframes": [
        "001531.webp",
