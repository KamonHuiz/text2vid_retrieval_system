        "001727.webp",
        "001728.webp",
        "001758.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Gia đình tôi chọn thuê công ty nhưng gặp thất bại ngay từ lần đầu tiên.",
      "start": 71.36,
      "end": 77.2,
      "n_words": 16,
