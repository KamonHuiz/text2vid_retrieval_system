        "002367.webp",
        "002415.webp",
        "002416.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đến 2020 chưa có con chim nào, lo lắng cả tài sản bỏ đó hết.",
      "start": 97.68,
      "end": 105.68,
      "n_words": 15,
