        "003349.webp",
        "003413.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Có lúc phải vay ngân hàng, giờ chúng tôi cũng đã có dòng tiền ổn định mỗi tháng.",
      "start": 137.6,
      "end": 142.4,
      "n_words": 18,
      "start_frame": 3440,
