        "002565.webp",
        "002605.webp",
        "002606.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thiết kế ban đầu của căn nhà yến này rộng khoảng 5 mét, chia ngăn đôi từ lầu thành từng phòng riêng nhưng do nóng quá, yến về không làm tổ.",
      "start": 105.68,
      "end": 115.04,
      "n_words": 31,
      "start_frame": 2642,
      "end_frame": 2876,
      "keyframes": [
        "002666.webp",
