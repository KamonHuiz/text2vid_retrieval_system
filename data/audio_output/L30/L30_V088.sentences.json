        "003000.webp",
        "003057.webp",
        "003058.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tổng tiền thu sửa hai lần nhà yến vốn 1,7 tỷ bây giờ đã tốn ngót 3 tỷ.",
      "start": 122.36,
      "end": 127.76,
      "n_words": 18,
      "start_frame": 3059,
      "end_frame": 3194,
      "keyframes": [
        "003151.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đến năm 2022 gia đình tôi đón những con chim yến đầu tiên, bắt đầu được thu lượm lộc của trời sau bao nhiêu năm cố gắng không nản chí.",
      "start": 127.76,
      "end": 137.6,
      "n_words": 30,
      "start_frame": 3194,
