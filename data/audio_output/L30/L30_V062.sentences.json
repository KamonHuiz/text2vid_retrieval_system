  "sentences": [
    {
      "text": "Thương những chú mèo hoang bữa đói bữa no, bạn Hoàng Anh Tú, 24 tuổi, quê Lâm Đồng, đã tạo ra một số sản phẩm gốm hình mèo bán để kiếm thêm ít tiền mua thức ăn cho chúng.",
      "start": 0.04,
      "end": 23.76,
      "n_words": 39,
      "start_frame": 1,
      "end_frame": 594,
      "keyframes": [
        "000075.webp",
