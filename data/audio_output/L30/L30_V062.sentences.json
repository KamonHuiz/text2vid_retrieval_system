      ],
      "keyframe_count": 21
    },
    {
      "text": "Tú tạo hình ly mèo, tượng mèo, pin cài áo, tất cả đều mang hình mèo dễ thương, ngộ nghĩnh.",
      "start": 154.72,
      "end": 161.28,
