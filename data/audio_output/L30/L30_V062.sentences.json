        "000528.webp",
        "000548.webp",
        "000578.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Làm chơi ăn thật, những sản phẩm của Tú được đón nhận và trở thành nghề có thu nhập cao cho chàng trai Gen Z.",
      "start": 23.76,
      "end": 32.32,
      "n_words": 25,
      "start_frame": 594,
      "end_frame": 808,
      "keyframes": [
        "000609.webp",
        "000632.webp",
        "000663.webp",
        "000695.webp",
        "000712.webp",
        "000741.webp",
        "000770.webp",
        "000771.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Năm 2021, Hoàng Anh Tú quyết định từ bỏ công việc văn phòng và theo nghề vẽ thủ công trên gốm.",
      "start": 32.32,
      "end": 39.68,
      "n_words": 21,
      "start_frame": 808,
      "end_frame": 992,
      "keyframes": [
        "000814.webp",
        "000857.webp",
        "000858.webp",
        "000892.webp",
        "000927.webp",
        "000928.webp",
        "000960.webp",
        "000992.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Làm việc ở lò gốm, Tú gặp những mèo hoang quanh đó hàng ngày; Cũng vốn thích mèo từ nhỏ lại thương cảm cho những con vật bữa đói bữa no, Tú lấy đây làm ý tưởng và thực hiện những sản phẩm độc đáo của mình.",
      "start": 39.68,
      "end": 55.16,
      "n_words": 47,
      "start_frame": 992,
      "end_frame": 1379,
      "keyframes": [
        "000992.webp",
        "000993.webp",
        "001015.webp",
        "001038.webp",
        "001039.webp",
        "001068.webp",
        "001097.webp",
        "001098.webp",
        "001123.webp",
        "001149.webp",
        "001150.webp",
        "001171.webp",
        "001192.webp",
        "001193.webp",
        "001231.webp",
        "001270.webp",
        "001271.webp",
        "001325.webp",
        "001379.webp"
      ],
      "keyframe_count": 19
    },
    {
      "text": "\"Khi mà mình làm những sản phẩm mèo ban đầu là mình chỉ định là bán đủ có tiền để mua hạt cho mèo ăn thôi, nhưng mà về sau thì mình thấy mình làm những cái sản phẩm này được mọi người đón nhận nhiều.",
      "start": 55.16,
      "end": 68.08,
      "n_words": 46,
      "start_frame": 1379,
      "end_frame": 1702,
      "keyframes": [
        "001379.webp",
        "001380.webp",
        "001507.webp",
        "001634.webp",
        "001635.webp",
        "001668.webp",
        "001701.webp",
        "001702.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Có một cái khoảng thời gian mà tụi mình bị chậm tiền á, chậm tiền cho khách trả thì mình nói với con mèo là: 'Tụi mày phù hộ cho tao có tiền đi thì tao sẽ lấy tiền mua pate cho mày ăn'.",
      "start": 68.08,
      "end": 79.44,
      "n_words": 44,
      "start_frame": 1702,
      "end_frame": 1986,
      "keyframes": [
        "001702.webp",
        "001703.webp",
        "001704.webp",
        "001705.webp",
        "001841.webp",
        "001978.webp",
        "001979.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Thế là xong rồi, không biết sao mà những lần mà mình nói như thế thì lúc nào cũng có tiền, và sau đấy là lúc này mình cũng mua pate cho tụi anh hết.",
      "start": 79.44,
      "end": 86.2,
      "n_words": 35,
      "start_frame": 1986,
      "end_frame": 2155,
      "keyframes": [
        "002016.webp",
        "002054.webp",
        "002055.webp",
        "002077.webp",
        "002099.webp",
        "002100.webp",
        "002128.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Nên là mình quyết định phát triển luôn cái mảng mà nặn mèo này.\"",
      "start": 86.2,
      "end": 92.32,
      "n_words": 14,
      "start_frame": 2155,
      "end_frame": 2308,
      "keyframes": [
        "002156.webp",
        "002157.webp",
        "002220.webp",
        "002283.webp",
        "002284.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tú coi những con mèo hoang ở đây như linh vật.",
      "start": 92.32,
      "end": 95.28,
      "n_words": 11,
      "start_frame": 2308,
      "end_frame": 2382,
      "keyframes": [
        "002320.webp",
        "002356.webp",
        "002357.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dù không thể mang về nhà trọ nuôi nhưng nếu ai ngỏ ý xin về chăm sóc, anh chàng cũng không nỡ rời.",
      "start": 95.28,
      "end": 101.96,
      "n_words": 23,
      "start_frame": 2382,
      "end_frame": 2549,
      "keyframes": [
        "002394.webp",
        "002431.webp",
        "002432.webp",
        "002464.webp",
        "002497.webp",
        "002498.webp",
        "002525.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đàn mèo cứ thế tự nhiên sinh sống tại lò gốm và rất ngoan ngoãn nghe lời.",
      "start": 101.96,
      "end": 108.64,
      "n_words": 17,
      "start_frame": 2549,
      "end_frame": 2716,
      "keyframes": [
        "002552.webp",
        "002553.webp",
        "002579.webp",
        "002606.webp",
        "002607.webp",
        "002630.webp",
        "002654.webp",
        "002655.webp",
        "002686.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "\"Mình kiểu như mình thấy tụi nó kiểu rất là chiêu á, nên là khi mà mình nhìn tụi nó thì mình kiểu như là mình thấy là ở giữa những cái thế giới mà mọi người ai cũng bộn bề tất bật đó thì mình thấy tụi nó như kiểu là những cái khoảng lặng để cho mình có thể nghỉ ngơi rồi thơ thẩn rồi bay bổng.",
      "start": 108.64,
      "end": 124.0,
      "n_words": 69,
      "start_frame": 2716,
      "end_frame": 3100,
      "keyframes": [
        "002718.webp",
        "002719.webp",
        "002865.webp",
        "003012.webp",
        "003013.webp",
        "003056.webp",
        "003099.webp",
        "003100.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Khi mà mình vẽ những cái con mèo thì mình chú ý nhất là về đôi mắt của tụi nó với biểu cảm, vì mình thấy là một tác phẩm mà mình vẽ ra cái hồn nhất là ở đôi mắt nên là mình rất là chú trọng vào biểu cảm và đôi mắt của những con mèo.\"",
      "start": 124.0,
      "end": 138.96,
      "n_words": 58,
      "start_frame": 3100,
      "end_frame": 3474,
      "keyframes": [
        "003100.webp",
