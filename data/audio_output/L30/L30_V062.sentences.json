        "003969.webp",
        "004026.webp",
        "004027.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mèo gốm trước khi thành hình hài sẽ được Tú nặn tay, chờ khô rồi mới lên màu, xịt men và đem đi nung.",
      "start": 161.28,
      "end": 169.04,
      "n_words": 24,
      "start_frame": 4032,
      "end_frame": 4226,
      "keyframes": [
        "004082.webp",
        "004138.webp",
        "004139.webp",
        "004173.webp",
        "004208.webp",
        "004209.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Giá thành dao động từ 70.000 đồng đến 500.000 đồng tùy sản phẩm.",
      "start": 169.04,
      "end": 173.76,
      "n_words": 13,
      "start_frame": 4226,
