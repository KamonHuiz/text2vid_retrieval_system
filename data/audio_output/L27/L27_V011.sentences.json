        "001055.webp",
        "001071.webp",
        "001072.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Có vẻ như nãy giờ thì con thử bốn loại thì loại này ngọt nhất.",
      "start": 42.92,
      "end": 52.08,
      "n_words": 15,
      "start_frame": 1073,
      "end_frame": 1302,
      "keyframes": [
        "001122.webp",
        "001172.webp",
        "001173.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chào mừng quý vị và các bạn đang đến với chương trình Việt Nam đi là ghiền.",
      "start": 52.08,
      "end": 57.0,
      "n_words": 17,
      "start_frame": 1302,
      "end_frame": 1425,
      "keyframes": [
        "001348.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Thưa quý vị, ngày hôm nay thì Thảo Uyên đang có mặt tại thành phố Ngã Bảy của tỉnh Hậu Giang.",
      "start": 57.0,
      "end": 61.52,
      "n_words": 21,
      "start_frame": 1425,
      "end_frame": 1538,
      "keyframes": [
        "001524.webp",
        "001525.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Với hàng trăm hàng ngàn những con sông con rạch lớn nhỏ thì đã cho một nguồn nước ngọt dồi dào, cũng như là điều kiện thổ nhưỡng tốt, thời tiết thì ôn hòa.",
      "start": 61.52,
      "end": 70.0,
      "n_words": 34,
      "start_frame": 1538,
      "end_frame": 1750,
      "keyframes": [
        "001561.webp",
        "001597.webp",
        "001598.webp",
        "001628.webp",
        "001658.webp",
        "001659.webp",
        "001694.webp",
        "001730.webp",
        "001731.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chính vì vậy mà Hậu Giang đã có rất là nhiều những vườn cây ăn trái sum xuê trĩu quả.",
      "start": 70.0,
      "end": 74.64,
      "n_words": 20,
      "start_frame": 1750,
      "end_frame": 1866,
      "keyframes": [
        "001783.webp",
        "001836.webp",
        "001837.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thảo Uyên nghĩ là rất là tuyệt vời nếu như mà chúng ta được đi bộ tận hưởng không khí trong lành cũng như là thưởng thức những trái cây theo đúng mùa tại miệt vườn của vùng sông nước.",
      "start": 74.64,
      "end": 84.08,
      "n_words": 40,
      "start_frame": 1866,
      "end_frame": 2102,
      "keyframes": [
        "001876.webp",
        "001915.webp",
        "001916.webp",
        "001951.webp",
        "001986.webp",
        "001987.webp",
        "002020.webp",
        "002053.webp",
        "002054.webp",
        "002075.webp",
        "002097.webp",
        "002098.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Vậy thì ngày hôm nay hãy để Thảo Uyên dẫn tất cả quý vị và các bạn chúng ta cùng nhau trải nghiệm nha.",
      "start": 84.08,
      "end": 91.12,
      "n_words": 24,
      "start_frame": 2102,
      "end_frame": 2278,
      "keyframes": [
        "002182.webp",
        "002266.webp",
        "002273.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngã Bảy, một địa danh nổi tiếng được nhiều người biết đến qua bài ca \"Ngã Bảy hữu tình\", anh bán chiếu, là một trong những địa phương của tỉnh Hậu Giang có nhiều vườn cây ăn trái và các địa điểm du lịch sinh thái miệt vườn khá hấp dẫn với các loại trái cây nhiệt đới vô cùng phong phú.",
      "start": 91.12,
      "end": 108.72,
      "n_words": 62,
      "start_frame": 2278,
      "end_frame": 2718,
      "keyframes": [
        "002300.webp",
        "002328.webp",
        "002329.webp",
        "002349.webp",
        "002370.webp",
        "002371.webp",
        "002388.webp",
        "002406.webp",
        "002407.webp",
        "002424.webp",
        "002442.webp",
        "002443.webp",
        "002466.webp",
        "002490.webp",
        "002491.webp",
        "002514.webp",
        "002537.webp",
        "002538.webp",
        "002564.webp",
