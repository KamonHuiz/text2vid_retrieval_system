        "002615.webp",
        "002638.webp",
        "002639.webp",
        "002659.webp",
        "002680.webp",
        "002681.webp",
        "002698.webp",
        "002715.webp",
        "002716.webp"
      ],
      "keyframe_count": 30
    },
    {
      "text": "Ở góc nhìn trên cao, Ngã Bảy là nơi tụ thủy của bảy nhánh kinh tạo thành một giao lộ sông nước trông thật ngoạn mục và kỳ vĩ.",
      "start": 108.72,
      "end": 117.32,
      "n_words": 29,
      "start_frame": 2718,
      "end_frame": 2933,
      "keyframes": [
        "002828.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Càng kỳ vĩ hơn khi đây lại là những dòng kinh do bàn tay con người khai thông dòng chảy đã hơn 100 năm qua trong lịch sử khẩn hoang miền Nam.",
      "start": 117.32,
      "end": 126.72,
      "n_words": 32,
      "start_frame": 2933,
      "end_frame": 3168,
      "keyframes": [
        "002940.webp",
        "002941.webp",
        "003006.webp",
        "003071.webp",
        "003072.webp",
        "003131.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nhà văn Sơn Nam từng viết về vùng đất này: \"Giữa Cần Thơ, Sóc Trăng và ranh tỉnh Rạch Giá có một cánh đồng bát ngát nước ngọt, không quá thấp và sình lầy như Đồng Tháp Mười\".",
      "start": 126.72,
      "end": 138.56,
      "n_words": 38,
      "start_frame": 3168,
      "end_frame": 3464,
      "keyframes": [
        "003191.webp",
        "003192.webp",
        "003256.webp",
        "003320.webp",
        "003321.webp",
        "003389.webp",
        "003458.webp",
        "003459.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Và nếu có dịp dừng chân tại đây, các bạn cũng đừng quá ngạc nhiên khi lạc bước vào những vườn cây ăn trái rộng đến vài ha với những cành trái lủng liễng ở miền sông nước Ngã Bảy như thế này nhé.",
      "start": 138.56,
      "end": 151.84,
      "n_words": 44,
      "start_frame": 3464,
      "end_frame": 3796,
      "keyframes": [
        "003514.webp",
        "003570.webp",
        "003571.webp",
        "003618.webp",
        "003666.webp",
        "003667.webp",
        "003692.webp",
        "003717.webp",
        "003718.webp",
        "003772.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Đây là khu vườn trái cây Thiên Ân của chú Nguyễn Văn Tâm, mà bà con lối xóm thường gọi là chú Mười Tâm, tọa lạc tại khu phố 7, phường Ngã Bảy thuộc thành phố Ngã Bảy của tỉnh Hậu Giang.",
      "start": 151.84,
      "end": 164.16,
      "n_words": 42,
      "start_frame": 3796,
      "end_frame": 4104,
      "keyframes": [
        "003826.webp",
        "003827.webp",
        "003847.webp",
        "003867.webp",
        "003868.webp",
        "003884.webp",
        "003900.webp",
        "003901.webp",
        "003920.webp",
        "003940.webp",
        "003941.webp",
        "003976.webp",
        "004011.webp",
        "004012.webp",
        "004053.webp",
        "004095.webp",
        "004096.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Trên khu vườn rộng mênh mông, chú Mười Tâm trồng nhiều loại cây ăn trái nhiệt đới nhưng chú lại đặc biệt yêu thích sưu tầm và trồng nhiều giống dâu quý.",
      "start": 164.16,
      "end": 173.92,
      "n_words": 32,
      "start_frame": 4104,
      "end_frame": 4348,
      "keyframes": [
        "004122.webp",
        "004148.webp",
        "004149.webp",
        "004181.webp",
        "004214.webp",
        "004215.webp",
        "004246.webp",
        "004277.webp",
        "004278.webp",
        "004308.webp",
        "004339.webp",
        "004340.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Hiện tại khu vườn của chú Mười có trên 1.000 gốc dâu, cho cành trái sum suê trĩu quả.",
      "start": 173.92,
      "end": 179.8,
      "n_words": 19,
      "start_frame": 4348,
      "end_frame": 4495,
      "keyframes": [
        "004371.webp",
        "004402.webp",
        "004403.webp",
        "004424.webp",
        "004446.webp",
        "004447.webp",
        "004468.webp",
        "004489.webp",
        "004490.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "- Trong vườn mình có bốn loại dâu: một loại dâu là dâu bòn bon là dâu vàng; Hai là dâu gia bảo là dâu xanh; Ba là dâu xiêm; Thứ tư nữa là dâu hạ châu.",
      "start": 179.8,
      "end": 193.6,
      "n_words": 37,
      "start_frame": 4495,
      "end_frame": 4840,
      "keyframes": [
        "004524.webp",
        "004558.webp",
        "004559.webp",
        "004696.webp",
        "004834.webp",
        "004835.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Đây là dâu bòn bon gọi là dâu vàng.",
      "start": 193.6,
      "end": 196.48,
      "n_words": 10,
      "start_frame": 4840,
      "end_frame": 4912,
      "keyframes": [
        "004879.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Khi mà nó nở hoa rồi thì mình phải lấy cái phấn lực, mình phải dùng máy mình thổi, mình thụ phấn hoa cho nó nó mới có ruột, không thì nó sẽ lép như vậy nè.",
      "start": 196.48,
      "end": 206.28,
      "n_words": 37,
      "start_frame": 4912,
      "end_frame": 5157,
      "keyframes": [
        "004924.webp",
        "004925.webp",
        "004974.webp",
        "005024.webp",
        "005025.webp",
        "005062.webp",
        "005100.webp",
        "005101.webp",
        "005121.webp",
        "005142.webp",
        "005143.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "- Tính ra là công đoạn cũng rất là khó chú với cái vườn mà rộng như vậy mình phải tốn bao nhiêu thời gian mới phun hết?",
      "start": 206.28,
      "end": 211.56,
      "n_words": 28,
      "start_frame": 5157,
      "end_frame": 5289,
      "keyframes": [
        "005190.webp",
        "005238.webp",
        "005239.webp",
        "005282.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "- À mỗi buổi sáng thì mình lấy phấn lực rồi bắt đầu là phải ba bốn máy mình mới đi giáp một khu vườn đó là phải mất cỡ mà một tiếng rưỡi tới hai tiếng đồng hồ.",
      "start": 211.56,
      "end": 221.12,
      "n_words": 39,
      "start_frame": 5289,
      "end_frame": 5528,
      "keyframes": [
        "005325.webp",
        "005326.webp",
        "005373.webp",
        "005421.webp",
        "005422.webp",
        "005474.webp",
        "005526.webp",
        "005527.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "- Chú Mười ơi, ví dụ như cái gốc cây mà con mấy chú đang đứng ở đây nè thì nó khoảng bao nhiêu tuổi rồi?",
      "start": 221.12,
      "end": 226.76,
      "n_words": 26,
      "start_frame": 5528,
      "end_frame": 5669,
      "keyframes": [
        "005590.webp",
        "005653.webp",
        "005654.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Gốc này khoảng trên 15 tuổi rồi.",
      "start": 226.76,
      "end": 229.4,
      "n_words": 8,
      "start_frame": 5669,
      "end_frame": 5735,
      "keyframes": [
        "005696.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trúng mùa là một cái cây này khoảng từ 300-400 ký lô trái.",
      "start": 229.4,
      "end": 232.84,
      "n_words": 13,
      "start_frame": 5735,
      "end_frame": 5821,
      "keyframes": [
        "005739.webp",
        "005740.webp",
        "005809.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tròn mà nó lớn thì cho nó có ruột nhưng mà nó vậy, nó thì cứ chua ngọt mới cắn thì nó ngọt chú, nhưng mà vô thôi nó chua.",
      "start": 233.08,
      "end": 251.52,
      "n_words": 30,
      "start_frame": 5827,
      "end_frame": 6288,
      "keyframes": [
        "005878.webp",
        "005879.webp",
        "005910.webp",
        "005942.webp",
        "005943.webp",
        "006052.webp",
        "006161.webp",
        "006162.webp",
        "006223.webp",
        "006285.webp",
        "006286.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "- Cái vườn dâu hạ châu này của mình là chú trồng bao nhiêu cây?",
      "start": 251.52,
      "end": 254.88,
      "n_words": 15,
      "start_frame": 6288,
      "end_frame": 6372,
      "keyframes": [
        "006327.webp",
        "006369.webp",
        "006370.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Khu này mình trồng 100 cây dâu hạ châu.",
      "start": 254.88,
      "end": 258.44,
      "n_words": 10,
      "start_frame": 6372,
      "end_frame": 6461,
      "keyframes": [
        "006409.webp",
        "006449.webp",
        "006450.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình đặc điểm mình trồng từng khu mình dễ xử lý.",
      "start": 258.44,
      "end": 264.56,
      "n_words": 11,
      "start_frame": 6461,
      "end_frame": 6614,
      "keyframes": [
        "006524.webp",
