        "003067.webp",
        "003068.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Khu du lịch Mũi Nai Hà Tiên hiện là điểm đến thu hút rất nhiều du khách ghé thăm.",
      "start": 123.4,
      "end": 129.84,
