        "003840.webp",
        "003841.webp",
        "004007.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngồi đây có thắng tay nè, đó mình có thể điều chỉnh được tốc độ nha.",
      "start": 164.64,
      "end": 172.68,
      "n_words": 16,
