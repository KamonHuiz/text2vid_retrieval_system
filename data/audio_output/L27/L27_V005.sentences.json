      "end_frame": 4317,
      "keyframes": [
        "004173.webp",
        "004174.webp",
        "004312.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi chắc chắn rồi, đã thắt dây, đã thắt dây, an toàn, bây giờ viết thôi!",
      "start": 172.68,
