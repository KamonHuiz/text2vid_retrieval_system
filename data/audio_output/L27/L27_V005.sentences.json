      "keyframes": [
        "001408.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và ngay hôm nay, chúng ta hãy cùng khám phá Mũi Nai, một trong những thắng cảnh của Hà Tiên, Kiên Giang.",
      "start": 59.76,
