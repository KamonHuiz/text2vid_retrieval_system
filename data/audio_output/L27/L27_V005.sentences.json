      "keyframes": [
        "001678.webp",
        "001720.webp",
        "001721.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngay bây giờ chúng ta hãy cùng đi khám phá thôi!",
      "start": 71.32,
      "end": 74.68,
      "n_words": 11,
      "start_frame": 1783,
      "end_frame": 1867,
      "keyframes": [
