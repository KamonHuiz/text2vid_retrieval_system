        "002000.webp",
        "002054.webp",
        "002055.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Biển Mũi Nai có triền dốc thoải, bãi cát mịn màng êm ái.",
      "start": 82.28,
      "end": 87.12,
      "n_words": 13,
