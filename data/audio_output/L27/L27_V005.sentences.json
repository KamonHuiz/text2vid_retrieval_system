        "003218.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đây là hệ thống xe trượt ống dài, tốc độ khoảng 40 km/h và sẽ khiến cho bạn vui chơi quên lối về.",
      "start": 129.84,
