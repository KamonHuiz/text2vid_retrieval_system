      "end_frame": 1412,
      "keyframes": [
        "001369.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mỗi du khách khi đến du lịch Hà Tiên thì luôn muốn tìm đến những quán ăn bình dân để có thể thưởng thức món bún kèn rất độc đáo của người dân nơi đây.",
      "start": 56.48,
      "end": 64.6,
      "n_words": 35,
      "start_frame": 1412,
      "end_frame": 1615,
