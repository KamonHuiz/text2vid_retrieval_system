        "004201.webp",
        "004237.webp",
        "004238.webp",
        "004247.webp",
        "004257.webp",
        "004258.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Cũng theo lời bà Năm, bún kèn Hà Tiên có hương vị thơm ngon lạ miệng, trước tiên là nhờ nguồn cá tươi biển Hà Tiên cho mình nhiều tôm cá, trong đó có vài loại cá biển có thịt trắng thơm dai và ngọt vừa đánh bắt ngoài biển về được lựa chọn để nấu nồi bún kèn sao cho thơm ngon nhất.",
      "start": 170.56,
      "end": 191.64,
      "n_words": 64,
      "start_frame": 4264,
      "end_frame": 4791,
      "keyframes": [
