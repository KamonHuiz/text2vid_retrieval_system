        "001919.webp",
        "001941.webp",
        "001942.webp",
        "001982.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đi thôi nào!",
      "start": 79.88,
      "end": 83.08,
      "n_words": 3,
      "start_frame": 1997,
      "end_frame": 2077,
      "keyframes": [
        "002023.webp",
        "002024.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Có người nói vui rằng đến Hà Tiên mà chưa thưởng thức tô bún kèn coi như chưa đến Hà Tiên.",
      "start": 83.08,
      "end": 89.0,
      "n_words": 21,
      "start_frame": 2077,
      "end_frame": 2225,
      "keyframes": [
        "002115.webp",
        "002206.webp",
        "002207.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ở Hà Tiên, món bún kèn thường bán vào buổi sáng và chỉ có vài hộ gia đình theo nghề này.",
      "start": 89.0,
      "end": 95.16,
      "n_words": 21,
      "start_frame": 2225,
      "end_frame": 2379,
      "keyframes": [
        "002279.webp",
        "002351.webp",
        "002352.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta có thể hỏi thăm bất cứ người dân địa phương hay tìm trên mạng internet là dễ dàng tìm được địa chỉ của các quán bún kèn ở thành phố biển nhỏ xinh xinh này.",
      "start": 95.16,
      "end": 104.92,
      "n_words": 37,
      "start_frame": 2379,
      "end_frame": 2623,
      "keyframes": [
        "002381.webp",
        "002411.webp",
        "002412.webp",
        "002473.webp",
        "002535.webp",
        "002536.webp",
        "002570.webp",
        "002605.webp",
        "002606.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hôm nay, Như Bình tìm đến quán bún kèn Năm Của trên đường Chi Lăng, thuộc phường Bình San, thành phố Hà Tiên.",
      "start": 104.92,
      "end": 111.0,
      "n_words": 23,
      "start_frame": 2623,
      "end_frame": 2775,
      "keyframes": [
        "002643.webp",
        "002680.webp",
        "002681.webp",
        "002733.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tuy là một quán ăn bình dân mộc mạc ven đường nhưng quán bún kèn Năm Của có khá đông thực khách đang ngồi xúm xít bên những tô bún khói nghi ngút.",
      "start": 111.0,
      "end": 120.72,
      "n_words": 33,
      "start_frame": 2775,
      "end_frame": 3018,
      "keyframes": [
        "002786.webp",
        "002787.webp",
        "002849.webp",
        "002911.webp",
        "002912.webp",
        "002958.webp",
        "003005.webp",
        "003006.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Ngồi bên cạnh Như Bình đây là bác Năm, cũng là chủ của quán Năm Của. - Dạ con chào bác Năm.",
      "start": 120.72,
      "end": 127.16,
      "n_words": 22,
      "start_frame": 3018,
      "end_frame": 3179,
      "keyframes": [
        "003073.webp",
        "003140.webp",
        "003141.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bác ơi, hồi xưa là lý do nào mà mình theo nghề bán bún kèn ạ?",
      "start": 127.16,
      "end": 132.0,
      "n_words": 16,
      "start_frame": 3179,
      "end_frame": 3300,
      "keyframes": [
        "003220.webp",
        "003299.webp",
        "003300.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Cái nghề bún kèn này là của Campuchia, giờ bà nội học lại rồi về nhà mình làm mình bán, mình chế biến thêm.",
      "start": 132.0,
      "end": 139.48,
      "n_words": 25,
      "start_frame": 3300,
      "end_frame": 3487,
      "keyframes": [
        "003300.webp",
        "003333.webp",
        "003367.webp",
        "003368.webp",
        "003427.webp",
        "003486.webp",
        "003487.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Hồi xưa ở Hà Tiên mình là chỉ có một hai người bán bún kèn thôi, nhưng mà cái quán bún kèn của bác là quán đầu tiên.",
      "start": 139.48,
      "end": 146.72,
      "n_words": 28,
      "start_frame": 3487,
      "end_frame": 3668,
      "keyframes": [
        "003487.webp",
        "003577.webp",
        "003667.webp",
        "003668.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tới bây giờ bác theo nghề đó là cỡ khoảng 30 năm rồi.",
      "start": 146.72,
      "end": 150.88,
      "n_words": 13,
      "start_frame": 3668,
      "end_frame": 3772,
      "keyframes": [
        "003668.webp",
        "003719.webp",
        "003771.webp",
        "003772.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cái hương vị của bún kèn đó là từ hồi nào tới giờ khách hàng cũng đã quen rồi, từ qua ở chợ Lớn năm nào cũng ghé hết trơn á ghé hai ba lần, vậy nha, một năm vậy đó.",
      "start": 150.88,
      "end": 162.04,
      "n_words": 41,
      "start_frame": 3772,
      "end_frame": 4051,
      "keyframes": [
        "003772.webp",
        "003802.webp",
        "003833.webp",
        "003834.webp",
