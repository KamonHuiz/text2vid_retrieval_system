        "003995.webp",
        "004031.webp",
        "004032.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Giờ hình như là họ đã ăn của mình rồi và năm nào có đi tham quan cũng ghé quán của mình.",
      "start": 162.04,
      "end": 170.56,
      "n_words": 22,
      "start_frame": 4051,
      "end_frame": 4264,
      "keyframes": [
        "004065.webp",
        "004098.webp",
        "004099.webp",
        "004131.webp",
        "004164.webp",
