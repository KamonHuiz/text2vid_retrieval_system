      ],
      "keyframe_count": 24
    },
    {
      "text": "Giờ là 5 giờ sáng và Như Bình đang có mặt ở phường Bình San, phía trước nhà của chị Hà, chủ quán bún kèn Năm Của.",
      "start": 234.6,
      "end": 241.56,
      "n_words": 27,
      "start_frame": 5865,
      "end_frame": 6039,
      "keyframes": [
        "005956.webp",
