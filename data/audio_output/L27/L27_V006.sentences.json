        "004790.webp"
      ],
      "keyframe_count": 36
    },
    {
      "text": "Như vậy được bà Năm cho phép vào thăm góc bếp của gia đình.",
      "start": 191.64,
      "end": 195.44,
      "n_words": 14,
      "start_frame": 4791,
      "end_frame": 4886,
