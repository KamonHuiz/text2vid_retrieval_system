        "005997.webp",
        "006038.webp",
        "006039.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ thì mình sẽ cùng vào bên trong học cách làm một tô bún kèn thơm ngon đậm vị, biết đâu chừng là Như Bình có thể nấu được một tô bún kèn cực to và hoành tráng. Mời các bạn theo sau. Bây giờ mình đi vô trong nha. - Dạ em chào chị! - Chào em.",
      "start": 241.56,
      "end": 260.08,
      "n_words": 59,
      "start_frame": 6039,
      "end_frame": 6502,
      "keyframes": [
        "006039.webp",
        "006271.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Sáng nay chị mở sớm vậy chị?",
      "start": 260.08,
      "end": 261.88,
      "n_words": 8,
      "start_frame": 6502,
      "end_frame": 6547,
      "keyframes": [
        "006503.webp",
        "006504.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- À, sáng chị nấu là từ 5 giờ đến 6 giờ chị mở cửa nha chị bán rồi. - Nhà chị xào cho em coi ha?",
      "start": 261.88,
      "end": 268.04,
      "n_words": 27,
      "start_frame": 6547,
      "end_frame": 6701,
      "keyframes": [
        "006581.webp",
        "006658.webp",
        "006659.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Dạ cái này là tỏi trước nè ha. - À là mình phi tỏi trước hả chị?",
      "start": 268.04,
      "end": 272.88,
      "n_words": 18,
      "start_frame": 6701,
      "end_frame": 6822,
      "keyframes": [
        "006751.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Phi tỏi trước.",
      "start": 272.88,
      "end": 274.0,
      "n_words": 4,
      "start_frame": 6822,
      "end_frame": 6850,
      "keyframes": [
        "006843.webp",
        "006844.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Tại sao lại gọi là bún kèn?",
      "start": 274.0,
      "end": 275.64,
      "n_words": 8,
      "start_frame": 6850,
      "end_frame": 6891,
      "keyframes": [
        "006869.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Chị để nước dừa dơ, nước dừa sốt này kia đó, à là giống như kèn nước dừa cho nó rút lại vậy đó hả chị.",
      "start": 275.64,
      "end": 282.84,
      "n_words": 27,
      "start_frame": 6891,
      "end_frame": 7071,
      "keyframes": [
        "006895.webp",
        "006896.webp",
        "006929.webp",
        "006963.webp",
        "006964.webp",
        "007016.webp",
        "007068.webp",
        "007069.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cá này mình nấu là cá gì vậy chị?",
      "start": 282.84,
      "end": 284.4,
      "n_words": 9,
      "start_frame": 7071,
      "end_frame": 7110,
      "keyframes": [
        "007098.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cá biển hay là cá hường bạc hay là cá nhâm?",
      "start": 284.4,
      "end": 286.8,
      "n_words": 11,
      "start_frame": 7110,
      "end_frame": 7170,
      "keyframes": [
        "007128.webp",
        "007129.webp",
        "007166.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Cá nhâm nó là nấu ngon nhất, nó béo, nó rất là thơm.",
      "start": 286.8,
      "end": 289.92,
      "n_words": 14,
      "start_frame": 7170,
      "end_frame": 7248,
      "keyframes": [
        "007204.webp",
        "007205.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cá hay là về á là làm ăn ngồi giữa dãy nè, lấy thịt cá sáp nhuyễn này kia là trong đầu nó cũng mấy lần, năm lần nó mới thành sạch.",
      "start": 289.92,
      "end": 299.68,
      "n_words": 32,
      "start_frame": 7248,
      "end_frame": 7492,
      "keyframes": [
        "007274.webp",
        "007343.webp",
        "007344.webp",
        "007435.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cái siêu nhỏ của nó để ra được một tô bún kèn thơm ngon chuẩn vị Hà Tiên á là tất cả những người đầu bếp như này là đều phải thức dậy vào lúc rất là sớm, tầm 3:30, 4:00 sáng rồi, rất là nhiều những cái công đoạn nó cầu kỳ để có thể ra được một tô bún kèn thơm ngon chuẩn vị.",
      "start": 299.68,
      "end": 319.92,
      "n_words": 66,
      "start_frame": 7492,
      "end_frame": 7998,
      "keyframes": [
        "007527.webp",
        "007528.webp",
        "007575.webp",
        "007622.webp",
        "007623.webp",
        "007837.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng là không có nghề gì là đơn giản ha.",
      "start": 319.92,
      "end": 322.56,
      "n_words": 10,
      "start_frame": 7998,
      "end_frame": 8064,
      "keyframes": [
        "008052.webp",
        "008053.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Một nguyên liệu quan trọng không thể thiếu tạo ra một tô bún kèn thơm ngon đó chính là nước chảo dừa và nước cốt dừa.",
      "start": 322.56,
      "end": 330.28,
      "n_words": 26,
      "start_frame": 8064,
      "end_frame": 8257,
      "keyframes": [
        "008147.webp",
        "008241.webp",
        "008242.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ mình sẽ bỏ thêm một vài muỗng nước cốt dừa vào nồi cá đang sôi nha.",
      "start": 330.28,
      "end": 338.48,
      "n_words": 18,
      "start_frame": 8257,
      "end_frame": 8462,
      "keyframes": [
        "008322.webp",
        "008403.webp",
        "008404.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Xuất sắc chưa?",
      "start": 338.48,
      "end": 339.88,
      "n_words": 3,
      "start_frame": 8462,
      "end_frame": 8497,
      "keyframes": [
        "008484.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Biết đâu là sau ngày hôm nay là Như Bình hoàn toàn có thể học được về nhà nấu một nồi ăn ha.",
      "start": 339.88,
      "end": 348.16,
      "n_words": 23,
      "start_frame": 8497,
      "end_frame": 8704,
      "keyframes": [
        "008564.webp",
        "008565.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Trời, em ở tiệm luôn chị!",
      "start": 348.16,
      "end": 350.76,
      "n_words": 7,
      "start_frame": 8704,
      "end_frame": 8769,
      "keyframes": [
        "008712.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Em cứ mở tiệm, em không phải cần tiếc vậy em cứ mở tiệm tự nhiên.",
      "start": 350.76,
      "end": 354.68,
      "n_words": 17,
      "start_frame": 8769,
      "end_frame": 8867,
      "keyframes": [
        "008859.webp",
        "008860.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ mình khuấy đều lên rồi nhớ nhà bắt đầu thấy mình nêm ra vậy nha, mình nêm gia vị vô có mỗi bột ngọt, đường, muối.",
      "start": 354.88,
      "end": 363.28,
      "n_words": 28,
      "start_frame": 8872,
      "end_frame": 9082,
      "keyframes": [
        "008924.webp",
        "008989.webp",
        "008990.webp",
        "009020.webp",
        "009050.webp",
        "009051.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trong cái tô bún kèn là nó sẽ bao gồm những gì chị?",
      "start": 363.28,
      "end": 366.0,
      "n_words": 13,
      "start_frame": 9082,
      "end_frame": 9150,
      "keyframes": [
        "009097.webp",
        "009144.webp",
        "009145.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Bún nè, dưa leo, giá nè, rau thơm nè, tôm khô nè - Tô bún nè nhiều ha.",
      "start": 366.0,
      "end": 373.6,
      "n_words": 19,
      "start_frame": 9150,
      "end_frame": 9340,
      "keyframes": [
        "009164.webp",
        "009184.webp",
        "009185.webp",
        "009207.webp",
        "009230.webp",
        "009231.webp",
        "009256.webp",
        "009282.webp",
        "009283.webp",
        "009302.webp",
        "009322.webp",
        "009323.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Nấu một tô bún kèn thấy nó cũng vất vả mà được cái là nó thơm nha.",
      "start": 373.6,
      "end": 379.84,
      "n_words": 17,
      "start_frame": 9340,
      "end_frame": 9496,
      "keyframes": [
        "009346.webp",
        "009370.webp",
        "009371.webp",
        "009433.webp",
        "009495.webp",
        "009496.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Chút nữa em đổ hạt điều vô cái em quậy lên nó bay thơm nữa.",
      "start": 379.84,
      "end": 383.48,
      "n_words": 16,
      "start_frame": 9496,
      "end_frame": 9587,
      "keyframes": [
        "009496.webp",
        "009540.webp",
        "009585.webp",
        "009586.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "- Cái này là nó chỉ có dầu với lại hạt điều hả chị?",
      "start": 383.48,
      "end": 387.08,
      "n_words": 14,
      "start_frame": 9587,
      "end_frame": 9677,
      "keyframes": [
        "009626.webp",
        "009667.webp",
        "009668.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vậy là màu là hoàn toàn tự nhiên đúng không chị? - Nè đó thấy không, cái nồi nó càng nó rất là đẹp thấy không?",
      "start": 387.08,
      "end": 393.52,
      "n_words": 26,
      "start_frame": 9677,
      "end_frame": 9838,
      "keyframes": [
        "009708.webp",
        "009749.webp",
        "009750.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Wow!",
      "start": 393.52,
      "end": 395.52,
      "n_words": 2,
      "start_frame": 9838,
      "end_frame": 9888,
      "keyframes": [
        "009851.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mùi của nước cốt dừa, mùi của nước điều rồi thêm mùi của sả, mùi của tỏi ớt tất cả nó đều hòa quyện tạo ra một cái mùi rất là riêng của tô bún kèn.",
      "start": 395.52,
      "end": 407.08,
      "n_words": 36,
      "start_frame": 9888,
      "end_frame": 10177,
      "keyframes": [
        "009952.webp",
        "009953.webp",
        "010008.webp",
        "010064.webp",
        "010065.webp",
        "010110.webp",
        "010156.webp",
        "010157.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Tô bún kèn thơm quá mà bây giờ em có được phép kiểu nếm thử không chị?",
      "start": 407.08,
      "end": 411.12,
      "n_words": 17,
      "start_frame": 10177,
      "end_frame": 10278,
      "keyframes": [
        "010190.webp",
        "010223.webp",
        "010224.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Nè em thử nha, em thử em thử coi sao chị. - Em vừa ăn cho em không?",
      "start": 411.12,
      "end": 417.32,
      "n_words": 19,
      "start_frame": 10278,
      "end_frame": 10433,
      "keyframes": [
        "010340.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Dạ vâng cho em xin phép.",
      "start": 417.32,
      "end": 422.32,
      "n_words": 7,
      "start_frame": 10433,
      "end_frame": 10558,
      "keyframes": [
        "010457.webp",
        "010458.webp",
        "010469.webp",
        "010481.webp",
        "010482.webp",
        "010517.webp",
        "010552.webp",
        "010553.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rất là vừa vặn đậm vị chứ không có bị nhạt nha, mà cá nó cũng thơm ngon nữa, thơm thật quá mà trình bày thì cũng hấp dẫn nha.",
      "start": 422.32,
      "end": 447.84,
      "n_words": 30,
      "start_frame": 10558,
      "end_frame": 11196,
      "keyframes": [
        "010683.webp",
        "010814.webp",
        "010815.webp",
        "010843.webp",
        "010871.webp",
        "010872.webp",
        "010889.webp",
        "010907.webp",
        "010908.webp",
        "010926.webp",
        "010945.webp",
        "010946.webp",
        "010985.webp",
        "011024.webp",
        "011025.webp",
        "011102.webp",
        "011179.webp",
        "011180.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Mình sẽ trộn đều nó lên nha.",
      "start": 447.84,
      "end": 455.32,
      "n_words": 7,
      "start_frame": 11196,
      "end_frame": 11383,
      "keyframes": [
        "011220.webp",
        "011261.webp",
        "011262.webp",
        "011319.webp",
        "011377.webp",
        "011378.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần nước bún được hòa trộn lại với nhau cùng với hương vị của sả, tôm khô của cá, nước cốt dừa, tất cả mọi thứ nó hòa quyện với nhau, rất là thơm béo, rất là ngon, ăn nó lạ miệng hay hay thú vị lắm.",
      "start": 455.32,
      "end": 471.92,
      "n_words": 47,
      "start_frame": 11383,
      "end_frame": 11798,
      "keyframes": [
        "011446.webp",
        "011515.webp",
        "011516.webp",
        "011739.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và đúng là tiếng lành đồn xa, mình đã hiểu lý do tại sao mà bún kèn ở Hà Tiên lại nổi tiếng và đắt khách đến như vậy.",
      "start": 471.92,
      "end": 478.88,
      "n_words": 29,
      "start_frame": 11798,
      "end_frame": 11972,
      "keyframes": [
        "011963.webp",
        "011964.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trời ơi, đặc sản Hà Tiên!",
      "start": 478.88,
      "end": 482.08,
      "n_words": 6,
      "start_frame": 11972,
      "end_frame": 12052,
      "keyframes": [
        "012045.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mời cả nhà đã ăn xong một tô rồi nhưng mà Như Bình vẫn cảm thấy là thèm thèm hương vị thơm ngon của tô bún kèn Hà Tiên.",
      "start": 482.08,
      "end": 498.12,
      "n_words": 29,
      "start_frame": 12052,
      "end_frame": 12453,
      "keyframes": [
        "012127.webp",
        "012128.webp",
        "012182.webp",
        "012237.webp",
        "012238.webp",
        "012257.webp",
        "012277.webp",
        "012278.webp",
        "012325.webp",
        "012372.webp",
        "012373.webp",
        "012400.webp",
        "012427.webp",
        "012428.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Và nếu như mà các bạn có dịp đến với Hà Tiên thì hãy ghé thăm và chắc chắn là phải thử qua món đặc sản này của thành phố Hà Tiên nha.",
      "start": 498.12,
      "end": 507.48,
      "n_words": 33,
      "start_frame": 12453,
      "end_frame": 12687,
      "keyframes": [
        "012468.webp",
        "012509.webp",
        "012510.webp",
        "012544.webp",
        "012579.webp",
        "012580.webp",
        "012622.webp",
        "012665.webp",
        "012671.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ở tập tiếp theo, mời các bạn hãy cùng với Như Bình khám phá Mũi Nai, vùng biển cực Tây của Nam Bộ.",
      "start": 507.48,
      "end": 513.72,
      "n_words": 23,
      "start_frame": 12687,
      "end_frame": 12843,
      "keyframes": [
        "012755.webp",
        "012840.webp",
        "012841.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mũi Nai còn có tên gọi là Lộc Trí với một mõm đá có hình dáng như một chú nai nằm nhìn ra biển.",
      "start": 513.72,
      "end": 521.04,
      "n_words": 24,
      "start_frame": 12843,
      "end_frame": 13026,
      "keyframes": [
        "012930.webp",
        "013019.webp",
        "013020.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nơi đây mỗi ngày có rất nhiều thuyền bè, ngư dân ra khơi đánh bắt tôm cá và trở về vào lúc hoàng hôn thơ mộng.",
      "start": 521.04,
      "end": 528.08,
      "n_words": 26,
      "start_frame": 13026,
      "end_frame": 13202,
      "keyframes": [
        "013052.webp",
        "013084.webp",
        "013085.webp",
        "013112.webp",
        "013140.webp",
        "013141.webp",
        "013154.webp",
        "013167.webp",
        "013168.webp",
        "013201.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Biển Mũi Nai Hà Tiên cũng là một trong những bãi biển đẹp của miền Tây Nam Bộ được nhiều du khách yêu thích và tìm về.",
      "start": 528.08,
      "end": 534.76,
      "n_words": 27,
      "start_frame": 13202,
      "end_frame": 13369,
      "keyframes": [
        "013235.webp",
        "013236.webp",
        "013254.webp",
        "013273.webp",
        "013274.webp",
        "013297.webp",
        "013320.webp",
        "013321.webp",
        "013346.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và bây giờ thì Như Bình phải nói lời chào tạm biệt rồi.",
      "start": 534.76,
      "end": 537.2,
      "n_words": 13,
      "start_frame": 13369,
      "end_frame": 13430,
      "keyframes": [
        "013372.webp",
        "013373.webp",
        "013399.webp",
        "013425.webp",
        "013426.webp"
      ],
      "keyframe_count": 5
