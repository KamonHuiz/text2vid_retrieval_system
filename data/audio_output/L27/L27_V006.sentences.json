        "001611.webp",
        "001612.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vì sao lại như vậy?",
      "start": 64.6,
      "end": 65.88,
      "n_words": 5,
      "start_frame": 1615,
      "end_frame": 1647,
      "keyframes": [
        "001634.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vì bún kèn vừa có tên gọi vô cùng độc lạ mà hương vị của nó cũng độc đáo không kém.",
      "start": 65.88,
      "end": 71.72,
      "n_words": 21,
      "start_frame": 1647,
      "end_frame": 1793,
      "keyframes": [
        "001656.webp",
        "001657.webp",
        "001676.webp",
        "001696.webp",
        "001697.webp",
        "001776.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vậy ngày hôm nay, hãy cùng với Như Bình đi trải nghiệm, học cách làm và đặc biệt là thưởng thức món bún kèn vô cùng độc lạ này nhé.",
      "start": 71.72,
      "end": 79.88,
      "n_words": 30,
      "start_frame": 1793,
      "end_frame": 1997,
      "keyframes": [
        "001856.webp",
        "001857.webp",
        "001876.webp",
        "001896.webp",
