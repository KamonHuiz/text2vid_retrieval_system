      "end_frame": 2112,
      "keyframes": [
        "002087.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hà Tiên nằm ở phía tây bắc tỉnh Kiên Giang, cách thành phố Rạch Giá khoảng 80 km.",
      "start": 84.48,
      "end": 88.56,
