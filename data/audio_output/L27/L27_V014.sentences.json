        "004751.webp",
        "004770.webp",
        "004771.webp",
        "004791.webp"
      ],
      "keyframe_count": 22
    },
    {
      "text": "Sau một quãng thời gian đi vòng quanh ở những con đường làng rồi phải leo 2-3 cây cầu thì cuối cùng địa điểm mà Thảo Uyên mong chờ nhất cũng đã đến.",
      "start": 192.4,
      "end": 200.04,
      "n_words": 33,
      "start_frame": 4810,
      "end_frame": 5001,
      "keyframes": [
        "004812.webp",
        "004813.webp",
        "004886.webp",
        "004959.webp",
        "004960.webp",
        "004988.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mọi người có biết địa điểm này là gì không?",
      "start": 200.04,
      "end": 206.52,
      "n_words": 10,
      "start_frame": 5001,
      "end_frame": 5163,
      "keyframes": [
        "005016.webp",
        "005017.webp",
        "005048.webp",
        "005080.webp",
        "005081.webp",
        "005115.webp",
        "005149.webp",
        "005150.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mọi người có nghe tiếng gì không?",
      "start": 206.52,
      "end": 210.08,
      "n_words": 7,
      "start_frame": 5163,
      "end_frame": 5252,
      "keyframes": [
        "005190.webp",
        "005231.webp",
        "005232.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó là tiếng của những chú dê ở phía sau lưng Thảo Uyên đây.",
      "start": 210.08,
      "end": 212.88,
      "n_words": 14,
      "start_frame": 5252,
      "end_frame": 5322,
      "keyframes": [
        "005274.webp",
        "005317.webp",
        "005318.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Uyên đang có mặt ở một trang trại dê ở ấp 2, xã Tân Hòa, huyện Châu Thành A của tỉnh Hậu Giang và Thảo Uyên cũng đã có hẹn với chị chủ ngày hôm nay.",
      "start": 212.88,
      "end": 220.8,
      "n_words": 36,
      "start_frame": 5322,
      "end_frame": 5520,
      "keyframes": [
        "005347.webp",
        "005377.webp",
        "005378.webp",
        "005423.webp",
        "005468.webp",
        "005469.webp",
        "005500.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Mình sẽ đến để khám phá trang trại dê này, không biết là chị đang ở đâu rồi?",
      "start": 220.8,
      "end": 224.48,
      "n_words": 18,
      "start_frame": 5520,
      "end_frame": 5612,
      "keyframes": [
        "005532.webp",
        "005533.webp",
        "005566.webp",
        "005600.webp",
        "005601.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ mình sẽ đi kiếm chị để cùng khám phá nhé. Em chào chị! Chào em, em mới xuống à? Dạ, chị đang cho dê ăn hả?",
      "start": 224.48,
      "end": 233.2,
      "n_words": 28,
      "start_frame": 5612,
      "end_frame": 5830,
      "keyframes": [
        "005655.webp",
        "005710.webp",
        "005711.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chị đang cho dê ăn.",
      "start": 233.2,
      "end": 234.68,
      "n_words": 5,
      "start_frame": 5830,
      "end_frame": 5867,
      "keyframes": [
        "005841.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Giới thiệu với mọi người đây là chị Đào, là chủ của trang trại dê Ngọc Đào.",
      "start": 234.68,
      "end": 238.84,
      "n_words": 17,
      "start_frame": 5867,
      "end_frame": 5971,
      "keyframes": [
        "005971.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và hiện tại thì nông trại của mình đang khoảng là bao nhiêu con dê?",
      "start": 238.84,
      "end": 241.88,
      "n_words": 15,
      "start_frame": 5971,
      "end_frame": 6047,
      "keyframes": [
        "005971.webp",
        "005972.webp",
        "006012.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hiện tại nông trại của chị là khoảng 400 con.",
      "start": 242.32,
      "end": 244.96,
      "n_words": 10,
      "start_frame": 6058,
      "end_frame": 6124,
      "keyframes": [
        "006088.webp",
        "006123.webp",
        "006124.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chị nuôi năm nay 12 năm rồi.",
      "start": 244.96,
      "end": 247.08,
      "n_words": 7,
      "start_frame": 6124,
      "end_frame": 6177,
      "keyframes": [
        "006124.webp",
        "006162.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hồi lúc đầu thì thấy ở đây đồng cỏ rồi nó nhiều bao la rồi lá cây, từ đó mình thấy cái phụ phẩm nông nghiệp nhiều quá mà không có tận dụng được.",
      "start": 247.08,
      "end": 258.4,
      "n_words": 34,
      "start_frame": 6177,
      "end_frame": 6460,
      "keyframes": [
        "006201.webp",
        "006202.webp",
        "006276.webp",
        "006350.webp",
        "006351.webp",
        "006405.webp",
        "006460.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Sản phẩm sữa dê là rất là tốt cho sức khỏe rồi mình thấy vậy rồi thôi mình nuôi dê rồi cho dùng trong gia đình, rồi từ đó thấy tốt rồi mình mới bán ra ngoài, đó mình mới nhân đàn nhiều lên.",
      "start": 258.4,
      "end": 272.36,
      "n_words": 44,
      "start_frame": 6460,
      "end_frame": 6809,
      "keyframes": [
        "006460.webp",
        "006461.webp",
        "006495.webp",
        "006530.webp",
