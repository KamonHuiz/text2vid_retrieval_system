        "001118.webp",
        "001176.webp",
        "001234.webp",
        "001235.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chào các bạn đến với chương trình Việt Nam đi la game.",
      "start": 52.16,
      "end": 57.08,
      "n_words": 12,
      "start_frame": 1304,
      "end_frame": 1427,
      "keyframes": [
        "001325.webp",
        "001416.webp",
        "001417.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thưa các bạn, ngày hôm nay Thảo Uyên xuống một chiếc đò, xuống một chiếc đò mà người miền Tây quen gọi là chiếc vỏ lãi để tìm đến một địa điểm du lịch độc lạ tại huyện Châu Thành A, tỉnh Hậu Giang.",
      "start": 57.08,
      "end": 68.08,
      "n_words": 44,
      "start_frame": 1427,
      "end_frame": 1702,
      "keyframes": [
        "001520.webp",
        "001623.webp",
        "001624.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Địa điểm mà Thảo Uyên đang tìm đến chỉ cách homestay Mường Đình khoảng 5 km.",
      "start": 68.08,
      "end": 72.48,
      "n_words": 16,
      "start_frame": 1702,
      "end_frame": 1812,
      "keyframes": [
        "001722.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Một vùng quê yên bình mà quý khán giả của chương trình Việt Nam đi la ghiền đã biết ở tập phim trước.",
      "start": 73.08,
      "end": 79.76,
      "n_words": 23,
      "start_frame": 1827,
      "end_frame": 1994,
      "keyframes": [
        "001906.webp",
        "001992.webp",
        "001993.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mắt chúng ta là dòng kinh xáng nối đây, được xem là một công trình giao thông thủy lớn đầu tiên ở Nam Bộ có thể so sánh với việc thiết lập đường xe lửa Sài Gòn - Mỹ Tho về đường bộ.",
      "start": 79.76,
      "end": 91.84,
      "n_words": 43,
      "start_frame": 1994,
      "end_frame": 2296,
      "keyframes": [
        "002113.webp",
        "002234.webp",
        "002235.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Kinh Xáng No được khởi công đào từ những năm đầu thế kỷ 20, có chiều dài khoảng 40 km, bắt nguồn từ ngã ba Vầm Sáng, một nhánh lớn của sông Hậu chạy ngang qua huyện Phong Điền, Cần Thơ, Châu Thành, Vị Thanh, Vĩnh Thủy của Hậu Giang trước khi đổ ra sông Cái Lớn, tỉnh Kiên Giang rồi hòa mình ra biển Tây.",
      "start": 91.84,
      "end": 112.2,
      "n_words": 66,
      "start_frame": 2296,
      "end_frame": 2805,
      "keyframes": [
        "002389.webp",
        "002543.webp",
        "002544.webp",
        "002647.webp",
        "002751.webp",
        "002752.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Kinh Xáng No từ xa xưa cho đến ngày nay vẫn được xem là một trong những tuyến đường thủy huyết mạch vận chuyển lúa gạo của miền Tây Nam Bộ.",
      "start": 112.2,
      "end": 123.52,
      "n_words": 31,
      "start_frame": 2805,
      "end_frame": 3088,
      "keyframes": [
        "002815.webp",
        "002879.webp",
        "002880.webp",
        "002966.webp",
        "003053.webp",
        "003057.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Từ kinh Xáng No, chiếc vỏ lãi đưa Thảo Uyên vào một con rạch nhỏ.",
      "start": 123.52,
      "end": 128.64,
      "n_words": 15,
      "start_frame": 3088,
      "end_frame": 3216,
      "keyframes": [
        "003133.webp",
        "003209.webp",
        "003210.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Xứ Ngàn là tên gọi thân thương về vùng đất Hậu Giang trù phú, xứ của ruột đồng, của những vườn trái cây, của những kinh rạch dọc ngang.",
      "start": 128.64,
      "end": 137.24,
      "n_words": 29,
      "start_frame": 3216,
      "end_frame": 3431,
      "keyframes": [
        "003265.webp",
        "003320.webp",
        "003321.webp",
        "003379.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Các con kênh được rẽ thẳng vào các cánh đồng được đặt tên từ 1.000 tới 14.000 rồi thành tên từ đó.",
      "start": 137.24,
      "end": 145.2,
      "n_words": 22,
      "start_frame": 3431,
      "end_frame": 3630,
      "keyframes": [
        "003438.webp",
        "003439.webp",
        "003511.webp",
        "003584.webp",
        "003585.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ngày nay dù có nhiều tuyến đường bộ được hình thành, việc đi lại có phần thuận tiện hơn nhưng với du khách phương xa về thăm đất Hậu Giang, trải nghiệm đường thủy là một điều thú vị.",
      "start": 145.2,
      "end": 156.08,
      "n_words": 39,
      "start_frame": 3630,
      "end_frame": 3902,
      "keyframes": [
        "003643.webp",
        "003701.webp",
        "003702.webp",
        "003789.webp",
        "003876.webp",
        "003877.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ngồi trên vỏ lãi, chúng ta được phóng tầm mắt quan sát những xóm làng hiền hòa mộc mạc bên bờ kênh, những vườn cây ăn trái xanh rì, những chiếc cầu nhỏ bé hiền hòa nối đôi bờ cùng đó là những cơn gió sông thổi mát rượi. Chiếc vỏ lãi đã cập bến.",
      "start": 156.08,
      "end": 176.32,
      "n_words": 55,
      "start_frame": 3902,
      "end_frame": 4408,
      "keyframes": [
        "003946.webp",
        "004015.webp",
        "004016.webp",
        "004070.webp",
        "004125.webp",
        "004126.webp",
        "004170.webp",
        "004214.webp",
        "004215.webp",
        "004276.webp",
        "004338.webp",
        "004339.webp",
        "004340.webp",
        "004342.webp",
        "004343.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Từ đây Thảo Uyên sẽ tự mình cuốc bộ để tìm đến một địa điểm du lịch trải nghiệm độc lạ qua lời giới thiệu của một người bạn tại địa phương.",
      "start": 176.32,
      "end": 192.4,
      "n_words": 32,
      "start_frame": 4408,
      "end_frame": 4810,
      "keyframes": [
        "004413.webp",
        "004484.webp",
        "004485.webp",
        "004514.webp",
        "004543.webp",
        "004544.webp",
        "004580.webp",
        "004617.webp",
        "004618.webp",
        "004642.webp",
        "004666.webp",
        "004667.webp",
        "004685.webp",
        "004703.webp",
        "004704.webp",
        "004718.webp",
        "004732.webp",
