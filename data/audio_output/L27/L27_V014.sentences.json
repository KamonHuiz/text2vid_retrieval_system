        "000880.webp",
        "000913.webp",
        "000914.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Một phút 30 giây là hết một bình, rất là nhiệt tình trong việc bú bình luôn.",
      "start": 36.64,
      "end": 52.16,
      "n_words": 17,
      "start_frame": 916,
