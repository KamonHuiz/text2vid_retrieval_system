        "000779.webp",
        "000812.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nhìn cái cảnh mấy bạn này uống là dễ luôn đúng không các bạn?",
      "start": 33.72,
      "end": 36.64,
      "n_words": 14,
