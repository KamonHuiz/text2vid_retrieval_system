        "001733.webp",
        "001790.webp",
        "001791.webp",
        "001843.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Vậy thì ngày hôm nay hãy cùng theo chân Thảo Uyên chúng ta khám phá Hậu Giang.",
      "start": 75.52,
      "end": 81.32,
      "n_words": 17,
      "start_frame": 1888,
      "end_frame": 2033,
      "keyframes": [
        "001896.webp",
        "001897.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Huyện Châu Thành được xem là cửa ngõ của tỉnh Hậu Giang, nằm cách thành phố Vị Thanh khoảng 25 km, cách thành phố Cần Thơ khoảng 10 km.",
      "start": 81.32,
      "end": 89.2,
      "n_words": 29,
      "start_frame": 2033,
      "end_frame": 2230,
      "keyframes": [
        "002062.webp",
        "002227.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nơi đây bên đôi bờ kinh xáng là những làng quê thôn xóm quanh năm được phủ một màu xanh tươi mát của những vườn cây ăn trái, vườn nối tiếp vườn được bao quanh bởi những con kinh rạch chằng chịt.",
      "start": 90.12,
      "end": 103.12,
      "n_words": 42,
      "start_frame": 2253,
      "end_frame": 2578,
      "keyframes": [
