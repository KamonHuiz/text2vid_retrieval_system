        "004366.webp",
        "004367.webp",
        "004409.webp",
        "004452.webp",
        "004453.webp",
        "004476.webp",
        "004500.webp",
        "004501.webp",
        "004548.webp",
        "004596.webp",
        "004619.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Điểm dừng chân tiếp theo trong hành trình hôm nay, chúng ta đã có mặt tại chân núi Sam.",
      "start": 185.04,
      "end": 188.96,
      "n_words": 19,
      "start_frame": 4626,
      "end_frame": 4724,
      "keyframes": [
        "004676.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bình thường đến đây thì bà con mình sẽ đến viếng miếu Bà Chúa Xứ, rồi sau đó thì mình sẽ có thêm thời gian để tham quan đỉnh núi Sam.",
      "start": 188.96,
      "end": 196.6,
      "n_words": 31,
      "start_frame": 4724,
      "end_frame": 4915,
      "keyframes": [
        "004734.webp",
