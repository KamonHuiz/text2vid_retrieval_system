        "004227.webp",
        "004228.webp",
        "004237.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Rất có thể đây là một trong những hiện vật cổ còn sót lại của nền văn hóa Óc Eo xưa.",
      "start": 169.6,
      "end": 185.04,
      "n_words": 21,
      "start_frame": 4240,
      "end_frame": 4626,
      "keyframes": [
        "004247.webp",
