        "003375.webp",
        "003376.webp",
        "003407.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Thì bà con thường đến để cầu xin cho mưa thuận gió hòa và mùa màng bội thu.",
      "start": 136.64,
      "end": 140.72,
      "n_words": 18,
      "start_frame": 3416,
      "end_frame": 3518,
      "keyframes": [
        "003439.webp",
        "003440.webp",
        "003479.webp",
        "003518.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và ở phía bên trong đây, đó chính là Bà Chúa Xứ với một bức tượng của Bà đặt ở ngay giữa chánh điện rất là lộng lẫy và rất là uy nghi.",
      "start": 140.72,
      "end": 149.68,
      "n_words": 33,
      "start_frame": 3518,
      "end_frame": 3742,
      "keyframes": [
        "003518.webp",
        "003519.webp",
        "003624.webp",
        "003730.webp",
        "003731.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Vào năm 2009 thì tượng Bà đã được ghi vào sách kỷ lục An Giang là bức tượng bằng đá sa thạch xưa nhất Việt Nam và cũng như là có áo phụng cúng nhiều nhất.",
      "start": 149.68,
      "end": 159.44,
      "n_words": 36,
      "start_frame": 3742,
      "end_frame": 3986,
      "keyframes": [
        "003772.webp",
