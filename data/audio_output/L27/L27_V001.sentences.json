        "003234.webp",
        "003261.webp",
        "003262.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Rất là nhiều bà con cùng tới đây, mỗi một năm có thể đón được khoảng từ 5 đến 6 triệu lượt khách tham quan và chiêm bái.",
      "start": 130.56,
      "end": 136.64,
      "n_words": 28,
      "start_frame": 3264,
      "end_frame": 3416,
      "keyframes": [
        "003288.webp",
