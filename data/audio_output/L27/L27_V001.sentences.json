        "002167.webp",
        "002238.webp",
        "002239.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Thì bây giờ các bạn hãy theo Trường chúng ta vào bên trong để cùng viếng nhé các bạn.",
      "start": 89.56,
      "end": 99.08,
      "n_words": 19,
      "start_frame": 2239,
      "end_frame": 2477,
      "keyframes": [
        "002239.webp",
