        "003885.webp",
        "003915.webp",
        "003916.webp",
        "003949.webp",
        "003983.webp",
        "003984.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Còn theo nhà khảo cổ người Pháp tên là Molot nghiên cứu vào năm 1941 thì tượng Bà Chúa Xứ núi Sam được cho là được tạc vào cuối thế kỷ thứ 6.",
      "start": 159.44,
      "end": 169.6,
      "n_words": 33,
      "start_frame": 3986,
      "end_frame": 4240,
      "keyframes": [
        "004004.webp",
        "004024.webp",
