        "006664.webp",
        "006686.webp",
        "006709.webp",
        "006710.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đi có vài phút à, lên tới nơi rồi!",
      "start": 271.32,
      "end": 273.56,
      "n_words": 9,
      "start_frame": 6783,
      "end_frame": 6839,
      "keyframes": [
        "006823.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ mình bắt đầu lên trên đây khám phá cụ thể coi đây có gì ha.",
      "start": 273.56,
      "end": 281.0,
      "n_words": 17,
      "start_frame": 6839,
      "end_frame": 7025,
      "keyframes": [
        "006937.webp",
        "006938.webp",
        "006957.webp",
        "006976.webp",
        "006977.webp",
        "006994.webp",
        "007011.webp",
        "007012.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chào các bạn, Trường đang đứng ở nơi này được gọi là quảng trường trên đỉnh núi Sam.",
      "start": 281.0,
      "end": 286.08,
      "n_words": 18,
      "start_frame": 7025,
      "end_frame": 7152,
      "keyframes": [
        "007051.webp",
        "007091.webp",
        "007092.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Từ đây mình có thể phóng tầm mắt nhìn thấy toàn bộ thành phố Châu Đốc nè mấy bạn ơi.",
      "start": 286.08,
      "end": 290.4,
      "n_words": 20,
      "start_frame": 7152,
      "end_frame": 7260,
      "keyframes": [
        "007163.webp",
        "007234.webp",
        "007235.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nhìn theo hướng của Trường đang chỉ nha, phía bên kia là những cái đồng nước nổi đúng không?",
      "start": 290.4,
      "end": 294.72,
      "n_words": 19,
      "start_frame": 7260,
      "end_frame": 7368,
      "keyframes": [
        "007277.webp",
        "007319.webp",
        "007320.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dọc theo khu vực nhà dân đang sinh sống đó là con kênh đào Vĩnh Tế.",
      "start": 294.72,
      "end": 298.56,
      "n_words": 16,
      "start_frame": 7368,
      "end_frame": 7464,
      "keyframes": [
        "007378.webp",
        "007436.webp",
        "007437.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đây là kênh đào danh tướng Hoàng Ngọc Hầu đã chỉ huy đào khoảng hơn 200 năm trước.",
      "start": 298.56,
      "end": 303.12,
      "n_words": 18,
      "start_frame": 7464,
      "end_frame": 7578,
      "keyframes": [
        "007506.webp",
        "007576.webp",
        "007577.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngoài cái việc là thông thương rồi giao thông về đường thủy, đây còn được xem như là một đường biên giới giữa Việt Nam chúng ta và nước bạn Campuchia.",
      "start": 303.12,
      "end": 312.72,
      "n_words": 31,
      "start_frame": 7578,
      "end_frame": 7818,
      "keyframes": [
        "007635.webp",
        "007693.webp",
        "007694.webp",
        "007726.webp",
        "007758.webp",
        "007759.webp",
        "007799.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rồi còn hướng này, hướng tây Trường đang chỉ nè, đây là trục đường chính dài khoảng 6 km tên là Tân Lộ Kiều Lương.",
      "start": 312.72,
      "end": 319.4,
      "n_words": 25,
      "start_frame": 7818,
      "end_frame": 7985,
      "keyframes": [
        "007840.webp",
        "007841.webp",
        "007892.webp",
        "007944.webp",
        "007945.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đây là trục đường nối từ trung tâm thành phố Châu Đốc đến chân núi Sam.",
      "start": 319.4,
      "end": 323.48,
      "n_words": 16,
      "start_frame": 7985,
      "end_frame": 8087,
      "keyframes": [
        "008016.webp",
        "008087.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Sau lưng tôi đây là bệ đá sa thạch ở đỉnh núi Sam.",
      "start": 323.48,
      "end": 326.72,
      "n_words": 13,
      "start_frame": 8087,
      "end_frame": 8168,
      "keyframes": [
        "008087.webp",
        "008088.webp",
        "008117.webp",
        "008147.webp",
        "008148.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Là hơn 200 năm trước đã tìm thấy tượng của Bà, thì sau đó thì người dân mới xin để thỉnh Bà xuống và lập miếu thờ mà nơi mà chúng ta đã có dịp để mà đến và chiêm bái.",
      "start": 326.72,
      "end": 339.24,
      "n_words": 41,
      "start_frame": 8168,
      "end_frame": 8481,
      "keyframes": [
        "008197.webp",
        "008247.webp",
        "008248.webp",
        "008325.webp",
        "008402.webp",
        "008403.webp",
        "008452.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Thì đây là một trong những dấu tích rất là đặc biệt mà bà con đến đây thường sẽ ghé thăm để chiêm bái.",
      "start": 339.24,
      "end": 348.0,
      "n_words": 24,
      "start_frame": 8481,
      "end_frame": 8700,
      "keyframes": [
        "008502.webp",
        "008503.webp",
        "008540.webp",
        "008578.webp",
        "008579.webp",
        "008625.webp",
        "008671.webp",
        "008672.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Các bạn thân mến, ẩm thực của miền Tây Nam Bộ nói chung và ẩm thực của An Giang nói riêng có rất là nhiều những cái điều đặc trưng và thú vị.",
      "start": 348.0,
      "end": 355.48,
      "n_words": 33,
      "start_frame": 8700,
      "end_frame": 8887,
      "keyframes": [
        "008781.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mà ngày hôm nay Trường tự đặt cho mình một cái thử thách đó chính là sẽ tìm kiếm để xem các bạn của chúng ta đi ăn quán nào ngon rồi chia sẻ trên mạng ra, cái Trường đi thử coi thế nào.",
      "start": 355.48,
      "end": 365.04,
      "n_words": 44,
      "start_frame": 8887,
      "end_frame": 9126,
      "keyframes": [
        "008891.webp",
        "008892.webp",
        "009062.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì hôm nay Trường đã tìm được một địa chỉ có cái tên rất là lạ đó chính là Cơm niêu Ông Địa.",
      "start": 365.04,
      "end": 370.84,
      "n_words": 23,
      "start_frame": 9126,
      "end_frame": 9271,
      "keyframes": [
        "009232.webp",
        "009233.webp",
        "009252.webp",
        "009271.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ghé vô thử nhé!",
      "start": 370.84,
      "end": 374.72,
      "n_words": 4,
      "start_frame": 9271,
      "end_frame": 9368,
      "keyframes": [
        "009271.webp",
        "009272.webp",
        "009319.webp",
        "009366.webp",
        "009367.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "\"Con đang đi quay chương trình Việt Nam đi là ghiền với mấy bạn khán giả coi đài nè.\"",
      "start": 374.72,
      "end": 379.76,
      "n_words": 19,
      "start_frame": 9368,
      "end_frame": 9494,
      "keyframes": [
        "009400.webp",
        "009433.webp",
        "009434.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thú thật là con muốn mời chú qua để giới thiệu cho mấy bạn về ẩm thực của quán mình, nhất là những cái món đặc sản miền sông nước ngay mùa nước nổi nè.",
      "start": 379.76,
      "end": 389.76,
      "n_words": 35,
      "start_frame": 9494,
      "end_frame": 9744,
      "keyframes": [
        "009586.webp",
        "009738.webp",
        "009739.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ chú Hoàng giới thiệu với chị Trường nha.\"",
      "start": 389.76,
      "end": 391.6,
      "n_words": 10,
      "start_frame": 9744,
      "end_frame": 9790,
      "keyframes": [
        "009779.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "\"Đây là cái món khai vị, chả giò tam giác.",
      "start": 391.6,
      "end": 394.24,
      "n_words": 10,
      "start_frame": 9790,
      "end_frame": 9856,
      "keyframes": [
        "009820.webp",
        "009821.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chả giò dễ thương không mấy bạn?",
      "start": 394.24,
      "end": 397.76,
      "n_words": 7,
      "start_frame": 9856,
      "end_frame": 9944,
      "keyframes": [
        "009861.webp",
        "009901.webp",
        "009902.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dễ thương mà ngon ha.",
      "start": 397.76,
      "end": 405.24,
      "n_words": 5,
      "start_frame": 9944,
      "end_frame": 10131,
      "keyframes": [
        "009977.webp",
        "010052.webp",
        "010053.webp",
        "010090.webp",
        "010128.webp",
        "010129.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đây là món cá linh chiên bột mùa nước nổi đây các bạn ơi, cá linh nè, thấy chưa?",
      "start": 405.24,
      "end": 412.96,
      "n_words": 19,
      "start_frame": 10131,
      "end_frame": 10324,
      "keyframes": [
        "010166.webp",
        "010204.webp",
        "010205.webp",
        "010232.webp",
        "010260.webp",
        "010261.webp",
        "010281.webp",
        "010301.webp",
        "010302.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hấp dẫn chứ nào!\"",
      "start": 412.96,
      "end": 417.52,
      "n_words": 4,
      "start_frame": 10324,
      "end_frame": 10438,
      "keyframes": [
        "010329.webp",
        "010357.webp",
        "010358.webp",
        "010389.webp",
        "010421.webp",
        "010422.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "\"Cá linh nha, đây là con cá heo nghe, cá heo là con cũng giật mình.",
      "start": 417.52,
      "end": 423.64,
      "n_words": 16,
      "start_frame": 10438,
      "end_frame": 10591,
      "keyframes": [
        "010462.webp",
        "010503.webp",
        "010504.webp",
        "010529.webp",
        "010555.webp",
        "010556.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ủa sao con tên cá linh là gì đây?",
      "start": 423.64,
      "end": 425.92,
      "n_words": 9,
      "start_frame": 10591,
      "end_frame": 10648,
      "keyframes": [
        "010616.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cá linh kho tộ đấy!",
      "start": 425.92,
      "end": 428.16,
      "n_words": 5,
      "start_frame": 10648,
      "end_frame": 10704,
      "keyframes": [
        "010677.webp",
        "010678.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cá linh mình trơn không vậy?",
      "start": 428.16,
      "end": 430.92,
      "n_words": 6,
      "start_frame": 10704,
      "end_frame": 10773,
      "keyframes": [
        "010753.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nó giống như là cá da trơn của đồng bằng sông Cửu Long.\"",
      "start": 430.92,
      "end": 433.44,
      "n_words": 13,
      "start_frame": 10773,
      "end_frame": 10836,
      "keyframes": [
        "010829.webp",
        "010830.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Con cá này là một những con cá đặc biệt và đặc sản rất là quý hiếm của đồng bằng sông Cửu Long mà bây giờ không còn nhiều nữa.",
      "start": 433.44,
      "end": 445.16,
      "n_words": 30,
      "start_frame": 10836,
      "end_frame": 11129,
      "keyframes": [
        "010929.webp",
        "011029.webp",
        "011030.webp",
        "011071.webp",
        "011113.webp",
        "011114.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đây lần đầu tiên được ăn con cá heo này, nó ngon thiệt rồi nha, cái thịt nó béo ha, cái da đó, cái da nó mới ngon nha, nó mới đặc biệt á.",
      "start": 445.16,
      "end": 452.8,
      "n_words": 34,
      "start_frame": 11129,
      "end_frame": 11320,
      "keyframes": [
        "011154.webp",
        "011195.webp",
        "011196.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi có trứng nữa trời ơi, nó mùi bùi ăn với gạo ngon quá trời!\"",
      "start": 452.8,
      "end": 458.28,
      "n_words": 15,
      "start_frame": 11320,
      "end_frame": 11457,
      "keyframes": [
        "011326.webp",
        "011457.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ mình qua thưởng thức món tiếp theo đó chính là món riêng biển tép.",
      "start": 458.28,
      "end": 461.64,
      "n_words": 16,
      "start_frame": 11457,
      "end_frame": 11541,
      "keyframes": [
        "011457.webp",
        "011458.webp",
        "011514.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bạn ơi, nếu mình tính ra nguyên liệu của nó rất đơn giản: giá, hành, đúng rồi, tép đâu cũng có hết trơn, kết hợp bông điên điển nữa thì mình ăn vô mình múc một muỗng là đầy luôn đó.",
      "start": 461.84,
      "end": 478.0,
      "n_words": 41,
      "start_frame": 11546,
      "end_frame": 11950,
      "keyframes": [
        "011570.webp",
        "011571.webp",
        "011631.webp",
        "011691.webp",
        "011692.webp",
        "011764.webp",
        "011836.webp",
        "011837.webp",
        "011888.webp",
        "011939.webp",
        "011940.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Mình ăn lần như vậy á, cái vị nó trộn lại nó mới ngon.",
      "start": 478.0,
      "end": 480.88,
      "n_words": 14,
      "start_frame": 11950,
      "end_frame": 12022,
      "keyframes": [
        "011980.webp",
        "012020.webp",
        "012021.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi bây giờ mình coi như là thưởng thức qua món tép xào, giờ qua món chính nè: đây, canh chua bông súng, bông điên điển, cá linh.",
      "start": 480.88,
      "end": 489.32,
      "n_words": 28,
      "start_frame": 12022,
      "end_frame": 12233,
      "keyframes": [
        "012066.webp",
        "012112.webp",
        "012113.webp",
        "012145.webp",
        "012177.webp",
        "012178.webp",
        "012208.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Không múc đại giá đầy ha, có nhiều lấy nhiều nha cá linh nè mấy bạn.",
      "start": 489.32,
      "end": 504.6,
      "n_words": 16,
      "start_frame": 12233,
      "end_frame": 12615,
      "keyframes": [
        "012238.webp",
        "012239.webp",
        "012316.webp",
        "012393.webp",
        "012394.webp",
        "012428.webp",
        "012463.webp",
        "012464.webp",
        "012535.webp",
        "012606.webp",
        "012607.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Mà hay dữ, các bạn nấu cái nồi lẩu á mà nó vừa chua là có nè, có cái đồ ngọt, có cái đồ cay, vừa có cái đồ mà nó vẫn nhận nước đắng, trộn lên bà con mình thiệt sự là hay ghê luôn á trời!",
      "start": 504.84,
      "end": 516.08,
      "n_words": 48,
      "start_frame": 12621,
      "end_frame": 12902,
      "keyframes": [
        "012659.webp",
        "012712.webp",
        "012713.webp",
        "012764.webp",
        "012815.webp",
        "012816.webp",
        "012885.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Hướng dẫn miền Tây mà con nói thiệt là hôm nay con chỉ định là mời chú giới thiệu sơ sơ thôi mà con không ngờ á là nhờ có chú ra, có chú ra vậy đó mà mới hiểu được nhiều thứ.",
      "start": 516.08,
      "end": 525.96,
      "n_words": 43,
      "start_frame": 12902,
      "end_frame": 13149,
      "keyframes": [
        "012955.webp",
        "012956.webp",
        "013005.webp",
        "013055.webp",
        "013056.webp",
        "013101.webp",
        "013147.webp",
        "013148.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đều là những cái sản vật của quê hương mùa nước nổi thì thôi thì thấy ấm lòng quá, giống như là hết miếng lẩu vậy đó, đủ vị hết nhưng mà nó ấm áp.",
      "start": 525.96,
      "end": 534.88,
      "n_words": 35,
      "start_frame": 13149,
      "end_frame": 13372,
      "keyframes": [
        "013179.webp",
        "013210.webp",
        "013211.webp",
        "013253.webp",
        "013296.webp",
        "013297.webp",
        "013346.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Con cảm ơn chú rất là nhiều.",
      "start": 534.88,
      "end": 535.96,
      "n_words": 7,
      "start_frame": 13372,
      "end_frame": 13399,
      "keyframes": [
        "013396.webp",
        "013397.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "\"Cảm ơn Trường đã lên đây và thưởng thức những bữa cơm đạm bạc của gia đình của nhà hàng Ông Địa.\"",
      "start": 535.96,
      "end": 542.76,
      "n_words": 22,
      "start_frame": 13399,
      "end_frame": 13569,
      "keyframes": [
        "013477.webp",
        "013557.webp",
        "013565.webp",
        "013566.webp",
        "013567.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ngày hôm nay mình đã có một hành trình trải nghiệm cũng đa dạng đúng không nào?",
      "start": 542.76,
      "end": 546.4,
