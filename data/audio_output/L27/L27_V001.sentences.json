        "002831.webp",
        "002858.webp",
        "002859.webp",
        "002889.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trường đang đứng ở ngay chánh điện của miếu Bà thì theo quan sát của Trường là bà con mình đến đây để viếng rồi tỏ lòng biết ơn thì rất là đông luôn, và những đợt cao điểm thì sẽ còn đông hơn nữa.",
      "start": 116.72,
      "end": 130.56,
      "n_words": 45,
      "start_frame": 2918,
      "end_frame": 3264,
      "keyframes": [
        "002919.webp",
        "002920.webp",
        "002966.webp",
