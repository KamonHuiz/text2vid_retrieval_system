        "004848.webp",
        "004849.webp",
        "004882.webp",
        "004915.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Thường thì mình sẽ đi theo các cách như là đi bộ nè hoặc là đi xe máy cũng được, nhưng mà 3 năm trở lại đây thì có tuyến cáp treo này.",
      "start": 196.6,
      "end": 204.52,
      "n_words": 33,
      "start_frame": 4915,
      "end_frame": 5113,
      "keyframes": [
        "004915.webp",
        "004916.webp",
        "004968.webp",
        "005020.webp",
        "005021.webp",
        "005065.webp",
        "005110.webp",
        "005111.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đây là một trong những sự lựa chọn Trường nghĩ là rất là thú vị, sẽ giúp chúng ta sẽ có thêm một cái góc nhìn từ trên cao, phóng tầm mắt quan sát cảnh vật xung quanh để có thêm những cái khoảng thời gian thư giãn và ngắm cảnh thật là đẹp.",
      "start": 204.52,
      "end": 215.48,
      "n_words": 54,
      "start_frame": 5113,
      "end_frame": 5387,
      "keyframes": [
        "005209.webp",
        "005308.webp",
        "005309.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nên là ngày hôm nay Trường sẽ cùng với tất cả các bạn đi cáp treo nha.",
      "start": 215.48,
      "end": 224.32,
      "n_words": 17,
      "start_frame": 5387,
      "end_frame": 5608,
      "keyframes": [
        "005410.webp",
        "005512.webp",
        "005513.webp",
        "005556.webp",
        "005599.webp",
        "005600.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đây là cáp treo nha, bây giờ mình sẽ lên cáp treo để di chuyển lên đỉnh núi Sam.",
      "start": 224.32,
      "end": 233.08,
      "n_words": 19,
      "start_frame": 5608,
      "end_frame": 5827,
      "keyframes": [
        "005665.webp",
        "005730.webp",
        "005731.webp",
        "005801.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trường đang trên cabin của cáp treo nè, các bạn mua một vé vậy là 90.000, cái này là giá khuyến mãi nha.",
      "start": 233.08,
      "end": 239.24,
      "n_words": 23,
      "start_frame": 5827,
      "end_frame": 5981,
      "keyframes": [
        "005872.webp",
        "005873.webp",
        "005922.webp",
        "005971.webp",
        "005972.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Như cái giá vé này là vé hai chiều, tức là đi lên xong rồi đi xuống luôn thì sẽ được tặng kèm thêm là một suất ăn trưa nữa.",
      "start": 239.24,
      "end": 246.8,
      "n_words": 30,
      "start_frame": 5981,
      "end_frame": 6170,
      "keyframes": [
        "006004.webp",
        "006036.webp",
        "006037.webp",
        "006071.webp",
        "006106.webp",
        "006107.webp",
        "006133.webp",
        "006160.webp",
        "006161.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đây mình có thể nhìn được toàn cảnh của núi Sam Châu Đốc.",
      "start": 246.8,
      "end": 251.28,
      "n_words": 13,
      "start_frame": 6170,
      "end_frame": 6282,
      "keyframes": [
        "006223.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bên này là mình nhìn thấy được những cánh đồng vô mùa nước nổi rồi nè, đó, xa xa nha các bạn.",
      "start": 251.28,
      "end": 256.6,
      "n_words": 22,
      "start_frame": 6282,
      "end_frame": 6415,
      "keyframes": [
        "006286.webp",
        "006287.webp",
        "006323.webp",
        "006360.webp",
        "006361.webp",
        "006391.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trường nghĩ là mấy bạn trải nghiệm thử lần đi mình đi bộ có cái thú riêng của đi bộ, mà lên trên cáp treo mình được nhìn thấy mọi thứ ở trên cao xuống, Trường bảo đảm là đã lắm á.",
      "start": 256.6,
      "end": 270.36,
      "n_words": 42,
      "start_frame": 6415,
      "end_frame": 6759,
      "keyframes": [
        "006421.webp",
        "006422.webp",
        "006493.webp",
        "006565.webp",
        "006566.webp",
