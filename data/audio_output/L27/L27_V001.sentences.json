        "002391.webp",
        "002404.webp",
        "002405.webp",
        "002436.webp",
        "002467.webp",
        "002468.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Ơi Trường đã vào bên trong miếu Bà, mình đang đứng ở khu vực sân bên ngoài thôi thì Trường cảm nhận được là về kiến trúc nhìn từ trên cao xuống thì các tầng tháp tựa như là một đóa sen vậy đó.",
      "start": 99.08,
      "end": 110.12,
      "n_words": 44,
      "start_frame": 2477,
      "end_frame": 2753,
      "keyframes": [
        "002503.webp",
        "002539.webp",
        "002540.webp",
        "002597.webp",
        "002654.webp",
        "002655.webp",
        "002703.webp",
        "002752.webp",
        "002753.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi phần mái cũng vậy, mang cái màu sắc nó rất là gần gũi với văn hóa Nam Bộ của mình.",
      "start": 110.12,
      "end": 116.72,
      "n_words": 21,
      "start_frame": 2753,
      "end_frame": 2918,
      "keyframes": [
        "002753.webp",
