        "000395.webp",
        "000403.webp",
        "000436.webp"
      ],
      "keyframe_count": 24
    },
    {
      "text": "Ta đi đây, lúc này quả tuyệt vời! Xin chào, xin chào các bạn khán giả của \"Việt Nam đi là ghiền\".",
      "start": 17.88,
      "end": 53.44,
      "n_words": 22,
