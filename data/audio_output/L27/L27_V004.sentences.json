        "007235.webp",
        "007236.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Biết sao không? Phải bàn view này là không phải - Trời ơi đẹp quá anh ơi!",
      "start": 294.52,
      "end": 298.8,
      "n_words": 17,
