      "start_frame": 8975,
      "end_frame": 9154,
      "keyframes": [
        "009000.webp",
        "009031.webp",
        "009032.webp",
        "009068.webp",
        "009105.webp",
        "009106.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Sao ghê, anh Tâm thấy không bơ sầu mà không?",
      "start": 366.16,
      "end": 371.16,
      "n_words": 11,
      "start_frame": 9154,
