        "000276.webp",
        "000282.webp",
        "000283.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đi từ đây ta biết thêm và học hỏi thêm điều mới về phong tục văn hóa, ẩm thực Việt Nam.",
      "start": 11.44,
      "end": 17.88,
      "n_words": 21,
      "start_frame": 286,
      "end_frame": 447,
