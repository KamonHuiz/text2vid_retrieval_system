      "keyframes": [
        "009543.webp",
        "009544.webp",
        "009576.webp",
        "009608.webp",
        "009609.webp",
        "009657.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Ủa mà anh là nó chín rồi nó rụng hay là nó chín đó rồi rụng?",
      "start": 388.0,
      "end": 390.84,
      "n_words": 17,
      "start_frame": 9700,
      "end_frame": 9771,
      "keyframes": [
        "009705.webp",
        "009706.webp",
        "009739.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Chín là rụng luôn đó nha, ăn đó, dạ thử mời các bạn nha. Các bạn thấy không, đi trekking với anh Việt Anh quá tuyệt vời.",
      "start": 390.84,
