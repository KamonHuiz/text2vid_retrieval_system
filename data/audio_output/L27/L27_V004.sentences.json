        "001180.webp",
        "001238.webp",
        "001239.webp"
      ],
      "keyframe_count": 45
    },
    {
      "text": "Đã lâu lắm rồi thì Nhật Trường mới được đồng hành cùng với tất cả các bạn.",
      "start": 53.44,
      "end": 56.52,
      "n_words": 17,
      "start_frame": 1336,
      "end_frame": 1413,
      "keyframes": [
        "001391.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Sau khi mà chúng ta chia tay với mảnh đất Hà Tiên, ngày hôm nay, Trường sẽ cùng với các bạn đi khám phá một địa điểm được mệnh danh là nóc nhà của khu vực đồng bằng sông Cửu Long, đó chính là Thiên Cấm Sơn, hay còn gọi là núi Cấm.",
      "start": 56.72,
      "end": 69.52,
      "n_words": 53,
      "start_frame": 1418,
      "end_frame": 1738,
      "keyframes": [
        "001543.webp",
        "001544.webp",
        "001642.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trường đang đứng đây là ở chân của núi Cấm, mà mọi người có thể quan sát xung quanh là những cây thốt nốt, một loại đặc sản của vùng đất An Giang rồi, có những cánh đồng rất là mênh mông.",
      "start": 69.52,
      "end": 78.44,
      "n_words": 42,
      "start_frame": 1738,
      "end_frame": 1961,
      "keyframes": [
        "001740.webp",
        "001741.webp",
        "001818.webp",
        "001895.webp",
        "001896.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nên là ngay bây giờ đây, chúng ta sẽ cùng gặp gỡ với khách mời là người sẽ dẫn Nhật Trường đi tham quan trong hành trình của ngày hôm nay.",
      "start": 78.44,
      "end": 85.16,
      "n_words": 31,
      "start_frame": 1961,
      "end_frame": 2129,
      "keyframes": [
        "001965.webp",
        "002034.webp",
        "002035.webp",
        "002110.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Xin được giới thiệu, đó chính là anh Việt Anh, anh đang công tác tại Ban quản lý của khu du lịch núi Cấm. - Em chào anh! - Chào em. - Hôm nay chúng ta sẽ cùng nhau đi trekking nha? - Ồ trekking đúng rồi.",
      "start": 85.16,
      "end": 96.64,
      "n_words": 47,
      "start_frame": 2129,
      "end_frame": 2416,
      "keyframes": [
        "002186.webp",
        "002187.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Con đường trekking của chúng ta là băng qua cánh đồng thốt nốt lên suối Thanh Long và chinh phục đỉnh Bồ Hồng. Bạn đã sẵn sàng chưa? - Dạ, đây rồi, tiến hành theo anh.",
      "start": 96.64,
      "end": 106.76,
      "n_words": 36,
      "start_frame": 2416,
      "end_frame": 2669,
      "keyframes": [
        "002473.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tôi là công đoạn chuẩn bị cho vụ mới, cào đất cho nó bằng ra.",
      "start": 106.76,
      "end": 120.16,
      "n_words": 15,
      "start_frame": 2669,
      "end_frame": 3004,
      "keyframes": [
        "002759.webp",
        "002760.webp",
        "002812.webp",
        "002864.webp",
        "002865.webp",
        "002946.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Năm mình làm mấy vụ lận ở đây là làm, chỉ có một hồ duy nhất thôi, khi mà mưa xuống là người dân mới bắt đầu tát đất để mà trồng lúa.",
      "start": 120.16,
      "end": 134.08,
      "n_words": 33,
      "start_frame": 3004,
      "end_frame": 3352,
      "keyframes": [
        "003028.webp",
        "003029.webp",
        "003059.webp",
        "003090.webp",
        "003091.webp",
        "003140.webp",
        "003190.webp",
        "003191.webp",
        "003243.webp",
        "003296.webp",
        "003297.webp",
        "003350.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "- Ủa sao tự nhiên đây có cái giếng gì anh?",
      "start": 134.08,
      "end": 136.28,
      "n_words": 11,
      "start_frame": 3352,
      "end_frame": 3407,
      "keyframes": [
        "003403.webp",
        "003404.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Đây là cái giếng cổ của người Khmer.",
      "start": 136.28,
      "end": 138.08,
      "n_words": 9,
      "start_frame": 3407,
      "end_frame": 3452,
      "keyframes": [
        "003434.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em thấy không mọi người, tuy là làm lại cái mặt bằng ở trên nhưng mà vẫn giữ lại cái dòng chữ cổ của người Khmer để ở cái giếng này.",
      "start": 138.08,
      "end": 146.84,
      "n_words": 31,
      "start_frame": 3452,
      "end_frame": 3671,
      "keyframes": [
        "003464.webp",
        "003465.webp",
        "003517.webp",
        "003569.webp",
        "003570.webp",
        "003619.webp",
        "003668.webp",
        "003669.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Giếng này là để cho bà con sinh hoạt, nấu nướng đồ ăn rồi các thứ sinh hoạt trong gia đình.",
      "start": 146.84,
      "end": 153.16,
      "n_words": 21,
      "start_frame": 3671,
      "end_frame": 3829,
      "keyframes": [
        "003745.webp",
        "003822.webp",
        "003823.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Ôi, rửa mặt một cái cho nó mát nè nha.",
      "start": 153.16,
      "end": 159.36,
      "n_words": 11,
      "start_frame": 3829,
      "end_frame": 3984,
      "keyframes": [
        "003906.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Có dịp xuống đây là phải ghé trạm tiếp nước nha các bạn nha.",
      "start": 159.36,
      "end": 162.64,
      "n_words": 14,
      "start_frame": 3984,
      "end_frame": 4066,
      "keyframes": [
        "003990.webp",
        "003991.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi thôi được rồi, vô đây thôi, mình để lại hồi nữa ai muốn dùng anh hả? Rồi thì giờ đi tiếp anh ơi.",
      "start": 162.64,
      "end": 170.76,
      "n_words": 24,
      "start_frame": 4066,
      "end_frame": 4269,
      "keyframes": [
        "004162.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đi thôi đi các bạn ơi! - Mệt chưa? - Hơi hơi.",
      "start": 170.76,
      "end": 175.32,
      "n_words": 12,
      "start_frame": 4269,
      "end_frame": 4383,
      "keyframes": [
        "004333.webp",
        "004338.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Rồi bây giờ ở chỗ đó là mình mới có cánh đồng bằng thôi, giờ chưa có bước lên đâu.",
      "start": 175.32,
      "end": 180.76,
      "n_words": 21,
      "start_frame": 4383,
      "end_frame": 4519,
      "keyframes": [
        "004440.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ mình mới bắt đầu mình chinh phục nè.",
      "start": 180.76,
      "end": 183.84,
      "n_words": 10,
      "start_frame": 4519,
      "end_frame": 4596,
      "keyframes": [
        "004543.webp",
        "004544.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đi cẩn thận nha, đá nhọn đó.",
      "start": 183.84,
      "end": 185.8,
      "n_words": 7,
      "start_frame": 4596,
      "end_frame": 4645,
      "keyframes": [
        "004601.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Dạ dạ.",
      "start": 185.8,
      "end": 186.6,
      "n_words": 3,
      "start_frame": 4645,
      "end_frame": 4665,
      "keyframes": [
        "004659.webp",
        "004660.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Thấy chỗ này nó sẽ hơi trơn nên là mình phải lựa mấy cái dải nào mà chuyên dụng xíu.",
      "start": 186.6,
      "end": 190.84,
      "n_words": 21,
      "start_frame": 4665,
      "end_frame": 4771,
      "keyframes": [
        "004717.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đi mà đi phải chắc từng bước, từng bước một đi.",
      "start": 190.84,
      "end": 200.96,
      "n_words": 11,
      "start_frame": 4771,
      "end_frame": 5024,
      "keyframes": [
        "004774.webp",
        "004775.webp",
        "004800.webp",
        "004826.webp",
        "004827.webp",
        "004919.webp",
        "005011.webp",
        "005012.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Nó hơi mệt nhưng mà mát, trời không khí đã lắm.",
      "start": 200.96,
      "end": 212.88,
      "n_words": 11,
      "start_frame": 5024,
      "end_frame": 5322,
      "keyframes": [
        "005056.webp",
        "005101.webp",
        "005102.webp",
        "005134.webp",
        "005167.webp",
        "005168.webp",
        "005192.webp",
        "005217.webp",
        "005218.webp",
        "005268.webp",
        "005319.webp",
        "005320.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Tới điểm đến đầu tiên, một con suối rất đẹp.",
      "start": 212.88,
      "end": 215.76,
      "n_words": 10,
      "start_frame": 5322,
      "end_frame": 5394,
      "keyframes": [
        "005359.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Suối này là suối Thanh Long. - Dạ.",
      "start": 215.76,
      "end": 217.68,
      "n_words": 8,
      "start_frame": 5394,
      "end_frame": 5442,
      "keyframes": [
        "005399.webp",
        "005400.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Đây là ngọn suối dài nhất của An Giang với chiều dài là 4.25 km và cao trung bình so với mặt nước biển là 250 mét.",
      "start": 217.68,
      "end": 228.88,
      "n_words": 28,
      "start_frame": 5442,
      "end_frame": 5722,
      "keyframes": [
        "005497.webp",
        "005595.webp",
        "005596.webp",
        "005643.webp",
        "005690.webp",
        "005691.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Ôi, nước rất là mát nha, mát lạnh luôn, á nước trong vắt luôn, quá tuyệt vời!",
      "start": 228.88,
      "end": 241.4,
      "n_words": 18,
      "start_frame": 5722,
      "end_frame": 6035,
      "keyframes": [
        "005725.webp",
        "005759.webp",
        "005760.webp",
        "005804.webp",
        "005849.webp",
        "005850.webp",
        "005931.webp",
        "006012.webp",
        "006013.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ở đây bà con địa phương hay gọi ở đây có hai cái tên.",
      "start": 241.4,
      "end": 245.52,
      "n_words": 14,
      "start_frame": 6035,
      "end_frame": 6138,
      "keyframes": [
        "006055.webp",
        "006098.webp",
        "006099.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Một khu vực này là người ta gọi là thác cây chôm chôm, vì ở đây có cây chôm chôm nó mọc từ xưa tới đây nè.",
      "start": 245.52,
      "end": 252.24,
      "n_words": 27,
      "start_frame": 6138,
      "end_frame": 6306,
      "keyframes": [
        "006147.webp",
        "006195.webp",
        "006196.webp",
        "006250.webp",
        "006305.webp",
        "006306.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ồ, quá trời trái luôn kìa, mà đang chưa vô mùa, xanh xanh.",
      "start": 252.24,
      "end": 256.4,
      "n_words": 13,
      "start_frame": 6306,
      "end_frame": 6410,
      "keyframes": [
        "006306.webp",
        "006339.webp",
        "006373.webp",
        "006374.webp",
        "006400.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Còn cái tên nữa là thác Cửa Núi. - Thác Cửa Núi hả?",
      "start": 256.4,
      "end": 260.32,
      "n_words": 13,
      "start_frame": 6410,
      "end_frame": 6508,
      "keyframes": [
        "006426.webp",
        "006427.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Thì tại ở đây khu vực này là cái cửa núi. - Em hiểu rồi, em hiểu rồi.",
      "start": 260.32,
      "end": 264.32,
      "n_words": 19,
      "start_frame": 6508,
      "end_frame": 6608,
      "keyframes": [
        "006571.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vậy là nếu mà mấy bạn mà lâu lâu mà muốn check-in thì không nói gì, còn lỡ mà muốn đi tới đây thôi thì hỏi bà con nè: \"Thác Thanh Long\", \"Thác Cửa Núi\" hoặc là \"Thác cây chôm chôm\" là được, mọi người chỉ đường vô đây yên tâm nha.",
      "start": 264.32,
      "end": 275.72,
      "n_words": 52,
      "start_frame": 6608,
      "end_frame": 6893,
      "keyframes": [
        "006716.webp",
        "006717.webp",
        "006741.webp",
        "006766.webp",
        "006767.webp",
        "006850.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đây là một cái nơi kế tiếp mà anh muốn dẫn em đi tới, đó là cái khu cắm trại.",
      "start": 275.72,
      "end": 280.8,
      "n_words": 20,
      "start_frame": 6893,
      "end_frame": 7020,
