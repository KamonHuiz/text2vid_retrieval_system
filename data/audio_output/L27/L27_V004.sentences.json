      "keyframes": [
        "007596.webp",
        "007597.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đây là cái cánh đồng thốt nốt nè, xuống đồng bằng nè, khu vực Tịnh Biên nè.",
      "start": 307.32,
