      "start_frame": 12640,
      "end_frame": 12671,
      "keyframes": [
        "012659.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trời ơi đẹp quá các bạn ơi, các bạn nhìn nè, trời ơi tuyệt vời luôn á. Mà anh Việt Anh hiện giờ là mình đang ở độ cao khoảng nhiêu rồi anh?",
      "start": 506.84,
      "end": 513.12,
      "n_words": 33,
