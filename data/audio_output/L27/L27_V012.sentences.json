      ],
      "keyframe_count": 20
    },
    {
      "text": "Thảo Uyên và ê-kíp thực hiện chương trình đang ghé thăm vườn trầu của gia đình chú Bảy Đời tại ấp Năm làng trầu Vị Thủy.",
      "start": 152.24,
      "end": 159.56,
      "n_words": 26,
      "start_frame": 3806,
      "end_frame": 3989,
      "keyframes": [
        "003835.webp",
        "003866.webp",
        "003867.webp",
        "003893.webp",
        "003920.webp",
