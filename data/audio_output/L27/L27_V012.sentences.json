        "007722.webp",
        "007723.webp",
        "007766.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "- Mình mà thu hoạch cái lá trầu này mình nên thu hoạch vào thời điểm nào gọi là tốt nhất?",
      "start": 312.32,
