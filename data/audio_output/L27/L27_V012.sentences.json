      "n_words": 31,
      "start_frame": 8927,
      "end_frame": 9138,
      "keyframes": [
        "008946.webp",
        "009021.webp",
        "009022.webp",
        "009081.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tuy là ngày nay tại địa phương đã hiếm người ăn trầu, chỉ trồng và bán trầu cho thương lái tiêu thụ nơi khác nhưng mà với chị và những bà con trồng xóm thì vườn trầu quanh nhà đã trở nên gắn bó thân thương từ thuở bé, hễ đi đâu xa là nhớ lắm.",
      "start": 365.52,
