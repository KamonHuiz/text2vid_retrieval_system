        "004348.webp",
        "004380.webp",
        "004412.webp",
        "004413.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Thưa quý vị, mà bây giờ thì chắc là Uyên cũng nhờ chú Bảy sẽ hướng dẫn cho Uyên xuống trầu như thế nào là đúng cách?",
      "start": 180.04,
      "end": 185.64,
      "n_words": 27,
      "start_frame": 4501,
      "end_frame": 4641,
      "keyframes": [
        "004525.webp",
        "004637.webp",
        "004638.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Rồi, cái đầu mới đầu tiên là con cột cái đọt này trước nè, rồi cột vô gì cho nó giữ lại cái dây trầu nó không có ngã xuống để thôi nó gãy, rồi bắt đầu mình cột cái nục ở trên cái đọt này xong bắt đầu từ dưới này mình cột dài lên.",
      "start": 185.64,
      "end": 198.52,
      "n_words": 57,
      "start_frame": 4641,
      "end_frame": 4963,
      "keyframes": [
        "004687.webp",
        "004737.webp",
        "004738.webp",
        "004820.webp",
        "004902.webp",
        "004903.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Ở xã Vị Thủy của mình là trồng trầu tính tới nay là bao nhiêu năm rồi chú?",
      "start": 198.52,
      "end": 202.52,
      "n_words": 19,
      "start_frame": 4963,
      "end_frame": 5063,
      "keyframes": [
        "004987.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Trồng được năm sáu chục năm, nhưng mà trước khi hồi còn nhỏ thì có bà Năm với ông Bảy Đời ở đây là ông có trồng trước chú rồi.",
      "start": 202.52,
      "end": 209.52,
      "n_words": 31,
      "start_frame": 5063,
      "end_frame": 5238,
      "keyframes": [
        "005072.webp",
        "005073.webp",
        "005155.webp",
        "005237.webp",
        "005238.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trầu phong kiến tô là ông có trồng rồi, chú ước là cỡ khoảng 80 năm rồi đó.",
      "start": 209.52,
      "end": 214.72,
      "n_words": 18,
      "start_frame": 5238,
      "end_frame": 5368,
      "keyframes": [
        "005238.webp",
        "005280.webp",
        "005322.webp",
        "005323.webp",
        "005359.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cái lúc trước thì trồng mới có bốn năm hộ thôi nhưng bây giờ là hết trơn cái làng nghề của ông Năm này với cái xã này nó ra tới 32 ha là trồng trầu.",
      "start": 214.72,
      "end": 223.68,
      "n_words": 36,
      "start_frame": 5368,
      "end_frame": 5592,
      "keyframes": [
        "005396.webp",
        "005397.webp",
        "005440.webp",
        "005484.webp",
        "005485.webp",
        "005534.webp",
        "005584.webp",
        "005585.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Như bây giờ mình xuống là mình phải gỡ cái dây trầu ra, cái tay này nó già quá mình sẽ hớt nó bỏ để cho cái tay này nó ra cái lá non này, xong cái lần mình xuống trầu mình chăm sóc là mình thu hoạch, sóc là mình thu hoạch vài cái bảy tám tháng tụt xuống.",
      "start": 223.68,
      "end": 238.2,
      "n_words": 60,
      "start_frame": 5592,
      "end_frame": 5955,
      "keyframes": [
        "005619.webp",
        "005654.webp",
