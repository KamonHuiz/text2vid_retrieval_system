        "002141.webp",
        "002178.webp",
        "002216.webp",
        "002217.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và trong tập phát sóng ngày hôm nay thì mời quý vị chúng ta sẽ cùng với Thảo Uyên gặp gỡ bà con để tìm hiểu về cách trồng loại cây đặc biệt này nhé.",
      "start": 89.68,
      "end": 98.32,
      "n_words": 35,
      "start_frame": 2242,
      "end_frame": 2458,
      "keyframes": [
        "002262.webp",
        "002307.webp",
        "002308.webp",
        "002435.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Làng trầu Vị Thủy thuộc xã Vị Thủy, huyện Vị Thủy, tỉnh Hậu Giang ngày nay đã gắn bó lâu đời với người dân địa phương và trở thành nét đặc trưng mỗi khi nhắc đến vùng quê này.",
      "start": 98.32,
      "end": 109.48,
      "n_words": 39,
      "start_frame": 2458,
      "end_frame": 2737,
      "keyframes": [
        "002562.webp",
        "002563.webp",
        "002592.webp",
        "002621.webp",
        "002622.webp",
        "002650.webp",
        "002679.webp",
        "002680.webp",
        "002707.webp",
        "002734.webp",
        "002735.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Hiện nay toàn huyện Vị Thủy có gần 40 ha trầu, trong đó thì xã Vị Thủy được xem là vương quốc trầu lá với hơn 200 vườn trầu trên tổng diện tích 32.5 ha tập trung tại ấp Năm và ấp Bảy.",
      "start": 109.48,
      "end": 124.0,
      "n_words": 43,
      "start_frame": 2737,
      "end_frame": 3100,
      "keyframes": [
        "002823.webp",
        "002912.webp",
        "002913.webp",
        "003008.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Có thể nói Vị Thủy là làng nghề trồng trầu quy mô và độc nhất còn lại ở miền Tây Nam Bộ.",
      "start": 124.0,
      "end": 130.16,
      "n_words": 22,
      "start_frame": 3100,
      "end_frame": 3254,
      "keyframes": [
        "003104.webp",
        "003105.webp",
        "003180.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tạm gác những bộn bề lo toan nơi phố thị, một lần ghé về đây để cùng tận hưởng bầu không khí mát mẻ, không gian miền quê yên bình, ngắm nhìn những lá trầu xanh mơn mởn lấp lánh nắng rồi cùng được nghe những lời kể hồn hậu, chất phác của bà con về chuyện trầu chuyện cau quả là một điều rất thú vị phải không các bạn?",
      "start": 130.16,
      "end": 152.24,
      "n_words": 71,
      "start_frame": 3254,
      "end_frame": 3806,
      "keyframes": [
        "003256.webp",
