        "006463.webp",
        "006507.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đặc biệt là trầu chỉ ưa các loại phân xanh có nguồn gốc tự nhiên nên là lá có màu xanh óng ả hơi được chút vàng trồng khá đẹp mắt.",
      "start": 261.96,
      "end": 271.48,
      "n_words": 31,
      "start_frame": 6549,
      "end_frame": 6787,
      "keyframes": [
        "006552.webp",
