        "009507.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Thưa quý vị, là sau khi chúng ta hái lá trầu xong thì bây giờ sẽ là công đoạn xếp thành ống.",
      "start": 381.76,
