      "end_frame": 1586,
      "keyframes": [
        "001378.webp",
        "001524.webp",
        "001525.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chào mừng quý vị và các bạn đang đến với chương trình Việt Nam đi la ghiền.",
      "start": 63.44,
      "end": 68.12,
      "n_words": 17,
      "start_frame": 1586,
      "end_frame": 1703,
      "keyframes": [
        "001615.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Từ thành phố Vị Thanh đi theo quốc lộ 61 hướng về Vị Thủy khoảng 13 km, khi đi ngang qua những con đường làng rợp bóng cây, thấy những cọc cây xanh mướt có lá chĩa thẳng lên trời, lúc đó chúng ta đã biết đến với làng nghề trồng trầu Vị Thủy.",
      "start": 68.12,
      "end": 83.92,
      "n_words": 54,
      "start_frame": 1703,
      "end_frame": 2098,
      "keyframes": [
        "001705.webp",
        "001706.webp",
        "001772.webp",
