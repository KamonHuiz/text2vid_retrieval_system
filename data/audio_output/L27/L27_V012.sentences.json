        "011499.webp",
        "011573.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "- Têm trầu cái bước đầu tiên trong cái têm trầu là chúng ta sẽ quét phôi đúng không ạ?",
      "start": 465.2,
