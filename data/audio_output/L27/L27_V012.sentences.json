      ],
      "keyframe_count": 3
    },
    {
      "text": "Theo chị Mỹ Xuyên thì nghề trồng trầu có thu nhập khá và ổn định kinh tế gia đình nếu như người trồng siêng năng chịu khó chăm sóc mỗi ngày.",
      "start": 348.6,
