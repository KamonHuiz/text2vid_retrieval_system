        "006176.webp",
        "006225.webp",
        "006226.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Một thời gian ngắn thấy dây trầu bén rễ thì giật ra đem ốp vào cọc mới.",
      "start": 249.32,
      "end": 254.92,
      "n_words": 17,
      "start_frame": 6233,
      "end_frame": 6373,
      "keyframes": [
        "006274.webp",
        "006323.webp",
        "006324.webp",
        "006361.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Do đây là loại lá nên nếu đủ phân đủ nước trầu sẽ cho thu hoạch lá sau ba đến bốn tháng.",
      "start": 254.92,
      "end": 261.96,
