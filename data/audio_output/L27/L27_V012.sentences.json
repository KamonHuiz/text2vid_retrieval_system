        "008536.webp",
        "008537.webp",
        "008585.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Hiện tại gia đình của chị có gần 2.000 nọc trầu trồng xung quanh vườn nhà.",
      "start": 344.2,
