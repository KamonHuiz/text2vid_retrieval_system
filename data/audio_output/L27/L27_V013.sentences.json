      "start_frame": 7278,
      "end_frame": 7513,
      "keyframes": [
        "007317.webp",
        "007361.webp",
        "007362.webp",
        "007437.webp",
        "007513.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cái nghề trồng khóm này nhà anh là anh làm bao lâu rồi?",
      "start": 300.52,
      "end": 303.04,
      "n_words": 13,
      "start_frame": 7513,
      "end_frame": 7576,
      "keyframes": [
        "007513.webp",
        "007514.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Ba tôi thì ổng làm hồi còn trẻ rồi thì bây giờ ba ổng cũng già, giờ tới tôi làm cũng 10 năm.",
      "start": 303.04,
      "end": 311.96,
      "n_words": 24,
      "start_frame": 7576,
      "end_frame": 7799,
      "keyframes": [
        "007634.webp",
        "007755.webp",
        "007756.webp",
        "007775.webp",
        "007794.webp",
        "007795.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Anh Phong ơi, em thấy là dường như khóm ở chỗ mình là nổi tiếng rồi đó, thì không biết là cái yếu tố nào tạo nên một trái khóm ngon vùng Cầu Đúc?",
      "start": 311.96,
      "end": 320.52,
      "n_words": 35,
      "start_frame": 7799,
      "end_frame": 8013,
      "keyframes": [
        "007913.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ở đây quá trình nào giờ thì nó hợp với cái thổ nhưỡng nào giờ?",
