      "keyframes": [
        "008359.webp",
        "008435.webp",
        "008436.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Bình thường một ngày nếu mà tưới hết ruộng khóm này của mình á, chắc mất mấy tiếng đồng hồ không anh?",
      "start": 339.64,
      "end": 344.6,
      "n_words": 23,
      "start_frame": 8491,
      "end_frame": 8615,
      "keyframes": [
        "008533.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Cả ngày mới giáp hết.",
