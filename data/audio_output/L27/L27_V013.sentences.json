        "006850.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phía trước ghe của Uyên đang là cha con anh Phong.",
      "start": 274.24,
      "end": 277.36,
      "n_words": 11,
      "start_frame": 6856,
