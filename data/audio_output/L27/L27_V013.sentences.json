        "000436.webp"
      ],
      "keyframe_count": 36
    },
    {
      "text": "Ta từ đó đến giờ là mình làm nghề trồng khóm, không hả ngoại?",
      "start": 17.88,
      "end": 24.8,
      "n_words": 14,
      "start_frame": 447,
      "end_frame": 620,
      "keyframes": [
        "000490.webp",
        "000544.webp",
        "000545.webp",
        "000579.webp",
        "000613.webp",
        "000614.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Khóc cha mẹ ta thì trồng khóm không ạ, mà còn khóm con.",
      "start": 24.8,
      "end": 29.12,
      "n_words": 13,
      "start_frame": 620,
      "end_frame": 728,
      "keyframes": [
        "000647.webp",
        "000681.webp",
        "000682.webp",
        "000714.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cảm ơn bà con, nói nhiều nước nè, chu thua ngọt ngọt rất là ngon. Chào mừng quý vị và các bạn đang đến với chương trình Việt Nam đi là ghiền.",
      "start": 29.12,
      "end": 46.28,
      "n_words": 32,
      "start_frame": 728,
      "end_frame": 1157,
      "keyframes": [
        "000746.webp",
        "000747.webp",
        "000765.webp",
        "000783.webp",
        "000784.webp",
        "000798.webp",
        "000813.webp",
        "000814.webp",
        "000832.webp",
        "000851.webp",
        "000852.webp",
        "000862.webp",
        "000873.webp",
        "000874.webp",
        "000888.webp",
        "000902.webp",
        "000903.webp",
        "000915.webp",
        "000928.webp",
        "000929.webp",
        "001043.webp"
      ],
      "keyframe_count": 21
    },
    {
      "text": "Ngày hôm nay thì Thảo Uyên đang có mặt tại xã Hỏa Tiến của thành phố Vị Thanh, tỉnh Hậu Giang.",
      "start": 46.28,
      "end": 51.52,
      "n_words": 21,
      "start_frame": 1157,
      "end_frame": 1288,
      "keyframes": [
        "001158.webp",
        "001159.webp",
        "001222.webp",
        "001286.webp",
        "001287.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ở đây thì khóm là một trong những loại trái cây đặc sản có mặt tại vùng đất Hậu Giang từ những năm 1930 của thế kỷ trước.",
      "start": 51.52,
      "end": 59.04,
      "n_words": 28,
      "start_frame": 1288,
      "end_frame": 1476,
      "keyframes": [
        "001343.webp",
        "001399.webp",
        "001400.webp",
        "001437.webp",
        "001474.webp",
        "001475.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và ngày hôm nay, Thảo Uyên rất là muốn dẫn quý vị chúng ta sẽ cùng nhau tìm hiểu về cách trồng khóm nè và chăm sóc làm sao để có một trái khóm thật là thơm ngon.",
      "start": 59.04,
      "end": 67.52,
      "n_words": 38,
      "start_frame": 1476,
      "end_frame": 1688,
      "keyframes": [
        "001531.webp",
        "001588.webp",
        "001589.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngay bây giờ thì đi thôi! Cây khóm xuất hiện trên vùng đất Hậu Giang gần 100 năm qua.",
      "start": 67.52,
      "end": 73.96,
      "n_words": 19,
      "start_frame": 1688,
      "end_frame": 1849,
      "keyframes": [
        "001721.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Từ những năm 1930 của thế kỷ trước, người dân vùng Hỏa Tiến, Vị Thanh nhận thấy đây là một loại trái ngon, ăn bổ dưỡng nên đã nhân giống trồng hai bên bờ sông cái lớn.",
      "start": 73.96,
      "end": 85.12,
      "n_words": 37,
      "start_frame": 1849,
      "end_frame": 2128,
      "keyframes": [
        "001853.webp",
        "001854.webp",
        "001903.webp",
        "001953.webp",
        "001954.webp",
        "001993.webp",
        "002033.webp",
        "002034.webp",
        "002078.webp",
        "002122.webp",
        "002123.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Xóm Cầu Đúc có nhiều bà con trồng chuyên canh loại trái cây này nên từ đó làng khóm Cầu Đúc vang danh cho tới nay.",
      "start": 85.12,
      "end": 92.16,
      "n_words": 26,
      "start_frame": 2128,
      "end_frame": 2304,
      "keyframes": [
        "002168.webp",
        "002213.webp",
        "002214.webp",
        "002261.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khóm Cầu Đúc có dáng thanh nhã, cuống ngắn, lõi nhỏ, hố mắt hơi sâu.",
      "start": 92.16,
      "end": 97.32,
      "n_words": 15,
      "start_frame": 2304,
      "end_frame": 2433,
      "keyframes": [
        "002309.webp",
        "002310.webp",
        "002345.webp",
        "002381.webp",
        "002382.webp",
        "002418.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Điểm đặc biệt tạo nên thương hiệu xưa nay của khóm Cầu Đúc đó là vị ngọt thanh, thịt màu vàng tươi, ít xơ.",
      "start": 97.32,
      "end": 105.52,
      "n_words": 24,
      "start_frame": 2433,
      "end_frame": 2638,
      "keyframes": [
        "002454.webp",
        "002455.webp",
        "002487.webp",
        "002520.webp",
        "002521.webp",
        "002548.webp",
        "002575.webp",
        "002576.webp",
        "002609.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hỏa Tiến hiện có khoảng 1.000 ha diện tích trồng khóm.",
      "start": 105.52,
      "end": 109.36,
      "n_words": 11,
      "start_frame": 2638,
      "end_frame": 2734,
      "keyframes": [
        "002643.webp",
        "002644.webp",
        "002688.webp",
        "002733.webp",
        "002734.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đây là một loại cây ăn trái mang lại nguồn thu nhập chính cho nhiều hộ gia đình.",
      "start": 109.36,
      "end": 113.8,
      "n_words": 18,
      "start_frame": 2734,
      "end_frame": 2845,
      "keyframes": [
        "002734.webp",
        "002788.webp",
        "002842.webp",
        "002843.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Địa phương đã thành lập hợp tác xã hoạt động trong lĩnh vực trồng, kinh doanh, chế biến các sản phẩm từ khóm.",
      "start": 113.8,
      "end": 119.92,
      "n_words": 23,
      "start_frame": 2845,
      "end_frame": 2998,
      "keyframes": [
        "002889.webp",
        "002936.webp",
        "002937.webp",
        "002982.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nơi đây cũng đã hình thành nên làng du lịch Cầu Đúc.",
      "start": 119.92,
      "end": 122.88,
      "n_words": 12,
      "start_frame": 2998,
      "end_frame": 3072,
      "keyframes": [
        "003027.webp",
        "003028.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cánh đồng khóm Cầu Đúc thu hút nhiều du khách đến tham quan.",
      "start": 122.88,
      "end": 126.72,
      "n_words": 13,
      "start_frame": 3072,
      "end_frame": 3168,
      "keyframes": [
        "003093.webp",
        "003159.webp",
        "003160.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vào mùa thu hoạch, về thăm làng khóm Cầu Đúc, chúng ta dễ dàng bắt gặp những chiếc xuồng đang chở đầy những trái khóm từ ngoài rẫy vô.",
      "start": 126.72,
      "end": 134.56,
      "n_words": 29,
      "start_frame": 3168,
      "end_frame": 3364,
      "keyframes": [
        "003188.webp",
        "003217.webp",
        "003218.webp",
        "003244.webp",
        "003271.webp",
        "003272.webp",
        "003307.webp",
        "003343.webp",
        "003344.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ven đường là những ụ khóm với những người phụ nữ đang nhanh tay chặt cuống khóm.",
      "start": 134.56,
      "end": 139.88,
      "n_words": 17,
      "start_frame": 3364,
      "end_frame": 3497,
      "keyframes": [
        "003371.webp",
        "003398.webp",
        "003399.webp",
        "003426.webp",
        "003454.webp",
        "003455.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thưa quý vị, trên tay Thảo Uyên đây là một trái khóm chín ngày hôm nay nha.",
      "start": 139.88,
      "end": 143.88,
      "n_words": 17,
      "start_frame": 3497,
      "end_frame": 3597,
      "keyframes": [
        "003526.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Còn có một khách mời rất là đặc biệt cùng với Thảo Uyên nữa, đó là chị Kế.",
      "start": 143.88,
      "end": 147.12,
      "n_words": 18,
      "start_frame": 3597,
      "end_frame": 3678,
      "keyframes": [
        "003598.webp",
        "003599.webp",
        "003651.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chị Kế là giáo viên của trường tiểu học và cũng là nông dân đang trồng khóm tại vùng Cầu Đúc của Hòa Tiến.",
      "start": 147.12,
      "end": 153.84,
      "n_words": 24,
      "start_frame": 3678,
      "end_frame": 3846,
      "keyframes": [
        "003704.webp",
        "003705.webp",
        "003774.webp",
        "003843.webp",
        "003844.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chị ơi, khi mà mình trồng được một trái khóm thì mất khoảng bao lâu thì mới có được một trái khóm như mà em đang cầm như thế này?",
      "start": 153.84,
      "end": 159.64,
      "n_words": 30,
      "start_frame": 3846,
      "end_frame": 3991,
      "keyframes": [
        "003916.webp",
        "003989.webp",
        "003990.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Bắt đầu từ trồng khóm tới thu hoạch trái này khoảng sáu tháng.",
      "start": 159.64,
      "end": 163.88,
      "n_words": 14,
      "start_frame": 3991,
      "end_frame": 4097,
      "keyframes": [
        "004043.webp",
        "004097.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Như trái khóm như thế này muốn trồng qua lớp khóm mới thì mình sẽ dùng cái con khóm này, mình sẽ xới đất xong rồi mình trồng xuống, một năm mới đổ trái rồi ra bốn tháng nữa mà được khóm như thế này.",
      "start": 163.88,
      "end": 174.08,
      "n_words": 45,
      "start_frame": 4097,
      "end_frame": 4352,
      "keyframes": [
        "004097.webp",
        "004098.webp",
        "004153.webp",
        "004208.webp",
        "004209.webp",
        "004255.webp",
        "004302.webp",
        "004303.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Ngoài ra thì cái con khóm này mình có thể bẻ này, mình có thể bán cho người ta, người ta trồng.",
      "start": 174.08,
      "end": 178.16,
      "n_words": 22,
      "start_frame": 4352,
      "end_frame": 4454,
      "keyframes": [
        "004377.webp",
        "004452.webp",
        "004453.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Và không biết là khi mà mình trồng khóm như này thì thu nhập của gia đình mình hàng tháng nó có ổn định hay không ạ?",
      "start": 178.16,
      "end": 182.92,
      "n_words": 28,
      "start_frame": 4454,
      "end_frame": 4573,
      "keyframes": [
        "004492.webp",
        "004532.webp",
        "004533.webp",
        "004571.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "- Thu nhập khóm này mang lại cho gia đình thì mình có thể lo trang trải hết tất cả trong gia đình rồi mình có thể lo cho con cái ăn học.",
      "start": 182.92,
      "end": 190.12,
      "n_words": 33,
      "start_frame": 4573,
      "end_frame": 4753,
      "keyframes": [
        "004610.webp",
        "004611.webp",
        "004654.webp",
        "004698.webp",
        "004699.webp",
        "004724.webp",
        "004749.webp",
        "004750.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Và ngày hôm nay, Thảo Uyên may mắn khi mà được gặp gỡ và làm quen với cụ bà Võ Thị Xa.",
      "start": 190.12,
      "end": 195.6,
      "n_words": 22,
      "start_frame": 4753,
      "end_frame": 4890,
      "keyframes": [
        "004845.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Năm nay đã ngoài 70 tuổi, cụ cho biết là mình ở làng khác nhưng mà về xứ này làm dâu rồi bén duyên với nghề trồng khóm đã trên 50 năm rồi.",
      "start": 195.6,
      "end": 204.48,
      "n_words": 33,
      "start_frame": 4890,
      "end_frame": 5112,
      "keyframes": [
        "004940.webp",
        "004941.webp",
        "004967.webp",
        "004994.webp",
        "004995.webp",
        "005065.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Giờ tuy là tuổi đã cao nhưng mà hễ khi nhà đi chặt khóm thì cụ cũng đều có mặt để phụ thêm một tay với con cháu.",
      "start": 204.48,
      "end": 211.84,
      "n_words": 28,
      "start_frame": 5112,
      "end_frame": 5296,
      "keyframes": [
        "005135.webp",
        "005136.webp",
        "005170.webp",
        "005204.webp",
        "005205.webp",
        "005248.webp",
        "005292.webp",
        "005293.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "- Từ đó đến giờ là mình làm nghề trồng khóm không hả ngoại?",
      "start": 211.84,
      "end": 214.76,
      "n_words": 14,
      "start_frame": 5296,
      "end_frame": 5369,
      "keyframes": [
        "005329.webp",
        "005365.webp",
        "005366.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Ờ hồi đó giờ là ngoại trồng khóm rồi cha mẹ tới già thì trồng khóm không.",
      "start": 214.76,
      "end": 218.4,
      "n_words": 18,
      "start_frame": 5369,
      "end_frame": 5460,
      "keyframes": [
        "005399.webp",
        "005432.webp",
        "005433.webp",
        "005454.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "- Dạ, ngày xưa thì khi mà thời bố mẹ của bà chồng nó có được như bây giờ không bằng?",
      "start": 218.4,
      "end": 224.04,
      "n_words": 21,
      "start_frame": 5460,
      "end_frame": 5601,
      "keyframes": [
        "005476.webp",
        "005477.webp",
        "005525.webp",
        "005573.webp",
        "005574.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- Ngày xưa không có bằng, hồi xưa cha chồng thì không có 12 tháng là không có đấu cái đá là 18 tháng mới là cháu từ ơn.",
      "start": 224.04,
      "end": 231.52,
      "n_words": 29,
