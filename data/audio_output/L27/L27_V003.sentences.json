        "001654.webp",
        "001707.webp",
        "001708.webp",
        "001732.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Mà các bạn biết không, rau rừng của vùng núi Cấm có tiếng hồi xưa tới giờ rồi, vậy nên là bây giờ chúng ta phải cùng nhau đi ăn thử bánh xèo rau rừng núi Cấm.",
      "start": 69.68,
      "end": 90.16,
      "n_words": 37,
      "start_frame": 1742,
      "end_frame": 2254,
      "keyframes": [
        "001757.webp",
        "001758.webp",
        "001857.webp",
        "001957.webp",
        "001980.webp",
        "001998.webp",
        "002016.webp",
        "002017.webp",
        "002045.webp",
        "002073.webp",
        "002074.webp",
        "002095.webp",
        "002116.webp",
        "002117.webp",
        "002138.webp",
        "002160.webp",
        "002161.webp",
        "002184.webp",
        "002208.webp",
        "002209.webp"
      ],
      "keyframe_count": 20
    },
    {
      "text": "Các bạn ơi, đây là rau rừng nè.",
      "start": 90.16,
      "end": 92.48,
      "n_words": 8,
      "start_frame": 2254,
      "end_frame": 2312,
      "keyframes": [
        "002263.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nhìn vô mình tưởng mình lạc vô một cái cửa hàng bán hoa hay gì đó. Chị ơi, dạ chị là chủ quán không? Dạ đúng.",
      "start": 92.48,
      "end": 99.16,
      "n_words": 26,
      "start_frame": 2312,
      "end_frame": 2479,
      "keyframes": [
        "002317.webp",
        "002318.webp",
        "002365.webp",
        "002412.webp",
        "002413.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trời ơi mừng quá, chị em là Nhật Trường đến từ chương trình Việt Nam Đi Là Ghiền, em muốn nhờ chị giới thiệu sơ sơ về rau rừng của vùng núi Cấm của mình được không ạ?",
      "start": 99.16,
      "end": 107.64,
      "n_words": 38,
      "start_frame": 2479,
      "end_frame": 2691,
      "keyframes": [
        "002487.webp",
        "002561.webp",
        "002562.webp",
        "002597.webp",
        "002633.webp",
        "002634.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Dạ được, mình có nhiều loại rau lận. Dạ mình có mười mấy loại rau là bày lên đây hết luôn á.",
      "start": 107.64,
      "end": 113.08,
      "n_words": 22,
      "start_frame": 2691,
      "end_frame": 2827,
      "keyframes": [
        "002736.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ đúng rồi.",
      "start": 113.08,
      "end": 113.6,
      "n_words": 3,
      "start_frame": 2827,
      "end_frame": 2840,
      "keyframes": [
        "002839.webp",
        "002840.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Như cái này là cái rau gì chị?",
      "start": 113.6,
      "end": 115.08,
      "n_words": 8,
      "start_frame": 2840,
      "end_frame": 2877,
      "keyframes": [
        "002840.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đại khái Đà Lạt cái này là tía tô rừng.",
      "start": 115.08,
      "end": 116.92,
      "n_words": 10,
      "start_frame": 2877,
      "end_frame": 2923,
      "keyframes": [
        "002883.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Giống như đang tặng hoa, như đang tặng hoa nguyên một bó rau quá trời lớn luôn.",
      "start": 116.92,
      "end": 120.52,
      "n_words": 17,
      "start_frame": 2923,
      "end_frame": 3013,
      "keyframes": [
        "002927.webp",
        "002928.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cái lá nè các bạn ơi, tía tô rừng một cái lá nó bự bằng bàn tay của mình luôn.",
      "start": 120.52,
      "end": 126.2,
      "n_words": 20,
      "start_frame": 3013,
      "end_frame": 3155,
      "keyframes": [
        "003041.webp",
        "003155.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cái này là đọt muối.",
      "start": 126.2,
      "end": 128.08,
      "n_words": 5,
      "start_frame": 3155,
      "end_frame": 3202,
      "keyframes": [
        "003155.webp",
        "003156.webp",
        "003197.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ cái này chua chua ngọt ngọt. Thử thử được không?",
      "start": 128.08,
      "end": 130.32,
      "n_words": 11,
      "start_frame": 3202,
      "end_frame": 3258,
      "keyframes": [
        "003238.webp",
        "003239.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Em thử được, cho em thử con lá ha.",
      "start": 130.32,
      "end": 132.64,
      "n_words": 9,
      "start_frame": 3258,
      "end_frame": 3316,
      "keyframes": [
        "003280.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ chua chua.",
      "start": 132.64,
      "end": 136.96,
      "n_words": 3,
      "start_frame": 3316,
      "end_frame": 3424,
      "keyframes": [
        "003322.webp",
        "003323.webp",
        "003368.webp",
        "003413.webp",
        "003414.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Giờ chị phải cho cái nào nó khác vị cái nha.",
      "start": 136.96,
      "end": 139.16,
      "n_words": 11,
      "start_frame": 3424,
      "end_frame": 3479,
      "keyframes": [
        "003445.webp",
        "003476.webp",
        "003477.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đây cái này khác vị luôn, cái này mình ăn vô là cái mùi của nó giống như mình đang uống nước ngọt xị vậy đó.",
      "start": 139.16,
      "end": 144.0,
      "n_words": 26,
      "start_frame": 3479,
      "end_frame": 3600,
      "keyframes": [
        "003534.webp",
        "003591.webp",
        "003592.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, thiệt thơm dễ sợ.",
      "start": 144.0,
      "end": 150.28,
      "n_words": 6,
      "start_frame": 3600,
      "end_frame": 3757,
      "keyframes": [
        "003643.webp",
        "003695.webp",
        "003696.webp",
        "003730.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Hay là bây giờ chị cho em xin được vô bếp mình á, em coi quá trình mình làm bánh xèo rồi cái hồi nữa em đặt hàng vài cái ra mình ăn chung với rau được không?",
      "start": 150.28,
      "end": 159.24,
      "n_words": 38,
      "start_frame": 3757,
      "end_frame": 3981,
      "keyframes": [
        "003765.webp",
        "003766.webp",
        "003890.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ được.",
      "start": 159.24,
      "end": 160.6,
      "n_words": 2,
      "start_frame": 3981,
      "end_frame": 4015,
      "keyframes": [
        "004015.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ là mình đã vô bếp, coi bà chủ của mình cho Trường vô bếp để mà trải nghiệm một ngày mình đổ bánh xèo.",
      "start": 160.6,
      "end": 166.48,
      "n_words": 26,
      "start_frame": 4015,
      "end_frame": 4162,
      "keyframes": [
        "004015.webp",
        "004016.webp",
        "004022.webp",
        "004028.webp",
        "004029.webp",
        "004092.webp",
        "004156.webp",
        "004157.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chị bắt đầu trước rồi cưng chiên sau nha là chị làm mẫu đó, chị sẽ làm mẫu, Trường sẽ là người bắt chước làm theo.",
      "start": 166.48,
      "end": 172.52,
      "n_words": 26,
      "start_frame": 4162,
      "end_frame": 4313,
      "keyframes": [
        "004287.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cái thứ nhất mình phải bật chảo lên cho nó nóng hay sao, đó mình để mình để dầu ăn vô.",
      "start": 172.52,
      "end": 177.24,
      "n_words": 21,
      "start_frame": 4313,
      "end_frame": 4431,
      "keyframes": [
        "004418.webp",
        "004419.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "À trời ơi quá điêu luyện các bạn ơi.",
      "start": 177.24,
      "end": 184.24,
      "n_words": 9,
      "start_frame": 4431,
      "end_frame": 4606,
      "keyframes": [
        "004462.webp",
        "004506.webp",
        "004507.webp",
        "004544.webp",
        "004581.webp",
        "004582.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Xong bóc cái này đổ, xong lắc nhẹ một cái, bỏ giá vô, đậu xanh vô là gia vị.",
      "start": 184.24,
      "end": 199.24,
      "n_words": 19,
      "start_frame": 4606,
      "end_frame": 4981,
      "keyframes": [
        "004622.webp",
        "004663.webp",
        "004664.webp",
        "004703.webp",
        "004742.webp",
        "004743.webp",
        "004805.webp",
        "004867.webp",
        "004868.webp",
        "004909.webp",
        "004950.webp",
        "004951.webp",
        "004973.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Gia vị cưng nếm thử đi, ăn thử một cái không?",
      "start": 199.24,
      "end": 202.52,
      "n_words": 11,
      "start_frame": 4981,
      "end_frame": 5063,
      "keyframes": [
        "004996.webp",
        "004997.webp",
        "005023.webp",
        "005049.webp",
        "005050.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chị cho chị cho rồi em sẽ làm thôi.",
      "start": 202.52,
      "end": 207.24,
      "n_words": 9,
      "start_frame": 5063,
      "end_frame": 5181,
      "keyframes": [
        "005099.webp",
        "005148.webp",
        "005149.webp",
        "005165.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nãy nãy chị làm vậy nè phải không, lắc nha?",
      "start": 207.24,
      "end": 210.6,
      "n_words": 10,
      "start_frame": 5181,
      "end_frame": 5265,
      "keyframes": [
        "005182.webp",
        "005183.webp",
        "005220.webp",
        "005258.webp",
        "005259.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bắt chước chị nè.",
      "start": 210.6,
      "end": 214.36,
      "n_words": 4,
      "start_frame": 5265,
      "end_frame": 5359,
      "keyframes": [
        "005335.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi nói rất dày cui luôn, có nhiều quá không vậy?",
      "start": 214.36,
      "end": 217.72,
      "n_words": 11,
      "start_frame": 5359,
      "end_frame": 5443,
      "keyframes": [
        "005412.webp",
        "005413.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Không vừa dưa đó. Rồi giờ sao nè? Kế tiếp là giá.",
      "start": 217.72,
      "end": 223.04,
      "n_words": 12,
      "start_frame": 5443,
      "end_frame": 5576,
      "keyframes": [
        "005460.webp",
        "005507.webp",
        "005508.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cái này em không có đeo bao tay, chị cho em đi nha, rồi giúp em một vài đường vô đây thôi. Được rồi phải không chị?",
      "start": 223.04,
      "end": 229.84,
      "n_words": 27,
      "start_frame": 5576,
      "end_frame": 5746,
      "keyframes": [
        "005610.webp",
        "005712.webp",
        "005713.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ rồi.",
      "start": 229.84,
      "end": 231.04,
      "n_words": 2,
      "start_frame": 5746,
      "end_frame": 5776,
      "keyframes": [
        "005770.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cho đậu xanh vô đây là thịt với tôm, là thịt với tôm nè.",
      "start": 231.04,
      "end": 234.56,
      "n_words": 14,
      "start_frame": 5776,
      "end_frame": 5864,
      "keyframes": [
        "005827.webp",
        "005828.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cái này là mình sơ chế sẵn là nó đã chín rồi, mình ăn lúc mình ăn mình không có ngại là thịt sống.",
      "start": 234.56,
      "end": 241.76,
      "n_words": 24,
      "start_frame": 5864,
      "end_frame": 6044,
      "keyframes": [
        "005917.webp",
        "006006.webp",
        "006007.webp",
        "006025.webp",
        "006043.webp",
        "006044.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ cái bánh của Trường đã chín rồi, ba phút đã hoàn thành.",
      "start": 241.76,
      "end": 244.8,
      "n_words": 14,
      "start_frame": 6044,
      "end_frame": 6120,
      "keyframes": [
        "006044.webp",
        "006078.webp",
        "006113.webp",
        "006114.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mời mọi người cùng coi nè. Rồi cho em xin cái dĩa đi.",
      "start": 244.8,
      "end": 251.16,
      "n_words": 13,
      "start_frame": 6120,
      "end_frame": 6279,
      "keyframes": [
        "006158.webp",
        "006203.webp",
        "006204.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đây rồi, bưng ra bàn cho khách em ơi, giỡn thôi.",
      "start": 251.16,
      "end": 259.6,
      "n_words": 11,
      "start_frame": 6279,
      "end_frame": 6490,
      "keyframes": [
        "006293.webp",
        "006383.webp",
        "006384.webp",
        "006414.webp",
        "006445.webp",
        "006446.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cái bánh của Trường nè mọi người, trời ơi nè, lần đầu tiên làm nó hơi bị bung bung nhẹ chỗ này, nó hơi dày thôi thông cảm đi, thấy chỗ này giòn giòn chút bỏ qua nha.",
      "start": 259.6,
      "end": 267.84,
      "n_words": 38,
      "start_frame": 6490,
      "end_frame": 6696,
      "keyframes": [
        "006583.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nè đã chưa?",
      "start": 267.84,
      "end": 269.4,
      "n_words": 3,
      "start_frame": 6696,
      "end_frame": 6735,
      "keyframes": [
        "006721.webp",
        "006722.webp",
        "006730.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đây là cái dĩa bánh mà của Trường làm nè, các bạn thấy không cũng đẹp bộ, nó chỉ bị xấu nhẹ chỗ này thôi.",
      "start": 269.4,
      "end": 274.72,
      "n_words": 25,
      "start_frame": 6735,
      "end_frame": 6868,
      "keyframes": [
        "006739.webp",
        "006740.webp",
        "006838.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thầy coi chỗ nào xấu thì mình đừng có nhìn, mình nhìn vô mấy chỗ đẹp đẹp như vậy nè. Ngoài hai chiếc bánh xèo rất là ngon ra thì đây, đây mới chính là nhân vật chính của ngày hôm nay.",
      "start": 274.72,
      "end": 284.92,
      "n_words": 42,
      "start_frame": 6868,
      "end_frame": 7123,
      "keyframes": [
        "006937.webp",
        "006938.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thấy chưa?",
      "start": 284.92,
      "end": 285.88,
      "n_words": 2,
      "start_frame": 7123,
      "end_frame": 7147,
      "keyframes": [
        "007125.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đây bó rau rừng bự cỡ này thì chịu sao nổi, chịu sao nổi đó.",
      "start": 285.88,
      "end": 292.92,
      "n_words": 15,
      "start_frame": 7147,
      "end_frame": 7323,
      "keyframes": [
        "007312.webp",
        "007313.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ mình thưởng thức thôi, mời mọi người một chút nha.",
      "start": 292.92,
      "end": 296.92,
      "n_words": 12,
      "start_frame": 7323,
      "end_frame": 7423,
      "keyframes": [
        "007366.webp",
        "007419.webp",
        "007420.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bánh xèo thường ăn là phải dùng tay bóc luôn thôi, giờ bỏ đũa ra lấy tay bóc nó mới đúng chuẩn là của dân ăn bánh xèo.",
      "start": 296.92,
      "end": 306.0,
      "n_words": 28,
      "start_frame": 7423,
      "end_frame": 7650,
      "keyframes": [
        "007521.webp",
        "007623.webp",
        "007624.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi coi cái vỏ nó giòn rụng nè, ôi đã không?",
      "start": 306.0,
      "end": 311.72,
      "n_words": 11,
      "start_frame": 7650,
      "end_frame": 7793,
      "keyframes": [
        "007705.webp",
        "007786.webp",
        "007787.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi mời các bạn chấm ngập nước mắm luôn.",
      "start": 311.72,
      "end": 320.4,
      "n_words": 9,
      "start_frame": 7793,
      "end_frame": 8010,
      "keyframes": [
        "007809.webp",
        "007831.webp",
        "007832.webp",
        "007851.webp",
        "007870.webp",
        "007871.webp",
        "007941.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cái bánh xèo của mình nó béo béo một chút mà ăn với rau rừng chút chút nhẫn nhẫn chua chua, rồi có cái mùi mà giống thoang thoảng của cái lá lúc nãy bỏ vô á, nó trộn lại nó tạo ra cái vị đặc biệt lắm.",
      "start": 320.4,
      "end": 331.36,
      "n_words": 48,
      "start_frame": 8010,
      "end_frame": 8284,
      "keyframes": [
        "008011.webp",
        "008012.webp",
        "008028.webp",
        "008044.webp",
        "008045.webp",
        "008071.webp",
        "008097.webp",
        "008098.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rồi không biết nói sao, nó không có rõ ràng một cái vị nào hết nhưng mà trong cái từng cái gọi là cái nhai của mình á, dung hòa hết mọi thứ luôn, đã lắm.",
      "start": 331.36,
      "end": 350.68,
      "n_words": 36,
      "start_frame": 8284,
      "end_frame": 8767,
      "keyframes": [
        "008316.webp",
        "008534.webp",
        "008535.webp",
        "008645.webp",
        "008756.webp",
        "008757.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Khi mà chúng ta khám phá thế giới rau rừng ở quán bánh xèo của chị Luyến thì chị cũng chỉ đường Trường đã gặp được chú Hai. Con chào chú Hai.",
      "start": 350.68,
      "end": 359.08,
      "n_words": 32,
      "start_frame": 8767,
      "end_frame": 8977,
      "keyframes": [
        "008804.webp",
        "008851.webp",
        "008852.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chào dạ đây giới thiệu với các bạn, chú Hai là một người chuyên đi hái rau rừng ở núi Cấm mình.",
      "start": 359.08,
      "end": 363.52,
      "n_words": 22,
      "start_frame": 8977,
      "end_frame": 9088,
      "keyframes": [
        "009056.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đó thì hôm nay chú đã chuẩn bị đồ nghề rất là đầy đủ đúng không? Nhìn chuyên nghiệp. Con xin mượn cái bộ đồ nghề của chú cái nha. Đó các bạn thấy chưa, đi hái rau rừng là phải vậy nè.",
      "start": 363.52,
      "end": 372.88,
      "n_words": 43,
      "start_frame": 9088,
      "end_frame": 9322,
      "keyframes": [
        "009104.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đồ đạc ở đây là ở núi Cấm mà xã An Hảo, ấp Vô Bà.",
      "start": 372.88,
      "end": 379.2,
      "n_words": 15,
      "start_frame": 9322,
      "end_frame": 9480,
      "keyframes": [
        "009356.webp",
        "009357.webp",
        "009416.webp",
        "009476.webp",
        "009477.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dạ đây hướng này thì hồ Tà Lọt.",
      "start": 379.2,
      "end": 382.12,
      "n_words": 8,
      "start_frame": 9480,
      "end_frame": 9553,
      "keyframes": [
        "009508.webp",
        "009539.webp",
        "009540.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vậy thì không biết là hôm nay chú cháu mình đi hái rau ở khu vực nào? Chú ở ngay đây luôn hả?",
      "start": 382.12,
      "end": 387.24,
      "n_words": 23,
      "start_frame": 9553,
      "end_frame": 9681,
      "keyframes": [
        "009612.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Con đây mình đi xuống con đường này đi vô mốt, gần cuối con đường này mới có rau.",
      "start": 387.24,
      "end": 391.52,
      "n_words": 19,
      "start_frame": 9681,
      "end_frame": 9788,
      "keyframes": [
        "009684.webp",
        "009685.webp",
        "009739.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vậy bây giờ đi với chú Hai chúng ta đi hái rau rừng thôi, đi nào các bạn thôi.",
      "start": 391.52,
      "end": 398.92,
      "n_words": 19,
      "start_frame": 9788,
      "end_frame": 9973,
      "keyframes": [
        "009793.webp",
        "009794.webp",
        "009833.webp",
        "009872.webp",
        "009873.webp",
        "009896.webp",
        "009920.webp",
        "009921.webp",
        "009942.webp",
        "009963.webp",
        "009964.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chú đây đây, con quả phụ chú cho nha, chú đi cho nó khỏe rồi đây con thử trải nghiệm một ngày đi hái rau coi nó làm sao, rau coi nó làm sao.",
      "start": 398.92,
      "end": 408.64,
      "n_words": 34,
      "start_frame": 9973,
      "end_frame": 10216,
      "keyframes": [
        "009997.webp",
        "010030.webp",
        "010031.webp",
        "010098.webp",
        "010166.webp",
        "010167.webp",
        "010197.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Mấy bạn nhìn thấy xung quanh nè là rau rừng nè, đinh lăng nè, là một tự nhiên hết trơn luôn, đó ai cũng rau rừng. Ủa cây này là cây gì chú?",
      "start": 408.64,
      "end": 418.4,
      "n_words": 33,
      "start_frame": 10216,
      "end_frame": 10460,
      "keyframes": [
        "010227.webp",
        "010228.webp",
        "010255.webp",
        "010283.webp",
        "010284.webp",
        "010306.webp",
        "010328.webp",
        "010329.webp",
        "010374.webp",
        "010420.webp",
        "010421.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Cây này là cây rau cát lồi, rau cát lồi nữa.",
      "start": 418.4,
      "end": 422.92,
      "n_words": 11,
      "start_frame": 10460,
      "end_frame": 10573,
      "keyframes": [
        "010521.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cây này nó trị thần kinh tọa nè.",
      "start": 422.92,
      "end": 424.96,
      "n_words": 8,
      "start_frame": 10573,
      "end_frame": 10624,
      "keyframes": [
        "010622.webp",
        "010623.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Củ này bây giờ người ta đi đào dữ lắm, một ký là 40.000.",
      "start": 424.96,
      "end": 427.64,
      "n_words": 14,
      "start_frame": 10624,
      "end_frame": 10691,
      "keyframes": [
        "010658.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nhìn nó giống cây kiểng ở nhà quá.",
      "start": 428.44,
      "end": 430.48,
      "n_words": 8,
      "start_frame": 10711,
      "end_frame": 10762,
      "keyframes": [
        "010726.webp",
        "010758.webp",
        "010759.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Này thì rau kim thái thiên nhiên nè, nó ăn trị được bệnh phổi nữa.",
      "start": 430.48,
      "end": 434.24,
      "n_words": 15,
      "start_frame": 10762,
      "end_frame": 10856,
      "keyframes": [
        "010782.webp",
        "010806.webp",
        "010807.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Còn cái này là ăn trị khớp rồi trị thần kinh tọa đồ, hay lắm.",
      "start": 434.24,
      "end": 439.24,
      "n_words": 15,
      "start_frame": 10856,
      "end_frame": 10981,
      "keyframes": [
        "010922.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ui mới bước đầu giống như đi hái dược liệu quá.",
      "start": 439.24,
      "end": 441.56,
      "n_words": 11,
      "start_frame": 10981,
      "end_frame": 11039,
      "keyframes": [
        "011038.webp",
        "011039.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cây này cây gì chú?",
      "start": 441.56,
      "end": 442.32,
      "n_words": 5,
      "start_frame": 11039,
      "end_frame": 11058,
      "keyframes": [
        "011039.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cây này là cây quỷnh cũng hơi chua chua chát chát, nó là ăn nó cũng trị được cho dạ dày, bao tử cũng hay lắm.",
      "start": 442.32,
      "end": 450.24,
      "n_words": 26,
      "start_frame": 11058,
      "end_frame": 11256,
      "keyframes": [
        "011062.webp",
        "011085.webp",
        "011086.webp",
        "011206.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chát chỗ này cây quỷnh, cây này ăn bánh xèo cũng được luôn.",
      "start": 450.24,
      "end": 454.96,
      "n_words": 13,
      "start_frame": 11256,
      "end_frame": 11374,
      "keyframes": [
        "011327.webp",
        "011328.webp",
        "011351.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ui gai không nè?",
      "start": 454.96,
      "end": 455.96,
      "n_words": 4,
      "start_frame": 11374,
      "end_frame": 11399,
      "keyframes": [
        "011375.webp",
        "011376.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cây dông ta kêu bằng là cây rong đồng, á rong đồng.",
      "start": 455.96,
      "end": 459.12,
      "n_words": 12,
      "start_frame": 11399,
      "end_frame": 11478,
      "keyframes": [
        "011441.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cái thân nó gai không à, mấy cái mềm mềm này mình ăn được với cuống đồ ăn rồi là vô là nó bùng ngủ ngay liền luôn, ngủ ngay liền luôn á. Ủa cây này là chị mất ngủ nè?",
      "start": 459.12,
      "end": 469.2,
      "n_words": 41,
      "start_frame": 11478,
      "end_frame": 11730,
      "keyframes": [
        "011506.webp",
        "011507.webp",
        "011640.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi chị mất ngủ ngày. Vậy chú hái được nhiều nhất là bao nhiêu ký?",
      "start": 469.2,
      "end": 474.96,
      "n_words": 16,
      "start_frame": 11730,
      "end_frame": 11874,
      "keyframes": [
        "011773.webp",
        "011774.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Tùy theo thời điểm, có lúc hái vài chục ký cũng có, năm sáu chục ký cũng có.",
      "start": 474.96,
      "end": 481.92,
      "n_words": 18,
      "start_frame": 11874,
      "end_frame": 12048,
      "keyframes": [
        "011926.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi sao mà khiêng ra được cũng phải ráng vác ra rồi mình hái.",
      "start": 481.92,
      "end": 485.96,
      "n_words": 14,
      "start_frame": 12048,
      "end_frame": 12149,
      "keyframes": [
        "012078.webp",
        "012079.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Vậy xong là có bạn hàng người ta tới người ta đặt hàng sẵn hay sao?",
      "start": 485.96,
      "end": 488.6,
      "n_words": 16,
      "start_frame": 12149,
      "end_frame": 12215,
      "keyframes": [
        "012172.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Có khi người ta đặt ở thành phố hay Cần Thơ đồ người ta đặt mình cũng hái mình giao cho người ta luôn.",
      "start": 488.6,
      "end": 494.32,
      "n_words": 24,
      "start_frame": 12215,
      "end_frame": 12358,
      "keyframes": [
        "012265.webp",
        "012266.webp",
        "012335.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ký gì bán được nhiều không?",
      "start": 494.32,
      "end": 496.48,
      "n_words": 6,
      "start_frame": 12358,
      "end_frame": 12412,
      "keyframes": [
        "012405.webp",
        "012406.webp"
      ],
      "keyframe_count": 2
    },
    {
