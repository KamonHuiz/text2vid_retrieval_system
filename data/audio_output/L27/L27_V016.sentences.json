        "005491.webp",
        "005511.webp",
        "005532.webp",
        "005533.webp",
        "005577.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Từ đó là bà con chúng ta là làm lưới để chụp đìa, có 3-4 tấn có đìa, năm bảy tấn cũng có.",
      "start": 224.72,
      "end": 232.8,
      "n_words": 23,
      "start_frame": 5618,
      "end_frame": 5820,
      "keyframes": [
        "005621.webp",
        "005622.webp",
        "005644.webp",
        "005666.webp",
        "005667.webp",
        "005711.webp",
        "005756.webp",
        "005757.webp",
        "005788.webp",
        "005820.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Đủ loại cá, hầu hết là cá sặc rằn nè, với cá chê, cá lóc, cá gô.",
      "start": 232.8,
      "end": 239.28,
      "n_words": 17,
      "start_frame": 5820,
      "end_frame": 5982,
      "keyframes": [
        "005820.webp",
        "005821.webp",
        "005845.webp",
        "005870.webp",
        "005871.webp",
        "005896.webp",
        "005921.webp",
        "005922.webp",
        "005954.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Mình thấy cái hàng nông sản thực phẩm của mình là nhiều quá, cho nên mình muốn nối gót cái truyền thống của cha ông mình, từ đó là vợ chồng tôi mới nảy sinh ra làm con cá khô bổi này vào thời những năm 80.",
      "start": 239.28,
      "end": 253.44,
      "n_words": 47,
      "start_frame": 5982,
      "end_frame": 6336,
      "keyframes": [
        "005987.webp",
        "005988.webp",
        "006119.webp",
        "006250.webp",
        "006251.webp",
        "006303.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tới nay khi mình đi chụp đìa về thì mình đưa lên mình chế biến, chế biến rồi vô mình ướp muối là một đêm, sáng lại mình phơi.",
      "start": 253.72,
      "end": 263.12,
      "n_words": 29,
      "start_frame": 6343,
      "end_frame": 6578,
      "keyframes": [
        "006356.webp",
        "006357.webp",
        "006384.webp",
        "006411.webp",
        "006412.webp",
        "006463.webp",
        "006515.webp",
        "006516.webp",
        "006547.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chú như vậy là chú phơi một nắng, rồi là ban đêm chú sấy, rồi qua ngày sau nữa là nếu như thời tiết tốt thì đem ra phơi tiếp.",
      "start": 263.12,
      "end": 272.56,
      "n_words": 30,
      "start_frame": 6578,
      "end_frame": 6814,
      "keyframes": [
        "006579.webp",
        "006580.webp",
        "006611.webp",
        "006643.webp",
        "006644.webp",
        "006675.webp",
        "006706.webp",
        "006707.webp",
        "006781.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ngày xưa là mình phơi mấy nắng mới được chứ vất vả lắm, hồi xưa phơi con cá có khi là ba nắng trở lên mới bán được, ngày xưa là vất vả lắm.",
      "start": 272.56,
      "end": 281.48,
      "n_words": 34,
      "start_frame": 6814,
      "end_frame": 7037,
      "keyframes": [
        "006855.webp",
        "006856.webp",
        "006895.webp",
        "006934.webp",
        "006935.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Từ những mẻ khô làm chi bán trong thôn quê chòm xóm, những khu chợ nhỏ, tới nay gia đình chú Tư Hùng đã phát triển lên quy mô bề thế, chuyên chế biến khô cá sặc rằn bán sỉ, lẻ có tiếng của xứ U Minh.",
      "start": 281.48,
