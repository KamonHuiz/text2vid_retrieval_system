        "002120.webp",
        "002182.webp",
        "002183.webp"
      ],
      "keyframe_count": 30
    },
    {
      "text": "Xin chào các bạn khán giả của chương trình Việt Nam đi la ghiền.",
      "start": 88.04,
      "end": 90.8,
      "n_words": 14,
      "start_frame": 2201,
      "end_frame": 2270,
      "keyframes": [
        "002226.webp",
        "002269.webp",
        "002270.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "U Minh vốn là nơi sinh sống của cá đồng và những cánh đồng lúa cũng như rừng tràm đã tạo ra nguồn thức ăn cũng như là nơi trú ngụ của những loại cá đồng này cho nên ở đây số lượng cá nhiều vô kể.",
      "start": 90.8,
      "end": 100.88,
      "n_words": 47,
      "start_frame": 2270,
      "end_frame": 2522,
      "keyframes": [
        "002270.webp",
        "002434.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và từ ngày xa xưa thì với số lượng cá này thì ông bà ta đã nghĩ ra cách làm mắm nè, làm khô để sử dụng dần và dần dà món ăn này đã trở thành một đặc sản rất là hấp dẫn của rừng U Minh.",
      "start": 100.88,
      "end": 111.84,
      "n_words": 48,
      "start_frame": 2522,
      "end_frame": 2796,
      "keyframes": [
        "002599.webp",
