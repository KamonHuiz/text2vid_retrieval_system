        "003413.webp",
        "003441.webp",
        "003442.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Không ngờ cách chế biến này đã giúp loài cá có kích cỡ nhỏ chỉ bằng bàn tay mình, lấm tấm, nhìn không bắt mắt chút nào nhưng khi thành khô thì cho thịt thơm ngọt bùi khi chiên hay nướng.",
      "start": 137.88,
      "end": 149.92,
      "n_words": 41,
      "start_frame": 3447,
      "end_frame": 3748,
      "keyframes": [
        "003464.webp",
