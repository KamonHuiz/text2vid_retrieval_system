        "003684.webp",
        "003685.webp",
        "003725.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tương truyền hang động này phát hiện từ thế kỷ 18 do các nhà sư và ngư dân tới đây khẩn hoang trên vùng đất mới và lập nên ngôi chùa ngay trong lòng hang.",
      "start": 149.68,
      "end": 160.8,
      "n_words": 35,
      "start_frame": 3742,
      "end_frame": 4020,
      "keyframes": [
        "003766.webp",
