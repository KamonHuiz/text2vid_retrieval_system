        "002167.webp",
        "002246.webp",
        "002247.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Do cấu tạo địa hình đá vôi lởm dởm, có nhiều mỏm núi sắc nhọn chỉ thẳng lên trời như những mũi chông nên nơi này còn có tên gọi là Hòn Chông.",
      "start": 90.64,
      "end": 101.04,
      "n_words": 33,
      "start_frame": 2266,
      "end_frame": 2526,
      "keyframes": [
        "002370.webp",
        "002494.webp",
        "002495.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và các bạn biết không, nằm ẩn sâu trong lòng núi đá tưởng đâu hoang sơ này lại có một công trình kiến trúc vô cùng độc đáo đó là một ngôi cổ tự do bàn tay của con người tạo dựng cách nay đã gần ba thế kỷ.",
      "start": 101.04,
      "end": 113.48,
      "n_words": 49,
      "start_frame": 2526,
      "end_frame": 2837,
      "keyframes": [
        "002543.webp",
