        "004411.webp",
        "004412.webp",
        "004584.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Khi đi vào chùa đó nó có một cái luồng gió từ ngoài cửa này nó thổi vô, nghĩa là gió mạnh lắm.",
      "start": 188.48,
      "end": 194.44,
      "n_words": 23,
      "start_frame": 4712,
      "end_frame": 4861,
      "keyframes": [
        "004756.webp",
        "004757.webp",
        "004791.webp",
        "004826.webp",
        "004827.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tất cả mọi người ta nói cứ ngỡ là có máy lạnh, nhưng mà sự thật thì nó không có máy lạnh, có thể gió là tự nhiên nó hút ở trên không.",
      "start": 194.44,
      "end": 201.24,
      "n_words": 33,
      "start_frame": 4861,
      "end_frame": 5031,
      "keyframes": [
        "004880.webp",
        "004933.webp",
        "004934.webp",
        "004987.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Suốt như Như Bình đã giới thiệu, bên trong chùa sẽ có một hang thông ra đến cửa biển và chiều dài là khoảng 50 mét.",
      "start": 201.24,
      "end": 208.92,
      "n_words": 26,
      "start_frame": 5031,
      "end_frame": 5223,
      "keyframes": [
        "005041.webp",
        "005042.webp",
        "005108.webp",
        "005174.webp",
        "005175.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nơi này thì sẽ rộng vừa đủ ba đến bốn người đi cùng một lúc và nước thì ăn mòn qua hàng ngàn năm nên là tạo ra rất là nhiều những hình thù gồ ghề độc đáo, và đây cũng là một nét đặc trưng và khi đó có tên là chùa Hang.",
      "start": 208.92,
      "end": 229.12,
      "n_words": 54,
      "start_frame": 5223,
      "end_frame": 5728,
      "keyframes": [
        "005237.webp",
