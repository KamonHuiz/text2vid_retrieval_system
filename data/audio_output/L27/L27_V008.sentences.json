      "end_frame": 2042,
      "keyframes": [
        "002027.webp",
        "002028.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khu vực có địa hình với nhiều núi đá vôi nằm gần nhau tạo thành một cụm núi đá vôi quy mô nhất tỉnh Kiên Giang.",
      "start": 81.68,
      "end": 90.64,
      "n_words": 26,
      "start_frame": 2042,
      "end_frame": 2266,
      "keyframes": [
        "002058.webp",
