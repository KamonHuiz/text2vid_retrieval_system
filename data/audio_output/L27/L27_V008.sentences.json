        "005590.webp",
        "005661.webp",
        "005662.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Càng vào trong lòng hang núi càng rộng mở, hang cao dần với hàng ngàn thạch nhũ có hình thù lạ mắt.",
      "start": 229.12,
      "end": 235.56,
      "n_words": 22,
      "start_frame": 5728,
      "end_frame": 5889,
      "keyframes": [
        "005736.webp",
        "005810.webp",
        "005811.webp",
        "005880.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nơi cao nhất có một miệng giếng trời thông gió khiến cho bên trong lòng hang mát rượi.",
      "start": 235.56,
      "end": 244.52,
      "n_words": 18,
      "start_frame": 5889,
      "end_frame": 6113,
      "keyframes": [
        "005950.webp",
