        "001522.webp",
        "001537.webp",
        "001538.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Ngoài phong cảnh sơn thủy hữu tình, những nét kiến trúc độc đáo của ngôi chùa ẩn trong hang hay những núi đá vôi lô nhô với những hình thù vô cùng độc đáo thì tạo ra những nét hấp dẫn thú vị rất là riêng của vùng đất này.",
      "start": 62.6,
      "end": 77.72,
      "n_words": 50,
      "start_frame": 1565,
      "end_frame": 1943,
