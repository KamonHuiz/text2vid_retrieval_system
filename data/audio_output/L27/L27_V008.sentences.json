        "003960.webp",
        "004001.webp",
        "004002.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Chùa Hang có hai cửa chính gồm một cửa từ đất liền và một cửa khác ăn ra mép biển Hàng Dương.",
      "start": 160.8,
      "end": 167.68,
      "n_words": 22,
