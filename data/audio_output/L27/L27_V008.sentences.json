        "001817.webp",
        "001818.webp",
        "001922.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chông là một bán đảo ven biển thuộc huyện Kiên Lương, tỉnh Kiên Giang.",
      "start": 78.04,
      "end": 81.68,
      "n_words": 14,
