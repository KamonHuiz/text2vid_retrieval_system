        "002756.webp",
        "002757.webp",
        "002834.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Đây là điểm đầu tiên mà nhiều du khách háo hức muốn khám phá khi đến với danh thắng Hòn Chông.",
      "start": 113.48,
      "end": 121.44,
