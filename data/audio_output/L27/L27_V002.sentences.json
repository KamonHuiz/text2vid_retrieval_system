        "009900.webp",
        "009947.webp",
        "009948.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đây món đầu tiên các bạn thấy chưa, nhìn thấy chưa bà chị tôi làm đâu.",
      "start": 398.08,
      "end": 403.28,
      "n_words": 16,
      "start_frame": 9952,
      "end_frame": 10082,
      "keyframes": [
        "009979.webp",
        "010010.webp",
        "010011.webp",
        "010047.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Món thứ hai là chị sẽ hướng dẫn cưng măng tươi trộn gỏi.",
      "start": 403.28,
      "end": 406.8,
      "n_words": 13,
      "start_frame": 10082,
      "end_frame": 10170,
      "keyframes": [
        "010084.webp",
        "010085.webp",
        "010104.webp",
        "010124.webp",
        "010125.webp",
        "010146.webp",
        "010168.webp",
        "010169.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rồi trước tiên cưng đổ măng, trước tiên cưng đổ măng vô thau đi.",
      "start": 406.8,
      "end": 409.0,
      "n_words": 14,
      "start_frame": 10170,
      "end_frame": 10225,
      "keyframes": [
        "010225.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Măng cho vô đây cho hết măng vô thau đi.",
      "start": 409.0,
      "end": 411.44,
      "n_words": 10,
      "start_frame": 10225,
      "end_frame": 10286,
      "keyframes": [
        "010225.webp",
        "010282.webp",
        "010283.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ rồi xong để thịt với tôm vô rồi cưng cho chén nước sốt vô luôn rồi cưng trộn đều lên, rồi trộn đều lên xong cái mình cho ra dĩa luôn, cho ra dĩa nha.",
      "start": 411.44,
      "end": 420.4,
      "n_words": 36,
      "start_frame": 10286,
      "end_frame": 10510,
      "keyframes": [
        "010293.webp",
        "010304.webp",
        "010305.webp",
        "010327.webp",
        "010350.webp",
        "010351.webp",
        "010372.webp",
        "010393.webp",
