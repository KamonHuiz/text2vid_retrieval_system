        "010418.webp",
        "010442.webp",
        "010443.webp",
        "010468.webp",
        "010494.webp",
        "010495.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Rồi chị thấy sao?",
      "start": 420.4,
      "end": 422.2,
      "n_words": 4,
      "start_frame": 10510,
      "end_frame": 10555,
      "keyframes": [
        "010537.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Quá ngon luôn!",
      "start": 422.52,
      "end": 423.32,
      "n_words": 3,
      "start_frame": 10563,
      "end_frame": 10583,
      "keyframes": [
        "010580.webp",
        "010581.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nãy giờ mới hai món thôi, giờ món thứ ba món này là món măng chua nấu gà rồi.",
      "start": 423.32,
      "end": 429.16,
      "n_words": 19,
      "start_frame": 10583,
      "end_frame": 10729,
      "keyframes": [
        "010610.webp",
        "010640.webp",
        "010641.webp",
        "010680.webp",
        "010720.webp",
        "010721.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vậy là em nghĩ là chắc cũng đã hoàn thành rồi nè.",
      "start": 429.16,
      "end": 431.64,
      "n_words": 12,
      "start_frame": 10729,
      "end_frame": 10791,
      "keyframes": [
        "010786.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Giờ không ấy, giờ trong thời gian chờ nước sôi rồi cái mình mình dọn ra bàn đi, hồi nó sôi ùng lên cái mình bỏ này vô là mình ăn thôi chị ơi.",
      "start": 431.64,
      "end": 442.24,
      "n_words": 34,
      "start_frame": 10791,
      "end_frame": 11056,
      "keyframes": [
        "010851.webp",
        "010852.webp",
        "010952.webp",
        "011053.webp",
        "011054.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi chị mời em nha, mời cả nhà cùng ăn với hai chị em mình nha, xin mời!",
      "start": 442.24,
      "end": 446.0,
      "n_words": 18,
      "start_frame": 11056,
      "end_frame": 11150,
      "keyframes": [
        "011098.webp",
        "011143.webp",
        "011144.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Món này là món măng tươi xào với tỏi.",
