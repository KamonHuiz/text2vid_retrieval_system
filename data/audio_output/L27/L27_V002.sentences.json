      "end": 450.84,
      "n_words": 9,
      "start_frame": 11150,
      "end_frame": 11271,
      "keyframes": [
        "011193.webp",
        "011243.webp",
        "011244.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngon quá chị, gia vị rất là vừa ăn luôn nha.",
      "start": 450.84,
      "end": 456.12,
      "n_words": 11,
      "start_frame": 11271,
      "end_frame": 11403,
      "keyframes": [
        "011317.webp",
        "011390.webp",
        "011391.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Con thử món măng trộn gỏi coi góp ý anh chị thêm coi cần thêm gì cần bớt gì không?",
      "start": 456.12,
      "end": 459.8,
      "n_words": 20,
      "start_frame": 11403,
      "end_frame": 11495,
      "keyframes": [
        "011406.webp",
        "011421.webp",
        "011422.webp",
        "011460.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nha Trường dạ.",
      "start": 459.8,
      "end": 461.36,
      "n_words": 3,
      "start_frame": 11495,
      "end_frame": 11534,
      "keyframes": [
        "011498.webp",
        "011499.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chấm với nước mắm đúng rồi mình chấm mắm pha chua ngọt có tỏi có ớt nè, rất là thơm ăn vô vẫn giữ được cái độ tươi của măng mà nó có một cái chút gì đó là ngọt ngọt chua chua theo the của ớt nữa, có cần nữa ăn nó thơm lắm.",
      "start": 461.36,
      "end": 478.72,
      "n_words": 55,
      "start_frame": 11534,
      "end_frame": 11968,
      "keyframes": [
        "011538.webp",
        "011577.webp",
        "011578.webp",
