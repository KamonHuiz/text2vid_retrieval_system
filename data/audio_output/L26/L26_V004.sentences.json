        "002197.webp",
        "002245.webp",
        "002293.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta nên sử dụng trà matcha sữa Lendy để tạo hương vị đặc trưng cho món bánh ngày hôm nay nha.",
      "start": 91.72,
      "end": 96.84,
