        "001753.webp",
        "001780.webp",
        "001781.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình nên ngâm gelatin này cùng với lại nước lạnh thì giúp gelatin được nở tốt hơn.",
      "start": 71.24,
      "end": 76.16,
      "n_words": 17,
      "start_frame": 1781,
      "end_frame": 1904,
      "keyframes": [
        "001781.webp",
        "001839.webp",
        "001898.webp",
        "001899.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta sẽ đi nấu các phần kem béo nha.",
