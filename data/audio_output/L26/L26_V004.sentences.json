        "002355.webp",
        "002416.webp",
        "002417.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Vị matcha của trà matcha sữa Lendy làm cho Minh Phương rất là thích bởi đậm đà nè và rất là thơm.",
      "start": 96.84,
