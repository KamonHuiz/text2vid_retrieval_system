        "001447.webp",
        "001461.webp",
        "001462.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Vậy thì Minh sẽ giúp Minh Phương thực hiện món panna cotta kem muối.",
      "start": 58.68,
      "end": 62.32,
      "n_words": 14,
