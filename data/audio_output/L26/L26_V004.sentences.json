        "001980.webp",
        "002007.webp",
        "002008.webp",
        "002044.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta không nên nấu hỗn hợp kem sữa quá nóng để tránh giảm độ đông đặc của gelatin nha.",
      "start": 83.0,
      "end": 87.88,
