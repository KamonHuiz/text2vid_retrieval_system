      "keyframes": [
        "000964.webp",
        "000965.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 43.36,
      "end": 47.24,
      "n_words": 11,
