      "n_words": 10,
      "start_frame": 1904,
      "end_frame": 1956,
      "keyframes": [
        "001925.webp",
        "001952.webp",
        "001953.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho 200g kem béo này vào, cho 20g đường vào trong đây.",
