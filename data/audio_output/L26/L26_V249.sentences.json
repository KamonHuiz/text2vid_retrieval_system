        "004354.webp",
        "004386.webp",
        "004387.webp"
      ],
      "keyframe_count": 24
    },
    {
      "text": "Trộn đều, trộn đều cái phần nhân này lên, quết cho nó mịn một tiếng.",
      "start": 175.48,
      "end": 178.92,
