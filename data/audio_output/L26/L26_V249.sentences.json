  "n_sentences": 63,
  "total_words": 990,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.48,
      "end": 12.08,
      "n_words": 4,
      "start_frame": 262,
      "end_frame": 302,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Anh Minh ơi, tới công chuyện rồi nè!",
      "start": 12.08,
      "end": 14.84,
      "n_words": 8,
      "start_frame": 302,
      "end_frame": 371,
      "keyframes": [
        "000330.webp",
        "000361.webp",
        "000362.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sao đó Minh Phương thấy mua nhiều khoai môn không?",
      "start": 14.84,
      "end": 17.36,
      "n_words": 10,
      "start_frame": 371,
      "end_frame": 434,
      "keyframes": [
        "000379.webp",
        "000396.webp",
        "000397.webp",
        "000419.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng rồi, tại vì em rất là thích ăn khoai môn.",
      "start": 17.36,
      "end": 19.36,
      "n_words": 11,
      "start_frame": 434,
      "end_frame": 484,
      "keyframes": [
        "000442.webp",
        "000443.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Không những có nhiều chất tinh bột nè, nhưng mà lại có rất là nhiều chất xơ trong khoai môn đúng không anh?",
      "start": 19.36,
      "end": 24.28,
      "n_words": 23,
      "start_frame": 484,
      "end_frame": 607,
      "keyframes": [
        "000518.webp",
        "000594.webp",
        "000595.webp",
        "000606.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng rồi.",
      "start": 24.28,
      "end": 24.84,
      "n_words": 2,
      "start_frame": 607,
      "end_frame": 621,
      "keyframes": [
        "000617.webp",
        "000618.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thế Minh Phương đã biết làm món gì chưa?",
      "start": 24.84,
      "end": 26.72,
      "n_words": 9,
      "start_frame": 621,
      "end_frame": 668,
      "keyframes": [
        "000641.webp",
        "000664.webp",
        "000665.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Khoai môn thì đã sẵn sàng rồi, nhưng mà làm một món ăn gì đó ngon từ khoai môn và đặc biệt là ăn chay cho ngày chay sắp đến thì em không biết, cho nên là anh Minh giúp em được không?",
      "start": 26.72,
      "end": 36.64,
      "n_words": 43,
      "start_frame": 668,
      "end_frame": 916,
      "keyframes": [
        "000696.webp",
        "000728.webp",
        "000729.webp",
        "000754.webp",
        "000780.webp",
        "000781.webp",
        "000847.webp",
        "000914.webp",
        "000915.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rất là sẵn lòng, thôi chúng ta sẽ bắt tay vào làm ngay luôn nha.",
      "start": 36.64,
      "end": 42.04,
      "n_words": 15,
      "start_frame": 916,
      "end_frame": 1051,
      "keyframes": [
        "000931.webp",
        "000948.webp",
        "000949.webp",
        "000973.webp",
        "000998.webp",
        "000999.webp",
        "001023.webp",
        "001048.webp",
        "001049.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hoành thánh chay giòn rụm rôm rốp, cả nhà thích mê.",
      "start": 42.04,
      "end": 61.28,
      "n_words": 11,
      "start_frame": 1051,
      "end_frame": 1532,
      "keyframes": [
        "001101.webp",
        "001153.webp",
        "001154.webp",
        "001196.webp",
        "001239.webp",
        "001254.webp",
        "001300.webp",
        "001346.webp",
        "001347.webp",
        "001437.webp",
        "001527.webp",
        "001528.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chào các bạn khán giả đang theo dõi chương trình Món ngon mỗi ngày được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 61.28,
      "end": 68.08,
      "n_words": 23,
      "start_frame": 1532,
      "end_frame": 1702,
      "keyframes": [
        "001616.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên, để thực hiện món này, đậu hũ non chúng ta sẽ luộc qua và vắt ráo nó đi.",
      "start": 68.08,
      "end": 74.16,
      "n_words": 20,
      "start_frame": 1702,
      "end_frame": 1854,
      "keyframes": [
        "001705.webp",
        "001706.webp",
        "001727.webp",
        "001749.webp",
        "001750.webp",
        "001795.webp",
        "001841.webp",
        "001842.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Minh Phương tán nhuyễn nó đi.",
      "start": 74.16,
      "end": 75.64,
      "n_words": 6,
      "start_frame": 1854,
      "end_frame": 1891,
      "keyframes": [
        "001864.webp",
        "001886.webp",
        "001887.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ vắt ráo và tán nhuyễn cái đậu hũ non này để cho nhân thế có độ kết dính tốt hơn nha.",
      "start": 75.64,
      "end": 81.4,
      "n_words": 24,
      "start_frame": 1891,
      "end_frame": 2035,
      "keyframes": [
        "001937.webp",
        "001987.webp",
        "001988.webp",
        "002009.webp",
        "002030.webp",
        "002031.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình sẽ cắt cái phần củ năng này thành hạt lựu nhỏ.",
      "start": 81.4,
      "end": 84.84,
      "n_words": 12,
      "start_frame": 2035,
      "end_frame": 2121,
      "keyframes": [
        "002042.webp",
        "002053.webp",
        "002054.webp",
        "002101.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Như vậy là trong món hoành thánh ngày hôm nay, ở cái phần nhân thì chúng ta sẽ có thêm cái độ giòn giòn đến từ củ năng đúng không Minh?",
      "start": 84.84,
      "end": 91.76,
      "n_words": 31,
      "start_frame": 2121,
      "end_frame": 2294,
      "keyframes": [
        "002149.webp",
        "002150.webp",
        "002192.webp",
        "002234.webp",
        "002235.webp",
        "002268.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi.",
      "start": 91.76,
      "end": 92.2,
      "n_words": 2,
      "start_frame": 2294,
      "end_frame": 2305,
      "keyframes": [
        "002301.webp",
        "002302.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Tiếp theo, chúng ta sẽ cắt phần nấm mèo.",
      "start": 92.2,
      "end": 94.2,
      "n_words": 9,
      "start_frame": 2305,
      "end_frame": 2355,
      "keyframes": [
        "002325.webp",
        "002348.webp",
        "002349.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nấm mèo này thì chúng ta đã ngâm mềm rồi đúng không nào?",
      "start": 94.2,
      "end": 98.08,
      "n_words": 13,
      "start_frame": 2355,
      "end_frame": 2452,
      "keyframes": [
        "002387.webp",
        "002425.webp",
        "002426.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cũng cắt nhuyễn luôn hả anh Minh?",
      "start": 98.08,
      "end": 99.52,
      "n_words": 7,
      "start_frame": 2452,
      "end_frame": 2488,
      "keyframes": [
        "002473.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cũng cắt hạt lựu nhỏ luôn để cho cái phần nhân của chúng ta nó đều với nhau.",
      "start": 99.52,
      "end": 103.56,
      "n_words": 18,
      "start_frame": 2488,
      "end_frame": 2589,
      "keyframes": [
        "002520.webp",
        "002521.webp",
        "002567.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Á Minh Phương, cắt cái phần nấm hương cắt nhỏ luôn.",
      "start": 103.56,
      "end": 106.96,
      "n_words": 11,
      "start_frame": 2589,
      "end_frame": 2674,
      "keyframes": [
        "002613.webp",
        "002614.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đây là nấm hương khô và chúng ta đã ngâm nở đúng không? Nở ra.",
      "start": 106.96,
      "end": 111.36,
      "n_words": 15,
      "start_frame": 2674,
      "end_frame": 2784,
      "keyframes": [
        "002683.webp",
        "002753.webp",
        "002754.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "À, đến lượt Minh Phương sẽ bẻ nhỏ cái phần bánh đa này.",
      "start": 111.36,
      "end": 115.84,
      "n_words": 13,
      "start_frame": 2784,
      "end_frame": 2896,
      "keyframes": [
        "002792.webp",
