        "002936.webp",
        "002962.webp",
        "002989.webp",
        "002990.webp",
        "003005.webp",
        "003020.webp",
        "003021.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi em cho ra đĩa lại nha. Dạ.",
      "start": 121.04,
      "end": 123.16,
      "n_words": 8,
      "start_frame": 3026,
      "end_frame": 3079,
      "keyframes": [
        "003044.webp",
        "003068.webp",
        "003069.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi rồi, cảm ơn Minh Phương.",
      "start": 123.16,
      "end": 124.8,
      "n_words": 6,
      "start_frame": 3079,
      "end_frame": 3120,
      "keyframes": [
        "003094.webp",
        "003119.webp",
        "003120.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cái phần khoai môn thì Minh đã hấp chín và tán nhuyễn rồi nè Minh Phương.",
      "start": 124.8,
      "end": 128.32,
      "n_words": 16,
      "start_frame": 3120,
      "end_frame": 3208,
      "keyframes": [
        "003120.webp",
        "003163.webp",
        "003207.webp",
        "003208.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khoai môn chúng ta sẽ có rất nhiều cách để làm chín.",
      "start": 128.52,
      "end": 131.28,
      "n_words": 12,
      "start_frame": 3213,
      "end_frame": 3282,
      "keyframes": [
        "003233.webp",
        "003258.webp",
        "003259.webp",
        "003270.webp",
        "003281.webp",
        "003282.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các bạn khán giả có thể cắt nhỏ khoai môn cùng với một ít nước và bọc màng bọc lại, hấp chín trong lò vi sóng trong vòng 5 phút là được.",
      "start": 131.28,
      "end": 139.52,
      "n_words": 32,
      "start_frame": 3282,
      "end_frame": 3488,
      "keyframes": [
        "003282.webp",
        "003381.webp",
        "003481.webp",
        "003482.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và mình sẽ cho vào trong đây cùng với tất cả các nguyên liệu mình đã cắt thái rồi nè: nấm mèo, củ năng và nấm hương.",
      "start": 139.52,
      "end": 148.48,
      "n_words": 27,
      "start_frame": 3488,
      "end_frame": 3712,
      "keyframes": [
        "003514.webp",
        "003547.webp",
        "003548.webp",
        "003586.webp",
        "003625.webp",
