        "004425.webp",
        "004426.webp",
        "004461.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp theo, chúng ta gói hoành thánh.",
      "start": 178.92,
      "end": 180.88,
      "n_words": 7,
      "start_frame": 4473,
      "end_frame": 4522,
