        "005277.webp",
        "005296.webp",
        "005297.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Đúng rồi, nhưng mà làm thêm vài cái nữa cho đẹp nha.",
      "start": 211.96,
      "end": 214.64,
