        "002862.webp",
        "002894.webp",
        "002895.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Một cái cối chúng ta sẽ cho vào đây, vào đây và chúng ta sẽ giã nhuyễn hơn nữa như thế này là được rồi Minh Phương.",
      "start": 115.84,
      "end": 121.04,
      "n_words": 27,
      "start_frame": 2896,
      "end_frame": 3026,
      "keyframes": [
        "002915.webp",
