      "n_words": 8,
      "start_frame": 4239,
      "end_frame": 4296,
      "keyframes": [
        "004265.webp",
        "004294.webp",
        "004295.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tiếp theo nè, còn thích hơn nữa, cô sẽ cho nguyên cái phần chân giò đã ướp vào.",
      "start": 171.84,
      "end": 177.84,
      "n_words": 18,
      "start_frame": 4296,
      "end_frame": 4446,
      "keyframes": [
        "004373.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ chọn chân giò trước có nhiều thịt thì món ăn sẽ ngon hơn nha.",
      "start": 177.84,
      "end": 182.96,
      "n_words": 22,
      "start_frame": 4446,
      "end_frame": 4574,
      "keyframes": [
        "004452.webp",
        "004453.webp",
        "004475.webp",
        "004498.webp",
        "004499.webp",
        "004536.webp",
        "004574.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Khi mà cô cho cái phần chân giò vào trong cái chảo á thì cô sẽ đảo liền để mà một chút nữa đó cái phần da bên ngoài nó không có tụt khỏi cái phần xương thì cái khoanh giò mình nó sẽ đẹp hơn ha.",
      "start": 182.96,
      "end": 196.0,
      "n_words": 47,
      "start_frame": 4574,
      "end_frame": 4900,
      "keyframes": [
        "004574.webp",
