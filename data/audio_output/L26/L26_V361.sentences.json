        "000411.webp",
        "000412.webp",
        "000462.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trong tủ lạnh nhà em lúc nào cũng có sấu hết, có sấu ngâm nè và có cả sấu đông lạnh nữa.",
      "start": 20.4,
      "end": 25.2,
      "n_words": 22,
