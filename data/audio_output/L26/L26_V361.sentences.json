      "keyframes": [
        "001850.webp",
        "001942.webp",
        "001943.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ là mình sẽ ướp gia vị vào, gồm có một muỗng canh tỏi băm, một muỗng canh hành tím băm, hai muỗng canh nước cốt nghệ bầm nhỏ nó ra, sau đó thì mình cho thêm xíu nước nóng, sau đó mình dắt ha.",
      "start": 77.72,
      "end": 90.28,
      "n_words": 46,
      "start_frame": 1943,
      "end_frame": 2257,
      "keyframes": [
        "001943.webp",
