      "keyframes": [
        "001383.webp",
        "001384.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 58.04,
      "end": 62.36,
      "n_words": 11,
      "start_frame": 1451,
      "end_frame": 1559,
      "keyframes": [
        "001473.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chân giò heo này sau khi mua về rửa sạch thì chúng ta sẽ thui qua cái phần da, sau đó mình rửa lại và chặt miếng vừa ăn như thế này.",
      "start": 62.36,
      "end": 70.48,
      "n_words": 32,
      "start_frame": 1559,
      "end_frame": 1762,
      "keyframes": [
