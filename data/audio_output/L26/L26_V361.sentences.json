        "003535.webp",
        "003573.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rồi cô cảm ơn Kim Thảo.",
      "start": 143.08,
      "end": 144.48,
      "n_words": 6,
      "start_frame": 3577,
      "end_frame": 3612,
      "keyframes": [
        "003611.webp",
        "003612.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ em sẽ đặt lên cho cô một cái nồi lên đây, cô sẽ cho nước dùng vô mình nấu cùng với sấu.",
      "start": 144.48,
      "end": 148.76,
      "n_words": 24,
      "start_frame": 3612,
