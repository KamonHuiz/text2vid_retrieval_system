        "003963.webp",
        "003983.webp",
        "003984.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bây giờ mình sẽ cho sả vào xào trước nè, sả mình đã đập dập cắt khúc.",
      "start": 159.4,
      "end": 163.92,
      "n_words": 17,
      "start_frame": 3985,
      "end_frame": 4098,
      "keyframes": [
        "004012.webp",
        "004041.webp",
        "004042.webp",
        "004071.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ sả thơm rồi đó, mình cho một ít hành tím và tỏi băm vào xào cho thơm nữa.",
      "start": 163.92,
      "end": 169.56,
      "n_words": 20,
      "start_frame": 4098,
      "end_frame": 4239,
      "keyframes": [
