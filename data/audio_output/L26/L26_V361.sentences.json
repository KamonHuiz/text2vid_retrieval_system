        "003682.webp",
        "003713.webp",
        "003714.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cô sẽ cho vào đó một lít rưỡi nước dùng, Kim Thảo sẽ cho hết cái phần sấu vô giúp cô.",
      "start": 148.76,
      "end": 153.92,
      "n_words": 21,
      "start_frame": 3719,
