        "001209.webp",
        "001210.webp",
        "001296.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 55.04,
      "end": 58.04,
      "n_words": 13,
