        "004752.webp",
        "004790.webp",
        "004791.webp",
        "004849.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Dạ rất là thơm luôn á cô Hà.",
      "start": 196.0,
      "end": 197.96,
      "n_words": 8,
      "start_frame": 4900,
      "end_frame": 4949,
      "keyframes": [
        "004907.webp",
        "004908.webp",
        "004925.webp",
        "004943.webp",
        "004944.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi bây giờ á cái phần thịt này đã săn rồi nè, nước sôi rồi cô Hà ơi, thì bây giờ mình chỉ cần cho cái phần chân giò heo qua đây thôi, mình sẽ cho hết phần sả và gia vị này vô nha.",
      "start": 197.96,
