        "000799.webp",
        "000800.webp",
        "000842.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "À chân giò om sấu nấu là ngon, ăn là mê.",
      "start": 35.32,
      "end": 55.04,
      "n_words": 11,
      "start_frame": 883,
      "end_frame": 1376,
      "keyframes": [
