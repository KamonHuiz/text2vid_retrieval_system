        "000605.webp",
        "000625.webp",
        "000626.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đây là món em gửi tặng cô Hà hôm nay.",
      "start": 25.2,
      "end": 27.72,
      "n_words": 10,
      "start_frame": 630,
