      "end": 139.48,
      "n_words": 6,
      "start_frame": 3448,
      "end_frame": 3487,
      "keyframes": [
        "003456.webp",
        "003467.webp",
        "003468.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, cắt lát để chút mình cho mình ăn cùng á.",
