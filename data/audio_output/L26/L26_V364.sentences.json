  "total_words": 840,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.52,
      "end": 12.12,
      "n_words": 4,
      "start_frame": 263,
      "end_frame": 303,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ôi mời quý khách ngồi, cảm ơn quý khách đã ghé đến chơi nhà.",
      "start": 12.12,
      "end": 18.8,
      "n_words": 14,
      "start_frame": 303,
      "end_frame": 470,
      "keyframes": [
        "000328.webp",
        "000356.webp",
        "000357.webp",
        "000380.webp",
        "000403.webp",
        "000404.webp",
        "000436.webp",
        "000469.webp",
        "000470.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Gia chủ có chuẩn bị một món ăn đặc sắc lắm để thết đãi quý khách. Trời, nghe trịnh trọng quá!",
      "start": 18.8,
      "end": 23.36,
      "n_words": 21,
      "start_frame": 470,
      "end_frame": 584,
      "keyframes": [
        "000470.webp",
        "000510.webp",
        "000551.webp",
        "000552.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đâu, cái gì quý?",
      "start": 23.36,
      "end": 24.08,
      "n_words": 4,
      "start_frame": 584,
      "end_frame": 602,
      "keyframes": [
        "000602.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đâu cho khách quý coi có quý thiệt không?",
      "start": 24.08,
      "end": 26.12,
      "n_words": 9,
      "start_frame": 602,
      "end_frame": 653,
      "keyframes": [
        "000602.webp",
        "000652.webp",
        "000653.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trời ơi, một con cá hoành tráng đây nè!",
      "start": 26.12,
      "end": 29.6,
      "n_words": 9,
      "start_frame": 653,
      "end_frame": 740,
      "keyframes": [
        "000653.webp",
        "000676.webp",
        "000699.webp",
        "000700.webp",
        "000718.webp",
        "000736.webp",
        "000737.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đó khách quý thấy không, con cá này da dày, thịt thơm, nấu canh nấu cháo đều ngon hết.",
      "start": 29.6,
      "end": 35.56,
      "n_words": 19,
      "start_frame": 740,
      "end_frame": 889,
      "keyframes": [
        "000755.webp",
        "000774.webp",
        "000775.webp",
        "000831.webp",
        "000888.webp",
        "000889.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cá hanh này thì gia chủ đãi cho khách quý món gì đây?",
      "start": 35.56,
      "end": 39.44,
      "n_words": 13,
      "start_frame": 889,
      "end_frame": 986,
      "keyframes": [
        "000889.webp",
        "000929.webp",
        "000969.webp",
        "000970.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Không không, quý khách là đầu bếp mà, quý khách phải vô nấu dùm.",
      "start": 39.44,
      "end": 43.96,
      "n_words": 14,
      "start_frame": 986,
      "end_frame": 1099,
      "keyframes": [
        "000995.webp",
        "001020.webp",
        "001021.webp",
        "001041.webp",
        "001062.webp",
        "001063.webp",
        "001080.webp",
        "001098.webp",
        "001099.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Trời ơi kìa!",
      "start": 43.96,
      "end": 45.12,
      "n_words": 3,
      "start_frame": 1099,
      "end_frame": 1128,
      "keyframes": [
        "001099.webp",
        "001113.webp",
        "001127.webp",
        "001128.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi thôi được rồi, quý khách nhận lời nấu nhưng mà gia chủ bữa nay sai gì làm đó rồi nha.",
      "start": 45.12,
      "end": 49.72,
      "n_words": 21,
      "start_frame": 1128,
      "end_frame": 1243,
      "keyframes": [
        "001128.webp",
        "001182.webp",
        "001237.webp",
        "001238.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ôi cái chuyện đó là chuyện đương nhiên rồi, canh cá hanh thì nấu chua ngon cơm.",
      "start": 49.72,
      "end": 72.56,
      "n_words": 17,
      "start_frame": 1243,
      "end_frame": 1814,
      "keyframes": [
        "001264.webp",
        "001290.webp",
        "001291.webp",
        "001315.webp",
        "001340.webp",
        "001341.webp",
        "001387.webp",
        "001434.webp",
