        "003184.webp",
        "003230.webp",
        "003231.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Tiếp theo đây là ngó sen.",
      "start": 129.24,
      "end": 130.92,
      "n_words": 6,
      "start_frame": 3231,
      "end_frame": 3273,
      "keyframes": [
        "003231.webp",
        "003256.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi, rồi, bây giờ em cắt khúc cho cô khoảng bốn phân.",
      "start": 130.92,
      "end": 134.0,
      "n_words": 12,
      "start_frame": 3273,
      "end_frame": 3350,
      "keyframes": [
        "003281.webp",
