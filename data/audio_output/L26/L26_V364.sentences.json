        "001484.webp",
        "001533.webp",
        "001548.webp",
        "001603.webp",
        "001658.webp",
        "001659.webp",
        "001745.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 72.56,
      "end": 76.04,
      "n_words": 13,
      "start_frame": 1814,
      "end_frame": 1901,
      "keyframes": [
        "001832.webp",
        "001833.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 76.04,
      "end": 80.16,
      "n_words": 11,
      "start_frame": 1901,
      "end_frame": 2004,
      "keyframes": [
        "001918.webp",
        "002003.webp",
        "002004.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đây, rau nêm em cắt rối giùm cô rau thơm.",
      "start": 80.16,
      "end": 84.12,
      "n_words": 10,
      "start_frame": 2004,
      "end_frame": 2103,
      "keyframes": [
        "002004.webp",
        "002042.webp",
        "002081.webp",
        "002082.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Món này thì mình sẽ sử dụng là rau răm nè, lá lốt nè, rau quế nữa ha.",
      "start": 84.12,
      "end": 89.6,
      "n_words": 18,
      "start_frame": 2103,
      "end_frame": 2240,
      "keyframes": [
        "002143.webp",
        "002204.webp",
        "002205.webp",
        "002221.webp",
        "002238.webp",
        "002239.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ tới lượt khách quý nha, cá hanh rất là ngon nè.",
      "start": 89.88,
      "end": 94.36,
      "n_words": 13,
      "start_frame": 2247,
      "end_frame": 2359,
      "keyframes": [
        "002253.webp",
        "002268.webp",
        "002269.webp",
        "002299.webp",
        "002329.webp",
        "002330.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Sau khi làm sạch rồi đó, mình sẽ khứa trên cá hanh mới được.",
      "start": 94.36,
      "end": 97.28,
      "n_words": 14,
      "start_frame": 2359,
      "end_frame": 2432,
      "keyframes": [
        "002360.webp",
        "002391.webp",
        "002392.webp",
        "002416.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta sẽ dùng gia vị nêm sẵn Ajinomoto lẩu Thái khoảng chừng một muỗng canh, mình sẽ ướp vào trong cá cho cái phần gia vị thấm vào những cái kẻ thịt mà mình đã khứa nè.",
      "start": 97.28,
      "end": 108.04,
      "n_words": 38,
      "start_frame": 2432,
      "end_frame": 2701,
      "keyframes": [
        "002441.webp",
