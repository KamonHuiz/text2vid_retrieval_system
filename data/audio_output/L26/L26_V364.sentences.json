      "start_frame": 3572,
      "end_frame": 3641,
      "keyframes": [
        "003600.webp",
        "003634.webp",
        "003635.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tiếp tục đậu rồng rồi cắt xéo xéo, rồi cà chua bi cắt dọc làm đôi.",
      "start": 145.64,
