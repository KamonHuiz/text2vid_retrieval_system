      "start_frame": 4935,
      "end_frame": 4962,
      "keyframes": [
        "004951.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mình sẽ rửa lên thì bây giờ mình sẽ cho hết gói gia vị nêm sẵn Ajiquik lẩu Thái vô luôn nha.",
      "start": 198.48,
