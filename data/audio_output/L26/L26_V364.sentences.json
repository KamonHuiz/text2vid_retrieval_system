        "003308.webp",
        "003335.webp",
        "003336.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi, rồi, chúng ta sẽ đặt một cái chảo lên trên bếp.",
      "start": 134.0,
      "end": 137.92,
      "n_words": 12,
      "start_frame": 3350,
      "end_frame": 3448,
      "keyframes": [
        "003359.webp",
