      "end_frame": 4030,
      "keyframes": [
        "003980.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi sau khi là mình thắng lấy phần mỡ nha, tỏi băm vào đây mình phi lên cho thơm.",
      "start": 161.2,
