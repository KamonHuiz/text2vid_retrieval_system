        "002647.webp",
        "002699.webp",
        "002700.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Cô sẽ sử dụng một ít rau nêm kia nhét nó vào trong bụng cá.",
      "start": 108.04,
      "end": 111.36,
      "n_words": 15,
      "start_frame": 2701,
      "end_frame": 2784,
      "keyframes": [
        "002722.webp",
        "002744.webp",
        "002745.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ nhét một ít rau thơm vào trong bụng cá để cho thịt cá thơm và ít bị bể sau khi nấu nha.",
      "start": 111.36,
      "end": 117.12,
      "n_words": 30,
      "start_frame": 2784,
      "end_frame": 2928,
      "keyframes": [
        "002800.webp",
        "002856.webp",
        "002857.webp",
        "002906.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta sẽ có một miếng mỡ khổ như thế này.",
      "start": 118.28,
      "end": 120.48,
      "n_words": 11,
      "start_frame": 2957,
      "end_frame": 3012,
      "keyframes": [
        "002957.webp",
        "002983.webp",
        "003009.webp",
        "003010.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ thì cô sẽ cắt mỡ vuông.",
