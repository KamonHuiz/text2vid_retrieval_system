      "end": 109.76,
      "n_words": 11,
      "start_frame": 2679,
      "end_frame": 2744,
      "keyframes": [
        "002687.webp",
        "002688.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Vậy nên ăn tôm thì chúng ta vừa bổ máu nè lại vừa bổ xương nữa.",
      "start": 109.96,
      "end": 113.76,
