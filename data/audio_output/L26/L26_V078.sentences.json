      "start_frame": 3076,
      "end_frame": 3367,
      "keyframes": [
        "003192.webp",
        "003311.webp",
        "003312.webp",
        "003357.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "À, rồi mình trải đều ra, sau đó mình cuốn chặt tay lại.",
      "start": 134.68,
      "end": 145.76,
      "n_words": 13,
      "start_frame": 3367,
      "end_frame": 3644,
