        "003919.webp",
        "003967.webp",
        "003968.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Như vậy là đã xong miếng chả đầu tiên rồi, rất là dễ thương luôn đấy ạ.",
      "start": 159.16,
