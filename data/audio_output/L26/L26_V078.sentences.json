      "end": 53.44,
      "n_words": 8,
      "start_frame": 1294,
      "end_frame": 1336,
      "keyframes": [
        "001299.webp",
        "001300.webp",
        "001336.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hôm nay chúng ta có bắp này, chúng ta làm món chả bắp tôm.",
      "start": 53.72,
      "end": 57.72,
      "n_words": 14,
