        "002528.webp",
        "002570.webp",
        "002571.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cái phần chả bắp này Thanh Phương thấy cái phần nguyên liệu rất là nhiều màu sắc nha.",
      "start": 102.96,
