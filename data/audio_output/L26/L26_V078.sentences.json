      "start_frame": 1004,
      "end_frame": 1044,
      "keyframes": [
        "001030.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
