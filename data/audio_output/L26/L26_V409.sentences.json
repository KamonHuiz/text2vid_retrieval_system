        "001661.webp",
        "001748.webp",
        "001749.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 72.72,
      "end": 76.4,
      "n_words": 11,
