      "end": 25.64,
      "n_words": 6,
      "start_frame": 594,
      "end_frame": 641,
      "keyframes": [
        "000606.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mới tập thôi mà mình làm cái động tác như vậy là các gia vị, các món ăn nó thấm đều vào nhau.",
      "start": 25.64,
