      "end_frame": 1910,
      "keyframes": [
        "001831.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ Thanh Phương chuẩn bị nấu một cái nồi nước.",
      "start": 76.4,
      "end": 78.6,
      "n_words": 11,
