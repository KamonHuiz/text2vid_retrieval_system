        "004993.webp",
        "005015.webp",
        "005016.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Nước nghêu đã được giữ lại rồi bông ơi, cho ba muỗng canh nước nghêu.",
      "start": 200.72,
      "end": 205.76,
