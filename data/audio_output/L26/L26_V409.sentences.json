        "001126.webp",
        "001174.webp",
        "001175.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Mình còn thấy mình làm liền đi anh ha.",
      "start": 47.12,
      "end": 51.24,
      "n_words": 9,
      "start_frame": 1178,
