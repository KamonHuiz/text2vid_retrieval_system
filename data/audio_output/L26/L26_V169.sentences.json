        "002386.webp",
        "002444.webp",
        "002503.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Tuấn sơ chế cho cô các nguyên liệu bên kia nha.",
      "start": 100.12,
      "end": 102.92,
      "n_words": 11,
      "start_frame": 2503,
