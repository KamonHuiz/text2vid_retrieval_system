      "n_words": 29,
      "start_frame": 772,
      "end_frame": 1008,
      "keyframes": [
        "000776.webp",
        "000777.webp",
        "000893.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Minh Tuấn ơi, hôm nay cô rất là thú vị khi mà giới thiệu cho Minh Tuấn và các bạn khán giả một món ăn được làm từ cá tuyết.",
      "start": 40.32,
