      "keyframes": [
        "001200.webp",
        "001262.webp",
        "001325.webp",
        "001326.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cá tuyết là một loài cá mà sống ở vùng nước lạnh và rất sâu ở đại dương, có lẽ vì vậy mà phần thịt cá này vừa chắc và nó không bị tanh, thậm chí nó còn thơm nữa và dày thịt.",
      "start": 53.04,
      "end": 64.96,
      "n_words": 43,
      "start_frame": 1326,
      "end_frame": 1624,
      "keyframes": [
        "001326.webp",
