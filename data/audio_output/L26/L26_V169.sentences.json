        "001811.webp",
        "001842.webp",
        "001843.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Vậy thì bây giờ mình nấu nha để cho Tuấn thẩm định món ăn ngày hôm nay nhé.",
      "start": 73.72,
      "end": 77.28,
