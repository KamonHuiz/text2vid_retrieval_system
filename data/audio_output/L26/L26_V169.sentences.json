        "003455.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tuấn cho cô một cái chảo nhỏ ra đây, Tuấn mở lửa giúp cô luôn.",
      "start": 139.28,
      "end": 142.0,
      "n_words": 15,
