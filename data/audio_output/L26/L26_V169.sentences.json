      "end": 77.56,
      "n_words": 1,
      "start_frame": 1932,
      "end_frame": 1939,
      "keyframes": [
        "001937.webp",
        "001938.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đầu tiên chúng ta sẽ sử dụng 1/3 muỗng cà phê muối, 1/3 muỗng cà phê tiêu, hai muỗng cà phê rượu sake.",
      "start": 77.56,
