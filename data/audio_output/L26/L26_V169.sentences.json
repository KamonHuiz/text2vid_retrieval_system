      "end_frame": 3144,
      "keyframes": [
        "003143.webp",
        "003144.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cải cần tàu này thì mình sẽ xử lý như thế nào cô ạ?",
      "start": 125.76,
