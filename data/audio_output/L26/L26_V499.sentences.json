        "003272.webp",
        "003273.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Su hào thì chúng ta sẽ cắt sợi dày khoảng chừng 7 ly như thế này.",
      "start": 131.12,
      "end": 136.28,
      "n_words": 16,
      "start_frame": 3278,
