      "end": 45.84,
      "n_words": 4,
      "start_frame": 1113,
      "end_frame": 1146,
      "keyframes": [
        "001139.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cảm ơn em.",
      "start": 45.84,
      "end": 48.92,
      "n_words": 3,
      "start_frame": 1146,
      "end_frame": 1223,
      "keyframes": [
        "001170.webp",
        "001171.webp",
        "001195.webp",
        "001220.webp",
        "001221.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chua ngọt thanh vị với cá chép nấu riềng mẻ.",
      "start": 48.92,
      "end": 66.44,
      "n_words": 10,
      "start_frame": 1223,
      "end_frame": 1661,
      "keyframes": [
        "001266.webp",
        "001311.webp",
        "001312.webp",
        "001367.webp",
        "001423.webp",
        "001439.webp",
        "001460.webp",
        "001481.webp",
        "001482.webp",
        "001596.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 66.44,
      "end": 74.88,
      "n_words": 22,
      "start_frame": 1661,
      "end_frame": 1872,
      "keyframes": [
        "001710.webp",
        "001711.webp",
        "001794.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đầu tiên, cá chép mà sau khi mà làm sạch ra thì mình sẽ cắt khúc khoảng chừng 3 phân như thế này, rắc một ít muối lên trên cái thịt cá chép như thế này, nó thấm vào trong cá để làm cho thịt cá khi mình ăn thì nó sẽ săn chắc và ngon.",
      "start": 74.88,
      "end": 87.24,
      "n_words": 56,
      "start_frame": 1872,
      "end_frame": 2181,
      "keyframes": [
        "001877.webp",
