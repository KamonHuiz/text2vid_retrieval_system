        "003372.webp",
        "003397.webp",
        "003398.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Xong phần rau rồi đó, em giúp cho cô một cái chảo lên trên đây để cô chiên cá nha.",
      "start": 136.28,
      "end": 140.76,
      "n_words": 20,
      "start_frame": 3407,
      "end_frame": 3519,
      "keyframes": [
        "003417.webp",
        "003436.webp",
        "003437.webp",
        "003478.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Dạ rồi, mở lửa lên giúp cô luôn.",
      "start": 140.76,
      "end": 143.84,
      "n_words": 8,
      "start_frame": 3519,
      "end_frame": 3596,
      "keyframes": [
        "003520.webp",
        "003521.webp",
        "003569.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cảm ơn Kim Thảo.",
      "start": 143.84,
