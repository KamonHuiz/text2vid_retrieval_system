        "002670.webp",
        "002671.webp",
        "002686.webp",
        "002702.webp",
        "002703.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và bây giờ thì cô sẽ cắt khúc khoảng chừng 3 phân.",
      "start": 110.32,
      "end": 114.0,
      "n_words": 12,
      "start_frame": 2758,
      "end_frame": 2850,
      "keyframes": [
        "002767.webp",
        "002832.webp",
        "002833.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Người Bắc thì có những cái món ăn mà nấu với lại rau cần rất là ngon.",
      "start": 114.0,
      "end": 118.0,
      "n_words": 17,
      "start_frame": 2850,
      "end_frame": 2950,
      "keyframes": [
        "002885.webp",
        "002938.webp",
        "002939.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Món này thì mình cũng nấu theo kiểu cái hương vị của cái món ăn miền Bắc.",
      "start": 118.0,
      "end": 122.6,
      "n_words": 17,
      "start_frame": 2950,
      "end_frame": 3065,
      "keyframes": [
        "002997.webp",
        "003056.webp",
        "003057.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tiếp theo thì hành lá và thì là thì mình cũng sẽ cắt khúc như thế này.",
      "start": 122.6,
      "end": 126.52,
      "n_words": 17,
      "start_frame": 3065,
