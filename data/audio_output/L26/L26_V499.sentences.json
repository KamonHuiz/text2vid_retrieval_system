      "end": 25.68,
      "n_words": 12,
      "start_frame": 557,
      "end_frame": 642,
      "keyframes": [
        "000570.webp",
        "000593.webp",
        "000594.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô Hà sao vậy em?",
      "start": 25.68,
      "end": 26.96,
      "n_words": 5,
      "start_frame": 642,
      "end_frame": 674,
      "keyframes": [
        "000650.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Không có biết làm cá trời ơi!",
      "start": 26.96,
      "end": 29.24,
      "n_words": 7,
      "start_frame": 674,
      "end_frame": 731,
      "keyframes": [
        "000707.webp",
        "000708.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Này làm rồi, sạch sẽ hết rồi thì bây giờ mình rửa lại thôi.",
      "start": 29.52,
      "end": 33.56,
      "n_words": 14,
      "start_frame": 738,
      "end_frame": 839,
      "keyframes": [
        "000763.webp",
        "000819.webp",
        "000820.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hôm nay cô định chiêu đãi em món cá chép mà em rất thích, với lại món cá chép có thịt là giòn nè, ngọt nè và thơm nữa.",
      "start": 33.56,
      "end": 40.6,
      "n_words": 29,
      "start_frame": 839,
      "end_frame": 1015,
      "keyframes": [
        "000849.webp",
        "000878.webp",
        "000879.webp",
        "000901.webp",
        "000924.webp",
        "000925.webp",
        "000950.webp",
        "000975.webp",
        "000976.webp",
        "001014.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chắc chắn sẽ làm một món ngon.",
      "start": 40.6,
      "end": 42.12,
      "n_words": 7,
      "start_frame": 1015,
      "end_frame": 1053,
      "keyframes": [
        "001052.webp",
        "001053.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Vậy thôi đi rửa cá giúp cô đi.",
      "start": 42.12,
      "end": 44.52,
      "n_words": 8,
      "start_frame": 1053,
      "end_frame": 1113,
      "keyframes": [
        "001053.webp",
        "001080.webp",
        "001108.webp",
        "001109.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Dạ, sẵn sàng rồi.",
