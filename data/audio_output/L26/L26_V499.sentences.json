        "001976.webp",
        "002075.webp",
        "002076.webp",
        "002128.webp",
        "002180.webp",
        "002181.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trong lúc mà mình để cho cá chép thấm một chút muối thì mình sẽ sơ chế các loại rau củ.",
      "start": 87.24,
      "end": 92.44,
      "n_words": 21,
      "start_frame": 2181,
      "end_frame": 2311,
      "keyframes": [
        "002181.webp",
        "002245.webp",
        "002310.webp",
        "002311.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cà chua thì đơn giản chúng ta chỉ cần cắt múi cau thôi, ở đây cô sẽ cắt làm sáu.",
      "start": 92.44,
      "end": 96.8,
      "n_words": 20,
      "start_frame": 2311,
      "end_frame": 2420,
      "keyframes": [
        "002311.webp",
        "002346.webp",
        "002382.webp",
        "002383.webp",
        "002401.webp",
        "002419.webp",
        "002420.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cà chua chín đỏ nha sẽ ngon.",
      "start": 96.8,
      "end": 99.56,
      "n_words": 7,
      "start_frame": 2420,
      "end_frame": 2489,
      "keyframes": [
        "002420.webp",
        "002453.webp",
        "002486.webp",
        "002487.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tiếp theo một trái ớt hiểm, chúng ta sẽ đập dập.",
      "start": 99.56,
      "end": 103.08,
      "n_words": 11,
      "start_frame": 2489,
      "end_frame": 2577,
      "keyframes": [
        "002515.webp",
        "002544.webp",
        "002545.webp",
        "002560.webp",
        "002575.webp",
        "002576.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Củ hành tím mình sẽ cắt lát, rồi rau cần chúng ta mua về rửa cho sạch ha.",
      "start": 103.32,
      "end": 110.32,
      "n_words": 18,
