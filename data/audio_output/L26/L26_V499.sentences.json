  "total_words": 974,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.48,
      "end": 12.08,
      "n_words": 4,
      "start_frame": 262,
      "end_frame": 302,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chào cô Hà, chào cô Thảo.",
      "start": 12.08,
      "end": 13.76,
      "n_words": 6,
      "start_frame": 302,
      "end_frame": 344,
      "keyframes": [
        "000322.webp",
        "000344.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hôm nay cô Hà đã chuẩn bị xong nguyên liệu rồi?",
      "start": 14.08,
      "end": 16.32,
      "n_words": 11,
      "start_frame": 352,
      "end_frame": 408,
      "keyframes": [
        "000371.webp",
        "000398.webp",
        "000399.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cũng chưa xong, gần xong thôi.",
