      "end": 18.08,
      "n_words": 6,
      "start_frame": 408,
      "end_frame": 452,
      "keyframes": [
        "000424.webp",
        "000449.webp",
        "000450.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ thì cô nhờ em là tiếp tục làm sạch con cá chép này giùm cô đi.",
      "start": 18.08,
      "end": 22.28,
      "n_words": 18,
      "start_frame": 452,
      "end_frame": 557,
      "keyframes": [
        "000498.webp",
        "000547.webp",
        "000548.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Làm cá hả cô? Không, ấy, hôm nay mình ăn chay đi.",
