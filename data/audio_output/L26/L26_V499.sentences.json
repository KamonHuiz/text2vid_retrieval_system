      "end_frame": 3618,
      "keyframes": [
        "003618.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cô cho vào đây khoảng chừng nửa chén dầu, rồi bây giờ cô sẽ cho cá vô đây chiên.",
      "start": 144.72,
