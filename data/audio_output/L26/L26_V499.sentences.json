      "n_words": 9,
      "start_frame": 4222,
      "end_frame": 4282,
      "keyframes": [
        "004222.webp",
        "004253.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng ta sẽ cho vào đây hai muỗng canh dầu.",
      "start": 171.28,
