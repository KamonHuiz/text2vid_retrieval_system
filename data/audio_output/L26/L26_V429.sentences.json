        "001990.webp",
        "002025.webp",
        "002026.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Mình cá cũng đã khứa xong, bây giờ mình sẽ làm một cái hỗn hợp gia vị để tẩm ướp vào cá nha.",
      "start": 82.56,
      "end": 86.92,
      "n_words": 23,
      "start_frame": 2064,
      "end_frame": 2173,
      "keyframes": [
        "002066.webp",
        "002106.webp",
        "002107.webp",
        "002140.webp",
        "002173.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bước đầu tiên thì Xin sẽ có nửa muỗng cà phê đường, nửa muỗng canh rượu trắng, hai muỗng canh nước tương Phú Sí.",
      "start": 86.92,
      "end": 92.08,
      "n_words": 24,
      "start_frame": 2173,
      "end_frame": 2302,
      "keyframes": [
        "002173.webp",
