        "002598.webp",
        "002599.webp",
        "002656.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Ướp một ít gia vị và rượu trắng vào cá trước để cá thấm vị và thơm hơn.",
      "start": 106.32,
