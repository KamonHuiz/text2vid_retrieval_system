        "000735.webp",
        "000755.webp",
        "000756.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chuyện nhỏ như con thỏ với đầu bếp Xinh đúng không?",
      "start": 30.76,
      "end": 34.4,
      "n_words": 11,
      "start_frame": 769,
      "end_frame": 860,
      "keyframes": [
        "000810.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hôm nay chúng ta sẽ làm một món cá chẽm hấp khác hoàn toàn với hai món mà khán giả đã từng ăn: cá hấp tàu xì ngọt, ngon đậm đà hương vị tự nhiên.",
      "start": 34.4,
      "end": 63.08,
      "n_words": 35,
      "start_frame": 860,
      "end_frame": 1577,
      "keyframes": [
        "000864.webp",
