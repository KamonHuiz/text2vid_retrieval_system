      "start_frame": 454,
      "end_frame": 486,
      "keyframes": [
        "000485.webp",
        "000486.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nhà mình rất thích ăn cá hấp với nước tương, nhưng thường thì mùi không thơm như ngoài nhà hàng.",
      "start": 19.44,
      "end": 26.08,
      "n_words": 20,
      "start_frame": 486,
      "end_frame": 652,
