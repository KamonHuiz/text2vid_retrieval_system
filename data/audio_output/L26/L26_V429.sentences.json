        "000562.webp",
        "000639.webp",
        "000640.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Dầu cũng thích nhưng ăn hoài cũng chán, có cách chế biến nào khác không?",
      "start": 26.08,
      "end": 30.76,
      "n_words": 15,
      "start_frame": 652,
