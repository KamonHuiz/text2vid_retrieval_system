        "001483.webp",
        "001571.webp",
        "001572.webp"
      ],
      "keyframe_count": 23
    },
    {
      "text": "Chào các bạn khán giả đến với chương trình Món ngon mỗi ngày được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 63.08,
      "end": 68.92,
      "n_words": 22,
      "start_frame": 1577,
      "end_frame": 1723,
      "keyframes": [
        "001649.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bước đầu tiên để làm món này, chúng ta sẽ sơ chế và tẩm ướp cá nha.",
      "start": 68.92,
      "end": 72.56,
      "n_words": 17,
      "start_frame": 1723,
      "end_frame": 1814,
      "keyframes": [
