        "004306.webp",
        "004384.webp",
        "004385.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và bây giờ cái phần sốt của chúng ta đã được rồi thì bây giờ chúng ta sẽ tắt bếp.",
      "start": 175.44,
