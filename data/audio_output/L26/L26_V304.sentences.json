      "end_frame": 356,
      "keyframes": [
        "000354.webp",
        "000355.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trời ơi sao mà dạo này nóng quá anh ơi.",
      "start": 14.24,
      "end": 16.32,
      "n_words": 10,
      "start_frame": 356,
      "end_frame": 408,
      "keyframes": [
        "000382.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạo này anh không thấy em hình như mập ra phải?",
      "start": 16.32,
      "end": 18.68,
      "n_words": 11,
      "start_frame": 408,
