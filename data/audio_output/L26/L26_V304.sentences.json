      "end": 19.4,
      "n_words": 3,
      "start_frame": 467,
      "end_frame": 485,
      "keyframes": [
        "000480.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Anh chắc là tại nóng quá chảy mỡ luôn rồi đó.",
