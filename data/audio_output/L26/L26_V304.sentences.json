      "end": 21.88,
      "n_words": 11,
      "start_frame": 485,
      "end_frame": 547,
      "keyframes": [
        "000497.webp",
        "000498.webp",
        "000525.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh chính vì nóng quá anh mới sắm đi chợ nè, có mấy trái cây vậy lượm về hết luôn cho anh gọn, ăn cho nó mát.",
      "start": 21.88,
      "end": 27.48,
      "n_words": 27,
      "start_frame": 547,
      "end_frame": 687,
      "keyframes": [
        "000552.webp",
        "000553.webp",
        "000620.webp",
        "000687.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ em chờ tí xíu để anh gọt trái cây, anh bày cái dĩa cho em, đãi em một dĩa trái cây ướp lạnh luôn.",
      "start": 27.48,
      "end": 32.32,
      "n_words": 26,
      "start_frame": 687,
      "end_frame": 808,
      "keyframes": [
        "000687.webp",
        "000688.webp",
        "000747.webp",
        "000806.webp",
        "000807.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Mà anh Vũ ơi, gọt trái cây để em gọt chứ đầu bếp ai gọt trái cây?",
      "start": 32.32,
      "end": 35.84,
      "n_words": 17,
      "start_frame": 808,
      "end_frame": 896,
      "keyframes": [
        "000879.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Phải làm một cái món gì đó từ trái cây mới hấp dẫn.",
      "start": 35.84,
      "end": 38.32,
      "n_words": 13,
      "start_frame": 896,
      "end_frame": 958,
      "keyframes": [
        "000951.webp",
        "000952.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thì trái cây mình làm cocktail thì bình thường rồi, nhà mình làm xà lách đi, mình thưởng thức một món xà lách Âu ở Việt Nam luôn.",
