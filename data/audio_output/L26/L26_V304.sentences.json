      "end_frame": 2929,
      "keyframes": [
        "002800.webp",
        "002801.webp",
        "002869.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn rồi hôm rồi đó, bây giờ em rút ra cái chén đi anh đếm rồi đó nha.",
      "start": 117.16,
