      "end_frame": 3098,
      "keyframes": [
        "003097.webp",
        "003098.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nhờ em tay vô và em bẻ những cái hạt đó khoảng làm hai làm ba thôi.",
      "start": 123.92,
      "end": 131.0,
      "n_words": 17,
