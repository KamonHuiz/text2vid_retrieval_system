      "end": 103.88,
      "n_words": 9,
      "start_frame": 2532,
      "end_frame": 2597,
      "keyframes": [
        "002565.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Như vậy là một trái cà chua thì chúng ta sẽ bổ múi cau nè, còn một trái còn lại chúng ta sẽ cắt hạt lựu.",
      "start": 103.88,
