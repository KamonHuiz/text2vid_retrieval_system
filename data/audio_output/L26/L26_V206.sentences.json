      "keyframes": [
        "002193.webp",
        "002219.webp",
        "002220.webp",
        "002266.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trong lúc Minh Phương đang phi tỏi, chúng ta sẽ xắt phần cà chua.",
      "start": 92.4,
      "end": 96.08,
      "n_words": 14,
      "start_frame": 2310,
      "end_frame": 2402,
      "keyframes": [
        "002312.webp",
