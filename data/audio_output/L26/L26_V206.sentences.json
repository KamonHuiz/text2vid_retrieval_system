      "keyframes": [
        "002885.webp",
        "002886.webp",
        "002926.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tỏi phi rất là thơm ngon rồi, Phước Hương sẽ lấy một phần ba tỏi phi để chúng ta ướp vào trong phần đầu cá hồi.",
      "start": 117.12,
      "end": 123.0,
      "n_words": 26,
      "start_frame": 2928,
