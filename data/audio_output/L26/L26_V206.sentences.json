        "003979.webp",
        "004066.webp",
        "004067.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần cà chua này chúng ta xào sơ thôi, cho phần cà chua này ra một cái chén.",
      "start": 162.68,
      "end": 167.16,
