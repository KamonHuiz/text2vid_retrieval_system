        "001782.webp",
        "001799.webp",
        "001800.webp",
        "001813.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Thế thì có rất là nhiều chất beta-carotene mà người ta hay gọi là tiền vitamin A nữa đó.",
      "start": 73.04,
      "end": 77.84,
      "n_words": 19,
      "start_frame": 1826,
      "end_frame": 1946,
      "keyframes": [
        "001827.webp",
        "001828.webp",
        "001890.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Beta-carotene tốt cho thị lực của mắt nè, tốt cho hệ miễn dịch của cơ thể chúng ta.",
      "start": 77.84,
      "end": 82.6,
      "n_words": 18,
      "start_frame": 1946,
      "end_frame": 2065,
