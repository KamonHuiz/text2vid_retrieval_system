      "keyframes": [
        "001693.webp",
        "001694.webp",
        "001712.webp",
        "001731.webp",
        "001732.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Với món canh ngày hôm nay thì còn có nguyên liệu là cà chua và măng chua nè.",
      "start": 69.28,
      "end": 73.04,
      "n_words": 18,
      "start_frame": 1732,
      "end_frame": 1826,
      "keyframes": [
