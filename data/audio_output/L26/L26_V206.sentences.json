        "001021.webp",
        "001056.webp",
        "001057.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ chọn những cái đầu cá hồi có màu xanh ánh bạc nè, mắt cá còn trong, thịt cá còn màu hồng cam, vậy là cá còn tươi.",
      "start": 42.4,
      "end": 49.6,
      "n_words": 30,
      "start_frame": 1060,
      "end_frame": 1240,
      "keyframes": [
        "001086.webp",
