        "002380.webp",
        "002398.webp",
        "002399.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Một trái thì bây giờ Phước Hương sẽ cắt múi cau.",
      "start": 96.08,
      "end": 98.6,
      "n_words": 11,
      "start_frame": 2402,
      "end_frame": 2465,
      "keyframes": [
        "002431.webp",
        "002464.webp",
        "002465.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ Hương sẽ cho phần cà chua cắt múi cau qua đây.",
      "start": 98.6,
      "end": 101.28,
      "n_words": 13,
      "start_frame": 2465,
      "end_frame": 2532,
      "keyframes": [
        "002465.webp",
        "002497.webp",
        "002530.webp",
        "002531.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trái tiếp theo thì Phước Hương sẽ cắt nhỏ.",
