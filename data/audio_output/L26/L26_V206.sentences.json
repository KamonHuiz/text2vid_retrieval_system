        "001147.webp",
        "001178.webp",
        "001179.webp",
        "001209.webp",
        "001240.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Sau khi các bạn mua về thì chúng ta rửa sạch và bây giờ Phước Hương cũng đã chặt ra thành từng miếng vừa ăn rồi.",
      "start": 49.6,
      "end": 54.68,
      "n_words": 26,
      "start_frame": 1240,
      "end_frame": 1367,
      "keyframes": [
        "001240.webp",
        "001241.webp",
        "001282.webp",
        "001323.webp",
        "001324.webp",
        "001342.webp",
        "001361.webp",
        "001362.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đầu tiên Phước Hương sẽ cho vào đây là một muỗng cà phê muối, một muỗng canh nước mắm.",
      "start": 54.68,
      "end": 59.04,
      "n_words": 19,
      "start_frame": 1367,
      "end_frame": 1476,
      "keyframes": [
        "001384.webp",
        "001407.webp",
        "001408.webp",
        "001425.webp",
        "001443.webp",
        "001444.webp",
        "001462.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bây giờ Phước Hương sẽ đập dập hai trái ớt hiểm để chúng ta cho vào cá luôn rồi và bây giờ chúng ta sẽ trộn đều lên. Chúng ta sẽ ướp cá trong bao lâu?",
      "start": 59.04,
      "end": 66.0,
      "n_words": 36,
      "start_frame": 1476,
      "end_frame": 1650,
      "keyframes": [
        "001481.webp",
        "001482.webp",
        "001496.webp",
        "001511.webp",
        "001512.webp",
        "001602.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phước Hương ướp cá từ 10 tới 15 phút là cá đã thấm.",
      "start": 66.16,
      "end": 69.28,
      "n_words": 13,
