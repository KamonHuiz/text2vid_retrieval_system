      "end_frame": 979,
      "keyframes": [
        "000773.webp",
        "000774.webp",
        "000880.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nguyên liệu chính của món ăn ngày hôm nay đó chính là đầu cá hồi.",
      "start": 39.16,
      "end": 42.4,
      "n_words": 15,
