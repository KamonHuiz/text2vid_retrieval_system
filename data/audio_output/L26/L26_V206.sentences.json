        "002038.webp",
        "002064.webp",
        "002065.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Phước Hương sẽ đặt cái chảo lên trên bếp để chúng ta phi tỏi, cho dầu ăn vào chảo.",
      "start": 82.6,
      "end": 86.76,
      "n_words": 19,
      "start_frame": 2065,
      "end_frame": 2169,
      "keyframes": [
        "002065.webp",
