        "003426.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta sẽ còn một phần ba tỏi phi trong chảo.",
      "start": 138.88,
      "end": 141.2,
      "n_words": 11,
      "start_frame": 3472,
