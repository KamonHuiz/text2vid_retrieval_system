        "002688.webp",
        "002715.webp",
        "002716.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Phần rau nêm Phước Hương sẽ cắt nhỏ, rau nêm thì mình có ngò gai và rau om.",
      "start": 108.64,
      "end": 115.08,
