        "002828.webp",
        "002829.webp",
        "002857.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ thì chúng ta đã có phần tỏi phi rất là thơm.",
      "start": 115.08,
      "end": 117.12,
      "n_words": 13,
