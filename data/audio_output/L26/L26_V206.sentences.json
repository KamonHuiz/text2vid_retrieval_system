        "004160.webp",
        "004173.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Tiếp theo Phước Hương sẽ đặt lên trên bếp một cái nồi khoảng 1.5 lít nước.",
      "start": 167.16,
      "end": 171.24,
