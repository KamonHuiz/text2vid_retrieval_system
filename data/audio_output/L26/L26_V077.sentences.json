        "004805.webp",
        "004837.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đối với món này thì chúng ta nên dùng gà giòn thì sẽ rất là ngon hơn nhiều.",
      "start": 194.24,
      "end": 199.0,
      "n_words": 18,
      "start_frame": 4856,
      "end_frame": 4975,
      "keyframes": [
        "004870.webp",
