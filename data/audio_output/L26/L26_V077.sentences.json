        "002581.webp",
        "002625.webp",
        "002626.webp"
      ],
      "keyframe_count": 23
    },
    {
      "text": "Đây, cắt lá xong chúng ta cho vô chúng ta giã luôn.",
      "start": 105.12,
      "end": 112.16,
      "n_words": 12,
      "start_frame": 2628,
      "end_frame": 2804,
      "keyframes": [
        "002662.webp",
        "002699.webp",
        "002700.webp",
        "002750.webp",
        "002801.webp",
        "002802.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các bạn chúng ta cũng nên nhớ nha, chúng ta nên cắt nhỏ sả, gừng và các loại rau thơm để khi giã được mau hơn và đặc biệt không còn sót cái sợi xơ của sả nha các bạn.",
      "start": 112.16,
      "end": 121.4,
      "n_words": 40,
      "start_frame": 2804,
      "end_frame": 3035,
      "keyframes": [
        "002828.webp",
        "002855.webp",
        "002856.webp",
        "002944.webp",
        "003033.webp",
        "003034.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ thì chúng ta bắt chảo lên sẽ rang năm hạt dỗi và khoảng một muỗng cà phê mắc khén này.",
      "start": 121.4,
