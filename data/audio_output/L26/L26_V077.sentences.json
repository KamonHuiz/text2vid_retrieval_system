        "003712.webp",
        "003713.webp",
        "003758.webp"
      ],
      "keyframe_count": 20
    },
    {
      "text": "Chúng ta cho vào trong cối, bây giờ thì chúng ta sẽ giã cho nhuyễn trước.",
      "start": 152.08,
      "end": 159.28,
      "n_words": 16,
      "start_frame": 3802,
      "end_frame": 3982,
