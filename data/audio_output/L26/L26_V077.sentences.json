      "n_words": 21,
      "start_frame": 817,
      "end_frame": 1015,
      "keyframes": [
        "000864.webp",
        "000865.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam. Và thưa các bạn, món ăn ngày hôm nay, chúng ta nguyên liệu chính là thịt gà.",
      "start": 40.6,
      "end": 49.28,
      "n_words": 28,
      "start_frame": 1015,
      "end_frame": 1232,
      "keyframes": [
        "001049.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và thịt gà này phải là thịt gà da giòn nha.",
      "start": 49.28,
      "end": 52.28,
      "n_words": 11,
      "start_frame": 1232,
      "end_frame": 1307,
      "keyframes": [
        "001234.webp",
        "001235.webp",
        "001270.webp",
        "001305.webp",
        "001306.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và một nguyên liệu nữa để tạo nên mùi vị đặc trưng của món ăn ngày hôm nay thì đó là chẩm chéo.",
      "start": 52.28,
      "end": 57.44,
      "n_words": 23,
      "start_frame": 1307,
      "end_frame": 1436,
      "keyframes": [
        "001357.webp",
        "001408.webp",
        "001409.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đây là những hạt gia vị gì?",
      "start": 57.44,
      "end": 59.08,
      "n_words": 7,
      "start_frame": 1436,
      "end_frame": 1477,
      "keyframes": [
        "001446.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Gì?",
      "start": 59.08,
      "end": 61.44,
      "n_words": 1,
      "start_frame": 1477,
      "end_frame": 1536,
      "keyframes": [
        "001484.webp",
        "001485.webp",
        "001536.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cái này là hạt dổi nè.",
      "start": 61.44,
      "end": 62.88,
      "n_words": 6,
      "start_frame": 1536,
      "end_frame": 1572,
      "keyframes": [
        "001536.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hay vậy ta!",
      "start": 62.88,
      "end": 63.84,
      "n_words": 3,
      "start_frame": 1572,
      "end_frame": 1596,
      "keyframes": [
        "001588.webp",
        "001589.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Còn cái này là mắc khén.",
      "start": 63.84,
      "end": 67.64,
      "n_words": 6,
      "start_frame": 1596,
      "end_frame": 1691,
      "keyframes": [
        "001619.webp",
        "001649.webp",
        "001650.webp",
        "001671.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mắc khén đúng rồi.",
      "start": 67.64,
      "end": 69.24,
      "n_words": 4,
      "start_frame": 1691,
      "end_frame": 1731,
      "keyframes": [
        "001692.webp",
        "001693.webp",
        "001712.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thưa các bạn, bây giờ chúng ta cùng thực hiện món gà xào chẩm chéo.",
      "start": 69.24,
      "end": 73.04,
      "n_words": 15,
      "start_frame": 1731,
      "end_frame": 1826,
      "keyframes": [
        "001732.webp",
        "001733.webp",
        "001778.webp",
        "001823.webp",
        "001824.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ở đây có nghĩa là \"chẩm\" những cái món chấm đi ạ, còn \"chéo\" nghĩa là các loại rau gia vị.",
      "start": 73.28,
      "end": 78.0,
      "n_words": 21,
      "start_frame": 1832,
      "end_frame": 1950,
      "keyframes": [
        "001853.webp",
        "001882.webp",
        "001883.webp",
        "001915.webp",
        "001948.webp",
        "001949.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thưa các bạn, ngoài ngò rí và ngò gai, chúng ta còn có thêm húng lủi nha.",
      "start": 78.0,
      "end": 83.04,
      "n_words": 17,
      "start_frame": 1950,
      "end_frame": 2076,
      "keyframes": [
        "002012.webp",
        "002076.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Xíu em cắt nhỏ húng lủi giùm anh luôn nha và sả đây, chúng ta khoảng hai cây thôi, sau đó chúng ta sẽ cắt nhỏ khoảng ba lát gừng thôi, chúng ta muốn cắt nhỏ sáu tép tỏi.",
      "start": 83.04,
      "end": 105.12,
      "n_words": 39,
      "start_frame": 2076,
      "end_frame": 2628,
      "keyframes": [
        "002076.webp",
        "002077.webp",
