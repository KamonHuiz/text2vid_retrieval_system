        "004374.webp",
        "004375.webp"
      ],
      "keyframe_count": 23
    },
    {
      "text": "Chúng ta chỉ cần cho vào đây một chút xíu giấm là chúng ta sẽ có trọn vị.",
      "start": 178.32,
      "end": 182.4,
      "n_words": 18,
      "start_frame": 4458,
      "end_frame": 4560,
      "keyframes": [
        "004467.webp",
        "004559.webp",
        "004560.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trộn đều lên.",
      "start": 182.4,
      "end": 183.52,
      "n_words": 3,
      "start_frame": 4560,
      "end_frame": 4588,
      "keyframes": [
        "004560.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Món này mà lên Tây Bắc thường là thấy là những cái món thịt nướng chấm với lại chẩm chéo này rất là ngon luôn đó anh Vũ ơi.",
