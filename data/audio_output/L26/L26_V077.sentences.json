        "003142.webp",
        "003194.webp",
        "003195.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trong hạt dỗi và mắc khén thì có chứa một hợp chất giúp kháng khuẩn và kích thích hệ tiêu hóa rất là tốt cho sức khỏe đấy ạ.",
      "start": 127.84,
      "end": 133.92,
      "n_words": 29,
      "start_frame": 3196,
      "end_frame": 3348,
      "keyframes": [
        "003270.webp",
        "003345.webp",
        "003346.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ta rang cho dậy mùi thơm ha.",
      "start": 133.92,
      "end": 135.72,
      "n_words": 7,
      "start_frame": 3348,
      "end_frame": 3393,
      "keyframes": [
        "003369.webp",
        "003392.webp",
        "003393.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho vào trong cối, thường là người ta sẽ dùng cái ớt thóc, tức là những ớt xanh bé bé người ta sẽ nướng, còn mình ở gia đình thì chúng ta có thể cho vào chảo chúng ta rang không dầu nha các bạn.",
      "start": 135.72,
      "end": 152.08,
      "n_words": 45,
      "start_frame": 3393,
      "end_frame": 3802,
      "keyframes": [
        "003393.webp",
