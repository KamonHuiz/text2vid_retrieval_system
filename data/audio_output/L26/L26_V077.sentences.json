        "004732.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đúng vậy, thịt gà chúng ta mua về làm sạch cho vào trong cái tô.",
      "start": 189.44,
      "end": 194.24,
      "n_words": 15,
