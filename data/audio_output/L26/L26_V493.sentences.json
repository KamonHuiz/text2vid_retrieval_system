      "end_frame": 2369,
      "keyframes": [
        "002323.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, cái phần táo đỏ nè, táo đỏ cô ta cũng sẽ ngâm cho nó mềm nở như thế này.",
      "start": 94.76,
