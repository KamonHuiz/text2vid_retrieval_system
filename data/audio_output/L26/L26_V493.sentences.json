        "002456.webp",
        "002477.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nấm rơm thì mua về cắt gốc rửa sạch, sau đó mình sẽ khứa chữ thập như thế này.",
      "start": 99.88,
