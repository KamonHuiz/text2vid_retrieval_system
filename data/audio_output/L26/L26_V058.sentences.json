        "005007.webp",
        "005008.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vậy bây giờ là mình phải đợi hả?",
      "start": 201.4,
      "end": 203.04,
      "n_words": 8,
      "start_frame": 5035,
      "end_frame": 5076,
      "keyframes": [
        "005042.webp",
        "005076.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khi nào mình mới cho tôm vào được?",
      "start": 203.04,
      "end": 204.56,
      "n_words": 8,
      "start_frame": 5076,
      "end_frame": 5114,
      "keyframes": [
        "005076.webp",
        "005077.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khi nào mà Kim Thảo thấy là khoai mì trong lại và nổi lên trên mặt thì là khoai mì chín, thì mình sẽ cho tôm vào tại vì tôm rất là mau chín.",
      "start": 204.56,
      "end": 211.56,
      "n_words": 34,
      "start_frame": 5114,
      "end_frame": 5289,
      "keyframes": [
        "005116.webp",
        "005156.webp",
        "005157.webp",
        "005192.webp",
        "005227.webp",
        "005228.webp",
        "005270.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "À, sau khi khoai mì trong trở lại thì Long sẽ cho cái phần tôm viên vào, mình cho lần lượt nhẹ nhẹ vào để viên nó tròn nha.",
      "start": 211.56,
      "end": 220.08,
      "n_words": 29,
      "start_frame": 5289,
      "end_frame": 5502,
      "keyframes": [
        "005312.webp",
        "005313.webp",
        "005359.webp",
        "005405.webp",
        "005406.webp",
        "005456.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Long cho vào nồi canh một muỗng rưỡi cà phê hạt nêm Ajinomoto ngon heo, hai muỗng cà phê đường, một muỗng cà phê bột ngọt Ajinomoto và cuối cùng chúng ta sẽ nấu nhỏ lửa trong vòng 5 phút.",
      "start": 220.08,
      "end": 231.92,
      "n_words": 40,
      "start_frame": 5502,
      "end_frame": 5798,
      "keyframes": [
        "005506.webp",
