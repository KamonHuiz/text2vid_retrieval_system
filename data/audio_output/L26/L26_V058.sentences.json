        "004237.webp",
        "004265.webp",
        "004266.webp",
        "004354.webp",
        "004442.webp",
        "004443.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Mà đặc biệt là khi ở nhà mình có các bạn nhỏ thì những công đoạn như thế này thì Kim Thảo nghĩ rằng là các bạn sẽ rất thích.",
      "start": 177.76,
      "end": 183.36,
      "n_words": 30,
      "start_frame": 4444,
      "end_frame": 4584,
      "keyframes": [
        "004477.webp",
        "004512.webp",
        "004513.webp",
        "004553.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Để làm xong vừa rồi Long với Thảo đã làm xong phần viên tôm và viên khoai mì, bây giờ mình sẽ chuẩn bị một cái nồi để mình tiến hành nấu canh.",
      "start": 183.36,
      "end": 193.04,
      "n_words": 33,
      "start_frame": 4584,
      "end_frame": 4826,
      "keyframes": [
        "004593.webp",
