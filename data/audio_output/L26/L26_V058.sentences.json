  "sentences": [
    {
      "text": "Món ngon mỗi ngày: canh khoai mì nấu tôm dẻo mềm, dai dai thơm, thanh quyện sánh.",
      "start": 10.48,
      "end": 39.84,
      "n_words": 17,
