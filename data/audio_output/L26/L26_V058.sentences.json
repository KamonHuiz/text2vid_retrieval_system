        "003752.webp",
        "003782.webp",
        "003783.webp",
        "003827.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Xong rồi nấu ăn rất là vui khi mà chúng ta có thể sáng tạo một chút xíu trong các nguyên liệu để mà mình làm nên món ăn đúng không nè?",
      "start": 154.0,
      "end": 177.76,
      "n_words": 32,
      "start_frame": 3850,
      "end_frame": 4444,
      "keyframes": [
        "003871.webp",
        "003872.webp",
        "003904.webp",
        "003937.webp",
        "003938.webp",
        "003999.webp",
        "004061.webp",
