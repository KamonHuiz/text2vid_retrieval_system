        "002489.webp",
        "002524.webp",
        "002525.webp",
        "002567.webp",
        "002609.webp",
        "002610.webp",
        "002628.webp",
        "002647.webp",
        "002648.webp",
        "002677.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Chúng ta có khoai mì kết hợp với tôm; Tôm thì bên cạnh việc cung cấp protein cho cơ thể thì có thể cung cấp kali, và kali khi kết hợp cùng với tinh bột đề kháng thì sẽ cho một hệ tiêu hóa khỏe mạnh đó quý vị.",
      "start": 107.36,
      "end": 119.84,
      "n_words": 49,
      "start_frame": 2684,
      "end_frame": 2996,
      "keyframes": [
        "002706.webp",
        "002707.webp",
        "002807.webp",
        "002907.webp",
        "002908.webp",
        "002951.webp",
        "002995.webp",
        "002996.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trong khi chờ đợi thì Kim Thảo giúp Long là mình cắt cái hành ngò nha để lát mình nêm vào canh.",
      "start": 119.84,
      "end": 140.28,
      "n_words": 22,
      "start_frame": 2996,
      "end_frame": 3507,
      "keyframes": [
        "002996.webp",
        "003048.webp",
        "003101.webp",
        "003102.webp",
        "003149.webp",
        "003196.webp",
        "003197.webp",
        "003236.webp",
        "003275.webp",
        "003276.webp",
        "003322.webp",
        "003369.webp",
        "003370.webp",
        "003423.webp",
        "003477.webp",
        "003478.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Bây giờ sẽ là cuộc thi vo viên: một bên vo khoai mì, một bên vo tôm.",
      "start": 140.28,
      "end": 154.0,
      "n_words": 17,
      "start_frame": 3507,
      "end_frame": 3850,
      "keyframes": [
        "003513.webp",
        "003548.webp",
