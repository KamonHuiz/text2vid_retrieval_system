        "005622.webp",
        "005652.webp",
        "005653.webp",
        "005724.webp",
        "005796.webp",
        "005797.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Những viên tôm đã nổi lên rồi, điều đó có nghĩa là canh của mình đã chín.",
      "start": 231.92,
      "end": 235.16,
      "n_words": 17,
      "start_frame": 5798,
      "end_frame": 5879,
      "keyframes": [
        "005817.webp",
        "005837.webp",
        "005838.webp",
        "005856.webp",
        "005875.webp",
        "005876.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chính xác, tắt bếp thôi quý vị!",
      "start": 235.16,
      "end": 237.44,
      "n_words": 7,
      "start_frame": 5879,
      "end_frame": 5936,
      "keyframes": [
        "005912.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và các bạn thân mến, rất đơn giản để có thể xem lại công thức trọn vẹn của chương trình ngày hôm nay, chỉ cần là quét mã QR trên màn hình của chúng tôi nhé.",
      "start": 237.44,
      "end": 246.96,
      "n_words": 36,
      "start_frame": 5936,
      "end_frame": 6174,
      "keyframes": [
        "005948.webp",
