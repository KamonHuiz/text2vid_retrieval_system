        "000816.webp",
        "000906.webp",
        "000996.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Chào quý vị khán giả đã quay trở lại với chương trình Món ngon mỗi ngày - Nấu chuẩn an lành.",
      "start": 39.84,
      "end": 44.0,
      "n_words": 21,
      "start_frame": 996,
      "end_frame": 1100,
      "keyframes": [
        "000996.webp",
        "000997.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam và hôm nay, Hoàng Long xin được phép chia sẻ cùng các bạn và khán giả một món ăn rất là đơn giản nhưng rất là đặc biệt, đó là món canh khoai mì nấu tôm.",
      "start": 44.0,
      "end": 56.76,
      "n_words": 47,
      "start_frame": 1100,
      "end_frame": 1419,
      "keyframes": [
        "001207.webp",
        "001418.webp",
        "001419.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đối với món canh khoai mì nấu tôm này, chúng ta sẽ có hai nguyên liệu chính đó là khoai mì và tôm, và sẽ kết hợp lại với nhau bằng giò sống.",
      "start": 56.76,
      "end": 63.52,
      "n_words": 33,
      "start_frame": 1419,
      "end_frame": 1588,
      "keyframes": [
        "001419.webp",
        "001440.webp",
        "001461.webp",
        "001462.webp",
        "001518.webp",
        "001574.webp",
        "001575.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Ồ, chúng ta chọn khoai mì bột tươi, mập, gọt vỏ mỡ màng để khoai mì không bị sượng, vào xơ.",
      "start": 63.52,
      "end": 71.12,
      "n_words": 21,
      "start_frame": 1588,
      "end_frame": 1778,
      "keyframes": [
        "001596.webp",
        "001618.webp",
        "001619.webp",
        "001699.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đối với khoai mì thì Long đã sơ chế, đầu tiên là mình gọt vỏ, mình ngâm với nước lạnh.",
      "start": 71.12,
      "end": 75.76,
      "n_words": 20,
      "start_frame": 1778,
      "end_frame": 1894,
      "keyframes": [
        "001779.webp",
        "001780.webp",
        "001801.webp",
        "001822.webp",
        "001823.webp",
        "001860.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ ngâm khoai mì vài giờ sau khi gọt vỏ để khoai mì không bị đắng; Mình sẽ tán đều ra và chúng ta phải vắt bỏ nước vàng khoai mì để loại bỏ chất độc.",
      "start": 75.76,
      "end": 84.24,
      "n_words": 38,
      "start_frame": 1894,
      "end_frame": 2106,
      "keyframes": [
        "001897.webp",
        "001898.webp",
        "001943.webp",
        "001989.webp",
        "001990.webp",
        "002021.webp",
        "002053.webp",
        "002054.webp",
        "002079.webp",
        "002105.webp",
        "002106.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đầu tiên Long cho vào đây là nửa muỗng cà phê hạt nêm Ajinomoto ngon heo.",
      "start": 84.24,
      "end": 87.6,
      "n_words": 16,
      "start_frame": 2106,
      "end_frame": 2190,
      "keyframes": [
        "002106.webp",
        "002148.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khoai mì là một loại tinh bột rất đặc biệt, hay còn được gọi là tinh bột đề kháng, cung cấp một hệ vi sinh tốt cho đường ruột.",
      "start": 87.6,
      "end": 95.32,
      "n_words": 29,
      "start_frame": 2190,
      "end_frame": 2383,
      "keyframes": [
        "002191.webp",
        "002192.webp",
        "002213.webp",
        "002234.webp",
        "002235.webp",
        "002304.webp",
        "002374.webp",
        "002375.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Tôm thì Long sẽ cho vào đây thêm một phần giò sống, tiếp tục Long cho vào đây là một muỗng cà phê hành tím băm, nửa muỗng cà phê hạt nêm Ajinomoto ngon heo và một chút xíu tiêu, và chúng ta sẽ trộn đều.",
      "start": 95.32,
      "end": 107.36,
      "n_words": 46,
      "start_frame": 2383,
      "end_frame": 2684,
      "keyframes": [
        "002414.webp",
