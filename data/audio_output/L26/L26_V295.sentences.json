        "000733.webp",
        "000771.webp",
        "000772.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Có biết làm sao không, tôi ra tôi gom không còn một cái cánh gà nào hết.",
      "start": 30.88,
      "end": 35.68,
