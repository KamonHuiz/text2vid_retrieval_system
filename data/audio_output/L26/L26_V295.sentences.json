        "000846.webp",
        "000877.webp",
        "000878.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "À vậy là Phước Hưng mua hết chứ ai nữa, hèn chi.",
      "start": 35.68,
      "end": 40.76,
      "n_words": 12,
      "start_frame": 892,
