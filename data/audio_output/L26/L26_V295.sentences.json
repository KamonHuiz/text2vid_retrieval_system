      "keyframes": [
        "003653.webp",
        "003654.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đúng rồi đó Minh Phương, như vậy thì món ăn sẽ giòn và chín đều hơn.",
      "start": 148.0,
      "end": 151.76,
