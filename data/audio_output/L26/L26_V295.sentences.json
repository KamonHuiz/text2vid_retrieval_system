      "start_frame": 1827,
      "end_frame": 1990,
      "keyframes": [
        "001908.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ở đây có cà chua, dưa leo và xà lách rồi, nhờ Minh Phương cắt giùm nha.",
      "start": 79.6,
      "end": 84.56,
      "n_words": 17,
      "start_frame": 1990,
      "end_frame": 2114,
