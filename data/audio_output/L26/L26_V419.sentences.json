      "end_frame": 6354,
      "keyframes": [
        "006318.webp",
        "006319.webp",
        "006337.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình sẽ đặt lên đây một ít bột húng lủi.",
