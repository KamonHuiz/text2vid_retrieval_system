      "end": 188.24,
      "n_words": 4,
      "start_frame": 4676,
      "end_frame": 4706,
      "keyframes": [
        "004682.webp",
        "004683.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Úa đẹp quá!",
      "start": 188.24,
      "end": 191.48,
      "n_words": 3,
      "start_frame": 4706,
      "end_frame": 4787,
      "keyframes": [
        "004735.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi bây giờ mình sẽ lấy cái bánh này ra mình sẽ hạ nhiệt bánh.",
      "start": 191.48,
      "end": 197.52,
      "n_words": 15,
      "start_frame": 4787,
      "end_frame": 4938,
      "keyframes": [
        "004788.webp",
