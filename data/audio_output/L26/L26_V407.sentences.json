      "end": 28.44,
      "n_words": 1,
      "start_frame": 682,
      "end_frame": 711,
      "keyframes": [
        "000687.webp",
        "000708.webp",
        "000709.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi vậy thì em có thích ăn bánh không?",
      "start": 28.44,
      "end": 30.4,
      "n_words": 9,
      "start_frame": 711,
      "end_frame": 760,
      "keyframes": [
        "000734.webp",
        "000759.webp",
        "000760.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ quá thích.",
      "start": 30.4,
      "end": 31.12,
      "n_words": 3,
      "start_frame": 760,
      "end_frame": 778,
      "keyframes": [
        "000760.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi vậy thì hôm nay thì cô sẽ tặng em một món bánh nha.",
      "start": 31.12,
      "end": 35.2,
      "n_words": 14,
      "start_frame": 778,
      "end_frame": 880,
      "keyframes": [
        "000790.webp",
        "000820.webp",
        "000821.webp",
        "000869.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ngoài hạnh nhân này thì cô sẽ kết hợp với đậu đỏ mà em mới vừa khen đó.",
      "start": 35.2,
      "end": 39.16,
      "n_words": 18,
      "start_frame": 880,
      "end_frame": 979,
      "keyframes": [
        "000918.webp",
        "000919.webp",
        "000946.webp",
        "000974.webp",
        "000975.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dạ được không?",
      "start": 39.16,
      "end": 39.92,
      "n_words": 3,
      "start_frame": 979,
      "end_frame": 998,
      "keyframes": [
        "000994.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ quá được. Rồi vậy mình vào làm liền nha.",
      "start": 39.92,
      "end": 42.2,
      "n_words": 10,
      "start_frame": 998,
      "end_frame": 1055,
      "keyframes": [
        "001014.webp",
        "001015.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hãy phụ cô nha.",
      "start": 42.2,
      "end": 46.0,
      "n_words": 4,
      "start_frame": 1055,
      "end_frame": 1150,
      "keyframes": [
        "001056.webp",
        "001098.webp",
        "001099.webp",
        "001123.webp",
        "001148.webp",
        "001149.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bánh hạnh nhân đậu đỏ ngọt thanh nhẹ nhàng.",
      "start": 46.0,
      "end": 63.24,
      "n_words": 9,
      "start_frame": 1150,
      "end_frame": 1581,
      "keyframes": [
        "001190.webp",
        "001231.webp",
        "001232.webp",
        "001292.webp",
        "001352.webp",
        "001367.webp",
        "001411.webp",
        "001455.webp",
        "001456.webp",
        "001543.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 63.24,
      "end": 68.0,
      "n_words": 13,
      "start_frame": 1581,
      "end_frame": 1700,
      "keyframes": [
        "001630.webp",
        "001631.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 68.0,
      "end": 71.52,
      "n_words": 11,
      "start_frame": 1700,
      "end_frame": 1788,
      "keyframes": [
        "001711.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên là đậu đỏ đã luộc chín mình sẽ cho vào trong chảo.",
      "start": 71.52,
      "end": 74.76,
      "n_words": 14,
      "start_frame": 1788,
      "end_frame": 1869,
      "keyframes": [
        "001791.webp",
        "001792.webp",
        "001803.webp",
        "001815.webp",
        "001816.webp",
        "001846.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ em cho thêm rồi đó cô, hai muỗng canh đường rồi và em cho vô một chút xíu muối nó dịu cái vị ngọt lại.",
      "start": 74.76,
      "end": 80.72,
      "n_words": 27,
      "start_frame": 1869,
      "end_frame": 2018,
      "keyframes": [
        "001877.webp",
        "001878.webp",
        "001925.webp",
        "001972.webp",
        "001973.webp",
        "001995.webp",
        "002018.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Em sẽ sên với lửa nhỏ nhỏ để cho đường tan ra hết.",
      "start": 80.72,
      "end": 83.76,
      "n_words": 13,
      "start_frame": 2018,
      "end_frame": 2094,
      "keyframes": [
        "002018.webp",
        "002019.webp",
        "002031.webp",
        "002044.webp",
        "002045.webp",
        "002067.webp",
        "002090.webp",
        "002091.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ sên đậu đỏ còn nguyên hạt giúp có cảm giác bùi của hạt đậu nhé.",
      "start": 83.76,
      "end": 89.48,
      "n_words": 23,
      "start_frame": 2094,
      "end_frame": 2237,
      "keyframes": [
        "002163.webp",
        "002235.webp",
        "002236.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô sẽ đánh nổi cái phần kem whipping này trước.",
      "start": 89.48,
      "end": 92.12,
      "n_words": 10,
      "start_frame": 2237,
      "end_frame": 2303,
      "keyframes": [
        "002266.webp",
        "002296.webp",
        "002297.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Khi mà mình đánh thì mình sẽ làm lạnh cái phần whipping cream các bạn nha.",
      "start": 92.12,
      "end": 96.04,
      "n_words": 16,
      "start_frame": 2303,
      "end_frame": 2401,
      "keyframes": [
        "002322.webp",
        "002347.webp",
        "002348.webp",
        "002399.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi sau đó mình sẽ cho vào trong đây mình đánh và rất là nhanh cô Hà cũng đã đánh nổi cái kem whipping rồi đây.",
      "start": 96.04,
      "end": 104.72,
      "n_words": 26,
      "start_frame": 2401,
      "end_frame": 2618,
      "keyframes": [
        "002451.webp",
        "002452.webp",
        "002489.webp",
        "002526.webp",
        "002527.webp",
        "002573.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình không nên đánh quá kỹ bởi vì mình đánh cứng quá thì nó sẽ bị tách nước.",
      "start": 104.72,
      "end": 109.4,
      "n_words": 18,
      "start_frame": 2618,
      "end_frame": 2735,
      "keyframes": [
        "002619.webp",
        "002620.webp",
        "002676.webp",
        "002733.webp",
        "002734.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phần whipping này sau khi đã đánh nổi rồi thì chúng ta tiếp tục giữ trong ngăn mát để cuối cùng thì chúng ta sẽ phết lên bánh.",
      "start": 109.4,
      "end": 115.52,
      "n_words": 28,
      "start_frame": 2735,
      "end_frame": 2888,
      "keyframes": [
        "002810.webp",
        "002886.webp",
        "002887.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi được rồi đó em, giờ cô tắt lửa ha.",
      "start": 115.52,
      "end": 117.04,
      "n_words": 10,
      "start_frame": 2888,
      "end_frame": 2926,
      "keyframes": [
        "002911.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Thử ha đó em thấy không, vừa dẻo đúng không? Dạ.",
      "start": 117.04,
      "end": 120.44,
      "n_words": 11,
      "start_frame": 2926,
      "end_frame": 3011,
      "keyframes": [
        "002935.webp",
        "002936.webp",
        "002965.webp",
        "002994.webp",
        "002995.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thì nó sẽ có cái độ ngọt và cái độ bùi.",
      "start": 120.44,
      "end": 123.44,
      "n_words": 11,
      "start_frame": 3011,
      "end_frame": 3086,
      "keyframes": [
        "003040.webp",
        "003086.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ thì chúng ta sẽ chuẩn bị bột để đổ bánh ha.",
      "start": 123.44,
      "end": 125.8,
      "n_words": 13,
      "start_frame": 3086,
      "end_frame": 3145,
      "keyframes": [
        "003086.webp",
        "003087.webp",
        "003112.webp",
        "003137.webp",
        "003138.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đầu tiên thì chúng ta sẽ cho một gói bột bánh rán pha sẵn vị truyền thống vào đây.",
      "start": 125.8,
      "end": 130.32,
      "n_words": 19,
      "start_frame": 3145,
      "end_frame": 3258,
      "keyframes": [
        "003176.webp",
        "003214.webp",
        "003215.webp",
        "003237.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và phần đặc biệt của ngày hôm nay nữa là chúng ta sẽ trộn thêm 40 g bột hạnh nhân và ở đây chúng ta sẽ sử dụng là bột hạnh nhân còn sống chưa có rang bánh sẽ rất là ngon bổ dưỡng.",
      "start": 130.32,
      "end": 142.76,
      "n_words": 44,
      "start_frame": 3258,
      "end_frame": 3569,
      "keyframes": [
        "003259.webp",
        "003260.webp",
        "003291.webp",
        "003323.webp",
        "003324.webp",
        "003412.webp",
        "003500.webp",
        "003501.webp",
        "003542.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đúng rồi.",
      "start": 142.76,
      "end": 143.36,
      "n_words": 2,
      "start_frame": 3569,
      "end_frame": 3584,
      "keyframes": [
        "003584.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi mình sẽ cho vào đây 170 ml nước và khuấy bột.",
      "start": 143.36,
      "end": 146.92,
      "n_words": 12,
      "start_frame": 3584,
      "end_frame": 3673,
      "keyframes": [
        "003584.webp",
        "003585.webp",
        "003629.webp",
        "003673.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và trong món ăn này thì chúng ta sẽ thêm bột hạnh nhân giúp món bánh thơm ngon hơn và còn tăng dinh dưỡng nữa.",
      "start": 146.92,
      "end": 153.44,
      "n_words": 25,
      "start_frame": 3673,
      "end_frame": 3836,
      "keyframes": [
        "003673.webp",
        "003674.webp",
        "003754.webp",
        "003835.webp",
        "003836.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đầu tiên thì mình sẽ đặt một cái chảo lên trên bếp rồi em mở lửa giúp cô nha.",
      "start": 153.44,
      "end": 158.44,
      "n_words": 19,
      "start_frame": 3836,
      "end_frame": 3961,
      "keyframes": [
        "003836.webp",
        "003849.webp",
        "003862.webp",
        "003863.webp",
        "003921.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cảm ơn em.",
      "start": 158.44,
      "end": 159.36,
      "n_words": 3,
      "start_frame": 3961,
      "end_frame": 3984,
      "keyframes": [
        "003979.webp",
        "003980.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi bây giờ thì mình sẽ giảm nhiệt chảo bằng cách là mình sẽ đặt lên một cái khăn ẩm.",
      "start": 159.36,
      "end": 164.08,
      "n_words": 20,
      "start_frame": 3984,
      "end_frame": 4102,
      "keyframes": [
        "004040.webp",
        "004101.webp",
        "004102.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hồi nãy là cô có rang sơ cái hạnh nhân lát này rồi, bây giờ thì mình sẽ xếp cái phần hạnh nhân này lên trên cái bánh nha.",
      "start": 164.08,
      "end": 171.28,
      "n_words": 29,
      "start_frame": 4102,
      "end_frame": 4282,
      "keyframes": [
        "004102.webp",
        "004135.webp",
        "004168.webp",
        "004169.webp",
        "004222.webp",
        "004276.webp",
        "004277.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Mình xếp thành một cái hoa, cái hoa cúc sơ sơ gì cũng được, sơ gì cũng được ha.",
      "start": 171.28,
      "end": 176.56,
      "n_words": 19,
      "start_frame": 4282,
      "end_frame": 4414,
      "keyframes": [
        "004345.webp",
        "004414.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi bây giờ thì cô sẽ đặt lại cái chảo lên trên bếp ha, mình sẽ đổ bột vào như bình thường mà mình đổ bánh bên khác thôi.",
      "start": 176.56,
      "end": 184.12,
      "n_words": 29,
      "start_frame": 4414,
      "end_frame": 4603,
      "keyframes": [
        "004414.webp",
        "004415.webp",
        "004435.webp",
        "004455.webp",
        "004456.webp",
        "004476.webp",
        "004497.webp",
        "004498.webp",
        "004526.webp",
        "004555.webp",
        "004556.webp",
        "004577.webp",
        "004598.webp",
        "004599.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Bây giờ thì bánh được rồi đó mình sẽ lật trở lại nha.",
      "start": 184.12,
      "end": 187.04,
      "n_words": 13,
      "start_frame": 4603,
      "end_frame": 4676,
      "keyframes": [
        "004622.webp",
        "004645.webp",
        "004646.webp",
        "004664.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Em hồi hộp quá.",
