      "end_frame": 542,
      "keyframes": [
        "000469.webp",
        "000470.webp",
        "000507.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Á, nước gì mà phi thường vậy?",
      "start": 21.68,
      "end": 23.6,
      "n_words": 7,
      "start_frame": 542,
      "end_frame": 590,
      "keyframes": [
        "000545.webp",
        "000546.webp",
        "000566.webp",
        "000587.webp",
        "000588.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dạ đây là nước đậu đỏ rang.",
      "start": 23.6,
      "end": 25.36,
      "n_words": 7,
      "start_frame": 590,
      "end_frame": 634,
      "keyframes": [
        "000611.webp",
        "000634.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ngày mai làm cho cô một chai nha.",
