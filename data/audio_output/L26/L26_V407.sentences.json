        "000426.webp",
        "000427.webp",
        "000448.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và đây là bột chai nước phi thường. Nước đẹp tóc của em.",
      "start": 18.72,
      "end": 21.68,
      "n_words": 13,
