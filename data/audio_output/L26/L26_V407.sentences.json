      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ, ủa em có chai nước gì Kim Thảo?",
      "start": 16.8,
      "end": 18.72,
      "n_words": 9,
      "start_frame": 420,
      "end_frame": 468,
