        "002523.webp",
        "002524.webp",
        "002570.webp",
        "002616.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Mình không nên đánh quá kỹ bởi vì mình đánh trị hoa quá thì nó sẽ bị chảy ra phần whipping này.",
      "start": 104.64,
      "end": 110.16,
      "n_words": 22,
      "start_frame": 2616,
      "end_frame": 2754,
      "keyframes": [
        "002616.webp",
        "002617.webp",
        "002673.webp",
        "002730.webp",
        "002731.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sau khi đã đánh nổi rồi thì chúng ta tiếp tục giữ trong ngăn mát để cuối cùng thì chúng ta sẽ phớt lên bánh rồi.",
      "start": 110.16,
      "end": 115.6,
      "n_words": 26,
      "start_frame": 2754,
      "end_frame": 2890,
      "keyframes": [
        "002807.webp",
        "002883.webp",
        "002884.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Được rồi đó em, giờ cô tắt lửa ha ha.",
      "start": 115.6,
      "end": 117.68,
      "n_words": 10,
      "start_frame": 2890,
      "end_frame": 2942,
      "keyframes": [
        "002908.webp",
        "002932.webp",
        "002933.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó em thấy không, dẻo đúng không? Dạ.",
      "start": 117.68,
      "end": 120.32,
      "n_words": 8,
      "start_frame": 2942,
      "end_frame": 3008,
      "keyframes": [
        "002962.webp",
        "002991.webp",
        "002992.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì nó sẽ có cái độ ngọt và cái độ bùi.",
      "start": 120.32,
      "end": 123.32,
      "n_words": 11,
      "start_frame": 3008,
      "end_frame": 3083,
      "keyframes": [
        "003037.webp",
        "003083.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ thì chúng ta sẽ chuẩn bị bột để đổ bánh ha.",
      "start": 123.32,
      "end": 125.68,
      "n_words": 13,
      "start_frame": 3083,
      "end_frame": 3142,
      "keyframes": [
        "003083.webp",
        "003084.webp",
        "003109.webp",
        "003134.webp",
        "003135.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đầu tiên thì chúng ta sẽ cho một gói bột bánh rán pha sẵn vị truyền thống vào đây, và phần đặc biệt của ngày hôm nay nữa là chúng ta sẽ trộn thêm 40 g bột hạnh nhân, và ở đây chúng ta sẽ sử dụng là bột hạnh nhân còn sống chưa có rang, bánh sẽ rất là ngon bổ dưỡng.",
      "start": 125.68,
      "end": 142.64,
      "n_words": 63,
      "start_frame": 3142,
      "end_frame": 3566,
      "keyframes": [
        "003173.webp",
        "003211.webp",
