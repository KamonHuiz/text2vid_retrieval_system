      "end": 27.28,
      "n_words": 8,
      "start_frame": 634,
      "end_frame": 682,
      "keyframes": [
        "000634.webp",
        "000635.webp",
        "000650.webp",
        "000665.webp",
        "000666.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dạ rồi.",
      "start": 27.28,
      "end": 28.84,
      "n_words": 2,
      "start_frame": 682,
      "end_frame": 721,
      "keyframes": [
        "000687.webp",
        "000708.webp",
        "000709.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vậy thì em có thích ăn bánh không?",
      "start": 28.84,
      "end": 30.4,
      "n_words": 8,
      "start_frame": 721,
      "end_frame": 760,
      "keyframes": [
        "000734.webp",
        "000759.webp",
        "000760.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ quá thích rồi.",
