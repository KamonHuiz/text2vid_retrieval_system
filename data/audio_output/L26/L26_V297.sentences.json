      "n_words": 7,
      "start_frame": 590,
      "end_frame": 634,
      "keyframes": [
        "000611.webp",
        "000634.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ngày mai làm cho cô một chai nha.",
