      "end": 31.36,
      "n_words": 4,
      "start_frame": 760,
      "end_frame": 784,
      "keyframes": [
        "000760.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vậy thì hôm nay thì cô sẽ tặng em một món bánh nha.",
      "start": 31.36,
      "end": 35.2,
      "n_words": 13,
      "start_frame": 784,
      "end_frame": 880,
      "keyframes": [
        "000790.webp",
        "000820.webp",
        "000821.webp",
        "000869.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ngoài hạnh nhân này thì cô sẽ kết hợp với đậu đỏ mà em mới vừa khen đó.",
      "start": 35.2,
      "end": 39.16,
      "n_words": 18,
      "start_frame": 880,
      "end_frame": 979,
      "keyframes": [
        "000918.webp",
        "000919.webp",
        "000946.webp",
        "000974.webp",
        "000975.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dạ được không?",
      "start": 39.16,
      "end": 39.92,
      "n_words": 3,
      "start_frame": 979,
      "end_frame": 998,
      "keyframes": [
        "000994.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ quá được rồi. Vậy mình vào làm liền nha.",
