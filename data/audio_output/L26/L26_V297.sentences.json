      "end": 42.2,
      "n_words": 10,
      "start_frame": 998,
      "end_frame": 1055,
      "keyframes": [
        "001014.webp",
        "001015.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hãy phụ cô làm nha bánh hạnh nhân đậu đỏ ngọt thanh nhẹ nhàng.",
      "start": 42.2,
      "end": 63.16,
      "n_words": 14,
      "start_frame": 1055,
      "end_frame": 1579,
      "keyframes": [
        "001056.webp",
        "001098.webp",
        "001099.webp",
        "001123.webp",
        "001148.webp",
