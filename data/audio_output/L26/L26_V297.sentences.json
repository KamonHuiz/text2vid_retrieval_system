      ],
      "keyframe_count": 2
    },
    {
      "text": "Ủa em có chai nước gì Kim Thảo?",
      "start": 17.16,
      "end": 18.72,
      "n_words": 8,
      "start_frame": 429,
      "end_frame": 468,
      "keyframes": [
        "000448.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và đây là bột chai nước phi thường, nước đẹp tóc của em.",
      "start": 18.72,
      "end": 21.68,
      "n_words": 13,
