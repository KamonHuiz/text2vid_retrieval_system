      "end_frame": 542,
      "keyframes": [
        "000469.webp",
        "000470.webp",
        "000507.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Á nước gì mà phi thường vậy?",
      "start": 21.68,
      "end": 23.6,
      "n_words": 7,
      "start_frame": 542,
      "end_frame": 590,
      "keyframes": [
