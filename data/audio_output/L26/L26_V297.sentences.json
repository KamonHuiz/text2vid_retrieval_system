        "001352.webp",
        "001367.webp",
        "001411.webp",
        "001455.webp",
        "001456.webp",
        "001543.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Mừng các bạn đang đến với chương trình Món Ngon Mỗi Ngày, chương trình được tài trợ bởi công ty Asino Việt Nam.",
      "start": 65.28,
      "end": 71.52,
      "n_words": 23,
      "start_frame": 1632,
      "end_frame": 1788,
      "keyframes": [
        "001711.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên là đậu đỏ đã luộc chín, mình sẽ cho vào trong chảo.",
      "start": 71.52,
      "end": 74.76,
      "n_words": 14,
      "start_frame": 1788,
      "end_frame": 1869,
      "keyframes": [
        "001791.webp",
        "001792.webp",
        "001803.webp",
        "001815.webp",
        "001816.webp",
        "001846.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ em cho thêm rồi đó cô, hai muỗng canh đường rồi và em cho vô một chút xíu muối nó dịu cái vị ngọt lại.",
      "start": 74.76,
      "end": 80.72,
      "n_words": 27,
      "start_frame": 1869,
      "end_frame": 2018,
      "keyframes": [
        "001877.webp",
        "001878.webp",
        "001925.webp",
        "001972.webp",
        "001973.webp",
        "001995.webp",
        "002018.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Em sẽ sên với lửa nhỏ nhỏ để cho đường tan ra hết.",
      "start": 80.72,
      "end": 83.68,
      "n_words": 13,
      "start_frame": 2018,
      "end_frame": 2092,
      "keyframes": [
