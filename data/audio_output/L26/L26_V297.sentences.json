        "003409.webp",
        "003497.webp",
        "003498.webp",
        "003539.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Đúng rồi.",
      "start": 142.64,
      "end": 143.24,
      "n_words": 2,
      "start_frame": 3566,
      "end_frame": 3581,
      "keyframes": [
        "003581.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi mình sẽ cho vào đây 170 ml nước và khuấy bột, và trong món ăn này thì chúng ta sẽ thêm bột hạnh nhân giúp món bánh thơm ngon hơn và còn tăng dinh dưỡng nữa.",
      "start": 143.24,
      "end": 153.36,
      "n_words": 37,
      "start_frame": 3581,
      "end_frame": 3834,
      "keyframes": [
        "003581.webp",
        "003582.webp",
        "003626.webp",
        "003670.webp",
        "003671.webp",
        "003751.webp",
        "003832.webp",
        "003833.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đầu tiên thì mình sẽ đặt một cái chảo lên trên bếp, rồi em mở lửa giúp cô nha.",
      "start": 153.36,
      "end": 158.32,
      "n_words": 19,
      "start_frame": 3834,
      "end_frame": 3958,
      "keyframes": [
        "003846.webp",
        "003859.webp",
        "003860.webp",
        "003918.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cảm ơn em.",
      "start": 158.32,
      "end": 159.24,
      "n_words": 3,
      "start_frame": 3958,
      "end_frame": 3981,
      "keyframes": [
        "003976.webp",
        "003977.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi bây giờ thì mình sẽ giảm nhiệt chảo bằng cách là mình sẽ đặt lên một cái khăn ẩm.",
      "start": 159.24,
      "end": 164.0,
      "n_words": 20,
      "start_frame": 3981,
      "end_frame": 4100,
      "keyframes": [
        "004037.webp",
        "004098.webp",
        "004099.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hồi nãy là cô có rang sơ cái hạnh nhân lát này rồi, bây giờ thì mình sẽ xếp cái phần hạnh nhân này lên trên cái bánh nha.",
      "start": 164.0,
      "end": 171.16,
      "n_words": 29,
      "start_frame": 4100,
      "end_frame": 4279,
      "keyframes": [
        "004132.webp",
        "004165.webp",
        "004166.webp",
        "004219.webp",
        "004273.webp",
        "004274.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình xếp thành một cái hoa, cái hoa cúc sơ sơ gì cũng được, gì cũng được ha.",
      "start": 171.16,
      "end": 176.48,
      "n_words": 18,
      "start_frame": 4279,
      "end_frame": 4412,
      "keyframes": [
        "004342.webp",
        "004411.webp",
        "004412.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi bây giờ thì cô sẽ đặt lại cái chảo lên trên bếp ha, mình sẽ đổ bột vào như bình thường mà mình đổ bánh bên khác thôi.",
      "start": 176.48,
      "end": 184.0,
      "n_words": 29,
      "start_frame": 4412,
      "end_frame": 4600,
      "keyframes": [
        "004412.webp",
        "004432.webp",
        "004452.webp",
        "004453.webp",
        "004473.webp",
        "004494.webp",
        "004495.webp",
        "004523.webp",
        "004552.webp",
        "004553.webp",
        "004574.webp",
        "004595.webp",
        "004596.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Bây giờ thì bánh được rồi đó, mình sẽ lật trở lại nha.",
      "start": 184.0,
      "end": 186.92,
      "n_words": 13,
      "start_frame": 4600,
      "end_frame": 4673,
      "keyframes": [
        "004619.webp",
        "004642.webp",
        "004643.webp",
        "004661.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Em hồi hộp quá, ua đẹp quá!",
      "start": 186.92,
      "end": 191.36,
      "n_words": 7,
      "start_frame": 4673,
      "end_frame": 4784,
      "keyframes": [
        "004679.webp",
        "004680.webp",
        "004732.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi bây giờ mình sẽ lấy cái bánh này ra.",
