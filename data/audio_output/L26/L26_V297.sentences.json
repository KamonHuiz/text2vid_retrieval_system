      "n_words": 10,
      "start_frame": 4784,
      "end_frame": 4880,
      "keyframes": [
        "004785.webp",
        "004786.webp",
        "004812.webp",
        "004839.webp",
        "004840.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Mình sẽ đổ chiếc bánh thứ hai, sẽ hạ nhiệt cái chảo.",
      "start": 195.2,
      "end": 200.56,
      "n_words": 12,
      "start_frame": 4880,
      "end_frame": 5014,
      "keyframes": [
        "004887.webp",
        "004934.webp",
        "004935.webp",
        "004975.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ thì mình sẽ xếp hạnh nhân lên thành hình bông hoa, ngoài bông hoa thì mình có thể là xếp thành mặt cười nữa đúng không?",
      "start": 200.56,
      "end": 209.04,
      "n_words": 28,
      "start_frame": 5014,
      "end_frame": 5226,
      "keyframes": [
        "005016.webp",
        "005017.webp",
        "005072.webp",
        "005128.webp",
        "005129.webp",
        "005200.webp"
      ],
      "keyframe_count": 6
    },
    {
