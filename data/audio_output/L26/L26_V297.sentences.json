        "002089.webp",
        "002090.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ sên đậu đỏ còn nguyên hạt giúp có cảm giác bùi của hạt đậu nhé.",
      "start": 83.68,
      "end": 89.36,
      "n_words": 23,
      "start_frame": 2092,
      "end_frame": 2234,
      "keyframes": [
        "002161.webp",
        "002232.webp",
        "002233.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô sẽ đánh nổi cái phần kem whipping này trước.",
      "start": 89.36,
      "end": 92.0,
      "n_words": 10,
      "start_frame": 2234,
      "end_frame": 2300,
      "keyframes": [
        "002263.webp",
        "002293.webp",
        "002294.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Khi mà mình đánh thì mình sẽ làm lạnh cái phần whipping cream các bạn nha.",
      "start": 92.0,
      "end": 95.92,
      "n_words": 16,
      "start_frame": 2300,
      "end_frame": 2398,
      "keyframes": [
        "002319.webp",
        "002344.webp",
        "002345.webp",
        "002396.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi sau đó mình sẽ cho vào trong đây mình đánh, và rất là nhanh cô Hà cũng đã đánh nổi cái whipping rồi đây.",
      "start": 95.92,
      "end": 104.64,
