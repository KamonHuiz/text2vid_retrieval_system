        "002306.webp",
        "002341.webp",
        "002342.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cảm ơn em đã quảng cáo cho giò heo.",
      "start": 93.96,
      "end": 96.04,
      "n_words": 9,
      "start_frame": 2349,
      "end_frame": 2401,
      "keyframes": [
        "002371.webp",
        "002400.webp",
        "002401.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Giò heo này thì chúng ta mua về rửa sạch nha các bạn.",
      "start": 96.04,
      "end": 99.36,
      "n_words": 13,
      "start_frame": 2401,
      "end_frame": 2484,
      "keyframes": [
        "002401.webp",
        "002462.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ chúng ta sẽ ướp giò heo trước.",
      "start": 99.36,
      "end": 101.12,
      "n_words": 9,
      "start_frame": 2484,
      "end_frame": 2528,
      "keyframes": [
        "002523.webp",
        "002524.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đầu tiên chúng ta ướp vào đây hai muỗng cà phê hạt nêm Aji-ngon heo, một muỗng cà phê bột ngọt Ajinomoto, một muỗng cà phê tiêu - cần nhiều nhiều tiêu tí xíu nha các bạn, một muỗng cà phê đường, một muỗng cà phê muối và một muỗng canh nước tương Phổ Sĩ.",
