        "000611.webp",
        "000632.webp",
        "000633.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Người ta đăng thần kinh như vậy cũng bị phát hiện.",
      "start": 25.6,
      "end": 27.68,
      "n_words": 11,
      "start_frame": 640,
      "end_frame": 692,
      "keyframes": [
        "000661.webp",
        "000689.webp",
        "000690.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bạn em ở miền Trung nói là cái món hầm là thường là phải có sả nghệ, mà ở đây em thấy đủ rồi nè nhưng mà thiếu mỗi sả nghệ thôi đúng không ạ?",
      "start": 27.68,
      "end": 34.92,
      "n_words": 35,
      "start_frame": 692,
      "end_frame": 873,
      "keyframes": [
        "000723.webp",
        "000757.webp",
        "000758.webp",
        "000788.webp",
        "000818.webp",
        "000819.webp",
        "000850.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đúng rồi em, hầm ở miền Tây cũng có, đặc biệt Bến Tre quê anh á thường thì không dùng sả nghệ mà dùng những cái gia vị thuốc bắc như vậy, và trong món ăn ngày hôm nay là anh có biến tấu cho thêm dừa nước để nhai ôi đã quá!",
