        "001332.webp",
        "001357.webp",
        "001358.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Giò heo hầm nước thấm vị đậm đà, vừa lạ vừa quen.",
      "start": 54.32,
      "end": 72.28,
      "n_words": 12,
