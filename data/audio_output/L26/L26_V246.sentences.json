        "001187.webp",
        "001188.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Vậy thì cần chừng gì nữa mình thực hiện ngay thôi.",
      "start": 49.12,
      "end": 54.32,
      "n_words": 11,
