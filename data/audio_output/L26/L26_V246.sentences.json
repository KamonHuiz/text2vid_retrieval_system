        "001658.webp",
        "001659.webp",
        "001749.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Hân hoan chào đón các bạn khán giả đang xem chương trình Món ngon mỗi ngày.",
      "start": 72.28,
      "end": 77.04,
      "n_words": 16,
