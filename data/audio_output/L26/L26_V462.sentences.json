      "keyframes": [
        "000372.webp",
        "000373.webp",
        "000413.webp",
        "000454.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cô có bạch quả nè, đậu hủ nè, chân nấm nè, đậu bơ tibo nè, cà rốt, ngò và hạt sen.",
      "start": 18.16,
