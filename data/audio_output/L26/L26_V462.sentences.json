        "001153.webp",
        "001154.webp",
        "001241.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 52.6,
      "end": 56.08,
      "n_words": 13,
      "start_frame": 1315,
      "end_frame": 1402,
      "keyframes": [
        "001329.webp",
        "001330.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam và hôm nay là một món chay cho nên là Phương cũng sẽ làm bếp chính rất là dễ dàng thôi.",
      "start": 56.08,
      "end": 65.12,
      "n_words": 32,
      "start_frame": 1402,
      "end_frame": 1628,
      "keyframes": [
        "001438.webp",
        "001546.webp",
        "001547.webp",
        "001581.webp",
        "001615.webp",
        "001616.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mở lửa lên giúp cô đi.",
      "start": 65.12,
      "end": 66.92,
      "n_words": 6,
      "start_frame": 1628,
      "end_frame": 1673,
      "keyframes": [
        "001645.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cho vào đây khoảng chừng một muỗng cà phê muối.",
      "start": 66.92,
      "end": 69.08,
      "n_words": 10,
      "start_frame": 1673,
      "end_frame": 1727,
      "keyframes": [
        "001674.webp",
        "001675.webp",
        "001724.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho thêm một cái muỗng muối khi mà chúng ta trần qua những loại rau củ quả để hương vị của món ăn đậm đà mà nó có màu xanh đẹp mắt phải không cô?",
      "start": 69.08,
      "end": 76.16,
      "n_words": 35,
      "start_frame": 1727,
      "end_frame": 1904,
      "keyframes": [
        "001773.webp",
