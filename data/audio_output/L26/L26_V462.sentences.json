        "004598.webp",
        "004662.webp",
        "004663.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Món này Phương nghĩ là không chỉ có trẻ em mới thích đâu mà ngay cả người lớn tuổi cũng thích nữa, rất là dễ ăn cô ha.",
      "start": 186.52,
      "end": 193.04,
      "n_words": 28,
      "start_frame": 4663,
      "end_frame": 4826,
      "keyframes": [
        "004663.webp",
        "004744.webp",
        "004825.webp",
        "004826.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Củ năng cô đã cắt sợi vô, đậu hủ luôn đạm trong món ăn đó.",
      "start": 193.04,
      "end": 198.56,
      "n_words": 15,
      "start_frame": 4826,
      "end_frame": 4964,
      "keyframes": [
        "004826.webp",
