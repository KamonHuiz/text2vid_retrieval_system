        "003442.webp",
        "003461.webp",
        "003462.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Tiếp theo thì phần củ năng này đã luộc chín rồi, bây giờ cô sẽ cắt sợi sợi luôn.",
      "start": 138.6,
      "end": 144.52,
      "n_words": 19,
      "start_frame": 3465,
      "end_frame": 3613,
      "keyframes": [
        "003486.webp",
