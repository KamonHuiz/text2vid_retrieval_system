        "002053.webp",
        "002070.webp",
        "002071.webp",
        "002087.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Bây giờ em cho hạt sen vô ha?",
      "start": 83.84,
      "end": 85.36,
      "n_words": 8,
      "start_frame": 2096,
      "end_frame": 2134,
      "keyframes": [
        "002104.webp",
        "002105.webp",
        "002129.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, rồi em cho luôn cả bạch quả vô luôn đi.",
      "start": 85.36,
      "end": 88.12,
      "n_words": 12,
      "start_frame": 2134,
      "end_frame": 2203,
      "keyframes": [
        "002153.webp",
        "002154.webp",
        "002177.webp",
        "002201.webp",
        "002202.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp theo phần đậu hủ trắng thì chúng ta sẽ cắt hạt lựu.",
      "start": 88.12,
      "end": 95.76,
      "n_words": 13,
      "start_frame": 2203,
      "end_frame": 2394,
      "keyframes": [
        "002242.webp",
        "002283.webp",
        "002284.webp",
        "002320.webp",
        "002356.webp",
        "002357.webp",
        "002377.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đây là cái chân nấm người ta gọi là chân nấm đông cô, các bạn lưu ý là chúng ta sẽ ngâm mềm chân nấm, xả nước vài lần và chần qua để giảm màu của chân nấm của các hạt lựu, và chút nữa đó mình cũng sẽ luộc lại.",
      "start": 95.76,
      "end": 108.8,
      "n_words": 51,
      "start_frame": 2394,
      "end_frame": 2720,
      "keyframes": [
        "002398.webp",
        "002399.webp",
        "002426.webp",
        "002454.webp",
        "002455.webp",
        "002472.webp",
