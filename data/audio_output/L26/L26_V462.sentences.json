        "000823.webp",
        "000848.webp",
        "000849.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Lạ vị đầy dinh dưỡng với súp bát trân chay.",
      "start": 34.0,
      "end": 52.6,
      "n_words": 10,
      "start_frame": 850,
      "end_frame": 1315,
      "keyframes": [
