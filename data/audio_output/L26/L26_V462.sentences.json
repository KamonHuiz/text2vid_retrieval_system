        "003554.webp",
        "003572.webp",
        "003573.webp",
        "003595.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Trong nước dùng này thì chúng ta sẽ nấu gồm có là củ sắn nè, bắp mỹ nè, su hào nè, rồi một ít cà rốt và chúng ta cũng có luộc củ năng ở trong này.",
      "start": 144.52,
      "end": 153.92,
      "n_words": 37,
      "start_frame": 3613,
      "end_frame": 3848,
      "keyframes": [
        "003618.webp",
