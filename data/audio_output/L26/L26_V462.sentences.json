        "002687.webp",
        "002718.webp",
        "002719.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Rồi bây giờ em có thể cho luôn cả cái phần cà rốt vô.",
      "start": 108.8,
      "end": 111.64,
      "n_words": 14,
      "start_frame": 2720,
      "end_frame": 2791,
      "keyframes": [
        "002758.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi vừa chín rồi, bây giờ em vớt ra bỏ vô thau nước đá.",
      "start": 111.64,
      "end": 114.4,
      "n_words": 14,
      "start_frame": 2791,
      "end_frame": 2860,
      "keyframes": [
        "002797.webp",
        "002798.webp",
        "002821.webp",
        "002844.webp",
        "002845.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp theo cái nồi nước đó em cho cái chân nấm này vô luộc giùm cô.",
      "start": 114.4,
      "end": 117.44,
      "n_words": 16,
      "start_frame": 2860,
      "end_frame": 2936,
      "keyframes": [
        "002864.webp",
        "002884.webp",
        "002885.webp",
        "002910.webp",
        "002935.webp",
        "002936.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rất là thơm giùm cô, rất là thơm cô ha, tại vì mình ăn cái chân nấm thì nó có cái độ dai dai giòn giòn hơn so với lại mình ăn cái tai nấm.",
      "start": 117.44,
      "end": 122.84,
      "n_words": 35,
      "start_frame": 2936,
      "end_frame": 3071,
      "keyframes": [
        "002936.webp",
        "002976.webp",
        "003017.webp",
        "003018.webp",
        "003043.webp",
        "003068.webp",
        "003069.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tiếp theo thì chúng ta sẽ có hai nguyên liệu cũng khá là đặc biệt: thứ nhất là bắp, thứ hai là củ năng.",
      "start": 122.84,
      "end": 127.6,
      "n_words": 24,
      "start_frame": 3071,
      "end_frame": 3190,
      "keyframes": [
        "003121.webp",
        "003173.webp",
        "003174.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hồi nãy hai cái loại này thì cô đã nấu ở trong nước dùng luôn rồi.",
      "start": 127.6,
      "end": 131.08,
      "n_words": 16,
      "start_frame": 3190,
      "end_frame": 3277,
      "keyframes": [
        "003225.webp",
        "003277.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bắp mỹ sau khi chúng ta đã nấu nước dùng thì chúng ta sẽ tách lấy hạt để bỏ vào súp để ăn tạo độ giòn và cảm giác rất là thú vị.",
      "start": 131.08,
      "end": 138.6,
      "n_words": 33,
      "start_frame": 3277,
      "end_frame": 3465,
      "keyframes": [
        "003277.webp",
