        "000592.webp",
        "000612.webp",
        "000613.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Wow, chắc chắn là món chay này sẽ cực kỳ hấp dẫn luôn.",
      "start": 24.76,
      "end": 28.12,
      "n_words": 13,
      "start_frame": 619,
