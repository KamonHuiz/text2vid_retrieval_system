      "keyframes": [
        "000655.webp",
        "000698.webp",
        "000699.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nôn nóng quá, thôi bây giờ mình thực hiện ngay đi được liền nha.",
      "start": 28.12,
      "end": 34.0,
      "n_words": 14,
      "start_frame": 703,
      "end_frame": 850,
      "keyframes": [
