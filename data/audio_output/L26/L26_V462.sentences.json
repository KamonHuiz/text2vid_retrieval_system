        "004184.webp",
        "004185.webp",
        "004228.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Mình sẽ khuấy cho gia vị tan, rồi bây giờ nước sôi rồi đó.",
      "start": 170.08,
      "end": 175.12,
      "n_words": 14,
      "start_frame": 4252,
      "end_frame": 4378,
