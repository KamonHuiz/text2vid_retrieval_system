        "000329.webp",
        "000350.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Những nguyên liệu mà cô chuẩn bị, em đoán là cô định nấu món chay đúng không?",
      "start": 14.56,
      "end": 18.16,
