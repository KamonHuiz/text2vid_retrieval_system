        "001828.webp",
        "001883.webp",
        "001884.webp",
        "001896.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi, cho cái đậu bơ tibo vô trước.",
      "start": 76.16,
      "end": 78.6,
      "n_words": 8,
      "start_frame": 1904,
      "end_frame": 1965,
      "keyframes": [
        "001909.webp",
        "001910.webp",
        "001935.webp",
        "001961.webp",
        "001962.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ở đây chúng ta có cà rốt, chúng ta cũng sẽ cắt hạt lựu.",
      "start": 78.6,
      "end": 83.84,
      "n_words": 14,
      "start_frame": 1965,
      "end_frame": 2096,
      "keyframes": [
        "001980.webp",
        "001999.webp",
        "002000.webp",
