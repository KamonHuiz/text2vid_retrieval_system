        "001393.webp",
        "001452.webp",
        "001453.webp",
        "001540.webp",
        "001628.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Chào quý vị khán giả đã quay trở lại với chương trình Món ngon mỗi ngày.",
      "start": 65.12,
      "end": 67.68,
      "n_words": 16,
      "start_frame": 1628,
      "end_frame": 1692,
      "keyframes": [
        "001628.webp",
        "001629.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 67.68,
      "end": 71.28,
      "n_words": 11,
      "start_frame": 1692,
      "end_frame": 1782,
      "keyframes": [
        "001708.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đây, ếch của em đây, thấy gì khác không?",
      "start": 71.28,
      "end": 73.72,
      "n_words": 9,
      "start_frame": 1782,
      "end_frame": 1843,
      "keyframes": [
        "001787.webp",
        "001788.webp",
        "001822.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ủa, cái món ăn này anh đã phải dùng khăn giấy và anh thấm cho nó thật là khô, tại vì lát khi mà anh ướp bột tẩm khô chiên giòn Ajinomoto vào nó sẽ tránh cái tình trạng mà giữ nước, nó sẽ không ngon.",
      "start": 73.72,
      "end": 83.72,
      "n_words": 46,
      "start_frame": 1843,
      "end_frame": 2093,
      "keyframes": [
        "001857.webp",
        "001858.webp",
        "001893.webp",
        "001928.webp",
        "001929.webp",
        "001983.webp",
        "002038.webp",
        "002039.webp",
        "002060.webp",
        "002082.webp",
        "002083.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Thì ra đó là một cái bí quyết để làm cho món ăn ngon hơn.",
      "start": 83.72,
      "end": 86.28,
      "n_words": 15,
      "start_frame": 2093,
      "end_frame": 2157,
      "keyframes": [
        "002095.webp",
        "002107.webp",
        "002108.webp",
        "002132.webp",
        "002156.webp",
        "002157.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cho vào đây, đó là một muỗng cà phê ớt bột paprika.",
      "start": 86.28,
      "end": 89.84,
      "n_words": 12,
      "start_frame": 2157,
      "end_frame": 2246,
      "keyframes": [
        "002157.webp",
        "002207.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng ta sẽ ướp thịt ếch với một ít ớt bột paprika để tạo mùi thơm và đậm vị, rồi mình sẽ trộn đều lên.",
