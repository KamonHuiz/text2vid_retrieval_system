      "end": 95.68,
      "n_words": 25,
      "start_frame": 2259,
      "end_frame": 2392,
      "keyframes": [
        "002311.webp",
        "002364.webp",
        "002365.webp",
        "002383.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ thì Long sẽ đập dập phần sả và xé sợi.",
      "start": 95.68,
      "end": 101.6,
      "n_words": 12,
      "start_frame": 2392,
      "end_frame": 2540,
      "keyframes": [
        "002401.webp",
