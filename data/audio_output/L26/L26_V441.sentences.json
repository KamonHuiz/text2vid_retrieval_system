        "002870.webp",
        "002902.webp",
        "002903.webp",
        "002925.webp",
        "002948.webp",
        "002949.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Cho một muỗng canh Ajinomoto bột tẩm khô chiên giòn vào phía trong phần sả này, thứ nhất để tạo cái vị và cái mùi thơm, trộn Ajinomoto bột tẩm khô chiên giòn với sả khi chiên để tạo độ kết dính và dễ dàng tạo hình.",
      "start": 118.12,
      "end": 130.72,
      "n_words": 47,
      "start_frame": 2953,
      "end_frame": 3268,
      "keyframes": [
        "002974.webp",
