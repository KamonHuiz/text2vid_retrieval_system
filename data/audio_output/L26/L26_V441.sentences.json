        "002423.webp",
        "002445.webp",
        "002446.webp",
        "002470.webp",
        "002495.webp",
        "002496.webp",
        "002520.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Phần sả thì khi mình đập dập mình sẽ cắt khúc nhẹ và mình sẽ xé sợi ra.",
      "start": 101.6,
      "end": 105.08,
      "n_words": 18,
      "start_frame": 2540,
      "end_frame": 2627,
      "keyframes": [
