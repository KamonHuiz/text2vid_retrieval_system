        "003697.webp",
        "003698.webp",
        "003741.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi, rất là thơm các bạn ơi!",
      "start": 150.4,
      "end": 153.08,
      "n_words": 8,
      "start_frame": 3760,
