        "002707.webp",
        "002708.webp",
        "002730.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bây giờ sau khi mình xé tơi cái phần sả này, bây giờ mình sẽ chuẩn bị một chảo dầu để mình chiên sả và cũng như mình chuẩn bị chiên ếch Long nha.",
      "start": 110.04,
      "end": 118.12,
      "n_words": 34,
      "start_frame": 2751,
      "end_frame": 2953,
      "keyframes": [
        "002753.webp",
