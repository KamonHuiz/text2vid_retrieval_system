        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 27
    },
    {
      "text": "Phước Hưng ơi, chuẩn bị nguyên liệu xong chưa?",
      "start": 12.0,
      "end": 15.08,
      "n_words": 9,
      "start_frame": 300,
      "end_frame": 377,
      "keyframes": [
        "000300.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đã sẵn sàng hết rồi!",
      "start": 15.08,
      "end": 16.56,
      "n_words": 5,
      "start_frame": 377,
      "end_frame": 414,
      "keyframes": [
        "000392.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nhưng mà ngồi ở đó lo cắm bông đi, Phước Hưng nấu ăn mình nên cũng được?",
      "start": 16.56,
      "end": 19.44,
      "n_words": 17,
      "start_frame": 414,
      "end_frame": 486,
      "keyframes": [
        "000484.webp",
        "000485.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đâu có được, muốn ăn là phải lăn vào bếp luôn liền.",
      "start": 19.44,
      "end": 23.68,
      "n_words": 12,
      "start_frame": 486,
      "end_frame": 592,
      "keyframes": [
        "000537.webp",
        "000590.webp",
        "000591.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Wow, hôm nay nấu món gì mà nguyên liệu có vẻ phong phú quá vậy ta?",
      "start": 23.68,
      "end": 27.96,
      "n_words": 16,
      "start_frame": 592,
      "end_frame": 699,
      "keyframes": [
        "000602.webp",
        "000614.webp",
        "000615.webp",
        "000658.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Phương có thấy trên bàn của mình không có thịt cũng không có cá đúng không nè? Một món chay đúng không?",
      "start": 27.96,
      "end": 32.36,
      "n_words": 22,
      "start_frame": 699,
      "end_frame": 809,
      "keyframes": [
        "000702.webp",
        "000703.webp",
        "000765.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chính xác luôn.",
      "start": 32.36,
      "end": 33.16,
      "n_words": 3,
      "start_frame": 809,
      "end_frame": 829,
      "keyframes": [
        "000828.webp",
        "000829.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hôm nay Phước Hưng sẽ làm cho một cái món chay nhưng mà là hầm nghe lạ miệng lắm.",
      "start": 33.16,
      "end": 37.52,
      "n_words": 19,
      "start_frame": 829,
      "end_frame": 938,
      "keyframes": [
        "000829.webp",
        "000902.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bắt tay vào làm ngay thôi!",
      "start": 37.52,
      "end": 40.72,
      "n_words": 6,
      "start_frame": 938,
      "end_frame": 1018,
      "keyframes": [
        "000975.webp",
        "000976.webp",
        "001000.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bữa tiệc hoành tráng với lẩu nấm hầm củ quả. Chào các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 40.72,
      "end": 63.2,
      "n_words": 22,
      "start_frame": 1018,
      "end_frame": 1580,
      "keyframes": [
        "001025.webp",
        "001026.webp",
        "001073.webp",
        "001120.webp",
        "001121.webp",
        "001192.webp",
        "001264.webp",
        "001282.webp",
        "001312.webp",
        "001343.webp",
        "001344.webp",
        "001431.webp",
        "001519.webp",
        "001520.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 63.2,
      "end": 66.96,
      "n_words": 11,
      "start_frame": 1580,
      "end_frame": 1674,
      "keyframes": [
        "001598.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đối với phần củ năng thì Minh Phương giúp cho Phước Hưng chúng ta chỉ chẻ đôi thôi.",
      "start": 66.96,
      "end": 71.12,
      "n_words": 18,
      "start_frame": 1674,
      "end_frame": 1778,
      "keyframes": [
        "001677.webp",
        "001678.webp",
        "001690.webp",
        "001703.webp",
        "001704.webp",
        "001716.webp",
        "001729.webp",
        "001730.webp",
        "001774.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Còn phần nấm đầu khỉ thì chúng ta sẽ cắt thành từng lát dày vừa ăn.",
      "start": 71.12,
      "end": 75.04,
      "n_words": 16,
      "start_frame": 1778,
      "end_frame": 1876,
      "keyframes": [
        "001819.webp",
        "001820.webp",
        "001836.webp",
        "001853.webp",
        "001854.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nấm đầu khỉ ngon mà lại rất là nhiều dinh dưỡng, có thể hỗ trợ cho chúng ta giảm sút trí nhớ nữa, rất là hay đúng không? Đúng rồi.",
      "start": 75.04,
      "end": 83.16,
      "n_words": 30,
      "start_frame": 1876,
      "end_frame": 2079,
      "keyframes": [
        "001879.webp",
        "001905.webp",
        "001906.webp",
        "001932.webp",
        "001958.webp",
        "001959.webp",
        "001989.webp",
        "002020.webp",
        "002021.webp",
        "002055.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Rồi phần ngưu bàng thì bây giờ chúng ta sẽ cắt lát mỏng.",
      "start": 83.16,
      "end": 86.0,
      "n_words": 13,
      "start_frame": 2079,
      "end_frame": 2150,
      "keyframes": [
        "002089.webp",
        "002090.webp",
        "002091.webp",
        "002092.webp",
        "002093.webp",
        "002137.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Sau khi mà các bạn chúng ta đã cắt cái phần nấm đầu khỉ cũng như củ năng rồi thì bây giờ Phước Hưng sẽ ướp gia vị vào đây.",
      "start": 86.0,
      "end": 92.04,
      "n_words": 30,
      "start_frame": 2150,
      "end_frame": 2301,
      "keyframes": [
        "002182.webp",
        "002183.webp",
        "002242.webp",
        "002301.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cho vào đây một muỗng cà phê hạt nêm Aji-no-moto ngon từ nấm hương và hạt sen, một muỗng cà phê tiêu và bây giờ chúng ta sẽ trộn đều lên cho gia vị được thấm.",
      "start": 92.04,
      "end": 101.64,
      "n_words": 36,
      "start_frame": 2301,
      "end_frame": 2541,
      "keyframes": [
        "002301.webp",
        "002302.webp",
        "002343.webp",
        "002385.webp",
        "002386.webp",
        "002417.webp",
        "002449.webp",
        "002450.webp",
        "002488.webp",
        "002526.webp",
        "002527.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Rồi xong, đặt lên trên bếp một cái nồi để chúng ta hầm.",
      "start": 101.64,
      "end": 105.52,
      "n_words": 13,
      "start_frame": 2541,
      "end_frame": 2638,
      "keyframes": [
        "002560.webp",
        "002594.webp",
        "002595.webp",
        "002617.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cho vào đây khoảng hai muỗng canh dầu ăn, cho tỏi vào chúng ta phi thơm nè.",
      "start": 105.52,
      "end": 109.92,
      "n_words": 17,
      "start_frame": 2638,
      "end_frame": 2748,
      "keyframes": [
        "002640.webp",
        "002641.webp",
        "002662.webp",
        "002684.webp",
        "002685.webp",
        "002719.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần tỏi cũng đã thơm, Phước Hưng sẽ cho phần nấm đầu khỉ cũng như củ năng, nấm hương nè.",
      "start": 109.92,
      "end": 116.4,
      "n_words": 20,
      "start_frame": 2748,
      "end_frame": 2910,
      "keyframes": [
        "002753.webp",
        "002754.webp",
        "002777.webp",
        "002800.webp",
        "002801.webp",
        "002828.webp",
        "002855.webp",
        "002856.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đối với món ăn ngày hôm nay, thì chúng ta sẽ ướp và xào nấm đầu khỉ và nấm hương để loại được cái mùi đặc trưng của nấm.",
      "start": 116.4,
      "end": 123.48,
      "n_words": 29,
      "start_frame": 2910,
      "end_frame": 3087,
      "keyframes": [
        "002941.webp",
        "003026.webp",
        "003027.webp",
        "003055.webp",
        "003083.webp",
        "003084.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ thì cái mùi thơm đã dậy lên rồi, Phước Hưng sẽ cho vào đây một lít sáu nước.",
      "start": 123.48,
      "end": 128.08,
      "n_words": 20,
      "start_frame": 3087,
      "end_frame": 3202,
      "keyframes": [
        "003113.webp",
        "003143.webp",
        "003144.webp",
        "003173.webp",
        "003202.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sao trong món ăn này Minh Phương thấy cho quá nhiều nước vậy?",
      "start": 128.08,
      "end": 131.04,
      "n_words": 13,
      "start_frame": 3202,
      "end_frame": 3276,
      "keyframes": [
        "003202.webp",
        "003203.webp",
        "003231.webp",
        "003259.webp",
        "003260.webp",
        "003276.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phước Hưng thường là chúng ta chỉ sử dụng một lít rưỡi hoặc là một lít thôi đúng không?",
      "start": 131.04,
      "end": 134.76,
      "n_words": 19,
      "start_frame": 3276,
      "end_frame": 3369,
      "keyframes": [
        "003276.webp",
        "003292.webp",
        "003293.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hôm nay Phước Hưng sử dụng một lít sáu vì đây là món hầm thì có cái thời gian phải ninh và chúng ta nấu nó hơi lâu thì nó sẽ rút nước xuống.",
      "start": 134.76,
      "end": 142.56,
      "n_words": 34,
      "start_frame": 3369,
      "end_frame": 3564,
      "keyframes": [
        "003404.webp",
        "003516.webp",
        "003517.webp",
        "003535.webp",
        "003554.webp",
        "003555.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần nước trong nồi cũng đã sôi trở lại rồi, Phước Hưng sẽ lần lượt cho ngưu bàng vào nè để cho tiết ra nước ngọt nè và táo đỏ.",
      "start": 142.56,
      "end": 151.36,
      "n_words": 30,
      "start_frame": 3564,
      "end_frame": 3784,
      "keyframes": [
        "003579.webp",
        "003603.webp",
        "003604.webp",
        "003636.webp",
        "003668.webp",
        "003669.webp",
        "003704.webp",
        "003740.webp",
        "003741.webp",
        "003763.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Còn phần hạt sen thì quý vị nên lưu ý luộc sơ hạt sen là để giúp cho cái món nước nó sẽ trong hơn.",
      "start": 151.36,
      "end": 157.04,
      "n_words": 25,
      "start_frame": 3784,
      "end_frame": 3926,
      "keyframes": [
        "003786.webp",
        "003787.webp",
        "003815.webp",
        "003843.webp",
        "003844.webp",
        "003885.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phước Hưng đã luộc sẵn rồi, chúng ta sẽ cho hạt sen vào luôn.",
      "start": 157.04,
      "end": 160.64,
      "n_words": 14,
      "start_frame": 3926,
      "end_frame": 4016,
      "keyframes": [
        "003927.webp",
        "003928.webp",
        "003972.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đối với món hầm thì cái phần nguyên liệu chúng ta chuẩn bị cũng sẽ cầu kỳ hơn một chút đúng không Phước Hưng?",
      "start": 160.64,
      "end": 165.04,
      "n_words": 24,
      "start_frame": 4016,
      "end_frame": 4126,
      "keyframes": [
        "004017.webp",
        "004018.webp",
        "004044.webp",
        "004071.webp",
        "004072.webp",
        "004098.webp",
        "004125.webp",
        "004126.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đúng rồi đó Minh Phương.",
      "start": 165.04,
      "end": 165.96,
      "n_words": 5,
      "start_frame": 4126,
      "end_frame": 4149,
      "keyframes": [
        "004126.webp",
        "004149.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mà chưa hết đâu, đối với món hầm thì quý vị chúng ta nên sử dụng lửa vừa để tất cả rau củ được chín mềm và tiết ra hết nước ngọt.",
      "start": 165.96,
      "end": 173.2,
      "n_words": 32,
      "start_frame": 4149,
      "end_frame": 4330,
      "keyframes": [
        "004149.webp",
        "004173.webp",
        "004174.webp",
        "004251.webp",
        "004328.webp",
        "004329.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vậy thì món hầm ngày hôm nay chúng ta sẽ nấu trong vòng bao lâu?",
      "start": 173.2,
      "end": 175.08,
      "n_words": 15,
      "start_frame": 4330,
      "end_frame": 4377,
      "keyframes": [
        "004347.webp",
        "004366.webp",
        "004367.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong vòng bao lâu hả Phước Hưng?",
      "start": 175.08,
      "end": 176.32,
      "n_words": 7,
      "start_frame": 4377,
      "end_frame": 4408,
      "keyframes": [
        "004386.webp",
        "004406.webp",
        "004407.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta chỉ hầm trong khoảng 30 phút thôi là đã ăn là đã ngon rồi.",
      "start": 176.32,
      "end": 179.84,
      "n_words": 16,
      "start_frame": 4408,
      "end_frame": 4496,
      "keyframes": [
        "004481.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và bây giờ Phước Hưng sẽ nêm gia vị vào đây: cho vào đây là nửa muỗng canh hạt nêm Aji-no-moto ngon từ nấm hương và hạt sen, nửa muỗng cà phê muối và một muỗng cà phê bột ngọt Aji-no-moto.",
      "start": 179.84,
      "end": 193.92,
      "n_words": 41,
      "start_frame": 4496,
      "end_frame": 4848,
      "keyframes": [
        "004556.webp",
        "004557.webp",
        "004609.webp",
        "004662.webp",
        "004663.webp",
        "004682.webp",
        "004702.webp",
