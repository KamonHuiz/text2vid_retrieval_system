        "004794.webp",
        "004816.webp",
        "004817.webp",
        "004835.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Và bây giờ cái nồi hầm của mình cũng đã đến thời gian và dậy lên cái mùi rất là thơm rồi.",
      "start": 193.92,
      "end": 198.64,
      "n_words": 22,
      "start_frame": 4848,
      "end_frame": 4966,
      "keyframes": [
        "004853.webp",
        "004854.webp",
        "004959.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cuối cùng Phước Hưng sẽ cho vào đây phần tiêu chúng ta đập dập nè: tiêu xanh đập dập.",
      "start": 198.64,
      "end": 204.32,
      "n_words": 19,
      "start_frame": 4966,
      "end_frame": 5108,
      "keyframes": [
        "005065.webp",
        "005066.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đúng không? Đúng rồi.",
      "start": 204.32,
      "end": 205.04,
      "n_words": 4,
      "start_frame": 5108,
      "end_frame": 5126,
      "keyframes": [
        "005113.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và đây cũng là một cái lưu ý cho quý vị nha, chúng ta sẽ để tiêu vào sau cùng để tiêu được chín và giữ được cái hương vị đặc trưng.",
      "start": 205.04,
      "end": 211.68,
      "n_words": 32,
      "start_frame": 5126,
      "end_frame": 5292,
      "keyframes": [
        "005160.webp",
        "005161.webp",
        "005191.webp",
        "005221.webp",
        "005222.webp",
        "005255.webp",
        "005288.webp",
        "005289.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Và bây giờ Phước Hưng sẽ tắt bếp nè, chúng ta sẽ đem ra trình bày ra thôi.",
      "start": 211.68,
      "end": 217.04,
      "n_words": 18,
      "start_frame": 5292,
      "end_frame": 5426,
      "keyframes": [
        "005334.webp",
        "005380.webp",
