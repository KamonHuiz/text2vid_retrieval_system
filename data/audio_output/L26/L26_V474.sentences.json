      "end_frame": 4998,
      "keyframes": [
        "004898.webp",
        "004899.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Với cái khối lượng thịt như vậy thì mình sẽ cho khoảng bao nhiêu nước vào trong hả Long?",
      "start": 199.92,
      "end": 203.92,
      "n_words": 19,
      "start_frame": 4998,
      "end_frame": 5098,
      "keyframes": [
        "005016.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Với cái lượng thịt như vậy thì Long sẽ cho vào đây khoảng một chén nước và sau đó mình sẽ đun cho đến khi phần thịt này thẩm thấu đều gia vị và cạn nước đi.",
      "start": 203.92,
      "end": 213.04,
      "n_words": 37,
