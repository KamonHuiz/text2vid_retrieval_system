        "003891.webp",
        "003892.webp",
        "003893.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Long chuẩn bị một cái chảo để mình chuẩn bị mình kho đây.",
      "start": 156.0,
      "end": 158.92,
      "n_words": 13,
