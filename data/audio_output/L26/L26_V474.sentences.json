        "001151.webp",
        "001234.webp",
        "001235.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dọn đồ lên có cái gì nấu cái đó, ok.",
      "start": 49.96,
      "end": 55.2,
      "n_words": 10,
      "start_frame": 1249,
