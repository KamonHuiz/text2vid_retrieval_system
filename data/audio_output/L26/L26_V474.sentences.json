      "n_words": 26,
      "start_frame": 770,
      "end_frame": 977,
      "keyframes": [
        "000795.webp",
        "000895.webp",
        "000896.webp",
        "000934.webp",
        "000972.webp",
        "000973.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ Long phải làm món gì á mà ngon hấp dẫn?",
      "start": 39.08,
