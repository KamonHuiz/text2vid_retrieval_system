        "001328.webp",
        "001352.webp",
        "001377.webp",
        "001378.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Sườn non kho chao mềm, thấm vị, ngon xuyến xao.",
      "start": 55.2,
      "end": 75.04,
      "n_words": 10,
      "start_frame": 1380,
