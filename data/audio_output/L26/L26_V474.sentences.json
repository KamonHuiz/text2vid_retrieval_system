      "n_words": 12,
      "start_frame": 977,
      "end_frame": 1068,
      "keyframes": [
        "001020.webp",
        "001068.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thì giờ Tuấn có hũ chao rồi, bên kia cũng phải có cái gì xứng đáng đi, thí dụ như là vài miếng thịt thôi.",
      "start": 42.72,
      "end": 49.96,
      "n_words": 25,
      "start_frame": 1068,
      "end_frame": 1249,
      "keyframes": [
