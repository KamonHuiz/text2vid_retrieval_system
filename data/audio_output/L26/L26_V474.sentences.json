        "002186.webp",
        "002187.webp",
        "002217.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Công đoạn đầu tiên mình sẽ làm gì Long?",
      "start": 89.36,
      "end": 91.04,
      "n_words": 9,
      "start_frame": 2234,
      "end_frame": 2276,
      "keyframes": [
        "002247.webp",
        "002248.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Câu đầu tiên đó chính là mình sẽ ướp sườn.",
      "start": 91.04,
      "end": 93.0,
      "n_words": 10,
      "start_frame": 2276,
      "end_frame": 2325,
      "keyframes": [
        "002286.webp",
        "002325.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đầu tiên Long sẽ ướp vào đây là một muỗng canh hạt nêm Ajinomoto ngon heo, một muỗng cà phê bột ngọt Ajinomoto, một muỗng cà phê đường, nửa muỗng cà phê tiêu, một muỗng canh nước chao.",
      "start": 93.0,
      "end": 104.4,
      "n_words": 38,
      "start_frame": 2325,
