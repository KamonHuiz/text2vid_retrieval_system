        "004835.webp",
        "004866.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rồi khi mà cái phần thịt đã săn lại thì Long sẽ cho nước vào.",
      "start": 195.84,
      "end": 199.92,
      "n_words": 15,
