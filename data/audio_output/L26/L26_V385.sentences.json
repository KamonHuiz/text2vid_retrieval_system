        "005617.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Mình sẽ để cái mặt nhẵn của bánh tráng ở bên ngoài và phần nhám lên trên.",
      "start": 224.68,
      "end": 228.44,
