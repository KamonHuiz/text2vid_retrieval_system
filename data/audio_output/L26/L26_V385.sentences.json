        "003924.webp",
        "003925.webp",
        "003960.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Em biết còn thiếu một thành phần rất là quan trọng của các món cuốn, đó chính là sốt.",
      "start": 159.76,
      "end": 163.64,
