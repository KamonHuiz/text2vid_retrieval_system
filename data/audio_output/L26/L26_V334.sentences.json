        "005241.webp",
        "005305.webp",
        "005306.webp",
        "005359.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi, cho luôn cái phần mà lá quế em cắt rối vào và thêm một chút xíu mè rang nữa, một xíu hành phi thôi.",
      "start": 216.2,
      "end": 223.8,
      "n_words": 26,
      "start_frame": 5405,
      "end_frame": 5595,
      "keyframes": [
        "005412.webp",
