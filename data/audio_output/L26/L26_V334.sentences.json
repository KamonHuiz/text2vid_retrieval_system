        "000606.webp",
        "000620.webp",
        "000621.webp",
        "000646.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Á thấm chưa?",
      "start": 26.8,
      "end": 31.12,
      "n_words": 3,
      "start_frame": 670,
      "end_frame": 778,
      "keyframes": [
        "000671.webp",
        "000672.webp",
        "000723.webp",
        "000775.webp",
        "000776.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Xả nhúc nè, chua tinh ốc rất ngon ngọt, muốn chua trời ơi, sao nó chua dữ thần vậy trời?",
      "start": 31.12,
      "end": 39.8,
      "n_words": 20,
      "start_frame": 778,
      "end_frame": 995,
      "keyframes": [
        "000816.webp",
        "000856.webp",
        "000857.webp",
        "000898.webp",
        "000940.webp",
        "000941.webp",
        "000965.webp",
        "000989.webp",
        "000990.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bây giờ có cách nào em xử nó không?",
      "start": 39.8,
      "end": 41.48,
      "n_words": 9,
      "start_frame": 995,
      "end_frame": 1037,
      "keyframes": [
        "001011.webp",
        "001033.webp",
        "001034.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thôi bây giờ làm một món gỏi đi, miền Trung cũng ngon lắm mà cóc nữa kết hợp ngon xuất sắc, nói chung làm gì cũng được đừng bắt ăn không là được.",
      "start": 41.48,
      "end": 49.76,
      "n_words": 33,
      "start_frame": 1037,
      "end_frame": 1244,
      "keyframes": [
        "001077.webp",
        "001121.webp",
        "001122.webp",
        "001157.webp",
        "001193.webp",
        "001194.webp",
        "001218.webp",
        "001243.webp",
        "001244.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Gỏi cóc tai heo giòn rụm, chua chua, càng ăn càng mê.",
      "start": 49.76,
      "end": 70.48,
      "n_words": 12,
      "start_frame": 1244,
      "end_frame": 1762,
      "keyframes": [
        "001244.webp",
        "001303.webp",
        "001363.webp",
        "001364.webp",
        "001397.webp",
        "001431.webp",
        "001446.webp",
        "001514.webp",
        "001583.webp",
        "001584.webp",
        "001670.webp",
        "001757.webp",
        "001758.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Chào các bạn khán giả đến với chương trình Món ngon mỗi ngày, chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 70.48,
      "end": 76.16,
      "n_words": 24,
      "start_frame": 1762,
      "end_frame": 1904,
      "keyframes": [
        "001832.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Anh Tuấn chuẩn bị giùm em cái nồi đi để mình luộc cái phần tai heo.",
      "start": 76.16,
      "end": 78.8,
      "n_words": 16,
      "start_frame": 1904,
      "end_frame": 1970,
      "keyframes": [
        "001907.webp",
        "001908.webp",
        "001941.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và tai heo khi chúng ta mua về thì chúng ta sẽ rửa sạch để cho hết mùi hôi và tai heo trắng hơn thì trước khi mà luộc tai heo thì chúng ta sẽ có ba củ hành tím chúng ta đập dập kèm theo chúng ta sẽ có một chút xíu gia vị.",
      "start": 78.8,
      "end": 88.92,
      "n_words": 55,
      "start_frame": 1970,
      "end_frame": 2223,
      "keyframes": [
        "001974.webp",
        "001975.webp",
        "002002.webp",
        "002030.webp",
        "002031.webp",
        "002055.webp",
        "002079.webp",
        "002080.webp",
        "002102.webp",
        "002125.webp",
        "002126.webp",
        "002148.webp",
        "002170.webp",
        "002171.webp",
        "002195.webp",
        "002220.webp",
        "002221.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Đầu tiên sẽ có một muỗng canh nước mắm nha, một muỗng cà phê muối, có thêm một muỗng cà phê bột ngọt Ajinomoto.",
      "start": 88.92,
      "end": 94.56,
      "n_words": 24,
      "start_frame": 2223,
      "end_frame": 2364,
      "keyframes": [
        "002248.webp",
        "002275.webp",
        "002276.webp",
        "002286.webp",
        "002297.webp",
        "002298.webp",
        "002309.webp",
        "002321.webp",
        "002322.webp",
        "002343.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Cho luôn cái phần tai heo đã được rửa sạch vào trong đây.",
      "start": 94.56,
      "end": 97.96,
      "n_words": 13,
      "start_frame": 2364,
      "end_frame": 2449,
      "keyframes": [
        "002365.webp",
        "002366.webp",
        "002407.webp",
        "002448.webp",
        "002449.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phần cóc đó chúng ta cắt mỏng nha.",
      "start": 97.96,
      "end": 99.68,
      "n_words": 8,
      "start_frame": 2449,
      "end_frame": 2492,
      "keyframes": [
        "002449.webp",
        "002475.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Anh Tuấn, cái phần lỗ tai này mình sẽ nấu trong khoảng bao lâu hả anh?",
      "start": 99.68,
      "end": 105.28,
      "n_words": 16,
      "start_frame": 2492,
      "end_frame": 2632,
      "keyframes": [
        "002502.webp",
        "002503.webp",
        "002569.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì chúng ta tính bắt đầu từ lúc nước sôi từ 15 tới 17 phút là lỗ tai vừa chín tới và còn giòn nha.",
      "start": 105.28,
      "end": 110.96,
      "n_words": 25,
      "start_frame": 2632,
      "end_frame": 2774,
      "keyframes": [
        "002636.webp",
        "002637.webp",
        "002708.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi đây là cái phần cóc, mình ra cắt mỏng ra nha.",
      "start": 110.96,
      "end": 113.6,
      "n_words": 12,
      "start_frame": 2774,
      "end_frame": 2840,
      "keyframes": [
        "002779.webp",
        "002780.webp",
        "002807.webp",
        "002834.webp",
        "002835.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và bây giờ thì xin sẽ có một muỗng canh đường thốt nốt bột.",
      "start": 113.6,
      "end": 116.44,
      "n_words": 14,
      "start_frame": 2840,
      "end_frame": 2911,
      "keyframes": [
        "002873.webp",
        "002911.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đối với món này chúng ta nên dùng đường thốt nốt để tạo hương vị đậm đà và độc đáo cho món ăn nha.",
      "start": 116.44,
      "end": 120.6,
      "n_words": 24,
      "start_frame": 2911,
      "end_frame": 3015,
      "keyframes": [
        "002911.webp",
        "002912.webp",
        "002962.webp",
        "003013.webp",
        "003014.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta có một phần ba muỗng cà phê muối nữa nha, trộn đều lên.",
      "start": 120.6,
      "end": 123.6,
      "n_words": 15,
      "start_frame": 3015,
      "end_frame": 3090,
      "keyframes": [
        "003040.webp",
        "003067.webp",
        "003068.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cóc sau khi chúng ta bào mỏng thì chúng ta trộn với đường và muối để tạo vị cho cóc và giảm được độ chua cũng như để cho cóc giòn hơn.",
      "start": 123.6,
      "end": 129.96,
      "n_words": 32,
      "start_frame": 3090,
      "end_frame": 3249,
      "keyframes": [
        "003092.webp",
        "003116.webp",
        "003117.webp",
        "003184.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và tiếp theo nữa thì xin sẽ cắt cái phần cà rốt đã được tỉa hoa nha, chúng ta sẽ cắt mỏng.",
      "start": 129.96,
      "end": 134.56,
      "n_words": 22,
      "start_frame": 3249,
      "end_frame": 3364,
      "keyframes": [
        "003252.webp",
        "003253.webp",
        "003327.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và bây giờ xin sẽ hướng dẫn cho mọi người cách pha cái phần nước sốt để chúng ta trộn gỏi nha: có ba muỗng canh đường thốt nốt đã được bào nhuyễn ra như vậy, và tiếp theo chúng ta sẽ có hai muỗng canh nước mắm.",
      "start": 134.56,
      "end": 145.2,
      "n_words": 48,
      "start_frame": 3364,
      "end_frame": 3630,
      "keyframes": [
        "003402.webp",
        "003403.webp",
        "003438.webp",
        "003473.webp",
        "003474.webp",
        "003516.webp",
        "003559.webp",
        "003560.webp",
        "003575.webp",
        "003591.webp",
        "003592.webp",
        "003614.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Và để cho món sốt này hoàn hảo hơn thì chúng ta sẽ có 1.5 muỗng canh giấm gạo lên men Ajinomoto.",
      "start": 145.2,
      "end": 150.24,
      "n_words": 22,
      "start_frame": 3630,
      "end_frame": 3756,
      "keyframes": [
        "003636.webp",
        "003637.webp",
        "003668.webp",
        "003700.webp",
        "003701.webp",
        "003727.webp",
        "003753.webp",
        "003754.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Tùy chúng ta thích tỏi nhiều ớt nhiều thì chúng ta bỏ theo sở thích của chúng ta nha, trộn đều hỗn hợp này lên.",
      "start": 150.24,
      "end": 155.92,
      "n_words": 25,
      "start_frame": 3756,
      "end_frame": 3898,
      "keyframes": [
        "003776.webp",
        "003799.webp",
        "003800.webp",
        "003831.webp",
        "003862.webp",
        "003863.webp",
        "003885.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tai heo cũng vừa chín tới ha, đó bắt đầu săn chắc đẹp đẽ rồi nè.",
      "start": 155.92,
      "end": 159.8,
      "n_words": 16,
      "start_frame": 3898,
      "end_frame": 3995,
      "keyframes": [
        "003908.webp",
        "003909.webp",
        "003921.webp",
        "003934.webp",
        "003935.webp",
        "003970.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Giờ sao, bây giờ chúng ta sẽ cho vào cái phần nước lạnh mà em đã chuẩn bị rồi.",
      "start": 159.8,
      "end": 163.48,
      "n_words": 19,
      "start_frame": 3995,
      "end_frame": 4087,
      "keyframes": [
        "004006.webp",
        "004007.webp",
        "004049.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Để cho món tai heo được ngon hơn, chúng ta cần thêm một muỗng canh giấm gạo lên men Ajinomoto nữa.",
      "start": 163.48,
      "end": 168.12,
      "n_words": 21,
      "start_frame": 4087,
      "end_frame": 4203,
      "keyframes": [
