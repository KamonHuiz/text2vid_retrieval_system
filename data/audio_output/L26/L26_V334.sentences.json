  "n_sentences": 48,
  "total_words": 1079,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.52,
      "end": 13.04,
      "n_words": 4,
      "start_frame": 263,
      "end_frame": 326,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thứ này nó ngon cho bà thấy nha, nè ăn thử nha, không thấy kêu em một tiếng nào luôn.",
      "start": 13.04,
      "end": 22.48,
      "n_words": 20,
      "start_frame": 326,
      "end_frame": 562,
      "keyframes": [
        "000379.webp",
        "000459.webp",
        "000460.webp",
        "000511.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ăn đi trời, muối ớt nữa, nè con này anh phải tỉa kỹ lắm luôn.",
      "start": 22.48,
      "end": 26.8,
      "n_words": 15,
      "start_frame": 562,
      "end_frame": 670,
      "keyframes": [
        "000563.webp",
