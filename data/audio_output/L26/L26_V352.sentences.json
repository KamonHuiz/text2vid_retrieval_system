        "004876.webp",
        "004895.webp",
        "004896.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nhưng trong cảm nhận của em vẫn còn thiếu một cái vị béo béo thanh thanh chua chua.",
      "start": 199.8,
      "end": 204.6,
