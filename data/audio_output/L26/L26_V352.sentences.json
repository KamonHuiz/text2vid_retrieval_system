        "002125.webp",
        "002210.webp",
        "002296.webp",
        "002297.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta cắt đôi, sau đó chúng ta cắt bỏ da, tiếp chúng ta sẽ cắt ra thành những lát mỏng.",
      "start": 92.24,
