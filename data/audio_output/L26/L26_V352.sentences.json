        "001743.webp",
        "001830.webp",
        "001831.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 75.92,
      "end": 79.68,
      "n_words": 11,
      "start_frame": 1898,
      "end_frame": 1992,
      "keyframes": [
        "001914.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và thưa bạn, nguyên liệu quen thuộc của chúng ta đó là một miếng thịt ba rọi.",
      "start": 79.68,
      "end": 83.8,
      "n_words": 17,
      "start_frame": 1992,
