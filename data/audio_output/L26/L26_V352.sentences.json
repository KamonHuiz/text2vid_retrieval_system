        "000610.webp",
        "000611.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Món ăn gì?",
      "start": 24.88,
      "end": 25.68,
      "n_words": 3,
      "start_frame": 622,
      "end_frame": 642,
      "keyframes": [
        "000634.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nói nghe cái.",
      "start": 25.68,
      "end": 26.56,
      "n_words": 3,
      "start_frame": 642,
      "end_frame": 664,
      "keyframes": [
        "000657.webp",
        "000658.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Món đó em chưa kịp nhìn thấy cái món đó luôn, á em chỉ thấy hình dáng nó mờ mờ là nó giống như snack nhưng nó không phải là snack thường.",
