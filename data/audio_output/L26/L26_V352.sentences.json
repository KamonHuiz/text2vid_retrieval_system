        "000888.webp",
        "000918.webp",
        "000949.webp",
        "000950.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mà cái món này công nhận lạ thiệt, nhưng mà em biết là sẽ không làm khó được anh Vũ đâu đúng không?",
      "start": 38.16,
      "end": 42.8,
      "n_words": 23,
      "start_frame": 954,
      "end_frame": 1070,
      "keyframes": [
        "000977.webp",
        "001005.webp",
        "001006.webp",
        "001035.webp",
        "001065.webp",
        "001066.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Với một nguyên liệu quen thuộc thôi nhưng mà anh sẽ cố gắng chế biến ra một món ăn như món trong mơ của em luôn.",
      "start": 42.8,
      "end": 48.72,
      "n_words": 26,
      "start_frame": 1070,
      "end_frame": 1218,
      "keyframes": [
        "001131.webp",
        "001197.webp",
        "001198.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Háo hức quá, mình vào bếp luôn nha anh.",
      "start": 48.72,
      "end": 50.32,
      "n_words": 9,
      "start_frame": 1218,
      "end_frame": 1258,
      "keyframes": [
        "001235.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi, mời em: Ba rọi tẩm trứng chiên giòn.",
      "start": 50.32,
      "end": 54.96,
      "n_words": 9,
      "start_frame": 1258,
      "end_frame": 1374,
      "keyframes": [
        "001273.webp",
        "001274.webp",
        "001298.webp",
        "001323.webp",
        "001324.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Làm cực dễ, vị cực ngon. Chào các bạn khán giả đang xem chương trình Món ngon mỗi ngày.",
      "start": 54.96,
      "end": 75.92,
