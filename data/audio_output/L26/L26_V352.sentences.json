      "n_words": 32,
      "start_frame": 664,
      "end_frame": 841,
      "keyframes": [
        "000738.webp",
        "000819.webp",
        "000820.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng, trong giấc mơ nó có sâu chuỗi câu chuyện, nhiều lúc nó vô lý lắm đúng không?",
      "start": 33.64,
      "end": 38.16,
      "n_words": 18,
      "start_frame": 841,
      "end_frame": 954,
      "keyframes": [
        "000853.webp",
