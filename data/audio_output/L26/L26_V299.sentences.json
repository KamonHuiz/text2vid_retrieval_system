      "end": 37.44,
      "n_words": 8,
      "start_frame": 873,
      "end_frame": 936,
      "keyframes": [
        "000895.webp",
        "000896.webp",
        "000931.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình nấu món gà đi cô. Được rồi, sẵn sàng thôi.",
