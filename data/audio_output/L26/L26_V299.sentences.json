        "001467.webp",
        "001468.webp",
        "001555.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 63.56,
      "end": 68.44,
      "n_words": 13,
