      "keyframes": [
        "000299.webp",
        "000300.webp",
        "000331.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trà Thông Phương, em chào cô buổi trưa. Mơ mộng gì ạ?",
