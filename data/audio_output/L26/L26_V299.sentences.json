      "keyframes": [
        "000363.webp",
        "000364.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Em đang mơ sao mà mình nhắm mắt rồi mình mở mắt ra là mình tới Phú Yên á.",
      "start": 17.32,
      "end": 21.28,
