        "000558.webp",
        "000579.webp",
        "000580.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Em thích mắt cá ngừ đại dương nè, rồi cơm gà Phú Yên nè, rồi lẩu gà lá é rồi.",
      "start": 23.8,
