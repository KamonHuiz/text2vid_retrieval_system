        "000723.webp",
        "000755.webp",
        "000756.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Như vậy là nhớ Phú Yên là chính, nhưng mà nhớ món ăn Phú Yên là 10 lần.",
