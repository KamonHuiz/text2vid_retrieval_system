      "end": 170.32,
      "n_words": 7,
      "start_frame": 4200,
      "end_frame": 4258,
      "keyframes": [
        "004229.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tiếp tục Hưng sẽ cho vào đây khoảng hai muỗng canh dầu ăn, cho vào đây một ít tỏi băm nè và một ít hành tím băm để chúng ta phi thơm.",
      "start": 170.32,
