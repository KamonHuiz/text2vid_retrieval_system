        "001467.webp",
        "001519.webp",
        "001520.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phần ớt chuông đỏ bây giờ chúng ta sẽ cắt sợi vừa ăn, lần lượt như vậy chúng ta cắt cái phần ớt chuông vàng.",
      "start": 60.88,
      "end": 69.68,
      "n_words": 25,
