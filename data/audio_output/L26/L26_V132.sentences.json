        "006370.webp",
        "006371.webp",
        "006434.webp",
        "006498.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cảm ơn Phước Hưng rất là nhiều. Và ngày hôm nay chúng ta có một món xào rất là ngon đúng không ạ?",
      "start": 259.92,
