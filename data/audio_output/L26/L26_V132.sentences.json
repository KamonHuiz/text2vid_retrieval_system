        "003389.webp",
        "003429.webp",
        "003430.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Lên trên bếp một cái chảo để chúng ta xào bò.",
      "start": 137.76,
      "end": 140.04,
      "n_words": 11,
      "start_frame": 3444,
