        "003728.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Bây giờ chúng ta phi thơm, đợi hành tỏi băm vàng lên thì chúng ta sẽ cho bò vào.",
      "start": 149.16,
      "end": 154.52,
