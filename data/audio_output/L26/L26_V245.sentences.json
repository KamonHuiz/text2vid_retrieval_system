        "001298.webp",
        "001344.webp",
        "001345.webp",
        "001435.webp",
        "001525.webp",
        "001526.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 63.92,
      "end": 68.16,
      "n_words": 11,
