        "000723.webp",
        "000781.webp",
        "000782.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hôm nay gặp đầu bếp thì chắc chắn là phải ăn rồi.",
      "start": 31.28,
      "end": 33.92,
      "n_words": 12,
      "start_frame": 782,
      "end_frame": 848,
      "keyframes": [
