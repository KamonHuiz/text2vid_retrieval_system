        "002590.webp",
        "002613.webp",
        "002614.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Sẽ lấy khoanh cá thu, chúng ta sẽ tẩm qua bột nè, miếng thứ hai.",
      "start": 104.6,
      "end": 113.44,
      "n_words": 15,
