        "001049.webp",
        "001074.webp",
        "001075.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Giòn giòn, cực mê.",
      "start": 43.0,
      "end": 44.68,
      "n_words": 4,
      "start_frame": 1075,
      "end_frame": 1117,
      "keyframes": [
        "001075.webp",
        "001113.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cá thu chiên nghệ. Chào các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 44.68,
      "end": 63.92,
      "n_words": 16,
      "start_frame": 1117,
      "end_frame": 1598,
      "keyframes": [
        "001151.webp",
