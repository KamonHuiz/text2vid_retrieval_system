        "000813.webp",
        "000845.webp",
        "000846.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Được luôn, vậy thì ngày hôm nay Phương sẽ kết hợp nghệ với lại cá cho ra một cái món ăn rất là độc đáo mà lạ miệng nữa.",
      "start": 33.92,
      "end": 40.0,
      "n_words": 29,
      "start_frame": 848,
      "end_frame": 1000,
      "keyframes": [
        "000921.webp",
        "000997.webp",
        "000998.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Làm ngay thôi!",
      "start": 40.0,
      "end": 43.0,
      "n_words": 3,
      "start_frame": 1000,
      "end_frame": 1075,
      "keyframes": [
