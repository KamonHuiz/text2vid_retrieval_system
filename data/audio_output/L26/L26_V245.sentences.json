        "002430.webp",
        "002491.webp",
        "002492.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ Phước Hương sẽ cho gói bột chi xù, bột tẩm khô chiên giòn ra một cái dĩa nè.",
      "start": 99.76,
      "end": 104.6,
      "n_words": 20,
      "start_frame": 2494,
      "end_frame": 2615,
      "keyframes": [
