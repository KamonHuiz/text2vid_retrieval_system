      "keyframes": [
        "003554.webp",
        "003555.webp",
        "003624.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, cho thính gạo rang vào để giúp cho món nước chấm có hương vị đặc trưng hơn.",
      "start": 147.2,
