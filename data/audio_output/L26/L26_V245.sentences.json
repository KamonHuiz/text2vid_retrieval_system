        "000627.webp",
        "000665.webp",
        "000666.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Vậy thì ngày hôm nay Minh Phương muốn ăn từ củ nghệ hay là muốn uống từ củ nghệ nè?",
      "start": 26.8,
