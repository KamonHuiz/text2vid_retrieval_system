        "002909.webp",
        "002944.webp",
        "002945.webp",
        "002968.webp",
        "002991.webp",
        "002992.webp",
        "003037.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đúng rồi, mình sẽ lựa chọn cái nho không hột á thì nó sẽ ngon và dễ thưởng thức hơn.",
      "start": 122.12,
      "end": 128.0,
      "n_words": 20,
      "start_frame": 3053,
      "end_frame": 3200,
      "keyframes": [
        "003083.webp",
        "003084.webp",
        "003127.webp",
        "003171.webp",
        "003172.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ chọn phần nho xanh không hạt nha bởi vì nó sẽ không có cái phần lợn cợn trong nước pha nè khi mà không có hạt.",
      "start": 128.0,
      "end": 134.32,
      "n_words": 29,
      "start_frame": 3200,
      "end_frame": 3358,
      "keyframes": [
        "003222.webp",
        "003272.webp",
        "003273.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngoài ra nho xanh thì có vị chua nhẹ nữa, cũng rất là phù hợp với thức uống ngày hôm nay.",
      "start": 134.32,
      "end": 139.08,
      "n_words": 21,
      "start_frame": 3358,
      "end_frame": 3477,
      "keyframes": [
        "003374.webp",
        "003475.webp",
        "003476.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì mình sẽ dầm cái phần nho này cho nó dập ra, trong lúc dầm mình sẽ xoáy nhẹ như này nè nó sẽ dễ hơn.",
      "start": 139.08,
      "end": 148.84,
      "n_words": 26,
      "start_frame": 3477,
      "end_frame": 3721,
      "keyframes": [
        "003506.webp",
        "003537.webp",
