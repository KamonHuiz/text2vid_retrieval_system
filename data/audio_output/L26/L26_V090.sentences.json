        "001302.webp",
        "001347.webp",
        "001392.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta thực hiện ngay thôi.",
      "start": 55.68,
      "end": 56.88,
      "n_words": 6,
      "start_frame": 1392,
      "end_frame": 1422,
      "keyframes": [
        "001392.webp",
        "001393.webp",
        "001413.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, và bây giờ mình sẽ đi vào thực hiện ha.",
      "start": 56.88,
      "end": 59.48,
      "n_words": 12,
      "start_frame": 1422,
      "end_frame": 1487,
      "keyframes": [
        "001433.webp",
        "001434.webp",
        "001464.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ, chúng ta sẽ cho vào trong đây hai gói Landi trà sữa Royvo, thêm vào trong đây là 60 ml nước sôi, sau đó chúng ta sẽ khuấy tan đều và để nguội ha. Đơn giản như vậy thôi ạ.",
      "start": 59.48,
      "end": 70.96,
      "n_words": 41,
      "start_frame": 1487,
      "end_frame": 1774,
      "keyframes": [
        "001495.webp",
        "001496.webp",
        "001520.webp",
        "001544.webp",
        "001545.webp",
        "001565.webp",
        "001586.webp",
        "001587.webp",
        "001654.webp",
        "001722.webp",
        "001723.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đúng rồi, nước thôi gọn mình nghe.",
      "start": 70.96,
      "end": 72.92,
      "n_words": 7,
      "start_frame": 1774,
      "end_frame": 1823,
      "keyframes": [
        "001799.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trà sữa mình cứ nghĩ là mình phải nấu trà lên, mình phải nấu sữa lên rồi mình pha định lượng như thế nào sao cho phù hợp.",
      "start": 72.92,
      "end": 78.72,
      "n_words": 28,
      "start_frame": 1823,
      "end_frame": 1968,
      "keyframes": [
        "001876.webp",
        "001944.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Tuy nhiên khi mà có gói Landi trà sữa Royvo thì dường như mọi thứ đã đơn giản hơn rất là nhiều.",
      "start": 78.72,
      "end": 83.8,
      "n_words": 22,
      "start_frame": 1968,
      "end_frame": 2095,
      "keyframes": [
        "001995.webp",
        "002046.webp",
        "002047.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ bỏ qua được rất là nhiều công đoạn mà nhanh chóng thôi mình đã có được một cái phần trà sữa đậm vị đúng chất luôn.",
      "start": 83.8,
      "end": 90.4,
      "n_words": 29,
      "start_frame": 2095,
      "end_frame": 2260,
      "keyframes": [
        "002096.webp",
        "002146.webp",
        "002147.webp",
        "002212.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng rồi, mình sẽ khuấy cho nó tan hết đều luôn nha.",
      "start": 90.4,
      "end": 94.72,
      "n_words": 12,
      "start_frame": 2260,
      "end_frame": 2368,
      "keyframes": [
        "002277.webp",
        "002278.webp",
        "002320.webp",
        "002362.webp",
        "002363.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Để pha được ngon hơn thì đơn giản lắm, chúng ta chỉ việc theo dõi thật là kỹ hướng dẫn ở trên Landi trà sữa Royvo đó là nếu như chúng ta muốn uống nóng thì chúng ta sẽ pha lượng nước bao nhiêu, còn uống lạnh thì mình pha ít nước thôi để khi cho đá vào thì sẽ vừa hơn.",
      "start": 94.72,
      "end": 108.84,
      "n_words": 62,
      "start_frame": 2368,
      "end_frame": 2721,
      "keyframes": [
        "002406.webp",
        "002450.webp",
        "002451.webp",
        "002593.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng rồi, khuấy xong rồi mình sẽ để qua một bên cho nó nguội ha.",
      "start": 108.84,
      "end": 114.44,
      "n_words": 15,
