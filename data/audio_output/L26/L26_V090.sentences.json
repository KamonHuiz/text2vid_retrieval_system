        "005416.webp",
        "005417.webp",
        "005486.webp",
        "005555.webp",
        "005556.webp",
        "005615.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chúng ta nên trang trí bằng một lớp sốt sô cô la, trang trí một lá húng lủi lên trên nữa nè.",
      "start": 225.96,
      "end": 231.2,
      "n_words": 22,
      "start_frame": 5649,
      "end_frame": 5780,
      "keyframes": [
        "005675.webp",
        "005676.webp",
        "005695.webp",
        "005715.webp",
        "005716.webp",
        "005748.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và bây giờ là món thức uống của chúng ta đã hoàn thành. Như vậy Thanh Phương đã hoàn thành.",
      "start": 231.2,
      "end": 233.96,
      "n_words": 20,
      "start_frame": 5780,
      "end_frame": 5849,
      "keyframes": [
        "005781.webp",
        "005782.webp",
        "005825.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ, Thanh Phương để ý dạo gần đây các bạn trẻ rất là thích những cái loại thức uống mà có kết hợp với lại kem.",
      "start": 234.32,
      "end": 239.52,
      "n_words": 26,
      "start_frame": 5858,
      "end_frame": 5988,
      "keyframes": [
        "005868.webp",
        "005869.webp",
        "005928.webp",
        "005988.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ở đây vừa có sự kết hợp giữa trà sữa nè, kem và nho nữa thì chắc chắn rằng đây sẽ là một món thức uống mà hầu như ai cũng yêu thích luôn đấy ạ.",
      "start": 239.52,
      "end": 246.8,
      "n_words": 36,
