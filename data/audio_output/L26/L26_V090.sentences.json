        "006291.webp",
        "006292.webp",
        "006316.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và món thức uống của chúng ta đã hoàn thành rồi đó Thanh Phương.",
      "start": 253.44,
      "end": 256.08,
      "n_words": 14,
