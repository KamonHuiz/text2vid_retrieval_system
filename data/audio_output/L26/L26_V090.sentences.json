      "end_frame": 2861,
      "keyframes": [
        "002736.webp",
        "002737.webp",
        "002805.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tiếp theo mình sẽ đi pha cái phần thức uống, cho vào trong đây là 6 trái nho, hình như là nho mẫu đơn đúng không ạ?",
      "start": 114.44,
      "end": 122.12,
      "n_words": 27,
      "start_frame": 2861,
      "end_frame": 3053,
      "keyframes": [
        "002874.webp",
