        "003557.webp",
        "003577.webp",
        "003578.webp",
        "003623.webp",
        "003668.webp",
        "003669.webp",
        "003717.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Với thức uống ngày hôm nay, chúng ta nên dầm nho để tạo hương vị đặc trưng cho thức uống nha.",
      "start": 148.84,
      "end": 153.08,
      "n_words": 21,
      "start_frame": 3721,
      "end_frame": 3827,
      "keyframes": [
        "003765.webp",
        "003766.webp",
        "003796.webp",
        "003826.webp",
        "003827.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp theo là mình sẽ cho cái phần nước đá này vào cho cái phần nước đá nó sát hết cái mặt như thế này luôn ha.",
      "start": 153.08,
      "end": 162.88,
      "n_words": 27,
      "start_frame": 3827,
      "end_frame": 4072,
      "keyframes": [
        "003827.webp",
        "003875.webp",
        "003924.webp",
