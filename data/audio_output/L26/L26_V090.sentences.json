        "003959.webp",
        "003994.webp",
        "003995.webp",
        "004035.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Ở đây mình sẽ sử dụng sữa tươi không đường nha.",
      "start": 162.88,
      "end": 166.84,
      "n_words": 11,
      "start_frame": 4072,
      "end_frame": 4171,
      "keyframes": [
        "004076.webp",
        "004077.webp",
        "004126.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho cái hỗn hợp trà sữa này vào trên, mình sẽ cho cái phần này nhẹ nhàng thôi để nó tạo cái tầng cho nó đẹp, cho nó đẹp mắt.",
      "start": 166.84,
      "end": 176.6,
      "n_words": 30,
      "start_frame": 4171,
      "end_frame": 4415,
      "keyframes": [
        "004175.webp",
        "004176.webp",
        "004223.webp",
        "004270.webp",
        "004271.webp",
        "004345.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Một cái loại thức uống rất là đẹp mắt luôn, có từng lớp từng phần rõ.",
      "start": 176.96,
      "end": 180.4,
      "n_words": 16,
      "start_frame": 4424,
      "end_frame": 4510,
      "keyframes": [
        "004455.webp",
        "004490.webp",
        "004491.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ở phần phía dưới là màu xanh ngọc của nho nè, rất là tốt cho mắt, kết hợp với lại sữa có canxi nè ha và thêm trà sữa có vị thơm thơm béo béo nữa.",
      "start": 180.4,
      "end": 189.88,
      "n_words": 36,
      "start_frame": 4510,
      "end_frame": 4747,
      "keyframes": [
        "004541.webp",
        "004591.webp",
        "004592.webp",
        "004702.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Món thức uống này quả thật rất hấp dẫn luôn đó anh Vinh.",
      "start": 189.88,
      "end": 192.6,
      "n_words": 13,
      "start_frame": 4747,
      "end_frame": 4815,
      "keyframes": [
        "004813.webp",
        "004814.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và để hấp dẫn hơn chúng ta sẽ cho thêm ba viên kem vani lên trên ly để tăng thêm cái vị béo nhẹ cho món thức uống của chúng ta nha.",
