        "003350.webp",
        "003381.webp",
        "003382.webp"
      ],
      "keyframe_count": 20
    },
    {
      "text": "Rồi một nguyên liệu nữa là cá dứa thì phải có lá dứa và hai lát gừng.",
      "start": 137.04,
      "end": 142.0,
      "n_words": 17,
