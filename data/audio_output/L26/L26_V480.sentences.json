        "005668.webp",
        "005669.webp",
        "005692.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Kế tiếp chúng ta sẽ cho hành tây vào xóc lên tí, hành tây nó trong lại là được đúng không anh?",
      "start": 228.56,
