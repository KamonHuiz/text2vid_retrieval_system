      "keyframes": [
        "002732.webp",
        "002770.webp",
        "002771.webp",
        "002807.webp",
        "002844.webp",
        "002845.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hành tây khoảng nửa củ hoặc một phần tư củ thôi, chúng ta cắt muối cao như vậy hết xong chúng ta cho ra dĩa.",
      "start": 113.84,
      "end": 122.4,
      "n_words": 25,
      "start_frame": 2846,
      "end_frame": 3060,
      "keyframes": [
        "002916.webp",
        "002987.webp",
