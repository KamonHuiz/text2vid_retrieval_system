        "002655.webp",
        "002693.webp",
        "002694.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chính xác nha, mình cho một gói vào đây, các bạn chúng ta trộn đều lên rồi xong chúng ta để qua một bên.",
      "start": 108.4,
      "end": 113.84,
      "n_words": 24,
