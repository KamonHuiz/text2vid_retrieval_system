        "001195.webp",
        "001196.webp",
        "001243.webp",
        "001291.webp",
        "001292.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Em là người rất thích cá dứa, rất là tươi đúng không anh?",
      "start": 51.68,
      "end": 54.56,
      "n_words": 13,
