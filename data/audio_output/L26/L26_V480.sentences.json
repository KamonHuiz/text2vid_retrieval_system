        "001757.webp",
        "001758.webp",
        "001872.webp",
        "001986.webp",
        "001987.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Chào các bạn của chương trình Món ngon mỗi ngày được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 79.64,
      "end": 84.88,
      "n_words": 19,
      "start_frame": 1991,
      "end_frame": 2122,
      "keyframes": [
        "002057.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn lưu ý nha, cá dứa một nắng chúng ta rửa sạch cá dứa với lại nước lạnh, sau đó chúng ta thấm ráo nước như vậy thì cá dứa một nắng chúng ta sẽ thơm và không bị tanh nha các bạn.",
      "start": 84.88,
