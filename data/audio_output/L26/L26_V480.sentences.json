        "001334.webp",
        "001335.webp",
        "001344.webp",
        "001354.webp",
        "001355.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rảnh không đi mua cá dứa để em để vô cho anh nấu cá dứa một nắng chua ngọt đậm đà mến.",
      "start": 54.56,
      "end": 79.64,
      "n_words": 22,
