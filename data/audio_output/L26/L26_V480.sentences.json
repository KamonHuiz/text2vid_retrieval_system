        "004160.webp",
        "004241.webp",
        "004242.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rồi bây giờ chúng ta tới giai đoạn chế biến thôi các bạn.",
      "start": 169.8,
      "end": 172.36,
      "n_words": 13,
      "start_frame": 4245,
      "end_frame": 4309,
      "keyframes": [
        "004272.webp",
        "004302.webp",
        "004303.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Một cái chảo dầu và một cái chảo xào.",
      "start": 172.36,
      "end": 174.76,
      "n_words": 9,
      "start_frame": 4309,
      "end_frame": 4369,
      "keyframes": [
        "004317.webp",
        "004332.webp",
        "004333.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chính xác, chúng ta nên để cái dầu vừa nóng thôi chúng ta cho gừng vô.",
      "start": 174.76,
      "end": 179.24,
      "n_words": 16,
      "start_frame": 4369,
