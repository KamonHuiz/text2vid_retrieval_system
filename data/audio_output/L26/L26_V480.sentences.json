        "005363.webp",
        "005392.webp",
        "005393.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi cá sau khi chúng ta chiên vàng như vậy, cho xíu dầu hoặc là lấy dầu hồi nãy mình chiên luôn ha.",
      "start": 215.8,
      "end": 222.44,
      "n_words": 23,
