      "end_frame": 1014,
      "keyframes": [
        "000873.webp",
        "000903.webp",
        "000904.webp",
        "000958.webp",
        "001013.webp",
        "001014.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vậy thôi em cho thêm nước, em bấm thêm một tiếng nữa thành cháo.",
      "start": 40.56,
      "end": 45.12,
      "n_words": 14,
      "start_frame": 1014,
      "end_frame": 1128,
      "keyframes": [
        "001014.webp",
        "001042.webp",
        "001071.webp",
        "001072.webp",
        "001089.webp",
        "001107.webp",
        "001108.webp",
        "001123.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cháo bây giờ anh phải giúp đỡ đời em, đi đố em trả về sao biết hay vậy ta?",
      "start": 45.12,
      "end": 51.68,
