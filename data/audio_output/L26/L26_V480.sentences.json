      "start_frame": 306,
      "end_frame": 368,
      "keyframes": [
        "000362.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Có ai mua nồi hay cơm ráng em mới ôm cái nồi cơm điện này trong mới vô mà anh la em rồi.",
      "start": 14.72,
