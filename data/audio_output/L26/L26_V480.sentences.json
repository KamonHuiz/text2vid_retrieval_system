        "003532.webp",
        "003541.webp",
        "003550.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Tất cả nguyên liệu đã xong, bây giờ chúng ta sẽ pha cái nước gia vị.",
      "start": 142.0,
      "end": 145.52,
