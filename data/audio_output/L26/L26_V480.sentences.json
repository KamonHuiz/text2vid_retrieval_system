        "004738.webp",
        "004768.webp",
        "004769.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đó, quá thơm luôn, thật sự luôn, rất là thơm anh ơi!",
      "start": 192.2,
      "end": 194.52,
      "n_words": 12,
      "start_frame": 4805,
      "end_frame": 4863,
      "keyframes": [
        "004830.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đây chúng ta vớt ra, chúng ta cho cá dứa vô chiên, dầu chiên ngập dầu như vậy mình chiên với lửa khoảng chừng 75% lửa hơi lớn thôi, chiên từ từ.",
      "start": 194.52,
      "end": 206.36,
      "n_words": 32,
