        "005180.webp",
        "005181.webp",
        "005195.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đó, em sẽ phết một lớp dầu mỏng lên trên cái vỉ nướng này ha.",
      "start": 208.32,
      "end": 212.2,
      "n_words": 15,
