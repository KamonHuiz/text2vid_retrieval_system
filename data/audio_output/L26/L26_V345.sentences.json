        "005256.webp",
        "005301.webp",
        "005302.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Mình sẽ nướng rau củ trước cô ha?",
      "start": 212.2,
      "end": 214.0,
      "n_words": 8,
      "start_frame": 5305,
      "end_frame": 5350,
      "keyframes": [
        "005338.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, màu sắc rất là bắt mắt luôn.",
