        "001247.webp",
        "001248.webp",
        "001334.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 56.8,
      "end": 59.28,
      "n_words": 13,
      "start_frame": 1420,
      "end_frame": 1482,
      "keyframes": [
        "001421.webp",
        "001422.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 59.84,
      "end": 63.84,
      "n_words": 11,
      "start_frame": 1496,
      "end_frame": 1596,
      "keyframes": [
        "001511.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ em giúp cô là những cái trái đậu bắp này đó, thì mình sẽ chẻ dọc ra.",
      "start": 63.84,
      "end": 68.72,
      "n_words": 19,
      "start_frame": 1596,
      "end_frame": 1718,
      "keyframes": [
        "001601.webp",
        "001602.webp",
        "001622.webp",
        "001643.webp",
        "001644.webp",
        "001671.webp",
        "001698.webp",
        "001699.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rồi còn bí đỏ thì bây giờ mình sẽ cắt lát dày khoảng chừng 3 ly.",
      "start": 68.72,
      "end": 72.88,
      "n_words": 16,
