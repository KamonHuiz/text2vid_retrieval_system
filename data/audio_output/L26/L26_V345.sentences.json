      "end": 182.44,
      "n_words": 7,
      "start_frame": 4529,
      "end_frame": 4561,
      "keyframes": [
        "004540.webp",
        "004541.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đó, chúng ta xay gia vị để gia vị dễ thấm nè, thấm đều và đặc biệt là tiết kiệm thời gian nữa.",
      "start": 182.44,
      "end": 188.04,
      "n_words": 23,
      "start_frame": 4561,
      "end_frame": 4701,
      "keyframes": [
        "004581.webp",
        "004622.webp",
        "004623.webp",
        "004663.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ thì cô sẽ ướp cái sốt với lại thịt bò.",
      "start": 188.04,
      "end": 190.6,
      "n_words": 12,
      "start_frame": 4701,
      "end_frame": 4765,
      "keyframes": [
        "004703.webp",
        "004704.webp",
        "004734.webp",
        "004765.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Một muỗng sốt lên cho cô rồi bên này nữa, rồi đó thì mình sẽ phết ra để cô trở lại.",
      "start": 190.6,
      "end": 197.0,
      "n_words": 21,
      "start_frame": 4765,
      "end_frame": 4925,
