      "end_frame": 788,
      "keyframes": [
        "000751.webp",
        "000788.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Vậy thì ngay bây giờ cô với em làm luôn nha.",
      "start": 31.52,
      "end": 33.72,
      "n_words": 11,
      "start_frame": 788,
      "end_frame": 843,
      "keyframes": [
        "000788.webp",
        "000789.webp",
        "000821.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Đúng rồi, thịt bò nướng mè kiểu Hàn Quốc bùi bùi cay cay, thơm say lòng người.",
      "start": 33.72,
      "end": 56.8,
      "n_words": 18,
      "start_frame": 843,
      "end_frame": 1420,
      "keyframes": [
        "000854.webp",
