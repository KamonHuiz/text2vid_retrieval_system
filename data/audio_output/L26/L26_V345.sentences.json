        "002491.webp",
        "002531.webp",
        "002532.webp",
        "002591.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "- Đúng rồi.",
      "start": 105.28,
      "end": 106.08,
      "n_words": 3,
      "start_frame": 2632,
      "end_frame": 2652,
      "keyframes": [
        "002650.webp",
        "002651.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Sau khi mà mình đã cắt những miếng thịt bò xong như thế này rồi, bây giờ thì chúng ta sẽ dàn miếng thịt bò.",
      "start": 106.08,
      "end": 110.48,
      "n_words": 25,
      "start_frame": 2652,
      "end_frame": 2762,
      "keyframes": [
        "002685.webp",
        "002719.webp",
        "002720.webp",
        "002740.webp",
        "002760.webp",
        "002761.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình có thể dùng màng bọc thực phẩm cũng được.",
      "start": 110.48,
      "end": 112.4,
      "n_words": 10,
      "start_frame": 2762,
      "end_frame": 2810,
      "keyframes": [
        "002784.webp",
        "002807.webp",
        "002808.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ cắt hai lát thịt bò dính ở cạnh bìa để có miếng thịt bò to hơn và dùng búa dần để thịt bò sau khi nướng mềm hơn ha.",
      "start": 112.4,
      "end": 121.36,
      "n_words": 37,
      "start_frame": 2810,
      "end_frame": 3034,
      "keyframes": [
        "002917.webp",
        "003026.webp",
        "003027.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi cứ như vậy thì chúng ta sẽ dần cho đến khi hết cái phần thịt bò.",
      "start": 121.36,
      "end": 125.08,
      "n_words": 17,
      "start_frame": 3034,
      "end_frame": 3127,
      "keyframes": [
        "003080.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Hay đúng là miếng bò nhìn rất là to mà mềm nữa.",
      "start": 125.08,
      "end": 128.68,
      "n_words": 13,
      "start_frame": 3127,
      "end_frame": 3217,
      "keyframes": [
        "003134.webp",
