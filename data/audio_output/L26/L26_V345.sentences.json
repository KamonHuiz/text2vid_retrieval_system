        "005063.webp",
        "005064.webp",
        "005099.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Mình chỉ cần để thấm khoảng chừng 10 phút là có thể nướng được rồi.",
      "start": 205.32,
      "end": 208.32,
      "n_words": 15,
      "start_frame": 5133,
      "end_frame": 5208,
      "keyframes": [
