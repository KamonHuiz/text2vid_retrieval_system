        "002083.webp",
        "002107.webp",
        "002108.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Cho một chút xíu dầu ha sẽ thơm nè.",
      "start": 84.32,
      "end": 86.6,
      "n_words": 9,
      "start_frame": 2108,
      "end_frame": 2165,
      "keyframes": [
        "002108.webp",
        "002136.webp",
        "002164.webp",
        "002165.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thịt bò trong món này thì mình sẽ chọn là thịt bò phi lê. Mình sẽ cắt phần thịt bò dày khoảng chừng 4 ly như thế này.",
      "start": 86.6,
      "end": 93.24,
      "n_words": 28,
      "start_frame": 2165,
      "end_frame": 2331,
      "keyframes": [
        "002165.webp",
        "002201.webp",
        "002238.webp",
        "002239.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đầu tiên, cái nhát cắt đầu tiên mình giữ dính lại ở đây, rồi cứ hai lát thịt bò dính nhau ở cạnh như thế này em biết chưa, để nhìn cho cái miếng bò nó cũng là to hơn nè. Không cô?",
      "start": 93.24,
      "end": 105.28,
      "n_words": 43,
      "start_frame": 2331,
      "end_frame": 2632,
      "keyframes": [
        "002344.webp",
