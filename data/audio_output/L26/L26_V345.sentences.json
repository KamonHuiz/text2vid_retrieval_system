        "000684.webp",
        "000714.webp",
        "000715.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "- Trời ơi, cô nói thì em mới nhớ ra là mình còn thiếu món nướng.",
      "start": 28.68,
      "end": 31.52,
      "n_words": 16,
