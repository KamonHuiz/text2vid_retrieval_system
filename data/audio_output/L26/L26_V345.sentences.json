      "n_words": 10,
      "start_frame": 5495,
      "end_frame": 5546,
      "keyframes": [
        "005500.webp",
        "005501.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Rồi nhưng mà miếng bò này thì mình nướng khoảng bao lâu thì được hả cô?",
      "start": 221.84,
      "end": 224.32,
      "n_words": 17,
      "start_frame": 5546,
      "end_frame": 5608,
      "keyframes": [
        "005552.webp",
        "005603.webp",
        "005604.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Thịt bò thì mình cũng không nên nướng lâu quá, nướng vừa chín tới là được rồi.",
      "start": 224.32,
