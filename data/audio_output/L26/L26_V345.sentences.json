        "001794.webp",
        "001821.webp",
        "001822.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Mình sẽ dùng cái loại bí đỏ hồ lô này thì nó ngon hơn.",
      "start": 72.88,
      "end": 75.6,
      "n_words": 14,
      "start_frame": 1822,
      "end_frame": 1890,
      "keyframes": [
        "001822.webp",
        "001854.webp",
        "001887.webp",
        "001888.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đầu tiên thì chúng ta sẽ ướp rau củ quả với lại 3 muỗng canh dầu ô liu, một ít muối thôi và một ít tiêu, rồi sau đó thì mình sẽ trộn đều lên.",
      "start": 75.6,
      "end": 84.32,
      "n_words": 35,
      "start_frame": 1890,
      "end_frame": 2108,
      "keyframes": [
        "001936.webp",
