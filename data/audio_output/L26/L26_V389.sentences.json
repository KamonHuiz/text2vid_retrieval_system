      "start_frame": 4677,
      "end_frame": 4718,
      "keyframes": [
        "004714.webp",
        "004715.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi kế tiếp chúng ta sẽ cho thịt gà đã ướp vào.",
