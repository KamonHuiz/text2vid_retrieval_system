      "end": 21.48,
      "n_words": 14,
      "start_frame": 444,
      "end_frame": 537,
      "keyframes": [
        "000513.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng vậy đó, mà hôm nay sẽ dùng phương pháp sáo đó.",
