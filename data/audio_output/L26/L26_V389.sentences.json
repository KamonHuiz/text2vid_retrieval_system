      "end_frame": 384,
      "keyframes": [
        "000362.webp",
        "000363.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Em đang chuẩn bị món ăn ngày hôm nay đó, mắm ruốc.",
      "start": 15.36,
      "end": 17.76,
      "n_words": 12,
