        "005457.webp",
        "005474.webp",
        "005475.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Trong món ăn này thì chúng ta đã kết hợp tương ớt Quảng Nam, gừng, ớt và hải sâm để tạo nên hương vị mới lạ cho món xào.",
      "start": 219.04,
      "end": 226.84,
      "n_words": 29,
      "start_frame": 5476,
      "end_frame": 5671,
      "keyframes": [
        "005503.webp",
        "005532.webp",
        "005533.webp",
