        "000558.webp",
        "000570.webp",
        "000571.webp",
        "000621.webp",
        "000671.webp",
        "000672.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Hay là bữa nay mình làm món xào với hải sâm nè, đó là một món ăn rất là bổ dưỡng đó.",
      "start": 26.96,
      "end": 32.72,
      "n_words": 22,
      "start_frame": 674,
      "end_frame": 818,
      "keyframes": [
        "000708.webp",
        "000745.webp",
        "000746.webp",
        "000773.webp",
        "000801.webp",
        "000802.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Trời, nghe hấp dẫn quá! Mình vào bếp thực hiện cô ha?",
      "start": 32.72,
      "end": 35.04,
      "n_words": 13,
      "start_frame": 818,
      "end_frame": 876,
      "keyframes": [
        "000843.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Đúng rồi, hải sâm xào sốt cay, cắn miếng nào mê ngay miếng đó.",
      "start": 35.04,
      "end": 56.8,
      "n_words": 15,
      "start_frame": 876,
      "end_frame": 1420,
      "keyframes": [
        "000884.webp",
        "000885.webp",
        "000909.webp",
        "000934.webp",
        "000935.webp",
        "000990.webp",
        "001045.webp",
