        "000438.webp",
        "000462.webp",
        "000487.webp",
        "000488.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "- Cô nghĩ là ai quý em món ăn nó tặng em thì em có thể là hấp cũng được, xào cũng được nữa.",
      "start": 19.52,
      "end": 26.96,
      "n_words": 24,
      "start_frame": 488,
      "end_frame": 674,
      "keyframes": [
        "000488.webp",
