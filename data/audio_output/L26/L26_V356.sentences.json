        "004317.webp",
        "004340.webp",
        "004341.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Thì mình sẽ sử dụng một cái trái ớt, cái trái ớt sừng thì nó cũng có cái mùi thơm đặc trưng the thôi, và hành ngò thì chúng ta sẽ cắt khúc.",
      "start": 173.68,
      "end": 182.68,
      "n_words": 33,
      "start_frame": 4342,
      "end_frame": 4567,
      "keyframes": [
        "004377.webp",
        "004413.webp",
        "004414.webp",
        "004430.webp",
        "004447.webp",
        "004448.webp",
        "004470.webp",
        "004493.webp",
        "004494.webp",
        "004541.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Và như vậy là chúng ta đã sơ chế các loại rau củ.",
      "start": 182.68,
      "end": 185.16,
      "n_words": 13,
      "start_frame": 4567,
      "end_frame": 4629,
      "keyframes": [
        "004588.webp",
        "004589.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ thì chúng ta hãy xào hải sản nha.",
      "start": 185.16,
      "end": 187.6,
      "n_words": 10,
      "start_frame": 4629,
      "end_frame": 4690,
      "keyframes": [
        "004638.webp",
        "004688.webp",
        "004689.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bật một cái chảo lên trên bếp nha, sẽ cho một ít dầu ăn vào đây, khoảng chừng một muỗng canh.",
      "start": 187.6,
      "end": 192.32,
      "n_words": 21,
      "start_frame": 4690,
      "end_frame": 4808,
      "keyframes": [
        "004715.webp",
        "004742.webp",
        "004743.webp",
        "004762.webp",
        "004781.webp",
        "004782.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Gừng cắt hình thoi vào trong này, một muỗng canh tỏi băm, một muỗng cà phê ớt hiểm băm mình sẽ cho vào đây.",
      "start": 192.32,
      "end": 199.52,
      "n_words": 24,
      "start_frame": 4808,
      "end_frame": 4988,
      "keyframes": [
        "004814.webp",
        "004847.webp",
        "004848.webp",
        "004869.webp",
        "004890.webp",
        "004891.webp",
        "004908.webp",
        "004926.webp",
        "004927.webp",
        "004945.webp",
        "004964.webp",
        "004965.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Ớt hiểm đã được ngâm khô có bốn loại ớt cô sử dụng cho món này luôn rồi đó ạ, tại vì món này là một cái món sốt cay.",
      "start": 199.52,
      "end": 206.4,
      "n_words": 30,
      "start_frame": 4988,
      "end_frame": 5160,
      "keyframes": [
        "004993.webp",
        "005021.webp",
        "005022.webp",
        "005056.webp",
        "005090.webp",
        "005091.webp",
        "005124.webp",
        "005158.webp",
        "005159.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Cho cái phần tôm và hải sâm vào đây, xào lên, tiếp tục nhanh tay cho phần còn lại của tương ớt Quảng Nam vô đây.",
      "start": 206.4,
      "end": 219.04,
      "n_words": 26,
      "start_frame": 5160,
      "end_frame": 5476,
      "keyframes": [
        "005192.webp",
        "005225.webp",
        "005226.webp",
        "005266.webp",
        "005307.webp",
        "005308.webp",
        "005349.webp",
        "005391.webp",
        "005392.webp",
        "005416.webp",
