        "000299.webp",
        "000300.webp",
        "000323.webp"
      ],
      "keyframe_count": 37
    },
    {
      "text": "- À cô ơi, em được tặng cái khúc hải sâm này nè mà em suy nghĩ hoài, em không biết là làm món ăn gì cho nó ngon bây giờ cô?",
      "start": 12.92,
      "end": 19.52,
      "n_words": 32,
      "start_frame": 323,
      "end_frame": 488,
      "keyframes": [
        "000323.webp",
