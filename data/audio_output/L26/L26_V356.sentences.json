        "001132.webp",
        "001147.webp",
        "001208.webp",
        "001269.webp",
        "001270.webp",
        "001356.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình \"Món ngon mỗi ngày\", chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 56.8,
      "end": 65.44,
      "n_words": 24,
      "start_frame": 1420,
      "end_frame": 1636,
      "keyframes": [
        "001443.webp",
        "001444.webp",
        "001536.webp",
        "001628.webp",
        "001629.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi, và Phương thấy là cô đã chuẩn bị một cái nồi nước rồi ha.",
      "start": 65.44,
      "end": 69.4,
      "n_words": 15,
      "start_frame": 1636,
      "end_frame": 1735,
      "keyframes": [
        "001675.webp",
        "001722.webp",
        "001723.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ cô sẽ cho đây vài lát gừng, một ít rượu trắng.",
      "start": 69.4,
      "end": 73.0,
      "n_words": 13,
      "start_frame": 1735,
      "end_frame": 1825,
      "keyframes": [
        "001752.webp",
        "001781.webp",
        "001782.webp",
        "001802.webp",
        "001823.webp",
        "001824.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Rượu trắng mình làm công đoạn này để khử mùi của hải sâm phải không cô?",
      "start": 73.0,
      "end": 77.6,
      "n_words": 17,
      "start_frame": 1825,
      "end_frame": 1940,
      "keyframes": [
        "001846.webp",
        "001869.webp",
        "001870.webp",
        "001917.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "- Đúng rồi đó Thanh Phương.",
      "start": 77.6,
      "end": 78.64,
      "n_words": 6,
      "start_frame": 1940,
      "end_frame": 1966,
      "keyframes": [
        "001965.webp",
        "001966.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Các bạn cũng lưu ý là chúng ta sẽ chần hải sâm qua nước sôi có rượu và gừng để khử mùi hăng của hải sâm nha.",
      "start": 78.64,
      "end": 85.16,
      "n_words": 27,
      "start_frame": 1966,
      "end_frame": 2129,
      "keyframes": [
        "001966.webp",
        "002047.webp",
        "002128.webp",
        "002129.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi, bây giờ nước sôi rồi đó, cho hải sâm vào đây mình chần, rồi khi nào mà nước nó sôi trở lại thì mình sẽ mới vớt ra.",
      "start": 85.16,
      "end": 92.68,
      "n_words": 29,
      "start_frame": 2129,
      "end_frame": 2317,
      "keyframes": [
        "002129.webp",
        "002147.webp",
        "002165.webp",
        "002166.webp",
        "002189.webp",
        "002212.webp",
        "002213.webp",
        "002267.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "- Dạ.",
      "start": 92.68,
      "end": 93.28,
      "n_words": 2,
      "start_frame": 2317,
      "end_frame": 2332,
      "keyframes": [
        "002322.webp",
        "002323.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Rồi, cô sẽ vớt phần hải sâm này ra thì chúng ta sẽ để nguội nè ha, sau đó thì mình sẽ cắt hải sâm, cắt nó thành khoanh như thế này.",
      "start": 93.28,
      "end": 100.32,
      "n_words": 33,
      "start_frame": 2332,
      "end_frame": 2508,
      "keyframes": [
        "002350.webp",
        "002378.webp",
        "002379.webp",
        "002419.webp",
        "002460.webp",
        "002461.webp",
        "002483.webp",
        "002506.webp",
        "002507.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hải sâm khi mà ăn thưởng thức thì nó giòn giòn và nó sần sật khá là thú vị, và bên cạnh đó là còn tốt cho sức khỏe, được ví giống như là sâm của biển cả vậy đó.",
      "start": 100.32,
      "end": 110.88,
      "n_words": 40,
      "start_frame": 2508,
      "end_frame": 2772,
      "keyframes": [
        "002543.webp",
        "002580.webp",
        "002581.webp",
        "002599.webp",
        "002617.webp",
        "002618.webp",
        "002656.webp",
        "002695.webp",
        "002696.webp",
        "002740.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "- Đúng rồi.",
      "start": 110.88,
      "end": 111.4,
      "n_words": 3,
      "start_frame": 2772,
      "end_frame": 2785,
      "keyframes": [
        "002784.webp",
        "002785.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi, bây giờ thì chúng ta đã cắt hải sâm xong, chúng ta sẽ chuẩn bị phần gia vị để ướp vào hải sâm.",
      "start": 111.4,
      "end": 116.48,
      "n_words": 24,
      "start_frame": 2785,
      "end_frame": 2912,
      "keyframes": [
        "002785.webp",
        "002815.webp",
        "002845.webp",
        "002846.webp",
        "002878.webp",
        "002911.webp",
        "002912.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Mình sẽ có một muỗng canh tương ớt Quảng Nam, cho vô một muỗng cà phê đường, một muỗng cà phê bột ngọt Ajinomoto, một muỗng canh giấm gạo lên men Ajinomoto, một muỗng canh nước tương Fujisawa.",
      "start": 116.48,
      "end": 127.96,
      "n_words": 38,
      "start_frame": 2912,
      "end_frame": 3199,
      "keyframes": [
        "002912.webp",
        "002942.webp",
        "002973.webp",
        "002974.webp",
        "002996.webp",
        "003019.webp",
        "003020.webp",
        "003056.webp",
        "003092.webp",
        "003093.webp",
        "003109.webp",
        "003125.webp",
        "003126.webp",
        "003142.webp",
        "003159.webp",
        "003160.webp",
        "003183.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Rồi sau đó cô sẽ khuấy đều lên, cô đã khuấy tan tất cả các gia vị với nhau.",
      "start": 128.72,
      "end": 134.76,
      "n_words": 19,
      "start_frame": 3218,
      "end_frame": 3369,
      "keyframes": [
        "003230.webp",
        "003252.webp",
        "003253.webp",
        "003274.webp",
        "003295.webp",
        "003296.webp",
        "003332.webp",
        "003368.webp",
        "003369.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "- Tôm sú thì cô đã lột vỏ rồi nè, rồi bỏ đầu nè, bỏ chỉ lưng cùng với lại hải sâm luôn ạ?",
      "start": 134.76,
      "end": 142.12,
      "n_words": 24,
      "start_frame": 3369,
      "end_frame": 3553,
      "keyframes": [
        "003369.webp",
        "003404.webp",
        "003440.webp",
        "003441.webp",
        "003463.webp",
        "003485.webp",
        "003486.webp",
        "003524.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "- Đúng rồi, mình cho cái hỗn hợp gia vị hồi nãy á rồi mình trộn đều lên.",
      "start": 142.12,
      "end": 146.36,
      "n_words": 18,
      "start_frame": 3553,
      "end_frame": 3659,
      "keyframes": [
        "003563.webp",
        "003564.webp",
        "003590.webp",
        "003617.webp",
        "003618.webp",
        "003645.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình chỉ cần để thấm chừng 5 tới 10 phút thôi.",
      "start": 146.36,
      "end": 149.24,
      "n_words": 11,
      "start_frame": 3659,
      "end_frame": 3731,
      "keyframes": [
        "003673.webp",
        "003674.webp",
        "003704.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ sơ chế tiếp đến phần rau củ quả thì gừng cô sẽ cắt dạng hình thoi ha, miếng vừa vừa.",
      "start": 149.24,
      "end": 156.36,
      "n_words": 23,
      "start_frame": 3731,
      "end_frame": 3909,
      "keyframes": [
        "003734.webp",
        "003735.webp",
        "003768.webp",
        "003802.webp",
        "003803.webp",
        "003812.webp",
        "003822.webp",
        "003823.webp",
        "003854.webp",
        "003885.webp",
        "003886.webp",
        "003902.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chọn cái gừng nó non một chút thì khi mình xào mình có thể ăn luôn được.",
      "start": 156.36,
      "end": 159.44,
      "n_words": 17,
      "start_frame": 3909,
      "end_frame": 3986,
      "keyframes": [
        "003919.webp",
        "003920.webp",
        "003942.webp",
        "003965.webp",
        "003966.webp",
        "003978.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Gừng, hành tây thì chúng ta cũng sẽ cắt cao trước, sau đó mình cũng cắt xéo xéo như là những cái dạng hình thoi nho nhỏ vừa vừa vậy đó.",
      "start": 159.44,
      "end": 166.6,
      "n_words": 31,
      "start_frame": 3986,
      "end_frame": 4165,
      "keyframes": [
        "003991.webp",
        "003992.webp",
        "004022.webp",
        "004053.webp",
        "004054.webp",
        "004079.webp",
        "004104.webp",
        "004105.webp",
        "004136.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Tiếp theo thì ớt chuông xanh, ớt chuông vàng thì mình cũng cắt hình thoi luôn nhưng mà mình đừng có cắt nhỏ quá.",
      "start": 166.6,
      "end": 173.68,
      "n_words": 24,
      "start_frame": 4165,
      "end_frame": 4342,
      "keyframes": [
        "004168.webp",
        "004169.webp",
        "004189.webp",
        "004209.webp",
        "004210.webp",
        "004233.webp",
        "004257.webp",
        "004258.webp",
        "004275.webp",
        "004293.webp",
