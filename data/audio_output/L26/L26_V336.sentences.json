        "004700.webp",
        "004726.webp",
        "004753.webp",
        "004754.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Lưỡi heo khìa chín rồi đó, bây giờ á thì cô sẽ vớt nó ra đó rồi mình để nguội bớt đi rồi mình hãy cắt lát.",
      "start": 190.24,
      "end": 198.64,
      "n_words": 27,
      "start_frame": 4756,
      "end_frame": 4966,
      "keyframes": [
        "004817.webp",
