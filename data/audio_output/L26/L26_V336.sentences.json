        "004881.webp",
        "004918.webp",
        "004955.webp",
        "004956.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình cắt mỏng mình sẽ ngon, có thể là chúng ta sẽ thay bằng tay heo bao tử nè, nó cũng na ná nhau mà mình làm theo cách khìa này cũng sẽ rất là ngon đó cô Hà.",
      "start": 198.64,
      "end": 207.76,
      "n_words": 39,
      "start_frame": 4966,
      "end_frame": 5194,
      "keyframes": [
        "004983.webp",
        "005011.webp",
        "005012.webp",
        "005043.webp",
        "005075.webp",
        "005076.webp",
        "005132.webp",
        "005189.webp",
        "005190.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Được đó chứ em?",
      "start": 207.76,
      "end": 208.72,
      "n_words": 4,
      "start_frame": 5194,
      "end_frame": 5218,
      "keyframes": [
        "005200.webp",
        "005211.webp",
        "005212.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ.",
      "start": 208.72,
      "end": 209.36,
      "n_words": 1,
      "start_frame": 5218,
      "end_frame": 5234,
      "keyframes": [
        "005228.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi sau khi cắt lưỡi heo xong mình sẽ trộn cái phần nước gỏi còn lại á, trộn vào trong cái này luôn: ngó sen nè ha, cà rốt và dưa leo, củ kiệu này, lưỡi heo vô, rau húng lủi và rau răm luôn, rồi một ít hành tím phi rồi và một ít mè rang nữa.",
