        "004311.webp",
        "004322.webp",
        "004323.webp",
        "004365.webp",
        "004408.webp",
        "004409.webp"
      ],
      "keyframe_count": 26
    },
    {
      "text": "Ngó sen nè, củ cà rốt và dưa leo chúng ta sẽ cho vào trong tô.",
      "start": 176.48,
      "end": 180.64,
      "n_words": 16,
      "start_frame": 4412,
      "end_frame": 4516,
      "keyframes": [
        "004462.webp",
        "004515.webp",
        "004516.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô sẽ cho vào đây ba muỗng canh nước trộn gỏi.",
      "start": 180.64,
      "end": 183.8,
      "n_words": 11,
      "start_frame": 4516,
      "end_frame": 4595,
      "keyframes": [
        "004516.webp",
        "004541.webp",
        "004566.webp",
        "004567.webp",
        "004588.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ trộn rau củ trước với nước trộn gỏi giúp rau củ thấm gia vị thì món ăn sẽ ngon hơn.",
      "start": 183.8,
      "end": 190.24,
      "n_words": 28,
      "start_frame": 4595,
      "end_frame": 4756,
      "keyframes": [
        "004610.webp",
