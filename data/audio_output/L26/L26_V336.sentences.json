        "003888.webp",
        "003933.webp",
        "003934.webp",
        "003961.webp",
        "003988.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Chẻ đôi dọc của cái củ kiệu này và bây giờ thì chúng ta sẽ pha sốt để mà trộn gỏi.",
      "start": 159.52,
      "end": 166.84,
      "n_words": 21,
      "start_frame": 3988,
      "end_frame": 4171,
      "keyframes": [
        "003988.webp",
        "003989.webp",
        "004013.webp",
        "004038.webp",
        "004039.webp",
        "004061.webp",
        "004084.webp",
        "004085.webp",
        "004109.webp",
        "004134.webp",
        "004135.webp",
        "004153.webp",
        "004171.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Đầu tiên thì chúng ta sẽ cho hai muỗng canh đường, một muỗng cà phê muối, bốn muỗng canh nước cốt chanh, một muỗng cà phê tỏi ớt băm rồi mình chỉ cần khuấy đều lên.",
      "start": 166.84,
      "end": 176.48,
      "n_words": 36,
      "start_frame": 4171,
      "end_frame": 4412,
      "keyframes": [
        "004171.webp",
        "004172.webp",
        "004183.webp",
        "004194.webp",
        "004195.webp",
        "004208.webp",
        "004222.webp",
        "004223.webp",
        "004229.webp",
        "004235.webp",
