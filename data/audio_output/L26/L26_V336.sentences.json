{
  "video_id": "L26_V336",
  "fps": 25.0,
  "n_sentences": 47,
  "total_words": 977,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày. Em chào cô Hà. Chào Kim Thảo!",
      "start": 10.48,
      "end": 14.08,
      "n_words": 11,
      "start_frame": 262,
      "end_frame": 352,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Muốn sang phải bắt đầu, muốn ăn củ kiệu phải kính yêu cô Hà.",
      "start": 14.88,
      "end": 19.44,
      "n_words": 14,
      "start_frame": 372,
      "end_frame": 486,
      "keyframes": [
        "000377.webp",
        "000454.webp",
        "000455.webp",
        "000470.webp",
        "000485.webp",
        "000486.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cô chỉ cần dĩa kiệu này thôi, không biết có kính yêu thật hay không nhưng mà tặng em luôn cái hũ này đó.",
      "start": 19.44,
      "end": 23.96,
      "n_words": 24,
      "start_frame": 486,
      "end_frame": 599,
      "keyframes": [
        "000486.webp",
        "000508.webp",
        "000530.webp",
        "000531.webp",
        "000548.webp",
        "000565.webp",
        "000566.webp",
        "000581.webp",
        "000597.webp",
        "000598.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Em cảm ơn cô Hà.",
      "start": 23.96,
      "end": 24.8,
      "n_words": 5,
      "start_frame": 599,
      "end_frame": 620,
      "keyframes": [
        "000609.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cô Hà đang chuẩn bị củ kiệu thì chắc là hôm nay phải có món gì đó ngon lắm đây.",
      "start": 24.8,
      "end": 28.52,
      "n_words": 20,
      "start_frame": 620,
      "end_frame": 713,
      "keyframes": [
        "000621.webp",
        "000622.webp",
        "000639.webp",
        "000656.webp",
        "000657.webp",
        "000696.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Em trả lại cô Hà nè.",
      "start": 28.52,
      "end": 29.88,
      "n_words": 6,
      "start_frame": 713,
      "end_frame": 747,
      "keyframes": [
        "000736.webp",
        "000737.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chắc chắn luôn, món ăn hôm nay sẽ cực kỳ bắt vị luôn và rất là ngon miệng.",
      "start": 29.88,
      "end": 34.24,
      "n_words": 18,
      "start_frame": 747,
      "end_frame": 856,
      "keyframes": [
        "000769.webp",
        "000802.webp",
        "000803.webp",
        "000826.webp",
        "000850.webp",
        "000851.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Wow!",
      "start": 34.24,
      "end": 35.32,
      "n_words": 1,
      "start_frame": 856,
      "end_frame": 883,
      "keyframes": [
        "000868.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vậy thì bây giờ em sẽ phụ cô Hà làm ngay món này nha: Lưỡi heo trộn kiệu chua xua tan hè nắng, đậm đà đưa cơm.",
      "start": 35.32,
      "end": 61.36,
      "n_words": 27,
      "start_frame": 883,
      "end_frame": 1534,
      "keyframes": [
        "000886.webp",
        "000887.webp",
        "000910.webp",
        "000934.webp",
        "000935.webp",
        "000952.webp",
        "000969.webp",
        "000970.webp",
        "000994.webp",
        "001019.webp",
        "001020.webp",
        "001078.webp",
        "001136.webp",
        "001137.webp",
        "001211.webp",
        "001286.webp",
        "001301.webp",
        "001331.webp",
        "001361.webp",
        "001362.webp",
        "001448.webp"
      ],
      "keyframe_count": 21
    },
    {
      "text": "Mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 61.36,
      "end": 64.24,
      "n_words": 12,
      "start_frame": 1534,
      "end_frame": 1606,
      "keyframes": [
        "001535.webp",
        "001536.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 64.24,
      "end": 68.24,
      "n_words": 11,
      "start_frame": 1606,
      "end_frame": 1706,
      "keyframes": [
        "001623.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ở đây nè, cô có đây là lưỡi heo, sau khi chúng ta mua về mình sẽ trụng qua nước sôi, mình sẽ cạo thật sạch và rửa lại để ráo.",
      "start": 68.24,
      "end": 75.72,
      "n_words": 31,
      "start_frame": 1706,
      "end_frame": 1893,
      "keyframes": [
        "001710.webp",
        "001711.webp",
        "001738.webp",
        "001765.webp",
        "001766.webp",
        "001798.webp",
        "001830.webp",
        "001831.webp",
        "001861.webp",
        "001891.webp",
        "001892.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ trụng lưỡi heo qua nước sôi thì mình sẽ cạo cái màng trắng của lưỡi heo một cách dễ dàng hơn.",
      "start": 75.72,
      "end": 82.28,
      "n_words": 29,
      "start_frame": 1893,
      "end_frame": 2057,
      "keyframes": [
        "001974.webp",
        "002057.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cô đã xẻ dọc làm hai rồi chúng ta sẽ ướp gia vị cho vào: đây là một muỗng canh đường, một muỗng canh hành và tỏi băm, một muỗng cà phê muối, một muỗng canh nước tương Phú Sĩ.",
      "start": 82.28,
      "end": 92.72,
      "n_words": 40,
      "start_frame": 2057,
      "end_frame": 2318,
      "keyframes": [
        "002057.webp",
        "002058.webp",
        "002076.webp",
        "002095.webp",
        "002096.webp",
        "002119.webp",
        "002142.webp",
        "002143.webp",
        "002162.webp",
        "002181.webp",
        "002182.webp",
        "002208.webp",
        "002234.webp",
        "002235.webp",
        "002252.webp",
        "002270.webp",
        "002271.webp",
        "002295.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Nó rất là thơm và nó tạo màu rất là đẹp.",
      "start": 92.72,
      "end": 94.96,
      "n_words": 11,
      "start_frame": 2318,
      "end_frame": 2374,
      "keyframes": [
        "002319.webp",
        "002320.webp",
        "002329.webp",
        "002338.webp",
        "002339.webp",
        "002352.webp",
        "002365.webp",
        "002366.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Để cho cái lưỡi heo này thấm gia vị khoảng chừng 20 phút, cô sẽ cho cái nồi lên trên bếp, mình sẽ cho dầu vào đây, cho sả đập dập.",
      "start": 94.96,
      "end": 101.92,
      "n_words": 31,
      "start_frame": 2374,
      "end_frame": 2548,
      "keyframes": [
        "002389.webp",
        "002413.webp",
        "002414.webp",
        "002434.webp",
        "002454.webp",
        "002455.webp",
        "002470.webp",
        "002485.webp",
        "002486.webp",
        "002505.webp",
        "002524.webp",
        "002525.webp",
        "002540.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Các khúc sả bắt đầu sôi lên rồi đúng không?",
      "start": 101.92,
      "end": 104.12,
      "n_words": 10,
      "start_frame": 2548,
      "end_frame": 2603,
      "keyframes": [
        "002555.webp",
        "002556.webp",
        "002582.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ.",
      "start": 104.12,
      "end": 104.48,
      "n_words": 1,
      "start_frame": 2603,
      "end_frame": 2612,
      "keyframes": [
        "002608.webp",
        "002609.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cô sẽ cho cái phần lưỡi heo vào đây, cái phần nước ướp này nè mình cũng cho vô luôn, chờ cho lưỡi heo săn lại.",
      "start": 104.48,
      "end": 111.68,
      "n_words": 26,
      "start_frame": 2612,
      "end_frame": 2792,
      "keyframes": [
        "002634.webp",
        "002659.webp",
        "002660.webp",
        "002677.webp",
        "002694.webp",
        "002695.webp",
        "002717.webp",
        "002740.webp",
        "002741.webp",
        "002765.webp",
        "002789.webp",
        "002790.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Em bắt đầu ngửi thấy mùi rất là thơm rồi đó. Thấy chưa?",
      "start": 111.68,
      "end": 115.52,
      "n_words": 13,
      "start_frame": 2792,
      "end_frame": 2888,
      "keyframes": [
        "002822.webp",
        "002855.webp",
        "002856.webp",
        "002864.webp",
        "002873.webp",
        "002874.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Dạ.",
      "start": 115.52,
      "end": 116.32,
      "n_words": 1,
      "start_frame": 2888,
      "end_frame": 2908,
      "keyframes": [
        "002907.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cô sẽ trở lại, mình sẽ cho thêm vào đây khoảng chừng một chén nước dừa tươi như thế này, hai muỗng canh giấm gạo lên men Ajinomoto.",
      "start": 116.32,
      "end": 123.2,
      "n_words": 28,
      "start_frame": 2908,
      "end_frame": 3080,
      "keyframes": [
        "002941.webp",
        "002942.webp",
        "002980.webp",
        "003018.webp",
        "003019.webp",
        "003031.webp",
        "003044.webp",
        "003045.webp",
        "003058.webp",
        "003071.webp",
        "003072.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Để làm gì vậy cô Hà?",
      "start": 123.2,
      "end": 124.56,
      "n_words": 6,
      "start_frame": 3080,
      "end_frame": 3114,
      "keyframes": [
        "003086.webp",
        "003100.webp",
        "003101.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "À, các bạn lưu ý là chúng ta dùng giấm gạo lên men Ajinomoto để lưỡi heo giòn hơn, giúp khử tanh và có hương vị hài hòa.",
      "start": 124.56,
      "end": 131.64,
      "n_words": 28,
      "start_frame": 3114,
      "end_frame": 3291,
      "keyframes": [
        "003125.webp",
        "003149.webp",
        "003150.webp",
        "003221.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trong lúc mình chờ cái phần lưỡi heo á thì Kim Thảo sẽ giúp cô món sen này.",
      "start": 131.64,
      "end": 136.32,
      "n_words": 18,
      "start_frame": 3291,
      "end_frame": 3408,
      "keyframes": [
        "003292.webp",
        "003293.webp",
        "003327.webp",
        "003362.webp",
        "003363.webp",
        "003378.webp",
        "003393.webp",
        "003394.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cô đã rửa ngâm nước chanh rồi giờ mình chỉ cần cắt khúc ra thôi ha.",
      "start": 136.32,
      "end": 139.52,
      "n_words": 16,
      "start_frame": 3408,
      "end_frame": 3488,
      "keyframes": [
        "003410.webp",
        "003426.webp",
        "003427.webp",
        "003469.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi còn cô thì sẽ cắt cà rốt.",
      "start": 139.52,
      "end": 141.6,
      "n_words": 8,
      "start_frame": 3488,
      "end_frame": 3540,
      "keyframes": [
        "003511.webp",
        "003512.webp",
        "003530.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cà rốt thì chúng ta sẽ cắt sợi như là đầu đũa vậy đó để mà mình trộn gỏi.",
      "start": 141.6,
      "end": 147.68,
      "n_words": 19,
      "start_frame": 3540,
      "end_frame": 3692,
      "keyframes": [
        "003548.webp",
        "003549.webp",
        "003568.webp",
        "003588.webp",
        "003589.webp",
        "003615.webp",
        "003642.webp",
        "003643.webp",
        "003671.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Còn dưa leo thì chúng ta cũng sẽ cắt khúc 5 phân, sau đó thì mình cũng cắt sợi rồi và mình cũng sẽ bỏ bớt phần ruột đi.",
      "start": 147.68,
      "end": 159.52,
      "n_words": 29,
      "start_frame": 3692,
      "end_frame": 3988,
      "keyframes": [
        "003699.webp",
        "003700.webp",
        "003713.webp",
        "003726.webp",
        "003727.webp",
        "003757.webp",
