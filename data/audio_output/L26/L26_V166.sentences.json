        "006320.webp",
        "006359.webp",
        "006360.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và khi ăn thì Minh Phương nghĩ là chúng ta có nên đặt lên một cái bếp lửa liu riu nhỏ nhỏ để nhúng rau đúng không anh Nghị? Đúng rồi Minh Phương.",
      "start": 254.4,
      "end": 260.8,
      "n_words": 33,
      "start_frame": 6360,
      "end_frame": 6520,
      "keyframes": [
        "006360.webp",
        "006440.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và cuối cùng Quốc Nghị sẽ cho một ít hành phi lên trên.",
      "start": 260.8,
      "end": 264.0,
      "n_words": 13,
      "start_frame": 6520,
      "end_frame": 6600,
      "keyframes": [
        "006521.webp",
        "006522.webp",
        "006562.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và món này Quốc Nghị đề xuất các bạn nên chế biến thêm món tôm nướng muối ớt ăn kèm nữa thì tuyệt vời luôn.",
      "start": 264.0,
      "end": 270.4,
      "n_words": 25,
      "start_frame": 6600,
      "end_frame": 6760,
      "keyframes": [
        "006602.webp",
        "006603.webp",
        "006638.webp",
        "006674.webp",
        "006675.webp",
        "006716.webp",
        "006758.webp",
        "006759.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Không chỉ bổ dưỡng, có thể thích hợp để chúng ta tẩm bổ cho những người thân của mình mà còn là một công thức để quý vị có thể thay đổi làm mới những bữa cơm hằng ngày của gia đình mình đúng không ạ?",
      "start": 270.4,
      "end": 281.8,
      "n_words": 46,
      "start_frame": 6760,
      "end_frame": 7045,
      "keyframes": [
        "006831.webp",
