        "005979.webp",
        "006004.webp",
        "006005.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Bây giờ Quốc Nghị sẽ cho ra một cái nồi dạ.",
      "start": 240.52,
      "end": 245.0,
      "n_words": 11,
      "start_frame": 6013,
      "end_frame": 6125,
      "keyframes": [
        "006042.webp",
        "006080.webp",
        "006081.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, và lại cực kỳ bổ dưỡng nữa các bạn ơi, bởi vì đây là món lẩu cháo mà cho nên là cái phần nước nó sẽ lỏng hơn để chúng ta có thể nhúng các loại rau ăn kèm.",
      "start": 245.0,
      "end": 254.4,
      "n_words": 41,
      "start_frame": 6125,
      "end_frame": 6360,
      "keyframes": [
        "006139.webp",
