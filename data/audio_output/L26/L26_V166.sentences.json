        "005669.webp",
        "005716.webp",
        "005717.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Ngon luôn!",
      "start": 229.08,
      "end": 229.92,
      "n_words": 2,
      "start_frame": 5727,
      "end_frame": 5748,
      "keyframes": [
        "005747.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và đừng quên công thức của món ăn này đã sẵn sàng được hiển thị trên mã QR, các bạn hãy quét và lưu về ngay công thức món lẩu cháo này các bạn nha.",
      "start": 229.92,
      "end": 240.52,
      "n_words": 35,
      "start_frame": 5748,
      "end_frame": 6013,
      "keyframes": [
        "005777.webp",
