        "002458.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ thì Kim Thảo sẽ giúp cô mình giã nhuyễn hỗn hợp này.",
      "start": 99.44,
      "end": 102.88,
      "n_words": 14,
