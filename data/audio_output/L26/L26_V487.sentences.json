        "003868.webp",
        "003899.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cắt củ cà rốt thành những cái que rồi cô sẽ cho vào trong tô luôn.",
      "start": 155.96,
      "end": 160.76,
