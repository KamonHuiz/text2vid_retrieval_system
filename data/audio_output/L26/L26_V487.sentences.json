      "end": 36.52,
      "n_words": 10,
      "start_frame": 852,
      "end_frame": 913,
      "keyframes": [
        "000912.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Rồi, như vậy thì hôm nay cô sẽ giới thiệu cho em cỏ xạ hương nè.",
