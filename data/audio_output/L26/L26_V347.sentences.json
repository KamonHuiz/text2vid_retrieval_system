      "end": 30.24,
      "n_words": 5,
      "start_frame": 734,
      "end_frame": 756,
      "keyframes": [
        "000754.webp",
        "000755.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Em thấy có lá rong biển, có tàu hủ ký, chắc sẽ liên quan đến món cuốn đúng không nào? Chính xác!",
      "start": 30.24,
