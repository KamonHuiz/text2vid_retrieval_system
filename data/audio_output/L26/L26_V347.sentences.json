        "002845.webp",
        "002862.webp",
        "002863.webp",
        "002885.webp",
        "002908.webp",
        "002909.webp",
        "002939.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Gia vị nêm rất là đơn giản.",
      "start": 118.52,
      "end": 119.96,
      "n_words": 7,
      "start_frame": 2963,
      "end_frame": 2999,
      "keyframes": [
        "002970.webp",
        "002971.webp",
        "002992.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ đúng rồi.",
      "start": 119.96,
      "end": 121.36,
      "n_words": 3,
      "start_frame": 2999,
      "end_frame": 3034,
      "keyframes": [
        "003014.webp",
        "003015.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Tất cả mình sẽ trộn đều lên đi.",
      "start": 121.36,
      "end": 122.92,
      "n_words": 8,
      "start_frame": 3034,
      "end_frame": 3073,
      "keyframes": [
        "003043.webp",
        "003071.webp",
        "003072.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi, phần nhân mình đã trộn xong rồi.",
      "start": 122.92,
      "end": 124.72,
      "n_words": 8,
      "start_frame": 3073,
      "end_frame": 3118,
      "keyframes": [
        "003107.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ giúp anh bỏ vào tủ lạnh.",
      "start": 124.72,
      "end": 126.6,
      "n_words": 8,
      "start_frame": 3118,
      "end_frame": 3165,
      "keyframes": [
        "003142.webp",
        "003143.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Dạ ủa nhưng mà sao mình không cuốn luôn đi anh Tưởng, mình bỏ vào tủ lạnh làm gì?",
      "start": 126.6,
      "end": 131.44,
      "n_words": 19,
      "start_frame": 3165,
      "end_frame": 3286,
      "keyframes": [
        "003212.webp",
        "003281.webp",
        "003282.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì khi mình bỏ phần nhân vào tủ lạnh, nó giúp cho cái phần nhân mình nó dẻo và tạo hình nó dễ dàng hơn.",
      "start": 131.44,
      "end": 137.04,
      "n_words": 25,
      "start_frame": 3286,
      "end_frame": 3426,
      "keyframes": [
        "003346.webp",
        "003411.webp",
        "003412.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Em hiểu rồi.",
      "start": 137.04,
      "end": 138.16,
      "n_words": 3,
      "start_frame": 3426,
      "end_frame": 3454,
      "keyframes": [
        "003432.webp",
        "003453.webp",
        "003454.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ cái phần quan trọng nữa là gì?",
      "start": 138.16,
      "end": 139.72,
      "n_words": 9,
      "start_frame": 3454,
      "end_frame": 3493,
      "keyframes": [
        "003454.webp",
        "003474.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mình sẽ đi cuốn cầu kỳ cùng với lại cái nhân.",
      "start": 139.72,
      "end": 142.16,
      "n_words": 11,
      "start_frame": 3493,
      "end_frame": 3554,
      "keyframes": [
        "003494.webp",
        "003495.webp",
        "003522.webp",
        "003550.webp",
        "003551.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dạ anh sẽ chia làm bốn, có bốn cái cuốn chay đúng không anh? Đúng rồi em.",
      "start": 142.16,
      "end": 146.08,
      "n_words": 17,
      "start_frame": 3554,
      "end_frame": 3652,
      "keyframes": [
        "003568.webp",
        "003585.webp",
        "003586.webp",
        "003623.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Dạ rồi cho nó đều phần nhân nó đều ra của em nè dạ.",
      "start": 146.08,
      "end": 150.0,
      "n_words": 14,
      "start_frame": 3652,
      "end_frame": 3750,
      "keyframes": [
        "003661.webp",
        "003662.webp",
        "003689.webp",
        "003716.webp",
        "003717.webp",
        "003739.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi và chúng ta thấm nước thì cái phần tàu hủ ky nó mềm.",
