        "001079.webp",
        "001103.webp",
        "001128.webp",
        "001129.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cuốn chả chay, món ngon cho ngày rằm. Chào các bạn khán giả đang xem chương trình Món ngon mỗi ngày.",
      "start": 45.24,
      "end": 66.72,
      "n_words": 21,
      "start_frame": 1131,
      "end_frame": 1668,
      "keyframes": [
        "001164.webp",
        "001200.webp",
        "001201.webp",
        "001256.webp",
        "001312.webp",
        "001327.webp",
        "001376.webp",
        "001425.webp",
        "001426.webp",
        "001512.webp",
        "001599.webp",
        "001600.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 66.72,
      "end": 70.72,
      "n_words": 11,
      "start_frame": 1668,
      "end_frame": 1768,
      "keyframes": [
        "001685.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Miếng tàu hũ ký này thì sẽ chọn những cái là gọi là dẻo và không bị rách.",
      "start": 70.72,
      "end": 75.12,
      "n_words": 18,
      "start_frame": 1768,
      "end_frame": 1878,
      "keyframes": [
        "001770.webp",
        "001771.webp",
        "001788.webp",
        "001806.webp",
        "001807.webp",
        "001831.webp",
        "001856.webp",
        "001857.webp",
        "001867.webp",
        "001877.webp",
        "001878.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đây là đậu hũ, mình sẽ luộc qua nước sôi, phơi ráo, tán nhuyễn.",
      "start": 75.12,
      "end": 79.08,
      "n_words": 14,
      "start_frame": 1878,
      "end_frame": 1977,
      "keyframes": [
        "001878.webp",
        "001903.webp",
        "001928.webp",
        "001929.webp",
        "001958.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đó, giò sống chay, giò sống chay em đi mua mà.",
      "start": 79.08,
      "end": 82.36,
      "n_words": 11,
      "start_frame": 1977,
      "end_frame": 2059,
      "keyframes": [
        "001987.webp",
        "001988.webp",
        "002008.webp",
        "002029.webp",
        "002030.webp",
        "002042.webp",
        "002055.webp",
        "002056.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Ồ, cà rốt mình cắt que, mình sẽ luộc qua nước sôi.",
      "start": 82.36,
      "end": 86.0,
      "n_words": 12,
      "start_frame": 2059,
      "end_frame": 2150,
      "keyframes": [
        "002070.webp",
        "002084.webp",
        "002085.webp",
        "002118.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tiêu xanh mình sẽ đập dập.",
      "start": 86.16,
      "end": 87.44,
      "n_words": 6,
      "start_frame": 2154,
      "end_frame": 2186,
      "keyframes": [
        "002170.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ngò rí, xắt nhuyễn, hành baro phi thơm lên đi.",
      "start": 87.44,
      "end": 90.8,
      "n_words": 10,
      "start_frame": 2186,
      "end_frame": 2270,
      "keyframes": [
        "002187.webp",
        "002188.webp",
        "002192.webp",
        "002196.webp",
        "002197.webp",
        "002233.webp",
        "002269.webp",
        "002270.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Phần còn lại bây giờ mình sẽ đi làm cái phần nhân giò sống nè.",
      "start": 90.8,
      "end": 94.48,
