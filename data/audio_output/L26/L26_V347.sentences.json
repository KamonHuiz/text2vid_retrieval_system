      "start_frame": 4387,
      "end_frame": 4404,
      "keyframes": [
        "004398.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cho phần cà rốt vào, dạ cuốn đó là đúng không?",
      "start": 176.16,
      "end": 180.04,
      "n_words": 11,
      "start_frame": 4404,
      "end_frame": 4501,
      "keyframes": [
        "004418.webp",
        "004419.webp",
        "004438.webp",
        "004457.webp",
        "004458.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đúng rồi, cho nó chặt cái tay chút xíu nha.",
      "start": 180.04,
      "end": 183.52,
      "n_words": 10,
      "start_frame": 4501,
      "end_frame": 4588,
      "keyframes": [
        "004505.webp",
        "004553.webp",
        "004554.webp",
        "004571.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bật cái nồi hấp lên cho nó sôi lên ha dạ.",
      "start": 183.52,
