      "end": 154.0,
      "n_words": 14,
      "start_frame": 3750,
      "end_frame": 3850,
      "keyframes": [
        "003762.webp",
        "003763.webp",
        "003803.webp",
        "003844.webp",
        "003845.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi bây giờ anh sẽ lấy này ra nè, cho phần nhân vào đây, như vậy là cái phần nhân chúng ta sẽ dàn đều miếng tàu hủ ky.",
      "start": 154.0,
      "end": 163.04,
      "n_words": 29,
      "start_frame": 3850,
      "end_frame": 4076,
      "keyframes": [
        "003869.webp",
        "003894.webp",
        "003895.webp",
        "003928.webp",
        "003962.webp",
        "003963.webp",
        "003987.webp",
        "004012.webp",
        "004013.webp",
        "004050.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Đúng rồi em.",
      "start": 163.04,
      "end": 163.68,
      "n_words": 3,
      "start_frame": 4076,
      "end_frame": 4092,
      "keyframes": [
        "004087.webp",
        "004088.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "À Minh Phương mà muốn cái cà rốt này nó nằm chính giữa, Minh Phương đặt cây cà rốt mình ở đây nè, tiếp tục Minh Phương gấp lại như thế này nè.",
      "start": 163.68,
      "end": 170.0,
      "n_words": 33,
      "start_frame": 4092,
      "end_frame": 4250,
      "keyframes": [
        "004101.webp",
        "004114.webp",
        "004115.webp",
        "004155.webp",
        "004195.webp",
        "004196.webp",
        "004224.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Phần mép này mình sẽ để phía dưới đi, khi hấp mình hấp nó xong không bị bung cho cái phần nhân vào.",
      "start": 170.0,
      "end": 175.48,
      "n_words": 23,
      "start_frame": 4250,
      "end_frame": 4387,
      "keyframes": [
        "004253.webp",
        "004254.webp",
