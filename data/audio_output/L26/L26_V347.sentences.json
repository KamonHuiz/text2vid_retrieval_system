      "end_frame": 2362,
      "keyframes": [
        "002270.webp",
        "002296.webp",
        "002323.webp",
        "002324.webp",
        "002353.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cho vào đây, đậu hũ nè, cho vào đây, tiêu xanh nè, hành baro phi cho thơm thơm.",
      "start": 94.48,
      "end": 101.44,
      "n_words": 18,
      "start_frame": 2362,
      "end_frame": 2536,
      "keyframes": [
        "002382.webp",
        "002383.webp",
        "002406.webp",
        "002429.webp",
        "002430.webp",
        "002453.webp",
        "002476.webp",
        "002477.webp",
        "002498.webp",
        "002520.webp",
        "002521.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Mùi gì?",
      "start": 101.6,
      "end": 102.0,
      "n_words": 2,
      "start_frame": 2540,
      "end_frame": 2550,
      "keyframes": [
        "002542.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mùi ngò rí và lại có cái màu xanh rất là hài hòa nữa. Đúng rồi em.",
      "start": 102.0,
      "end": 105.6,
      "n_words": 17,
      "start_frame": 2550,
      "end_frame": 2640,
      "keyframes": [
        "002564.webp",
        "002565.webp",
        "002605.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ, tiếp theo nữa mình sẽ đem vào gia vị trong cái phần nhân của mình: nửa muỗng cà phê bột ngọt Ajinomoto, tiếp theo nữa là nửa muỗng canh hạt nêm Aji-ngon, nửa muỗng cà phê đường, cho một muỗng cà phê vào.",
      "start": 105.6,
      "end": 118.2,
      "n_words": 44,
      "start_frame": 2640,
      "end_frame": 2955,
      "keyframes": [
        "002646.webp",
        "002647.webp",
        "002681.webp",
