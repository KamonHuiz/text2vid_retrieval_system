      "n_words": 11,
      "start_frame": 4588,
      "end_frame": 4673,
      "keyframes": [
        "004589.webp",
        "004590.webp",
        "004628.webp",
        "004667.webp",
        "004668.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi tiếp tục công việc của mình, hoàn thành xuất sắc.",
