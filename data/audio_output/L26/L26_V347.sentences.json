        "001025.webp",
        "001041.webp",
        "001042.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Suốt ngày dọa em hoài.",
      "start": 42.04,
      "end": 45.24,
      "n_words": 5,
      "start_frame": 1051,
      "end_frame": 1131,
      "keyframes": [
