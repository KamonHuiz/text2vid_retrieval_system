      "end": 14.04,
      "n_words": 5,
      "start_frame": 306,
      "end_frame": 351,
      "keyframes": [
        "000328.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Phương em đã hoàn thành xuất sắc nhiệm vụ anh giao rồi, anh kiểm tra xem đủ chưa.",
      "start": 14.04,
      "end": 19.36,
