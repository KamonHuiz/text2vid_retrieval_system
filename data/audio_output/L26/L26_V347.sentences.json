        "000812.webp",
        "000846.webp",
        "000880.webp",
        "000881.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ mới 10 điểm nè, nhưng mà cộng thêm 90 điểm mới được 100 đó nha.",
      "start": 36.0,
      "end": 39.8,
      "n_words": 17,
      "start_frame": 900,
      "end_frame": 995,
      "keyframes": [
        "000904.webp",
