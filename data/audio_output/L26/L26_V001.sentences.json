        "001647.webp",
        "001648.webp",
        "001758.webp",
        "001868.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đùi ếch cho vào trong tô và mình ướp gia vị, chỉ cần ướp vào đây một muỗng canh nước hành tỏi băm cùng với nửa muỗng cà phê tiêu xay.",
      "start": 74.72,
      "end": 82.76,
      "n_words": 31,
      "start_frame": 1868,
      "end_frame": 2069,
      "keyframes": [
