      "end": 157.12,
      "n_words": 11,
      "start_frame": 3880,
      "end_frame": 3928,
      "keyframes": [
        "003921.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Chừng hai tới ba phút thôi.",
