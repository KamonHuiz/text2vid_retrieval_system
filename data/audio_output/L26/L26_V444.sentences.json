        "002224.webp",
        "002257.webp",
        "002258.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Như vậy thì sò lông mới tái mới có giữ vị ngọt bên trong mới hấp dẫn.",
      "start": 90.32,
