        "002310.webp",
        "002362.webp",
        "002363.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Vừa chín như vậy anh sẽ đem đi anh xả qua nước lạnh, xả nước lạnh.",
      "start": 94.56,
      "end": 98.52,
