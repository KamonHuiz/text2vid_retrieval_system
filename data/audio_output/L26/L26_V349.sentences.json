        "002757.webp",
        "002758.webp",
        "002820.webp",
        "002882.webp",
        "002883.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta ngắt cây cho các bé thì chúng ta khỏi cho vào.",
      "start": 115.6,
      "end": 118.56,
      "n_words": 13,
      "start_frame": 2890,
      "end_frame": 2964,
      "keyframes": [
        "002924.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bắt đem một cái chảo để chúng ta làm sốt, được gọi là linh hồn của món ăn.",
      "start": 118.56,
      "end": 123.2,
      "n_words": 18,
      "start_frame": 2964,
      "end_frame": 3080,
      "keyframes": [
        "002965.webp",
