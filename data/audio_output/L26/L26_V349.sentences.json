        "004031.webp",
        "004044.webp",
        "004058.webp",
        "004059.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Xong bây giờ chúng ta sẽ chiên cái gà cho được giòn.",
      "start": 162.64,
      "end": 166.4,
      "n_words": 12,
      "start_frame": 4066,
      "end_frame": 4160,
      "keyframes": [
        "004075.webp",
