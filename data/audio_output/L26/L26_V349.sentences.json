        "000964.webp",
        "000984.webp",
        "000985.webp",
        "001006.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "\"Cái món cánh gà là các bạn nhỏ rất là thích.",
      "start": 41.04,
      "end": 43.68,
      "n_words": 11,
      "start_frame": 1026,
      "end_frame": 1092,
      "keyframes": [
        "001028.webp",
