        "001621.webp",
        "001622.webp",
        "001708.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Mến chào các bạn khán giả đang xem chương trình Món ngon mỗi ngày.",
      "start": 71.6,
      "end": 74.88,
      "n_words": 14,
      "start_frame": 1790,
      "end_frame": 1872,
      "keyframes": [
        "001795.webp",
        "001796.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 74.88,
      "end": 79.2,
      "n_words": 11,
      "start_frame": 1872,
      "end_frame": 1980,
      "keyframes": [
        "001922.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và thưa các bạn, với bốn cái cánh gà thì đầu tiên chúng ta cắt ra thành từng miếng kích cỡ khoảng 3 centimet.",
      "start": 79.2,
      "end": 85.56,
      "n_words": 24,
      "start_frame": 1980,
      "end_frame": 2139,
      "keyframes": [
        "002048.webp",
        "002049.webp",
        "002098.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Như vậy chúng ta cho vào đây khoảng một muỗng canh nước tỏi.",
      "start": 85.56,
      "end": 89.04,
      "n_words": 13,
      "start_frame": 2139,
      "end_frame": 2226,
      "keyframes": [
        "002148.webp",
        "002149.webp",
        "002186.webp",
        "002223.webp",
        "002224.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thường ăn gà rán thì các bé rất là thích uống với lại nước ngọt đúng không?",
      "start": 89.04,
      "end": 93.08,
      "n_words": 17,
      "start_frame": 2226,
      "end_frame": 2327,
      "keyframes": [
        "002274.webp",
        "002325.webp",
        "002326.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hôm nay anh dùng cái mùi nước ngọt xá xị, anh ướp vào đây khoảng chừng hai muỗng canh nước xá xị nha.",
      "start": 93.08,
      "end": 99.44,
      "n_words": 23,
      "start_frame": 2327,
      "end_frame": 2486,
      "keyframes": [
        "002357.webp",
        "002389.webp",
        "002390.webp",
        "002422.webp",
        "002455.webp",
        "002456.webp",
        "002485.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Hay quá đó!",
      "start": 99.44,
      "end": 100.6,
      "n_words": 3,
      "start_frame": 2486,
      "end_frame": 2515,
      "keyframes": [
        "002514.webp",
        "002515.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Một muỗng cà phê hạt nêm Ajinomoto ngon gà, chúng ta trộn đều ướp khoảng 15 phút.",
      "start": 100.6,
      "end": 106.36,
      "n_words": 17,
      "start_frame": 2515,
      "end_frame": 2659,
      "keyframes": [
