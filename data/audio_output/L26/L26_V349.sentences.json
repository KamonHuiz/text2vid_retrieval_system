        "002996.webp",
        "003026.webp",
        "003027.webp",
        "003061.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng vậy, cho tỏi vào khoảng một muỗng canh rồi một muỗng cà phê gừng băm, cho ớt khô vào xào để mùi thơm lên.",
      "start": 123.2,
      "end": 131.12,
      "n_words": 25,
      "start_frame": 3080,
      "end_frame": 3278,
      "keyframes": [
        "003095.webp",
