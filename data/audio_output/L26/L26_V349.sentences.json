      "end_frame": 314,
      "keyframes": [
        "000300.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ngày hôm nay gặp anh Vũ.",
      "start": 12.56,
      "end": 13.68,
      "n_words": 6,
      "start_frame": 314,
      "end_frame": 342,
      "keyframes": [
        "000322.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "\"Em có khó khăn này em không biết chia sẻ cùng ai, chỉ có chia sẻ cùng anh thôi.",
      "start": 13.68,
      "end": 17.68,
      "n_words": 19,
      "start_frame": 342,
      "end_frame": 442,
      "keyframes": [
        "000345.webp",
