        "001055.webp",
        "001082.webp",
        "001083.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Giờ thì anh sẽ chia sẻ cho em một cái món ăn quen nhưng mà lạ.",
      "start": 43.68,
      "end": 47.8,
      "n_words": 16,
      "start_frame": 1092,
      "end_frame": 1195,
      "keyframes": [
        "001121.webp",
        "001160.webp",
        "001161.webp",
        "001185.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ mời các bạn cùng theo dõi thực hiện món ăn ngày hôm nay nhé: Gà chiên xá xị giòn tan mang vị mới.\"",
      "start": 47.8,
      "end": 71.6,
      "n_words": 25,
      "start_frame": 1195,
      "end_frame": 1790,
      "keyframes": [
        "001210.webp",
