        "000388.webp",
        "000430.webp",
        "000431.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Vũ ơi, cánh gà sao không biết làm gì hết trơn?\"",
      "start": 17.68,
      "end": 20.36,
      "n_words": 11,
      "start_frame": 442,
      "end_frame": 509,
      "keyframes": [
        "000450.webp",
        "000469.webp",
        "000470.webp",
        "000492.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "\"Á hả?",
      "start": 20.36,
      "end": 20.92,
      "n_words": 2,
      "start_frame": 509,
      "end_frame": 523,
      "keyframes": [
        "000515.webp",
        "000516.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Không, em biết là mình sẽ làm cái gì nhưng em không biết mình phải làm thế nào thôi.",
      "start": 20.92,
      "end": 25.88,
      "n_words": 19,
      "start_frame": 523,
      "end_frame": 647,
      "keyframes": [
        "000571.webp",
        "000627.webp",
        "000628.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cuối cùng là em muốn cái gì?",
      "start": 25.88,
      "end": 28.2,
      "n_words": 7,
      "start_frame": 647,
      "end_frame": 705,
      "keyframes": [
        "000666.webp",
        "000705.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ý của em là cánh gà thì em làm nhiều món lắm rồi, em chiên xù, chiên giòn, chiên nước mắm nhiều món lắm cho mấy bạn nhỏ nhà em ăn, nhưng mà bây giờ em đang suy nghĩ ra món gì đó độc đáo, lạ miệng thì anh Vũ có cái gợi ý nào không?\"",
      "start": 28.2,
      "end": 41.04,
      "n_words": 56,
      "start_frame": 705,
      "end_frame": 1026,
      "keyframes": [
        "000705.webp",
        "000706.webp",
        "000742.webp",
        "000778.webp",
        "000779.webp",
