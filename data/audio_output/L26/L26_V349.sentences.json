        "003217.webp",
        "003226.webp",
        "003227.webp",
        "003252.webp",
        "003277.webp",
        "003278.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Cho vào đây khoảng tám muỗng canh nước ngọt xá xị nha, cho tiếp ở đây một muỗng canh tương gà, một muỗng canh tương ớt Hàn Quốc, cho vào đây một muỗng canh nước tương phú sĩ, nửa muỗng cà phê hạt nêm Ajinomoto ngon gà.",
      "start": 131.12,
      "end": 146.32,
      "n_words": 47,
      "start_frame": 3278,
      "end_frame": 3658,
      "keyframes": [
        "003278.webp",
