        "004567.webp",
        "004589.webp"
      ],
      "keyframe_count": 22
    },
    {
      "text": "Rồi bây giờ chúng ta tẩm bột ướt luôn nha các bạn, đó thả vô từng miếng từng miếng như vậy.",
      "start": 184.6,
      "end": 192.2,
      "n_words": 21,
      "start_frame": 4615,
      "end_frame": 4805,
      "keyframes": [
        "004628.webp",
