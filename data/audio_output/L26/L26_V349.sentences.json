        "002627.webp",
        "002657.webp",
        "002658.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Thì hành lá cắt xéo cũng khoảng 2 centimet thôi ha, rồi ớt khô khoảng năm quả thôi, ngâm mềm ra chúng ta cũng cắt xéo thôi.",
      "start": 106.36,
      "end": 115.6,
      "n_words": 27,
      "start_frame": 2659,
      "end_frame": 2890,
      "keyframes": [
        "002683.webp",
        "002708.webp",
        "002709.webp",
