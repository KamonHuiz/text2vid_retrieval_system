        "003749.webp",
        "003809.webp",
        "003810.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi xong, tắt lửa rất là nhanh các bạn.",
      "start": 152.52,
      "end": 154.88,
      "n_words": 9,
      "start_frame": 3813,
      "end_frame": 3872,
      "keyframes": [
        "003841.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Thưa các bạn, chúng ta chỉ cần kết hợp tương ớt Hàn Quốc với lại nước ngọt xá xị để tạo vị cay ngọt mới lạ cho món ăn chút là chén.",
      "start": 154.88,
      "end": 162.64,
      "n_words": 32,
      "start_frame": 3872,
      "end_frame": 4066,
      "keyframes": [
        "003873.webp",
