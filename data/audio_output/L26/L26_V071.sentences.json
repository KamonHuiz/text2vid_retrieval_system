        "001612.webp",
        "001613.webp",
        "001653.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Dạ thưa các bạn, món ngày hôm nay chúng ta thực hiện đó là món xà lách táo và hạt óc chó.",
      "start": 67.44,
