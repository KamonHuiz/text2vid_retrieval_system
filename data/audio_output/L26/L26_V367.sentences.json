        "003772.webp",
        "003773.webp",
        "003795.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Mình sẽ đặt một cái chảo dầu lên trên bếp rồi mở lửa giúp cô ha.",
      "start": 152.64,
      "end": 156.12,
      "n_words": 16,
      "start_frame": 3816,
