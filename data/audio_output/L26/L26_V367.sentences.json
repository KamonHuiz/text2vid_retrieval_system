        "003556.webp",
        "003557.webp",
        "003578.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Dạ, rồi cô sẽ gắp phần sườn ra tô.",
      "start": 143.16,
      "end": 145.56,
      "n_words": 9,
      "start_frame": 3579,
      "end_frame": 3639,
      "keyframes": [
        "003599.webp",
        "003600.webp",
        "003622.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Em sẽ trộn đều khoảng chừng hai muỗng canh bột mì với lại cái phần sả đó, rồi bây giờ thì chúng ta sẽ tiến hành chiên sả.",
      "start": 145.56,
      "end": 152.64,
