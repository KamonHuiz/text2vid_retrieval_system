        "000847.webp",
        "000848.webp",
        "000871.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sườn non xào chanh sả, lạ mà ngon, ăn là thích.",
      "start": 38.64,
      "end": 56.64,
      "n_words": 11,
      "start_frame": 966,
      "end_frame": 1416,
      "keyframes": [
