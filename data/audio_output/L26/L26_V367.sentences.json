        "001922.webp",
        "001958.webp",
        "001959.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Dạ, với món ăn này em sẽ thấy là cô sẽ chọn cái phần sườn non, chặt miếng vừa ăn.",
      "start": 79.08,
      "end": 85.48,
      "n_words": 20,
