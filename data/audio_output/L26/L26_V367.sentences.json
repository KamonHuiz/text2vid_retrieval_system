        "004494.webp",
        "004495.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Mình vớt ra nè, mình rũ ra không có còn ngấm dầu nữa rồi cô sẽ bỏ qua đây.",
      "start": 180.2,
      "end": 185.16,
      "n_words": 19,
      "start_frame": 4505,
      "end_frame": 4629,
      "keyframes": [
