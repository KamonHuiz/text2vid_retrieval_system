        "000801.webp",
        "000824.webp",
        "000847.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Cô Hà ơi, uống nhanh mình vô bếp qua.",
      "start": 33.88,
      "end": 35.64,
      "n_words": 9,
      "start_frame": 847,
