        "001246.webp",
        "001247.webp",
        "001333.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 56.64,
      "end": 59.64,
      "n_words": 13,
      "start_frame": 1416,
      "end_frame": 1491,
      "keyframes": [
        "001420.webp",
        "001421.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình mỗi ngày được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 59.64,
      "end": 63.52,
      "n_words": 13,
      "start_frame": 1491,
      "end_frame": 1588,
      "keyframes": [
        "001507.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên thì cô sẽ sơ chế cái phần lá chúc này, chúng ta sẽ chừa lại khoảng chừng 2-3 lá để chút nữa mình chiên rồi mình trình bày lên cho đẹp ha, rồi phần còn lại thì chúng ta sẽ cắt nhỏ, mình lấy khoảng chừng hai muỗng cà phê phần lá chúc băm.",
      "start": 63.52,
      "end": 79.08,
      "n_words": 56,
      "start_frame": 1588,
      "end_frame": 1977,
      "keyframes": [
