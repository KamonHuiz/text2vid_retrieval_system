        "005181.webp",
        "005230.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cô đặt chảo lên và em mở lửa giúp cô nha, Kim Thảo.",
      "start": 211.16,
      "end": 213.76,
      "n_words": 13,
