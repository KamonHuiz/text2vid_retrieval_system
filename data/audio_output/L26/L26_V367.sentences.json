        "005732.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô sẽ cho phần sườn vào đây mình xào đều, mình sẽ cảm nhận là rất là thơm.",
      "start": 229.32,
      "end": 237.48,
