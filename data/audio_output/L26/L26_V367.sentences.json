      "end_frame": 4244,
      "keyframes": [
        "004073.webp",
        "004129.webp",
        "004130.webp",
        "004185.webp",
        "004241.webp",
        "004242.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ chiên giòn sả non để kèm với món ăn thì khi ăn món ăn sẽ ngon hơn.",
      "start": 169.76,
      "end": 174.72,
      "n_words": 20,
      "start_frame": 4244,
      "end_frame": 4368,
      "keyframes": [
        "004304.webp",
        "004367.webp",
        "004368.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình sẽ ướp cái phần sườn mà mình đã ôm này nè với khoảng chừng ba muỗng canh bột mì.",
      "start": 174.72,
