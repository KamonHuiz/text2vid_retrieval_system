      "start_frame": 333,
      "end_frame": 369,
      "keyframes": [
        "000348.webp",
        "000349.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chuẩn bị làm món gì đây, món gì đây?",
      "start": 14.76,
      "end": 17.08,
      "n_words": 9,
      "start_frame": 369,
