      "start_frame": 1701,
      "end_frame": 1731,
      "keyframes": [
        "001729.webp",
        "001730.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thì vậy hơn tí xíu cũng được tại vì mình nấu canh mà, ok.",
      "start": 69.24,
      "end": 72.88,
      "n_words": 14,
