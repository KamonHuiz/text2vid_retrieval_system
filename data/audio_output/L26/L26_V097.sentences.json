      "end": 59.12,
      "n_words": 10,
      "start_frame": 1418,
      "end_frame": 1478,
      "keyframes": [
        "001453.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Khoai mài vậy thì với món này đầu tiên mình sẽ làm gì đây?",
