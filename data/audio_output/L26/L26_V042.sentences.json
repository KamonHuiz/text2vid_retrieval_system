      "n_words": 38,
      "start_frame": 1243,
      "end_frame": 1476,
      "keyframes": [
        "001313.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Thật là trùng hợp luôn, ngày hôm nay Phước Hưng cũng đang dự định sẽ làm cái món đó, chính là cá bống trứng kho tiêu.",
      "start": 60.52,
      "end": 66.32,
      "n_words": 26,
      "start_frame": 1513,
      "end_frame": 1658,
      "keyframes": [
        "001552.webp",
        "001592.webp",
        "001593.webp",
        "001625.webp",
        "001658.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và cũng như theo lời của chuyên gia dinh dưỡng Tiến sĩ Đào Thị Yến Phi thì món ăn ngày hôm nay sẽ giúp hỗ trợ giảm một lượng mỡ thừa rất tốt cho cơ thể.",
      "start": 66.32,
      "end": 74.28,
      "n_words": 36,
      "start_frame": 1658,
      "end_frame": 1857,
      "keyframes": [
        "001658.webp",
        "001659.webp",
        "001758.webp",
        "001857.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đầu tiên cho món ăn này thì Phước Hưng sẽ hướng dẫn cho các bạn sơ chế cái phần hành lá.",
      "start": 74.28,
      "end": 78.16,
      "n_words": 21,
      "start_frame": 1857,
      "end_frame": 1954,
      "keyframes": [
        "001857.webp",
        "001858.webp",
        "001906.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phần đầu hành trắng thì Phước Hưng sẽ đập dập, cắt nhuyễn; Còn phần hành lá thì Phước Hưng sẽ cắt nhỏ; Còn phần ớt sừng thì Phước Hưng sẽ cắt lát, còn ớt hiểm thì Phước Hưng sẽ đập dập.",
