      "start_frame": 4884,
      "end_frame": 4943,
      "keyframes": [
        "004911.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hương thơm của món ăn bắt đầu dậy rồi, rất là thơm rồi.",
      "start": 197.72,
      "end": 201.6,
      "n_words": 13,
      "start_frame": 4943,
      "end_frame": 5040,
      "keyframes": [
        "004944.webp",
