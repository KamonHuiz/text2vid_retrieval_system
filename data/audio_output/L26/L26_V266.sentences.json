        "003978.webp",
        "003979.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Còn dư lại phần này mình sẽ cho vào trong bụng cá.",
      "start": 159.24,
      "end": 161.96,
      "n_words": 12,
      "start_frame": 3981,
      "end_frame": 4049,
      "keyframes": [
        "004012.webp",
        "004045.webp",
        "004046.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình nấu lên á thì cái bụng cá nó thường nó sẽ không bị bể.",
