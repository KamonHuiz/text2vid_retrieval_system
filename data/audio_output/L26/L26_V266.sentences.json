      "end": 68.24,
      "n_words": 7,
      "start_frame": 1649,
      "end_frame": 1706,
      "keyframes": [
        "001706.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em rất là sẵn sàng.",
