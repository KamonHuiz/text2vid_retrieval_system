        "001311.webp",
        "001312.webp",
        "001398.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 59.2,
      "end": 62.0,
      "n_words": 13,
