      "start_frame": 1838,
      "end_frame": 1912,
      "keyframes": [
        "001902.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ em sẽ khứa cái phần nấm đông cô trước dạ, rồi phần hành tây tiến cắt cao dạ.",
      "start": 76.48,
      "end": 90.4,
      "n_words": 19,
      "start_frame": 1912,
