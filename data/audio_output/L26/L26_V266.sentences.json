        "003488.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp theo một ít bột năng nè, chúng ta sẽ thoa vào những cái chỗ mà mình đã cắt cá như thế này để cho cái phần nhân nó sẽ dính chặt vào cá hơn.",
      "start": 139.52,
      "end": 148.36,
      "n_words": 35,
      "start_frame": 3488,
      "end_frame": 3709,
      "keyframes": [
        "003488.webp",
