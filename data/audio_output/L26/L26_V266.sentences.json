      "end": 166.0,
      "n_words": 15,
      "start_frame": 4049,
      "end_frame": 4150,
      "keyframes": [
        "004113.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "À dạ, hứa hẹn là món canh này rất là chất lượng đúng không cô?",
