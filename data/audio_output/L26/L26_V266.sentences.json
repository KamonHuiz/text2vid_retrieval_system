        "004299.webp",
        "004300.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi cô sẽ để qua dĩa.",
      "start": 172.04,
      "end": 174.24,
      "n_words": 6,
      "start_frame": 4301,
      "end_frame": 4356,
      "keyframes": [
        "004333.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi bây giờ thì em đặt lên cho cô, em đặt lên cho cô một cái chảo lên trên bếp nha. Dạ.",
      "start": 174.24,
