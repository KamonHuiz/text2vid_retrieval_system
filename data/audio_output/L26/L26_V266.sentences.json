      "keyframes": [
        "001484.webp",
        "001485.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 62.0,
      "end": 65.96,
      "n_words": 11,
      "start_frame": 1550,
      "end_frame": 1649,
      "keyframes": [
        "001595.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Phương ơi, dạ là nhờ em rồi.",
