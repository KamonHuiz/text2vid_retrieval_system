      "keyframes": [
        "002801.webp",
        "002802.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Tiếp theo thì chúng ta sẽ sơ chế đến phần cá.",
      "start": 112.12,
      "end": 114.56,
      "n_words": 11,
      "start_frame": 2803,
      "end_frame": 2864,
      "keyframes": [
        "002832.webp",
        "002863.webp",
        "002864.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Con cá sau khi làm sạch, bây giờ chúng ta sẽ khứa.",
