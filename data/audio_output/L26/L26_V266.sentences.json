        "002220.webp",
        "002221.webp",
        "002249.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Rồi và bây giờ thì chúng ta sẽ trộn cái phần nhân thịt.",
      "start": 90.4,
