      "end_frame": 1264,
      "keyframes": [
        "001223.webp",
        "001263.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bánh crepe nhân sầu riêng mời chờ các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 50.56,
