        "000378.webp",
        "000401.webp",
        "000402.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chào Phước Hương, đang lẩm bẩm gì đó à?",
      "start": 17.12,
      "end": 19.68,
      "n_words": 9,
      "start_frame": 428,
