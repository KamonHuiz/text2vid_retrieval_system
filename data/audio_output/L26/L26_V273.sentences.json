      "n_words": 20,
      "start_frame": 738,
      "end_frame": 886,
      "keyframes": [
        "000758.webp",
        "000759.webp",
        "000833.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phước Hương nói đi.",
