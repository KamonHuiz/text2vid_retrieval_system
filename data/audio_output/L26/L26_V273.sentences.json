  "total_words": 983,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày!",
      "start": 10.52,
      "end": 12.56,
      "n_words": 4,
      "start_frame": 263,
      "end_frame": 314,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thơm quá à, chắc chắn là Phước Hương giấu trái sầu riêng trong bếp nè. Chào Thanh Phương!",
      "start": 12.56,
