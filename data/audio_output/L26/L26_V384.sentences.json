  "fps": 25.0,
  "n_sentences": 50,
  "total_words": 968,
  "sentences": [
    {
      "text": "Món thơm mỗi ngày.",
      "start": 10.56,
      "end": 11.96,
      "n_words": 4,
      "start_frame": 264,
      "end_frame": 299,
      "keyframes": [
        "000299.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- À ơi, cô đi chợ về rồi đây! - Ủa em làm gì á hả?",
      "start": 11.96,
      "end": 16.6,
      "n_words": 16,
      "start_frame": 299,
      "end_frame": 415,
      "keyframes": [
        "000299.webp",
        "000300.webp",
        "000330.webp",
        "000361.webp",
        "000362.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- Em đợi cô từ sáng giờ rồi cô.",
      "start": 16.6,
      "end": 19.04,
      "n_words": 9,
      "start_frame": 415,
      "end_frame": 476,
      "keyframes": [
        "000417.webp",
        "000472.webp",
        "000473.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Trời ơi cô đã mua nè, một con cá nè.",
      "start": 19.04,
      "end": 22.32,
      "n_words": 11,
      "start_frame": 476,
      "end_frame": 558,
      "keyframes": [
        "000486.webp",
        "000500.webp",
        "000501.webp",
        "000529.webp",
        "000557.webp",
        "000558.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nghĩ coi mình làm món gì?",
      "start": 22.32,
      "end": 23.56,
      "n_words": 6,
      "start_frame": 558,
      "end_frame": 589,
      "keyframes": [
        "000558.webp",
        "000559.webp",
        "000560.webp",
        "000561.webp",
        "000588.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- Em nghĩ ra rồi nè, phần đầu á mình đem nấu canh chua me, cái phần đuôi mình đem kho tộ, nửa thân giữa thì mình đem chiên xù, còn nửa còn lại mình làm cái gì ngon ngon được vậy cô?",
      "start": 23.56,
      "end": 35.12,
      "n_words": 43,
      "start_frame": 589,
      "end_frame": 878,
      "keyframes": [
        "000615.webp",
        "000616.webp",
        "000671.webp",
        "000727.webp",
        "000728.webp",
        "000765.webp",
        "000802.webp",
        "000803.webp",
        "000839.webp",
        "000876.webp",
        "000877.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Con cá sáu trăm mà nấu gì dữ vậy?",
      "start": 35.12,
      "end": 37.76,
      "n_words": 9,
      "start_frame": 878,
      "end_frame": 944,
      "keyframes": [
        "000924.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Không có đâu nghe, cô còn mua thêm rau quế vị nữa nè.",
      "start": 37.76,
      "end": 41.28,
      "n_words": 14,
      "start_frame": 944,
      "end_frame": 1032,
      "keyframes": [
        "000972.webp",
        "000973.webp",
        "001000.webp",
        "001028.webp",
        "001029.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cô tính là cô làm món cá nướng cùng với rau quế vị, nghe cũng có vẻ rất hấp dẫn.",
      "start": 41.28,
      "end": 46.56,
      "n_words": 20,
      "start_frame": 1032,
      "end_frame": 1164,
      "keyframes": [
        "001072.webp",
        "001116.webp",
        "001117.webp",
        "001131.webp",
        "001145.webp",
        "001146.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thôi bây giờ mình bắt đầu luôn nha.",
      "start": 46.56,
      "end": 48.0,
      "n_words": 8,
      "start_frame": 1164,
      "end_frame": 1200,
      "keyframes": [
        "001183.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Được liền luôn!",
      "start": 48.0,
      "end": 50.84,
      "n_words": 4,
      "start_frame": 1200,
      "end_frame": 1271,
      "keyframes": [
        "001220.webp",
        "001221.webp",
        "001245.webp",
        "001270.webp",
        "001271.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cá điêu hồng ngũ vị nướng, xuất thơm vị, ngon khó cưỡng.",
      "start": 50.84,
      "end": 70.96,
      "n_words": 12,
      "start_frame": 1271,
      "end_frame": 1774,
      "keyframes": [
        "001271.webp",
        "001323.webp",
        "001376.webp",
        "001377.webp",
        "001429.webp",
        "001481.webp",
        "001496.webp",
        "001547.webp",
        "001599.webp",
        "001600.webp",
        "001687.webp",
        "001774.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 70.96,
      "end": 73.76,
      "n_words": 12,
      "start_frame": 1774,
      "end_frame": 1844,
      "keyframes": [
        "001774.webp",
        "001775.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 73.76,
      "end": 77.76,
      "n_words": 11,
      "start_frame": 1844,
      "end_frame": 1944,
      "keyframes": [
        "001862.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và đây là một cái loại rau mà người ta còn gọi là rau ngũ vị hay là rau quế vị.",
      "start": 77.76,
      "end": 82.72,
      "n_words": 21,
      "start_frame": 1944,
      "end_frame": 2068,
      "keyframes": [
        "001949.webp",
        "001950.webp",
        "001985.webp",
        "002021.webp",
        "002022.webp",
        "002062.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rau này ha cô ta hay ăn trong các cái loại rau sống mà trong cái món bánh tráng Tây Ninh mà cuốn rau rừng đó.",
      "start": 82.72,
      "end": 90.6,
      "n_words": 26,
      "start_frame": 2068,
      "end_frame": 2265,
      "keyframes": [
        "002102.webp",
        "002103.webp",
        "002157.webp",
        "002212.webp",
        "002213.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Em ngửi cái mùi em thấy nó quen lắm mà không kịp nhớ ra.",
      "start": 90.6,
      "end": 93.24,
      "n_words": 14,
      "start_frame": 2265,
      "end_frame": 2331,
      "keyframes": [
        "002271.webp",
        "002330.webp",
        "002331.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ở đây thì cô đã chuẩn bị rồi nè: một muỗng canh nước lá ngũ vị mình đã băm ra và để ướp cái gia vị vào trong cá.",
      "start": 93.24,
      "end": 100.48,
      "n_words": 29,
      "start_frame": 2331,
      "end_frame": 2512,
      "keyframes": [
        "002331.webp",
        "002393.webp",
        "002456.webp",
        "002457.webp",
        "002495.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thì mình cần thêm một muỗng canh muối tôm Tây Ninh, một muỗng cà phê bột ngọt Ajinomoto, cùng với lại một muỗng canh màu dầu điều.",
      "start": 100.48,
      "end": 108.8,
      "n_words": 27,
      "start_frame": 2512,
      "end_frame": 2720,
      "keyframes": [
        "002534.webp",
        "002535.webp",
        "002560.webp",
        "002585.webp",
        "002586.webp",
        "002619.webp",
        "002652.webp",
        "002653.webp",
        "002685.webp",
        "002718.webp",
        "002719.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Mình chỉ cần khuấy đều cái hỗn hợp gia vị này.",
      "start": 108.8,
      "end": 112.32,
      "n_words": 11,
      "start_frame": 2720,
      "end_frame": 2808,
      "keyframes": [
        "002759.webp",
        "002799.webp",
        "002800.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tiếp theo, cá điêu hồng sau khi mua về mình rửa sạch và bây giờ thì chúng ta sẽ tiến hành là mình sẽ khứa ở trên mình cá, khứa xéo như thế này.",
      "start": 112.32,
      "end": 121.12,
      "n_words": 34,
      "start_frame": 2808,
      "end_frame": 3028,
      "keyframes": [
        "002846.webp",
        "002892.webp",
        "002893.webp",
        "002912.webp",
        "002932.webp",
        "002933.webp",
        "002975.webp",
        "003018.webp",
        "003019.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Thì chúng ta sẽ khứa khoảng ba khứa dọc theo mình cá.",
      "start": 121.12,
      "end": 124.08,
      "n_words": 12,
      "start_frame": 3028,
      "end_frame": 3102,
      "keyframes": [
        "003048.webp",
        "003078.webp",
        "003079.webp",
        "003101.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ khứa xéo trên mình cá để cho gia vị dễ thấm nha.",
      "start": 124.08,
      "end": 129.0,
      "n_words": 20,
      "start_frame": 3102,
      "end_frame": 3225,
      "keyframes": [
        "003124.webp",
        "003125.webp",
        "003171.webp",
        "003218.webp",
        "003219.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi khi mình ướp là mình cho gia vị lên trên này và cho nó vào trong mấy cái kẽ mà mình đã khứa ra đó, rồi và mát xa đều ở trên cái da cá.",
      "start": 129.0,
      "end": 139.4,
      "n_words": 36,
      "start_frame": 3225,
      "end_frame": 3485,
      "keyframes": [
        "003301.webp",
        "003384.webp",
        "003385.webp",
        "003435.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khi mà mình cho thêm màu dầu điều thì em thấy là con cá nó sẽ có màu đẹp và trở nên bóng bẩy hơn, ngon.",
      "start": 139.4,
      "end": 145.28,
      "n_words": 26,
      "start_frame": 3485,
      "end_frame": 3632,
      "keyframes": [
        "003486.webp",
        "003487.webp",
        "003558.webp",
        "003630.webp",
        "003631.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Còn những cái gia vị này nè mình cũng nên nhớ là mình cũng sẽ cho vào trong bụng của cá, thậm chí là mình cũng có thể cho một ít lá ngũ vị giã nát mình cho vô đây luôn á thì hồi sau nó sẽ rất là thơm bếp.",
      "start": 145.28,
      "end": 157.76,
      "n_words": 51,
      "start_frame": 3632,
      "end_frame": 3944,
      "keyframes": [
        "003700.webp",
        "003769.webp",
        "003770.webp",
        "003848.webp",
        "003927.webp",
        "003928.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chuẩn bị xong rồi, bây giờ em nướng cá giúp cô.",
      "start": 157.76,
      "end": 160.16,
      "n_words": 11,
      "start_frame": 3944,
      "end_frame": 4004,
      "keyframes": [
        "003965.webp",
        "004002.webp",
        "004003.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "À mình để cá lên vỉ nướng này nè, phía dưới lên trên mình nướng cá luôn.",
      "start": 160.16,
      "end": 164.6,
      "n_words": 17,
      "start_frame": 4004,
      "end_frame": 4115,
      "keyframes": [
        "004036.webp",
        "004069.webp",
        "004070.webp",
        "004100.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ừ rồi, giảm lửa vừa vừa thôi.",
      "start": 164.6,
      "end": 168.12,
      "n_words": 7,
      "start_frame": 4115,
      "end_frame": 4203,
      "keyframes": [
        "004131.webp",
        "004132.webp",
        "004164.webp",
        "004196.webp",
        "004197.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rất là đẹp ha!",
      "start": 168.12,
      "end": 170.56,
      "n_words": 4,
      "start_frame": 4203,
      "end_frame": 4264,
      "keyframes": [
        "004240.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi và như vậy là để cho cá dễ chín á thì giờ mình sẽ dùng một cái miếng giấy bạc á rồi mình trùm lên đó, và chúng ta cũng sẽ chờ cái mặt bên này khoảng chừng 10 phút cho cá chín.",
      "start": 170.56,
      "end": 180.76,
      "n_words": 44,
      "start_frame": 4264,
      "end_frame": 4519,
      "keyframes": [
        "004283.webp",
