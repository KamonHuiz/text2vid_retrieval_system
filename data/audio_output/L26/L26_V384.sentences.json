      "end_frame": 5828,
      "keyframes": [
        "005692.webp",
        "005715.webp",
        "005716.webp",
        "005785.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Là được rồi, màu sắc nước sốt rất là thơm, ngon vàng của thơm nữa chứ.",
      "start": 233.12,
