        "004850.webp",
        "004877.webp",
        "004878.webp",
        "004908.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tiếp theo thì chúng ta sẽ cho vào đây hành tây cắt hạt lựu.",
      "start": 197.36,
      "end": 200.72,
      "n_words": 14,
      "start_frame": 4934,
      "end_frame": 5018,
      "keyframes": [
        "004939.webp",
        "004940.webp",
        "004963.webp",
        "004986.webp",
        "004987.webp",
        "005011.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Khi xào hành tây thì các bạn lưu ý là chúng ta sẽ xào hành tây chín kỹ để phần sốt ngọt và thơm hơn.",
      "start": 200.72,
      "end": 206.76,
      "n_words": 25,
      "start_frame": 5018,
      "end_frame": 5169,
      "keyframes": [
        "005036.webp",
        "005037.webp",
