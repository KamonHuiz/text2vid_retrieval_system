        "004328.webp",
        "004339.webp",
        "004340.webp",
        "004405.webp",
        "004471.webp",
        "004472.webp",
        "004495.webp",
        "004519.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ dùng giấy bạc bọc lên cá khi nướng để cá chín đều ha.",
      "start": 180.76,
      "end": 185.2,
      "n_words": 21,
      "start_frame": 4519,
      "end_frame": 4630,
      "keyframes": [
        "004519.webp",
        "004520.webp",
        "004574.webp",
        "004629.webp",
        "004630.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ làm sốt để ăn kèm.",
      "start": 185.2,
      "end": 187.12,
      "n_words": 8,
      "start_frame": 4630,
      "end_frame": 4678,
      "keyframes": [
        "004630.webp",
        "004654.webp",
        "004678.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sẽ đặt một cái chảo lên trên bếp, mình sẽ cho vào đây hai muỗng canh dầu điều.",
      "start": 187.12,
      "end": 191.44,
      "n_words": 18,
      "start_frame": 4678,
      "end_frame": 4786,
      "keyframes": [
        "004678.webp",
        "004679.webp",
        "004698.webp",
