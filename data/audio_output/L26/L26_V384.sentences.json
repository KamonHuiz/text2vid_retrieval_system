        "005101.webp",
        "005120.webp",
        "005121.webp",
        "005142.webp",
        "005163.webp",
        "005164.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Tỏi mình cũng sẽ bập nhỏ cho vào đây.",
      "start": 206.76,
      "end": 209.44,
      "n_words": 9,
      "start_frame": 5169,
      "end_frame": 5236,
      "keyframes": [
        "005200.webp",
        "005236.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ thì chúng ta sẽ nêm gia vị vào đây: một muỗng canh rưỡi nước mắm, tiếp theo mình cho một muỗng canh đường, nửa muỗng cà phê bột ngọt Ajinomoto, hai muỗng cà phê nước cốt tắc, rồi mình cho luôn phần ớt xanh ớt đỏ đã dập vào đây.",
      "start": 209.44,
      "end": 226.92,
      "n_words": 52,
      "start_frame": 5236,
      "end_frame": 5673,
      "keyframes": [
        "005236.webp",
