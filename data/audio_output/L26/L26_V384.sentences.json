        "004744.webp",
        "004769.webp",
        "004770.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mình đợi cho dầu nóng lên, mình sẽ sử dụng khoảng chừng bốn củ hành tím cắt lát vô xào lên cho thơm.",
      "start": 191.44,
      "end": 197.36,
      "n_words": 23,
      "start_frame": 4786,
      "end_frame": 4934,
      "keyframes": [
        "004796.webp",
