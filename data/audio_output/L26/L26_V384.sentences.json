        "005669.webp"
      ],
      "keyframe_count": 32
    },
    {
      "text": "Bây giờ cho chừng hai muỗng cà phê nước đã pha bột năng vô thôi để cho phần sốt này nó có độ sánh nhẹ nhẹ là được rồi.",
      "start": 226.92,
      "end": 233.12,
      "n_words": 29,
