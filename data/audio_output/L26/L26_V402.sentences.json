{
  "video_id": "L26_V402",
  "fps": 25.0,
  "n_sentences": 58,
  "total_words": 927,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.56,
      "end": 12.08,
      "n_words": 4,
      "start_frame": 264,
      "end_frame": 302,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chào Long, chào Minh Tuấn ơi nhìn kìa thấy gì không?",
      "start": 12.08,
      "end": 16.48,
      "n_words": 11,
      "start_frame": 302,
      "end_frame": 412,
      "keyframes": [
        "000331.webp",
        "000362.webp",
        "000363.webp",
        "000376.webp",
        "000390.webp",
        "000391.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mưa gió tơi bời, mây đen đang kéo đến.",
      "start": 16.48,
      "end": 19.24,
      "n_words": 9,
      "start_frame": 412,
      "end_frame": 481,
      "keyframes": [
        "000418.webp",
        "000445.webp",
        "000446.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Có món gì thơm thơm mặn mặn ăn cho đỡ đói không?",
      "start": 19.24,
      "end": 22.6,
      "n_words": 12,
      "start_frame": 481,
      "end_frame": 565,
      "keyframes": [
        "000485.webp",
        "000525.webp",
        "000526.webp",
        "000562.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đói quá Long ơi, mình ăn lẩu được không?",
      "start": 22.6,
      "end": 26.84,
      "n_words": 9,
      "start_frame": 565,
      "end_frame": 671,
      "keyframes": [
        "000598.webp",
        "000599.webp",
        "000619.webp",
        "000639.webp",
        "000640.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nói chung là tính cầu xin cái món gì ăn cho nó đỡ đói thôi, nhưng mà lẩu thì quá tuyệt vời luôn. Lẩu gì?",
      "start": 26.84,
      "end": 32.92,
      "n_words": 25,
      "start_frame": 671,
      "end_frame": 823,
      "keyframes": [
        "000717.webp",
        "000794.webp",
        "000795.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Lẩu cá tiến vua, cá lăng đúng không?",
      "start": 32.92,
      "end": 36.48,
      "n_words": 8,
      "start_frame": 823,
      "end_frame": 912,
      "keyframes": [
        "000837.webp",
        "000880.webp",
        "000881.webp",
        "000894.webp",
        "000907.webp",
        "000908.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ mình kết hợp với lại bông súng đũa.",
      "start": 36.48,
      "end": 39.36,
      "n_words": 10,
      "start_frame": 912,
      "end_frame": 984,
      "keyframes": [
        "000934.webp",
        "000961.webp",
        "000962.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trời ôi được không?",
      "start": 39.36,
      "end": 41.8,
      "n_words": 4,
      "start_frame": 984,
      "end_frame": 1045,
      "keyframes": [
        "000994.webp",
        "001026.webp",
        "001027.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sắp xỉu rồi, nấu liền luôn được không chứ còn chờ nữa không được đâu.",
      "start": 41.8,
      "end": 47.2,
      "n_words": 15,
      "start_frame": 1045,
      "end_frame": 1180,
      "keyframes": [
        "001079.webp",
        "001132.webp",
        "001133.webp",
        "001157.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ẩm thực đồng quê với lẩu cá lăng bông sọ đũa mến. Chào quý vị khán giả đã quay trở lại với chương trình Món ngon mỗi ngày.",
      "start": 47.2,
      "end": 69.52,
      "n_words": 28,
      "start_frame": 1180,
      "end_frame": 1738,
      "keyframes": [
        "001182.webp",
        "001183.webp",
        "001226.webp",
        "001270.webp",
        "001271.webp",
        "001324.webp",
        "001377.webp",
        "001392.webp",
        "001442.webp",
        "001493.webp",
        "001494.webp",
        "001581.webp",
        "001668.webp",
        "001669.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 69.52,
      "end": 73.2,
      "n_words": 11,
      "start_frame": 1738,
      "end_frame": 1830,
      "keyframes": [
        "001751.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nếu mà nói về món lẩu thì chắc là không có gì quá phức tạp đúng không Long?",
      "start": 73.2,
      "end": 77.4,
      "n_words": 18,
      "start_frame": 1830,
      "end_frame": 1935,
      "keyframes": [
        "001834.webp",
        "001835.webp",
        "001880.webp",
        "001925.webp",
        "001926.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đặc biệt hôm nay nấu lẩu cực kỳ nhanh, quan trọng là chỗ đó.",
      "start": 77.4,
      "end": 80.68,
      "n_words": 14,
      "start_frame": 1935,
      "end_frame": 2017,
      "keyframes": [
        "001958.webp",
        "001990.webp",
        "001991.webp",
        "002004.webp",
        "002017.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ mình sẽ cá nha anh Tuấn.",
      "start": 80.68,
      "end": 82.24,
      "n_words": 8,
      "start_frame": 2017,
      "end_frame": 2056,
      "keyframes": [
        "002017.webp",
        "002018.webp",
        "002040.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi, đây là cá lăng rất là tươi.",
      "start": 82.24,
      "end": 84.52,
      "n_words": 8,
      "start_frame": 2056,
      "end_frame": 2113,
      "keyframes": [
        "002063.webp",
        "002064.webp",
        "002103.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho khử mùi tanh nè, biết luôn, cho thêm chút giấm nè.",
      "start": 84.52,
      "end": 88.88,
      "n_words": 12,
      "start_frame": 2113,
      "end_frame": 2222,
      "keyframes": [
        "002142.webp",
        "002143.webp",
        "002182.webp",
        "002221.webp",
        "002222.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ cho vào cá một muỗng canh gia vị nêm sẵn Ajikit lẩu kim chi và mình trộn đều lên, và mình sẽ cho thấm.",
      "start": 88.88,
      "end": 96.52,
      "n_words": 27,
      "start_frame": 2222,
      "end_frame": 2413,
      "keyframes": [
        "002222.webp",
        "002290.webp",
        "002358.webp",
        "002359.webp",
        "002385.webp",
        "002411.webp",
        "002412.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cà chua bổ múi cau nè.",
      "start": 96.52,
      "end": 99.64,
      "n_words": 6,
      "start_frame": 2413,
      "end_frame": 2491,
      "keyframes": [
        "002444.webp",
        "002476.webp",
        "002477.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sau khi cắt cà chua xong, chúng ta sẽ chuẩn bị phần sả, mình sẽ đập dập cắt khúc ha, cắt khúc.",
      "start": 99.64,
      "end": 109.68,
      "n_words": 22,
      "start_frame": 2491,
      "end_frame": 2742,
      "keyframes": [
        "002492.webp",
        "002507.webp",
        "002508.webp",
        "002548.webp",
        "002589.webp",
        "002590.webp",
        "002617.webp",
        "002644.webp",
        "002645.webp",
        "002687.webp",
        "002730.webp",
        "002731.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Rau thơm mình cũng cắt khúc luôn.",
      "start": 109.68,
      "end": 111.56,
      "n_words": 7,
      "start_frame": 2742,
      "end_frame": 2789,
      "keyframes": [
        "002756.webp",
        "002781.webp",
        "002782.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó, mấy cái món lẩu chua là không được thiếu cái này: rau tần dày lá thì mình sẽ sắc sợi sợi.",
      "start": 111.56,
      "end": 120.72,
      "n_words": 22,
      "start_frame": 2789,
      "end_frame": 3018,
      "keyframes": [
        "002824.webp",
        "002866.webp",
        "002867.webp",
        "002874.webp",
        "002881.webp",
        "002882.webp",
        "002914.webp",
        "002946.webp",
        "002947.webp",
        "002969.webp",
        "002992.webp",
        "002993.webp",
        "003013.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Thơm ơi, chúng ta cắt lát thế là xong phần sả.",
      "start": 120.72,
      "end": 127.12,
      "n_words": 11,
      "start_frame": 3018,
      "end_frame": 3178,
      "keyframes": [
        "003034.webp",
        "003035.webp",
        "003063.webp",
        "003091.webp",
        "003092.webp",
        "003116.webp",
        "003141.webp",
        "003142.webp",
        "003143.webp",
        "003144.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Tiếp theo mình sẽ làm gì?",
      "start": 127.12,
      "end": 128.36,
      "n_words": 6,
      "start_frame": 3178,
      "end_frame": 3209,
      "keyframes": [
        "003181.webp",
        "003188.webp",
        "003195.webp",
        "003196.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mình sẽ xào tao phần cá rồi xào thơm sả rồi mình sóc nhẹ nhàng thôi để cá đừng có vỡ đúng không?",
      "start": 128.36,
      "end": 139.12,
      "n_words": 23,
      "start_frame": 3209,
      "end_frame": 3478,
      "keyframes": [
        "003212.webp",
        "003229.webp",
        "003230.webp",
        "003254.webp",
        "003278.webp",
        "003279.webp",
        "003310.webp",
        "003342.webp",
        "003343.webp",
        "003408.webp",
        "003474.webp",
        "003475.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Cá săn lại thấm gia vị, thơm mùi sả nữa.",
      "start": 139.12,
      "end": 142.32,
      "n_words": 10,
      "start_frame": 3478,
      "end_frame": 3558,
      "keyframes": [
        "003498.webp",
        "003522.webp",
        "003523.webp",
        "003552.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đây là một công đoạn rất là quan trọng, cái việc mà sóc cá với dầu phi sả giúp cho cá thơm hơn và săn hơn.",
      "start": 142.32,
      "end": 146.88,
      "n_words": 26,
      "start_frame": 3558,
      "end_frame": 3672,
      "keyframes": [
        "003582.webp",
        "003583.webp",
        "003625.webp",
        "003668.webp",
        "003669.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tuấn ơi cái phần cá đã săn rồi đó, bây giờ Tuấn rút luôn lấy cái nồi lẩu đi.",
      "start": 146.88,
      "end": 149.88,
      "n_words": 19,
      "start_frame": 3672,
      "end_frame": 3747,
      "keyframes": [
        "003705.webp",
        "003742.webp",
        "003743.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "OK, mình phụ bếp nô tì mà.",
      "start": 149.88,
      "end": 151.84,
      "n_words": 7,
      "start_frame": 3747,
      "end_frame": 3796,
      "keyframes": [
        "003779.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Một lít nước nha.",
      "start": 151.84,
      "end": 152.92,
      "n_words": 4,
      "start_frame": 3796,
      "end_frame": 3823,
      "keyframes": [
        "003816.webp",
        "003817.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đây rồi, mình chờ nước sôi lên ha.",
      "start": 152.92,
      "end": 155.84,
      "n_words": 8,
      "start_frame": 3823,
      "end_frame": 3896,
      "keyframes": [
        "003883.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, nước sôi xong phải đổ ăn cá vào.",
      "start": 155.84,
      "end": 158.0,
      "n_words": 10,
      "start_frame": 3896,
      "end_frame": 3950,
      "keyframes": [
        "003949.webp",
        "003950.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khi mà nước sôi chúng ta hãy cho vào đây là cái phần gói gia vị nêm sẵn Ajikit lẩu kim chi phần còn lại nãy đúng không?",
      "start": 158.0,
      "end": 163.92,
      "n_words": 28,
      "start_frame": 3950,
      "end_frame": 4098,
      "keyframes": [
        "003950.webp",
        "003999.webp",
        "004049.webp",
        "004050.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Sau khi mình lấy lại một muỗng canh.",
      "start": 163.92,
      "end": 165.04,
      "n_words": 8,
      "start_frame": 4098,
      "end_frame": 4126,
      "keyframes": [
        "004102.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, sôi mình đổ vô đều lên, vẩy đều lên mà chỉ vậy thôi hả?",
      "start": 165.04,
      "end": 168.56,
      "n_words": 16,
      "start_frame": 4126,
      "end_frame": 4214,
      "keyframes": [
        "004155.webp",
        "004156.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Không nêm nếm gì nữa luôn?",
      "start": 168.56,
      "end": 169.64,
      "n_words": 6,
      "start_frame": 4214,
      "end_frame": 4241,
      "keyframes": [
        "004228.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tiện lát mình chỉ rưới chút xíu nước mắm cho đậm vị thôi.",
      "start": 169.64,
      "end": 172.12,
      "n_words": 13,
      "start_frame": 4241,
      "end_frame": 4303,
      "keyframes": [
        "004300.webp",
        "004301.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Các bạn lưu ý là khi sử dụng gia vị nêm sẵn Ajikit lẩu kim chi, gói và kim chi sẽ giúp cho công đoạn nấu của chúng ta nó nhanh chóng và tiện lợi hơn.",
      "start": 172.12,
      "end": 179.04,
      "n_words": 36,
      "start_frame": 4303,
      "end_frame": 4476,
      "keyframes": [
        "004386.webp",
        "004472.webp",
        "004473.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi bây giờ khi mà sôi phải cho cá vào.",
      "start": 179.04,
      "end": 183.84,
      "n_words": 10,
      "start_frame": 4476,
      "end_frame": 4596,
      "keyframes": [
        "004504.webp",
        "004535.webp",
        "004536.webp",
        "004562.webp",
        "004589.webp",
        "004590.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Lẩu hấp dẫn chưa?",
      "start": 183.84,
      "end": 184.96,
      "n_words": 4,
      "start_frame": 4596,
      "end_frame": 4624,
      "keyframes": [
        "004613.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ Long phải cho phần cà chua vào, cho cái phần ớt quá đẹp luôn, màu quá đẹp mắt.",
      "start": 184.96,
      "end": 189.72,
      "n_words": 20,
      "start_frame": 4624,
      "end_frame": 4743,
      "keyframes": [
        "004637.webp",
        "004638.webp",
        "004660.webp",
        "004682.webp",
        "004683.webp",
        "004713.webp",
        "004743.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Trước khi tắt bếp thì Long sẽ cho vào đây là một muỗng cà phê đường và một muỗng canh nước mắm và mình chỉ cho một ít rau thơm vào.",
      "start": 189.72,
      "end": 199.52,
      "n_words": 31,
      "start_frame": 4743,
      "end_frame": 4988,
      "keyframes": [
        "004743.webp",
        "004744.webp",
        "004766.webp",
        "004789.webp",
        "004790.webp",
        "004804.webp",
        "004819.webp",
        "004820.webp",
        "004834.webp",
        "004849.webp",
        "004850.webp",
        "004878.webp",
        "004907.webp",
        "004908.webp",
        "004929.webp",
        "004950.webp",
        "004951.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Mình nhìn là mình thấy là cái món ăn này là phải thực sự là đầy đủ dinh dưỡng luôn.",
      "start": 199.52,
      "end": 203.44,
      "n_words": 20,
      "start_frame": 4988,
      "end_frame": 5086,
      "keyframes": [
        "005028.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cá lăng thì mọi người cũng biết rồi, đây là một cái loài cá mà có rất là ít xương và ăn rất là ngon nên là rất là phù hợp cho các thành viên trong gia đình luôn.",
      "start": 203.44,
      "end": 210.8,
      "n_words": 39,
      "start_frame": 5086,
      "end_frame": 5270,
      "keyframes": [
        "005105.webp",
        "005106.webp",
        "005152.webp",
        "005198.webp",
        "005199.webp",
        "005233.webp",
        "005268.webp",
        "005269.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mình cho tiếp xíu tần dày lá vào, phần dày lá rất là hợp với cá lăng.",
      "start": 210.8,
      "end": 214.36,
      "n_words": 17,
      "start_frame": 5270,
      "end_frame": 5359,
      "keyframes": [
        "005323.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, nấm nè, cho một ít nấm vào.",
      "start": 214.36,
      "end": 216.68,
      "n_words": 9,
      "start_frame": 5359,
      "end_frame": 5417,
      "keyframes": [
        "005377.webp",
        "005378.webp"
