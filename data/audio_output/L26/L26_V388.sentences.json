      "n_words": 34,
      "start_frame": 532,
      "end_frame": 718,
      "keyframes": [
        "000608.webp",
        "000713.webp",
        "000714.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ô nhưng mà vương giả là từ nguyên liệu cho đến cả cách nấu luôn hả?",
