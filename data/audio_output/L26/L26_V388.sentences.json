      "start_frame": 1004,
      "end_frame": 1024,
      "keyframes": [
        "001013.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu năm mới khai xuân là sang sang một chút cho cả năm mình hân hoan đúng không?",
