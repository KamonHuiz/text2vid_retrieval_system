        "000990.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thật sự ra em biết không, mình ăn gỏi cuốn rồi nhưng mà em ăn đậu hủ cuốn chưa?",
      "start": 40.44,
