        "000455.webp",
        "000456.webp",
        "000475.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Buồn lắm á nhớ, cái món nào sẵn sàng xíu đi.",
      "start": 19.12,
      "end": 21.72,
      "n_words": 11,
