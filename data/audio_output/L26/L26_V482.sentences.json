        "000348.webp",
        "000396.webp",
        "000397.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "May quá, nhớ đậu hủ, em nhớ đậu hủ rồi.",
      "start": 16.44,
      "end": 19.12,
      "n_words": 10,
      "start_frame": 411,
