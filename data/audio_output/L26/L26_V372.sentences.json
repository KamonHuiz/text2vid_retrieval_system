        "003740.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi phần gà sau khi chúng ta cắt ra thì bây giờ mình sẽ tẩm ướp.",
      "start": 149.96,
      "end": 153.44,
