      "start_frame": 3564,
      "end_frame": 3597,
      "keyframes": [
        "003589.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chúng ta sẽ chọn má đùi để khi xào gà không bị khô.",
