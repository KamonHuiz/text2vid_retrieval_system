        "000531.webp",
        "000575.webp",
        "000576.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ăn Tết lớn lắm hay sao mà giờ dư âm dữ vậy?",
      "start": 25.52,
      "end": 28.36,
      "n_words": 12,
      "start_frame": 638,
      "end_frame": 709,
      "keyframes": [
        "000649.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi dư luôn cái rổ mùa xuân vậy hả?",
