      "keyframes": [
        "002211.webp",
        "002247.webp",
        "002248.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Khi mình mua về thì mình sẽ sơ chế như thế nào hả Hoàng Long?",
