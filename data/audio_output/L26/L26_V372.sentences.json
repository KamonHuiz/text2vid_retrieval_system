        "002019.webp",
        "002050.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "À thôi đưa đây Phương nói là dễ rồi, phải có công sức chứ đúng không?",
      "start": 82.84,
      "end": 88.08,
      "n_words": 16,
      "start_frame": 2071,
      "end_frame": 2202,
      "keyframes": [
        "002082.webp",
