{
  "video_id": "L26_V307",
  "fps": 25.0,
  "n_sentences": 68,
  "total_words": 1061,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.52,
      "end": 12.4,
      "n_words": 4,
      "start_frame": 263,
      "end_frame": 310,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ôi thơm quá! Ủa cô Hà đâu rồi ta?",
      "start": 12.4,
      "end": 16.72,
      "n_words": 9,
      "start_frame": 310,
      "end_frame": 418,
      "keyframes": [
        "000316.webp",
        "000332.webp",
        "000333.webp",
        "000377.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "- Cô!",
      "start": 16.72,
      "end": 18.36,
      "n_words": 2,
      "start_frame": 418,
      "end_frame": 459,
      "keyframes": [
        "000421.webp",
        "000422.webp",
        "000442.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Em chào cô Hà.",
      "start": 18.36,
      "end": 19.4,
      "n_words": 5,
      "start_frame": 459,
      "end_frame": 485,
      "keyframes": [
        "000462.webp",
        "000463.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Chào Kim Thảo.",
      "start": 19.4,
      "end": 20.28,
      "n_words": 4,
      "start_frame": 485,
      "end_frame": 507,
      "keyframes": [
        "000486.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Ủa cô Hà ơi, cô Hà có nguyên liệu gì lạ vậy cô?",
      "start": 20.28,
      "end": 23.16,
      "n_words": 14,
      "start_frame": 507,
      "end_frame": 579,
      "keyframes": [
        "000509.webp",
        "000510.webp",
        "000529.webp",
        "000548.webp",
        "000549.webp",
        "000570.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Cô đang chuẩn bị nguyên liệu nấu cho món rằm tháng sáu này nè.",
      "start": 23.16,
      "end": 26.48,
      "n_words": 15,
      "start_frame": 579,
      "end_frame": 662,
      "keyframes": [
        "000591.webp",
        "000592.webp",
        "000623.webp",
        "000655.webp",
        "000656.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- Ô nhắc đến rằm tháng sáu âm lịch á thì em nhớ là em đã từng đến với Quảng Ninh, ở đó có một cái lễ hội rất là lớn, có một câu thơ như thế này nè.",
      "start": 26.48,
      "end": 35.92,
      "n_words": 39,
      "start_frame": 662,
      "end_frame": 898,
      "keyframes": [
        "000702.webp",
        "000748.webp",
        "000749.webp",
        "000808.webp",
        "000867.webp",
        "000868.webp",
        "000885.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "- Cô Hà đọc chút đi, vừa nấu vừa đọc nha.",
      "start": 35.92,
      "end": 39.08,
      "n_words": 11,
      "start_frame": 898,
      "end_frame": 977,
      "keyframes": [
        "000903.webp",
        "000904.webp",
        "000937.webp",
        "000970.webp",
        "000971.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- Dạ.",
      "start": 39.08,
      "end": 39.68,
      "n_words": 2,
      "start_frame": 977,
      "end_frame": 992,
      "keyframes": [
        "000987.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi bây giờ thì mình sẽ nấu món ăn của ngày hôm nay: mì căn kho nấm, cháo lá dứa sánh bùi thơm ngát.",
      "start": 39.68,
      "end": 63.16,
      "n_words": 24,
      "start_frame": 992,
      "end_frame": 1579,
      "keyframes": [
        "001003.webp",
        "001004.webp",
        "001028.webp",
        "001053.webp",
        "001054.webp",
        "001078.webp",
        "001103.webp",
        "001104.webp",
        "001154.webp",
        "001205.webp",
        "001206.webp",
        "001248.webp",
        "001291.webp",
        "001306.webp",
        "001368.webp",
        "001430.webp",
        "001431.webp",
        "001517.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 63.16,
      "end": 66.84,
      "n_words": 13,
      "start_frame": 1579,
      "end_frame": 1671,
      "keyframes": [
        "001604.webp",
        "001605.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Azino Việt Nam.",
      "start": 66.84,
      "end": 70.28,
      "n_words": 11,
      "start_frame": 1671,
      "end_frame": 1757,
      "keyframes": [
        "001688.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi bắt đầu, món ăn này thì cô nhờ Kim Thảo bắc lên cho cô một nồi nước để cô nấu cháo nha.",
      "start": 70.28,
      "end": 74.84,
      "n_words": 23,
      "start_frame": 1757,
      "end_frame": 1871,
      "keyframes": [
        "001771.webp",
        "001772.webp",
        "001793.webp",
        "001815.webp",
        "001816.webp",
        "001830.webp",
        "001845.webp",
        "001846.webp",
        "001861.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Dạ.",
      "start": 74.84,
      "end": 75.12,
      "n_words": 1,
      "start_frame": 1871,
      "end_frame": 1878,
      "keyframes": [
        "001877.webp",
        "001878.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thì đầu tiên là mình sẽ cho vào đây một chút xíu muối.",
      "start": 75.12,
      "end": 78.44,
      "n_words": 13,
      "start_frame": 1878,
      "end_frame": 1961,
      "keyframes": [
        "001878.webp",
        "001900.webp",
        "001922.webp",
        "001923.webp",
        "001942.webp",
        "001961.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Kim Thảo cho dùm cô đó là chén gạo mà cô đã vo rồi đó.",
      "start": 78.44,
      "end": 81.76,
      "n_words": 15,
      "start_frame": 1961,
      "end_frame": 2044,
      "keyframes": [
        "001961.webp",
        "001962.webp",
        "001985.webp",
        "002009.webp",
        "002010.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và các bạn cũng lưu ý là khi mà mình nấu cháo thì mình sẽ nấu từ hồi nước lạnh nha, mình cho nếp vô luôn.",
      "start": 81.76,
      "end": 87.04,
      "n_words": 26,
      "start_frame": 2044,
      "end_frame": 2176,
      "keyframes": [
        "002056.webp",
        "002103.webp",
        "002104.webp",
        "002127.webp",
        "002150.webp",
        "002151.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nấu như vậy nó sẽ làm cho cái cháo của mình nó có cái độ sánh sệt.",
      "start": 87.04,
      "end": 91.08,
      "n_words": 17,
      "start_frame": 2176,
      "end_frame": 2277,
      "keyframes": [
        "002189.webp",
        "002227.webp",
        "002228.webp",
        "002260.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng rồi, ban đầu thì mình khuấy ha, khuấy sơ.",
      "start": 91.08,
      "end": 93.84,
      "n_words": 10,
      "start_frame": 2277,
      "end_frame": 2346,
      "keyframes": [
        "002292.webp",
        "002293.webp",
        "002323.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi cho vào nấu ở đây một ít lá dứa.",
      "start": 93.84,
      "end": 96.76,
      "n_words": 10,
      "start_frame": 2346,
      "end_frame": 2419,
      "keyframes": [
        "002354.webp",
        "002355.webp",
        "002396.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bắt đầu sơ chế các nguyên liệu khác.",
      "start": 96.76,
      "end": 98.92,
      "n_words": 8,
      "start_frame": 2419,
      "end_frame": 2473,
      "keyframes": [
        "002438.webp",
        "002439.webp",
        "002471.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đầu tiên là mì căn, mình sẽ lựa cái miếng mì căn nó trắng và nó ráo mặt như thế này nè.",
      "start": 98.92,
      "end": 103.44,
      "n_words": 22,
      "start_frame": 2473,
      "end_frame": 2586,
      "keyframes": [
        "002504.webp",
        "002505.webp",
        "002575.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sau khi mình rửa sạch và bây giờ thì cô sẽ cắt nó thành miếng vừa ăn, cắt hai trước sau đó thì cô sẽ cắt làm ba.",
      "start": 103.44,
      "end": 110.0,
      "n_words": 28,
      "start_frame": 2586,
      "end_frame": 2750,
      "keyframes": [
        "002645.webp",
        "002646.webp",
        "002673.webp",
        "002700.webp",
        "002701.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đối với trong món ăn chay thì người ta sử dụng mì căn để bổ sung cái chất đạm cho cái bữa ăn chay đó.",
      "start": 110.0,
      "end": 116.44,
      "n_words": 25,
      "start_frame": 2750,
      "end_frame": 2911,
      "keyframes": [
        "002779.webp",
        "002857.webp",
        "002858.webp",
        "002885.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ thì cô sẽ đặt một cái chảo lên trên bếp, mở lửa lên rồi mình sẽ cho vào đây dầu ăn.",
      "start": 116.44,
      "end": 121.44,
      "n_words": 23,
      "start_frame": 2911,
      "end_frame": 3036,
      "keyframes": [
        "002913.webp",
        "002914.webp",
        "002949.webp",
        "002985.webp",
        "002986.webp",
        "003026.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Mà cô Hà ơi, tại sao mì căn mình phải chiên lên vậy cô Hà?",
      "start": 121.44,
      "end": 125.12,
      "n_words": 16,
      "start_frame": 3036,
      "end_frame": 3128,
      "keyframes": [
        "003066.webp",
        "003067.webp",
        "003096.webp",
        "003125.webp",
        "003126.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- À, đối với món ăn này á thì chúng ta sẽ chiên sơ mì căn để tạo cái màu sắc hấp dẫn và khi mà mình kho nó sẽ thấm vị hơn.",
      "start": 125.12,
      "end": 132.32,
      "n_words": 33,
      "start_frame": 3128,
      "end_frame": 3308,
      "keyframes": [
        "003174.webp",
        "003223.webp",
        "003224.webp",
        "003263.webp",
        "003303.webp",
        "003304.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Mì căn này em có thể mua được ở đâu cô Hà?",
      "start": 132.32,
      "end": 134.6,
      "n_words": 13,
      "start_frame": 3308,
      "end_frame": 3365,
      "keyframes": [
        "003354.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Chỗ mà bán đậu hủ em.",
      "start": 134.6,
      "end": 136.16,
      "n_words": 7,
      "start_frame": 3365,
      "end_frame": 3404,
      "keyframes": [
        "003404.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hồi nãy hứa là đọc thơ cho cô nghe đó.",
      "start": 136.16,
      "end": 139.16,
      "n_words": 10,
      "start_frame": 3404,
      "end_frame": 3479,
      "keyframes": [
        "003404.webp",
        "003405.webp",
        "003439.webp",
        "003473.webp",
        "003474.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- Dạ: \"Dù ai đi ngược về xuôi, nhớ rằm tháng sáu chèo bơi thì về\".",
      "start": 139.16,
      "end": 144.68,
      "n_words": 16,
      "start_frame": 3479,
      "end_frame": 3617,
      "keyframes": [
        "003558.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Cô biết về đâu không?",
      "start": 144.68,
      "end": 145.76,
      "n_words": 6,
      "start_frame": 3617,
      "end_frame": 3644,
      "keyframes": [
        "003643.webp",
        "003644.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Câu này cô cũng biết à, là về Quảng Ninh đúng không?",
      "start": 145.76,
      "end": 150.0,
      "n_words": 13,
      "start_frame": 3644,
      "end_frame": 3750,
      "keyframes": [
        "003644.webp",
        "003695.webp",
        "003746.webp",
        "003747.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "- Nhưng mà để làm gì cô?",
      "start": 150.0,
      "end": 151.6,
      "n_words": 7,
      "start_frame": 3750,
      "end_frame": 3790,
      "keyframes": [
        "003772.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- À, dự cái lễ hội tưởng nhớ chiến công của tướng quân Trần Khánh Dư đánh thắng quân Nguyên Mông.",
      "start": 151.6,
      "end": 158.48,
      "n_words": 21,
      "start_frame": 3790,
      "end_frame": 3962,
      "keyframes": [
        "003797.webp",
        "003798.webp",
        "003834.webp",
        "003870.webp",
        "003871.webp",
        "003894.webp",
        "003918.webp",
        "003919.webp",
        "003943.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Wow!",
      "start": 158.48,
      "end": 160.44,
      "n_words": 1,
      "start_frame": 3962,
      "end_frame": 4011,
      "keyframes": [
        "003967.webp",
        "003968.webp",
        "003989.webp",
        "004010.webp",
        "004011.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bắc lên cho cô một cái nồi để cô kho nha.",
      "start": 160.44,
      "end": 163.56,
      "n_words": 11,
      "start_frame": 4011,
      "end_frame": 4089,
      "keyframes": [
        "004011.webp",
        "004032.webp",
        "004053.webp",
        "004054.webp",
        "004075.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dạ.",
      "start": 163.56,
      "end": 163.96,
      "n_words": 1,
      "start_frame": 4089,
      "end_frame": 4099,
      "keyframes": [
        "004097.webp",
        "004098.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cho dầu vào trong nồi, khi mà dầu nóng rồi thì mình sẽ cho bơ cắt lát này.",
      "start": 163.96,
      "end": 168.76,
      "n_words": 18,
      "start_frame": 4099,
      "end_frame": 4219,
      "keyframes": [
        "004121.webp",
        "004144.webp",
        "004145.webp",
        "004167.webp",
        "004189.webp",
        "004190.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình sử dụng nhiều bơ một chút thì món ăn mình nó sẽ thơm.",
      "start": 168.76,
      "end": 171.96,
      "n_words": 14,
      "start_frame": 4219,
      "end_frame": 4299,
      "keyframes": [
        "004243.webp",
        "004297.webp",
        "004298.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Với món chay thì chúng ta không thể nào mà thiếu bơ được.",
      "start": 171.96,
      "end": 175.44,
      "n_words": 13,
      "start_frame": 4299,
      "end_frame": 4386,
      "keyframes": [
        "004340.webp",
        "004383.webp",
        "004384.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho mì căn vô.",
      "start": 175.44,
      "end": 176.52,
      "n_words": 4,
      "start_frame": 4386,
      "end_frame": 4413,
      "keyframes": [
        "004400.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nấm rơm mình ngâm rửa sạch và khứa chữ thập nè, nó vừa đẹp nó vừa thấm gia vị nữa.",
      "start": 176.52,
      "end": 181.44,
      "n_words": 20,
      "start_frame": 4413,
      "end_frame": 4536,
      "keyframes": [
        "004417.webp",
        "004418.webp",
        "004472.webp",
        "004526.webp",
        "004527.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sẽ đảo.",
      "start": 181.64,
      "end": 183.08,
      "n_words": 2,
      "start_frame": 4541,
      "end_frame": 4577,
      "keyframes": [
        "004555.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ thì mình sẽ cho vào đây một ít nước tương Phú Sĩ nha, một ít dầu hào chay và một ít hạt nêm Aji-ngon nấm.",
      "start": 183.08,
      "end": 192.72,
      "n_words": 27,
      "start_frame": 4577,
      "end_frame": 4818,
      "keyframes": [
        "004583.webp",
        "004584.webp",
        "004628.webp",
        "004673.webp",
        "004674.webp",
        "004702.webp",
        "004730.webp",
        "004731.webp",
        "004745.webp",
        "004760.webp",
        "004761.webp",
        "004783.webp",
        "004806.webp",
        "004807.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Thấy không dạ?",
      "start": 192.72,
      "end": 193.56,
      "n_words": 3,
      "start_frame": 4818,
      "end_frame": 4839,
      "keyframes": [
        "004835.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rất là thơm ha.",
      "start": 193.56,
      "end": 194.92,
      "n_words": 4,
      "start_frame": 4839,
      "end_frame": 4873,
      "keyframes": [
        "004864.webp",
        "004865.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đó và màu sắc nó cũng đã lên rồi.",
      "start": 194.92,
      "end": 198.08,
      "n_words": 9,
      "start_frame": 4873,
      "end_frame": 4952,
      "keyframes": [
        "004908.webp",
        "004952.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mình cho nước dừa tươi nó vừa xâm xấp tới với lại những cái nguyên liệu bên trong này.",
