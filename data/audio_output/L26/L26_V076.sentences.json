        "002085.webp",
        "002086.webp",
        "002150.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta cắt những miếng hạt lựu nhỏ thôi.",
      "start": 88.48,
      "end": 93.56,
      "n_words": 9,
      "start_frame": 2212,
