        "001154.webp",
        "001198.webp",
        "001199.webp",
        "001228.webp",
        "001258.webp",
        "001259.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "- Đúng rồi em.",
      "start": 50.36,
      "end": 50.96,
      "n_words": 4,
      "start_frame": 1259,
      "end_frame": 1274,
      "keyframes": [
        "001259.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và đây anh có một phần, cùng hai nguyên liệu kết hợp với nhau thì chúng ta biết món ngon ngày hôm nay chúng ta có tên gọi là gì đúng không em?",
      "start": 50.96,
      "end": 56.04,
      "n_words": 33,
      "start_frame": 1274,
      "end_frame": 1401,
      "keyframes": [
        "001282.webp",
        "001305.webp",
        "001306.webp",
        "001332.webp",
        "001358.webp",
        "001359.webp",
        "001396.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tức là cơm chiên kim chi.",
      "start": 56.04,
      "end": 57.6,
      "n_words": 6,
      "start_frame": 1401,
      "end_frame": 1440,
      "keyframes": [
        "001433.webp",
        "001434.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Kim chi này thì chúng ta chọn mua kim chi vừa ngấu thôi, tức là vừa chua vừa ăn và chúng ta phải vắt ráo nước.",
      "start": 57.6,
      "end": 64.36,
      "n_words": 26,
      "start_frame": 1440,
      "end_frame": 1609,
      "keyframes": [
        "001470.webp",
