        "001507.webp",
        "001535.webp",
        "001563.webp",
        "001564.webp",
        "001595.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bây giờ nhờ em thái sợi, có cái cỡ khoảng 3 ly là được.",
      "start": 64.36,
      "end": 68.0,
      "n_words": 14,
      "start_frame": 1609,
      "end_frame": 1700,
      "keyframes": [
        "001627.webp",
