        "003023.webp",
        "003024.webp",
        "003069.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Các bạn, bây giờ phần chuẩn bị nguyên liệu đã xong rồi, chúng ta tới phần chính.",
      "start": 123.0,
