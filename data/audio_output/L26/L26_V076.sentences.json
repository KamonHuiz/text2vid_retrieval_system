        "006783.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mà mình ăn kèm với một món canh nữa là hết ý luôn đấy ạ.",
      "start": 272.44,
      "end": 275.44,
      "n_words": 15,
      "start_frame": 6811,
