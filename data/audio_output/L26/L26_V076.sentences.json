        "005931.webp",
        "005980.webp",
        "005981.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta chờ trứng chín một tí xíu nha.",
      "start": 239.56,
      "end": 242.08,
      "n_words": 9,
      "start_frame": 5989,
