        "001867.webp",
        "001922.webp",
        "001923.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Và cơm thì chúng ta nấu cho khô ráo và để cho nguội.",
      "start": 76.96,
      "end": 80.04,
      "n_words": 13,
      "start_frame": 1924,
      "end_frame": 2001,
      "keyframes": [
        "001966.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Như vậy, bây giờ tôi sẽ hướng dẫn xử lý cái phần thịt bò rồi chúng ta sẽ cắt ra thành những sợi trước nha.",
      "start": 80.04,
