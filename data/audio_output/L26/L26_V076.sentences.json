        "005317.webp",
        "005318.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tắt lửa, chúng ta cho hành lá vào sau cùng, thì chúng ta nhớ cho dầu mè vào nha.",
      "start": 212.8,
      "end": 217.72,
      "n_words": 19,
