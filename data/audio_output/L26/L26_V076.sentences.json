      "end_frame": 7133,
      "keyframes": [
        "006886.webp",
        "006998.webp",
        "007110.webp",
        "007111.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cơm chiên màu đỏ điểm xuyết màu vàng xanh cực bắt mắt, thơm lừng mùi kim chi và nước tương vị chua cay, kích thích cùng với thịt bò mềm mọng cực cuốn.",
      "start": 285.32,
      "end": 296.2,
      "n_words": 33,
      "start_frame": 7133,
      "end_frame": 7405,
      "keyframes": [
        "007141.webp",
        "007171.webp",
