      "n_words": 31,
      "start_frame": 856,
      "end_frame": 1103,
      "keyframes": [
        "000859.webp",
        "000860.webp",
        "000985.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Anh Vũ nè, em thấy trong phần nguyên liệu có kim chi cực kỳ hấp dẫn luôn, chắc là anh Vũ định làm một cái món Hàn Quốc đúng không ạ?",
      "start": 44.12,
      "end": 50.36,
      "n_words": 32,
      "start_frame": 1103,
      "end_frame": 1259,
      "keyframes": [
        "001110.webp",
