      "n_words": 21,
      "start_frame": 4852,
      "end_frame": 4997,
      "keyframes": [
        "004868.webp",
        "004869.webp",
        "004895.webp",
        "004922.webp",
        "004923.webp",
        "004948.webp",
        "004973.webp",
        "004974.webp",
        "004987.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Thì Long sẽ sử dụng lại cái phần dầu mà mình chiên đậu rồi, mình chỉ lấy một ít thôi.",
      "start": 199.88,
      "end": 203.88,
      "n_words": 20,
      "start_frame": 4997,
      "end_frame": 5097,
      "keyframes": [
        "005000.webp",
        "005001.webp",
        "005028.webp",
        "005056.webp",
        "005057.webp",
        "005076.webp",
        "005096.webp",
        "005097.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mình sẽ xào thơm cái phần hành baro này, cứ phần gốc, phần lá thì mình sẽ cho vào lúc sau. Thơm quá!",
      "start": 203.88,
