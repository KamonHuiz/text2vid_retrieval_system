  "n_sentences": 62,
  "total_words": 1001,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.48,
      "end": 12.52,
      "n_words": 4,
      "start_frame": 262,
      "end_frame": 313,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Uy Phương thấy có củ cải trắng nè, bí ngòi nè.",
      "start": 12.52,
      "end": 17.4,
      "n_words": 11,
      "start_frame": 313,
      "end_frame": 435,
      "keyframes": [
        "000333.webp",
        "000366.webp",
        "000367.webp",
        "000397.webp",
        "000427.webp",
        "000428.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ủa sao toàn rau củ không vậy?",
      "start": 17.4,
      "end": 19.84,
      "n_words": 7,
      "start_frame": 435,
      "end_frame": 496,
      "keyframes": [
        "000472.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hôm nay chay hả?",
      "start": 19.84,
      "end": 20.84,
      "n_words": 4,
      "start_frame": 496,
      "end_frame": 521,
      "keyframes": [
        "000517.webp",
        "000518.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chính xác luôn, có rau củ luôn nè.",
      "start": 20.84,
      "end": 22.84,
      "n_words": 8,
      "start_frame": 521,
      "end_frame": 571,
      "keyframes": [
        "000537.webp",
        "000556.webp",
        "000557.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rau củ không được thiếu nguồn cung cấp canxi à?",
      "start": 22.84,
      "end": 27.96,
      "n_words": 10,
      "start_frame": 571,
      "end_frame": 699,
      "keyframes": [
        "000581.webp",
        "000605.webp",
        "000606.webp",
        "000617.webp",
        "000629.webp",
        "000630.webp",
        "000651.webp",
        "000673.webp",
        "000674.webp",
        "000687.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Đây là sai nha, ở đây mình có mè trắng nè với lại bí đỏ nè là rất nhiều canxi rồi. Vậy á hả?",
      "start": 27.96,
      "end": 34.92,
      "n_words": 24,
      "start_frame": 699,
      "end_frame": 873,
      "keyframes": [
        "000701.webp",
        "000702.webp",
        "000715.webp",
        "000728.webp",
        "000729.webp",
        "000752.webp",
        "000775.webp",
        "000776.webp",
        "000794.webp",
        "000813.webp",
        "000814.webp",
        "000832.webp",
        "000850.webp",
        "000851.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Đúng không ta?",
      "start": 34.92,
      "end": 36.16,
      "n_words": 3,
      "start_frame": 873,
      "end_frame": 904,
      "keyframes": [
        "000876.webp",
        "000901.webp",
        "000902.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Quá đủ chất luôn.",
      "start": 36.16,
      "end": 37.28,
      "n_words": 4,
      "start_frame": 904,
      "end_frame": 932,
      "keyframes": [
        "000916.webp",
        "000931.webp",
        "000932.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Một món ngon đang đợi sẵn chúng ta: rau củ xào đậu hũ sốt mè thanh mát ngọt mê ly. Chào quý vị khán giả đã quay trở lại với chương trình Món ngon mỗi ngày.",
      "start": 37.28,
      "end": 64.44,
      "n_words": 36,
      "start_frame": 932,
      "end_frame": 1611,
      "keyframes": [
        "000932.webp",
        "000956.webp",
        "000980.webp",
        "000981.webp",
        "001005.webp",
        "001030.webp",
        "001031.webp",
        "001083.webp",
        "001136.webp",
        "001137.webp",
        "001196.webp",
        "001255.webp",
        "001272.webp",
        "001316.webp",
        "001361.webp",
        "001362.webp",
        "001448.webp",
        "001535.webp",
        "001536.webp"
      ],
      "keyframe_count": 19
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 64.44,
      "end": 68.2,
      "n_words": 11,
      "start_frame": 1611,
      "end_frame": 1705,
      "keyframes": [
        "001623.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trước tiên làm gì nào?",
      "start": 68.2,
      "end": 69.52,
      "n_words": 5,
      "start_frame": 1705,
      "end_frame": 1738,
      "keyframes": [
        "001710.webp",
        "001711.webp",
        "001724.webp",
        "001738.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trước tiên phần bông cải mình tách ra, sử dụng cái mũi dao đúng không, muỗng vào cái phần chân và tách ra, rất là đơn giản, để riêng một bên.",
      "start": 69.52,
      "end": 77.68,
      "n_words": 31,
      "start_frame": 1738,
      "end_frame": 1942,
      "keyframes": [
        "001738.webp",
        "001739.webp",
        "001775.webp",
        "001812.webp",
        "001813.webp",
        "001840.webp",
        "001867.webp",
        "001868.webp",
        "001904.webp",
        "001941.webp",
        "001942.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đến lượt Minh Phương cắt cái phần bí đỏ này đúng không Hoàng Long?",
      "start": 77.68,
      "end": 80.88,
      "n_words": 14,
      "start_frame": 1942,
      "end_frame": 2022,
      "keyframes": [
        "001942.webp",
        "001975.webp",
        "002009.webp",
        "002010.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng rồi, cắt lát vừa ăn như thế này đúng không nào?",
      "start": 80.88,
      "end": 83.16,
      "n_words": 12,
      "start_frame": 2022,
      "end_frame": 2079,
      "keyframes": [
        "002058.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, cái đó là vừa đó.",
      "start": 83.16,
      "end": 84.8,
      "n_words": 7,
      "start_frame": 2079,
      "end_frame": 2120,
      "keyframes": [
        "002106.webp",
        "002107.webp",
        "002116.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi có cái phần ớt sừng thì phần ớt thì mình xắt hình thôi.",
      "start": 84.8,
      "end": 88.04,
      "n_words": 14,
      "start_frame": 2120,
      "end_frame": 2201,
      "keyframes": [
        "002126.webp",
        "002127.webp",
        "002149.webp",
        "002172.webp",
        "002173.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thôi đối với món xào, các cái loại rau củ quả chúng ta cắt cái hình dáng nó tương đồng nhau để chín cho nó đồng đều đúng không Hoàng Long?",
      "start": 88.04,
      "end": 95.44,
      "n_words": 31,
      "start_frame": 2201,
      "end_frame": 2386,
      "keyframes": [
        "002246.webp",
        "002320.webp",
        "002321.webp",
        "002352.webp",
        "002383.webp",
        "002384.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đồng thời nó cũng đẹp mắt nữa.",
      "start": 95.44,
      "end": 97.64,
      "n_words": 7,
      "start_frame": 2386,
      "end_frame": 2441,
      "keyframes": [
        "002413.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Như vậy là xong cái phần ớt của Long.",
      "start": 97.92,
      "end": 100.24,
      "n_words": 9,
      "start_frame": 2448,
      "end_frame": 2506,
      "keyframes": [
        "002459.webp",
        "002475.webp",
        "002476.webp",
        "002489.webp",
        "002503.webp",
        "002504.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ở đây thì chúng ta còn bí ngòi đúng không Hoàng Long?",
      "start": 100.24,
      "end": 102.64,
      "n_words": 12,
      "start_frame": 2506,
      "end_frame": 2566,
      "keyframes": [
        "002518.webp",
        "002532.webp",
        "002533.webp",
        "002564.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bí ngòi mình chẻ đôi sau đó mình cắt xéo, và đối với bí ngòi thì chúng ta không có bỏ cái phần vỏ đúng không Hoàng Long?",
      "start": 102.64,
      "end": 109.44,
      "n_words": 28,
      "start_frame": 2566,
      "end_frame": 2736,
      "keyframes": [
        "002596.webp",
        "002597.webp",
        "002635.webp",
        "002673.webp",
        "002674.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Không nên bỏ phần vỏ, đúng rồi, bởi vì cái phần vỏ nó có độ giòn và nó cũng rất là tốt.",
      "start": 109.44,
      "end": 113.48,
      "n_words": 22,
      "start_frame": 2736,
      "end_frame": 2837,
      "keyframes": [
        "002754.webp",
        "002834.webp",
        "002835.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phần cà chua chúng ta cà chua mình chẻ đôi là được, mình chẻ đôi luôn.",
      "start": 113.48,
      "end": 116.24,
      "n_words": 16,
      "start_frame": 2837,
      "end_frame": 2906,
      "keyframes": [
        "002869.webp",
        "002904.webp",
        "002905.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Việc kết hợp rau củ nhiều màu sắc giúp cho món ăn ngon, đầy đủ dinh dưỡng và đẹp mắt hơn.",
      "start": 116.24,
      "end": 121.08,
      "n_words": 21,
      "start_frame": 2906,
      "end_frame": 3027,
      "keyframes": [
        "002936.webp",
        "002967.webp",
        "002968.webp",
        "002993.webp",
        "003019.webp",
        "003020.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ Long sẽ cắt cái phần đậu hũ này.",
      "start": 121.08,
      "end": 123.0,
      "n_words": 10,
      "start_frame": 3027,
      "end_frame": 3075,
      "keyframes": [
        "003046.webp",
        "003072.webp",
        "003073.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Như vậy là protein trong món ăn ngày hôm nay sẽ là phần đậu hũ nè.",
      "start": 123.0,
      "end": 127.76,
      "n_words": 16,
      "start_frame": 3075,
      "end_frame": 3194,
      "keyframes": [
        "003116.webp",
        "003159.webp",
        "003160.webp",
        "003194.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi hôm nay sẽ là một trận chiến không hồi kết.",
      "start": 127.76,
      "end": 131.72,
      "n_words": 11,
      "start_frame": 3194,
      "end_frame": 3293,
      "keyframes": [
        "003194.webp",
        "003229.webp",
        "003230.webp",
        "003259.webp",
        "003289.webp",
        "003290.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phương sẽ đợi nước sôi để trần cái phần bông cải và bí đỏ, còn Hoàng Long thì sẽ chiên rám mặt phần đậu hũ.",
      "start": 131.72,
      "end": 143.48,
      "n_words": 25,
      "start_frame": 3293,
      "end_frame": 3587,
      "keyframes": [
        "003318.webp",
        "003346.webp",
        "003347.webp",
        "003402.webp",
        "003458.webp",
        "003459.webp",
        "003499.webp",
        "003540.webp",
        "003541.webp",
        "003573.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Phần nước sôi rồi, mình cho thêm vào đây là một chút xíu muối nè, nửa muỗng cà phê đường.",
      "start": 143.48,
      "end": 148.8,
      "n_words": 20,
      "start_frame": 3587,
      "end_frame": 3720,
      "keyframes": [
        "003605.webp",
        "003606.webp",
        "003650.webp",
        "003694.webp",
        "003695.webp",
        "003716.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phương sẽ cho trước tiên là cái phần bông cải trắng vào trần thật nhanh với nhiệt độ thật là lớn.",
      "start": 148.8,
      "end": 155.04,
      "n_words": 21,
      "start_frame": 3720,
      "end_frame": 3876,
      "keyframes": [
        "003738.webp",
        "003739.webp",
        "003764.webp",
        "003789.webp",
        "003790.webp",
        "003831.webp",
        "003872.webp",
        "003873.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rồi đó, Phương nghĩ được rồi đó.",
      "start": 155.04,
      "end": 156.48,
      "n_words": 7,
      "start_frame": 3876,
      "end_frame": 3912,
      "keyframes": [
        "003906.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ thì sẽ nhanh chóng vớt ra, mình xả nước lạnh liền là được rồi.",
      "start": 156.48,
      "end": 160.36,
      "n_words": 16,
      "start_frame": 3912,
      "end_frame": 4009,
      "keyframes": [
        "003939.webp",
        "003940.webp",
        "003973.webp",
        "004007.webp",
        "004008.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Kế đến là cho cái phần bí đỏ vào khoảng 45 giây thôi các bạn. Phần bí đỏ chắc là cũng được rồi đó Hoàng Long ha?",
      "start": 160.36,
      "end": 167.48,
      "n_words": 27,
      "start_frame": 4009,
      "end_frame": 4187,
      "keyframes": [
        "004042.webp",
