        "004077.webp",
        "004096.webp",
        "004115.webp",
        "004116.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi đó, mình cũng trần qua rồi xả nước lạnh luôn.",
      "start": 167.48,
      "end": 170.32,
      "n_words": 12,
      "start_frame": 4187,
      "end_frame": 4258,
      "keyframes": [
        "004209.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Việc trần sơ rau củ giúp cho rau củ chín đều và thấm vị.",
      "start": 170.72,
      "end": 174.52,
      "n_words": 14,
      "start_frame": 4268,
      "end_frame": 4363,
      "keyframes": [
        "004302.webp",
        "004303.webp",
        "004327.webp",
        "004352.webp",
        "004353.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cái phần đậu hũ đã bắt đầu được rồi ha, trông qua hấp dẫn quá.",
      "start": 174.52,
      "end": 178.8,
      "n_words": 15,
      "start_frame": 4363,
      "end_frame": 4470,
      "keyframes": [
        "004382.webp",
        "004411.webp",
        "004412.webp",
        "004442.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thì bây giờ mình sẽ pha sốt trước khi mình xào.",
      "start": 178.8,
      "end": 180.68,
      "n_words": 11,
      "start_frame": 4470,
      "end_frame": 4517,
      "keyframes": [
        "004473.webp",
        "004474.webp",
        "004494.webp",
        "004515.webp",
        "004516.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ mình sẽ cần nước tương Kikkoman nè, hạt nêm Ajinomoto ngon lắm, bột ngọt Ajinomoto, đường, mè rang và nước lọc.",
      "start": 180.68,
      "end": 194.08,
      "n_words": 23,
      "start_frame": 4517,
      "end_frame": 4852,
      "keyframes": [
        "004553.webp",
        "004590.webp",
        "004591.webp",
        "004634.webp",
        "004678.webp",
        "004679.webp",
        "004706.webp",
