        "002481.webp",
        "002482.webp",
        "002506.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ chúng ta sẽ cất gà qua một bên và chuẩn bị tới cái phần quan trọng nhất ngày hôm nay đó là bí xanh.",
      "start": 101.12,
      "end": 105.96,
      "n_words": 26,
      "start_frame": 2528,
      "end_frame": 2649,
      "keyframes": [
        "002530.webp",
        "002531.webp",
        "002589.webp",
        "002648.webp",
        "002649.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Món này chúng ta nên mua bí già thì món canh sẽ ngon hơn.",
      "start": 105.96,
      "end": 109.84,
      "n_words": 14,
      "start_frame": 2649,
      "end_frame": 2746,
      "keyframes": [
        "002649.webp",
        "002698.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khi sử dụng bí già thì chúng ta nên loại bỏ phần hột bên trong để món canh không bị cứng và chua nha.",
      "start": 109.84,
      "end": 114.72,
      "n_words": 24,
      "start_frame": 2746,
      "end_frame": 2868,
      "keyframes": [
        "002748.webp",
        "002749.webp",
        "002809.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ chúng ta sẽ cắt dọc như vầy, chúng ta sẽ cắt lại miếng vừa ăn.",
      "start": 114.72,
      "end": 123.36,
      "n_words": 17,
