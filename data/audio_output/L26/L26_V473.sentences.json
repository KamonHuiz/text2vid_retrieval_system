        "002175.webp",
        "002201.webp",
        "002202.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Chúng ta sẽ trộn cái phần hỗn hợp này lên.",
      "start": 88.36,
      "end": 91.2,
      "n_words": 10,
      "start_frame": 2209,
      "end_frame": 2280,
      "keyframes": [
        "002236.webp",
        "002270.webp",
        "002271.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Gà thì mình sẽ ướp trong bao lâu thì thấm vị?",
      "start": 91.2,
      "end": 93.44,
      "n_words": 11,
      "start_frame": 2280,
      "end_frame": 2336,
      "keyframes": [
        "002303.webp",
        "002335.webp",
        "002336.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đối với phần gà hôm nay thì xin chặt nó hơi to hơn bình thường một xíu, cho nên là chúng ta sẽ ướp tầm khoảng 15 tới 20 phút là miếng gà đã vừa thấm rồi.",
      "start": 93.44,
      "end": 101.12,
      "n_words": 37,
      "start_frame": 2336,
      "end_frame": 2528,
      "keyframes": [
        "002336.webp",
