        "000928.webp",
        "000953.webp",
        "000954.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Hay quá trời ơi, ý kiến quá hay luôn á, vừa được uống nước nè ha, vừa được món canh ngon mà xin nấu tặng vậy thôi.",
      "start": 38.2,
      "end": 44.96,
      "n_words": 27,
      "start_frame": 955,
      "end_frame": 1124,
      "keyframes": [
        "000995.webp",
