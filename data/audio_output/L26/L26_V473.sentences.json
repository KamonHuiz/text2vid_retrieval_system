        "001038.webp",
        "001076.webp",
        "001115.webp",
        "001116.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ mình làm liền đi, nấu liền luôn canh gà bí xanh ngọt mát trong lành.",
      "start": 44.96,
      "end": 68.28,
