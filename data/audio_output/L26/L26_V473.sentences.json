        "004730.webp",
        "004731.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Wow, một cái món ngon mà thực hiện dễ quá đi, còn đẹp nữa.",
      "start": 189.4,
      "end": 194.04,
      "n_words": 14,
