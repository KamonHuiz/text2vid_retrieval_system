        "005912.webp",
        "005967.webp",
        "005968.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nhanh trong tích tắc luôn, chúng ta đã có một cái món canh cực kỳ hấp dẫn các bạn ơi.",
      "start": 240.08,
      "end": 244.36,
