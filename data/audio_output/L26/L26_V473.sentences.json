      "start_frame": 1707,
      "end_frame": 1843,
      "keyframes": [
        "001776.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Phần đầu tiên thì chúng ta sẽ mua gà về, làm sạch và chúng ta chặt miếng vừa ăn tùy thích ở gia đình chúng ta.",
      "start": 73.72,
      "end": 80.0,
