        "005307.webp",
        "005308.webp",
        "005362.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và bây giờ là phần nêm cuối cùng, chúng ta cần nửa muỗng canh hạt nêm Ajinomoto ngon gà nữa nha.",
      "start": 216.56,
      "end": 222.12,
      "n_words": 21,
      "start_frame": 5414,
      "end_frame": 5553,
      "keyframes": [
        "005416.webp",
