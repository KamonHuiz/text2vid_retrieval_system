        "004789.webp",
        "004848.webp",
        "004849.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và bây giờ thì chúng ta sẽ tiếp tục cho phần bí xanh và cà rốt đã chuẩn bị.",
      "start": 194.04,
      "end": 198.48,
      "n_words": 19,
