      "n_words": 8,
      "start_frame": 630,
      "end_frame": 675,
      "keyframes": [
        "000647.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chơi gì ai nói còn với tên là cá tai phát.",
