        "003971.webp",
        "003972.webp",
        "004033.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bây giờ quý vị sẽ ra một tô phở để cho Kim Thảo thưởng thức trước đã nha.",
      "start": 162.56,
