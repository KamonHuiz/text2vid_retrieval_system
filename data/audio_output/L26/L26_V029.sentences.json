      "end": 140.6,
      "n_words": 10,
      "start_frame": 3446,
      "end_frame": 3515,
      "keyframes": [
        "003462.webp",
        "003463.webp",
        "003509.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho vào nồi 1 lít rưỡi nước lọc.",
