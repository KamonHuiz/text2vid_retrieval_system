        "002324.webp",
        "002342.webp",
        "002343.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Cái việc chúng ta ướp tỏi với gừng giúp tạo mùi hương đặc trưng cho phở tái lăn đó.",
      "start": 93.72,
