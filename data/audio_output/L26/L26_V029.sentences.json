        "003253.webp",
        "003306.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Phần lá hành thì các bạn cắt nhỏ làm rau nêm.",
      "start": 134.44,
      "end": 137.84,
      "n_words": 11,
      "start_frame": 3361,
      "end_frame": 3446,
      "keyframes": [
        "003411.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ chúng ta sẽ nấu nước dùng phở bò.",
