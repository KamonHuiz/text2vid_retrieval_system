      "n_words": 11,
      "start_frame": 1055,
      "end_frame": 1159,
      "keyframes": [
        "001092.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ngày hôm nay, đầu bếp Quốc Nghị sẽ hướng dẫn cho chúng ta một món ăn mà người Việt Nam ai cũng biết, đó chính là phở tái lăn.",
      "start": 46.36,
      "end": 52.84,
      "n_words": 29,
      "start_frame": 1159,
      "end_frame": 1321,
      "keyframes": [
        "001249.webp",
        "001250.webp",
        "001271.webp",
        "001293.webp",
        "001294.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và ngày hôm nay, Quốc Nghị sẽ hướng dẫn cho các bạn khán giả nè, Kim Thảo nè, nấu phở tái lăn nhanh gọn lẹ ngay trong căn bếp gia đình mình luôn.",
      "start": 52.84,
      "end": 60.44,
      "n_words": 33,
      "start_frame": 1321,
      "end_frame": 1511,
      "keyframes": [
        "001355.webp",
        "001417.webp",
        "001418.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và món ăn này theo chuyên gia dinh dưỡng Tiến sĩ Đào Thị Yến Phi, nó sẽ giúp hỗ trợ cho trí não làm việc hiệu quả hơn đó.",
      "start": 60.44,
      "end": 67.12,
      "n_words": 29,
      "start_frame": 1511,
      "end_frame": 1678,
      "keyframes": [
        "001548.webp",
        "001678.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thịt bò chúng ta sẽ cắt lát mỏng. Các bạn cắt ngược sớ nha thì thịt nó mới mềm.",
      "start": 67.12,
      "end": 71.72,
      "n_words": 19,
      "start_frame": 1678,
      "end_frame": 1793,
      "keyframes": [
        "001678.webp",
        "001679.webp",
        "001702.webp",
        "001726.webp",
        "001727.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Với món ăn này thì có thịt bò có chứa nhiều sắt và kẽm, rất là tốt cho trí não.",
      "start": 71.72,
      "end": 77.28,
      "n_words": 20,
      "start_frame": 1793,
      "end_frame": 1932,
      "keyframes": [
        "001795.webp",
        "001863.webp",
        "001864.webp",
        "001897.webp",
        "001930.webp",
        "001931.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tiếp đến là gầu bò, các bạn cũng sẽ cắt lát mỏng ngược sớ.",
      "start": 77.28,
      "end": 81.92,
      "n_words": 14,
      "start_frame": 1932,
      "end_frame": 2048,
      "keyframes": [
        "001992.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ chúng ta sẽ ướp thịt bò.",
      "start": 81.92,
      "end": 83.72,
      "n_words": 8,
      "start_frame": 2048,
      "end_frame": 2093,
      "keyframes": [
        "002054.webp",
        "002055.webp",
        "002074.webp",
        "002093.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đầu tiên các bạn sẽ cho một muỗng cà phê gia vị nêm sẵn Aji-phở bò, một muỗng rưỡi cà phê đường, một muỗng canh tỏi băm, một muỗng canh gừng băm.",
      "start": 83.72,
      "end": 93.72,
      "n_words": 32,
      "start_frame": 2093,
      "end_frame": 2343,
      "keyframes": [
        "002093.webp",
