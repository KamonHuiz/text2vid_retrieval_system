        "000755.webp",
        "000756.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Thật ra thì cô hiểu không, em đang kiểu như là khát khao và mong muốn được ăn bơ.",
      "start": 30.44,
      "end": 34.72,
      "n_words": 19,
      "start_frame": 761,
      "end_frame": 868,
      "keyframes": [
        "000814.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cô đang làm cái gì đó lạnh lạnh ngon ngon cô ơi, lạnh lạnh ngon ngon phải không?",
