        "002306.webp",
        "002355.webp",
        "002356.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi Tuấn ơi, Tuấn thấy là cô đã chuẩn bị sẵn bên chỗ của Tuấn kìa.",
      "start": 94.28,
