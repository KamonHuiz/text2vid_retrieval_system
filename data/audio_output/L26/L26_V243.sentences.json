      "n_words": 8,
      "start_frame": 1895,
      "end_frame": 1963,
      "keyframes": [
        "001948.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn cũng lưu ý là chúng ta sẽ chọn dừa dẻo, không già thì món bánh sẽ ngon hơn.",
      "start": 78.52,
