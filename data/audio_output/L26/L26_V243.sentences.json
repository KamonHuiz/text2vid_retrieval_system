      "n_words": 11,
      "start_frame": 1682,
      "end_frame": 1780,
      "keyframes": [
        "001699.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên là cô sẽ sên cái nhân dừa rồi mình để lửa nhỏ nhỏ thôi ha.",
      "start": 71.2,
      "end": 75.8,
