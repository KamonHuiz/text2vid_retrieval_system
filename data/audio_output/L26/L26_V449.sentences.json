        "002353.webp",
        "002354.webp",
        "002383.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Tiếp theo thì chúng ta sẽ trộn cái hỗn hợp giò sống trộn vào.",
      "start": 96.36,
      "end": 99.56,
      "n_words": 14,
