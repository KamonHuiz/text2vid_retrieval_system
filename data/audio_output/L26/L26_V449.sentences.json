        "000822.webp",
        "000846.webp",
        "000847.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Giờ mình vô bếp làm liền luôn ha.",
      "start": 34.08,
      "end": 35.68,
      "n_words": 8,
      "start_frame": 852,
      "end_frame": 892,
      "keyframes": [
        "000872.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đó, càng cua chiên mè sốt mayo, ngon khó cưỡng, vạn người mê.",
      "start": 35.68,
      "end": 58.08,
      "n_words": 13,
      "start_frame": 892,
      "end_frame": 1452,
      "keyframes": [
        "000897.webp",
