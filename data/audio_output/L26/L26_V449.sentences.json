        "002665.webp",
        "002666.webp",
        "002702.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Như vậy đủ rồi đó, bây giờ mình sẽ trộn đều lên.",
      "start": 108.88,
      "end": 111.24,
      "n_words": 12,
