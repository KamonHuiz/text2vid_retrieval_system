        "001281.webp",
        "001282.webp",
        "001369.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 58.08,
      "end": 61.2,
      "n_words": 13,
      "start_frame": 1452,
      "end_frame": 1530,
      "keyframes": [
        "001457.webp",
        "001458.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 61.2,
      "end": 65.28,
      "n_words": 11,
      "start_frame": 1530,
      "end_frame": 1632,
      "keyframes": [
        "001546.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi, đầu tiên để sơ chế phần càng cua thì mình sẽ bật lên một nồi nước sôi và trong nồi nước sôi này đó, chúng ta sẽ cho vô là vài cái lát gừng đập dập, một muỗng canh rượu trắng.",
      "start": 65.28,
      "end": 76.76,
      "n_words": 42,
      "start_frame": 1632,
      "end_frame": 1919,
      "keyframes": [
        "001635.webp",
