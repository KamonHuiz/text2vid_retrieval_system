      "end": 25.52,
      "n_words": 5,
      "start_frame": 584,
      "end_frame": 638,
      "keyframes": [
        "000604.webp",
        "000630.webp",
        "000631.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Càng cua thì rất là ngon và bổ dưỡng dạ.",
      "start": 25.52,
      "end": 27.84,
      "n_words": 10,
      "start_frame": 638,
      "end_frame": 696,
      "keyframes": [
        "000663.webp",
        "000695.webp",
        "000696.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô nghĩ ra một món rồi, mình đem chiên lên thì chắc chắn là các anh nhỏ sẽ rất thích đó, món chiên là tụi nhỏ thích lắm luôn á cô.",
