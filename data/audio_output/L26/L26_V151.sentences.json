        "001461.webp",
        "001482.webp",
        "001504.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đối với tôm càng thì các bạn sẽ cắt cái phần càng, phần chân ra.",
      "start": 60.16,
      "end": 64.96,
