      "end_frame": 1438,
      "keyframes": [
        "001355.webp",
        "001415.webp",
        "001416.webp",
        "001438.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta sẽ làm món tôm càng đút lò.",
      "start": 57.52,
      "end": 60.16,
      "n_words": 9,
      "start_frame": 1438,
      "end_frame": 1504,
      "keyframes": [
        "001438.webp",
