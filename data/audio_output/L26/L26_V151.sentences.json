        "001250.webp",
        "001295.webp",
        "001296.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Thật ra thì bây giờ giá tôm càng và giá phô mai nó rất là phổ biến rồi.",
      "start": 53.28,
      "end": 57.52,
