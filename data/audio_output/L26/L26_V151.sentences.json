        "002393.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Sau khi tôm vừa chín tới thì Quốc Nghĩa sẽ vớt ra và ngâm qua một thau nước đá lạnh.",
      "start": 95.84,
