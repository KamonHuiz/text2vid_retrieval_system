        "003419.webp",
        "003468.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trong lúc Kim Thảo làm thì chúng ta sẽ bắt chảo lên bếp để mình thắng mỡ.",
      "start": 138.72,
      "end": 142.16,
      "n_words": 17,
