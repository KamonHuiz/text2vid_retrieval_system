        "002969.webp",
        "003007.webp",
        "003008.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thì sẽ là cân bằng được hàn nhiệt, rất là tinh tế đúng không ạ?",
      "start": 123.28,
      "end": 127.2,
      "n_words": 15,
      "start_frame": 3082,
      "end_frame": 3180,
      "keyframes": [
        "003092.webp",
        "003176.webp",
        "003177.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi bây giờ cái phần sốt như vậy được rồi đó, giờ cô sẽ tắt lửa nha. Dạ cô.",
      "start": 127.2,
      "end": 130.88,
      "n_words": 19,
      "start_frame": 3180,
      "end_frame": 3272,
      "keyframes": [
        "003218.webp",
        "003260.webp",
        "003261.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sẽ trút cái phần sốt ra nè, thơm quá luôn!",
