        "003304.webp",
        "003337.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Á cô Hà ơi, em cắt nhỏ phần hành lá đó để mình làm cái dầu hành.",
      "start": 133.76,
      "end": 138.72,
