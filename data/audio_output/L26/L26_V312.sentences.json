      "end": 24.72,
      "n_words": 10,
      "start_frame": 574,
      "end_frame": 618,
      "keyframes": [
        "000577.webp",
        "000578.webp",
        "000600.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Không thì thì tại vì người ta cần dùng chúc nhiều đúng không cô?",
