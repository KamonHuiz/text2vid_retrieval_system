      "keyframes": [
        "003211.webp",
        "003212.webp",
        "003241.webp",
        "003271.webp",
        "003272.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- Em nôn được ăn quá!",
      "start": 131.04,
      "end": 132.8,
      "n_words": 6,
      "start_frame": 3276,
      "end_frame": 3320,
      "keyframes": [
        "003295.webp",
        "003318.webp",
        "003319.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Bây giờ em cho cô cái túi bắt kem đi ha.",
