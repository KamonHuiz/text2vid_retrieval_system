        "002956.webp",
        "002957.webp",
        "002984.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Sẽ có một ít đường, bột ngọt Ajinomoto, hạt nêm Aji-ngon heo và một ít tiêu.",
      "start": 119.92,
      "end": 128.24,
      "n_words": 16,
      "start_frame": 2998,
      "end_frame": 3206,
      "keyframes": [
        "003011.webp",
