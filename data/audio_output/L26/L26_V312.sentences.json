        "000908.webp",
        "000963.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "- Á ghê không?",
      "start": 39.8,
      "end": 40.88,
      "n_words": 4,
      "start_frame": 995,
      "end_frame": 1022,
      "keyframes": [
        "001019.webp",
        "001020.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Quá ghê cô, bởi cho nên em phải đi An Giang, em phải khởi nghiệp.",
      "start": 40.88,
      "end": 45.2,
      "n_words": 16,
