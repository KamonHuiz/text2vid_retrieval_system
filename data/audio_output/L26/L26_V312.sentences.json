        "002430.webp",
        "002472.webp",
        "002473.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp theo mình sẽ cho giò sống vào đây, có thêm mỡ băm nè ha để cho cái phần ốc nó không bị khô quá.",
      "start": 99.0,
      "end": 105.08,
      "n_words": 25,
