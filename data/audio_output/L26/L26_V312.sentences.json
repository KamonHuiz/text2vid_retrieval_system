        "003174.webp",
        "003175.webp",
        "003193.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Và bây giờ thì chúng ta sẽ trộn đều cái hỗn hợp này lên.",
      "start": 128.24,
      "end": 131.04,
      "n_words": 14,
