      "end": 135.84,
      "n_words": 12,
      "start_frame": 3320,
      "end_frame": 3396,
      "keyframes": [
        "003350.webp",
        "003382.webp",
        "003383.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô nó có giống cái này không cô?",
