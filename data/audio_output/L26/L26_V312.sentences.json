        "003607.webp",
        "003608.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đây là cái phần ruột heo mà cô đã mua và làm sạch, cô sẽ rút một đầu lại.",
      "start": 144.56,
      "end": 149.0,
      "n_words": 19,
      "start_frame": 3614,
      "end_frame": 3725,
      "keyframes": [
        "003646.webp",
        "003685.webp",
        "003686.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ cắt khúc vừa vừa như thế này nè.",
