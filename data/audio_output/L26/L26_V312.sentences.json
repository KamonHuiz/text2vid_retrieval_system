        "000429.webp",
        "000447.webp",
        "000448.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ là người ta đua nhau trồng cây chúc thành công lắm luôn.",
      "start": 19.08,
      "end": 22.96,
      "n_words": 14,
      "start_frame": 477,
      "end_frame": 574,
      "keyframes": [
        "000498.webp",
        "000549.webp",
        "000550.webp",
        "000563.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "- Cô cho em biết làm sao họ thành công?",
