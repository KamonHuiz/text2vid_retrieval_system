      "n_words": 22,
      "start_frame": 1853,
      "end_frame": 2020,
      "keyframes": [
        "001931.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên mình sẽ cho thịt ốc đã sơ chế, đã băm vào đây.",
      "start": 80.8,
      "end": 84.72,
      "n_words": 14,
      "start_frame": 2020,
      "end_frame": 2118,
      "keyframes": [
        "002021.webp",
        "002022.webp",
        "002067.webp",
        "002113.webp",
        "002114.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ băm thịt ốc không quá nhuyễn nhé để khi ăn mình sẽ cảm nhận được hương vị và độ giòn của ốc.",
      "start": 84.72,
      "end": 92.2,
      "n_words": 30,
