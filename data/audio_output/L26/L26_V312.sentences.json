        "002243.webp",
        "002287.webp",
        "002288.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cho em hỏi riêng cái phần ốc này là mình dùng ốc gì cũng được?",
      "start": 92.2,
      "end": 95.0,
      "n_words": 15,
      "start_frame": 2305,
      "end_frame": 2375,
      "keyframes": [
        "002323.webp",
        "002359.webp",
        "002360.webp",
        "002373.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ngon nhất là mình sẽ sử dụng ốc bươu, còn nếu không thì mình cũng có thể sử dụng ốc vú sữa.",
      "start": 95.0,
      "end": 99.0,
