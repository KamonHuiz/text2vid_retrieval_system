      "end_frame": 2774,
      "keyframes": [
        "002648.webp",
        "002649.webp",
        "002694.webp",
        "002740.webp",
        "002741.webp",
        "002761.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các bạn nhúm lại giữ chặt, đúng rồi, cắt nhỏ rồi, đúng rồi, mình cắt nhuyễn thì nó bám vào trong cá được nhiều hơn.",
      "start": 110.96,
      "end": 120.04,
      "n_words": 25,
