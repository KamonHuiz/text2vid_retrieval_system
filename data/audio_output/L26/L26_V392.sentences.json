        "001818.webp",
        "001861.webp",
        "001862.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Dùng những cây tre đó, chúng ta xiên như vậy cho cá kèo thẳng đuột luôn.",
      "start": 74.64,
      "end": 79.24,
      "n_words": 16,
      "start_frame": 1866,
      "end_frame": 1981,
      "keyframes": [
        "001931.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Như vậy là hôm nay món là món chiên nhưng mà mình vẫn xiên que ha?",
      "start": 79.24,
      "end": 82.72,
      "n_words": 16,
      "start_frame": 1981,
      "end_frame": 2068,
      "keyframes": [
        "002001.webp",
        "002002.webp",
        "002010.webp",
        "002018.webp",
        "002019.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đúng rồi, mình xiên que như vậy thì khi mình thưởng thức á là nó sẽ hấp dẫn, nó ngon hơn và cái hình thức nó cũng đẹp hơn.",
      "start": 82.72,
