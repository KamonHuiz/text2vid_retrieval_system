      "end_frame": 1694,
      "keyframes": [
        "001609.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cá kèo chúng ta mua về, chúng ta xử lý làm cho sạch nhớt, cho tí xíu muối với lại chanh sát sạch là được.",
      "start": 67.76,
      "end": 74.64,
      "n_words": 25,
      "start_frame": 1694,
      "end_frame": 1866,
