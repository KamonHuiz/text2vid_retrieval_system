        "004566.webp",
        "004585.webp",
        "004586.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chiên như vậy thì cá kèo nó sẽ bề mặt sẽ cứng hơn.",
      "start": 183.52,
      "end": 188.96,
      "n_words": 13,
      "start_frame": 4588,
      "end_frame": 4724,
      "keyframes": [
        "004620.webp",
        "004655.webp",
        "004656.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Gần cái bề mặt rồi, các bạn nhớ chúng ta mới thả cá vô chúng ta khoan di chuyển cá nha.",
      "start": 188.96,
      "end": 195.92,
      "n_words": 21,
      "start_frame": 4724,
      "end_frame": 4898,
      "keyframes": [
        "004730.webp",
        "004804.webp",
        "004805.webp",
        "004850.webp",
        "004896.webp",
        "004897.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Anh nhờ em một nhiệm vụ được không?",
      "start": 195.92,
      "end": 197.32,
      "n_words": 8,
      "start_frame": 4898,
      "end_frame": 4933,
      "keyframes": [
        "004923.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ được chứ.",
