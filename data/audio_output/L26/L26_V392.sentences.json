        "002176.webp",
        "002218.webp",
        "002219.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nhưng mà anh biết không, lúc mà mình tuốt cái cây xiên ra nó bị dính vào thịt của cá.",
      "start": 88.96,
      "end": 94.24,
      "n_words": 20,
