        "000868.webp",
        "000912.webp",
        "000913.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nghe lạ không?",
      "start": 36.64,
      "end": 37.96,
      "n_words": 3,
      "start_frame": 916,
      "end_frame": 949,
      "keyframes": [
        "000926.webp",
        "000940.webp",
        "000941.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phụ bếp đã sẵn sàng rồi.",
      "start": 37.96,
