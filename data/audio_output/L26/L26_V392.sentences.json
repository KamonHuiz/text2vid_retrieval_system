      "end": 198.04,
      "n_words": 3,
      "start_frame": 4933,
      "end_frame": 4951,
      "keyframes": [
        "004949.webp",
        "004950.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Em đứng em canh anh chờ nha.",
      "start": 198.04,
      "end": 200.0,
      "n_words": 7,
      "start_frame": 4951,
      "end_frame": 5000,
      "keyframes": [
        "004979.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trong thời gian đó anh Vũ làm gì ạ?",
      "start": 200.36,
      "end": 202.2,
      "n_words": 9,
      "start_frame": 5009,
      "end_frame": 5055,
      "keyframes": [
        "005009.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trong thời gian đó tôi sẽ pha sốt chanh dây, vô cùng dễ.",
