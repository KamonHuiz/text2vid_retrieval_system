      "end_frame": 5418,
      "keyframes": [
        "005391.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nhưng mà ngày hôm nay em để ý là anh sẽ sử dụng cái độ chua từ chanh dây.",
      "start": 216.72,
      "end": 220.6,
