      "end_frame": 2648,
      "keyframes": [
        "002585.webp",
        "002604.webp",
        "002605.webp",
        "002626.webp",
        "002648.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Còn một nhúm rau răm thôi mà các bạn nhớ là phải để cho ráo nước.",
      "start": 105.92,
      "end": 110.96,
      "n_words": 16,
