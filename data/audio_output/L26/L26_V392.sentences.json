        "000986.webp",
        "000987.webp",
        "001011.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cá kèo chiên sốt chanh dây điểm 10 cho bữa tiệc vân vân.",
      "start": 41.36,
      "end": 61.2,
      "n_words": 13,
