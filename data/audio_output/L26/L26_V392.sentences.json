      "start_frame": 3200,
      "end_frame": 3344,
      "keyframes": [
        "003215.webp",
        "003249.webp",
        "003250.webp",
        "003297.webp",
        "003344.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta cần gia vị nêm sẵn Ajinomoto bột tẩm khô chiên giòn, chúng ta cho vào trong cái dĩa đó.",
      "start": 133.76,
