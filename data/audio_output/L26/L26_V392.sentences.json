        "000754.webp",
        "000788.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Món này bảo đảm là lạ luôn các bạn: cá kèo chiên với lại sốt chanh dây.",
      "start": 32.4,
      "end": 36.64,
