      "keyframes": [
        "002781.webp",
        "002782.webp",
        "002801.webp",
        "002821.webp",
        "002822.webp",
        "002906.webp",
        "002990.webp",
        "002991.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cho một cái dĩa rau răm thì phải có ớt, chúng ta cần ớt sừng, các bạn một trái thôi, chúng ta băm nhuyễn, chúng ta trộn vô.",
      "start": 120.04,
      "end": 128.0,
      "n_words": 28,
      "start_frame": 3001,
      "end_frame": 3200,
      "keyframes": [
        "003036.webp",
