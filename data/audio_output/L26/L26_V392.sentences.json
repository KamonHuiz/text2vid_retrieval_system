        "000675.webp",
        "000706.webp",
        "000707.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nhưng mà ngày hôm nay làm cái món gì mà phải có nước cốt chanh dây này hả anh?",
      "start": 28.28,
      "end": 32.4,
