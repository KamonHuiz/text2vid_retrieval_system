      ],
      "keyframe_count": 20
    },
    {
      "text": "Ngoài trừ cá hồi và tôm ra thì rất quan trọng trong đây là có cơm gạo Nhật nữa, và mình sẽ trộn chung với lại rong biển và một ít mè rang, và thêm một nguyên liệu mà rất là Việt Nam đó chính là thì là.",
      "start": 62.72,
      "end": 74.6,
      "n_words": 48,
      "start_frame": 1568,
      "end_frame": 1865,
      "keyframes": [
