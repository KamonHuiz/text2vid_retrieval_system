      "end_frame": 2078,
      "keyframes": [
        "002064.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và bây giờ chúng ta sẽ nhờ Minh Phương sơ chế cũng như là cắt cái phần củ sen này.",
