        "001587.webp",
        "001588.webp",
        "001613.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Việc đầu tiên Quốc Nghị sẽ hướng dẫn các bạn mài vỏ chanh vàng nè.",
      "start": 65.48,
      "end": 68.8,
