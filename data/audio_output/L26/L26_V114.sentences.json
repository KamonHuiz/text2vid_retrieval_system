        "001866.webp",
        "001938.webp",
        "001939.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Sau khi lấy được vỏ chanh vàng mài ra thì chúng ta đi sơ chế trái cây nha.",
      "start": 77.84,
      "end": 82.6,
