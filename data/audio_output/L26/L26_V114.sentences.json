        "001311.webp",
        "001312.webp",
        "001356.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tại Minh Phương đã thấy rất là nhiều các loại trái cây ở đây.",
      "start": 54.68,
      "end": 57.96,
      "n_words": 14,
