        "002432.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cho vào đây 100 g cream cheese nè, tiếp đến là 50 g dừa vụn và một ít cà phê vỏ chanh mài.",
      "start": 97.28,
      "end": 103.52,
