        "003543.webp",
        "003568.webp",
        "003569.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đối với món cà ri ngày hôm nay thì Phước Hưng cũng sẽ sử dụng lá cà ri tươi và bây giờ chúng ta sẽ cho lá cà ri vào chúng ta chiên.",
      "start": 142.84,
      "end": 151.0,
      "n_words": 33,
      "start_frame": 3571,
      "end_frame": 3775,
      "keyframes": [
        "003624.webp",
        "003679.webp",
        "003680.webp",
        "003739.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Quả thật là lá cà ri tươi khi mà được chiên lên á có một cái mùi thơm rất là dễ chịu và đặc trưng.",
      "start": 151.0,
      "end": 156.56,
      "n_words": 25,
      "start_frame": 3775,
      "end_frame": 3914,
      "keyframes": [
        "003799.webp",
