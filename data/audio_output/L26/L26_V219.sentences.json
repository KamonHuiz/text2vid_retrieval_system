        "002075.webp",
        "002093.webp",
        "002094.webp",
        "002114.webp",
        "002134.webp",
        "002135.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Sau khi mà các bạn chúng ta đã cho gia vị vào trong gà chúng ta ướp rồi thì chúng ta chỉ ướp khoảng từ 10 tới 15 phút thôi là gà đã được thấm.",
      "start": 86.72,
      "end": 94.04,
      "n_words": 35,
      "start_frame": 2168,
      "end_frame": 2351,
      "keyframes": [
        "002194.webp",
        "002254.webp",
        "002255.webp",
        "002272.webp",
        "002290.webp",
        "002291.webp",
        "002321.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Khoai lang thì chúng ta sẽ cắt khối khoảng 3 centimet và khi mà chúng ta cắt xong thì ngâm ngay qua bên cái nước muối loãng để cho khoai không bị thâm.",
      "start": 94.04,
      "end": 103.0,
      "n_words": 33,
      "start_frame": 2351,
      "end_frame": 2575,
      "keyframes": [
        "002352.webp",
        "002353.webp",
        "002416.webp",
        "002480.webp",
        "002481.webp",
        "002531.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi đối với phần sả củ thì chúng ta sẽ đập dập và cắt khúc vừa ăn.",
      "start": 103.0,
      "end": 110.8,
      "n_words": 17,
      "start_frame": 2575,
      "end_frame": 2770,
      "keyframes": [
        "002582.webp",
