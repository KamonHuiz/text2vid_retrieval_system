      "keyframes": [
        "004030.webp",
        "004031.webp",
        "004052.webp",
        "004074.webp",
        "004075.webp",
        "004109.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tiếp tục Phước Hưng sẽ cho phần hành tím băm vào và tỏi băm.",
      "start": 165.72,
      "end": 169.36,
      "n_words": 14,
      "start_frame": 4143,
      "end_frame": 4234,
      "keyframes": [
        "004144.webp",
        "004145.webp",
        "004174.webp",
        "004203.webp",
        "004204.webp",
        "004215.webp",
        "004226.webp",
        "004227.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "- Rất là nhiều gia vị đúng không nào? - Đúng rồi.",
      "start": 169.36,
      "end": 171.92,
      "n_words": 12,
      "start_frame": 4234,
      "end_frame": 4298,
      "keyframes": [
        "004263.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tiếp theo thì Phước Hưng cho phần ớt băm vào luôn.",
      "start": 171.92,
      "end": 174.48,
      "n_words": 11,
      "start_frame": 4298,
      "end_frame": 4362,
      "keyframes": [
        "004300.webp",
        "004301.webp",
        "004330.webp",
        "004359.webp",
        "004360.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phần sả củ cũng như là tỏi, hành tím, ớt đã dậy lên được mùi thơm rồi, cho phần gà vào chúng ta xào săn.",
      "start": 174.48,
      "end": 181.0,
      "n_words": 25,
      "start_frame": 4362,
      "end_frame": 4525,
      "keyframes": [
        "004413.webp",
        "004466.webp",
        "004467.webp",
        "004498.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và bây giờ tiếp theo Phước Hưng sẽ cho vào đây khoảng một muỗng canh bột cà ri giúp cho cái món cà ri có cái hương vị đặc trưng và có cái váng dầu rất là đẹp.",
      "start": 181.0,
      "end": 188.68,
      "n_words": 38,
      "start_frame": 4525,
      "end_frame": 4717,
      "keyframes": [
        "004529.webp",
        "004530.webp",
        "004556.webp",
        "004583.webp",
        "004584.webp",
        "004610.webp",
        "004637.webp",
        "004638.webp",
        "004692.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và đây cũng là một cái lưu ý cho các bạn nhé, chúng ta sẽ xào thịt gà trước giúp cho thịt gà săn chắc nè, khi ăn sẽ thơm ngon hơn.",
      "start": 188.68,
      "end": 195.24,
      "n_words": 32,
      "start_frame": 4717,
      "end_frame": 4881,
      "keyframes": [
        "004746.webp",
