        "002691.webp",
        "002713.webp",
        "002714.webp",
        "002724.webp",
        "002735.webp",
        "002736.webp",
        "002754.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Phần khoai sau khi cắt khúc và ngâm qua phần nước lọc có một chút muối thì bây giờ Minh Phương đã vớt ra để ráo nước.",
      "start": 110.8,
      "end": 117.52,
      "n_words": 27,
      "start_frame": 2770,
      "end_frame": 2938,
      "keyframes": [
        "002773.webp",
        "002774.webp",
        "002846.webp",
        "002918.webp",
        "002919.webp",
        "002931.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Nè ráo nước nè.",
      "start": 117.52,
      "end": 117.76,
      "n_words": 5,
      "start_frame": 2938,
      "end_frame": 2944,
      "keyframes": [
        "002943.webp",
        "002944.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ mình chiên đúng không?",
      "start": 117.76,
      "end": 118.88,
      "n_words": 6,
      "start_frame": 2944,
      "end_frame": 2972,
      "keyframes": [
        "002944.webp",
        "002964.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Đúng rồi.",
      "start": 118.88,
      "end": 119.44,
      "n_words": 3,
      "start_frame": 2972,
      "end_frame": 2986,
      "keyframes": [
        "002985.webp",
        "002986.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và đây cũng là một cái lưu ý khi mà quý vị chúng ta làm món ăn này nhé, chúng ta phải chiên khoai lang trước khi nấu giúp cho khoai lang không bị nát, khi ăn sẽ thơm ngon hơn.",
      "start": 119.44,
      "end": 128.56,
      "n_words": 41,
      "start_frame": 2986,
      "end_frame": 3214,
      "keyframes": [
        "002986.webp",
        "003028.webp",
        "003070.webp",
        "003071.webp",
        "003141.webp",
        "003211.webp",
        "003212.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Phước Hưng ơi, phần khoai đã vàng xém cái cạnh bên ngoài rồi, bây giờ mình vớt được chưa?",
      "start": 128.56,
      "end": 133.04,
      "n_words": 19,
      "start_frame": 3214,
      "end_frame": 3326,
      "keyframes": [
        "003280.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Được rồi đó Minh Phương.",
