        "000569.webp",
        "000570.webp",
        "000660.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Rất vui được gặp lại các bạn khán giả đang theo dõi chương trình Món ngon mỗi ngày, nấu chuẩn ăn lành. Chương trình được tài trợ bởi công ty Anoto Việt Nam.",
      "start": 29.88,
      "end": 39.12,
      "n_words": 33,
      "start_frame": 747,
      "end_frame": 978,
      "keyframes": [
        "000750.webp",
        "000751.webp",
        "000867.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Khi mà nhắc đến cà ri thì là một món ăn rất là quen thuộc rồi đúng không nào?",
      "start": 39.12,
      "end": 43.88,
      "n_words": 19,
      "start_frame": 978,
      "end_frame": 1097,
      "keyframes": [
        "000984.webp",
        "000985.webp",
        "001035.webp",
        "001085.webp",
        "001086.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đây là món ăn xuất xứ từ Ấn Độ.",
      "start": 43.88,
      "end": 46.04,
      "n_words": 9,
      "start_frame": 1097,
      "end_frame": 1151,
      "keyframes": [
        "001117.webp",
        "001148.webp",
        "001149.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chữ cà ri trong tiếng Tamil của Ấn Độ có nghĩa là nước sốt, và ở mỗi nơi thì họ sẽ biến tấu cái hương vị sốt cà ri này theo một cách khác nhau.",
      "start": 46.04,
      "end": 55.28,
      "n_words": 35,
      "start_frame": 1151,
      "end_frame": 1382,
      "keyframes": [
        "001205.webp",
        "001261.webp",
        "001262.webp",
        "001332.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ngày hôm nay thì chúng ta sẽ thực hiện món cà ri gà với cách hướng dẫn của đầu bếp Phước Hưng để xem có gì thú vị và đặc biệt nha.",
      "start": 55.28,
      "end": 61.36,
      "n_words": 32,
      "start_frame": 1382,
      "end_frame": 1534,
      "keyframes": [
        "001402.webp",
        "001403.webp",
        "001428.webp",
        "001454.webp",
        "001455.webp",
        "001517.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vậy thì bây giờ chúng ta hãy nấu liền đi mà để tiết kiệm thời gian hơn thì bây giờ Phương sẽ bật lên trên bếp một cái chảo dầu để chúng ta chiên khoai.",
      "start": 61.36,
      "end": 68.36,
      "n_words": 35,
      "start_frame": 1534,
      "end_frame": 1709,
      "keyframes": [
        "001580.webp",
        "001581.webp",
        "001645.webp",
        "001709.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và nguyên liệu chính trong món ăn ngày hôm nay đó chính là đùi gà.",
      "start": 68.36,
      "end": 71.24,
      "n_words": 15,
      "start_frame": 1709,
      "end_frame": 1781,
      "keyframes": [
        "001709.webp",
        "001710.webp",
        "001733.webp",
        "001757.webp",
        "001758.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phần đùi gà thì chúng ta rửa sạch và để ráo và chặt làm đôi thành từng miếng vừa ăn.",
      "start": 71.24,
      "end": 76.0,
      "n_words": 20,
      "start_frame": 1781,
      "end_frame": 1900,
      "keyframes": [
        "001802.webp",
        "001846.webp",
        "001847.webp",
        "001872.webp",
        "001898.webp",
        "001899.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phương sẽ cho vào đây hai muỗng cà phê hạt nêm Aji-goma gà, một muỗng cà phê đường, nửa muỗng cà phê muối, nửa muỗng cà phê tiêu, một muỗng cà phê bột cà ri, sẽ trộn đều gia vị lên.",
      "start": 76.0,
      "end": 86.72,
      "n_words": 41,
      "start_frame": 1900,
      "end_frame": 2168,
      "keyframes": [
        "001926.webp",
        "001954.webp",
        "001955.webp",
        "001970.webp",
        "001986.webp",
        "001987.webp",
        "002000.webp",
        "002014.webp",
        "002015.webp",
        "002035.webp",
