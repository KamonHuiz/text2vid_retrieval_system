        "005562.webp",
        "005593.webp",
        "005625.webp",
        "005626.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Và cuối cùng cho phần hành tây cắt múi cau vào nồi cà ri của chúng ta đã sôi trở lại rồi, bây giờ Phước Hưng sẽ tắt bếp.",
      "start": 225.08,
      "end": 231.56,
      "n_words": 29,
      "start_frame": 5627,
      "end_frame": 5789,
      "keyframes": [
        "005662.webp",
        "005698.webp",
        "005699.webp",
        "005761.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Vậy là hoàn tất rồi.",
      "start": 231.56,
      "end": 233.04,
      "n_words": 5,
      "start_frame": 5789,
      "end_frame": 5826,
      "keyframes": [
        "005823.webp",
        "005824.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Để nấu đúng chuẩn nè, để có được một cái thành phẩm một nồi cà ri thơm ngon như thế này thì hãy nhớ những lưu ý từ đầu bếp Phước Hưng các bạn nha.",
      "start": 233.0,
      "end": 240.4,
