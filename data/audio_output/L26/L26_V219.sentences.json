        "003856.webp",
        "003913.webp",
        "003914.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ là cái lá cà ri đã trong lại và chuyển màu rồi, Hưng sẽ vớt lá cà ri ra.",
      "start": 156.56,
      "end": 161.2,
