      "end": 134.96,
      "n_words": 6,
      "start_frame": 3326,
      "end_frame": 3374,
      "keyframes": [
        "003349.webp",
        "003350.webp",
        "003368.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi và bây giờ tiếp theo Phước Hưng sẽ đặt lên trên bếp một cái nồi để chúng ta nấu cà ri, cho vào đây khoảng hai muỗng canh dầu ăn.",
      "start": 134.96,
      "end": 142.84,
      "n_words": 31,
      "start_frame": 3374,
      "end_frame": 3571,
      "keyframes": [
        "003387.webp",
