      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ngày mới với cà ri gà.",
      "start": 13.28,
      "end": 29.88,
      "n_words": 6,
      "start_frame": 332,
      "end_frame": 747,
      "keyframes": [
        "000338.webp",
