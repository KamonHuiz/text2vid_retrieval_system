        "001632.webp",
        "001663.webp",
        "001664.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và bây giờ chúng ta sẽ cắt lát ra rồi chúng ta mới cắt sợi lại.",
      "start": 66.96,
