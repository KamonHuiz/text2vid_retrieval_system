        "003298.webp",
        "003299.webp",
        "003366.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Đúng rồi.",
      "start": 136.88,
      "end": 137.64,
      "n_words": 2,
      "start_frame": 3422,
      "end_frame": 3441,
      "keyframes": [
        "003433.webp",
        "003434.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Tắt lửa, cho cá ngừ vào, cho vào đây nửa muỗng cà phê hạt nêm Aji-ngon heo, một phần ba muỗng cà phê bột ngọt Ajinomoto.",
      "start": 137.64,
      "end": 146.88,
      "n_words": 26,
      "start_frame": 3441,
