        "002587.webp",
        "002588.webp",
        "002611.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Thì em thấy có hành tây nè, có ớt chuông đỏ và xanh.",
      "start": 105.36,
      "end": 109.2,
      "n_words": 13,
      "start_frame": 2634,
      "end_frame": 2730,
      "keyframes": [
        "002635.webp",
