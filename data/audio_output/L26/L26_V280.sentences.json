        "005444.webp",
        "005445.webp",
        "005489.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đẹp quá!",
      "start": 220.72,
      "end": 221.6,
      "n_words": 2,
      "start_frame": 5518,
      "end_frame": 5540,
      "keyframes": [
        "005534.webp",
        "005535.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi xong chúng ta có ngay cái cuộn thứ hai.",
