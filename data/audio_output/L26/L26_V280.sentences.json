      "end": 197.0,
      "n_words": 14,
      "start_frame": 4838,
      "end_frame": 4925,
      "keyframes": [
        "004843.webp",
        "004844.webp",
        "004871.webp",
        "004898.webp",
        "004899.webp",
        "004923.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng vậy, rồi chúng ta cuộn ra vậy.",
