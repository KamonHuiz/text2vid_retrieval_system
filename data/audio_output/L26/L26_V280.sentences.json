        "002668.webp",
        "002700.webp",
        "002701.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Em thấy cái phần nhân hơi giống món trứng ốp lết phải không anh? Đúng vậy.",
      "start": 109.2,
      "end": 112.72,
      "n_words": 16,
      "start_frame": 2730,
      "end_frame": 2818,
      "keyframes": [
        "002762.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mà một nguyên liệu nữa để tạo cái protein trong cái món trứng đó là cá ngừ ngâm dầu.",
      "start": 112.72,
      "end": 117.16,
      "n_words": 19,
      "start_frame": 2818,
      "end_frame": 2929,
      "keyframes": [
        "002824.webp",
        "002825.webp",
        "002889.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cá ngừ ngâm dầu chúng ta bỏ cái dầu ngâm trong cá ngừ rồi chúng ta cho vô cái chén, chúng ta tán cho thật nhuyễn luôn nha các bạn.",
      "start": 117.16,
