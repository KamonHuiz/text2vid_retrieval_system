        "001805.webp",
        "001806.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Như vậy thì trứng gà ta với trứng gà công nghiệp nó có khác nhau khi mà chúng ta chiên không anh?",
      "start": 72.24,
