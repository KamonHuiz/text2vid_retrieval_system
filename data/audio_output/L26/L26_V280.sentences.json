        "003893.webp",
        "003938.webp",
        "003939.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi đây là cái chảo chiên trứng kiểu Nhật, nó có cái thành nó cao hơn các bạn ha.",
      "start": 157.64,
      "end": 162.28,
      "n_words": 19,
