        "003035.webp",
        "003058.webp",
        "003081.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Bây giờ chúng ta sẽ bắt đầu đem một cái chảo, chúng ta xào nhân trước nha.",
      "start": 123.24,
      "end": 126.72,
      "n_words": 17,
      "start_frame": 3081,
      "end_frame": 3168,
      "keyframes": [
        "003081.webp",
        "003082.webp",
        "003125.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho vào đây ít dầu, cho các loại rau này vào xào cho nhanh nó bớt hăng, chứ thường là người Nhật người ta làm người ta cũng bỏ trực tiếp vô trong trứng luôn.",
      "start": 126.72,
      "end": 136.88,
      "n_words": 35,
      "start_frame": 3168,
