        "004220.webp",
        "004271.webp",
        "004272.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Một vá trứng có nhân vào trước, chúng ta cuộn lớp trước.",
      "start": 171.04,
      "end": 177.52,
      "n_words": 12,
      "start_frame": 4276,
      "end_frame": 4438,
      "keyframes": [
        "004305.webp",
