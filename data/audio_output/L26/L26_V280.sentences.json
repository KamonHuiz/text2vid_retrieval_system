        "004362.webp",
        "004384.webp",
        "004385.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các bạn mặt trứng se lại thì chúng ta bắt đầu cuộn đúng không anh?",
      "start": 177.52,
      "end": 180.68,
      "n_words": 15,
      "start_frame": 4438,
      "end_frame": 4517,
      "keyframes": [
        "004443.webp",
        "004501.webp",
        "004502.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tại vì nếu mà chúng ta để cho nó chín quá thì lát nữa nó sẽ không có sự kết dính ở phía trong.",
      "start": 180.68,
      "end": 185.44,
      "n_words": 24,
      "start_frame": 4517,
      "end_frame": 4636,
      "keyframes": [
        "004527.webp",
        "004552.webp",
        "004553.webp",
        "004608.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "À dạ, đối với món trứng này chúng ta canh lửa là cực kỳ là quan trọng.",
      "start": 185.44,
      "end": 189.08,
      "n_words": 17,
      "start_frame": 4636,
      "end_frame": 4727,
      "keyframes": [
        "004664.webp",
        "004665.webp",
        "004693.webp",
        "004721.webp",
        "004722.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Các bạn để lửa nóng vừa thôi, trứng vừa tráng chúng ta cuộn liền.",
      "start": 189.08,
      "end": 193.52,
