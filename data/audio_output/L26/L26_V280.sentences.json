        "003799.webp",
        "003800.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ phần nhân này đã nguội rồi ta sẽ cho vào trong một tô ha, tô trứng bên đây.",
      "start": 152.4,
      "end": 157.64,
