      "start_frame": 4727,
      "end_frame": 4838,
      "keyframes": [
        "004747.webp",
        "004773.webp",
        "004774.webp",
        "004795.webp",
        "004816.webp",
        "004817.webp",
        "004830.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bây giờ thì đến hai cái lớp trứng không có nhân các bạn nha.",
