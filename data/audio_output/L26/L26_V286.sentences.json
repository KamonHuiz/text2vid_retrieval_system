      "keyframes": [
        "001709.webp",
        "001710.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 71.36,
      "end": 75.68,
      "n_words": 11,
      "start_frame": 1784,
      "end_frame": 1892,
      "keyframes": [
        "001799.webp",
        "001889.webp",
        "001890.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ Long sẽ cắt phần đậu hũ.",
