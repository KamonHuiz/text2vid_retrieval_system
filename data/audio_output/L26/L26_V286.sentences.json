      "end_frame": 1138,
      "keyframes": [
        "000988.webp",
        "001078.webp",
        "001079.webp",
        "001102.webp",
        "001126.webp",
        "001127.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Oh vậy thì mình làm ngay nha.",
