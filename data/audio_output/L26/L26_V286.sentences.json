        "004743.webp",
        "004744.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Cho cái phần nước bột năng pha loãng này vào, độ sánh sệt của mình nó tương đối thì bây giờ Long sẽ cho cái phần đậu hũ vào.",
      "start": 190.0,
      "end": 196.16,
      "n_words": 29,
      "start_frame": 4750,
      "end_frame": 4904,
      "keyframes": [
        "004792.webp",
