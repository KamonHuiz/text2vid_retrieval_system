        "000756.webp",
        "000779.webp",
        "000802.webp",
        "000803.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Món đó ai cũng biết, rất là ngon, rất là béo, rất là hấp dẫn.",
      "start": 32.24,
      "end": 36.0,
      "n_words": 15,
