        "001543.webp",
        "001544.webp",
        "001626.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Mến chào quý khán giả đã quay trở lại với chương trình Món ngon mỗi ngày.",
      "start": 68.24,
      "end": 71.36,
