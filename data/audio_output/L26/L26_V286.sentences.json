      "end": 90.64,
      "n_words": 10,
      "start_frame": 2193,
      "end_frame": 2266,
      "keyframes": [
        "002224.webp",
        "002260.webp",
        "002261.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chuyển hết cái phần này qua đây gọn gàng.",
