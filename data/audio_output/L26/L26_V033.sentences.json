        "004879.webp",
        "004915.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chảo sau khi dầu màu điều nóng á, các bạn sẽ cho vào đây nửa muỗng canh tỏi băm.",
      "start": 196.64,
      "end": 201.36,
      "n_words": 19,
      "start_frame": 4916,
      "end_frame": 5034,
      "keyframes": [
        "004952.webp",
