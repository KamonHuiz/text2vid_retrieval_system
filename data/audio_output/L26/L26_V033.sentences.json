        "004769.webp",
        "004806.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các bạn làm nóng chảo, sau đó cho một muỗng canh dầu màu điều.",
      "start": 193.52,
      "end": 196.64,
      "n_words": 14,
      "start_frame": 4838,
