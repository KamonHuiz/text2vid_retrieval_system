  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.48,
      "end": 12.12,
      "n_words": 4,
      "start_frame": 262,
      "end_frame": 303,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mề gà được tạo hình hoa khế đẹp mắt, vị chua ngọt, cay cay hài hòa, giòn sần sật, thêm chút màu sắc từ hành lá và ớt sừng, cuối tuần lai rai là chuẩn bài.",
      "start": 12.12,
      "end": 39.6,
      "n_words": 36,
      "start_frame": 303,
      "end_frame": 990,
      "keyframes": [
        "000315.webp",
        "000331.webp",
        "000332.webp",
        "000349.webp",
        "000367.webp",
        "000368.webp",
        "000407.webp",
        "000446.webp",
        "000447.webp",
        "000477.webp",
        "000508.webp",
        "000523.webp",
        "000551.webp",
        "000579.webp",
        "000580.webp",
        "000616.webp",
        "000653.webp",
