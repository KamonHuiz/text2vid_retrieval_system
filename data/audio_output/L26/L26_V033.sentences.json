        "004615.webp",
        "004616.webp",
        "004666.webp",
        "004717.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Và bây giờ chúng ta sẽ khuấy đều cái sốt này nè.",
      "start": 188.68,
      "end": 193.52,
      "n_words": 12,
      "start_frame": 4717,
      "end_frame": 4838,
