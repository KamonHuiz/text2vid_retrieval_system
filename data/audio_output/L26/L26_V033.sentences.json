      "end": 231.84,
      "n_words": 8,
      "start_frame": 5712,
      "end_frame": 5796,
      "keyframes": [
        "005795.webp",
        "005796.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Sau khi xào xong, các bạn sẽ cho hết cái phần nước sốt vào nè, cho vào đây một chén nước.",
      "start": 231.84,
      "end": 238.72,
      "n_words": 21,
      "start_frame": 5796,
      "end_frame": 5968,
      "keyframes": [
        "005796.webp",
        "005841.webp",
        "005887.webp",
        "005888.webp",
        "005929.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ xào khoảng 5 phút.",
      "start": 238.72,
      "end": 242.44,
      "n_words": 7,
      "start_frame": 5968,
      "end_frame": 6061,
      "keyframes": [
        "005971.webp",
        "005972.webp",
        "006000.webp",
        "006029.webp",
        "006030.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sau khi xào mề gà với sốt xào cay thì các bạn sẽ cho hành lá và ớt sừng đỏ vào nè, trộn đều là xong vì hành với ớt rất là dễ chín.",
      "start": 242.44,
      "end": 252.88,
      "n_words": 34,
      "start_frame": 6061,
      "end_frame": 6322,
      "keyframes": [
        "006068.webp",
        "006107.webp",
        "006108.webp",
        "006157.webp",
        "006207.webp",
        "006208.webp",
        "006237.webp",
        "006267.webp",
        "006268.webp",
        "006312.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Như vậy là món mề gà xào cay chúng ta đã hoàn thành xong rồi trong tích tắc thôi đúng không nào?",
      "start": 252.88,
