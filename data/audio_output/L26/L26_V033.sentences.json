        "004367.webp",
        "004368.webp",
        "004391.webp",
        "004415.webp",
        "004416.webp",
        "004447.webp"
      ],
      "keyframe_count": 22
    },
    {
      "text": "Nước tương của nó thơm lắm Phương và cái màu sắc cũng đẹp hơn nữa.",
      "start": 178.96,
      "end": 182.44,
      "n_words": 15,
      "start_frame": 4474,
      "end_frame": 4561,
      "keyframes": [
        "004479.webp",
        "004480.webp",
        "004524.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, và cuối cùng là một muỗng canh giấm gạo lên men Ajinomoto, nó có vị chua nhẹ trong cái sốt này.",
      "start": 182.44,
      "end": 188.68,
      "n_words": 23,
      "start_frame": 4561,
      "end_frame": 4717,
      "keyframes": [
        "004569.webp",
