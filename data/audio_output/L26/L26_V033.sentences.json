        "000826.webp",
        "000934.webp",
        "000935.webp",
        "000965.webp"
      ],
      "keyframe_count": 25
    },
    {
      "text": "Rất vui khi được gặp lại các bạn khán giả đang theo dõi chương trình Món ngon mỗi ngày, nấu chuẩn ăn lành.",
      "start": 39.6,
      "end": 44.96,
      "n_words": 23,
      "start_frame": 990,
      "end_frame": 1124,
      "keyframes": [
        "000996.webp",
        "000997.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam. Rồi cuối tuần rồi thì có một gợi ý món ngon nào cho Minh Phương không?",
      "start": 44.96,
      "end": 53.36,
      "n_words": 27,
      "start_frame": 1124,
      "end_frame": 1334,
      "keyframes": [
        "001179.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chắc chắn là có rồi.",
      "start": 53.36,
      "end": 54.52,
      "n_words": 5,
      "start_frame": 1334,
      "end_frame": 1363,
      "keyframes": [
        "001362.webp",
        "001363.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cuối tuần lai rai thì Quốc Nghị sẽ hướng dẫn Minh Phương cùng các bạn khán giả thực hiện món mề gà xào cay nha.",
      "start": 54.52,
      "end": 60.76,
      "n_words": 25,
      "start_frame": 1363,
      "end_frame": 1519,
      "keyframes": [
        "001363.webp",
        "001390.webp",
        "001417.webp",
        "001418.webp",
        "001504.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và theo chuyên gia dinh dưỡng Tiến sĩ Đào Thị Yến Phi thì món ăn này giúp hỗ trợ cho thận khỏe luôn đó nha.",
      "start": 60.76,
      "end": 66.96,
      "n_words": 25,
      "start_frame": 1519,
      "end_frame": 1674,
      "keyframes": [
        "001590.webp",
        "001591.webp",
        "001627.webp",
        "001663.webp",
        "001664.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nghe hấp dẫn quá, thôi bây giờ mình bắt tay làm liền đi.",
      "start": 66.96,
      "end": 69.56,
      "n_words": 13,
      "start_frame": 1674,
      "end_frame": 1739,
      "keyframes": [
        "001708.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Sẵn sàng nguyên liệu chính trong món ăn ngày hôm nay đó là mề gà, thì các bạn mua về nè, rửa sạch với nước muối giấm đi, và chút nữa Quốc Nghị sẽ hướng dẫn các bạn sơ chế mề gà.",
      "start": 69.56,
      "end": 78.32,
      "n_words": 42,
      "start_frame": 1739,
      "end_frame": 1958,
      "keyframes": [
        "001753.webp",
        "001754.webp",
        "001784.webp",
        "001815.webp",
        "001816.webp",
        "001887.webp",
        "001958.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Các bạn có thể sử dụng nguyên bộ lòng gà nếu mà các bạn không mua được mề gà nha.",
      "start": 78.32,
      "end": 82.28,
      "n_words": 20,
      "start_frame": 1958,
      "end_frame": 2057,
      "keyframes": [
        "001958.webp",
        "001959.webp",
        "002006.webp",
        "002054.webp",
        "002055.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Gừng cũ thì các bạn sẽ cắt lát, về phần hành lá thì các bạn cắt khúc khoảng 3 cm, ớt các bạn cắt lát xéo.",
      "start": 82.28,
      "end": 96.72,
      "n_words": 26,
      "start_frame": 2057,
      "end_frame": 2418,
      "keyframes": [
        "002088.webp",
        "002122.webp",
        "002123.webp",
        "002177.webp",
        "002232.webp",
        "002233.webp",
        "002255.webp",
        "002278.webp",
        "002279.webp",
        "002350.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Bây giờ chúng ta sẽ đi trần mề gà qua nước rượu gừng.",
      "start": 96.72,
      "end": 100.48,
      "n_words": 13,
      "start_frame": 2418,
      "end_frame": 2512,
      "keyframes": [
        "002422.webp",
        "002423.webp",
        "002465.webp",
        "002508.webp",
        "002509.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Các bạn cho vào nước sôi vài lát gừng và một ít rượu trắng.",
      "start": 100.48,
      "end": 105.16,
      "n_words": 14,
      "start_frame": 2512,
      "end_frame": 2629,
      "keyframes": [
        "002538.webp",
        "002567.webp",
        "002568.webp",
        "002604.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cái việc trần mề gà qua nước có rượu gừng giúp khử mùi tanh trong mề gà.",
      "start": 105.16,
      "end": 109.52,
      "n_words": 17,
      "start_frame": 2629,
      "end_frame": 2738,
      "keyframes": [
        "002640.webp",
        "002641.webp",
        "002688.webp",
        "002736.webp",
        "002737.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trong mề gà thì có rất là nhiều chất natri và kali, những cái khoáng chất này thì rất là tốt cho hoạt động của thận, chính vì thế mà trong bữa ăn hàng ngày mình có thể bổ sung những món ăn để giúp cho hoạt động của thận khỏe hơn đó.",
      "start": 109.52,
      "end": 122.12,
      "n_words": 53,
      "start_frame": 2738,
      "end_frame": 3053,
      "keyframes": [
        "002808.webp",
        "002880.webp",
        "002881.webp",
        "002964.webp",
        "003047.webp",
        "003048.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ chúng ta sẽ vớt mề gà nè, các bạn ngâm qua một pha nước lạnh.",
      "start": 122.12,
      "end": 126.88,
      "n_words": 17,
      "start_frame": 3053,
      "end_frame": 3172,
      "keyframes": [
        "003079.webp",
        "003110.webp",
        "003111.webp",
        "003152.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tiếp theo chúng ta sẽ khứa mề gà thành hình hoa khế.",
      "start": 126.88,
      "end": 130.36,
      "n_words": 12,
      "start_frame": 3172,
      "end_frame": 3259,
      "keyframes": [
        "003193.webp",
        "003194.webp",
        "003226.webp",
        "003259.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cái mề gà nè mình sẽ khứa lắc ngang như thế này mỏng, sau khi khứa dọc thì các bạn tiếp tục khứa ngang nè, cắt lát nè.",
      "start": 130.36,
      "end": 140.68,
      "n_words": 28,
      "start_frame": 3259,
      "end_frame": 3517,
      "keyframes": [
        "003259.webp",
        "003260.webp",
        "003312.webp",
        "003364.webp",
        "003365.webp",
        "003448.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta nên khứa mề gà thành hoa khế để khi xào thấm vị sốt hơn.",
      "start": 140.68,
      "end": 144.6,
      "n_words": 16,
      "start_frame": 3517,
      "end_frame": 3615,
      "keyframes": [
        "003531.webp",
        "003532.webp",
        "003573.webp",
        "003615.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thú thiệt với anh Nghị nha, ở nhà mà làm những món về mề gà Minh Phương không có cái bước này đâu, nhưng mà quả thật là thêm một cái thao tác tạo hình như thế này thôi, lát nữa khi mà chúng ta nấu và xào cái phần mề gà xong thì những cánh hoa sẽ xòe ra và có cái hình dáng rất là đẹp mắt.",
      "start": 144.6,
      "end": 161.44,
      "n_words": 69,
      "start_frame": 3615,
      "end_frame": 4036,
      "keyframes": [
        "003615.webp",
        "003616.webp",
        "003823.webp",
        "004030.webp",
        "004031.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Xong cái phần mề gà, để pha cái sốt xào cay xào cùng mề gà thì các bạn sẽ cho vào đây một phần ba muỗng cà phê tiêu, một muỗng cà phê ớt bột, hai muỗng cà phê đường cát, một muỗng canh tương ớt, hai muỗng canh dầu hào, hai muỗng canh nước tương Phú Sĩ.",
      "start": 161.44,
      "end": 178.8,
      "n_words": 58,
      "start_frame": 4036,
      "end_frame": 4470,
      "keyframes": [
        "004053.webp",
        "004075.webp",
        "004076.webp",
        "004125.webp",
        "004175.webp",
        "004176.webp",
        "004195.webp",
        "004214.webp",
        "004215.webp",
        "004232.webp",
        "004249.webp",
        "004250.webp",
        "004286.webp",
        "004323.webp",
