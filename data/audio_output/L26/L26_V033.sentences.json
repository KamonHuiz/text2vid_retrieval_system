        "004982.webp",
        "004983.webp",
        "005008.webp",
        "005034.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chúng ta sẽ phi thơm tỏi.",
      "start": 201.36,
      "end": 205.6,
      "n_words": 6,
      "start_frame": 5034,
      "end_frame": 5140,
      "keyframes": [
        "005034.webp",
        "005035.webp",
        "005052.webp",
        "005069.webp",
        "005070.webp",
        "005107.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Món xào mà cho nên là không thể thiếu được cái giai đoạn mà mình phi dầu nè, mình phi tỏi và cái mùi thơm nó thoát lên đúng không ạ, rất là hấp dẫn.",
      "start": 205.92,
      "end": 214.56,
      "n_words": 35,
      "start_frame": 5148,
      "end_frame": 5364,
      "keyframes": [
        "005238.webp",
        "005330.webp",
        "005331.webp",
        "005351.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tỏi dậy mùi thơm á, các bạn sẽ cho mề gà vào nè.",
      "start": 214.56,
      "end": 217.44,
      "n_words": 13,
      "start_frame": 5364,
      "end_frame": 5436,
      "keyframes": [
        "005372.webp",
        "005423.webp",
        "005425.webp",
        "005428.webp",
        "005429.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hấp dẫn chưa Minh Phương?",
      "start": 217.44,
      "end": 218.92,
      "n_words": 5,
      "start_frame": 5436,
      "end_frame": 5473,
      "keyframes": [
        "005441.webp",
        "005454.webp",
        "005455.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đang đợi là những cái cánh hoa khế nó sẽ nở như thế nào, được áo thêm một cái lớp dầu màu điều ở ngoài nữa cho nên rất là đẹp mắt.",
      "start": 218.92,
      "end": 228.48,
      "n_words": 32,
      "start_frame": 5473,
      "end_frame": 5712,
      "keyframes": [
        "005478.webp",
        "005502.webp",
        "005503.webp",
        "005649.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Anh Nghị ha, mình sẽ đảo đều nè.",
