        "002676.webp",
        "002677.webp",
        "002756.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bây giờ chúng ta sẽ tiến hành kho thịt vịt này thôi.",
      "start": 111.56,
      "end": 116.0,
      "n_words": 12,
      "start_frame": 2789,
      "end_frame": 2900,
      "keyframes": [
        "002835.webp",
