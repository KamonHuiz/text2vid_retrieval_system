        "005285.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta để đây ít hành lá, thế là chúng ta đã hoàn thành xong món vịt kho riềng ớt khô.",
      "start": 212.16,
      "end": 225.04,
