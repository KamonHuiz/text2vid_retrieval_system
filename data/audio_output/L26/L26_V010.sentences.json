      "end_frame": 1234,
      "keyframes": [
        "001064.webp",
        "001101.webp",
        "001102.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam. Em chào anh Vũ!",
      "start": 49.36,
      "end": 54.64,
      "n_words": 15,
      "start_frame": 1234,
      "end_frame": 1366,
      "keyframes": [
        "001243.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em chào Kim Thảo.",
      "start": 54.64,
      "end": 55.36,
      "n_words": 4,
      "start_frame": 1366,
      "end_frame": 1384,
      "keyframes": [
        "001384.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Anh Vũ ơi, lâu quá em không được ăn vịt kho, hôm nay mình làm được không anh?",
      "start": 55.36,
      "end": 59.24,
      "n_words": 18,
      "start_frame": 1384,
      "end_frame": 1481,
      "keyframes": [
        "001384.webp",
        "001385.webp",
        "001429.webp",
        "001473.webp",
        "001474.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Vâng, thưa các bạn, món ngày hôm nay có tên gọi là Vịt kho riềng ớt khô.",
      "start": 59.24,
      "end": 62.76,
      "n_words": 17,
      "start_frame": 1481,
      "end_frame": 1569,
      "keyframes": [
        "001520.webp",
        "001566.webp",
        "001567.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và theo các chuyên gia dinh dưỡng thì một điều đặc biệt nữa, món này sẽ hỗ trợ cho việc bổ máu rất là nhiều nha các bạn.",
      "start": 62.76,
      "end": 68.64,
      "n_words": 28,
      "start_frame": 1569,
      "end_frame": 1716,
      "keyframes": [
        "001641.webp",
        "001715.webp",
        "001716.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì thịt vịt chúng ta mua về chúng ta rửa sạch, một tí gừng giã nhuyễn cùng với lại rượu trắng.",
      "start": 68.64,
      "end": 75.2,
      "n_words": 21,
      "start_frame": 1716,
      "end_frame": 1880,
      "keyframes": [
        "001716.webp",
        "001750.webp",
        "001785.webp",
        "001786.webp",
        "001831.webp",
        "001877.webp",
        "001878.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Phần da vịt để cho vịt chúng ta được thơm hơn, khử được mùi tanh cũng như mùi hôi của phần da vịt nha các bạn.",
      "start": 75.2,
      "end": 80.04,
      "n_words": 26,
      "start_frame": 1880,
      "end_frame": 2001,
      "keyframes": [
        "001939.webp",
        "002000.webp",
        "002001.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ thì chúng ta sẽ ướp cái phần thịt vịt này: một muỗng cà phê bột ngọt Ajinomoto, một muỗng canh hạt nêm Ajinomoto, ba muỗng canh nước mắm.",
      "start": 80.04,
      "end": 93.72,
      "n_words": 30,
      "start_frame": 2001,
      "end_frame": 2343,
      "keyframes": [
        "002001.webp",
        "002062.webp",
        "002123.webp",
