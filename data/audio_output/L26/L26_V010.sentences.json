        "003871.webp",
        "003907.webp",
        "003908.webp",
        "003949.webp",
        "003991.webp",
        "003992.webp",
        "004016.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Kim Thảo thích nhất là trong các món kho chúng ta sử dụng nước dừa tại vì nó sẽ làm cho thịt ngọt hơn và khi ăn cảm nhận như là nó có một cái mùi hương gì đó mà rất là quyến rũ vậy đó anh Vũ.",
      "start": 161.6,
      "end": 172.64,
      "n_words": 48,
      "start_frame": 4040,
      "end_frame": 4316,
      "keyframes": [
        "004040.webp",
