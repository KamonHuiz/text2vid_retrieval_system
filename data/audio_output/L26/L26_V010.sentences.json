        "004217.webp",
        "004313.webp",
        "004314.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta sẽ cho vào đây khoảng ba muỗng canh nước cốt me các bạn nha.",
      "start": 172.64,
      "end": 176.4,
      "n_words": 16,
      "start_frame": 4316,
      "end_frame": 4410,
      "keyframes": [
        "004363.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cho nước cốt me vào trong món kho này để tạo vị chua nhẹ cũng như làm cho thịt vịt mau mềm, thì vịt chúng ta sẽ săn chắc và giữ được độ giòn nha các bạn.",
      "start": 176.4,
      "end": 184.56,
      "n_words": 37,
      "start_frame": 4410,
      "end_frame": 4614,
      "keyframes": [
        "004412.webp",
        "004413.webp",
        "004511.webp",
        "004610.webp",
        "004611.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Khi nước kho vừa sôi lên vậy chúng ta hạ lửa xuống, chúng ta kho rim từ từ khoảng độ chừng 30-40 phút là thịt vịt đã thấm và mềm.",
      "start": 184.56,
      "end": 194.08,
      "n_words": 30,
      "start_frame": 4614,
      "end_frame": 4852,
      "keyframes": [
        "004644.webp",
