        "002868.webp",
        "002900.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Dầu đã nóng rồi, các bạn chúng ta sẽ cho riềng vào, chúng ta sẽ cho hành băm nè, tỏi băm nè.",
      "start": 116.0,
      "end": 121.52,
      "n_words": 22,
      "start_frame": 2900,
      "end_frame": 3038,
      "keyframes": [
        "002900.webp",
