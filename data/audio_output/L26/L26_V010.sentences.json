        "003003.webp",
        "003004.webp",
        "003021.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta chỉ cần dùng riềng và ớt khô, nhớ là ớt khô nha các bạn để chúng ta tạo cái mùi vị đặc trưng cho món ăn này.",
      "start": 121.52,
      "end": 128.28,
      "n_words": 29,
      "start_frame": 3038,
      "end_frame": 3207,
      "keyframes": [
        "003039.webp",
        "003040.webp",
        "003120.webp",
        "003201.webp",
        "003202.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ cho thịt vịt vào xào.",
      "start": 128.28,
      "end": 130.56,
      "n_words": 8,
      "start_frame": 3207,
      "end_frame": 3264,
      "keyframes": [
        "003246.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chảo đang rất là thơm cho nên là khi cho thịt vịt vào thì thịt vịt cũng sẽ được áo hết tất cả những cái nguyên liệu mà tạo mùi thơm như thế này.",
      "start": 131.48,
      "end": 139.8,
      "n_words": 34,
      "start_frame": 3287,
      "end_frame": 3495,
      "keyframes": [
        "003290.webp",
