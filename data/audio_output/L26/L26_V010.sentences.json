        "003702.webp",
        "003703.webp",
        "003768.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sau khi chúng ta xào cho thịt vịt được săn, chúng ta cho nước dừa vào, thêm xíu nước nữa.",
      "start": 153.12,
      "end": 160.92,
      "n_words": 20,
      "start_frame": 3828,
      "end_frame": 4023,
      "keyframes": [
        "003834.webp",
