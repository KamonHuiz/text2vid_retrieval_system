        "000457.webp",
        "000498.webp",
        "000499.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cô Hà có cao kiến gì không cô?",
      "start": 20.52,
      "end": 22.12,
      "n_words": 8,
      "start_frame": 513,
      "end_frame": 553,
      "keyframes": [
        "000525.webp",
        "000552.webp",
        "000553.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Em có yêu cầu gì đặc biệt hơn?",
