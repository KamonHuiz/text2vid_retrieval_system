        "000996.webp",
        "001013.webp",
        "001030.webp",
        "001031.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Wow, có rau củ quả là em chịu liền đó cô!",
      "start": 41.36,
      "end": 45.8,
      "n_words": 11,
      "start_frame": 1034,
