      "keyframes": [
        "002613.webp",
        "002688.webp",
        "002689.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi xong rồi cô ơi! Cô cảm ơn Thanh Phương.",
      "start": 107.68,
      "end": 110.32,
      "n_words": 10,
      "start_frame": 2692,
      "end_frame": 2758,
      "keyframes": [
        "002724.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vậy mình sẽ cho cái phần tôm đã quết này ra, cho vào đây là giò sống.",
      "start": 110.32,
      "end": 114.36,
