        "001933.webp",
        "001965.webp",
        "001998.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chúng ta lau khô tôm trước khi quết để tôm được dai nha các bạn.",
      "start": 79.92,
      "end": 84.2,
      "n_words": 15,
