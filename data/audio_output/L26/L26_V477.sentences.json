        "005228.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Cái tạo hình nhìn đẹp quá cô ha, trông nó tròn tròn như là hình mặt trăng vậy đó.",
      "start": 209.4,
      "end": 214.04,
