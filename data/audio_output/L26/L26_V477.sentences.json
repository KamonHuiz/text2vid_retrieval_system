        "000679.webp",
        "000716.webp",
        "000754.webp",
        "000755.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Giòn giòn thì mình sẽ chiên ha, sốt thì mình sẽ làm với sốt hoa quả nè.",
      "start": 30.8,
      "end": 36.32,
      "n_words": 17,
