        "001650.webp",
        "001737.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Hân hoan chào đón các bạn đang theo dõi chương trình Món ngon mỗi ngày.",
      "start": 71.36,
      "end": 76.32,
      "n_words": 15,
