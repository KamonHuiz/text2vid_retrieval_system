      "keyframes": [
        "001824.webp",
        "001825.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Azino Việt Nam.",
      "start": 76.32,
      "end": 80.4,
      "n_words": 11,
      "start_frame": 1908,
      "end_frame": 2010,
      "keyframes": [
        "001918.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi thưa các bạn, đầu tiên thì chúng ta sẽ chế các loại rau củ.",
      "start": 80.4,
      "end": 84.72,
      "n_words": 15,
