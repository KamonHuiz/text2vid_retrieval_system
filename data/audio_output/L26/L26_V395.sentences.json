        "001008.webp",
        "001070.webp",
        "001071.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chính xác luôn, bao luôn Thái đi rồi.",
      "start": 43.04,
      "end": 45.28,
      "n_words": 8,
      "start_frame": 1076,
