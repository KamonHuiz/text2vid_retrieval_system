        "002706.webp",
        "002720.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hy vọng là năm mới chúng ta ăn rau muống thì muốn gì được ngay quả năm xăng như vậy.",
      "start": 108.8,
      "end": 116.84,
      "n_words": 20,
      "start_frame": 2720,
