        "000475.webp",
        "000491.webp",
        "000492.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Mặc dù là Tết Tây thôi mà em đã thấy không khí rất là nhộn nhịp rồi.",
      "start": 19.72,
      "end": 23.96,
