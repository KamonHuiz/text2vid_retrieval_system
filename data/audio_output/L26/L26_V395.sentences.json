        "000772.webp",
        "000783.webp",
        "000794.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Nhưng mà bây giờ làm sao để được vẫn có cái cảm giác được đi du lịch bây giờ anh?",
      "start": 31.76,
