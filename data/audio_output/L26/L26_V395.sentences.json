        "002485.webp",
        "002486.webp",
        "002503.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hành tím thì chúng ta không băm nhỏ, à không, cắt lát mà chúng ta cắt làm tư.",
      "start": 100.8,
      "end": 106.08,
