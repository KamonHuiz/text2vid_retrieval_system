      "end": 75.48,
      "n_words": 11,
      "start_frame": 1783,
      "end_frame": 1887,
      "keyframes": [
        "001802.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ giúp cô cắt các loại rau này, mình sẽ cắt đôi, cắt thành hai. Được rồi.",
      "start": 75.48,
