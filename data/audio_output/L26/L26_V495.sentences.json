      "end_frame": 332,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cái gì mà lén lén lúc thì Thanh Phương có gì giấu lòng hả em?",
