      "start_frame": 669,
      "end_frame": 696,
      "keyframes": [
        "000682.webp",
        "000696.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đây là một món thức uống rất nổi tiếng tại Peru nha.",
