        "002082.webp",
        "002109.webp",
        "002136.webp",
        "002137.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và thường chúng ta thấy thịt vịt thì có nhiều cái phần mỡ ở dưới lớp da đúng không dạ?",
      "start": 85.56,
      "end": 90.24,
      "n_words": 20,
      "start_frame": 2139,
      "end_frame": 2256,
      "keyframes": [
        "002191.webp",
        "002245.webp",
        "002246.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ xử lý là cái phần mỡ đó, chúng ta nên chọn thịt vịt xiêm thì thịt vịt sẽ dai, món ăn này sẽ ngon hơn rất là nhiều nha các bạn.",
      "start": 90.24,
      "end": 97.6,
      "n_words": 34,
      "start_frame": 2256,
      "end_frame": 2440,
      "keyframes": [
        "002279.webp",
        "002312.webp",
        "002313.webp",
        "002373.webp",
        "002434.webp",
        "002435.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta khứa vài đường ở phần da như vậy nha các bạn, khứa như vậy để mình cho cái mỡ nó tiết ra ngoài.",
      "start": 97.6,
      "end": 103.68,
      "n_words": 25,
      "start_frame": 2440,
      "end_frame": 2592,
      "keyframes": [
        "002479.webp",
        "002523.webp",
        "002524.webp",
        "002581.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khi áp chảo, cái nước mỡ nó chảy đi, chúng ta cho phần da để dưới nha các bạn.",
      "start": 103.68,
      "end": 110.96,
      "n_words": 19,
      "start_frame": 2592,
      "end_frame": 2774,
      "keyframes": [
        "002638.webp",
        "002639.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Lúc nào cũng vậy, làm tất cả các món ăn mà có cái thành phần đạm thì em thấy là mình sẽ cho da ở dưới, cá hồi cũng vậy luôn đúng không?",
      "start": 110.96,
      "end": 117.16,
      "n_words": 33,
      "start_frame": 2774,
      "end_frame": 2929,
      "keyframes": [
        "002780.webp",
        "002921.webp",
        "002922.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cá hồi cũng vậy luôn đúng không anh?",
      "start": 117.16,
      "end": 118.64,
      "n_words": 8,
      "start_frame": 2929,
      "end_frame": 2966,
      "keyframes": [
        "002960.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Gà cũng vậy, vịt cũng vậy.",
      "start": 118.64,
      "end": 120.0,
      "n_words": 6,
      "start_frame": 2966,
      "end_frame": 3000,
      "keyframes": [
        "002999.webp",
        "003000.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng ta nên áp chảo phần da vịt với lửa lớn để giảm bớt lượng mỡ cho vịt nha các bạn.",
      "start": 120.0,
      "end": 127.12,
      "n_words": 21,
      "start_frame": 3000,
      "end_frame": 3178,
      "keyframes": [
        "003000.webp",
