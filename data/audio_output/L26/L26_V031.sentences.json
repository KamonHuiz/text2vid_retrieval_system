        "000859.webp",
        "000860.webp",
        "000891.webp"
      ],
      "keyframe_count": 22
    },
    {
      "text": "Rất vui khi được gặp lại các bạn đang xem chương trình Món ngon mỗi ngày, nấu chuẩn ăn lành.",
      "start": 36.72,
      "end": 41.28,
      "n_words": 20,
      "start_frame": 918,
      "end_frame": 1032,
      "keyframes": [
        "000923.webp",
        "000924.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam. Em chào anh Vũ.",
      "start": 41.28,
      "end": 46.2,
      "n_words": 15,
      "start_frame": 1032,
      "end_frame": 1155,
      "keyframes": [
        "001048.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chào anh Minh Tuấn.",
      "start": 46.2,
      "end": 47.04,
      "n_words": 4,
      "start_frame": 1155,
      "end_frame": 1176,
      "keyframes": [
        "001173.webp",
        "001174.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Vô là em để ý cái chỗ mà nguyên liệu của anh liền.",
      "start": 47.04,
      "end": 50.72,
      "n_words": 13,
      "start_frame": 1176,
      "end_frame": 1268,
      "keyframes": [
        "001197.webp",
        "001221.webp",
        "001222.webp",
        "001258.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Em thấy có cơm rượu lạ, nếu mà cơm rượu bình thường là mình ăn không mà hôm nay anh Vũ anh bỏ vô đây để mà anh làm một cái món ăn gì đó là em đang tưởng tượng coi là cái món ăn này nó là gì mà vị nó ra làm sao vậy?",
      "start": 50.72,
      "end": 62.16,
      "n_words": 56,
      "start_frame": 1268,
      "end_frame": 1554,
      "keyframes": [
        "001295.webp",
        "001296.webp",
        "001398.webp",
        "001501.webp",
        "001502.webp",
        "001524.webp",
        "001546.webp",
        "001547.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đố em, thường người ta ăn cơm rượu vào dịp nào?",
      "start": 62.16,
      "end": 64.4,
      "n_words": 11,
      "start_frame": 1554,
      "end_frame": 1610,
      "keyframes": [
        "001576.webp",
        "001606.webp",
        "001607.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ, nó là cái Tết mà gọi là Tết Đoan Ngọ, hay là Tết diệt sâu bọ đúng không anh? Đúng rồi.",
      "start": 64.4,
      "end": 69.72,
      "n_words": 22,
      "start_frame": 1610,
      "end_frame": 1743,
      "keyframes": [
        "001677.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và thưa các bạn, món ngày hôm nay chúng ta hết sức là đơn giản, cũng như là mời lại các bạn, chúng ta kết hợp với thịt vịt và cơm rượu, nghe rất là lạ không các bạn?",
      "start": 69.72,
      "end": 78.44,
      "n_words": 39,
      "start_frame": 1743,
      "end_frame": 1961,
      "keyframes": [
        "001748.webp",
        "001749.webp",
        "001854.webp",
        "001959.webp",
        "001960.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thưa các bạn, món vịt nấu cơm rượu theo chuyên gia dinh dưỡng tiến sĩ Đào Thị Yến Phi thì món ăn này sẽ giúp bổ máu nha các bạn.",
      "start": 78.44,
      "end": 85.56,
      "n_words": 30,
      "start_frame": 1961,
      "end_frame": 2139,
      "keyframes": [
        "001987.webp",
        "002015.webp",
        "002016.webp",
        "002048.webp",
