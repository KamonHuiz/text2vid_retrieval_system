        "004089.webp",
        "004090.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Phần rau gia vị kèm thì chúng ta chỉ cần hành lá thôi, chúng ta cắt khúc ăn.",
      "start": 164.12,
      "end": 169.12,
