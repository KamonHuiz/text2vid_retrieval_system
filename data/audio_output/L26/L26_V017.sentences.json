        "002982.webp",
        "002983.webp",
        "003010.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Cho phần tỏi, hành tím đập dập, cho lá quế cắt sợi vào luôn, và cuối cùng Hưng sẽ cho ớt hiểm đập dập.",
      "start": 121.4,
      "end": 130.08,
      "n_words": 24,
      "start_frame": 3035,
      "end_frame": 3252,
      "keyframes": [
        "003038.webp",
        "003039.webp",
        "003062.webp",
        "003086.webp",
        "003087.webp",
        "003168.webp",
        "003249.webp",
        "003250.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta sẽ ướp lá quế cắt sợi vào phần tôm trước để lá quế ngấm gia vị vào tôm, thì khi kho món ăn có mùi thơm đặc trưng hơn.",
      "start": 130.08,
      "end": 138.08,
      "n_words": 31,
      "start_frame": 3252,
      "end_frame": 3452,
      "keyframes": [
        "003350.webp",
        "003451.webp",
        "003452.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngày hôm nay chúng ta có món tôm thì chắc chắn là sẽ cung cấp được một lượng đạm tốt cho cơ thể, đồng thời là chất chống oxy hóa và ít calo, cho nên chúng ta có thể thoải mái ăn mà không sợ tăng cân.",
      "start": 138.08,
      "end": 149.72,
      "n_words": 47,
      "start_frame": 3452,
      "end_frame": 3743,
      "keyframes": [
        "003452.webp",
        "003543.webp",
        "003634.webp",
        "003635.webp",
        "003688.webp",
        "003742.webp",
        "003743.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chúng ta để tôm được thấm khoảng năm phút là được rồi và chúng ta bắt chảo lên.",
      "start": 149.72,
      "end": 153.64,
      "n_words": 18,
      "start_frame": 3743,
      "end_frame": 3841,
      "keyframes": [
        "003743.webp",
        "003766.webp",
        "003790.webp",
        "003791.webp",
        "003823.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hưng sẽ cho vào đây hai muỗng canh dầu điều, cho vào đây một muỗng canh đường để chúng ta thắng caramel.",
      "start": 154.28,
      "end": 164.96,
      "n_words": 22,
      "start_frame": 3857,
      "end_frame": 4124,
      "keyframes": [
        "003857.webp",
