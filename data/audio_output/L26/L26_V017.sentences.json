        "003958.webp",
        "003959.webp",
        "003997.webp",
        "004036.webp",
        "004037.webp",
        "004084.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Phần màu caramel đã ngả cái màu nâu đẹp rồi, bây giờ Phước Hưng sẽ cho phần tôm vào.",
      "start": 164.96,
      "end": 175.76,
      "n_words": 19,
      "start_frame": 4124,
      "end_frame": 4394,
      "keyframes": [
