      "end": 46.0,
      "n_words": 33,
      "start_frame": 903,
      "end_frame": 1150,
      "keyframes": [
        "000909.webp",
        "000910.webp",
        "001039.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chào Kim Thảo!",
      "start": 46.0,
      "end": 46.96,
      "n_words": 3,
      "start_frame": 1150,
      "end_frame": 1174,
      "keyframes": [
        "001168.webp",
        "001169.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chào Phước Hưng!",
      "start": 46.96,
      "end": 47.8,
      "n_words": 3,
      "start_frame": 1174,
      "end_frame": 1195,
      "keyframes": [
        "001186.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Phước Hưng ơi, Kim Thảo muốn ăn tôm kho quá, nhưng mà bình thường ở nhà chỉ kho nước tương, nước mắm tự nhiên thấy nó hơi quen thuộc.",
      "start": 47.8,
      "end": 54.16,
      "n_words": 29,
      "start_frame": 1195,
      "end_frame": 1354,
      "keyframes": [
        "001203.webp",
        "001204.webp",
        "001247.webp",
        "001290.webp",
        "001291.webp",
        "001321.webp",
        "001352.webp",
        "001353.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Có cách nào làm cho món tôm kho nó đặc biệt hơn không? Tôm kho đúng không?",
      "start": 54.16,
      "end": 58.04,
      "n_words": 17,
      "start_frame": 1354,
      "end_frame": 1451,
      "keyframes": [
        "001369.webp",
        "001386.webp",
        "001387.webp",
        "001402.webp",
        "001417.webp",
        "001418.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thường thì mình hay kho là mình sử dụng tôm sú hoặc là tôm càng.",
      "start": 58.04,
      "end": 62.08,
      "n_words": 15,
      "start_frame": 1451,
      "end_frame": 1552,
      "keyframes": [
        "001461.webp",
        "001504.webp",
        "001505.webp",
        "001528.webp",
        "001552.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hai loại tôm này thì kho rất là ngon và rất là phù hợp luôn.",
      "start": 62.08,
      "end": 65.24,
      "n_words": 15,
      "start_frame": 1552,
      "end_frame": 1631,
      "keyframes": [
        "001552.webp",
        "001553.webp",
        "001578.webp",
        "001604.webp",
        "001605.webp",
        "001619.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vậy thì ngày hôm nay, Phước Hưng sẽ hướng dẫn cho Kim Thảo cũng như là các bạn một cái món kho có một cái sự kết hợp rất là độc đáo, đó là món tôm sú kho lá quế.",
      "start": 65.24,
      "end": 73.8,
      "n_words": 40,
      "start_frame": 1631,
      "end_frame": 1845,
      "keyframes": [
        "001633.webp",
        "001634.webp",
        "001739.webp",
        "001845.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và cũng theo lời của chuyên gia dinh dưỡng thì món ăn ngày hôm nay hỗ trợ giảm mỡ thừa trong cơ thể của chúng ta rất tốt.",
      "start": 73.8,
      "end": 79.92,
      "n_words": 28,
      "start_frame": 1845,
      "end_frame": 1998,
      "keyframes": [
        "001845.webp",
        "001846.webp",
        "001866.webp",
        "001887.webp",
        "001888.webp",
        "001942.webp",
        "001997.webp",
        "001998.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Lá quế thì Hưng sẽ cắt sợi để Hưng ướp vào tôm.",
      "start": 79.92,
      "end": 83.04,
      "n_words": 12,
      "start_frame": 1998,
      "end_frame": 2076,
      "keyframes": [
        "001998.webp",
        "002039.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Theo Kim Thảo được biết thì lá quế rất là tốt cho sức khỏe, có thể cân bằng được axit nè và giúp cho cơ thể của chúng ta trao đổi chất tốt.",
      "start": 83.04,
      "end": 90.68,
      "n_words": 33,
      "start_frame": 2076,
      "end_frame": 2267,
      "keyframes": [
        "002081.webp",
        "002082.webp",
        "002169.webp",
        "002257.webp",
        "002258.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đập dập còn phần hành tím Phước Hưng cũng sẽ đập dập luôn.",
      "start": 90.88,
      "end": 95.84,
      "n_words": 13,
      "start_frame": 2272,
      "end_frame": 2396,
      "keyframes": [
        "002280.webp",
        "002303.webp",
        "002304.webp",
        "002356.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ chúng ta sẽ ướp gia vị vào tôm cho tôm được thấm vị.",
      "start": 95.84,
      "end": 99.44,
      "n_words": 15,
      "start_frame": 2396,
      "end_frame": 2486,
      "keyframes": [
        "002408.webp",
        "002409.webp",
        "002442.webp",
        "002475.webp",
        "002476.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đối với món tôm ngày hôm nay thì chúng ta sẽ bỏ đầu nè, lột vỏ cho sạch, chừa đuôi.",
      "start": 99.44,
      "end": 104.04,
      "n_words": 20,
      "start_frame": 2486,
      "end_frame": 2601,
      "keyframes": [
        "002505.webp",
        "002535.webp",
        "002536.webp",
        "002567.webp",
        "002598.webp",
        "002599.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ xẻ dọc sâu vào lưng tôm, khi kho thì tôm sẽ thấm vị và bung trông rất là đẹp.",
      "start": 104.04,
      "end": 109.76,
      "n_words": 22,
      "start_frame": 2601,
      "end_frame": 2744,
      "keyframes": [
        "002672.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hưng sẽ cho hết cái phần tôm vào.",
      "start": 110.0,
      "end": 112.68,
      "n_words": 8,
      "start_frame": 2750,
      "end_frame": 2817,
      "keyframes": [
        "002784.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên Hưng sẽ cho vào đây hai muỗng canh nước mắm, một muỗng cà phê bột ngọt Ajinomoto, nửa muỗng cà phê tiêu.",
      "start": 112.68,
      "end": 121.4,
      "n_words": 24,
      "start_frame": 2817,
      "end_frame": 3035,
      "keyframes": [
        "002821.webp",
