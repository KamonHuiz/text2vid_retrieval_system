        "005356.webp",
        "005384.webp",
        "005385.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Khi ăn thì chúng ta sẽ trộn đều lên.",
      "start": 215.44,
      "end": 217.92,
      "n_words": 9,
      "start_frame": 5386,
      "end_frame": 5448,
      "keyframes": [
        "005418.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cuối cùng Phước Hưng sẽ cho lên đây một ít đậu phộng rang.",
      "start": 217.92,
      "end": 221.36,
      "n_words": 13,
      "start_frame": 5448,
      "end_frame": 5534,
      "keyframes": [
        "005451.webp",
        "005452.webp",
        "005492.webp",
        "005533.webp",
        "005534.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Một con tôm nè, một củ hành tím nè và một ít tỏi nè, ăn kèm với một cái lá quế. Rồi, mời Kim Thảo!",
      "start": 221.36,
      "end": 231.2,
      "n_words": 25,
      "start_frame": 5534,
      "end_frame": 5780,
      "keyframes": [
        "005534.webp",
        "005671.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cảm ơn Phước Hưng! Chưa ăn mà đã thấy ngon rồi đó.",
      "start": 231.2,
      "end": 233.04,
      "n_words": 12,
      "start_frame": 5780,
      "end_frame": 5826,
      "keyframes": [
        "005808.webp",
        "005809.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thịt tôm giữ được độ dai và rất thấm vị luôn, thơm nè, có chút cay nhẹ nhẹ và đặc biệt khi mà ăn kết hợp với lá quế, đúng thật là vị tôm sú kho tự nhiên cảm thấy đặc biệt hơn hẳn.",
      "start": 240.0,
      "end": 253.52,
      "n_words": 44,
      "start_frame": 6000,
      "end_frame": 6338,
      "keyframes": [
        "006042.webp",
        "006085.webp",
        "006100.webp",
        "006141.webp",
        "006183.webp",
        "006184.webp",
        "006259.webp",
        "006334.webp",
        "006335.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chắc chắn là các bạn khán giả cũng sẽ mê món này giống như Kim Thảo đấy ạ.",
      "start": 253.52,
      "end": 257.36,
      "n_words": 18,
      "start_frame": 6338,
      "end_frame": 6434,
      "keyframes": [
        "006383.webp",
        "006432.webp",
        "006433.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và để đạt được hiệu quả dinh dưỡng thì chúng ta nên tham khảo món ăn này cùng với bản thực đơn sau đây: Tôm sú lá quế, nhanh gọn, đơn giản, hao cơm cực kỳ, không thể bỏ qua.",
      "start": 257.36,
      "end": 271.88,
      "n_words": 40,
      "start_frame": 6434,
      "end_frame": 6797,
      "keyframes": [
        "006484.webp",
        "006536.webp",
        "006537.webp",
        "006599.webp",
        "006661.webp",
        "006662.webp",
        "006730.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Để xem lại công thức của món ăn ngày hôm nay cùng với gợi ý của rất nhiều những món ăn hấp dẫn nữa cho bữa cơm gia đình, các bạn chỉ cần truy cập vào YouTube, website, fanpage của chương trình Món ngon mỗi ngày.",
      "start": 271.88,
      "end": 282.6,
      "n_words": 46,
