        "004291.webp",
        "004319.webp",
        "004320.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chúng ta sẽ xóc đều cho phần caramel dầu điều áo vào tôm.",
      "start": 175.76,
      "end": 181.72,
      "n_words": 13,
      "start_frame": 4394,
      "end_frame": 4543,
      "keyframes": [
        "004433.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Phước Hưng sẽ cho vào đây hai muỗng canh nước lọc để chúng ta kho.",
      "start": 181.72,
      "end": 185.48,
      "n_words": 15,
      "start_frame": 4543,
      "end_frame": 4637,
      "keyframes": [
        "004547.webp",
        "004548.webp",
        "004571.webp",
        "004595.webp",
        "004596.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta không cần kho quá lâu vì kho quá lâu thì phần thịt tôm sẽ bị khô, ăn không ngon.",
      "start": 185.48,
      "end": 190.64,
      "n_words": 21,
      "start_frame": 4637,
      "end_frame": 4766,
      "keyframes": [
        "004681.webp",
        "004766.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ thì cái màu sắc của tôm rất là đẹp luôn.",
      "start": 190.64,
      "end": 193.36,
      "n_words": 12,
      "start_frame": 4766,
      "end_frame": 4834,
      "keyframes": [
        "004766.webp",
        "004767.webp",
        "004796.webp",
        "004826.webp",
        "004827.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phước Hưng sẽ tắt bếp nè.",
      "start": 193.36,
      "end": 194.96,
      "n_words": 6,
      "start_frame": 4834,
      "end_frame": 4874,
      "keyframes": [
        "004864.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Còn các bạn khán giả thì chỉ cần lấy điện thoại ra và quét mã QR trên màn hình của chúng tôi là có trọn vẹn công thức của món ăn ngày hôm nay nhé.",
      "start": 194.96,
      "end": 203.76,
      "n_words": 35,
      "start_frame": 4874,
      "end_frame": 5094,
      "keyframes": [
        "004902.webp",
        "004903.webp",
        "004975.webp",
        "005047.webp",
        "005048.webp",
        "005072.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ Hưng sẽ cho tôm vào, sẽ cho lên đây tỏi nè, ớt nè, hành tím nè, một ít lá quế tươi.",
      "start": 203.76,
      "end": 215.44,
      "n_words": 23,
      "start_frame": 5094,
      "end_frame": 5386,
      "keyframes": [
        "005097.webp",
