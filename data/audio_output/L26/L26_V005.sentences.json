        "001298.webp",
        "001320.webp",
        "001321.webp",
        "001353.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Súp cua là rất là dễ ăn đối với các bé đó Minh Phương.",
      "start": 55.4,
      "end": 58.12,
      "n_words": 14,
      "start_frame": 1385,
      "end_frame": 1453,
      "keyframes": [
        "001386.webp",
        "001387.webp",
        "001418.webp",
        "001450.webp",
        "001451.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Vậy món súp ngày hôm nay có tên gọi là gì?",
      "start": 58.12,
      "end": 59.0,
      "n_words": 11,
      "start_frame": 1453,
      "end_frame": 1475,
      "keyframes": [
        "001473.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Món súp ngày hôm nay chúng ta sẽ nấu món súp mộc nhĩ cua và theo chuyên gia dinh dưỡng, món ăn này sẽ giúp hỗ trợ bổ máu nữa.",
      "start": 59.92,
      "end": 66.76,
      "n_words": 30,
      "start_frame": 1498,
      "end_frame": 1669,
      "keyframes": [
        "001539.webp",
        "001583.webp",
        "001584.webp",
        "001628.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Minh sẽ trộn lần lượt cái phần nấm này vào trong đây, khi nấm nó vừa chín là mình sẽ vớt ra là được và tiếp theo Minh sẽ đi trần cái phần mộc nhĩ này nha.",
      "start": 67.24,
      "end": 82.68,
      "n_words": 37,
      "start_frame": 1681,
      "end_frame": 2067,
      "keyframes": [
        "001725.webp",
        "001777.webp",
        "001778.webp",
        "001824.webp",
        "001870.webp",
        "001871.webp",
        "001925.webp",
        "001979.webp",
        "001980.webp",
        "002023.webp",
        "002067.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Cả nấm và mộc nhĩ thì các bạn lưu ý là chúng ta trần rất là nhanh thôi.",
      "start": 82.68,
      "end": 86.24,
      "n_words": 18,
      "start_frame": 2067,
      "end_frame": 2156,
      "keyframes": [
        "002067.webp",
        "002068.webp",
        "002114.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, đặc biệt là mộc nhĩ là chúng ta chần quá lâu thì cái nước ngọt trong mộc nhĩ nó sẽ không còn nữa.",
      "start": 86.24,
      "end": 91.16,
      "n_words": 25,
      "start_frame": 2156,
      "end_frame": 2279,
      "keyframes": [
        "002160.webp",
        "002161.webp",
        "002181.webp",
        "002201.webp",
        "002202.webp",
        "002239.webp",
        "002277.webp",
        "002278.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Với hai loại nấm ngày hôm nay, chúng ta nên trộn nấm để làm giảm mùi hăng của nấm nha.",
      "start": 91.16,
      "end": 95.36,
      "n_words": 20,
      "start_frame": 2279,
      "end_frame": 2384,
      "keyframes": [
        "002330.webp",
        "002382.webp",
        "002383.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và bây giờ thì mình sẽ đi xào cái phần thịt cua này, sẽ xào với lại một muỗng cà phê gừng băm với nửa muỗng canh dầu màu điều.",
      "start": 95.36,
      "end": 103.4,
      "n_words": 30,
      "start_frame": 2384,
      "end_frame": 2585,
      "keyframes": [
        "002422.webp",
        "002461.webp",
        "002462.webp",
        "002492.webp",
        "002523.webp",
        "002524.webp",
        "002556.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Sau đó mình sẽ phi thơm này lên nè, thơm rồi cho hết cái phần thịt cua này vào.",
      "start": 103.4,
      "end": 110.44,
      "n_words": 19,
      "start_frame": 2585,
      "end_frame": 2761,
      "keyframes": [
        "002588.webp",
