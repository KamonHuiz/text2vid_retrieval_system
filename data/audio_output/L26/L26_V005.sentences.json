        "001006.webp",
        "001120.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Anh Ngọc Minh ơi, Minh Phương đang tìm một món ăn nào đó với thịt cua nè, nhưng mà đặc biệt là dành cho mấy bé dễ ăn.",
      "start": 49.12,
      "end": 55.4,
      "n_words": 28,
      "start_frame": 1228,
