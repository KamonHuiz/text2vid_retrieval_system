        "002630.webp",
        "002671.webp",
        "002672.webp",
        "002717.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Với món này, chúng ta nên xào thịt cua cùng với gừng và dầu màu điều giúp thịt cua thơm và màu sắc thêm hấp dẫn hơn nha.",
      "start": 110.44,
      "end": 116.84,
      "n_words": 28,
      "start_frame": 2761,
      "end_frame": 2921,
      "keyframes": [
        "002762.webp",
        "002763.webp",
        "002840.webp",
        "002918.webp",
        "002919.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Mình sẽ nêm vào đây một ít tiêu trắng nè.",
      "start": 116.84,
      "end": 118.96,
      "n_words": 10,
      "start_frame": 2921,
      "end_frame": 2974,
      "keyframes": [
        "002946.webp",
        "002973.webp",
        "002974.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình sẽ sử dụng 1/3 muỗng cà phê hạt nêm Ajinomoto ngon heo, sẽ xào nhanh tay với lửa lớn một tí xíu cho nó săn cái thịt cua này lại là được.",
      "start": 118.96,
      "end": 128.24,
      "n_words": 33,
      "start_frame": 2974,
      "end_frame": 3206,
      "keyframes": [
        "002974.webp",
        "002994.webp",
