        "003243.webp",
        "003279.webp",
        "003280.webp",
        "003328.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ mình sẽ tắt bếp ha và cho cái phần thịt cua của mình xào ra đây.",
      "start": 134.96,
      "end": 140.56,
      "n_words": 18,
      "start_frame": 3374,
      "end_frame": 3514,
      "keyframes": [
        "003376.webp",
        "003377.webp",
        "003448.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và đây là một lít nước dùng, chúng ta sẽ cho đậu hũ trắng mình sẽ cắt khối vuông, bốn cây thanh cua cắt lát xéo như thế này đây.",
      "start": 140.56,
      "end": 149.96,
      "n_words": 30,
      "start_frame": 3514,
      "end_frame": 3749,
      "keyframes": [
        "003520.webp",
