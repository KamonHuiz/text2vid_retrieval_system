        "003093.webp",
        "003094.webp",
        "003150.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cái phần thịt cua bây giờ rất là thơm và có một cái màu vàng cam rất là đẹp.",
      "start": 128.24,
      "end": 134.96,
      "n_words": 19,
      "start_frame": 3206,
      "end_frame": 3374,
      "keyframes": [
        "003207.webp",
