      "start_frame": 5460,
      "end_frame": 5556,
      "keyframes": [
        "005548.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Minh Phương rất là nóng lòng muốn thử với cái cách làm ngày hôm nay của đầu bếp Ngọc Minh.",
      "start": 222.24,
      "end": 227.0,
      "n_words": 20,
      "start_frame": 5556,
      "end_frame": 5675,
      "keyframes": [
        "005637.webp",
        "005638.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cái mùi gừng thoang thoảng nhẹ nhẹ rất là dễ chịu.",
