      "end_frame": 2060,
      "keyframes": [
        "001978.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chúng ta sơ chế cái phần hành tây ở đây, Phước Hưng đã lột vỏ sạch rồi.",
      "start": 82.4,
      "end": 86.36,
      "n_words": 17,
      "start_frame": 2060,
      "end_frame": 2159,
      "keyframes": [
        "002064.webp",
        "002065.webp",
        "002085.webp",
        "002105.webp",
        "002106.webp",
        "002136.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ Phước Hưng sẽ cắt khoanh khoảng 2 cm.",
