      "keyframes": [
        "002500.webp",
        "002569.webp",
        "002570.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hưng sẽ lấy cái phần nhỏ bên trong ra, chừa lại hai khoanh thôi.",
      "start": 103.16,
      "end": 107.56,
      "n_words": 14,
