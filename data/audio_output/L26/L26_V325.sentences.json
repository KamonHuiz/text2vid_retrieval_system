      "n_words": 24,
      "start_frame": 986,
      "end_frame": 1141,
      "keyframes": [
        "001046.webp",
        "001110.webp",
        "001111.webp",
        "001128.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Á trời ơi, nhưng mà bây giờ có cái món ăn nào đơn giản dành cho người mới nhập môn tập ăn hành tây như Phương không?",
