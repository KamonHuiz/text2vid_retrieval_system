  "total_words": 1005,
  "sentences": [
    {
      "text": "Chào mừng quý khán giả quay trở lại với Món ngon mỗi ngày.",
      "start": 0.0,
      "end": 0.0,
      "n_words": 13,
      "start_frame": 0,
      "end_frame": 0,
      "keyframes": [
        "000000.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chà, bữa nay ai mà vẽ mặt cho mấy con cá đẹp luôn á. Còn ai vào đây nữa hả chú Phước Hưng?",
      "start": 12.32,
