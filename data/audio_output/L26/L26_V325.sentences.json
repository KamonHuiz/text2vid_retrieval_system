        "003497.webp",
        "003510.webp",
        "003511.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Phương thấy là trong phần nhân ngày hôm nay chúng ta không có thêm gia vị nè?",
      "start": 140.48,
      "end": 143.68,
      "n_words": 17,
