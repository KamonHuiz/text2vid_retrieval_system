        "000563.webp",
        "000615.webp",
        "000668.webp",
        "000669.webp",
        "000692.webp",
        "000716.webp",
        "000717.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Mặc dù là Phương không có thích cái mùi hăng hăng nồng của hành tây đâu, nhưng mà chính cái mùi nồng đó nha giúp cho hành tây có khả năng thanh lọc không khí nè, cũng như là phòng các bệnh do vi khuẩn gây ra.",
      "start": 28.8,
      "end": 39.44,
      "n_words": 47,
      "start_frame": 720,
      "end_frame": 986,
      "keyframes": [
        "000728.webp",
        "000740.webp",
        "000741.webp",
        "000772.webp",
        "000803.webp",
        "000804.webp",
        "000892.webp",
        "000981.webp",
        "000982.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ngoài ra, hành tây lại còn kháng viêm cho cơ thể của mình rất là tốt luôn nữa, không ăn là tiếc lắm luôn.",
