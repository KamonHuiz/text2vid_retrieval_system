      "start_frame": 3766,
      "end_frame": 3872,
      "keyframes": [
        "003870.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Làm như vậy thì khi chiên, giữa phần hành tây và nhân sẽ chặt chẽ hơn.",
