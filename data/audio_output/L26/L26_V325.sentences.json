      "end_frame": 2370,
      "keyframes": [
        "002244.webp",
        "002322.webp",
        "002323.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thế thì chúng ta phải lựa củ hành tây như thế nào cho đẹp?",
      "start": 94.8,
      "end": 97.28,
      "n_words": 14,
      "start_frame": 2370,
      "end_frame": 2432,
      "keyframes": [
        "002376.webp",
        "002430.webp",
        "002431.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì chúng ta sẽ lựa những củ hành tây vừa nè, hình bầu dục thì để có những miếng hành tây đều nhau hơn.",
