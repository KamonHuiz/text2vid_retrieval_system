        "002656.webp",
        "002669.webp",
        "002670.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và bây giờ tiếp theo, chúng ta sẽ trộn nhân cho phần thịt heo xay vào, cho phần tôm giã nhuyễn vào.",
      "start": 107.56,
      "end": 114.12,
      "n_words": 22,
      "start_frame": 2689,
      "end_frame": 2853,
      "keyframes": [
        "002692.webp",
