        "001804.webp",
        "001891.webp",
        "001892.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 78.32,
      "end": 82.4,
      "n_words": 11,
