      "end": 148.08,
      "n_words": 8,
      "start_frame": 3641,
      "end_frame": 3702,
      "keyframes": [
        "003701.webp",
        "003702.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng ta cho đây 1.5 lít nước vào đó và các bạn nhớ là cho nước nguội nha.",
      "start": 148.08,
      "end": 154.28,
