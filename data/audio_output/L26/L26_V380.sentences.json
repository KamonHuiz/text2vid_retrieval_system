        "002526.webp",
        "002552.webp",
        "002553.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Để ướp vô trong thịt chín sặc cho thịt thơm đó.",
      "start": 104.16,
      "end": 108.24,
      "n_words": 11,
      "start_frame": 2604,
      "end_frame": 2706,
      "keyframes": [
        "002613.webp",
        "002673.webp",
        "002674.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phần lá chúng ta làm gì?",
