        "001403.webp",
        "001428.webp",
        "001429.webp",
        "001469.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rất vui khi được gặp lại các bạn khán giả đang xem chương trình Món ngon mỗi ngày.",
      "start": 75.52,
      "end": 79.56,
      "n_words": 18,
      "start_frame": 1888,
      "end_frame": 1989,
      "keyframes": [
        "001907.webp",
        "001908.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 79.56,
      "end": 83.4,
      "n_words": 11,
      "start_frame": 1989,
      "end_frame": 2085,
      "keyframes": [
        "001998.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chúng ta cầm xương chặt ra từng khúc, từng khúc khoảng 3 cm.",
      "start": 83.4,
      "end": 86.24,
      "n_words": 13,
      "start_frame": 2085,
      "end_frame": 2156,
      "keyframes": [
        "002089.webp",
        "002090.webp",
        "002137.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vậy chúng ta ngâm trong nước lạnh, ngâm xả ngâm xả khoảng 3-4 lần cho nước ngâm được trong, sau đó chúng ta để ráo như vậy.",
      "start": 86.24,
      "end": 92.32,
      "n_words": 27,
      "start_frame": 2156,
      "end_frame": 2308,
      "keyframes": [
        "002185.webp",
        "002186.webp",
        "002257.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Như vậy nước canh nấu sẽ trong và thơm ngọt thịt.",
      "start": 92.32,
      "end": 95.28,
      "n_words": 11,
      "start_frame": 2308,
      "end_frame": 2382,
      "keyframes": [
        "002328.webp",
        "002329.webp",
        "002355.webp",
        "002381.webp",
        "002382.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phần đầu hành và phần lá hành, phần đầu chúng ta đập dập ra như vậy, à chúng ta cắt nhỏ rồi làm gì Minh Tuấn biết không nào?",
      "start": 95.28,
      "end": 104.16,
      "n_words": 29,
      "start_frame": 2382,
      "end_frame": 2604,
      "keyframes": [
        "002382.webp",
