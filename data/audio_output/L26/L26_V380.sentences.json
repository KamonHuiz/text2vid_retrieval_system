        "004133.webp",
        "004166.webp",
        "004167.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Miếng sườn này coi một nguyên liệu dân dã nhưng mà ăn vô cùng hấp dẫn, bùi chắc luôn nha.",
      "start": 166.72,
