  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.56,
      "end": 12.12,
      "n_words": 4,
      "start_frame": 264,
      "end_frame": 303,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ui, anh ăn gì mà anh ăn mình không cho em ăn với hả?",
      "start": 12.12,
      "end": 15.8,
      "n_words": 14,
      "start_frame": 303,
      "end_frame": 395,
      "keyframes": [
        "000321.webp",
        "000343.webp",
        "000344.webp",
        "000369.webp",
        "000394.webp",
        "000395.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Biết cái gì không mà đồ ăn trời ơi không biết nữa.",
      "start": 15.8,
      "end": 18.68,
      "n_words": 12,
      "start_frame": 395,
      "end_frame": 467,
      "keyframes": [
        "000395.webp",
        "000435.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đem coi em xuất khẩu thành thơ luôn cho anh.",
      "start": 18.68,
      "end": 24.4,
      "n_words": 10,
      "start_frame": 467,
      "end_frame": 610,
      "keyframes": [
        "000476.webp",
        "000477.webp",
        "000520.webp",
        "000564.webp",
        "000565.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ngon ghê lắm, quả xanh xanh có gân, da nhám, đúng rồi, thân tròn tròn mà tạo hóa bắt dẹt ra, đó chính là trái vả.",
      "start": 24.4,
      "end": 38.4,
      "n_words": 26,
      "start_frame": 610,
      "end_frame": 960,
      "keyframes": [
        "000611.webp",
        "000658.webp",
        "000659.webp",
        "000719.webp",
        "000779.webp",
        "000780.webp",
        "000800.webp",
        "000820.webp",
        "000821.webp",
        "000860.webp",
        "000900.webp",
        "000901.webp",
        "000919.webp",
        "000937.webp",
        "000938.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Em hay quá rồi, xuất sắc đúng là anh ơi của chương trình.",
      "start": 38.4,
      "end": 42.04,
      "n_words": 13,
      "start_frame": 960,
      "end_frame": 1051,
      "keyframes": [
        "000963.webp",
        "000989.webp",
        "000990.webp",
        "001026.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ngon ăn dạ, em thấy người ta làm nhiều món lắm nè, ví dụ như là chấm mắm ruốc nè, thí dụ như là mình trộn gỏi nè.",
      "start": 42.04,
      "end": 48.76,
      "n_words": 28,
      "start_frame": 1051,
      "end_frame": 1219,
      "keyframes": [
        "001062.webp",
        "001063.webp",
        "001123.webp",
        "001183.webp",
        "001184.webp",
        "001205.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vậy hôm nay mình làm món gì anh?",
      "start": 48.76,
      "end": 50.68,
      "n_words": 8,
      "start_frame": 1219,
      "end_frame": 1267,
      "keyframes": [
        "001227.webp",
        "001228.webp",
        "001251.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hôm nay mình nấu canh đi, tại vì anh mới học được một món canh từ trái vả.",
      "start": 50.68,
      "end": 54.44,
      "n_words": 18,
      "start_frame": 1267,
      "end_frame": 1361,
      "keyframes": [
