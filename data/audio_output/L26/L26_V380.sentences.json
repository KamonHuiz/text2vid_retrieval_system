        "005184.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Dùng lá lốt nó sẽ có mùi vị lạ hơn, chúng ta cắt nhỏ ra như vậy.",
      "start": 207.36,
      "end": 213.64,
