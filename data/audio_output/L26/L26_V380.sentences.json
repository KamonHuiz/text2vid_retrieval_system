        "001341.webp",
        "001358.webp",
        "001359.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Vô bếp thanh ngọt với canh sườn mít non, trái vả.",
      "start": 54.44,
      "end": 59.08,
      "n_words": 11,
      "start_frame": 1361,
