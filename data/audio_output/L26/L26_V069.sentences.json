        "001930.webp",
        "001960.webp",
        "001961.webp",
        "001981.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Sau khi mua lươn về thì mình sẽ sơ chế sạch rồi mình cắt khúc khoảng 10 đến 12 centimet và mình sẽ bỏ cái phần xương sống đi.",
      "start": 80.0,
      "end": 87.72,
      "n_words": 29,
      "start_frame": 2000,
      "end_frame": 2193,
      "keyframes": [
        "002002.webp",
        "002003.webp",
        "002096.webp",
        "002189.webp",
        "002190.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ có những cái miếng lươn như thế này.",
      "start": 87.72,
      "end": 89.92,
      "n_words": 11,
      "start_frame": 2193,
      "end_frame": 2248,
      "keyframes": [
        "002218.webp",
        "002247.webp",
        "002248.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ thì chúng ta sẽ xiên thịt lươn, que xiên này trước khi mà chúng ta đem xiên vào thịt lươn á thì một là mình ngâm nước, hai là chúng ta sẽ phết một lớp dầu, vậy sau khi mình nướng thì nó không dính quá cứng vào trong thịt lươn, mình sẽ lấy thịt lươn ra dễ dàng hơn nha các bạn.",
      "start": 89.92,
      "end": 103.68,
      "n_words": 65,
      "start_frame": 2248,
      "end_frame": 2592,
      "keyframes": [
        "002248.webp",
