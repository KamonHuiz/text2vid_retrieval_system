        "002716.webp",
        "002747.webp",
        "002748.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi que thứ hai chúng ta sẽ để sang một bên.",
      "start": 110.04,
      "end": 120.92,
      "n_words": 11,
      "start_frame": 2751,
      "end_frame": 3023,
      "keyframes": [
        "002802.webp",
