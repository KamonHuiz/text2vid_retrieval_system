        "002457.webp",
        "002588.webp",
        "002589.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chúng ta lưu ý là chúng ta sẽ xiên lươn theo bề ngang và dứt khoát để định hình miếng lươn khi nướng nha các bạn.",
      "start": 103.68,
      "end": 110.04,
      "n_words": 26,
      "start_frame": 2592,
      "end_frame": 2751,
      "keyframes": [
        "002637.webp",
