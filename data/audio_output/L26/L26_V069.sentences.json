        "001334.webp",
        "001379.webp",
        "001380.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chính xác.",
      "start": 55.2,
      "end": 55.76,
      "n_words": 2,
      "start_frame": 1380,
      "end_frame": 1394,
      "keyframes": [
        "001380.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hôm nay chúng ta cũng sẽ làm món lươn nướng, nhưng mà là lươn nướng lá chanh.",
      "start": 55.76,
      "end": 59.24,
      "n_words": 17,
      "start_frame": 1394,
      "end_frame": 1481,
      "keyframes": [
        "001397.webp",
        "001414.webp",
        "001415.webp",
        "001458.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nướng lá chanh bây giờ mình bắt tay cho mình chuẩn bị liền.",
      "start": 59.24,
      "end": 62.0,
      "n_words": 13,
      "start_frame": 1481,
      "end_frame": 1550,
      "keyframes": [
        "001502.webp",
        "001503.webp",
        "001525.webp",
        "001548.webp",
        "001549.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đúng rồi, cô chuẩn bị xong hết rồi và bây giờ lá chanh là công việc của Tuấn, thấy nó là em hơi mệt rồi, bây giờ em cắt lấy một ít sợi để mình trang trí cuối cùng á.",
      "start": 62.0,
      "end": 72.0,
      "n_words": 40,
      "start_frame": 1550,
      "end_frame": 1800,
      "keyframes": [
        "001591.webp",
        "001634.webp",
        "001635.webp",
        "001682.webp",
        "001730.webp",
        "001731.webp",
        "001780.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Còn nhiều sả băm nhỏ giùm cô, cô cần khoảng chừng hai muỗng cà phê lá chanh băm.",
      "start": 72.0,
      "end": 75.6,
      "n_words": 18,
      "start_frame": 1800,
      "end_frame": 1890,
      "keyframes": [
        "001830.webp",
        "001831.webp",
        "001865.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Món ăn này thì chúng ta lựa con lươn hơi to một chút, có lưng nâu bụng vàng.",
      "start": 75.8,
      "end": 80.0,
      "n_words": 18,
      "start_frame": 1895,
      "end_frame": 2000,
      "keyframes": [
        "001899.webp",
