        "001689.webp",
        "001711.webp",
        "001712.webp",
        "001825.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi, em cắt hình khối, cạnh khoảng 2 centimet nha.",
      "start": 76.92,
      "end": 91.12,
      "n_words": 11,
