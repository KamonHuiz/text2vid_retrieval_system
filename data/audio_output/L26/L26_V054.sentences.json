        "001415.webp",
        "001492.webp",
        "001569.webp",
        "001570.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đầu tiên thì Kim Thảo giúp anh sơ chế các loại rau củ.",
      "start": 62.88,
      "end": 66.16,
      "n_words": 13,
      "start_frame": 1572,
      "end_frame": 1654,
      "keyframes": [
        "001595.webp",
        "001620.webp",
        "001621.webp",
        "001644.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ha dạ, khi mà chúng ta kết hợp ớt chuông đỏ thì có vitamin A, ớt chuông vàng thì có vitamin C, hai loại vitamin này rất là tốt cho sức khỏe của chúng ta và đặc biệt là tăng hệ đề kháng đúng không ạ?",
      "start": 66.16,
      "end": 76.92,
      "n_words": 46,
      "start_frame": 1654,
      "end_frame": 1923,
      "keyframes": [
        "001667.webp",
