        "005805.webp"
      ],
      "keyframe_count": 25
    },
    {
      "text": "Cuối cùng chúng ta cho vào đây khoảng, ta cho vào đây khoảng một muỗng cà phê dầu mè.",
      "start": 232.24,
      "end": 235.68,
