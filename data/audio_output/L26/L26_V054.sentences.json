        "002575.webp",
        "002576.webp",
        "002599.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Rồi hành chúng ta cắt xéo dày 5 ly, chiều dài khoảng 3 centimet.",
      "start": 104.8,
      "end": 113.52,
      "n_words": 14,
