      "n_words": 11,
      "start_frame": 6094,
      "end_frame": 6160,
      "keyframes": [
        "006125.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ chúng ta sẽ trình bày ra đĩa nha.",
