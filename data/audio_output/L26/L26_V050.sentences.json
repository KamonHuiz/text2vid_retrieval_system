        "002025.webp",
        "002069.webp",
        "002070.webp",
        "002118.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bây giờ chúng ta sẽ đi làm nhân thịt bò để cuộn với rong biển.",
      "start": 86.48,
      "end": 90.08,
      "n_words": 15,
      "start_frame": 2162,
      "end_frame": 2252,
      "keyframes": [
        "002167.webp",
