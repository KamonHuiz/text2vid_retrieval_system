        "002941.webp",
        "002967.webp",
        "002993.webp",
        "002994.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ chúng ta sẽ cắt thanh cua nè, chia thanh cua làm hai phần ba nè, cái phần nguyên này các bạn sẽ cắt làm ba lát, một phần ba thì các bạn cũng sẽ cắt dọc luôn.",
      "start": 119.8,
      "end": 133.88,
      "n_words": 39,
      "start_frame": 2995,
      "end_frame": 3347,
      "keyframes": [
        "003028.webp",
