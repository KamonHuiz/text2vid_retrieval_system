        "002208.webp",
        "002249.webp",
        "002250.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chọn thịt bò xay có lẫn mỡ để giúp món ăn ngon hơn nha.",
      "start": 90.08,
      "end": 93.28,
      "n_words": 14,
      "start_frame": 2252,
      "end_frame": 2332,
      "keyframes": [
        "002288.webp",
        "002326.webp",
        "002327.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hành tây nè, các bạn sẽ đem vào đây hai muỗng canh gia vị nêm sẵn Ajinomoto, bột tẩm khô chiên giòn.",
      "start": 93.28,
      "end": 100.4,
      "n_words": 22,
      "start_frame": 2332,
      "end_frame": 2510,
      "keyframes": [
        "002362.webp",
        "002397.webp",
        "002398.webp",
        "002420.webp",
        "002443.webp",
        "002444.webp",
        "002477.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Dùng gói gia vị nêm sẵn Ajinomoto, bột tẩm khô chiên giòn để trộn nhân giúp món ăn tăng hương vị và ngon hơn.",
      "start": 100.4,
      "end": 106.36,
      "n_words": 24,
      "start_frame": 2510,
      "end_frame": 2659,
      "keyframes": [
        "002511.webp",
        "002512.webp",
        "002585.webp",
        "002658.webp",
        "002659.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp đấy là một muỗng canh dầu ăn và cuối cùng là một phần tư muỗng cà phê tiêu, trộn đều cái hỗn hợp này lên.",
      "start": 106.36,
      "end": 114.04,
      "n_words": 26,
      "start_frame": 2659,
      "end_frame": 2851,
      "keyframes": [
        "002659.webp",
