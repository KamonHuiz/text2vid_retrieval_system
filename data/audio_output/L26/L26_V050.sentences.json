        "004011.webp",
        "004012.webp",
        "004054.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chính xác luôn.",
      "start": 163.12,
      "end": 163.92,
      "n_words": 3,
      "start_frame": 4078,
      "end_frame": 4098,
      "keyframes": [
        "004097.webp",
        "004098.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đầu tiên các bạn sẽ cho ba muỗng canh sốt mayonnaise vị nguyên bản, một muỗng canh nước tương Phú Sĩ, một ít tỏi băm, cuối cùng là một phần tư muỗng cà phê tiêu rang thơm giã nhuyễn.",
      "start": 163.92,
      "end": 181.0,
      "n_words": 39,
      "start_frame": 4098,
      "end_frame": 4525,
      "keyframes": [
