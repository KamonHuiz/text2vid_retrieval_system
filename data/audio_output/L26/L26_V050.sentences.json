        "005264.webp",
        "005352.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chúng ta áp chảo ít dầu thôi để giảm cái độ béo, chúng ta cho ra giấy thấm dầu này.",
      "start": 214.08,
      "end": 221.72,
