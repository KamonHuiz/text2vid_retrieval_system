      "keyframes": [
        "000967.webp",
        "000968.webp",
        "001094.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 44.4,
      "end": 48.88,
      "n_words": 11,
      "start_frame": 1110,
      "end_frame": 1222,
      "keyframes": [
        "001220.webp",
        "001221.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và bây giờ trên bếp Quốc Ngày, sẵn sàng thịt bò nè, thanh cua nè, rong biển nè và hôm nay Quốc Ngày sẽ hướng dẫn Thanh Phương cùng các bạn khán giả thực hiện món bò cuộn rong biển.",
      "start": 48.88,
      "end": 59.12,
      "n_words": 40,
      "start_frame": 1222,
      "end_frame": 1478,
      "keyframes": [
        "001252.webp",
        "001284.webp",
        "001285.webp",
        "001321.webp",
        "001357.webp",
        "001358.webp",
        "001387.webp",
        "001416.webp",
        "001417.webp",
        "001455.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Rong biển và theo lời của chuyên gia dinh dưỡng Tiến sĩ Đào Thị Yến Phi thì món bò cuộn rong biển rất tốt cho việc xây dựng khối cơ xương ở người trưởng thành có tập thể dục từ mức độ trung bình đến nặng, trẻ đang giai đoạn tăng trưởng nhanh trong quá trình dậy thì đó nha.",
      "start": 59.12,
      "end": 75.44,
      "n_words": 60,
      "start_frame": 1478,
      "end_frame": 1886,
      "keyframes": [
        "001494.webp",
        "001495.webp",
        "001545.webp",
        "001596.webp",
        "001597.webp",
        "001669.webp",
        "001741.webp",
