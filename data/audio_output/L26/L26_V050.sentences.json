      "end": 137.92,
      "n_words": 10,
      "start_frame": 3347,
      "end_frame": 3448,
      "keyframes": [
        "003363.webp",
        "003384.webp",
        "003385.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn đặt cái phần nhám rong biển lên trên nè, cho một phần thịt bò vào, đặt hai thanh cua lên trên nè, ít thịt bò lên trên nữa rồi chúng ta sẽ cuộn lại.",
      "start": 137.92,
      "end": 150.88,
      "n_words": 36,
      "start_frame": 3448,
      "end_frame": 3772,
      "keyframes": [
        "003452.webp",
