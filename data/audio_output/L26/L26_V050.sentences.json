        "001845.webp",
        "001882.webp",
        "001883.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Nhờ Thanh Phương cắt hạt lựu hành tây nè, hành lá thì các bạn sẽ cắt nhỏ.",
      "start": 75.44,
      "end": 86.48,
      "n_words": 17,
      "start_frame": 1886,
