        "002795.webp",
        "002796.webp",
        "002825.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trong rong biển thì có chứa canxi và mangan giúp làm tăng mật độ xương và ngăn ngừa được tình trạng loãng xương.",
      "start": 114.04,
      "end": 119.8,
      "n_words": 23,
      "start_frame": 2851,
      "end_frame": 2995,
      "keyframes": [
        "002855.webp",
