        "005760.webp",
        "005794.webp",
        "005795.webp",
        "005815.webp",
        "005835.webp",
        "005836.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ chúng ta sẽ tắt lửa.",
      "start": 233.64,
      "end": 236.68,
      "n_words": 7,
      "start_frame": 5841,
      "end_frame": 5917,
      "keyframes": [
        "005863.webp",
        "005891.webp",
        "005892.webp",
        "005916.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Canh nè, thơm quá, hấp dẫn quá Dũng Hà.",
      "start": 236.68,
      "end": 240.76,
      "n_words": 9,
      "start_frame": 5917,
