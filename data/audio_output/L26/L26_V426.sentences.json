        "002832.webp",
        "002862.webp",
        "002863.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cà chua xong thì sẽ cho ra đĩa.",
      "start": 114.84,
      "end": 118.64,
      "n_words": 8,
      "start_frame": 2871,
      "end_frame": 2966,
      "keyframes": [
        "002942.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tiếp đến là một quả ớt hiểm, nếu mà thích ăn cay thì chúng ta có thể cho thêm, dập rau ôm hay còn gọi là ngò rí và ngò gai, chúng ta cũng sẽ cắt nhỏ để chút nữa chúng ta cho vào canh.",
      "start": 118.64,
      "end": 131.28,
      "n_words": 45,
      "start_frame": 2966,
      "end_frame": 3282,
      "keyframes": [
        "003021.webp",
