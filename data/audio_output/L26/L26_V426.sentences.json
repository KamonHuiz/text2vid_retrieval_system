        "001370.webp",
        "001371.webp",
        "001458.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Mến chào các bạn khán giả của chương trình Món ngon mỗi ngày.",
      "start": 61.72,
      "end": 64.24,
      "n_words": 13,
      "start_frame": 1543,
      "end_frame": 1606,
      "keyframes": [
        "001546.webp",
        "001547.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 64.24,
      "end": 68.24,
      "n_words": 11,
      "start_frame": 1606,
      "end_frame": 1706,
      "keyframes": [
        "001627.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên là cá rô đã làm sạch ruột nè, đánh sạch vảy nè, rồi sau đó mình rửa qua một lớp nước muối để khử bớt tanh đúng không?",
      "start": 68.24,
      "end": 76.52,
      "n_words": 30,
      "start_frame": 1706,
      "end_frame": 1913,
      "keyframes": [
        "001708.webp",
        "001709.webp",
        "001723.webp",
        "001738.webp",
        "001739.webp",
        "001825.webp",
        "001911.webp",
        "001912.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Khứa lên thân cá mỗi bên một đường như thế này giúp cho cá mau chín.",
      "start": 76.52,
      "end": 80.56,
      "n_words": 16,
