      "end_frame": 928,
      "keyframes": [
        "000845.webp",
        "000846.webp",
        "000885.webp",
        "000925.webp",
        "000926.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Vậy thì bây giờ mình bắt tay thực hiện thôi nhé.",
      "start": 37.12,
      "end": 39.0,
      "n_words": 11,
      "start_frame": 928,
      "end_frame": 975,
      "keyframes": [
        "000954.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vào bếp canh cá rô bông súng ngon đúng điệu, dịu vị đồng quê.",
      "start": 39.0,
      "end": 61.72,
      "n_words": 14,
      "start_frame": 975,
      "end_frame": 1543,
      "keyframes": [
        "000983.webp",
        "000984.webp",
        "001008.webp",
