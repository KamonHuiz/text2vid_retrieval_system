        "003396.webp",
        "003430.webp",
        "003431.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Dũng Hà chuẩn bị giúp Nghị một cái nồi thật là xinh.",
      "start": 137.24,
      "end": 139.6,
      "n_words": 12,
      "start_frame": 3431,
      "end_frame": 3490,
      "keyframes": [
        "003431.webp",
        "003458.webp",
        "003485.webp",
        "003486.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nồi đã nóng thì Quốc Nghị sẽ cho vào đây một lượng dầu kha khá nhỏ nha.",
      "start": 139.6,
      "end": 145.28,
      "n_words": 17,
      "start_frame": 3490,
      "end_frame": 3632,
      "keyframes": [
        "003575.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Sau khi dầu ăn đã nóng, Quốc Nghị sẽ cho vào đây khoảng một muỗng canh tỏi, chúng ta sẽ phi thơm tỏi.",
      "start": 145.28,
      "end": 150.56,
      "n_words": 23,
      "start_frame": 3632,
      "end_frame": 3764,
      "keyframes": [
        "003664.webp",
        "003665.webp",
        "003687.webp",
        "003709.webp",
        "003710.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thơm ha, wow!",
      "start": 150.56,
      "end": 153.24,
      "n_words": 3,
      "start_frame": 3764,
      "end_frame": 3831,
      "keyframes": [
        "003765.webp",
        "003821.webp",
        "003822.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ đảo đều cho nó vàng, nó dậy mùi tỏi lên.",
      "start": 153.24,
      "end": 157.24,
      "n_words": 13,
      "start_frame": 3831,
      "end_frame": 3931,
      "keyframes": [
        "003877.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Quốc Nghị sẽ tắt lửa nè, sẽ múc cái lượng dầu tỏi lên tay con cá, mình rưới một ít dầu tỏi như vậy để cho cái da của con cá nó săn lại.",
      "start": 157.24,
      "end": 168.52,
      "n_words": 34,
      "start_frame": 3931,
      "end_frame": 4213,
      "keyframes": [
        "003932.webp",
