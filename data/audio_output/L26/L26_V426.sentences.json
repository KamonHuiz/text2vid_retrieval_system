        "004925.webp",
        "004968.webp",
        "004969.webp",
        "004998.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Việc cho giấm vào nấu chung với cá giúp khử mùi và làm cho món canh thơm hơn.",
      "start": 203.56,
      "end": 209.16,
