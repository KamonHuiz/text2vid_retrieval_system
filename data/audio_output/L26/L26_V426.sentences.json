        "004184.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Đúng không ta?",
      "start": 168.52,
      "end": 169.44,
      "n_words": 3,
      "start_frame": 4213,
      "end_frame": 4236,
      "keyframes": [
        "004225.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cũng đúng một phần thôi Dũng Hà.",
      "start": 169.44,
      "end": 170.68,
      "n_words": 7,
      "start_frame": 4236,
      "end_frame": 4267,
      "keyframes": [
        "004266.webp",
        "004267.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đây cũng là một cái mẹo nhỏ, việc chúng ta ướp dầu phi tỏi lên cá giúp cho khử mùi tanh của cá.",
      "start": 170.68,
      "end": 175.12,
      "n_words": 23,
      "start_frame": 4267,
      "end_frame": 4378,
      "keyframes": [
        "004267.webp",
        "004333.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đối với phần dầu và tỏi còn lại trong nồi, Quốc Nghị sẽ cho cà chua này và ớt xắt vào, rồi chúng ta sẽ cho vào đây một lít hai nước.",
      "start": 176.0,
      "end": 183.84,
      "n_words": 32,
