        "004499.webp",
        "004542.webp",
        "004543.webp",
        "004567.webp",
        "004592.webp",
        "004593.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Phần nước canh của chúng ta đã sôi, Quốc Nghị sẽ cho cá vào từ từ, chúng ta không nên lấy cái phần dầu này vì canh chúng ta không nên quá béo đó Dũng Hà.",
      "start": 183.84,
      "end": 193.48,
      "n_words": 36,
      "start_frame": 4596,
      "end_frame": 4837,
      "keyframes": [
        "004618.webp",
        "004644.webp",
        "004645.webp",
        "004670.webp",
        "004695.webp",
        "004696.webp",
        "004739.webp",
        "004783.webp",
        "004784.webp",
        "004814.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Rồi sau khi cho cá vào nấu canh, Quốc Nghị sẽ đem vào đây hai muỗng cà phê muối, bốn muỗng canh giấm gạo lên men Lisa.",
      "start": 193.48,
      "end": 200.64,
      "n_words": 27,
      "start_frame": 4837,
      "end_frame": 5016,
      "keyframes": [
        "004844.webp",
