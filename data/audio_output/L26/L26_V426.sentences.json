        "002712.webp",
        "002736.webp",
        "002737.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đến là cà chua sẽ cắt thành miếng cau như thế này.",
      "start": 110.92,
      "end": 114.84,
      "n_words": 12,
      "start_frame": 2773,
      "end_frame": 2871,
      "keyframes": [
        "002801.webp",
