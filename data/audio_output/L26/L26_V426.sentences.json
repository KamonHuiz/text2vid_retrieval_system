        "005615.webp",
        "005653.webp",
        "005654.webp",
        "005690.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Một muỗng cà phê đường, chua là phải có ngọt, đúng rồi, cho vào đây một muỗng canh nước mắm.",
      "start": 228.88,
