      "end_frame": 2014,
      "keyframes": [
        "001942.webp",
        "001973.webp",
        "001974.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ủa mình chỉ khứa có một đường thôi hả?",
      "start": 80.56,
      "end": 82.0,
      "n_words": 9,
      "start_frame": 2014,
      "end_frame": 2050,
      "keyframes": [
        "002035.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Thôi cô ta lại nghĩ là khứa hai ba đường giống như là chúng ta hay làm những loại cá khác, chứ kích thước như thế này thì mình khứa hai đường, khi nấu nó sẽ dễ bị nát cá.",
      "start": 82.0,
      "end": 89.84,
      "n_words": 40,
      "start_frame": 2050,
      "end_frame": 2246,
      "keyframes": [
        "002096.webp",
        "002097.webp",
        "002115.webp",
        "002134.webp",
        "002135.webp",
        "002175.webp",
        "002215.webp",
        "002216.webp",
        "002232.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Thân cây súng chúng ta sẽ rửa sạch và cắt thành những khúc khoảng 5 centimet như thế này rồi sẽ cho ra dĩa.",
      "start": 89.84,
      "end": 98.36,
      "n_words": 24,
      "start_frame": 2246,
      "end_frame": 2459,
      "keyframes": [
        "002248.webp",
        "002249.webp",
        "002295.webp",
        "002341.webp",
        "002342.webp",
        "002367.webp",
        "002393.webp",
        "002394.webp",
        "002428.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Thấy được nấu canh chua là mình đã mê lắm rồi.",
      "start": 98.36,
      "end": 100.76,
      "n_words": 11,
      "start_frame": 2459,
      "end_frame": 2519,
      "keyframes": [
        "002463.webp",
        "002464.webp",
        "002490.webp",
        "002516.webp",
        "002517.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Kỳ này chúng ta sẽ lột bỏ cái phần vỏ như thế này nè và cũng sẽ cắt 5 cm bằng thân cây hoa súng.",
      "start": 100.76,
      "end": 110.6,
      "n_words": 25,
      "start_frame": 2519,
      "end_frame": 2765,
      "keyframes": [
        "002602.webp",
