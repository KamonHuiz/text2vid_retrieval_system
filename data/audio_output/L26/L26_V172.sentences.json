        "003969.webp",
        "003990.webp",
        "003991.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Vừa xanh như thế này thì mình sẽ vớt ra.",
      "start": 159.72,
      "end": 161.84,
      "n_words": 10,
      "start_frame": 3993,
      "end_frame": 4046,
      "keyframes": [
        "004018.webp",
        "004045.webp",
        "004046.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Với lá nhàu thì nó có công dụng là giúp nhuận tràng nè, có thể là phòng chống được đau lưng và làm mát cơ thể nữa đó.",
      "start": 161.84,
      "end": 170.32,
      "n_words": 28,
      "start_frame": 4046,
      "end_frame": 4258,
      "keyframes": [
