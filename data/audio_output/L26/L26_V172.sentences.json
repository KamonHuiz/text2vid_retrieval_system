        "001864.webp",
        "001876.webp",
        "001877.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Phần mít sau khi ngâm mềm rồi cắt khúc cho cô khoảng chừng 3 phân.",
      "start": 75.2,
      "end": 81.64,
      "n_words": 15,
