        "003627.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ thì dầu nóng rồi đó, chúng ta sẽ cho cái phần lá nhàu mà mình đã cắt sợi vào đây, mình sẽ chiên lên, vớt ra để chút mình sẽ trang trí.",
      "start": 146.08,
      "end": 154.64,
      "n_words": 34,
      "start_frame": 3652,
      "end_frame": 3866,
      "keyframes": [
        "003658.webp",
