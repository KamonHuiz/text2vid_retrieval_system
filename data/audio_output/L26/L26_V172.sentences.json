        "002865.webp",
        "002866.webp",
        "002906.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cũng sẽ cắt khối giống như là chuối vậy đó.",
      "start": 118.96,
      "end": 121.2,
      "n_words": 10,
      "start_frame": 2974,
