        "005107.webp",
        "005130.webp",
        "005131.webp",
        "005165.webp",
        "005199.webp",
        "005200.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta sẽ xào nấm rơm và mì căn này khoảng chừng một phút thôi để cho nó thơm.",
      "start": 208.2,
      "end": 214.08,
