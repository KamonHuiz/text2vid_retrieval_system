        "003568.webp",
        "003569.webp",
        "003582.webp"
      ],
      "keyframe_count": 27
    },
    {
      "text": "Em cho cô một cái chảo dầu lên trên bếp.",
      "start": 143.6,
      "end": 146.08,
      "n_words": 10,
      "start_frame": 3590,
