        "005034.webp",
        "005035.webp",
        "005059.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Tiếp tục mình cho nấm rơm, mì căn đã chiên vô xào chung luôn.",
      "start": 202.88,
      "end": 208.2,
      "n_words": 14,
