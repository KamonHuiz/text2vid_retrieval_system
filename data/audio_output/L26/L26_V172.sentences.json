        "002220.webp",
        "002268.webp",
        "002269.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Ướp tiêu vào nấm mèo sau khi cắt để át đi mùi gỗ mục của nấm nha.",
      "start": 90.76,
      "end": 95.4,
