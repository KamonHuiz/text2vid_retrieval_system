        "004788.webp",
        "004822.webp",
        "004823.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mình thêm vào đây là hai muỗng canh dầu điều, đợi cho dầu nóng nóng thì bây giờ mình sẽ cho vào đây là sả cắt khúc đập dập, cho vào đây là tỏi băm.",
      "start": 192.92,
      "end": 202.88,
      "n_words": 35,
      "start_frame": 4823,
      "end_frame": 5072,
      "keyframes": [
