        "004176.webp",
        "004252.webp",
        "004253.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Sau khi mình chiên xong rồi thì bây giờ mình sẽ để ra để cho cái lá này nó thấm dầu.",
      "start": 170.32,
