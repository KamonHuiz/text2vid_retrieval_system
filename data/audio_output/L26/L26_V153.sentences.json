      "n_words": 12,
      "start_frame": 3658,
      "end_frame": 3724,
      "keyframes": [
        "003695.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi nước sôi rồi đó, Kim Thảo dở nắp giúp cô.",
      "start": 148.96,
      "end": 151.92,
      "n_words": 11,
