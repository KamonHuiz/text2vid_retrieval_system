        "001639.webp",
        "001640.webp",
        "001679.webp",
        "001719.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Món ăn ngày hôm nay của chúng ta sẽ có tên là mọc cốm chiên giòn.",
      "start": 68.76,
      "end": 72.96,
      "n_words": 16,
