        "003298.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thảo em đã chuẩn bị cho cô Hà một cái nồi nước sôi để có thể hấp được đây.",
      "start": 132.0,
      "end": 138.44,
