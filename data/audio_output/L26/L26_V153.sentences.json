        "001771.webp",
        "001822.webp",
        "001823.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta trộn cái phần nhân của mọc ha, rồi mình sẽ cho vào cái tô này đây.",
      "start": 72.96,
      "end": 77.88,
      "n_words": 18,
