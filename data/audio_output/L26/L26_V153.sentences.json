        "001918.webp",
        "001940.webp",
        "001941.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Gồm có mọc tức là giò sống khoảng 50g, tai heo chúng ta luộc chín và cắt nhỏ như thế này.",
      "start": 77.88,
      "end": 83.84,
