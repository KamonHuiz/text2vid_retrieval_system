      "start_frame": 345,
      "end_frame": 398,
      "keyframes": [
        "000371.webp",
        "000398.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trời ơi anh nhìn cái gian bếp hôm nay gọn gàng là anh hiểu rồi, Phương được anh ha.",
      "start": 15.92,
