        "000515.webp",
        "000528.webp",
        "000529.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Anh em thấy nè, có rất là nhiều nồi ở trong bếp.",
      "start": 22.24,
      "end": 25.44,
      "n_words": 12,
      "start_frame": 556,
