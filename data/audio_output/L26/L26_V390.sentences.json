      "end_frame": 724,
      "keyframes": [
        "000676.webp",
        "000718.webp",
        "000719.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nui mình trưng bày nhiều lúc mình quên á, dạ mà cái này anh thấy còn ngon dạ.",
      "start": 28.96,
      "end": 32.56,
      "n_words": 18,
      "start_frame": 724,
      "end_frame": 814,
      "keyframes": [
        "000762.webp",
        "000805.webp",
        "000806.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, bây giờ mình làm món gì đây ta?",
