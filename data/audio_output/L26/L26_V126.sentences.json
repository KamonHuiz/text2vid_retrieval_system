        "000814.webp",
        "000904.webp",
        "000905.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 41.0,
      "end": 44.84,
      "n_words": 11,
      "start_frame": 1025,
      "end_frame": 1121,
      "keyframes": [
        "001049.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nhìn nguyên liệu trên bàn, Phương nghĩ hôm nay mình sẽ nấu cái gì nào?",
      "start": 45.28,
      "end": 47.8,
      "n_words": 15,
      "start_frame": 1132,
      "end_frame": 1195,
      "keyframes": [
        "001194.webp",
        "001195.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trời ơi, xin lỗi, nãy giờ Thanh Phương để là đĩa rau mà có rất là nhiều hoa trên đó luôn nha, chắc là món lẩu đúng không?",
      "start": 47.8,
      "end": 53.44,
      "n_words": 28,
      "start_frame": 1195,
      "end_frame": 1336,
      "keyframes": [
        "001195.webp",
        "001219.webp",
        "001244.webp",
        "001245.webp",
        "001294.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đúng rồi.",
      "start": 53.44,
      "end": 53.84,
      "n_words": 2,
      "start_frame": 1336,
      "end_frame": 1346,
      "keyframes": [
        "001344.webp",
        "001345.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cá kèo thì xin cũng đã tranh thủ đi mua và làm sạch trước rồi.",
      "start": 53.84,
      "end": 56.8,
      "n_words": 15,
      "start_frame": 1346,
      "end_frame": 1420,
      "keyframes": [
        "001383.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn nên nhớ đối với món này chúng ta nên chọn cá kèo tự nhiên để món ăn được ngọt và thơm hơn nha.",
      "start": 56.8,
      "end": 61.6,
      "n_words": 25,
      "start_frame": 1420,
      "end_frame": 1540,
      "keyframes": [
        "001421.webp",
        "001422.webp",
        "001478.webp",
        "001534.webp",
        "001535.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rau nè, mình thích rau gì thì mình mua rau đó, tùy vào khẩu vị gia đình của chúng ta ha. Tiếp theo, xin mời cà chua nè, thơm và hai trái ớt hiểm.",
      "start": 61.6,
      "end": 69.96,
      "n_words": 34,
      "start_frame": 1540,
      "end_frame": 1749,
      "keyframes": [
        "001574.webp",
        "001613.webp",
        "001614.webp",
        "001641.webp",
        "001669.webp",
        "001670.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Kèm theo cái phần rau nêm bên đó thì nhờ Phương là nhặt cái lá quế và chúng ta sẽ cắt nhuyễn ra để chúng ta nêm vào cái nồi lẩu sau khi nấu xong.",
      "start": 69.96,
      "end": 77.64,
      "n_words": 35,
      "start_frame": 1749,
      "end_frame": 1941,
      "keyframes": [
        "001786.webp",
        "001902.webp",
        "001903.webp",
        "001932.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Lại cà chua này thì chúng ta sẽ cắt múi cau, phần thơm này thì chúng ta sẽ cắt rẻ quạt nha.",
      "start": 77.64,
      "end": 98.28,
      "n_words": 22,
      "start_frame": 1941,
      "end_frame": 2457,
      "keyframes": [
        "001962.webp",
