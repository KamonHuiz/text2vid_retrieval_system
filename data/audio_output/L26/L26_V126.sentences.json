      "keyframes": [
        "004563.webp",
        "004564.webp",
        "004678.webp",
        "004792.webp",
        "004793.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Muốn xào đũa thì có nhiều vitamin C nè, tăng cường hệ miễn dịch cho cơ thể, còn có cả bông bí nữa.",
      "start": 193.0,
      "end": 198.24,
      "n_words": 23,
      "start_frame": 4825,
      "end_frame": 4956,
      "keyframes": [
        "004858.webp",
        "004924.webp",
        "004925.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trời ơi, những ai mà thích ăn những cái món bông như thế này là cái món lẩu này rất là hợp khẩu vị luôn, vừa đẹp nè, vừa thơm ngon lại vừa dinh dưỡng, giảm cân nữa nha.",
      "start": 198.24,
      "end": 207.24,
      "n_words": 39,
      "start_frame": 4956,
      "end_frame": 5181,
      "keyframes": [
        "004959.webp",
        "004994.webp",
        "004995.webp",
        "005084.webp",
        "005173.webp",
        "005174.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi bây giờ cái phần nước đã sôi lại ha, xin sẽ cho mỗi thứ một nửa vào trước.",
      "start": 207.24,
      "end": 212.64,
      "n_words": 19,
      "start_frame": 5181,
      "end_frame": 5316,
      "keyframes": [
        "005244.webp",
        "005315.webp",
        "005316.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho một ít bông bí vào nè, rau nhúc vào, xua đũa vào, bông điên điển nữa.",
      "start": 212.64,
      "end": 220.92,
      "n_words": 17,
      "start_frame": 5316,
      "end_frame": 5523,
      "keyframes": [
        "005316.webp",
        "005342.webp",
        "005368.webp",
