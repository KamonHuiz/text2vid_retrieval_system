        "002630.webp",
        "002654.webp",
        "002655.webp",
        "002675.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Xin ơi, Phương rất là thích ăn cá kèo luôn á, nhưng mà cái công đoạn mà mình sơ chế làm sao để cho sạch, đừng có bị nhớt á.",
      "start": 107.64,
      "end": 112.88,
      "n_words": 30,
      "start_frame": 2691,
      "end_frame": 2822,
      "keyframes": [
        "002695.webp",
        "002696.webp",
        "002755.webp",
        "002815.webp",
        "002816.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ dùng nước đá, nước lạnh, chúng ta ngâm cái phần cá kèo này vào thì cá sẽ không còn dảy nữa.",
      "start": 112.88,
      "end": 117.2,
      "n_words": 24,
      "start_frame": 2822,
      "end_frame": 2930,
      "keyframes": [
        "002871.webp",
        "002926.webp",
        "002927.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sau đó thì chúng ta sẽ vớt ra và cho vào nước giấm thật là chua thì cái phần nhớt ở bên ngoài sẽ đục lại và chúng ta dễ tuốt ra hơn.",
      "start": 117.2,
      "end": 124.0,
      "n_words": 33,
      "start_frame": 2930,
      "end_frame": 3100,
      "keyframes": [
        "002942.webp",
