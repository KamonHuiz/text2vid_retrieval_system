        "005653.webp",
        "005684.webp",
        "005685.webp",
        "005733.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Không thể nào thiếu những loại rau thơm này được, chúng ta sẽ cho một ít vào và bây giờ chúng ta sẽ tắt lửa nồi lẩu này ha.",
      "start": 230.96,
      "end": 237.24,
      "n_words": 29,
      "start_frame": 5774,
      "end_frame": 5931,
      "keyframes": [
        "005781.webp",
        "005782.webp",
        "005828.webp",
        "005874.webp",
        "005875.webp",
        "005927.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ chuyển sang một nồi lẩu khác và ngồi ăn với nhau xem nó ngon như thế nào. Sẵn sàng!",
      "start": 237.24,
      "end": 241.68,
      "n_words": 22,
      "start_frame": 5931,
      "end_frame": 6042,
      "keyframes": [
        "005980.webp",
        "005981.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và các bạn ơi, các bạn có thể quét mã QR để xem lại công thức của món ăn ngày hôm nay nhé.",
      "start": 241.68,
      "end": 247.84,
      "n_words": 23,
      "start_frame": 6042,
      "end_frame": 6196,
      "keyframes": [
        "006066.webp",
        "006151.webp",
        "006152.webp",
        "006176.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi bây giờ xin phép múc ra ngoài bên cái nồi lẩu này nha, cho thêm một miếng nước lẩu nữa nha.",
