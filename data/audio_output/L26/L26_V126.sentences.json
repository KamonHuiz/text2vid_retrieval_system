      "end_frame": 2604,
      "keyframes": [
        "002462.webp",
        "002463.webp",
        "002534.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Xin chuẩn bị cái nồi nước dùng gà nè, Phương mở lửa lên.",
      "start": 104.16,
      "end": 107.64,
      "n_words": 13,
      "start_frame": 2604,
      "end_frame": 2691,
      "keyframes": [
        "002605.webp",
