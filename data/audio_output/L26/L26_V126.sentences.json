        "000299.webp",
        "000300.webp",
        "000355.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sơ chế ngay nhé. Chào các bạn khán giả đang theo dõi chương trình Món ngon mỗi ngày, nấu chuẩn an lành.",
      "start": 14.8,
      "end": 41.0,
      "n_words": 22,
      "start_frame": 370,
