        "003044.webp",
        "003071.webp",
        "003072.webp",
        "003092.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Sau đó chúng ta rửa với vòi nước lạnh và với muối lại thì cá sẽ không còn nhớt và trơn nữa.",
      "start": 124.0,
      "end": 127.84,
      "n_words": 22,
      "start_frame": 3100,
      "end_frame": 3196,
      "keyframes": [
        "003113.webp",
        "003114.webp",
        "003137.webp",
