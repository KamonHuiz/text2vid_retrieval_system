        "000497.webp",
        "000498.webp",
        "000523.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đây là bếp Quốc Nghị đây.",
      "start": 21.0,
      "end": 22.04,
      "n_words": 6,
      "start_frame": 525,
      "end_frame": 551,
      "keyframes": [
        "000549.webp",
        "000550.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cái bánh bao nhà mua này phải không? Có đúng không?",
      "start": 22.04,
      "end": 23.92,
      "n_words": 11,
      "start_frame": 551,
      "end_frame": 598,
      "keyframes": [
        "000578.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ok, mà sao anh chuẩn bị nấm với cá chẻm chi vậy?",
      "start": 23.92,
      "end": 26.84,
      "n_words": 12,
      "start_frame": 598,
      "end_frame": 671,
      "keyframes": [
        "000607.webp",
        "000608.webp",
        "000625.webp",
        "000642.webp",
        "000643.webp",
        "000654.webp",
        "000666.webp",
        "000667.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Thì gói chả giò, chả giò thường em nhớ nha là phải thịt xay nè hoặc là tôm nè, rồi các loại rau củ mình hái nữa mình trộn lên mình cuốn.",
      "start": 26.84,
      "end": 33.68,
      "n_words": 32,
      "start_frame": 671,
      "end_frame": 842,
      "keyframes": [
        "000681.webp",
        "000696.webp",
        "000697.webp",
        "000768.webp",
        "000839.webp",
        "000840.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thì bây giờ anh làm chả giò từ cá chẻm mà nấm có được không? Hay vậy!",
      "start": 33.68,
      "end": 37.56,
      "n_words": 17,
      "start_frame": 842,
      "end_frame": 939,
      "keyframes": [
        "000877.webp",
        "000914.webp",
        "000915.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ừ, cái món này sẽ gói gọn cả biển trời yêu thương dành cho mày, bắt tay vào làm ngay nhé.",
      "start": 37.56,
      "end": 43.2,
      "n_words": 21,
      "start_frame": 939,
      "end_frame": 1080,
      "keyframes": [
        "000958.webp",
        "001002.webp",
