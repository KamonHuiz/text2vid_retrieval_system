        "000380.webp",
        "000405.webp",
        "000406.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Anh ca sĩ Minh Phương à, anh làm cái gì trong bếp của anh Nghị đây?",
      "start": 16.24,
      "end": 21.0,
      "n_words": 16,
      "start_frame": 406,
      "end_frame": 525,
      "keyframes": [
        "000406.webp",
