        "004867.webp",
        "004868.webp",
        "004912.webp"
      ],
      "keyframe_count": 22
    },
    {
      "text": "Cái nhanh quá, giỏi trời, vừa ý luôn, quá xuất sắc rồi!",
      "start": 197.84,
      "end": 202.68,
      "n_words": 12,
