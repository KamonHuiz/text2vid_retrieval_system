        "002827.webp",
        "002858.webp",
        "002890.webp",
        "002891.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Cái phần gừng nè nó cũng sẽ giúp cho đẩy mùi tanh của cá rất là tốt lắm.",
      "start": 115.64,
      "end": 119.6,
      "n_words": 18,
      "start_frame": 2891,
      "end_frame": 2990,
      "keyframes": [
