        "002521.webp",
        "002568.webp",
        "002569.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Chúng ta cho thêm giấm vào có tác dụng gì hết nhỉ?",
      "start": 102.84,
      "end": 106.0,
      "n_words": 12,
      "start_frame": 2571,
      "end_frame": 2650,
      "keyframes": [
        "002604.webp",
        "002639.webp",
        "002640.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ướp giấm vào thì cá giúp tạo vị hấp dẫn cho món ăn.",
      "start": 106.0,
      "end": 109.04,
      "n_words": 13,
      "start_frame": 2650,
      "end_frame": 2726,
      "keyframes": [
        "002682.webp",
        "002724.webp",
        "002725.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho tiếp một ít tiêu sọ nữa, một muỗng canh ớt sừng cắt sợi và một muỗng cà phê gừng cắt sợi.",
      "start": 109.04,
      "end": 115.64,
      "n_words": 22,
      "start_frame": 2726,
      "end_frame": 2891,
      "keyframes": [
        "002749.webp",
