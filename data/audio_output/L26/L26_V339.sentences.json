        "001026.webp",
        "001049.webp",
        "001050.webp",
        "001072.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Ok bạn, chả giò nấm cá giòn tan, ngọt vị.",
      "start": 43.2,
      "end": 65.12,
      "n_words": 10,
      "start_frame": 1080,
      "end_frame": 1628,
      "keyframes": [
        "001095.webp",
