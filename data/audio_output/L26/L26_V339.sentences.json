        "003829.webp",
        "003860.webp",
        "003861.webp",
        "003896.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nấm chúng ta sẽ vuốt hai bên, vuốt bên trái, chúng ta sẽ quét một lớp trứng gà đã đánh tan.",
      "start": 157.04,
      "end": 165.72,
      "n_words": 21,
