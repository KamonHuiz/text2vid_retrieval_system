        "005050.webp",
        "005051.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ là đã xong, bật một chảo dầu và chiên.",
      "start": 202.68,
      "end": 205.72,
      "n_words": 11,
      "start_frame": 5067,
