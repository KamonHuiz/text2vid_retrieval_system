        "001383.webp",
        "001455.webp",
        "001456.webp",
        "001542.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Mến chào các bạn khán giả đang theo dõi chương trình Món ngon mỗi ngày.",
      "start": 65.12,
      "end": 68.2,
      "n_words": 15,
      "start_frame": 1628,
      "end_frame": 1705,
      "keyframes": [
        "001629.webp",
        "001630.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 68.2,
      "end": 72.04,
      "n_words": 11,
      "start_frame": 1705,
      "end_frame": 1801,
      "keyframes": [
        "001718.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cái phần cá nè chúng ta sẽ cắt con chì, tức là mình sẽ cắt thanh bằng cái ngón tay út của mình á.",
      "start": 72.04,
      "end": 80.24,
      "n_words": 24,
      "start_frame": 1801,
      "end_frame": 2006,
      "keyframes": [
        "001807.webp",
        "001808.webp",
        "001852.webp",
        "001896.webp",
        "001897.webp",
        "001977.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Như Minh Phương được biết là phần cá rất là dai nè, ngọt và chắc và lại rất là nhiều dinh dưỡng nữa đúng không ạ?",
      "start": 80.44,
      "end": 87.36,
      "n_words": 26,
      "start_frame": 2011,
      "end_frame": 2184,
      "keyframes": [
        "002057.webp",
        "002058.webp",
        "002095.webp",
        "002133.webp",
        "002134.webp",
        "002168.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi, chính xác luôn.",
      "start": 87.36,
      "end": 88.4,
      "n_words": 5,
      "start_frame": 2184,
      "end_frame": 2210,
      "keyframes": [
        "002203.webp",
        "002204.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi cái phần cá chúng ta cắt khúc như thế này thì Quốc Nghị sẽ ướp vào đây nửa muỗng cà phê hạt nêm Ajinomoto ngon heo cho nó thấm vào cá, một phần ba muỗng cà phê bột ngọt Ajinomoto, tiếp tục là một muỗng cà phê giấm gạo lên men Ajinomoto.",
      "start": 88.4,
      "end": 102.84,
      "n_words": 53,
      "start_frame": 2210,
      "end_frame": 2571,
      "keyframes": [
        "002234.webp",
