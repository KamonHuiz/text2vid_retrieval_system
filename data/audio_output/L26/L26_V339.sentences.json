      "end": 148.96,
      "n_words": 10,
      "start_frame": 3664,
      "end_frame": 3724,
      "keyframes": [
        "003692.webp",
        "003724.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ thì chúng ta sẽ gói chả giò.",
