        "004406.webp",
        "004407.webp",
        "004431.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dĩa thử thách dành cho Phương đó.",
      "start": 177.84,
      "end": 179.72,
      "n_words": 7,
      "start_frame": 4446,
      "end_frame": 4493,
      "keyframes": [
