      "start_frame": 3724,
      "end_frame": 3797,
      "keyframes": [
        "003724.webp",
        "003725.webp",
        "003761.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đặt vào đây nè, rồi một lá cải, không quên cái phần rau gừng đúng không?",
      "start": 151.88,
      "end": 157.04,
