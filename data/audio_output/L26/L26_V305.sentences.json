      "end": 31.92,
      "n_words": 8,
      "start_frame": 745,
      "end_frame": 798,
      "keyframes": [
        "000775.webp",
        "000776.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Nếu mà ăn lẩu thì em bỏ nhiều trước à?",
