        "001408.webp",
        "001409.webp",
        "001495.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Hân hoan chào đón các bạn khán giả đang xem chương trình Món ngon mỗi ngày.",
      "start": 61.44,
      "end": 66.52,
      "n_words": 16,
      "start_frame": 1536,
      "end_frame": 1663,
      "keyframes": [
        "001582.webp",
        "001583.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 66.52,
      "end": 70.16,
      "n_words": 11,
      "start_frame": 1663,
      "end_frame": 1754,
      "keyframes": [
        "001669.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên nhờ MC Minh Tuấn đó là luộc cái bánh gạo này trước.",
      "start": 70.16,
      "end": 73.76,
      "n_words": 14,
      "start_frame": 1754,
      "end_frame": 1844,
      "keyframes": [
        "001755.webp",
