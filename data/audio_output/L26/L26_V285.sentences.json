        "003670.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Bên đây là bánh gạo nó nổi lên rồi nè, nó nở ra gấp đôi luôn đó.",
      "start": 147.64,
      "end": 151.76,
