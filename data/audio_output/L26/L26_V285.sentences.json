        "004789.webp",
        "004826.webp",
        "004827.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Xào thơm lên, sau đó cho thịt gà vào, chúng ta xào rồi chúng ta xào cho gà vừa chín nha.",
      "start": 193.08,
