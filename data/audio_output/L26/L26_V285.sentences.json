  "total_words": 957,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày. Em chào anh Vũ Tấn, tới rồi hả em?",
      "start": 10.56,
      "end": 13.68,
      "n_words": 13,
      "start_frame": 264,
      "end_frame": 342,
      "keyframes": [
        "000299.webp",
        "000300.webp",
        "000340.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phụ anh làm món ăn ngày hôm nay với.",
      "start": 13.68,
      "end": 15.2,
      "n_words": 9,
      "start_frame": 342,
      "end_frame": 380,
      "keyframes": [
        "000380.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vô anh Nam, mình làm món gì?",
      "start": 15.2,
      "end": 16.4,
      "n_words": 7,
      "start_frame": 380,
      "end_frame": 410,
      "keyframes": [
        "000380.webp",
        "000381.webp",
        "000401.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hoàng đại còn một nguyên liệu nữa anh chưa đem kịp, đố em nguyên liệu đó là gì nè?",
      "start": 16.4,
      "end": 20.04,
      "n_words": 19,
      "start_frame": 410,
      "end_frame": 501,
      "keyframes": [
        "000422.webp",
        "000423.webp",
        "000460.webp",
        "000498.webp",
        "000499.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nghe, lắng nghe nè, nghe vô lắng nghe nha.",
      "start": 20.04,
      "end": 22.12,
      "n_words": 9,
      "start_frame": 501,
      "end_frame": 553,
      "keyframes": [
        "000530.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ, thân em vừa trắng lại vừa thon?",
      "start": 22.12,
      "end": 24.32,
      "n_words": 8,
      "start_frame": 553,
      "end_frame": 608,
      "keyframes": [
        "000561.webp",
        "000562.webp",
        "000586.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh ngưng ra chỗ đó luôn đi.",
      "start": 24.32,
      "end": 25.48,
      "n_words": 7,
      "start_frame": 608,
      "end_frame": 637,
      "keyframes": [
        "000610.webp",
        "000611.webp",
        "000623.webp",
        "000635.webp",
        "000636.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Là bánh trôi nước đúng không anh?",
