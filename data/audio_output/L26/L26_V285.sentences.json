        "003962.webp",
        "003963.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chúng ta nêm vào trong bánh gạo nêm Aji-ngon gà để cho bánh gạo có vị vừa ăn hơn.",
      "start": 158.92,
      "end": 164.08,
