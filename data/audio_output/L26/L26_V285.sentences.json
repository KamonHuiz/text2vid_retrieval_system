        "001082.webp",
        "001083.webp",
        "001107.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bánh gạo cay có ngay tức khắc!",
      "start": 45.08,
      "end": 61.44,
      "n_words": 7,
      "start_frame": 1127,
      "end_frame": 1536,
