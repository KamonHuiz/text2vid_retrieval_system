        "001779.webp",
        "001803.webp",
        "001804.webp",
        "001844.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ủa tại sao mình lại phải luộc trước anh?",
      "start": 73.76,
      "end": 75.36,
      "n_words": 9,
      "start_frame": 1844,
      "end_frame": 1884,
      "keyframes": [
        "001844.webp",
        "001884.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Để khi chúng ta xào thì bánh gạo sẽ mềm hơn, thấm gia vị hơn, chúng ta ăn sẽ ngon hơn.",
      "start": 75.36,
      "end": 80.04,
      "n_words": 21,
      "start_frame": 1884,
      "end_frame": 2001,
      "keyframes": [
        "001884.webp",
        "001885.webp",
        "001942.webp",
        "002000.webp",
        "002001.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trong khi chờ đợi nước sôi thì tôi sẽ hướng dẫn các bạn cách sơ chế cắt nguyên liệu: hành tây khoảng nửa củ thôi, chúng ta cắt hạt lựu.",
      "start": 80.04,
      "end": 88.32,
      "n_words": 30,
      "start_frame": 2001,
      "end_frame": 2208,
      "keyframes": [
        "002001.webp",
        "002069.webp",
        "002137.webp",
        "002138.webp",
        "002169.webp",
        "002201.webp",
        "002202.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tiếp tục, bắp cải cắt miếng vừa ăn.",
      "start": 88.32,
      "end": 92.6,
      "n_words": 8,
      "start_frame": 2208,
      "end_frame": 2315,
      "keyframes": [
        "002225.webp",
        "002248.webp",
        "002249.webp",
        "002282.webp",
        "002315.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi hành boro chúng ta cắt lát xéo, món ăn Hàn Quốc thì cái hành boro này họ sử dụng rất là nhiều.",
      "start": 92.6,
