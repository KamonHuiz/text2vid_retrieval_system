      "end": 39.72,
      "n_words": 7,
      "start_frame": 939,
      "end_frame": 993,
      "keyframes": [
        "000954.webp",
        "000990.webp",
        "000991.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, rồi chúng ta bắt tay vào bếp thực hiện món này thôi nha các bạn.",
      "start": 39.72,
      "end": 45.08,
