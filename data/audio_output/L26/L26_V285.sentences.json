      "end": 26.76,
      "n_words": 7,
      "start_frame": 637,
      "end_frame": 669,
      "keyframes": [
        "000651.webp",
        "000667.webp",
        "000668.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Xưa rồi, đây phải đọc cái bài thơ rõ ràng ha, phải chờ đọc bài thơ rõ ràng.",
      "start": 26.76,
      "end": 31.04,
      "n_words": 18,
      "start_frame": 669,
      "end_frame": 776,
      "keyframes": [
        "000687.webp",
        "000707.webp",
        "000708.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh không à đây: \"Thân em vừa trắng lại vừa dài\", không có tròn nha ô tú.",
      "start": 31.04,
      "end": 37.56,
      "n_words": 17,
      "start_frame": 776,
      "end_frame": 939,
      "keyframes": [
        "000782.webp",
