  "total_words": 1109,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.52,
      "end": 12.64,
      "n_words": 4,
      "start_frame": 263,
      "end_frame": 316,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Dạ vâng, chào Minh Tuấn Phương.",
      "start": 12.64,
      "end": 14.32,
      "n_words": 6,
      "start_frame": 316,
      "end_frame": 358,
      "keyframes": [
        "000325.webp",
        "000351.webp",
        "000352.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Có thấy là dạo này thời tiết nó bất thường không?",
      "start": 14.32,
      "end": 16.24,
      "n_words": 11,
      "start_frame": 358,
      "end_frame": 406,
      "keyframes": [
        "000377.webp",
        "000403.webp",
        "000404.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi đó, lúc nắng lúc mưa, lúc nóng lúc mát, lúc oi, nói chung là nó có cái gì làm mình khó chịu?",
      "start": 16.24,
      "end": 23.72,
      "n_words": 24,
      "start_frame": 406,
      "end_frame": 593,
      "keyframes": [
        "000434.webp",
        "000464.webp",
        "000465.webp",
        "000529.webp",
        "000593.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thời tiết thất thường nhưng mà mình không có ăn uống thất thường là tốt rồi.",
      "start": 23.72,
      "end": 26.6,
      "n_words": 16,
      "start_frame": 593,
      "end_frame": 665,
      "keyframes": [
        "000593.webp",
        "000594.webp",
        "000633.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng, nhưng mà Minh Tuấn thấy là giữa cái thời tiết mà nó bất thường, nó khó chịu như vậy thì Phước Hưng phải làm một cái món ăn gì đó mà nó thật phi thường để mình cứu lại thời tiết được chứ?",
      "start": 26.6,
      "end": 35.0,
      "n_words": 44,
      "start_frame": 665,
      "end_frame": 875,
      "keyframes": [
        "000673.webp",
        "000674.webp",
        "000699.webp",
        "000725.webp",
        "000726.webp",
        "000777.webp",
        "000829.webp",
        "000830.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Hiện giờ là mình đang ảnh hưởng của cái nóng của mùa hè nè, Phước Hưng sẽ hướng dẫn cho Minh Tuấn một cái món ăn tới đâu mát tới đó mà lại đầy đủ chất dinh dưỡng nữa.",
      "start": 35.0,
      "end": 42.92,
      "n_words": 39,
      "start_frame": 875,
      "end_frame": 1073,
      "keyframes": [
        "000927.webp",
        "001024.webp",
        "001025.webp",
        "001065.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mát là đẹp da là khỏe, vô làm thôi!",
      "start": 42.92,
      "end": 49.04,
      "n_words": 9,
      "start_frame": 1073,
      "end_frame": 1226,
      "keyframes": [
        "001105.webp",
        "001106.webp",
        "001139.webp",
        "001172.webp",
        "001173.webp",
        "001197.webp",
        "001222.webp",
        "001223.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Thanh ngọt đậm đà với bánh canh vịt.",
      "start": 49.04,
      "end": 67.92,
      "n_words": 8,
      "start_frame": 1226,
      "end_frame": 1698,
      "keyframes": [
        "001260.webp",
