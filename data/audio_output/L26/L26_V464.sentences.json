        "003701.webp",
        "003725.webp",
        "003726.webp",
        "003743.webp",
        "003761.webp",
        "003762.webp",
        "003778.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Như vậy là những cái nguyên liệu kia là Phước Hưng cũng sơ chế xong, nấm rơm thì Minh Tuấn cũng đã vẽ hình chữ thập ở trên đầu rồi. Cảm ơn Minh Tuấn.",
      "start": 151.32,
      "end": 157.08,
      "n_words": 34,
      "start_frame": 3783,
      "end_frame": 3927,
      "keyframes": [
        "003795.webp",
