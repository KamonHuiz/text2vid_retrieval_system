        "004162.webp",
        "004163.webp",
        "004197.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Bây giờ thì phần củ nén cũng đã thơm rồi, cho hết cái phần thịt vịt mà mình đã ướp vào đây luôn và bây giờ Phước Hưng sẽ xào cho thật là săn và thấm gia vị.",
      "start": 168.96,
      "end": 177.88,
      "n_words": 38,
      "start_frame": 4224,
      "end_frame": 4447,
      "keyframes": [
        "004231.webp",
