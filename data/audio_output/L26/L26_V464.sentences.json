        "003812.webp",
        "003829.webp",
        "003830.webp",
        "003879.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ Phước sẽ đặt lên trên bếp một cái nồi để chúng ta nấu bánh canh, cho vào đây khoảng hai muỗng canh dầu ăn cho cái phần hành tím giã nhuyễn cũng như là củ nén giã nhuyễn cho vào luôn, và bây giờ chúng ta sẽ phi thơm.",
      "start": 157.08,
      "end": 168.96,
      "n_words": 51,
      "start_frame": 3927,
      "end_frame": 4224,
      "keyframes": [
        "003929.webp",
