        "003487.webp",
        "003499.webp",
        "003500.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Sau khi mà quý vị tỉa bông xong thì bây giờ chúng ta sẽ cắt lát dày.",
      "start": 140.04,
      "end": 146.84,
      "n_words": 17,
      "start_frame": 3501,
      "end_frame": 3671,
      "keyframes": [
        "003514.webp",
