        "003552.webp",
        "003575.webp",
        "003576.webp",
        "003605.webp",
        "003634.webp",
        "003635.webp",
        "003656.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Phần hành lá và rau răm thì bây giờ Phước Hưng sẽ cắt nhuyễn để chúng ta nêm vào phần bánh canh rồi.",
      "start": 146.84,
      "end": 151.32,
      "n_words": 23,
      "start_frame": 3671,
      "end_frame": 3783,
      "keyframes": [
        "003677.webp",
