        "004400.webp",
        "004431.webp",
        "004432.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đúng rồi, mới xào rồi mà quá thơm luôn á!",
      "start": 177.88,
      "end": 181.12,
      "n_words": 10,
      "start_frame": 4447,
      "end_frame": 4528,
      "keyframes": [
        "004472.webp",
        "004513.webp",
        "004514.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, bây giờ Hưng sẽ cho nước sôi vào nè.",
      "start": 181.12,
      "end": 183.28,
      "n_words": 11,
      "start_frame": 4528,
      "end_frame": 4582,
      "keyframes": [
        "004541.webp",
        "004568.webp",
        "004569.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó, chúng ta sẽ cho vào đây một lít rưỡi.",
      "start": 183.28,
      "end": 185.6,
      "n_words": 10,
      "start_frame": 4582,
      "end_frame": 4640,
      "keyframes": [
        "004605.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trong nồi cũng đã sôi trở lại rồi, sẽ cho phần củ cải trắng vào và nấm rơm vào và chúng ta lại nấu tiếp tục để cho củ cải trắng và nấm rơm được ra nước ngọt.",
      "start": 185.6,
      "end": 194.2,
      "n_words": 38,
      "start_frame": 4640,
      "end_frame": 4855,
      "keyframes": [
        "004642.webp",
