        "001330.webp",
        "001362.webp",
        "001382.webp",
        "001449.webp",
        "001517.webp",
        "001518.webp",
        "001607.webp",
        "001696.webp",
        "001697.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chào các bạn đang đến với chương trình Món ngon mỗi ngày, chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 67.92,
      "end": 73.84,
      "n_words": 23,
      "start_frame": 1698,
      "end_frame": 1846,
      "keyframes": [
        "001772.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vịt thì khi mà quý vị mua về thì chúng ta sẽ xát với lại gừng và rượu cho thật là sạch.",
      "start": 73.84,
      "end": 78.28,
      "n_words": 22,
      "start_frame": 1846,
      "end_frame": 1957,
      "keyframes": [
        "001847.webp",
        "001848.webp",
        "001873.webp",
        "001898.webp",
        "001899.webp",
        "001927.webp",
        "001955.webp",
        "001956.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Ở đây Phước Hưng cũng đã làm xong luôn, bây giờ thì Phước Hưng sẽ ướp gia vị vào đây.",
      "start": 78.28,
      "end": 81.92,
      "n_words": 20,
      "start_frame": 1957,
      "end_frame": 2048,
      "keyframes": [
        "001974.webp",
        "001993.webp",
        "001994.webp",
        "002021.webp",
        "002048.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đối với món ăn ngày hôm nay thì Phước Hưng sẽ sử dụng củ nén giã nhuyễn để cho củ nén ra tinh dầu, để giúp cho món ăn tạo được hương thơm đặc trưng.",
      "start": 81.92,
      "end": 88.76,
      "n_words": 35,
      "start_frame": 2048,
      "end_frame": 2219,
      "keyframes": [
        "002048.webp",
        "002049.webp",
        "002093.webp",
        "002137.webp",
        "002138.webp",
        "002179.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phước Hưng sẽ sử dụng một phần hai lượng củ nén mà chúng ta đã giã nhuyễn và một phần hai lượng hành tím giã nhuyễn luôn.",
      "start": 88.76,
      "end": 94.76,
      "n_words": 27,
      "start_frame": 2219,
      "end_frame": 2369,
      "keyframes": [
        "002220.webp",
        "002221.webp",
        "002262.webp",
        "002303.webp",
        "002304.webp",
        "002338.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và Hưng sẽ nêm gia vị vào đây: một muỗng cà phê hạt nêm Aji-ngon heo, một muỗng cà phê bột ngọt Ajinomoto và nửa muỗng cà phê tiêu cho vào đây, một muỗng cà phê ớt bột.",
      "start": 94.76,
      "end": 105.72,
      "n_words": 38,
      "start_frame": 2369,
      "end_frame": 2643,
      "keyframes": [
        "002372.webp",
        "002373.webp",
        "002391.webp",
        "002409.webp",
        "002410.webp",
        "002442.webp",
        "002474.webp",
        "002475.webp",
        "002505.webp",
        "002535.webp",
        "002536.webp",
        "002545.webp",
        "002554.webp",
        "002555.webp",
        "002576.webp",
        "002598.webp",
        "002599.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Đối với món ăn ngày hôm nay thì chúng ta sẽ sử dụng dầu màu điều để ướp vào trong thịt vịt để giúp cho món ăn tạo thêm màu sắc đẹp nè và hương vị thơm ngon hơn.",
      "start": 105.72,
      "end": 113.2,
      "n_words": 39,
      "start_frame": 2643,
      "end_frame": 2830,
      "keyframes": [
        "002666.webp",
        "002734.webp",
        "002735.webp",
        "002783.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mà Hưng nghĩ là vì thịt vịt thì nó rất là béo, nhiều mỡ nên là nó có cái độ cay đi kèm, cay đi kèm là nó cân bằng tạo ra cái món ăn nó ngon hơn.",
      "start": 113.2,
      "end": 120.08,
      "n_words": 38,
      "start_frame": 2830,
      "end_frame": 3002,
      "keyframes": [
        "002832.webp",
        "002833.webp",
        "002916.webp",
        "002999.webp",
        "003000.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ Phước Hưng sẽ trộn đều lên.",
      "start": 120.08,
      "end": 121.36,
      "n_words": 8,
      "start_frame": 3002,
      "end_frame": 3034,
      "keyframes": [
        "003027.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Phần nấm rơm thì khi mà các bạn mua về thì chúng ta sẽ rửa sạch và chúng ta cắt bỏ cái phần gốc đi.",
      "start": 121.36,
      "end": 125.84,
      "n_words": 25,
      "start_frame": 3034,
      "end_frame": 3146,
      "keyframes": [
        "003054.webp",
        "003055.webp",
        "003089.webp",
        "003123.webp",
        "003124.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và bây giờ Minh Tuấn giúp giùm cắt phần chữ thập bên trên, thì cái hình chữ thập này giúp cho món ăn của mình lại được đẹp nè và lại thấm gia vị vào cái nấm nữa.",
      "start": 125.84,
      "end": 133.36,
      "n_words": 38,
      "start_frame": 3146,
      "end_frame": 3334,
      "keyframes": [
        "003184.webp",
        "003244.webp",
        "003245.webp",
        "003263.webp",
        "003282.webp",
        "003283.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi, trong khi mà Minh Tuấn đang sơ chế phần nấm rơm thì Phước Hưng sẽ hướng dẫn cho quý vị tiếp theo, thì chúng ta sẽ tỉa cái phần củ cải trắng này.",
      "start": 133.36,
      "end": 140.04,
      "n_words": 34,
      "start_frame": 3334,
      "end_frame": 3501,
      "keyframes": [
        "003360.webp",
