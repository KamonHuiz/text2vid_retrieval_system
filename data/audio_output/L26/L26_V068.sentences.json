        "003565.webp",
        "003601.webp",
        "003602.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thì có cái chảo đây, chúng ta sẽ cho vào chảo khoảng hai muỗng canh dầu ăn.",
      "start": 144.24,
      "end": 148.72,
