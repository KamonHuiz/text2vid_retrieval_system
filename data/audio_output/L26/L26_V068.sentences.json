        "003452.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Bây giờ thì chúng ta sẽ tiến hành nấu canh thôi. Hà dạ.",
      "start": 138.24,
      "end": 140.88,
      "n_words": 13,
      "start_frame": 3456,
      "end_frame": 3522,
      "keyframes": [
        "003490.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi Tuấn sẽ bật lên cho cô một lít rưỡi nước sôi cô.",
      "start": 140.88,
      "end": 144.24,
      "n_words": 13,
