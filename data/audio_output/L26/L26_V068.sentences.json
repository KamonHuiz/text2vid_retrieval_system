        "001398.webp",
        "001423.webp",
        "001449.webp",
        "001450.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Em đoán một cái món lẩu đúng không, lẩu đúng không?",
      "start": 58.0,
      "end": 59.84,
      "n_words": 11,
      "start_frame": 1450,
      "end_frame": 1496,
      "keyframes": [
        "001450.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, đó thì hôm nay chúng ta sẽ làm món lẩu cá lăng vị Thái.",
      "start": 59.84,
      "end": 63.8,
      "n_words": 16,
      "start_frame": 1496,
      "end_frame": 1595,
      "keyframes": [
        "001523.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ thì mình sẽ bắt tay mình làm luôn cô ha.",
      "start": 63.8,
      "end": 65.68,
      "n_words": 12,
      "start_frame": 1595,
      "end_frame": 1642,
      "keyframes": [
        "001596.webp",
        "001597.webp",
        "001624.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, và muốn mua được cá lăng ngon thì chúng ta sẽ lựa những cái con mà mắt nó còn trong, khi mà chúng ta sờ vào trong cái mình của nó đó thì nó không có đổ quá nhiều nhớt, cũng như là mình ấn tay vô nó có độ đàn hồi tốt thì là được rồi đó Tuấn. Hà dạ.",
      "start": 65.68,
      "end": 79.68,
      "n_words": 63,
      "start_frame": 1642,
      "end_frame": 1992,
      "keyframes": [
        "001652.webp",
