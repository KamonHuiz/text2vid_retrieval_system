        "001324.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bên đây em thấy có nhiều loại mà gọi là những cái hương vị đặc trưng của cái món Thái.",
      "start": 53.68,
      "end": 58.0,
