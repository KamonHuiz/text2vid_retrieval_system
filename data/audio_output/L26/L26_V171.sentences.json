        "001149.webp",
        "001150.webp",
        "001173.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nghe thôi là đã thấy ngon rồi, chưa cần biết chế biến ra làm sao.",
      "start": 47.12,
      "end": 50.16,
      "n_words": 15,
