        "001251.webp",
        "001252.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trứng là nguồn cung cấp chất đạm nè, còn hàu thì Minh Tuấn biết được gì không?",
      "start": 50.16,
      "end": 54.36,
      "n_words": 17,
      "start_frame": 1254,
      "end_frame": 1359,
      "keyframes": [
        "001291.webp",
