        "001529.webp",
        "001530.webp",
        "001617.webp",
        "001705.webp",
        "001706.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Mừng các bạn đang đến với chương trình Món ngon mỗi ngày, được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 68.24,
      "end": 74.48,
      "n_words": 21,
      "start_frame": 1706,
      "end_frame": 1862,
      "keyframes": [
        "001706.webp",
        "001786.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Các loại chúng ta cũng đã sơ chế sẵn hết rồi.",
      "start": 74.48,
      "end": 76.96,
      "n_words": 11,
      "start_frame": 1862,
      "end_frame": 1924,
      "keyframes": [
        "001866.webp",
        "001867.webp",
        "001895.webp",
        "001924.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cuối cùng thôi, bây giờ mình sẽ cắt cái phần hành tây và hành lá này.",
      "start": 76.96,
      "end": 80.96,
      "n_words": 16,
      "start_frame": 1924,
      "end_frame": 2024,
      "keyframes": [
        "001924.webp",
        "001925.webp",
        "001972.webp",
        "002019.webp",
        "002020.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hành tây thì cô sẽ cắt miếng cau, còn hành lá thì chúng ta sẽ cắt khúc khoảng chừng 3-4 phân.",
      "start": 80.96,
      "end": 87.44,
