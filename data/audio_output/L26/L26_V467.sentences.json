        "004538.webp",
        "004539.webp",
        "004558.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Ngoài ra thì trong ngưu bàng cũng có rất là nhiều kali nè, giúp tiêu hóa tốt và giảm cái lượng cholesterol nữa.",
      "start": 183.04,
      "end": 189.08,
      "n_words": 23,
