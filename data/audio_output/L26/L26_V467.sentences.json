        "003686.webp",
        "003716.webp",
        "003717.webp",
        "003754.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và trong lúc chờ cá thấm thì chúng ta sẽ đặt cái chảo lên trên bếp, cho vào đây chừng một muỗng canh dầu ăn.",
      "start": 151.56,
      "end": 158.2,
      "n_words": 25,
      "start_frame": 3789,
      "end_frame": 3955,
