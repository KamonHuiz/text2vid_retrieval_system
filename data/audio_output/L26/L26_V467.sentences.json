        "000515.webp",
        "000552.webp",
        "000553.webp",
        "000648.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Thật ra là ngưu bàng rất là tốt và đã được chương trình hướng dẫn nhiều món rồi đó, em cũng có thể tham khảo.",
      "start": 29.68,
      "end": 35.36,
      "n_words": 25,
      "start_frame": 742,
      "end_frame": 884,
      "keyframes": [
        "000744.webp",
