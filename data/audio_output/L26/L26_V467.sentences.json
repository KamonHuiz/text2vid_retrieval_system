        "000766.webp",
        "000788.webp",
        "000789.webp",
        "000818.webp",
        "000847.webp",
        "000848.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Nhưng mà sẵn hôm nay có ngưu bàng ngon như thế này thì cô sẽ giới thiệu một món ăn mới ha.",
      "start": 35.36,
      "end": 39.6,
      "n_words": 22,
      "start_frame": 884,
      "end_frame": 990,
      "keyframes": [
        "000892.webp",
        "000937.webp",
        "000938.webp",
        "000963.webp",
        "000988.webp",
        "000989.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ kết hợp ngưu bàng với lại cá, mình đem hấp, đảm bảo món ăn rất là độc lạ và rất là dinh dưỡng.",
      "start": 39.6,
      "end": 46.56,
      "n_words": 26,
      "start_frame": 990,
      "end_frame": 1164,
      "keyframes": [
        "001081.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cá hấp ngưu bàng thanh tao, ngon bung tỏa.",
      "start": 48.96,
      "end": 68.24,
      "n_words": 9,
      "start_frame": 1224,
      "end_frame": 1706,
      "keyframes": [
        "001224.webp",
