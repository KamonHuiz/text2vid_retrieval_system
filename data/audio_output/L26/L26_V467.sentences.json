        "002584.webp",
        "002612.webp",
        "002613.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Như cá này thì cô sẽ khứa chéo bên này cũng vậy.",
      "start": 104.64,
      "end": 108.64,
      "n_words": 12,
      "start_frame": 2616,
      "end_frame": 2716,
      "keyframes": [
        "002646.webp",
        "002680.webp",
        "002681.webp",
        "002698.webp",
        "002716.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp theo là chúng ta sẽ ướp cá.",
      "start": 108.64,
      "end": 110.72,
      "n_words": 8,
      "start_frame": 2716,
      "end_frame": 2768,
      "keyframes": [
        "002716.webp",
        "002717.webp",
        "002744.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì mình sẽ cho vào đây là một muỗng canh nước gừng cùng với lại một muỗng canh rượu trắng.",
      "start": 110.72,
      "end": 117.52,
      "n_words": 20,
      "start_frame": 2768,
      "end_frame": 2938,
      "keyframes": [
