        "003466.webp",
        "003501.webp",
        "003502.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Như vậy là cá sẽ được ướp thơm mùi nước tương Phú Sĩ.",
      "start": 140.88,
      "end": 145.24,
      "n_words": 13,
      "start_frame": 3522,
      "end_frame": 3631,
      "keyframes": [
        "003579.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, ướp vào bên trong bụng cá một ít ha, rồi còn lại thì cô sẽ ướp vào trong thịt cá.",
      "start": 145.24,
      "end": 151.56,
      "n_words": 22,
      "start_frame": 3631,
      "end_frame": 3789,
      "keyframes": [
        "003656.webp",
