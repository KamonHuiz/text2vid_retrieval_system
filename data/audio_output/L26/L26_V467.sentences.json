        "002063.webp",
        "002077.webp",
        "002091.webp",
        "002092.webp",
        "002120.webp",
        "002148.webp",
        "002149.webp",
        "002168.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Về cá, hành, tiêu hồng chúng ta mua thì chúng ta đừng có mổ bụng cái món cá hấp để giữ nguyên cái hình dạng của nó, cô giữ nguyên bụng nè.",
      "start": 87.44,
      "end": 93.64,
      "n_words": 32,
      "start_frame": 2186,
      "end_frame": 2341,
      "keyframes": [
        "002187.webp",
        "002188.webp",
        "002264.webp",
        "002340.webp",
        "002341.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nhưng mà mình sẽ móc làm sạch cái phần ruột và rửa sạch phần mang rồi vây đồ này nọ, mình chừa lại để cho nó đẹp.",
      "start": 93.64,
      "end": 99.8,
      "n_words": 27,
      "start_frame": 2341,
      "end_frame": 2495,
      "keyframes": [
        "002341.webp",
        "002417.webp",
        "002494.webp",
        "002495.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta sẽ khứa xéo trên mình cá và mỗi một cái đoạn chúng ta cách nhau khoảng chừng 2 phân ha.",
      "start": 99.8,
      "end": 104.64,
      "n_words": 22,
