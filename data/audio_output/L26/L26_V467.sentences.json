        "004870.webp",
        "004891.webp",
        "004892.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bây giờ là ngưu bàng chín rồi, cô tắt lửa ha, rồi cô sẽ rút ra.",
      "start": 195.84,
      "end": 200.96,
      "n_words": 16,
      "start_frame": 4896,
      "end_frame": 5024,
      "keyframes": [
        "004936.webp",
        "004981.webp",
        "004982.webp",
        "005004.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Em bắc lên cho cô một cái xửng hấp để mình sẽ hấp cá dạ.",
      "start": 200.96,
      "end": 204.96,
      "n_words": 15,
      "start_frame": 5024,
