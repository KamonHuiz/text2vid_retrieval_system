      "n_words": 10,
      "start_frame": 1393,
      "end_frame": 1456,
      "keyframes": [
        "001423.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Phần ớt sừng thì mình sẽ cắt khúc bởi vì đây là món om mà đúng không?",
      "start": 58.24,
      "end": 62.28,
      "n_words": 17,
      "start_frame": 1456,
      "end_frame": 1557,
      "keyframes": [
