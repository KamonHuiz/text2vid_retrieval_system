        "000505.webp",
        "000529.webp",
        "000554.webp",
        "000555.webp",
        "000569.webp",
        "000584.webp",
        "000585.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Thật ra thì phi lê cá nó không phải là khó, thấy em rất là chịu khó mà khéo tay cho nên là cô nghĩ em ráng thì sẽ làm được.",
      "start": 23.68,
      "end": 30.4,
      "n_words": 31,
      "start_frame": 592,
      "end_frame": 760,
      "keyframes": [
        "000633.webp",
        "000681.webp",
        "000682.webp",
        "000726.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Dạ, và bữa nay em mua cá này tính làm món gì á?",
      "start": 30.4,
      "end": 33.0,
      "n_words": 13,
      "start_frame": 760,
      "end_frame": 825,
      "keyframes": [
        "000770.webp",
        "000771.webp",
        "000798.webp",
        "000825.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Hay là cô gửi cho em đi.",
      "start": 33.0,
      "end": 34.44,
      "n_words": 7,
      "start_frame": 825,
      "end_frame": 861,
      "keyframes": [
        "000825.webp",
        "000826.webp",
        "000841.webp",
        "000856.webp",
        "000857.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "À, đối với lại cá mà đã phi lê như thế này thì mình làm một món cá cuộn thì nó vừa ngon mà nó vừa đẹp nữa.",
      "start": 34.44,
      "end": 41.68,
      "n_words": 28,
      "start_frame": 861,
      "end_frame": 1042,
      "keyframes": [
        "000918.webp",
        "000979.webp",
        "000980.webp",
        "001007.webp",
        "001034.webp",
        "001035.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Wow, phi lê cá cuộn hả?",
      "start": 41.68,
      "end": 43.48,
      "n_words": 6,
      "start_frame": 1042,
      "end_frame": 1087,
      "keyframes": [
        "001078.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Lạ quá, mình làm luôn nha cô.",
      "start": 43.48,
      "end": 46.88,
      "n_words": 7,
      "start_frame": 1087,
      "end_frame": 1172,
      "keyframes": [
        "001122.webp",
        "001123.webp",
        "001147.webp",
        "001172.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cá điêu hồng cuốn dưa kiệu thơm ngon mỹ miều, siêu lòng thực khách.",
      "start": 46.88,
      "end": 67.04,
      "n_words": 14,
      "start_frame": 1172,
      "end_frame": 1676,
      "keyframes": [
        "001172.webp",
