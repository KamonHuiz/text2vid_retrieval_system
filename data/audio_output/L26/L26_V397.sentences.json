        "004441.webp"
      ],
      "keyframe_count": 20
    },
    {
      "text": "Chúng ta sẽ xiên cái miếng cá có hai cái phần rìa úp vào nhau để không có bị bung ra sau khi chúng ta chiên ha.",
      "start": 177.72,
