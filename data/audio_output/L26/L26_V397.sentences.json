        "001372.webp",
        "001404.webp",
        "001455.webp",
        "001507.webp",
        "001508.webp",
        "001595.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày, chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 67.04,
      "end": 73.88,
      "n_words": 24,
      "start_frame": 1676,
      "end_frame": 1847,
      "keyframes": [
        "001682.webp",
        "001683.webp",
        "001766.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô nhờ Hacota giúp cô, mình áp chảo cho cái ba loại sườn khói này nè.",
      "start": 73.88,
      "end": 78.24,
      "n_words": 16,
      "start_frame": 1847,
      "end_frame": 1956,
      "keyframes": [
        "001850.webp",
