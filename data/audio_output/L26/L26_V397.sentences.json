        "002527.webp",
        "002639.webp",
        "002752.webp",
        "002753.webp",
        "002795.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "À, sẽ tỉa lại một chút để cho nó có cái cạnh là khoảng chừng bốn phân với năm phân, vậy nè thì hồi sau mình sẽ tạo hình dễ hơn.",
      "start": 112.76,
      "end": 120.84,
      "n_words": 31,
      "start_frame": 2819,
      "end_frame": 3021,
      "keyframes": [
        "002838.webp",
        "002839.webp",
        "002899.webp",
        "002960.webp",
        "002961.webp",
        "002963.webp",
        "002966.webp",
        "002967.webp",
        "002993.webp",
        "003019.webp",
        "003020.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Cái phần cá vụn á thì chúng ta sẽ băm nhỏ.",
      "start": 120.84,
      "end": 123.8,
      "n_words": 11,
      "start_frame": 3021,
      "end_frame": 3095,
      "keyframes": [
        "003054.webp",
        "003089.webp",
        "003090.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cái phần mà thịt ba rọi xông khói á bây giờ mình sẽ cắt nhỏ lại rồi sẽ lần lượt trộn vào: sườn thịt cá đã băm nhỏ, thịt ba rọi xông khói đã áp chảo và cắt nhỏ, một muỗng canh dưa kiệu mình đã băm nhỏ.",
      "start": 123.8,
