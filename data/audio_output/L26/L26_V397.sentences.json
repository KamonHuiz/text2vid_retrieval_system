        "002192.webp",
        "002213.webp",
        "002235.webp",
        "002236.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đúng rồi em, áp chảo để cho nó ra cái phần mỡ đi và nó trở nên thơm, nó chín vàng rồi.",
      "start": 89.56,
      "end": 95.68,
      "n_words": 22,
      "start_frame": 2239,
      "end_frame": 2392,
      "keyframes": [
        "002293.webp",
        "002350.webp",
        "002351.webp",
        "002364.webp",
        "002377.webp",
        "002378.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Củ kiệu còn lại thì mình sẽ băm nhỏ.",
      "start": 95.92,
      "end": 98.84,
      "n_words": 9,
      "start_frame": 2398,
      "end_frame": 2471,
      "keyframes": [
        "002410.webp",
        "002411.webp",
        "002442.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vậy bây giờ chúng ta sẽ cắt lát phần phi lê cá, nhưng mà để cho phần phi lê cá sau khi mà mình cắt nó có một cái bản lớn mình cuốn lại thì thứ nhất là mình sẽ nghiêng dao, cái thứ hai là chúng ta sẽ cắt từng cái cặp hai miếng và nó dính lại phần da đó em.",
      "start": 98.84,
      "end": 112.76,
      "n_words": 63,
      "start_frame": 2471,
      "end_frame": 2819,
      "keyframes": [
        "002474.webp",
