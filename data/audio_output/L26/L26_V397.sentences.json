        "003532.webp",
        "003533.webp",
        "003566.webp",
        "003600.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cái mùi của lá hương thảo là một cái mùi nó rất là lạ miệng.",
      "start": 144.0,
      "end": 147.0,
      "n_words": 15,
      "start_frame": 3600,
      "end_frame": 3675,
      "keyframes": [
        "003600.webp",
        "003601.webp",
        "003649.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, mình sẽ bắt đầu cuốn cá nha.",
      "start": 147.0,
      "end": 149.76,
      "n_words": 9,
      "start_frame": 3675,
