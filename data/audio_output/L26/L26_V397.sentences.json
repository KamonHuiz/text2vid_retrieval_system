      "start_frame": 263,
      "end_frame": 301,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trời ơi, ai mà phi lê cái miếng cá xuất sắc vậy nè trời?",
      "start": 12.04,
      "end": 15.44,
      "n_words": 14,
      "start_frame": 301,
      "end_frame": 386,
      "keyframes": [
        "000342.webp",
        "000384.webp",
        "000385.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Người bán cá làm chứ ai.",
      "start": 15.44,
      "end": 17.56,
      "n_words": 6,
      "start_frame": 386,
      "end_frame": 439,
      "keyframes": [
        "000401.webp",
        "000417.webp",
        "000418.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Công nhận không gì qua mắt được cô hết trơn á, mà đúng thiệt em phi lê cá rất là dở cho nên toàn là mua ở ngoài chợ không thôi.",
      "start": 17.56,
      "end": 23.68,
      "n_words": 31,
      "start_frame": 439,
      "end_frame": 592,
      "keyframes": [
        "000461.webp",
