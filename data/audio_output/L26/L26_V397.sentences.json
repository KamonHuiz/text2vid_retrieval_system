        "001869.webp",
        "001887.webp",
        "001888.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trong lúc đó thì chúng ta sẽ sơ chế một vài nguyên liệu.",
      "start": 78.24,
      "end": 81.72,
      "n_words": 13,
      "start_frame": 1956,
      "end_frame": 2043,
      "keyframes": [
        "001964.webp",
        "002040.webp",
        "002041.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Gừng bây giờ mình sẽ cắt sợi rồi mình sẽ để gừng đây.",
      "start": 81.72,
      "end": 85.08,
      "n_words": 13,
      "start_frame": 2043,
      "end_frame": 2127,
      "keyframes": [
        "002085.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Kiệu ngâm chua một nửa thì mình sẽ cắt sợi, còn một nửa thì mình sẽ băm nhỏ.",
      "start": 85.08,
      "end": 89.56,
      "n_words": 18,
      "start_frame": 2127,
      "end_frame": 2239,
      "keyframes": [
        "002130.webp",
        "002131.webp",
        "002161.webp",
