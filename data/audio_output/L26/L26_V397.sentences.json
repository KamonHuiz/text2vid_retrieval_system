        "004040.webp",
        "004058.webp",
        "004059.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Mình sẽ phết lên đây, mình đặt lên gừng và một ít kiệu cuốn lại.",
      "start": 163.16,
      "end": 167.52,
