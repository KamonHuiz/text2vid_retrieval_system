        "004600.webp",
        "004601.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Cứ như vậy thì chúng ta sẽ cuốn hết cái phần cá này.",
      "start": 184.04,
      "end": 187.76,
      "n_words": 13,
