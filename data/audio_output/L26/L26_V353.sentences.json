        "003548.webp",
        "003600.webp",
        "003601.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Sau khi mà mình đã tạo màu cho cái phần da gà xong rồi vớt cái phần gà này ra đi đã.",
