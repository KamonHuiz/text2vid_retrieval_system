        "002080.webp",
        "002106.webp",
        "002107.webp",
        "002150.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cái phần nho này thì mình sẽ trang trí, cô Hà ơi em cắt lát một trái đi rồi ba trái em cắt đôi sẽ bỏ vào đây.",
      "start": 87.6,
      "end": 98.08,
      "n_words": 28,
      "start_frame": 2190,
      "end_frame": 2452,
      "keyframes": [
        "002194.webp",
