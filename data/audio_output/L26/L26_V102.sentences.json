        "001227.webp",
        "001252.webp",
        "001253.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Món bánh ngày là món bánh kẹp sốt đậu gà.",
      "start": 50.4,
      "end": 53.64,
      "n_words": 10,
      "start_frame": 1260,
      "end_frame": 1341,
      "keyframes": [
        "001297.webp",
        "001341.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cái phần sốt đậu gà là em rất là tò mò nha.",
      "start": 53.64,
      "end": 56.12,
      "n_words": 12,
      "start_frame": 1341,
      "end_frame": 1403,
      "keyframes": [
        "001341.webp",
        "001342.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mình bắt tay mình làm thử coi là cái phần sốt này có gì cô hả?",
      "start": 56.12,
      "end": 59.12,
      "n_words": 16,
      "start_frame": 1403,
      "end_frame": 1478,
      "keyframes": [
        "001409.webp",
        "001476.webp",
        "001477.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và để làm sốt đậu gà thì đầu tiên là Minh Tuấn giúp cô em mài cái vỏ chanh, vỏ chanh vàng kia và lấy cho cô hai muỗng canh nước cốt chanh.",
      "start": 59.12,
      "end": 67.76,
      "n_words": 33,
      "start_frame": 1478,
      "end_frame": 1694,
      "keyframes": [
        "001572.webp",
        "001667.webp",
        "001668.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ trong lúc mà Tuấn mài vỏ chanh á thì cô Hà sẽ tranh thủ là cô Hà cắt cái quả chuối này ra và mình sẽ cho vào trong cái cối để mà chút nữa chúng ta xay, chúng ta làm phần sốt.",
      "start": 67.76,
      "end": 78.88,
      "n_words": 45,
      "start_frame": 1694,
      "end_frame": 1972,
      "keyframes": [
