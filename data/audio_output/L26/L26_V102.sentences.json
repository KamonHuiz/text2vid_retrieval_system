      "end_frame": 1073,
      "keyframes": [
        "000964.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em chào cô Hà Minh.",
      "start": 42.92,
      "end": 44.36,
      "n_words": 5,
      "start_frame": 1073,
      "end_frame": 1109,
      "keyframes": [
        "001074.webp",
        "001075.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hôm nay làm bánh không biết là cô làm bánh gì để mà gửi tặng cho mọi người đây?",
      "start": 44.64,
      "end": 50.4,
      "n_words": 19,
