        "001921.webp",
        "001970.webp",
        "001971.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Xong rồi cô ơi, mình cùng kiểm tra thành quả.",
      "start": 78.88,
      "end": 81.52,
      "n_words": 10,
      "start_frame": 1972,
      "end_frame": 2038,
      "keyframes": [
        "001999.webp",
        "002027.webp",
        "002028.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cắt ra cô chỉ cần hai muỗng canh nước cốt chanh là được.",
      "start": 81.52,
      "end": 87.6,
      "n_words": 13,
      "start_frame": 2038,
      "end_frame": 2190,
      "keyframes": [
        "002040.webp",
        "002053.webp",
