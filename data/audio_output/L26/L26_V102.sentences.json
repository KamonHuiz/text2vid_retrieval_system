        "003737.webp",
        "003774.webp",
        "003775.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mới xay như vậy thôi và nó ra mùi rất thơm luôn.",
      "start": 152.16,
      "end": 154.84,
      "n_words": 12,
