        "005067.webp",
        "005130.webp",
        "005131.webp",
        "005156.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Và cuối cùng chúng ta sẽ chiên khoai môn luôn.",
      "start": 206.72,
      "end": 211.12,
      "n_words": 10,
      "start_frame": 5168,
      "end_frame": 5278,
      "keyframes": [
        "005182.webp",
        "005183.webp",
        "005203.webp",
        "005224.webp",
        "005225.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và đây cũng là một bí quyết nhỏ trong món ăn ngày hôm nay, cái việc chúng ta chiên khoai môn trước giúp cho khoai được thơm và ngon hơn.",
      "start": 211.12,
      "end": 217.32,
      "n_words": 30,
      "start_frame": 5278,
      "end_frame": 5433,
      "keyframes": [
        "005285.webp",
        "005345.webp",
        "005346.webp",
        "005386.webp",
        "005427.webp",
        "005428.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Như vậy là khoai môn đã vàng, bây giờ Thanh Phương giúp mình vớt ra.",
      "start": 217.32,
      "end": 220.68,
      "n_words": 15,
      "start_frame": 5433,
      "end_frame": 5517,
      "keyframes": [
        "005472.webp",
        "005516.webp",
        "005517.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ chúng ta sẽ nấu nước lẩu.",
      "start": 220.68,
      "end": 223.04,
      "n_words": 8,
      "start_frame": 5517,
      "end_frame": 5576,
      "keyframes": [
        "005517.webp",
        "005546.webp",
        "005575.webp",
        "005576.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Các bạn đầu tiên vớt mía ra nè, để lại bắp, rồi tiếp đến các bạn sẽ cho cà rốt cắt hoa vào, khoai môn chiên.",
      "start": 223.04,
      "end": 232.96,
      "n_words": 26,
      "start_frame": 5576,
      "end_frame": 5824,
      "keyframes": [
        "005576.webp",
        "005605.webp",
        "005635.webp",
