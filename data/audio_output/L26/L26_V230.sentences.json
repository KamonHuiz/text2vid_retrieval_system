        "002675.webp",
        "002707.webp",
        "002708.webp",
        "002749.webp",
        "002791.webp",
        "002792.webp"
      ],
      "keyframe_count": 20
    },
    {
      "text": "Các bạn có thể sử dụng đậu hũ chiên sẵn hoặc là đậu hũ tươi, cắt ra làm tám miếng đều nhau.",
      "start": 111.68,
      "end": 117.24,
      "n_words": 22,
      "start_frame": 2792,
      "end_frame": 2931,
      "keyframes": [
        "002792.webp",
        "002818.webp",
        "002844.webp",
        "002845.webp",
        "002890.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ đầu bếp sẽ hướng dẫn các bạn sơ chế cà rốt. Cà rốt các bạn gọt vỏ sau đó các bạn sẽ khứa hoa.",
      "start": 118.64,
      "end": 125.68,
      "n_words": 26,
      "start_frame": 2966,
      "end_frame": 3142,
      "keyframes": [
        "002970.webp",
        "003003.webp",
        "003004.webp",
        "003020.webp",
        "003036.webp",
        "003037.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình khứa hoa kiểu cạnh cong như thế này này, thì các bạn để nghiêng cái lưỡi dao như thế này.",
      "start": 125.68,
      "end": 136.32,
      "n_words": 21,
      "start_frame": 3142,
      "end_frame": 3408,
      "keyframes": [
        "003186.webp",
        "003335.webp",
        "003336.webp",
        "003371.webp",
        "003407.webp",
        "003408.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi sau khi khứa những cái cạnh cong như thế này, chúng ta sẽ cắt lát có độ dài khoảng 0.3 cm là được, rồi chúng ta sẽ cho ra đĩa.",
      "start": 136.32,
      "end": 145.16,
      "n_words": 31,
      "start_frame": 3408,
      "end_frame": 3629,
      "keyframes": [
        "003408.webp",
        "003504.webp",
        "003601.webp",
        "003602.webp",
        "003624.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp đến là hành baro, chúng ta sẽ cắt lát mỏng.",
      "start": 145.16,
      "end": 151.76,
      "n_words": 11,
      "start_frame": 3629,
      "end_frame": 3794,
      "keyframes": [
        "003646.webp",
        "003647.webp",
        "003689.webp",
        "003732.webp",
        "003733.webp",
        "003766.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ thì Phương sẽ chuẩn bị sẵn một chảo dầu nhé.",
      "start": 151.76,
      "end": 154.08,
      "n_words": 12,
      "start_frame": 3794,
      "end_frame": 3852,
      "keyframes": [
        "003799.webp",
        "003800.webp",
        "003820.webp",
        "003841.webp",
        "003842.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp đến là nấm hương, các bạn sẽ dùng dao này khứa ngôi sao trên mặt nấm như thế này đó.",
      "start": 154.08,
      "end": 159.88,
      "n_words": 21,
      "start_frame": 3852,
      "end_frame": 3997,
      "keyframes": [
        "003854.webp",
        "003867.webp",
        "003868.webp",
        "003908.webp",
        "003948.webp",
        "003949.webp",
        "003990.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chúng ta sẽ khứa ngôi sao rồi xong cái phần nấm hương.",
      "start": 159.88,
      "end": 164.28,
      "n_words": 12,
      "start_frame": 3997,
      "end_frame": 4107,
      "keyframes": [
        "004032.webp",
        "004033.webp",
        "004048.webp",
        "004064.webp",
        "004065.webp",
        "004086.webp",
        "004107.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Nấm rơm chẻ đôi như thế này, nấm đùi gà chúng ta sẽ cắt thành lát, xong phần nấm đùi gà.",
      "start": 164.28,
      "end": 176.0,
      "n_words": 21,
      "start_frame": 4107,
      "end_frame": 4400,
      "keyframes": [
        "004107.webp",
