        "004635.webp",
        "004668.webp",
        "004669.webp",
        "004696.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tiếp đến các bạn sẽ chiên đậu hũ ki.",
      "start": 188.84,
      "end": 190.88,
      "n_words": 9,
      "start_frame": 4721,
      "end_frame": 4772,
      "keyframes": [
        "004723.webp",
        "004724.webp",
        "004772.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Khi chiên đậu hũ ki chúng ta để dầu thiệt nóng lên nha để mình khi mình cho vào nè, đó nhiệt thiệt là nó sẽ chín liền ra liền, rồi chúng ta gắp ra đó, rất là nhanh.",
      "start": 190.88,
      "end": 206.72,
      "n_words": 39,
      "start_frame": 4772,
      "end_frame": 5168,
      "keyframes": [
        "004772.webp",
