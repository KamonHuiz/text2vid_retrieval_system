        "004376.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Cuối cùng, những nguyên liệu đã sơ chế xong.",
      "start": 176.0,
      "end": 177.92,
      "n_words": 9,
      "start_frame": 4400,
      "end_frame": 4448,
      "keyframes": [
        "004404.webp",
        "004405.webp",
        "004433.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ chúng ta sẽ phi vàng cái hành baro này, chút nữa sẽ cho lên trên lẩu.",
      "start": 177.92,
      "end": 182.36,
      "n_words": 18,
      "start_frame": 4448,
      "end_frame": 4559,
      "keyframes": [
        "004462.webp",
        "004463.webp",
        "004507.webp",
        "004552.webp",
        "004553.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Vừa vàng tới thôi để giữ được cái độ ngọt cũng như mùi thơm của hành baro đó nha anh Phương.",
      "start": 182.36,
      "end": 188.84,
      "n_words": 21,
      "start_frame": 4559,
      "end_frame": 4721,
      "keyframes": [
        "004577.webp",
        "004602.webp",
