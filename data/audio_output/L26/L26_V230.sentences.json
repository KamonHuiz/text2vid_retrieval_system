        "006032.webp",
        "006033.webp",
        "006064.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Lẩu mà có nước tương này thơm lắm luôn anh, và một muỗng canh hạt nêm Ajinomoto ngon lắm.",
      "start": 243.68,
      "end": 248.44,
      "n_words": 19,
      "start_frame": 6092,
      "end_frame": 6211,
      "keyframes": [
        "006095.webp",
