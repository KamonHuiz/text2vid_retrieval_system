      "end": 193.76,
      "n_words": 13,
      "start_frame": 4687,
      "end_frame": 4844,
      "keyframes": [
        "004721.webp",
        "004767.webp",
        "004768.webp",
        "004814.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Hấp dẫn chưa?",
