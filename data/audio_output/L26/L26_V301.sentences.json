        "003183.webp",
        "003200.webp",
        "003201.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Dưa leo mình bỏ hột đi.",
      "start": 129.0,
      "end": 130.36,
      "n_words": 6,
      "start_frame": 3225,
      "end_frame": 3259,
      "keyframes": [
        "003237.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cái việc mà mình cho đường và ướp chung với dưa leo cà rốt á để cho hai cái này nó trở nên giòn và ngọt hơn.",
