      "n_words": 41,
      "start_frame": 3735,
      "end_frame": 3977,
      "keyframes": [
        "003804.webp",
        "003874.webp",
        "003875.webp",
        "003926.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ mình sẽ tới công đoạn là mình áp chảo mực.",
