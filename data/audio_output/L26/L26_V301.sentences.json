        "002626.webp",
        "002627.webp"
      ],
      "keyframe_count": 19
    },
    {
      "text": "Rồi mình khuấy đều lên.",
      "start": 106.76,
      "end": 108.56,
      "n_words": 5,
      "start_frame": 2669,
      "end_frame": 2714,
      "keyframes": [
        "002672.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nhưng mà Hoàng Long ơi, Minh Phương thắc mắc là tại sao trong cái phần nước sốt này lại có Mayonnaise ngọt dịu?",
      "start": 108.56,
      "end": 114.32,
      "n_words": 23,
      "start_frame": 2714,
      "end_frame": 2858,
      "keyframes": [
        "002717.webp",
        "002718.webp",
        "002748.webp",
        "002779.webp",
        "002780.webp",
        "002817.webp",
        "002854.webp",
        "002855.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cái việc mà cho thêm cái phần sốt Mayonnaise ngọt dịu vào sẽ giúp cho mực có vị béo thơm và hấp dẫn hơn.",
