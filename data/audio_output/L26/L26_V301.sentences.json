      "end": 201.72,
      "n_words": 26,
      "start_frame": 4869,
      "end_frame": 5043,
      "keyframes": [
        "004926.webp",
        "004991.webp",
        "004992.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cần tây nè, ớt nào, mình phải trộn chung với nhau luôn. Vỗ tay!",
      "start": 202.48,
      "end": 206.24,
      "n_words": 14,
