        "004158.webp",
        "004203.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mực thì chắc chắn rất là nhanh chín đúng không Hoàng Long?",
      "start": 168.12,
      "end": 170.64,
      "n_words": 12,
      "start_frame": 4203,
      "end_frame": 4266,
      "keyframes": [
        "004203.webp",
        "004204.webp",
        "004242.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, mình lật được chưa ta?",
