      "end": 215.92,
      "n_words": 17,
      "start_frame": 5322,
      "end_frame": 5398,
      "keyframes": [
        "005381.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mình cũng ngâm sau đó mình để ráo nước.",
