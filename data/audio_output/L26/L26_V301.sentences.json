      "end": 30.64,
      "n_words": 13,
      "start_frame": 707,
      "end_frame": 766,
      "keyframes": [
        "000711.webp",
        "000712.webp",
        "000750.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho nên là nấu chè không hẳn là phổ tai chỉ có thể nấu chè mà có thể làm rất là nhiều món khác.",
