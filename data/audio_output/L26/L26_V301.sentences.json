        "001831.webp",
        "001911.webp",
        "001912.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Háo hức quá, bây giờ là mực trước nha.",
      "start": 76.8,
      "end": 78.64,
      "n_words": 9,
      "start_frame": 1920,
