      "end": 208.4,
      "n_words": 8,
      "start_frame": 5156,
      "end_frame": 5210,
      "keyframes": [
        "005163.webp",
        "005203.webp",
        "005204.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vỗ tay thì thông thường mình mua về nè, Minh Phương nấu chè thì Phương sẽ ngâm đúng không?",
      "start": 208.4,
      "end": 212.88,
      "n_words": 19,
      "start_frame": 5210,
      "end_frame": 5322,
      "keyframes": [
        "005262.webp",
        "005320.webp",
        "005321.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Còn đối với khi làm gỏi thì chúng ta cũng ngâm thôi hả hay như thế nào?",
