        "003577.webp",
        "003595.webp",
        "003596.webp",
        "003618.webp",
        "003640.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đường hòa tan cùng với giấm mới cho vào đây là sốt Mayonnaise ngọt dịu.",
      "start": 145.6,
      "end": 149.4,
      "n_words": 15,
      "start_frame": 3640,
      "end_frame": 3735,
      "keyframes": [
        "003640.webp",
