        "002016.webp",
        "002055.webp",
        "002056.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ mình sẽ khứa vảy rồng cho nó nha.",
      "start": 84.0,
      "end": 86.04,
      "n_words": 10,
      "start_frame": 2100,
      "end_frame": 2151,
      "keyframes": [
        "002110.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đối với những món ăn mà liên quan đến mực thì cái phần tạo hình khi mà chúng ta thưởng thức cũng rất là thú vị.",
      "start": 86.04,
      "end": 91.64,
      "n_words": 26,
      "start_frame": 2151,
      "end_frame": 2291,
      "keyframes": [
        "002165.webp",
        "002166.webp",
        "002228.webp",
        "002290.webp",
        "002291.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ mình sẽ pha cái phần sốt để mình ướp mực.",
      "start": 91.64,
      "end": 93.96,
      "n_words": 12,
      "start_frame": 2291,
      "end_frame": 2349,
      "keyframes": [
        "002291.webp",
        "002319.webp",
        "002348.webp",
        "002349.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mình sẽ cho vào đây là hạt nêm Aji-ngon gà, kế đến là bột ngọt Ajinomoto, sốt Mayonnaise ngọt dịu, sa tế để tạo màu, ít nước hành tỏi băm và cuối cùng thêm vào đây một ít tiêu nữa.",
      "start": 93.96,
      "end": 106.76,
      "n_words": 40,
      "start_frame": 2349,
      "end_frame": 2669,
      "keyframes": [
        "002349.webp",
