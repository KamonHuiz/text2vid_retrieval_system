        "000418.webp",
        "000419.webp",
        "000457.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Định trổ tài nấu chè phổ tai, tại vì Minh Phương mới biết được thông tin nha.",
      "start": 18.76,
      "end": 24.44,
