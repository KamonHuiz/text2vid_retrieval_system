        "000557.webp",
        "000558.webp",
        "000609.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phổ tai có rất là nhiều chất xơ đúng không?",
      "start": 24.44,
      "end": 28.04,
      "n_words": 10,
      "start_frame": 611,
      "end_frame": 701,
      "keyframes": [
        "000660.webp",
        "000661.webp",
        "000686.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mà phổ tai thì chỉ nấu chè thôi, chứ làm được cái gì?",
