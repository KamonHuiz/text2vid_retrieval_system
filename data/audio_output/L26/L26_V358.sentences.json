      "end": 190.52,
      "n_words": 2,
      "start_frame": 4744,
      "end_frame": 4763,
      "keyframes": [
        "004753.webp",
        "004754.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nó có hai ba tên nữa à, có hai tên gọi, còn gọi là nấm nút.",
      "start": 190.52,
      "end": 194.48,
      "n_words": 16,
