      "keyframes": [
        "004773.webp",
        "004792.webp",
        "004793.webp",
        "004828.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi mình phải xả hơi một chút và cũng phải cẩn thận kẻo nóng nha các bạn.",
      "start": 194.48,
      "end": 198.6,
      "n_words": 17,
      "start_frame": 4862,
      "end_frame": 4965,
      "keyframes": [
        "004864.webp",
        "004865.webp",
        "004914.webp",
        "004963.webp",
        "004964.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiêu xanh thì mình sẽ đập dập mình cho vào chén.",
      "start": 198.6,
      "end": 202.72,
      "n_words": 11,
      "start_frame": 4965,
      "end_frame": 5068,
      "keyframes": [
        "004984.webp",
        "005005.webp",
        "005006.webp",
        "005017.webp",
        "005028.webp",
        "005029.webp",
        "005046.webp",
        "005064.webp",
        "005065.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi bây giờ mình sẽ làm sốt, cho đây một muỗng dầu điều, mình phi thơm phần gừng, thơm quá!",
      "start": 202.72,
