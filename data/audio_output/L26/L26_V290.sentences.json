        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 33
    },
    {
      "text": "Anh Tuấn ơi? - Ơi!",
      "start": 12.12,
      "end": 13.28,
      "n_words": 5,
      "start_frame": 303,
      "end_frame": 332,
      "keyframes": [
        "000317.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Mấy nay dịch ở nhà mình làm gì nè?",
      "start": 13.28,
      "end": 15.68,
      "n_words": 10,
      "start_frame": 332,
      "end_frame": 392,
      "keyframes": [
        "000335.webp",
        "000336.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Anh có làm gì đâu, nói chuyện với cây cỏ.",
      "start": 15.68,
      "end": 18.44,
      "n_words": 11,
      "start_frame": 392,
      "end_frame": 461,
      "keyframes": [
        "000397.webp",
        "000458.webp",
        "000459.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Ở có mình, không ai nói chuyện hết á.",
      "start": 18.44,
      "end": 20.28,
      "n_words": 10,
      "start_frame": 461,
      "end_frame": 507,
      "keyframes": [
        "000481.webp",
        "000503.webp",
        "000504.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi ăn uống sao?",
      "start": 20.28,
      "end": 21.44,
      "n_words": 4,
      "start_frame": 507,
      "end_frame": 536,
      "keyframes": [
        "000518.webp",
        "000532.webp",
        "000533.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Ăn cũng khổ cực lắm em.",
      "start": 21.44,
      "end": 22.8,
      "n_words": 7,
      "start_frame": 536,
      "end_frame": 570,
      "keyframes": [
        "000569.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ví dụ như ăn bào ngư với cá này kia thôi, chứ có cái gì đâu mà ăn.",
      "start": 22.8,
      "end": 25.52,
      "n_words": 18,
      "start_frame": 570,
      "end_frame": 638,
      "keyframes": [
        "000606.webp",
        "000607.webp",
        "000632.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trời đất ơi, dịch bệnh mà ăn bào ngư với cá không, làm gì có mà ăn?",
      "start": 25.52,
      "end": 29.6,
      "n_words": 17,
      "start_frame": 638,
      "end_frame": 740,
      "keyframes": [
        "000657.webp",
        "000658.webp",
        "000714.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tưởng tượng thôi em.",
      "start": 29.6,
      "end": 31.0,
      "n_words": 4,
      "start_frame": 740,
      "end_frame": 775,
      "keyframes": [
        "000770.webp",
        "000771.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ăn lạp xưởng cái anh tưởng tượng bào ngư, rồi anh ăn hủ tiếu anh tưởng tượng là vi cá với tổ yến, hiểu không?",
      "start": 31.0,
      "end": 36.32,
      "n_words": 25,
      "start_frame": 775,
      "end_frame": 908,
      "keyframes": [
        "000794.webp",
        "000817.webp",
        "000818.webp",
        "000854.webp",
        "000891.webp",
        "000892.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nhưng mà vấn đề nằm ở chỗ là anh mua mấy cái đó nhiều quá nên là giờ có dư quá trời luôn.",
      "start": 36.32,
      "end": 41.0,
      "n_words": 23,
      "start_frame": 908,
      "end_frame": 1025,
      "keyframes": [
        "000932.webp",
        "000973.webp",
        "000974.webp",
        "001009.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ anh phải nhờ em giúp đây.",
      "start": 41.0,
      "end": 42.28,
      "n_words": 8,
      "start_frame": 1025,
      "end_frame": 1057,
      "keyframes": [
        "001045.webp",
        "001046.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Lạp xưởng nè, sườn yến không?",
      "start": 42.28,
      "end": 45.84,
      "n_words": 6,
      "start_frame": 1057,
      "end_frame": 1146,
      "keyframes": [
        "001081.webp",
        "001117.webp",
        "001118.webp",
        "001145.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tôm khô à, tôm khô.",
      "start": 45.84,
      "end": 46.96,
      "n_words": 5,
      "start_frame": 1146,
      "end_frame": 1174,
      "keyframes": [
        "001173.webp",
        "001174.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ Long giúp Tuấn đi.",
      "start": 46.96,
      "end": 48.28,
      "n_words": 6,
      "start_frame": 1174,
      "end_frame": 1207,
      "keyframes": [
        "001174.webp",
        "001187.webp",
        "001201.webp",
        "001202.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "À, cũng tương đối đủ nguyên liệu rồi, có thể là bột đường cũng ăn rất là ngon, ngon nha, hứa là ngon.",
      "start": 48.28,
      "end": 54.08,
      "n_words": 23,
      "start_frame": 1207,
      "end_frame": 1352,
      "keyframes": [
        "001254.webp",
        "001306.webp",
        "001307.webp",
        "001316.webp",
        "001325.webp",
        "001326.webp",
        "001335.webp",
        "001345.webp",
        "001346.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Làm thôi!",
      "start": 54.08,
      "end": 56.8,
      "n_words": 2,
      "start_frame": 1352,
      "end_frame": 1420,
      "keyframes": [
        "001357.webp",
        "001368.webp",
        "001369.webp",
        "001393.webp",
        "001418.webp",
        "001419.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cơm chiên Dương Châu tha hồ biến tấu.",
      "start": 56.8,
      "end": 75.44,
      "n_words": 8,
      "start_frame": 1420,
      "end_frame": 1886,
      "keyframes": [
        "001452.webp",
        "001485.webp",
        "001486.webp",
        "001532.webp",
        "001579.webp",
        "001594.webp",
        "001652.webp",
        "001710.webp",
        "001711.webp",
        "001797.webp",
        "001884.webp",
        "001885.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chào quý vị khán giả đã quay trở lại với chương trình Món ngon mỗi ngày, chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 75.68,
      "end": 82.32,
      "n_words": 27,
      "start_frame": 1892,
      "end_frame": 2058,
      "keyframes": [
        "001973.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ Tuấn có cần phụ gì không?",
      "start": 82.32,
      "end": 84.0,
      "n_words": 8,
      "start_frame": 2058,
      "end_frame": 2100,
      "keyframes": [
        "002061.webp",
        "002062.webp",
        "002084.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Có, phần cà rốt thì Long đã cắt hạt lựu sẵn, thì giờ Minh Tuấn sẽ giúp Long là mình luộc sơ qua cái phần này nha.",
      "start": 84.0,
      "end": 89.16,
      "n_words": 28,
      "start_frame": 2100,
      "end_frame": 2229,
      "keyframes": [
        "002107.webp",
        "002108.webp",
        "002131.webp",
        "002154.webp",
        "002155.webp",
        "002195.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Đây rồi.",
      "start": 89.16,
      "end": 89.84,
      "n_words": 3,
      "start_frame": 2229,
      "end_frame": 2246,
      "keyframes": [
        "002236.webp",
        "002237.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trong khi chờ đợi Minh Tuấn luộc thì Long sẽ cắt xá xíu và lạp xưởng.",
      "start": 89.84,
      "end": 92.8,
      "n_words": 16,
      "start_frame": 2246,
      "end_frame": 2320,
      "keyframes": [
        "002261.webp",
        "002286.webp",
        "002287.webp",
        "002304.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và ở đây thì Long đang cắt hạt lựu tất cả những cái thành phần, ví dụ như là thịt xá xíu hay là lạp xưởng, và mình cắt cái phần hạt lựu này cho nó đều nhau để cái món ăn của mình nó sẽ đẹp mắt hơn.",
      "start": 92.8,
      "end": 101.64,
      "n_words": 49,
      "start_frame": 2320,
      "end_frame": 2541,
      "keyframes": [
        "002321.webp",
        "002322.webp",
        "002332.webp",
        "002342.webp",
        "002343.webp",
        "002392.webp",
        "002441.webp",
        "002442.webp",
        "002493.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bây giờ bên đây thì nước cũng đã sôi rồi, cho nên là bây giờ Minh Tuấn sẽ luộc tất cả các phần như là đậu Hà Lan nè, cho luôn cả cà rốt cắt hạt lựu vô nè.",
      "start": 101.64,
      "end": 110.36,
      "n_words": 39,
      "start_frame": 2541,
      "end_frame": 2759,
      "keyframes": [
        "002544.webp",
        "002545.webp",
        "002564.webp",
        "002583.webp",
        "002584.webp",
        "002616.webp",
        "002648.webp",
        "002649.webp",
        "002666.webp",
        "002684.webp",
        "002685.webp",
        "002712.webp",
        "002740.webp",
        "002741.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Bên đây Long sẽ tiếp tục cắt lạp xưởng.",
      "start": 110.36,
      "end": 112.16,
      "n_words": 9,
      "start_frame": 2759,
      "end_frame": 2804,
      "keyframes": [
        "002772.webp",
        "002803.webp",
        "002804.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cái lạp xưởng này mình đã luộc trước khi mình cắt được chưa Tuấn ơi.",
      "start": 112.16,
      "end": 116.64,
      "n_words": 15,
      "start_frame": 2804,
      "end_frame": 2916,
      "keyframes": [
        "002804.webp",
        "002821.webp",
        "002839.webp",
        "002840.webp",
        "002864.webp",
        "002889.webp",
        "002890.webp",
        "002903.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ mình vớt ra, mình trần qua, vớt ra mình trần qua nước lạnh đi.",
      "start": 116.64,
      "end": 118.6,
      "n_words": 16,
      "start_frame": 2916,
      "end_frame": 2965,
      "keyframes": [
        "002917.webp",
        "002918.webp",
        "002941.webp",
        "002964.webp",
        "002965.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đây, giữ lại màu xanh, màu rất là đẹp. Cái quan trọng là gì?",
      "start": 118.6,
      "end": 122.48,
      "n_words": 14,
      "start_frame": 2965,
      "end_frame": 3062,
      "keyframes": [
        "002965.webp",
        "002995.webp",
        "003025.webp",
        "003026.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mình chỉ luộc sơ thôi, một hồi mình còn xào nữa mà đúng không?",
      "start": 122.48,
      "end": 125.4,
      "n_words": 14,
      "start_frame": 3062,
      "end_frame": 3135,
      "keyframes": [
        "003085.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Đúng rồi.",
      "start": 125.4,
      "end": 125.88,
      "n_words": 3,
      "start_frame": 3135,
      "end_frame": 3147,
      "keyframes": [
        "003144.webp",
        "003145.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Lòng là xưởng nha, là sườn.",
      "start": 125.88,
      "end": 130.16,
      "n_words": 7,
      "start_frame": 3147,
      "end_frame": 3254,
      "keyframes": [
        "003168.webp",
        "003191.webp",
        "003192.webp",
        "003217.webp",
        "003243.webp",
        "003244.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nó cắt xong bây giờ mình sẽ cho ra dĩa.",
      "start": 130.16,
      "end": 131.68,
      "n_words": 10,
      "start_frame": 3254,
      "end_frame": 3292,
      "keyframes": [
        "003267.webp",
        "003291.webp",
        "003292.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Với cái bông cơm chiên ở lòng mình có gạo chuẩn cũ luôn, rất phù hợp để chiên cơm.",
      "start": 131.68,
      "end": 136.48,
      "n_words": 19,
      "start_frame": 3292,
      "end_frame": 3412,
      "keyframes": [
        "003292.webp",
        "003304.webp",
        "003317.webp",
        "003318.webp",
        "003332.webp",
        "003347.webp",
        "003348.webp",
        "003359.webp",
        "003371.webp",
        "003372.webp",
        "003396.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Các bạn ở nhà có thể chọn loại gạo cũ một chút xíu và mình nấu cơm nó hơi khô thì cái hạt gạo mà khi nấu xong nó sẽ tơi và sẽ ngon hơn khi chiên.",
      "start": 136.76,
      "end": 144.6,
      "n_words": 37,
      "start_frame": 3419,
      "end_frame": 3615,
      "keyframes": [
        "003421.webp",
        "003422.webp",
        "003518.webp",
        "003614.webp",
        "003615.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ mình sẽ trộn với lại xá xíu nè, rồi mình phải trộn vào hết phần đậu Hà Lan và cà rốt.",
      "start": 144.6,
      "end": 150.92,
      "n_words": 23,
      "start_frame": 3615,
      "end_frame": 3773,
      "keyframes": [
        "003615.webp",
        "003656.webp",
        "003697.webp",
        "003698.webp",
        "003734.webp",
        "003771.webp",
        "003772.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tiếp đến chúng ta sẽ cho vào đây là hai muỗng cà phê hạt nêm Aji-ngon heo đó, giúp cho món ăn của mình nó sẽ đậm đà hơn.",
      "start": 150.92,
      "end": 156.96,
      "n_words": 29,
      "start_frame": 3773,
      "end_frame": 3924,
      "keyframes": [
        "003800.webp",
        "003829.webp",
        "003830.webp",
        "003877.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Một muỗng cà phê nước tương Phú Sĩ, Tuấn rất là thích cái mùi của nước tương - Long cũng rất là thích.",
      "start": 156.96,
      "end": 161.4,
      "n_words": 23,
      "start_frame": 3924,
      "end_frame": 4035,
      "keyframes": [
        "003925.webp",
        "003926.webp",
        "003954.webp",
        "003982.webp",
        "003983.webp",
        "004008.webp",
        "004033.webp",
        "004034.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "- Một muỗng cà phê đường, một muỗng canh sốt cà chua và kế đến là một muỗng canh dầu điều.",
      "start": 161.4,
      "end": 166.88,
      "n_words": 21,
      "start_frame": 4035,
      "end_frame": 4172,
      "keyframes": [
        "004056.webp",
        "004079.webp",
        "004080.webp",
        "004095.webp",
        "004110.webp",
        "004111.webp",
        "004153.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cho từ từ vào và mình sẽ trộn đều lên.",
      "start": 166.88,
      "end": 169.04,
      "n_words": 10,
      "start_frame": 4172,
      "end_frame": 4226,
      "keyframes": [
        "004195.webp",
        "004196.webp",
        "004209.webp",
        "004223.webp",
        "004224.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Khúc này Tuấn làm cho cái phần lạp xưởng này, chỉ cần bếp chỉ cần hơi nóng nóng sẽ bỏ vào lòng chảo xào cho nó tươm phần mỡ ra.",
      "start": 169.04,
      "end": 174.48,
      "n_words": 30,
      "start_frame": 4226,
      "end_frame": 4362,
      "keyframes": [
        "004236.webp",
        "004249.webp",
        "004250.webp",
        "004304.webp",
        "004358.webp",
        "004359.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tại vì mình đã luộc với nước rồi, luộc với nước rồi nên nó chín rồi đó.",
      "start": 174.48,
      "end": 178.88,
      "n_words": 17,
      "start_frame": 4362,
      "end_frame": 4472,
      "keyframes": [
        "004386.webp",
        "004414.webp",
        "004415.webp",
        "004445.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ cái phần nó lóe lên nè với lại nó có một cái mùi hương rất là thơm đó, thì lúc này Long sẽ cho vào cái phần cơm của Tuấn để mình trộn tiếp nha.",
      "start": 178.88,
