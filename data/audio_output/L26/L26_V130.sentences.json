      "end": 54.04,
      "n_words": 40,
      "start_frame": 1120,
      "end_frame": 1351,
      "keyframes": [
        "001248.webp",
        "001249.webp",
        "001304.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng mình tưởng biết vỏ bánh này là gì?",
