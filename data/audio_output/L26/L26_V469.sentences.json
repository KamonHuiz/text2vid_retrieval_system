        "003583.webp",
        "003584.webp",
        "003599.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chuyển sang một cái hương vị nó là thơm nồng rồi đó, thơm nồng.",
      "start": 144.16,
      "end": 147.84,
      "n_words": 14,
      "start_frame": 3604,
      "end_frame": 3696,
      "keyframes": [
        "003614.webp",
        "003615.webp",
        "003656.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho vào đây ba muỗng canh tương cà, nó đẹp hơn, màu đẹp và nó tạo được cái độ sệt sánh cho cái phần sốt.",
      "start": 147.84,
      "end": 154.44,
      "n_words": 25,
      "start_frame": 3696,
      "end_frame": 3861,
      "keyframes": [
        "003698.webp",
