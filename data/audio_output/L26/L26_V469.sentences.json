        "003028.webp",
        "003029.webp",
        "003050.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chúng ta sẽ cần khoảng một muỗng canh dầu ăn.",
      "start": 122.84,
      "end": 125.0,
      "n_words": 10,
      "start_frame": 3071,
