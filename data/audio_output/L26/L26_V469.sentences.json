        "002537.webp",
        "002582.webp",
        "002583.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Ngâm đậu hũ trong nước có gia vị để đậu hũ được thấm vị hơn.",
      "start": 103.36,
      "end": 106.8,
      "n_words": 15,
      "start_frame": 2584,
      "end_frame": 2670,
      "keyframes": [
