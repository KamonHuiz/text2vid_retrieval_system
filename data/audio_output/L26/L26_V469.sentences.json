        "003072.webp",
        "003073.webp",
        "003099.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đầu tiên là chúng ta sẽ cho hành tây vào, tiếp theo là hành boaro.",
      "start": 125.0,
      "end": 128.16,
      "n_words": 15,
      "start_frame": 3125,
      "end_frame": 3204,
      "keyframes": [
        "003126.webp",
        "003127.webp",
        "003170.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ xào hành tây và hành boaro trước để cho hành tây trong lại và ngả sang màu vàng cánh gián đậm một chút xíu thì món sốt sẽ ngon hơn.",
      "start": 128.48,
      "end": 136.16,
      "n_words": 33,
      "start_frame": 3212,
      "end_frame": 3404,
      "keyframes": [
