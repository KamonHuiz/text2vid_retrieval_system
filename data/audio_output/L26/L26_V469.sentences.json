        "002349.webp",
        "002377.webp",
        "002406.webp"
      ],
      "keyframe_count": 19
    },
    {
      "text": "Cái phần đậu hũ trắng chúng ta sẽ cắt làm tám miếng nhỏ và chúng ta sẽ ngâm vào cái phần nước ấm có gia vị khi nãy.",
      "start": 96.24,
      "end": 103.36,
      "n_words": 28,
      "start_frame": 2406,
      "end_frame": 2584,
      "keyframes": [
        "002406.webp",
