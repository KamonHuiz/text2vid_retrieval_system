        "002635.webp",
        "002636.webp",
        "002654.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cắt hành tây hạt lựu nhỏ.",
      "start": 106.8,
      "end": 110.64,
      "n_words": 6,
      "start_frame": 2670,
      "end_frame": 2766,
