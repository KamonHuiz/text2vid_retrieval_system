        "003747.webp",
        "003811.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta cần một muỗng canh đường nữa, xào cái phần này lên cho tất cả những nguyên liệu hòa quyện với nhau và chúng ta còn một cái phần cà chua bằm nữa.",
      "start": 154.44,
      "end": 164.84,
      "n_words": 34,
      "start_frame": 3861,
      "end_frame": 4121,
      "keyframes": [
        "003876.webp",
