        "003348.webp",
        "003377.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và bây giờ hành tây cũng đã trong, hành boaro cũng trong và ngả sang màu vàng vừa ý mình rồi thì bây giờ chúng ta sẽ cho gừng băm nha, ớt.",
      "start": 136.16,
      "end": 144.16,
      "n_words": 32,
      "start_frame": 3404,
      "end_frame": 3604,
      "keyframes": [
