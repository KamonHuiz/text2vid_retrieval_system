  "total_words": 1054,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.56,
      "end": 11.96,
      "n_words": 4,
      "start_frame": 264,
      "end_frame": 299,
      "keyframes": [
        "000299.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Xin ơi làm gì đó?",
      "start": 11.96,
      "end": 13.72,
      "n_words": 5,
      "start_frame": 299,
      "end_frame": 343,
      "keyframes": [
        "000299.webp",
        "000300.webp",
        "000320.webp",
        "000341.webp",
        "000342.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Xin đang nghiên cứu lại một cái loại sốt sambal mà tự nhiên quên công thức, cho nên bây giờ phải đang nhớ lại nè.",
      "start": 13.72,
      "end": 19.36,
      "n_words": 25,
      "start_frame": 343,
      "end_frame": 484,
      "keyframes": [
        "000377.webp",
        "000412.webp",
        "000413.webp",
        "000446.webp",
        "000479.webp",
        "000480.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Sambal nè nè, đừng có nghĩ tới điệu nhảy nha, một loại sốt đặc biệt của Indo.",
      "start": 19.36,
      "end": 23.88,
      "n_words": 17,
      "start_frame": 484,
      "end_frame": 597,
      "keyframes": [
        "000510.webp",
        "000541.webp",
        "000542.webp",
        "000569.webp",
        "000597.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trời ơi, sao biết hay vậy?",
      "start": 23.88,
      "end": 26.0,
      "n_words": 6,
      "start_frame": 597,
      "end_frame": 650,
      "keyframes": [
        "000597.webp",
        "000598.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cái sốt sambal này nó bị sao rồi, nó như thế nào và nó ăn với cái gì?",
      "start": 26.0,
      "end": 30.48,
      "n_words": 18,
      "start_frame": 650,
      "end_frame": 762,
      "keyframes": [
        "000681.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Thì thật ra cái sốt sambal này thì nó hơi đặc biệt bởi vì rất là nhiều cái gia vị mà nguyên vật liệu có mùi hòa vào nhau, nhưng mà đặc biệt cái sốt này thì nó sẽ có một cái vị cay là chính và rất là đậm vị.",
      "start": 30.48,
      "end": 42.92,
      "n_words": 51,
      "start_frame": 762,
      "end_frame": 1073,
      "keyframes": [
        "000765.webp",
        "000766.webp",
        "000858.webp",
        "000950.webp",
        "000951.webp",
        "001013.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hôm nay Xin sẽ nghiên cứu để làm ra một cái loại sốt mà chúng ta có thể ăn chay được, kết hợp với lại đậu hũ non tẩm với mè.",
      "start": 42.92,
      "end": 49.8,
      "n_words": 31,
      "start_frame": 1073,
      "end_frame": 1245,
      "keyframes": [
        "001076.webp",
        "001077.webp",
        "001124.webp",
        "001171.webp",
        "001172.webp",
        "001207.webp",
        "001243.webp",
        "001244.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trời ơi nghe thôi là thấy kích thích khẩu vị rồi đó, chắc phải làm liền ha.",
      "start": 49.8,
      "end": 54.4,
      "n_words": 17,
