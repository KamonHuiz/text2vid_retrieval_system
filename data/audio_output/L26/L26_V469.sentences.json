        "001409.webp",
        "001434.webp",
        "001435.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đậu hũ áp chảo sốt sambal sánh, đậm đà lắm.",
      "start": 57.4,
      "end": 76.92,
      "n_words": 10,
      "start_frame": 1435,
      "end_frame": 1923,
      "keyframes": [
