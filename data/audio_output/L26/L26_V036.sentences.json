        "001365.webp",
        "001431.webp",
        "001432.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Wow, chúng ta bắt tay vào sơ chế luôn anh nha.",
      "start": 57.4,
      "end": 60.2,
      "n_words": 11,
      "start_frame": 1435,
