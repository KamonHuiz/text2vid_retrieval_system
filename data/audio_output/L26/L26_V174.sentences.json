        "001436.webp",
        "001437.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần ức gà này thì bây giờ Phước Hưng sẽ lạng mỏng vừa ăn.",
      "start": 57.52,
      "end": 60.72,
