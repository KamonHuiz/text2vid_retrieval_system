        "000556.webp",
        "000582.webp",
        "000583.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rong biển là rong biển đúng không?",
      "start": 23.36,
      "end": 25.28,
      "n_words": 7,
      "start_frame": 584,
      "end_frame": 632,
      "keyframes": [
        "000607.webp",
        "000631.webp",
        "000632.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chính xác luôn.",
      "start": 25.28,
      "end": 26.12,
      "n_words": 3,
      "start_frame": 632,
      "end_frame": 653,
      "keyframes": [
        "000632.webp",
        "000646.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Củ sen sẽ kết hợp với rong biển để nấu ra một cái món canh rất là thanh đạm mà lại ăn mát cho cơ thể của mình nữa.",
      "start": 26.12,
      "end": 32.56,
      "n_words": 29,
      "start_frame": 653,
      "end_frame": 814,
      "keyframes": [
        "000660.webp",
        "000661.webp",
        "000737.webp",
        "000813.webp",
        "000814.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hay quá Hưng ơi, chúng ta sẽ bắt đầu ngay thôi.",
      "start": 32.56,
      "end": 36.88,
      "n_words": 11,
      "start_frame": 814,
      "end_frame": 922,
      "keyframes": [
        "000814.webp",
        "000826.webp",
        "000839.webp",
        "000840.webp",
        "000857.webp",
        "000874.webp",
        "000875.webp",
        "000899.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Canh củ sen rong biển ngọt thanh mát lành. Chào các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 36.88,
      "end": 57.36,
      "n_words": 21,
      "start_frame": 922,
      "end_frame": 1434,
      "keyframes": [
        "000924.webp",
        "000925.webp",
        "000959.webp",
        "000994.webp",
        "000995.webp",
        "001020.webp",
        "001046.webp",
        "001061.webp",
        "001125.webp",
        "001189.webp",
        "001190.webp",
        "001276.webp",
        "001363.webp",
        "001364.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 57.36,
      "end": 61.36,
      "n_words": 11,
      "start_frame": 1434,
      "end_frame": 1534,
      "keyframes": [
        "001452.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ở đây Phước Hưng chuẩn bị là tàu hủ ki tươi, đây là dạng cộng có hai dạng tàu hủ ki: một là dạng tàu hủ ki khô và tàu hủ ki tươi.",
      "start": 61.36,
      "end": 69.52,
      "n_words": 33,
      "start_frame": 1534,
      "end_frame": 1738,
      "keyframes": [
        "001540.webp",
        "001541.webp",
        "001570.webp",
        "001599.webp",
        "001600.webp",
        "001620.webp",
        "001641.webp",
        "001642.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Nhưng nếu mà chúng ta nấu tiết kiệm thời gian hơn và ăn cũng ngon nữa thì chúng ta nên mua cái loại tươi như vầy.",
      "start": 69.52,
      "end": 74.96,
      "n_words": 26,
      "start_frame": 1738,
      "end_frame": 1874,
      "keyframes": [
        "001756.webp",
        "001870.webp",
        "001871.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ chúng ta sẽ cắt ra thành từng đoạn vừa ăn nè, rồi Hưng sẽ cho hết qua một cái tô.",
      "start": 74.96,
      "end": 82.08,
      "n_words": 22,
      "start_frame": 1874,
      "end_frame": 2052,
      "keyframes": [
        "001949.webp",
        "002027.webp",
        "002028.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta ướp phần tàu hủ ki trước, và đây cũng là một cái lưu ý cho quý vị nhé: chúng ta sẽ ướp gia vị vào tàu hủ ki trước khi nấu, làm như vậy giúp cho món ăn khi ăn sẽ ngon hơn.",
      "start": 82.08,
      "end": 90.64,
      "n_words": 45,
      "start_frame": 2052,
      "end_frame": 2266,
      "keyframes": [
        "002058.webp",
        "002088.webp",
        "002089.webp",
        "002176.webp",
        "002263.webp",
        "002264.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cho vào đây nửa muỗng cà phê bột ngọt Ajinomoto, một muỗng cà phê hạt nêm Aji-ngon, một muỗng canh hành bo rô băm.",
      "start": 90.64,
      "end": 97.8,
      "n_words": 24,
      "start_frame": 2266,
      "end_frame": 2445,
      "keyframes": [
        "002301.webp",
        "002339.webp",
        "002340.webp",
        "002357.webp",
        "002375.webp",
        "002376.webp",
        "002388.webp",
        "002401.webp",
        "002402.webp",
        "002422.webp",
        "002443.webp",
        "002444.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Bây giờ chúng ta sẽ trộn lên, chúng ta sẽ ướp khoảng 10 tới 15 phút là tàu hủ ki được thấm vị.",
      "start": 97.8,
      "end": 102.28,
      "n_words": 23,
      "start_frame": 2445,
      "end_frame": 2557,
      "keyframes": [
        "002459.webp",
        "002474.webp",
        "002475.webp",
        "002498.webp",
        "002522.webp",
        "002523.webp",
        "002540.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Và tiếp theo Phước Hương sẽ hướng dẫn cho quý vị chúng ta sơ chế cái phần rau củ.",
      "start": 102.28,
      "end": 106.08,
      "n_words": 19,
      "start_frame": 2557,
      "end_frame": 2652,
      "keyframes": [
        "002558.webp",
        "002559.webp",
        "002604.webp",
        "002649.webp",
        "002650.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đầu tiên thì phần cà rốt, bây giờ Phước Hương sẽ tỉa hoa vì đây là món canh, các bạn cũng nên lưu ý chúng ta đừng cắt lát quá mỏng vì khi nấu thì nó sẽ bị nát, ăn sẽ không ngon.",
      "start": 106.08,
      "end": 116.52,
      "n_words": 43,
      "start_frame": 2652,
      "end_frame": 2913,
      "keyframes": [
        "002683.webp",
        "002716.webp",
        "002717.webp",
        "002739.webp",
        "002762.webp",
        "002763.webp",
        "002839.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rồi bây giờ chúng ta cho qua một cái dĩa ở bên này.",
      "start": 116.52,
      "end": 119.96,
      "n_words": 13,
      "start_frame": 2913,
      "end_frame": 2999,
      "keyframes": [
        "002916.webp",
        "002917.webp",
        "002959.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Còn phần củ sen, chúng ta bào vỏ cho thật sạch đi và chúng ta sẽ ngâm sơ qua nước chanh, làm như vậy thì giúp cho củ sen được trắng lâu hơn.",
      "start": 119.96,
      "end": 127.72,
      "n_words": 33,
      "start_frame": 2999,
      "end_frame": 3193,
      "keyframes": [
        "003002.webp",
        "003003.webp",
        "003016.webp",
        "003030.webp",
        "003031.webp",
        "003076.webp",
        "003122.webp",
        "003123.webp",
        "003157.webp",
        "003191.webp",
        "003192.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Bây giờ Phước Hương cũng sẽ cắt cái khoanh tròn, phần củ sen này dày khoảng 5 ly.",
      "start": 127.72,
      "end": 131.84,
      "n_words": 18,
      "start_frame": 3193,
      "end_frame": 3296,
      "keyframes": [
        "003227.webp",
        "003262.webp",
        "003263.webp",
        "003289.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Phần này thì cái khoanh tròn nó vừa ăn chúng ta để nguyên, và đây là cái phần hơi lớn thì chúng ta sẽ cắt đôi ra.",
      "start": 131.84,
      "end": 139.68,
      "n_words": 27,
      "start_frame": 3296,
      "end_frame": 3492,
      "keyframes": [
        "003315.webp",
        "003316.webp",
        "003374.webp",
        "003432.webp",
        "003433.webp",
        "003465.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ thì tất cả nguyên liệu của chúng ta đã sẵn sàng.",
      "start": 139.68,
      "end": 142.16,
      "n_words": 13,
      "start_frame": 3492,
      "end_frame": 3554,
      "keyframes": [
        "003498.webp",
        "003499.webp",
        "003535.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ Phước Hương sẽ bật lên trên bếp một cái nồi để chúng ta nấu canh.",
      "start": 142.16,
      "end": 144.96,
      "n_words": 17,
      "start_frame": 3554,
      "end_frame": 3624,
      "keyframes": [
        "003571.webp",
        "003572.webp",
        "003596.webp",
        "003621.webp",
        "003622.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cho vào đây một ít dầu ăn, cho khoảng một muỗng canh hành bo rô băm vào, chúng ta phi thơm thì phần hành bo rô đã dậy lên mùi thơm rồi.",
      "start": 144.96,
      "end": 154.04,
      "n_words": 32,
      "start_frame": 3624,
      "end_frame": 3851,
      "keyframes": [
        "003642.webp",
        "003662.webp",
        "003663.webp",
        "003703.webp",
        "003744.webp",
        "003745.webp",
        "003771.webp",
        "003797.webp",
        "003798.webp",
        "003841.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Phước Hương sẽ cho hết cái phần tàu hủ ki mà mình đã ướp từ lúc ban đầu vào, chúng ta sẽ xào cho dậy mùi thơm và săn miếng tàu hủ ki lên.",
      "start": 154.04,
      "end": 161.08,
      "n_words": 34,
      "start_frame": 3851,
      "end_frame": 4027,
      "keyframes": [
        "003884.webp",
        "003885.webp",
        "003955.webp",
        "004025.webp",
        "004026.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ thì phần tàu hủ ki cũng đã thơm rồi, Phước Hương sẽ cho vào đây một lít hai nước, cho phần củ sen và cà rốt vào.",
      "start": 161.08,
      "end": 167.84,
      "n_words": 29,
      "start_frame": 4027,
      "end_frame": 4196,
      "keyframes": [
        "004083.webp",
        "004141.webp",
        "004142.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bình thường thì củ sen như tất cả chúng ta đều biết là sẽ rất là tốt cho sức khỏe tim mạch nè, ăn củ sen ngủ rất là ngon, giải tỏa được căng thẳng.",
      "start": 167.84,
      "end": 175.0,
      "n_words": 35,
      "start_frame": 4196,
      "end_frame": 4375,
      "keyframes": [
        "004205.webp",
        "004269.webp",
        "004270.webp",
        "004295.webp",
        "004320.webp",
        "004321.webp",
        "004354.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Nhưng mà có một cái nguyên liệu mà ngày hôm nay Kim Thảo rất là thắc mắc đó là bạch quả, không biết là Phước Hương đã chọn bạch quả cho món này thì có cái dụng ý gì không?",
      "start": 176.56,
      "end": 185.32,
      "n_words": 40,
      "start_frame": 4414,
      "end_frame": 4633,
      "keyframes": [
        "004476.webp",
        "004564.webp",
        "004565.webp",
        "004598.webp",
        "004631.webp",
        "004632.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bạch quả thì khi chúng ta ăn thì rất là mát cho cơ thể, bồi bổ cho cơ thể, rất là tốt cho trí não của mình.",
      "start": 185.32,
      "end": 190.56,
      "n_words": 27,
      "start_frame": 4633,
      "end_frame": 4764,
      "keyframes": [
        "004676.webp",
        "004721.webp",
        "004722.webp",
        "004742.webp",
        "004762.webp",
        "004763.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần bạch quả này khi mà quý vị mua về thì chúng ta làm sạch cái phần vỏ cứng bên ngoài đi và chúng ta sẽ luộc sơ một nước trước rồi chúng ta hãy đem đi nấu canh, như vậy thì sẽ giúp cho cái món canh của mình có cái nước trong hơn và đẹp hơn.",
      "start": 190.56,
      "end": 203.4,
      "n_words": 58,
      "start_frame": 4764,
      "end_frame": 5085,
      "keyframes": [
        "004924.webp",
        "005085.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cho phần bạch quả vào, chúng ta nêm gia vị vào đây: Hưng sẽ cho vào đây là một muỗng cà phê muối nè, một muỗng cà phê bột ngọt Ajinomoto và nửa muỗng canh hạt nêm Aji-ngon nấm, nửa muỗng canh đường ngọt.",
      "start": 203.4,
      "end": 216.68,
      "n_words": 44,
      "start_frame": 5085,
      "end_frame": 5417,
      "keyframes": [
        "005085.webp",
