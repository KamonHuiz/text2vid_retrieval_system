        "000300.webp",
        "000301.webp",
        "000302.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bình thường sen ở dưới ao, hôm nay mát mẻ sen leo lên bờ làm sao?",
      "start": 12.08,
      "end": 17.68,
      "n_words": 16,
      "start_frame": 302,
      "end_frame": 442,
      "keyframes": [
        "000302.webp",
        "000303.webp",
        "000377.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ ngày thường thì không có củ sen, hôm nay lại có, nấu ngay với rong biển.",
      "start": 17.68,
      "end": 23.36,
      "n_words": 18,
      "start_frame": 442,
      "end_frame": 584,
      "keyframes": [
        "000452.webp",
