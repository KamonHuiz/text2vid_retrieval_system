  "n_sentences": 41,
  "total_words": 1061,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.48,
      "end": 12.08,
      "n_words": 4,
      "start_frame": 262,
      "end_frame": 302,
      "keyframes": [
