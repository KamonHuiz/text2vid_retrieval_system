        "005891.webp",
        "005943.webp",
        "005944.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Sau khi mà quý vị chúng ta cho gừng cắt sợi cũng như là rong biển vào rồi thì chúng ta nấu khoảng một phút nữa thôi là canh đã chín rồi, khói nghi ngút luôn.",
      "start": 237.8,
      "end": 248.08,
      "n_words": 36,
      "start_frame": 5945,
      "end_frame": 6202,
      "keyframes": [
        "006021.webp",
