        "005329.webp",
        "005346.webp",
        "005347.webp",
        "005389.webp"
      ],
      "keyframe_count": 27
    },
    {
      "text": "Đối với món canh ngày hôm nay thì các bạn có thể kết hợp với nhiều loại rau củ khác nhau để tạo nên một cái món canh thanh mát và phong phú hơn.",
      "start": 217.52,
      "end": 225.2,
      "n_words": 34,
      "start_frame": 5438,
      "end_frame": 5630,
      "keyframes": [
        "005464.webp",
        "005495.webp",
        "005496.webp",
        "005562.webp",
        "005628.webp",
        "005629.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ Hưng sẽ cho gừng cắt sợi vào nè để cái món canh này chúng ta ăn ấm bụng hơn.",
      "start": 225.2,
      "end": 229.8,
      "n_words": 21,
      "start_frame": 5630,
      "end_frame": 5745,
      "keyframes": [
        "005669.webp",
        "005709.webp",
        "005710.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho phần rong biển vào, chúng ta sẽ cho rong biển vào sau cùng giúp cho rong biển giữ được độ tươi mát và độ giòn khi ăn sẽ ngon hơn.",
      "start": 229.8,
      "end": 237.8,
      "n_words": 31,
      "start_frame": 5745,
      "end_frame": 5945,
      "keyframes": [
        "005774.webp",
