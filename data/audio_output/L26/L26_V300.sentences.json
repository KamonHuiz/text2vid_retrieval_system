        "003759.webp",
        "003784.webp",
        "003785.webp",
        "003808.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "- Với món canh chùm ngây này cô Hà chọn là dưa leo nấu chung thì có một cái mục đích gì không ạ?",
      "start": 153.24,
      "end": 160.52,
      "n_words": 24,
      "start_frame": 3831,
      "end_frame": 4013,
      "keyframes": [
        "003832.webp",
        "003833.webp",
        "003890.webp",
        "003948.webp",
        "003949.webp",
        "003988.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Có chứ, chúng ta sẽ thêm dưa leo vào món canh chùm ngây để tạo độ ngọt cũng như là mùi thơm đặc trưng cho món ăn.",
      "start": 160.52,
      "end": 166.76,
      "n_words": 28,
      "start_frame": 4013,
      "end_frame": 4169,
      "keyframes": [
        "004028.webp",
        "004029.webp",
        "004098.webp",
        "004168.webp",
        "004169.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp tục làm nó đi ha.",
      "start": 166.76,
      "end": 167.92,
      "n_words": 6,
      "start_frame": 4169,
      "end_frame": 4198,
      "keyframes": [
        "004169.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi cô sẽ bắc một cái nồi lên để mà mình chuẩn bị nấu canh.",
      "start": 167.92,
      "end": 171.88,
