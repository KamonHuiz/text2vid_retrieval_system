        "003632.webp",
        "003678.webp",
        "003679.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi tiếp theo thì dưa leo sẽ lạng bỏ bớt cái ruột, sẽ cắt lát dày 5 ly.",
      "start": 147.36,
      "end": 153.24,
      "n_words": 18,
