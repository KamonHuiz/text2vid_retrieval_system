        "000591.webp",
        "000618.webp",
        "000619.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Em còn trẻ lắm Thảo ơi mà lo cái gì.",
      "start": 24.8,
      "end": 27.08,
      "n_words": 10,
      "start_frame": 620,
      "end_frame": 677,
      "keyframes": [
        "000648.webp",
        "000677.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- À cô Hà có cái món nào mà rau củ nào mà có nhiều canxi để mình tốt cho xương khớp không cô Hà?",
      "start": 27.08,
