        "001667.webp",
        "001729.webp",
        "001730.webp",
        "001816.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày, chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 74.2,
      "end": 82.88,
      "n_words": 24,
      "start_frame": 1855,
      "end_frame": 2072,
      "keyframes": [
        "001903.webp",
        "001904.webp",
        "001989.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đầu tiên ở đây nếu mà được thì mình sẽ chọn mua tôm tươi lạnh và mình sẽ lau thật khô tôm.",
      "start": 82.88,
      "end": 88.8,
      "n_words": 22,
      "start_frame": 2072,
      "end_frame": 2220,
      "keyframes": [
        "002074.webp",
        "002075.webp",
        "002084.webp",
        "002093.webp",
        "002094.webp",
        "002130.webp",
        "002167.webp",
        "002168.webp",
        "002194.webp",
        "002220.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ lau khô tôm thì xay xong tôm sẽ dai nha.",
      "start": 88.8,
      "end": 93.4,
      "n_words": 18,
