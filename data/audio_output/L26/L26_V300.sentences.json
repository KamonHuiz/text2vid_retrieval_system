      "n_words": 12,
      "start_frame": 5371,
      "end_frame": 5437,
      "keyframes": [
        "005429.webp",
        "005430.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Dạ, trước khi cho vô thì mình nên vò sơ sơ lá chùm ngây nha.",
      "start": 217.48,
      "end": 223.2,
      "n_words": 15,
      "start_frame": 5437,
      "end_frame": 5580,
      "keyframes": [
        "005466.webp",
        "005502.webp",
        "005503.webp",
        "005554.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi mình cho vô đây, nước sôi trở lại, cho dưa leo thì không được để nước sôi lâu quá nha.",
      "start": 223.2,
      "end": 228.56,
      "n_words": 21,
      "start_frame": 5580,
      "end_frame": 5714,
      "keyframes": [
        "005606.webp",
