        "005135.webp",
        "005136.webp",
        "005186.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Sau khi cho tôm vô mình đợi cho cái nước sôi lại khoảng chừng hai phút cho viên tôm thật chín bên trong.",
      "start": 209.36,
      "end": 214.84,
      "n_words": 23,
      "start_frame": 5234,
