        "003307.webp",
        "003308.webp",
        "003340.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Rồi đẹp lắm, cứ vậy mà làm hết nha Thảo nha.",
      "start": 133.64,
      "end": 137.44,
      "n_words": 11,
      "start_frame": 3341,
