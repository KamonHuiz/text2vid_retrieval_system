      "keyframes": [
        "004205.webp",
        "004241.webp",
        "004242.webp",
        "004272.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nồi nóng rồi mình bắt đầu cho dầu vô nha, một ít hành tím băm vô, tím băm vô phi lên cho thơm.",
      "start": 171.88,
      "end": 177.6,
      "n_words": 23,
      "start_frame": 4297,
      "end_frame": 4440,
      "keyframes": [
        "004302.webp",
        "004303.webp",
        "004331.webp",
        "004360.webp",
        "004361.webp",
        "004381.webp",
        "004402.webp",
        "004403.webp",
        "004421.webp",
        "004440.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Nên xào nấm rơm trước Kim Thảo, và các bạn lưu ý là đối với món ăn này thì chúng ta sẽ xào nấm rơm trước để nấm rơm thơm và không bị hăng mùi nấm nha.",
      "start": 177.6,
      "end": 186.6,
      "n_words": 37,
      "start_frame": 4440,
      "end_frame": 4665,
      "keyframes": [
        "004440.webp",
