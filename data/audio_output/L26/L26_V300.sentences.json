      "keyframes": [
        "003373.webp",
        "003374.webp",
        "003405.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong lúc đó thì chúng ta sẽ sơ chế đến phần nấm rơm.",
      "start": 137.44,
      "end": 140.44,
      "n_words": 13,
      "start_frame": 3436,
      "end_frame": 3511,
      "keyframes": [
        "003437.webp",
        "003438.webp",
        "003511.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nấm rơm mà sau khi rửa sạch rồi thì bây giờ chúng ta chỉ có cắt đôi thôi, nhưng nếu như nấm nhỏ thì mình có thể để nguyên.",
      "start": 140.44,
      "end": 147.36,
      "n_words": 29,
      "start_frame": 3511,
      "end_frame": 3684,
      "keyframes": [
        "003511.webp",
