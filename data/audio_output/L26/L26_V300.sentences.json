        "002845.webp",
        "002846.webp",
        "002901.webp",
        "002956.webp",
        "002957.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tôm cô đã xay xong thì cô sẽ cho vào đây là một ít ớt băm, mình sử dụng ớt sừng.",
      "start": 119.08,
      "end": 124.6,
      "n_words": 21,
      "start_frame": 2977,
      "end_frame": 3115,
      "keyframes": [
        "002983.webp",
        "003010.webp",
        "003011.webp",
        "003058.webp",
        "003106.webp",
        "003107.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Em trộn lên đi, xong rồi sau đó em sẽ dùng tay em thấm nước và em vo tôm thành những cái viên như mấy cái tay nắm này nha.",
