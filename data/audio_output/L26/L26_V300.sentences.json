      "keyframes": [
        "000861.webp",
        "000888.webp",
        "000889.webp",
        "000920.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Không bị thừa chất chứ gì?",
      "start": 37.48,
      "end": 40.08,
      "n_words": 6,
      "start_frame": 937,
      "end_frame": 1002,
      "keyframes": [
        "000952.webp",
        "000953.webp",
        "000986.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô nghĩ ra rồi, à đó là chùm ngây đó.",
      "start": 40.08,
      "end": 42.96,
      "n_words": 10,
      "start_frame": 1002,
      "end_frame": 1074,
      "keyframes": [
