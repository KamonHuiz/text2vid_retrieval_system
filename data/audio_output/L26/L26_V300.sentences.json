        "000780.webp",
        "000833.webp",
        "000834.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "- À muốn bổ sung canxi là từ thực vật đúng không dạ?",
      "start": 33.56,
      "end": 37.48,
      "n_words": 13,
      "start_frame": 839,
