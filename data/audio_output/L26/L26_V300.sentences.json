        "004549.webp",
        "004550.webp",
        "004578.webp",
        "004606.webp",
        "004607.webp",
        "004636.webp",
        "004665.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Mình sẽ cho vào đây một chút xíu muối rồi.",
      "start": 186.6,
      "end": 189.32,
      "n_words": 10,
      "start_frame": 4665,
      "end_frame": 4733,
      "keyframes": [
        "004665.webp",
        "004666.webp",
        "004693.webp",
        "004720.webp",
        "004721.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nấm rơm thơm rồi đó, cô sẽ cho vào đây một lít hai nước, mình đun cho nước sôi lên nha.",
      "start": 189.32,
      "end": 194.84,
      "n_words": 21,
      "start_frame": 4733,
      "end_frame": 4871,
      "keyframes": [
        "004745.webp",
