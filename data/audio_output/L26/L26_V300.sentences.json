      "end_frame": 2335,
      "keyframes": [
        "002220.webp",
        "002221.webp",
        "002276.webp",
        "002332.webp",
        "002333.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ cô sẽ cho tôm vào trong cái cối xay này.",
      "start": 93.4,
      "end": 95.84,
      "n_words": 12,
      "start_frame": 2335,
      "end_frame": 2396,
      "keyframes": [
        "002363.webp",
        "002394.webp",
        "002395.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sau khi cho tôm xong thì cô sẽ cho gia vị vô, cô sẽ cho vô đây là một ít hạt nêm Aji-no-moto nấm, hành lá đã cắt nhỏ nè, mình sẽ thêm vào đây một ít tiêu cho vào trong cối, mình bắt đầu xay ha.",
      "start": 95.84,
      "end": 108.48,
      "n_words": 47,
      "start_frame": 2396,
      "end_frame": 2712,
      "keyframes": [
        "002428.webp",
        "002462.webp",
        "002463.webp",
        "002507.webp",
