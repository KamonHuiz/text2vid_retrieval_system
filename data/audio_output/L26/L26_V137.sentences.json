        "001169.webp",
        "001170.webp",
        "001307.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Cánh gà là một nguyên liệu rất là tốt cho sức khỏe và cung cấp protein tốt cho cơ thể.",
      "start": 54.8,
      "end": 59.28,
      "n_words": 20,
