        "002227.webp",
        "002272.webp",
        "002273.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Tiếp theo chúng ta sẽ pha cái hỗn hợp ướp vào phần cánh gà.",
      "start": 90.92,
