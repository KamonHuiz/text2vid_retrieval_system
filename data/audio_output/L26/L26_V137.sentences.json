        "000709.webp",
        "000799.webp",
        "000800.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Azino Việt Nam.",
      "start": 36.56,
      "end": 41.0,
      "n_words": 11,
      "start_frame": 914,
