        "001824.webp",
        "001858.webp",
        "001859.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chương trình sẽ giới thiệu một món chay có tên gọi là củ năng ôm nấm chay.",
      "start": 74.4,
      "end": 79.6,
