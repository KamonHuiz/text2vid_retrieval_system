      "end": 56.32,
      "n_words": 4,
      "start_frame": 1382,
      "end_frame": 1408,
      "keyframes": [
        "001406.webp",
        "001407.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chào Minh Tuấn.",
