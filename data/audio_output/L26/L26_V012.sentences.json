        "001923.webp",
        "001987.webp",
        "001988.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Theo chuyên gia dinh dưỡng, sẽ là một món ăn hỗ trợ cho tim mạch và giảm mỡ thừa.",
      "start": 79.6,
      "end": 84.12,
