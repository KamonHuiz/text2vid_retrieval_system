        "001546.webp",
        "001547.webp",
        "001593.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Á cô!",
      "start": 65.12,
      "end": 65.6,
      "n_words": 2,
      "start_frame": 1628,
      "end_frame": 1640,
      "keyframes": [
        "001640.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ mình lại tiếp tục, em nhờ cô làm thêm món mới để mà vào những cái dịp đặc biệt như là rằm nè hay là mùng một để cho mọi người có những cái món mới để mình trải nghiệm trong việc ăn chay.",
