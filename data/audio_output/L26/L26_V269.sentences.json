        "005576.webp"
      ],
      "keyframe_count": 32
    },
    {
      "text": "Rồi chúng ta cho thêm vào đây ớt sừng các bạn, nửa muỗng cà phê thôi.",
      "start": 223.2,
      "end": 227.16,
      "n_words": 16,
