        "004553.webp",
        "004554.webp",
        "004591.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi xong chúng ta tắt lửa.",
      "start": 183.64,
      "end": 185.28,
      "n_words": 6,
      "start_frame": 4591,
      "end_frame": 4632,
      "keyframes": [
        "004591.webp",
        "004629.webp",
        "004630.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Như chúng ta cũng đã biết thì mì căn làm từ bột mì, giúp thay thế cái chất đạm từ động vật để món ăn chúng ta cân bằng được dinh dưỡng hơn.",
      "start": 185.28,
      "end": 192.88,
      "n_words": 33,
      "start_frame": 4632,
      "end_frame": 4822,
      "keyframes": [
        "004652.webp",
