        "004076.webp",
        "004096.webp",
        "004097.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Cho mì căn đúng rồi, rồi mình xào cho nó săn.",
      "start": 164.48,
      "end": 167.24,
      "n_words": 11,
      "start_frame": 4112,
      "end_frame": 4181,
      "keyframes": [
        "004139.webp",
        "004181.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Tới đây các bạn đó, hạ lửa nhỏ nha các bạn.",
      "start": 167.24,
      "end": 171.56,
      "n_words": 11,
      "start_frame": 4181,
      "end_frame": 4289,
      "keyframes": [
        "004181.webp",
