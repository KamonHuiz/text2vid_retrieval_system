        "004268.webp",
        "004285.webp",
        "004286.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta mới nêm vào đây nửa muỗng cà phê bột ngọt Ajinomoto, nửa muỗng canh nước tương Phú Sĩ.",
      "start": 171.56,
      "end": 177.04,
      "n_words": 20,
      "start_frame": 4289,
      "end_frame": 4426,
      "keyframes": [
        "004305.webp",
        "004324.webp",
        "004325.webp",
        "004339.webp",
        "004353.webp",
        "004354.webp",
        "004370.webp",
        "004386.webp",
        "004387.webp",
        "004405.webp",
        "004423.webp",
        "004424.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Vậy là xong hả anh?",
      "start": 177.04,
      "end": 178.08,
      "n_words": 5,
      "start_frame": 4426,
      "end_frame": 4452,
      "keyframes": [
        "004443.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, bây giờ phúc mình tăng lửa lên cho mì căn đó, sôi ha.",
      "start": 178.08,
      "end": 183.64,
      "n_words": 15,
