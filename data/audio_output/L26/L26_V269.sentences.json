        "004734.webp",
        "004749.webp",
        "004750.webp",
        "004783.webp",
        "004817.webp",
        "004818.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Hoa chuối thì có tác dụng là chống viêm nè, ngăn các bệnh như là thiếu máu nè hoặc là chống lão hóa rất là tốt.",
      "start": 192.88,
      "end": 198.56,
      "n_words": 26,
      "start_frame": 4822,
      "end_frame": 4964,
      "keyframes": [
        "004890.webp",
        "004963.webp",
        "004964.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hoa chuối cũng là món ăn rất là tốt cho những chị em mà đang nuôi con nhỏ.",
      "start": 198.56,
      "end": 202.96,
      "n_words": 18,
      "start_frame": 4964,
      "end_frame": 5074,
      "keyframes": [
        "004964.webp",
        "004978.webp",
        "004992.webp",
        "004993.webp",
        "005022.webp",
        "005052.webp",
        "005053.webp",
        "005065.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta sẽ pha nước trộn cho các bạn: sẽ cho nửa muỗng cà phê bột ngọt Ajinomoto, khoảng nửa muỗng cà phê muối nha các bạn, hai muỗng canh giấm gạo lên men Ajinomoto, cho vào đây khoảng một muỗng canh cái tương Phú Sĩ các bạn tạo cái mùi thơm cũng như cái màu đẹp cho cái nước trộn gỏi của mình.",
