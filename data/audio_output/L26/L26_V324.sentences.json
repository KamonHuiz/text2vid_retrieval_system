        "000345.webp",
        "000361.webp",
        "000362.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dạ vâng, hầu như con gái ai cũng thích hoa hết mà.",
      "start": 14.68,
      "end": 16.92,
      "n_words": 12,
      "start_frame": 367,
      "end_frame": 423,
      "keyframes": [
        "000392.webp",
        "000422.webp",
        "000423.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hoa hôm nay tươi quá trời.",
      "start": 16.92,
      "end": 17.96,
      "n_words": 6,
      "start_frame": 423,
      "end_frame": 449,
      "keyframes": [
        "000423.webp",
        "000439.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ăn nè, để hôm nay anh tặng hoa cho em mà.",
