        "002120.webp",
        "002144.webp",
        "002169.webp",
        "002170.webp",
        "002188.webp",
        "002207.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Kế đến chúng ta sẽ băm nhuyễn phần hành lá.",
      "start": 88.28,
      "end": 91.48,
      "n_words": 10,
      "start_frame": 2207,
      "end_frame": 2287,
      "keyframes": [
        "002207.webp",
        "002208.webp",
        "002230.webp",
        "002252.webp",
        "002253.webp",
        "002271.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Với phần tôm thì bây giờ mình sẽ đập dập và băm nhuyễn.",
      "start": 91.48,
      "end": 97.96,
      "n_words": 13,
      "start_frame": 2287,
      "end_frame": 2449,
      "keyframes": [
        "002290.webp",
        "002291.webp",
        "002300.webp",
        "002310.webp",
        "002311.webp",
        "002324.webp",
        "002338.webp",
