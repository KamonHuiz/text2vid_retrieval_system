        "002368.webp",
        "002397.webp",
        "002398.webp",
        "002425.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Phần chuẩn bị nguyên liệu cũng xong.",
      "start": 97.96,
      "end": 99.88,
      "n_words": 7,
      "start_frame": 2449,
