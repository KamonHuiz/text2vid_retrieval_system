      "keyframes": [
        "002452.webp",
        "002453.webp",
        "002472.webp",
        "002492.webp",
        "002493.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ mình hãy chuẩn bị trộn làm cái phần nhân.",
      "start": 99.88,
      "end": 102.48,
      "n_words": 11,
      "start_frame": 2497,
      "end_frame": 2562,
      "keyframes": [
        "002528.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mình đã có tôm rồi, và đây mình có giò sống nha, cho vào.",
      "start": 102.48,
      "end": 105.84,
      "n_words": 14,
      "start_frame": 2562,
      "end_frame": 2646,
      "keyframes": [
        "002563.webp",
        "002564.webp",
        "002580.webp",
        "002596.webp",
        "002597.webp",
        "002620.webp",
        "002644.webp",
        "002645.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cho một phần cà rốt vào, cho hết cái phần nấm này vào, cho hành lá ra một muỗng hành lá thôi, và mình cho cái phần bắp mình đã luộc rồi mình bào ra.",
      "start": 105.84,
      "end": 115.36,
      "n_words": 35,
      "start_frame": 2646,
      "end_frame": 2884,
      "keyframes": [
        "002663.webp",
        "002682.webp",
        "002683.webp",
        "002704.webp",
        "002725.webp",
        "002726.webp",
        "002764.webp",
        "002802.webp",
        "002803.webp",
        "002843.webp",
        "002883.webp",
        "002884.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Bây giờ mình sẽ nêm vào đây là nửa muỗng cà phê đường và một muỗng rưỡi cà phê hạt nêm Ajinomoto ngon heo, nửa muỗng cà phê tiêu, xíu hành tím băm đi cho nó thơm luôn.",
      "start": 115.36,
      "end": 125.76,
      "n_words": 38,
      "start_frame": 2884,
      "end_frame": 3144,
      "keyframes": [
        "002884.webp",
        "002908.webp",
        "002933.webp",
        "002934.webp",
        "002947.webp",
        "002961.webp",
        "002962.webp",
        "002983.webp",
        "003004.webp",
        "003005.webp",
        "003021.webp",
        "003037.webp",
        "003038.webp",
        "003072.webp",
        "003107.webp",
        "003108.webp",
        "003136.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Hết công đoạn quên rồi, phải nói chung là đều tay và mạnh tay được rồi thì nó mới dai và ngon.",
      "start": 125.76,
      "end": 131.44,
      "n_words": 22,
      "start_frame": 3144,
      "end_frame": 3286,
      "keyframes": [
        "003165.webp",
        "003166.webp",
        "003191.webp",
        "003216.webp",
        "003217.webp",
        "003246.webp",
        "003276.webp",
        "003277.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đang cắt tròn cái phần hoành thánh lá này để lát mình làm hoa hồng.",
      "start": 131.68,
      "end": 136.04,
      "n_words": 15,
      "start_frame": 3292,
      "end_frame": 3401,
      "keyframes": [
        "003302.webp",
        "003328.webp",
        "003329.webp",
        "003361.webp",
        "003393.webp",
        "003394.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chia Thanh Phương một ít nè.",
      "start": 136.04,
      "end": 138.4,
      "n_words": 6,
      "start_frame": 3401,
      "end_frame": 3460,
      "keyframes": [
        "003425.webp",
        "003456.webp",
        "003457.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình sẽ lấy ba lá, sau đó mình sẽ cho một muỗng rưỡi nhân vào.",
      "start": 138.4,
      "end": 143.56,
      "n_words": 15,
      "start_frame": 3460,
      "end_frame": 3589,
      "keyframes": [
        "003487.webp",
        "003517.webp",
        "003518.webp",
        "003535.webp",
        "003552.webp",
        "003553.webp",
        "003575.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cái phần nhân ở đây các bạn lưu ý là chúng ta sẽ lấy vừa đủ thôi để khi mà mình chiên lên á thì cái phần nhân bên trong nó dễ chín hơn.",
      "start": 143.56,
      "end": 150.92,
      "n_words": 34,
      "start_frame": 3589,
      "end_frame": 3773,
      "keyframes": [
        "003597.webp",
        "003598.webp",
        "003639.webp",
        "003680.webp",
        "003681.webp",
        "003723.webp",
        "003765.webp",
        "003766.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Để mình gấp đôi lại, mình sẽ cuộn lại, cuộn lại như vậy thôi.",
      "start": 150.92,
      "end": 155.28,
      "n_words": 14,
      "start_frame": 3773,
      "end_frame": 3882,
      "keyframes": [
        "003782.webp",
        "003799.webp",
        "003800.webp",
        "003877.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng rồi, cuộn như vậy thôi nó sẽ hình bông hồng, rồi sau đó mình thấm nhẹ muỗng vào nước ẩm mình dán lại.",
      "start": 155.84,
      "end": 165.44,
      "n_words": 24,
      "start_frame": 3896,
      "end_frame": 4136,
      "keyframes": [
        "003954.webp",
        "003955.webp",
        "003999.webp",
        "004044.webp",
        "004045.webp",
        "004073.webp",
        "004102.webp",
        "004103.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Màu hồng rất là xinh.",
      "start": 165.44,
      "end": 166.84,
      "n_words": 5,
      "start_frame": 4136,
      "end_frame": 4171,
      "keyframes": [
        "004140.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn lưu ý là với món ăn này chúng ta sẽ phết nhân thật là mỏng để tạo hình hoa hồng thật là đẹp mắt thôi.",
      "start": 166.84,
      "end": 171.92,
      "n_words": 27,
      "start_frame": 4171,
      "end_frame": 4298,
      "keyframes": [
        "004177.webp",
        "004178.webp",
        "004236.webp",
        "004294.webp",
        "004295.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ Thanh Phương làm thử một cái nha.",
      "start": 171.92,
      "end": 174.2,
      "n_words": 9,
      "start_frame": 4298,
      "end_frame": 4355,
      "keyframes": [
        "004328.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Làm nha.",
      "start": 174.2,
      "end": 175.44,
      "n_words": 2,
      "start_frame": 4355,
      "end_frame": 4386,
      "keyframes": [
        "004362.webp",
        "004363.webp",
        "004383.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ cho mỏng đều ra xong rồi sau đó mình gấp đôi lại phải không anh?",
      "start": 175.44,
      "end": 179.6,
      "n_words": 18,
      "start_frame": 4386,
      "end_frame": 4490,
      "keyframes": [
        "004403.webp",
        "004404.webp",
        "004455.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Gấp đôi lại.",
      "start": 179.6,
      "end": 180.44,
      "n_words": 3,
      "start_frame": 4490,
      "end_frame": 4511,
      "keyframes": [
        "004507.webp",
        "004508.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng ta sẽ đè nhẹ nhẹ cái phần trung tâm như thế này rồi sau đó mình sẽ cuộn lại.",
      "start": 180.44,
      "end": 184.64,
      "n_words": 20,
      "start_frame": 4511,
      "end_frame": 4616,
      "keyframes": [
        "004537.webp",
        "004566.webp",
        "004567.webp",
        "004589.webp",
        "004612.webp",
        "004613.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Xinh quá trời!",
      "start": 184.64,
      "end": 186.52,
      "n_words": 3,
      "start_frame": 4616,
      "end_frame": 4663,
      "keyframes": [
        "004630.webp",
        "004647.webp",
        "004648.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng là con gái khéo tay ghê chưa.",
      "start": 186.52,
      "end": 188.52,
      "n_words": 8,
      "start_frame": 4663,
      "end_frame": 4713,
      "keyframes": [
        "004666.webp",
        "004685.webp",
        "004686.webp",
        "004712.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đây, đặt vào đây.",
      "start": 188.52,
      "end": 189.56,
      "n_words": 4,
      "start_frame": 4713,
      "end_frame": 4739,
      "keyframes": [
        "004739.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ mình sẽ chuẩn bị đem chiên và làm sốt rồi.",
      "start": 189.56,
