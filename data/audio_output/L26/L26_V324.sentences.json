        "000474.webp",
        "000492.webp",
        "000493.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dịp gì?",
      "start": 20.0,
      "end": 20.72,
      "n_words": 2,
      "start_frame": 500,
      "end_frame": 518,
      "keyframes": [
        "000505.webp",
        "000518.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nếu mình thích thì mình tặng thôi mà.",
      "start": 20.72,
      "end": 22.08,
      "n_words": 8,
      "start_frame": 518,
      "end_frame": 552,
      "keyframes": [
        "000518.webp",
        "000519.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hoa đặc biệt á, vừa đẹp vừa ngon nữa.",
      "start": 22.08,
      "end": 24.56,
      "n_words": 9,
      "start_frame": 552,
      "end_frame": 614,
      "keyframes": [
        "000565.webp",
        "000611.webp",
        "000612.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hiểu ý Thanh Phương ghê, vừa thích hoa nè mà vừa lại có tâm hồn ăn uống nữa, món quà này là quá phù hợp luôn đó. Đúng rồi đó.",
      "start": 24.56,
      "end": 30.8,
      "n_words": 30,
      "start_frame": 614,
      "end_frame": 770,
      "keyframes": [
        "000660.webp",
        "000708.webp",
        "000709.webp",
        "000732.webp",
        "000755.webp",
        "000756.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Anh nghĩ là bây giờ mình sẽ vào bếp mình làm cái hoa.",
      "start": 30.8,
      "end": 32.96,
      "n_words": 13,
      "start_frame": 770,
      "end_frame": 824,
      "keyframes": [
        "000786.webp",
        "000816.webp",
        "000817.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đồng ý liền hè.",
      "start": 32.96,
      "end": 36.32,
      "n_words": 4,
      "start_frame": 824,
      "end_frame": 908,
      "keyframes": [
        "000833.webp",
        "000849.webp",
        "000850.webp",
        "000874.webp",
        "000899.webp",
        "000900.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vui nhộn rộn ràng căn bếp với hoành thánh hoa hồng.",
      "start": 36.32,
      "end": 53.6,
      "n_words": 11,
      "start_frame": 908,
      "end_frame": 1340,
      "keyframes": [
        "000946.webp",
        "000993.webp",
        "000994.webp",
        "001051.webp",
        "001108.webp",
        "001123.webp",
        "001170.webp",
        "001218.webp",
        "001219.webp",
        "001305.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chào mừng quý vị đã quay trở lại với chương trình Món ngon mỗi ngày.",
      "start": 53.6,
      "end": 58.28,
      "n_words": 15,
      "start_frame": 1340,
      "end_frame": 1457,
      "keyframes": [
        "001392.webp",
        "001393.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 58.28,
      "end": 62.36,
      "n_words": 11,
      "start_frame": 1457,
      "end_frame": 1559,
      "keyframes": [
        "001474.webp",
        "001555.webp",
        "001556.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh Long này, Thanh Phương hóng quá, không biết là cái bông hoa mà anh Long làm thì nó sẽ đẹp và nó thơm ngon như thế nào?",
      "start": 62.36,
      "end": 68.64,
      "n_words": 28,
      "start_frame": 1559,
      "end_frame": 1716,
      "keyframes": [
        "001635.webp",
        "001715.webp",
        "001716.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cà rốt thì mình sẽ thái sợi và băm nhỏ.",
      "start": 68.64,
      "end": 71.48,
      "n_words": 10,
      "start_frame": 1716,
      "end_frame": 1787,
      "keyframes": [
        "001716.webp",
        "001750.webp",
        "001784.webp",
        "001785.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cái phần cà rốt băm nhuyễn này là mình sẽ để làm nhân đúng không ạ?",
      "start": 71.48,
      "end": 74.68,
      "n_words": 16,
      "start_frame": 1787,
      "end_frame": 1867,
      "keyframes": [
        "001820.webp",
        "001855.webp",
        "001856.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, mình sẽ làm nhân.",
      "start": 74.68,
      "end": 78.92,
      "n_words": 6,
      "start_frame": 1867,
      "end_frame": 1973,
      "keyframes": [
        "001895.webp",
        "001934.webp",
        "001935.webp",
        "001955.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Kế đến là chúng ta sẽ băm nhỏ phần nấm, như vậy là khi thưởng thức ở phần nhân, chúng ta sẽ cảm nhận được độ dai giòn, giòn sần sật của cà rốt và của nấm mèo.",
      "start": 78.92,
      "end": 88.28,
      "n_words": 38,
      "start_frame": 1973,
      "end_frame": 2207,
      "keyframes": [
        "001975.webp",
        "001976.webp",
        "002008.webp",
        "002041.webp",
