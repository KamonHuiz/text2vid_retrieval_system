      ],
      "keyframe_count": 37
    },
    {
      "text": "Có vẻ Thanh Phương thích hoa nhỉ?",
      "start": 12.96,
      "end": 14.68,
      "n_words": 7,
      "start_frame": 324,
      "end_frame": 367,
      "keyframes": [
        "000328.webp",
