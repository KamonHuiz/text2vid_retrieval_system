        "004914.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Rồi sau khi cái hỗn hợp này sôi và tan đường, các bạn sẽ tắt lửa và để thật là nguội.",
      "start": 196.72,
      "end": 202.4,
      "n_words": 21,
      "start_frame": 4918,
