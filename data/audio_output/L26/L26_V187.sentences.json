        "001558.webp",
        "001574.webp",
        "001575.webp",
        "001591.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đây, phần củ nén nhiệm vụ cao cả là cái mùi ớt xiêm và củ nén nó quyện vào nhau rất là thơm luôn.",
      "start": 64.2,
      "end": 72.36,
      "n_words": 24,
      "start_frame": 1605,
      "end_frame": 1809,
      "keyframes": [
        "001607.webp",
