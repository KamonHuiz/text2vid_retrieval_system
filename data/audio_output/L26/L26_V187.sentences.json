        "002690.webp",
        "002747.webp",
        "002748.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trong thời gian đó thì chúng ta sẽ đi bật cái nhiệt độ lò.",
      "start": 109.92,
      "end": 113.12,
      "n_words": 14,
