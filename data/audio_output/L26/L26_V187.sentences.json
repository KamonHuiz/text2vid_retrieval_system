        "003167.webp",
        "003198.webp",
        "003199.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cá các bạn để thấm 20 phút.",
      "start": 128.32,
      "end": 130.08,
      "n_words": 7,
      "start_frame": 3208,
      "end_frame": 3252,
      "keyframes": [
        "003238.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trong thời gian chờ đợi thì tôi sẽ hướng dẫn các bạn làm cái dầu hẹ để chúng ta tưới lên trên cá nướng.",
      "start": 130.08,
      "end": 135.32,
      "n_words": 24,
