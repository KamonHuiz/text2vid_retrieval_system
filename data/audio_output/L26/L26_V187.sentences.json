        "004323.webp",
        "004324.webp",
        "004382.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Nếu các bạn thích ăn cay thì các bạn có thể cho phi thơm tỏi ớt lên.",
      "start": 175.28,
      "end": 179.52,
