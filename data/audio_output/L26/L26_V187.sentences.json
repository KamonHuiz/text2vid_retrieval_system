      "end_frame": 878,
      "keyframes": [
        "000761.webp",
        "000762.webp",
        "000856.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 35.12,
      "end": 39.32,
      "n_words": 11,
      "start_frame": 878,
      "end_frame": 983,
      "keyframes": [
        "000951.webp",
        "000952.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Các bạn khán giả thân mến, nếu như một ngày nào đó mà chúng ta cảm thấy là cần một món ăn ngon bổ dưỡng cho sức khỏe thể chất cho đến sức khỏe của tinh thần thì hãy làm ngay món ăn của ngày hôm nay nhé, đó là cá lóc nướng ớt xiêm xanh, bảo đảm sẽ không làm cho chúng ta thất vọng đâu ạ.",
      "start": 39.32,
      "end": 56.08,
      "n_words": 68,
      "start_frame": 983,
      "end_frame": 1402,
      "keyframes": [
        "001080.webp",
        "001175.webp",
        "001399.webp",
        "001400.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đầu tiên, để thực hiện món này, chúng ta cần cái sốt ớt xiêm xanh.",
      "start": 56.08,
      "end": 59.12,
      "n_words": 15,
      "start_frame": 1402,
      "end_frame": 1478,
      "keyframes": [
        "001450.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ớt xiêm xanh thì chúng ta phải giã ớt xiêm xanh cùng với lại củ nén.",
      "start": 59.12,
      "end": 64.2,
      "n_words": 16,
      "start_frame": 1478,
      "end_frame": 1605,
      "keyframes": [
        "001501.webp",
