        "006074.webp",
        "006132.webp",
        "006133.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Nhẹ nhàng đặt con cá lóc nướng ra một cái đĩa mà tôi đã chuẩn bị sẵn nè.",
      "start": 245.44,
