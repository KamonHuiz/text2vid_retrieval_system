        "003577.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Hẹ lá nè, cắt nhỏ, sẽ nêm vào đây một ít muối, một ít bột ngọt Ajinomoto, rồi các bạn trộn đều cho muối và bột ngọt thấm vào trong hẹ lá.",
      "start": 143.16,
      "end": 152.24,
      "n_words": 32,
      "start_frame": 3579,
      "end_frame": 3806,
      "keyframes": [
        "003612.webp",
