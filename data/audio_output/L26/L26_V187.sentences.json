        "002928.webp",
        "002995.webp",
        "002996.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi cái phần sả hạt ớt xiêm cũng như củ nén, các bạn nhồi hết vào trong cái ruột cá nha, đừng có để ra ngoài nó sẽ rất là phí vì nó rất là thơm.",
      "start": 120.08,
      "end": 128.32,
      "n_words": 36,
      "start_frame": 3002,
      "end_frame": 3208,
      "keyframes": [
        "003066.webp",
