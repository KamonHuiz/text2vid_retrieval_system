        "002104.webp",
        "002105.webp",
        "002127.webp",
        "002149.webp",
        "002150.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta chiên dầu vừa đủ sém sém cái mặt mì thôi, chúng ta không cần phải chiên ngập dầu giống như là mì chiên giòn.",
      "start": 86.0,
      "end": 92.0,
      "n_words": 26,
      "start_frame": 2150,
      "end_frame": 2300,
      "keyframes": [
        "002150.webp",
        "002180.webp",
        "002210.webp",
        "002211.webp",
        "002255.webp",
        "002299.webp",
        "002300.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rồi bây giờ dầu cũng đã nóng thì xin sẽ tiến hành chiên cái mì yfu này ra nguyên cái chảo.",
      "start": 92.0,
      "end": 96.08,
      "n_words": 21,
      "start_frame": 2300,
      "end_frame": 2402,
      "keyframes": [
        "002300.webp",
        "002363.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và chúng ta chiên như vậy, khi chúng ta chiên như vậy thì chúng ta xào lên không bị đứt và xào mì luôn lúc nào cũng dài.",
      "start": 96.08,
      "end": 101.16,
      "n_words": 28,
      "start_frame": 2402,
      "end_frame": 2529,
      "keyframes": [
        "002427.webp",
        "002428.webp",
        "002472.webp",
        "002516.webp",
        "002517.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đây chính là ý nghĩa của món ăn ngày hôm nay mà đúng không?",
      "start": 101.16,
      "end": 103.4,
      "n_words": 14,
