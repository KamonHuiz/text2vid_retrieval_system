        "004146.webp",
        "004197.webp",
        "004248.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và cái quyết định cho món này vẫn là nấm trà.",
      "start": 169.92,
      "end": 172.48,
      "n_words": 11,
      "start_frame": 4248,
