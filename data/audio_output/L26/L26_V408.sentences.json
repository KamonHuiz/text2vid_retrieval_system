        "004098.webp",
        "004099.webp",
        "004122.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Minh Phương đã ngửi được cái mùi thơm rất là nhẹ mùi của cái món xào chay mình chưa?",
      "start": 165.76,
