      "n_words": 22,
      "start_frame": 2820,
      "end_frame": 2950,
      "keyframes": [
        "002858.webp",
        "002902.webp",
        "002903.webp",
        "002936.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và bây giờ thì chúng ta sẽ làm cái hỗn hợp nước sốt: một muỗng canh dầu ăn, có một muỗng cà phê tiêu, có một muỗng cà phê đường, có nửa muỗng canh nước tương Phú Sĩ nữa nha, cần thêm nửa muỗng canh dầu hào chay, khuấy lên để cho tất cả các hỗn hợp được quyện vào với nhau.",
      "start": 118.0,
      "end": 132.12,
      "n_words": 62,
      "start_frame": 2950,
      "end_frame": 3303,
      "keyframes": [
        "002970.webp",
