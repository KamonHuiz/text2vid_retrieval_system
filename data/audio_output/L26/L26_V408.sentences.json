        "000795.webp",
        "000829.webp",
        "000830.webp",
        "000856.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Hôm nay chúng ta sẽ biến tấu một món mì mới gọi là mì ufu.",
      "start": 35.24,
      "end": 38.48,
      "n_words": 15,
      "start_frame": 881,
      "end_frame": 962,
      "keyframes": [
        "000882.webp",
        "000883.webp",
        "000925.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì chúng ta sẽ xào chay với một loại nấm rất là nhiều dinh dưỡng đó là nấm trà.",
      "start": 38.8,
      "end": 42.12,
      "n_words": 19,
      "start_frame": 970,
      "end_frame": 1053,
      "keyframes": [
        "000979.webp",
