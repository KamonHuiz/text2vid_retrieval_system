        "003692.webp",
        "003693.webp",
        "003719.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Và bây giờ thì chúng ta bắt đầu xào mì.",
      "start": 149.76,
      "end": 151.6,
      "n_words": 10,
      "start_frame": 3744,
