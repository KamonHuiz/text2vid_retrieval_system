        "003767.webp",
        "003787.webp",
        "003788.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nửa muỗng canh dầu ăn, sử dụng một phần hai phần hành boaro này để xào thơm lên nha.",
      "start": 151.6,
