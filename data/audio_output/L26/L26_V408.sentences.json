        "002002.webp",
        "002024.webp",
        "002025.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Và đây là thành phẩm, trong khi Minh Phương trần cải thìa xin sẽ chiên luôn cái mì yfu nha.",
      "start": 81.2,
      "end": 86.0,
      "n_words": 20,
      "start_frame": 2030,
      "end_frame": 2150,
      "keyframes": [
        "002045.webp",
        "002065.webp",
        "002066.webp",
