      "end_frame": 2585,
      "keyframes": [
        "002538.webp",
        "002559.webp",
        "002560.webp",
        "002581.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng rồi, săn lại như vậy được, chúng ta sẽ vớt ra để ráo dầu.",
      "start": 103.4,
      "end": 107.84,
      "n_words": 15,
      "start_frame": 2585,
      "end_frame": 2696,
      "keyframes": [
        "002603.webp",
        "002604.webp",
        "002620.webp",
        "002636.webp",
        "002637.webp",
        "002668.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chờ cái mì yfu này nguội thì xin sẽ nhờ Phương cắt cái ớt Đà Lạt thành hình que.",
      "start": 107.84,
      "end": 112.8,
      "n_words": 19,
      "start_frame": 2696,
