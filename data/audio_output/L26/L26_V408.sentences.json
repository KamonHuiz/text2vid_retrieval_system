        "001117.webp",
        "001142.webp",
        "001143.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Mì yfu xào nấm trà, cả nhà đều thích mến.",
      "start": 45.8,
      "end": 65.36,
      "n_words": 10,
      "start_frame": 1145,
      "end_frame": 1634,
      "keyframes": [
        "001187.webp",
