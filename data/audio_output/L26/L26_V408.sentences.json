      "end_frame": 418,
      "keyframes": [
        "000400.webp",
        "000401.webp",
        "000416.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Để Phương thôi nha, tự nhiên nhiệt tình ngang vậy, nhờ tôi cái gì nào?",
