        "001544.webp",
        "001631.webp",
        "001632.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chào các bạn khán giả đến với chương trình Món ngon mỗi ngày, chương trình được tài trợ bởi công ty Ajinomoto Việt Nam nè.",
      "start": 65.36,
      "end": 73.28,
      "n_words": 25,
      "start_frame": 1634,
      "end_frame": 1832,
      "keyframes": [
        "001722.webp",
        "001813.webp",
        "001814.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ luộc đi, nước sôi rồi.",
      "start": 73.28,
      "end": 76.12,
      "n_words": 7,
      "start_frame": 1832,
      "end_frame": 1903,
      "keyframes": [
        "001845.webp",
        "001876.webp",
        "001877.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phương sẽ trần phần cải thìa.",
      "start": 76.12,
      "end": 77.68,
      "n_words": 6,
      "start_frame": 1903,
      "end_frame": 1942,
      "keyframes": [
        "001912.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Thì đối với mì này thì chúng ta mua về chúng ta nên trần sơ qua.",
      "start": 77.92,
      "end": 81.2,
      "n_words": 16,
