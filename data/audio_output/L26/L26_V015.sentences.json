        "004517.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phần hành boa rô cũng đã dậy lên mùi thơm rồi, Hưng sẽ cho phần cơm vào.",
      "start": 181.56,
      "end": 185.96,
