      "keyframes": [
        "002837.webp",
        "002869.webp",
        "002870.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sau đó thì chúng ta sẽ trộn đều phần nhân này lên.",
      "start": 114.88,
      "end": 117.28,
      "n_words": 12,
      "start_frame": 2872,
      "end_frame": 2932,
      "keyframes": [
        "002900.webp",
        "002930.webp",
        "002931.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ thấy chừng khoảng một muỗng canh bột năng cùng với lại hai phần ba chén nước, sau đó mình sẽ bắc lên trên bếp mình khuấy thì chúng ta sẽ có cái chén hồ dán như thế này.",
      "start": 117.28,
      "end": 126.28,
      "n_words": 41,
