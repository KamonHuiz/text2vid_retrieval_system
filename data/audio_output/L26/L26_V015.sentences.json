        "003363.webp",
        "003400.webp",
        "003401.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta sẽ phết một lớp hồ.",
      "start": 136.24,
      "end": 140.0,
      "n_words": 7,
      "start_frame": 3406,
      "end_frame": 3500,
