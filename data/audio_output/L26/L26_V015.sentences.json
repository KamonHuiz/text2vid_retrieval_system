        "004334.webp",
        "004427.webp",
        "004428.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Hưng sẽ cho vào đây khoảng hai muỗng canh dầu ăn, cho vào đây một ít hành boa rô.",
      "start": 177.12,
