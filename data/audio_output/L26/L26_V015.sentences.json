        "003106.webp",
        "003155.webp",
        "003156.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ đặt cái mặt láng của lá rong biển nằm ở bên dưới như thế này.",
      "start": 126.28,
      "end": 129.92,
