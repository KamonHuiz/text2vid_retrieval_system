      "end_frame": 421,
      "keyframes": [
        "000418.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam và nhân dịp lễ Vu Lan thì chương trình dành tặng đến các bạn khán giả một món quà thật là đặc biệt.",
      "start": 16.84,
      "end": 26.4,
      "n_words": 34,
      "start_frame": 421,
      "end_frame": 660,
      "keyframes": [
