        "000734.webp",
        "000807.webp",
        "000808.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hộp này đúng không?",
      "start": 32.56,
      "end": 34.0,
      "n_words": 4,
      "start_frame": 814,
      "end_frame": 850,
      "keyframes": [
        "000828.webp",
        "000849.webp",
        "000850.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô chọn hộp này.",
      "start": 34.0,
      "end": 37.64,
      "n_words": 4,
      "start_frame": 850,
      "end_frame": 941,
      "keyframes": [
        "000850.webp",
        "000910.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cảm ơn Phước Hưng.",
      "start": 37.64,
      "end": 38.84,
      "n_words": 4,
      "start_frame": 941,
      "end_frame": 971,
      "keyframes": [
        "000970.webp",
        "000971.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ chúng ta hãy cùng nhau mở ra.",
      "start": 38.84,
      "end": 40.8,
      "n_words": 9,
      "start_frame": 971,
      "end_frame": 1020,
      "keyframes": [
        "000971.webp",
        "000996.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nguyên liệu của Hưng là gạo tím và đối với gạo tím thì ngày hôm nay Phước Hưng sẽ hướng dẫn cho các bạn một cái món chay rất là thanh đạm luôn, đó là món cơm gạo tím chay.",
      "start": 40.8,
      "end": 50.12,
      "n_words": 40,
      "start_frame": 1020,
      "end_frame": 1253,
      "keyframes": [
        "001022.webp",
        "001023.webp",
        "001116.webp",
        "001210.webp",
        "001211.webp",
        "001251.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "À, còn của cô thì là có rong biển và mè.",
      "start": 50.12,
      "end": 53.0,
      "n_words": 11,
      "start_frame": 1253,
      "end_frame": 1325,
      "keyframes": [
        "001291.webp",
        "001292.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đây là hai nguyên liệu mà rất là tốt hỗ trợ cho tim và mạch máu.",
      "start": 53.0,
      "end": 57.12,
      "n_words": 16,
      "start_frame": 1325,
      "end_frame": 1428,
      "keyframes": [
        "001326.webp",
        "001360.webp",
        "001361.webp",
        "001393.webp",
        "001425.webp",
        "001426.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cô sẽ làm món chả giò rong biển chay.",
      "start": 57.12,
      "end": 59.08,
      "n_words": 9,
      "start_frame": 1428,
      "end_frame": 1477,
      "keyframes": [
        "001453.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chay cô sẽ là chuẩn bị trước cái phần nhân chả giò: đậu hũ trắng mình luộc qua xong sau đó mình vắt cho thật là ráo rồi mình tán ra, cà rốt băm và củ năng băm chúng ta sẽ cho vào đây luôn, nấm mèo băm nhỏ và nấm hương băm nhỏ khoảng chừng hai muỗng canh, bún tàu một muỗng canh, ngò rí băm nửa muỗng canh, tiêu xanh, tàu hủ ki mà chúng ta đã chiên giòn lên và bóp nhỏ cho vào đây, hành boa rô đã phi vàng thơm nửa muỗng cà phê hạt nêm Ajinomoto nấm, nửa muỗng cà phê đường, nửa muỗng cà phê bột ngọt Ajinomoto và nửa muỗng cà phê nước tương Phú Sĩ.",
      "start": 59.08,
      "end": 112.04,
      "n_words": 124,
