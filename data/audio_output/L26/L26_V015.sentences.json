        "004649.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta sẽ xào săn cơm trước khi trộn nhân giúp cho món cơm ngon hơn.",
      "start": 185.96,
      "end": 189.96,
      "n_words": 16,
