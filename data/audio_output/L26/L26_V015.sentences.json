        "003910.webp",
        "003911.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Bây giờ phần đậu hũ cũng đã vàng rồi, tắt bếp nè.",
      "start": 156.56,
      "end": 159.12,
      "n_words": 12,
