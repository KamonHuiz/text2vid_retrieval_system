        "003210.webp",
        "003229.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Các bạn lưu ý là chúng ta nên nắm và vắt nhân lại trước khi cuốn giúp nhân có độ kết dính tốt hơn nhé.",
      "start": 129.92,
      "end": 136.24,
      "n_words": 25,
      "start_frame": 3248,
      "end_frame": 3406,
      "keyframes": [
        "003249.webp",
