      ],
      "keyframe_count": 60
    },
    {
      "text": "Cho vào đây thêm một muỗng canh bột năng nhé các bạn.",
      "start": 112.48,
      "end": 114.88,
      "n_words": 12,
      "start_frame": 2812,
