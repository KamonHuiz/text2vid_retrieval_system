        "003458.webp",
        "003459.webp",
        "003483.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và món cơm tím chay thì đầu tiên Phước Hưng sẽ hướng dẫn cho các bạn, chúng ta cắt cái phần đậu hũ trắng trước.",
      "start": 140.0,
      "end": 145.2,
      "n_words": 25,
      "start_frame": 3500,
      "end_frame": 3630,
      "keyframes": [
        "003507.webp",
        "003508.webp",
        "003568.webp",
        "003629.webp",
        "003630.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phần đậu hũ trắng này thì chúng ta sẽ cắt hạt lựu nhỏ.",
      "start": 145.2,
      "end": 148.32,
      "n_words": 13,
      "start_frame": 3630,
      "end_frame": 3708,
      "keyframes": [
        "003630.webp",
        "003680.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đậu hũ là một cái nguyên liệu rất là quen thuộc trong món chay vì trong đậu hũ chứa rất là nhiều chất dinh dưỡng, giảm cholesterol trong máu và rất tốt cho tim mạch.",
      "start": 148.32,
      "end": 156.56,
      "n_words": 35,
      "start_frame": 3708,
      "end_frame": 3914,
      "keyframes": [
