        "004340.webp",
        "004367.webp",
        "004368.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rồi bầu của em, bầu của em nè cũng đã đẹp rồi nè.",
      "start": 174.8,
      "end": 178.16,
      "n_words": 13,
