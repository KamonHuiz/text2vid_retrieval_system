        "003610.webp",
        "003611.webp",
        "003652.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Như vậy chúng ta sẽ đặt chảo lên trên bếp để mình chiên cơm ha.",
      "start": 146.32,
      "end": 150.4,
      "n_words": 15,
      "start_frame": 3658,
      "end_frame": 3760,
      "keyframes": [
        "003693.webp",
        "003694.webp",
        "003728.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cà rốt của em cũng đã chín rồi nè, em sẽ lấy cà rốt ra.",
      "start": 150.4,
      "end": 153.68,
      "n_words": 15,
