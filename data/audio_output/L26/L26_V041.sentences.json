      "start_frame": 6290,
      "end_frame": 6507,
      "keyframes": [
        "006380.webp",
        "006472.webp",
        "006473.webp",
        "006489.webp",
        "006506.webp",
        "006507.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trong món ăn này chúng ta sử dụng sốt dùng ngay kho quẹt giúp món ăn chuẩn vị ngon hơn và tiết kiệm thời gian nữa.",
      "start": 260.28,
