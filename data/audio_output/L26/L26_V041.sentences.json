        "001652.webp",
        "001684.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ thì cô sẽ băm nhỏ và sau đó mình cắt hạt lựu.",
      "start": 67.36,
      "end": 72.48,
      "n_words": 14,
