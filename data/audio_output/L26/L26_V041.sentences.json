      "keyframes": [
        "000858.webp",
        "000859.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam. Chào Minh Tuấn. Em chào cô.",
      "start": 38.72,
      "end": 44.96,
