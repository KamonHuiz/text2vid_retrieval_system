      "end_frame": 2649,
      "keyframes": [
        "002592.webp",
        "002593.webp",
        "002621.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bông cải trắng thì em nghĩ là mình sẽ cắt cho nó vừa ăn?",
