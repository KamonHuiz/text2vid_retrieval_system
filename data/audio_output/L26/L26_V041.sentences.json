      "n_words": 41,
      "start_frame": 5060,
      "end_frame": 5308,
      "keyframes": [
        "005150.webp",
        "005300.webp",
        "005301.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thấy vừa rồi nè, anh sẽ vớt ra rồi mình sẽ cho vào giấy thấm dầu.",
      "start": 212.32,
      "end": 217.0,
      "n_words": 16,
      "start_frame": 5308,
      "end_frame": 5425,
      "keyframes": [
        "005335.webp",
        "005369.webp",
        "005370.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cứ như vậy thì chúng ta sẽ lần lượt chiên hết phần cơm tôm nha.",
      "start": 217.0,
      "end": 219.88,
      "n_words": 15,
      "start_frame": 5425,
      "end_frame": 5497,
      "keyframes": [
        "005439.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn, còn tất cả các bạn đang theo dõi chương trình thì ngay bây giờ trên màn hình của chúng ta đang xuất hiện một mã QR, mọi người hãy lấy điện thoại ra quét mã này, chúng ta sẽ ngay lập tức có công thức nấu ăn của ngày hôm nay để thực hành tại nhà ha.",
      "start": 219.88,
      "end": 233.08,
      "n_words": 59,
      "start_frame": 5497,
      "end_frame": 5827,
      "keyframes": [
        "005508.webp",
