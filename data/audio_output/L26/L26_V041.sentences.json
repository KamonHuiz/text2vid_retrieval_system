        "004535.webp",
        "004558.webp",
        "004559.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rồi như vậy là toàn bộ cái phần rau củ luộc của mình thì đã xong.",
      "start": 183.6,
      "end": 186.84,
      "n_words": 16,
      "start_frame": 4590,
      "end_frame": 4671,
      "keyframes": [
        "004615.webp",
        "004671.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ em gấp vào là em cảm nhận được cái độ cứng cứng, giòn giòn của nó rồi đó.",
      "start": 186.84,
