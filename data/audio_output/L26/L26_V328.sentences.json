        "002981.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Xong luôn phần cà chua màu cam, còn đây là bơ chỉ cần cắt lát dày khoảng chừng hai ly thôi.",
      "start": 119.68,
      "end": 124.84,
      "n_words": 21,
