        "002090.webp",
        "002107.webp",
        "002108.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Mình chỉ sử dụng mực ống thôi, sau đó thì mình cắt khoanh.",
      "start": 84.36,
      "end": 87.84,
      "n_words": 13,
