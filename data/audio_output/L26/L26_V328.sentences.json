        "002256.webp",
        "002257.webp",
        "002285.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cô sẽ đậy nắp lại, không cần phải cho nước đâu, em mở lửa lên giúp cô.",
      "start": 92.48,
      "end": 96.08,
      "n_words": 17,
