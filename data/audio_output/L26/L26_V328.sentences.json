      "start_frame": 1708,
      "end_frame": 1868,
      "keyframes": [
        "001793.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi bây giờ em giúp mang giùm cô cái nồi ở bên kia qua đây đi, thì cô sẽ hấp mực.",
      "start": 74.72,
