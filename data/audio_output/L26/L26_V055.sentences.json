      "end": 220.08,
      "n_words": 9,
      "start_frame": 5312,
      "end_frame": 5502,
      "keyframes": [
        "005351.webp",
        "005400.webp",
        "005401.webp",
        "005437.webp",
        "005473.webp",
        "005474.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Được rồi nè, cô vớt ra nè, thấy chưa nè, bắt đầu giòn đúng rồi.",
