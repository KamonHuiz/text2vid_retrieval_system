        "004571.webp",
        "004572.webp",
        "004606.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "- Dạ, đó rất là nhanh chóng, nó cái màu vàng nè.",
      "start": 185.32,
      "end": 188.12,
      "n_words": 12,
      "start_frame": 4633,
      "end_frame": 4703,
      "keyframes": [
        "004641.webp",
        "004642.webp",
        "004669.webp",
        "004697.webp",
        "004698.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Với Ajinomoto bột tẩm khô chiên giòn là nó vừa vị luôn.",
      "start": 188.12,
      "end": 191.28,
      "n_words": 12,
      "start_frame": 4703,
      "end_frame": 4782,
      "keyframes": [
        "004740.webp",
        "004782.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Đúng rồi, mà nó lại vừa ra màu đẹp nữa.",
      "start": 191.28,
      "end": 192.96,
      "n_words": 11,
      "start_frame": 4782,
      "end_frame": 4824,
      "keyframes": [
        "004782.webp",
        "004783.webp",
        "004824.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- Đúng rồi, bởi vì nó có gia vị sẵn ở trong đó rồi, chiên nó lên màu rất là đẹp.",
      "start": 192.96,
      "end": 196.92,
      "n_words": 21,
      "start_frame": 4824,
      "end_frame": 4923,
      "keyframes": [
        "004824.webp",
        "004865.webp",
        "004866.webp",
        "004894.webp",
        "004922.webp",
        "004923.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Với món ăn này thì lần đầu tiên chúng ta chiên là chúng ta chiên chín tới màu vàng sáng mà non thôi thì mình vớt ra.",
      "start": 196.92,
      "end": 203.6,
      "n_words": 27,
      "start_frame": 4923,
      "end_frame": 5090,
      "keyframes": [
        "004923.webp",
        "004936.webp",
        "004950.webp",
        "004951.webp",
        "004978.webp",
        "005006.webp",
        "005007.webp",
        "005047.webp",
        "005088.webp",
        "005089.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chúng ta nên chiên hai lần để giữ độ giòn cho món ăn.",
      "start": 203.6,
      "end": 206.8,
      "n_words": 13,
      "start_frame": 5090,
      "end_frame": 5170,
      "keyframes": [
        "005128.webp",
        "005168.webp",
        "005169.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Lần hai này thì mình sẽ chiên lửa lớn cô ha, và chiên rất nhanh thôi dạ.",
      "start": 206.8,
      "end": 212.48,
      "n_words": 17,
      "start_frame": 5170,
      "end_frame": 5312,
      "keyframes": [
        "005235.webp",
        "005302.webp",
        "005303.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó, âm thanh của sự hấp dẫn đó này.",
