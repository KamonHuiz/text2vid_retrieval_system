      "start_frame": 925,
      "end_frame": 1086,
      "keyframes": [
        "000977.webp",
        "000978.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 43.44,
      "end": 47.84,
      "n_words": 11,
      "start_frame": 1086,
      "end_frame": 1196,
      "keyframes": [
        "001089.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hôm nay có vẻ bữa tiệc gia đình hơi đơn giản, rất là dễ làm dạ, chỉ có cánh gà với lại lá chanh.",
      "start": 47.84,
      "end": 55.68,
      "n_words": 24,
      "start_frame": 1196,
      "end_frame": 1392,
      "keyframes": [
        "001200.webp",
        "001201.webp",
        "001235.webp",
        "001269.webp",
        "001270.webp",
        "001297.webp",
        "001325.webp",
        "001326.webp",
        "001357.webp",
        "001388.webp",
        "001389.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "- Món gì cô?",
      "start": 55.68,
      "end": 56.68,
      "n_words": 4,
      "start_frame": 1392,
      "end_frame": 1417,
      "keyframes": [
        "001407.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Thì cánh gà chiên lá chanh, rất là đơn giản để ra một cái món ăn thật là hấp dẫn.",
      "start": 56.68,
      "end": 63.72,
      "n_words": 21,
      "start_frame": 1417,
      "end_frame": 1593,
      "keyframes": [
        "001425.webp",
        "001426.webp",
        "001509.webp",
        "001592.webp",
        "001593.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- Thứ nhất là em đang có nhu cầu ăn rất nhiều gà tại vì đó là một cái lượng đạm.",
      "start": 63.72,
      "end": 67.52,
      "n_words": 21,
      "start_frame": 1593,
      "end_frame": 1688,
      "keyframes": [
        "001593.webp",
        "001623.webp",
        "001653.webp",
        "001654.webp",
        "001670.webp",
        "001687.webp",
        "001688.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đạm này thì không có quá nhiều dầu mỡ nên rất hợp để mà mình tập, để mình xây dựng cơ đúng đó.",
      "start": 67.52,
      "end": 71.92,
      "n_words": 23,
      "start_frame": 1688,
      "end_frame": 1798,
      "keyframes": [
        "001688.webp",
        "001744.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Cô đã chuẩn bị cho em cái gia vị mà em rất thích đó là lá chanh.",
      "start": 71.92,
      "end": 76.16,
      "n_words": 18,
      "start_frame": 1798,
      "end_frame": 1904,
      "keyframes": [
        "001800.webp",
        "001801.webp",
        "001851.webp",
        "001902.webp",
        "001903.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Em lấy bốn lá em băm nhỏ cho cô.",
      "start": 76.16,
      "end": 80.16,
      "n_words": 9,
      "start_frame": 1904,
      "end_frame": 2004,
      "keyframes": [
        "001954.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cánh gà sau khi mua về chúng ta sẽ rửa sạch.",
      "start": 80.16,
      "end": 83.0,
      "n_words": 11,
      "start_frame": 2004,
      "end_frame": 2075,
      "keyframes": [
        "002005.webp",
        "002006.webp",
        "002033.webp",
        "002060.webp",
        "002061.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đối với lại cái phần mà cái tỏi của cái cánh, các bạn lưu ý là chúng ta sẽ dùng dao hoặc kéo, chúng ta sẽ khứa hoặc là nhắc nó ra cho nó mỏng một chút.",
      "start": 83.0,
      "end": 91.24,
      "n_words": 37,
      "start_frame": 2075,
      "end_frame": 2281,
      "keyframes": [
        "002100.webp",
        "002140.webp",
        "002141.webp",
        "002179.webp",
        "002217.webp",
        "002218.webp",
        "002249.webp",
        "002280.webp",
        "002281.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta sẽ khứa mỏng để cho nó mỏng bớt như thế này chút mình chiên sẽ không mất nhiều thời gian, với lại gia vị nó sẽ thấm vào trong cái miếng thịt này nhiều hơn.",
      "start": 91.24,
      "end": 99.2,
      "n_words": 37,
      "start_frame": 2281,
      "end_frame": 2480,
      "keyframes": [
        "002281.webp",
        "002333.webp",
        "002385.webp",
        "002386.webp",
        "002432.webp",
        "002478.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Lá chanh cắt sợi đó, để còn bây giờ thì em sẽ băm.",
      "start": 99.2,
      "end": 109.4,
      "n_words": 13,
      "start_frame": 2480,
      "end_frame": 2735,
      "keyframes": [
        "002499.webp",
        "002532.webp",
        "002565.webp",
        "002566.webp",
        "002619.webp",
        "002673.webp",
        "002674.webp",
        "002724.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ chúng ta sẽ cho vào trong cái tô để mình ướp gia vị.",
      "start": 109.4,
      "end": 115.04,
      "n_words": 15,
      "start_frame": 2735,
      "end_frame": 2876,
      "keyframes": [
        "002774.webp",
        "002775.webp",
        "002820.webp",
        "002865.webp",
        "002866.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ ướp vào trong cánh gà này một muỗng cà phê lá chanh băm, nửa muỗng canh ớt sừng băm.",
      "start": 115.04,
      "end": 121.08,
      "n_words": 22,
      "start_frame": 2876,
      "end_frame": 3027,
      "keyframes": [
        "002918.webp",
        "002971.webp",
        "002972.webp",
        "002999.webp",
        "003027.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta nên tẩm thêm ớt băm và lá chanh băm để cánh gà thơm mùi đặc trưng nhé.",
      "start": 121.08,
      "end": 125.96,
      "n_words": 19,
      "start_frame": 3027,
      "end_frame": 3149,
      "keyframes": [
        "003027.webp",
        "003028.webp",
        "003056.webp",
        "003085.webp",
        "003086.webp",
        "003117.webp",
        "003148.webp",
        "003149.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ thì Tuấn giúp cô tiếp là mình sẽ bắc lên trên bếp một cái chảo dầu, tiếp tục cho vào đây gia vị sẵn Ajinomoto bột tẩm khô chiên giòn.",
      "start": 125.96,
      "end": 135.36,
      "n_words": 32,
      "start_frame": 3149,
      "end_frame": 3384,
      "keyframes": [
        "003149.webp",
        "003185.webp",
        "003222.webp",
        "003223.webp",
        "003249.webp",
        "003276.webp",
        "003277.webp",
        "003296.webp",
        "003316.webp",
        "003317.webp",
        "003348.webp",
        "003379.webp",
        "003380.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Mình sẽ cho một gói bột vô trên đây, rất là tiện dụng khi mình sử dụng bột này vì mình không có đắn đo là phải thêm mỗi loại gia vị bao nhiêu đúng không?",
      "start": 135.36,
      "end": 143.8,
      "n_words": 36,
      "start_frame": 3384,
      "end_frame": 3595,
      "keyframes": [
        "003443.webp",
        "003506.webp",
        "003507.webp",
        "003542.webp",
        "003578.webp",
        "003579.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Có gia vị sẵn rồi, rất là dễ ăn.",
      "start": 143.8,
      "end": 145.8,
      "n_words": 9,
      "start_frame": 3595,
      "end_frame": 3645,
      "keyframes": [
        "003612.webp",
        "003645.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trước khi mình chiên gà thì chúng ta sẽ chiên lá chanh trước nha các bạn.",
      "start": 145.8,
      "end": 148.76,
      "n_words": 16,
      "start_frame": 3645,
      "end_frame": 3719,
      "keyframes": [
        "003645.webp",
        "003646.webp",
        "003682.webp",
        "003718.webp",
        "003719.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ lau khô lá chanh nha vì nó sẽ dễ bị bắn dầu.",
      "start": 148.76,
      "end": 152.88,
      "n_words": 20,
      "start_frame": 3719,
      "end_frame": 3822,
      "keyframes": [
        "003719.webp",
        "003770.webp",
        "003822.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ chiên lá chanh trước khi chiên cánh gà để dầu thơm thì khi đó món ăn sẽ ngon hơn.",
      "start": 152.88,
      "end": 159.76,
      "n_words": 27,
      "start_frame": 3822,
      "end_frame": 3994,
      "keyframes": [
        "003822.webp",
        "003823.webp",
        "003902.webp",
        "003982.webp",
        "003983.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bỏ vô thôi là thơm lừng luôn, chiên vậy thôi sau đó thì mình sẽ vớt ra.",
      "start": 159.76,
      "end": 166.08,
      "n_words": 17,
      "start_frame": 3994,
      "end_frame": 4152,
      "keyframes": [
        "004014.webp",
        "004046.webp",
        "004047.webp",
        "004083.webp",
        "004119.webp",
        "004120.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tiếp tục chúng ta sẽ cho cánh gà vào chiên nha.",
      "start": 166.08,
      "end": 168.52,
      "n_words": 11,
      "start_frame": 4152,
      "end_frame": 4213,
      "keyframes": [
        "004166.webp",
        "004212.webp",
        "004213.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cái cánh tỏi gà mình sẽ cho vô chiên trước, đó là cái phần lâu chín nhất.",
      "start": 168.52,
      "end": 172.0,
      "n_words": 17,
      "start_frame": 4213,
      "end_frame": 4300,
      "keyframes": [
        "004213.webp",
        "004283.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "- Đúng rồi, nó hơi lâu chín hơn.",
      "start": 172.0,
      "end": 176.72,
      "n_words": 8,
      "start_frame": 4300,
      "end_frame": 4418,
      "keyframes": [
        "004354.webp",
        "004355.webp",
        "004379.webp",
        "004403.webp",
        "004404.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- Cô sẽ cho cái phần cánh vô.",
      "start": 176.72,
      "end": 178.76,
      "n_words": 8,
      "start_frame": 4418,
      "end_frame": 4469,
      "keyframes": [
        "004436.webp",
        "004469.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cái món ăn này thì thời gian chiên rất nhanh cho nên là chúng ta sẽ sử dụng cánh gà công nghiệp nó sẽ phù hợp hơn.",
