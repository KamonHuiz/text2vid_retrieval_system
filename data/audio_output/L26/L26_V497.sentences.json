        "002411.webp",
        "002421.webp",
        "002422.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta cần thêm một muỗng cà phê hạt nêm Aji-ngon nấm hương và hạt sen nữa nha.",
      "start": 96.88,
      "end": 100.4,
