      "end": 16.84,
      "n_words": 11,
      "start_frame": 323,
      "end_frame": 421,
      "keyframes": [
        "000381.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nấm ngon như vậy mà không ăn, hết hồn à?",
