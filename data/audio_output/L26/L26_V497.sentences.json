      "end": 22.68,
      "n_words": 9,
      "start_frame": 501,
      "end_frame": 567,
      "keyframes": [
        "000507.webp",
        "000521.webp",
        "000522.webp",
        "000537.webp",
        "000552.webp",
        "000553.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Minh Vương có một cái dĩa nấm linh chi trắng nè, rất là hấp dẫn.",
      "start": 22.68,
      "end": 26.4,
      "n_words": 15,
