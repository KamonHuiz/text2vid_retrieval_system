        "000927.webp",
        "000954.webp",
        "000955.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và rất là trùng hợp, xin cũng có nấm nè, biết nấm gì không?",
      "start": 38.24,
      "end": 41.56,
      "n_words": 14,
      "start_frame": 956,
      "end_frame": 1039,
      "keyframes": [
        "000980.webp",
