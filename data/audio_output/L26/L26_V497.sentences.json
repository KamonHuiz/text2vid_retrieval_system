      "keyframes": [
        "001252.webp",
        "001253.webp",
        "001267.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nghe thú vị đó, đậu hũ hấp nấm nhật mềm ngon bất tận.",
      "start": 51.52,
      "end": 73.96,
      "n_words": 13,
      "start_frame": 1288,
      "end_frame": 1849,
      "keyframes": [
        "001295.webp",
