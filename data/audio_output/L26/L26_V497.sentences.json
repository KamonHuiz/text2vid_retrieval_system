        "002492.webp",
        "002508.webp",
        "002509.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Các bạn nên nhớ chúng ta khứa một bên đậu hũ để đậu hũ dễ thấm gia vị hơn khi hấp nha.",
      "start": 100.4,
