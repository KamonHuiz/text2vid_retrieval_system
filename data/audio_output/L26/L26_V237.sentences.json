        "003228.webp",
        "003251.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hành tây này các bạn cắt dứt khoát nha để nó không có bị vỡ.",
      "start": 130.4,
      "end": 133.52,
      "n_words": 15,
