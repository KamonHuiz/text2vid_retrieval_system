      "end_frame": 1241,
      "keyframes": [
        "001110.webp",
        "001111.webp",
        "001176.webp",
        "001241.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trong trứng cút thì như chúng ta đã biết là có chứa vitamin A, choline và chất chống oxy hóa rất là tốt để phục hồi chức năng của phổi.",
      "start": 49.88,
      "end": 58.32,
      "n_words": 30,
      "start_frame": 1247,
      "end_frame": 1458,
      "keyframes": [
        "001262.webp",
        "001282.webp",
        "001283.webp",
        "001455.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bên cạnh đó thì vitamin A như quý vị cũng biết là giúp cho chúng ta sáng mắt hơn, đặc biệt là ngăn chặn sự phát triển của đục thủy tinh thể.",
      "start": 58.56,
      "end": 65.16,
      "n_words": 32,
      "start_frame": 1464,
      "end_frame": 1629,
      "keyframes": [
        "001628.webp",
        "001629.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trong đây có sự phối hợp giữa nấm mèo với lại hành tây.",
      "start": 65.16,
      "end": 68.6,
      "n_words": 13,
      "start_frame": 1629,
