      "keyframes": [
        "001629.webp",
        "001671.webp",
        "001714.webp",
        "001715.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nấm mèo thì có chứa chất sắt, còn hành tây thì có chứa vitamin C.",
      "start": 68.6,
      "end": 72.24,
      "n_words": 15,
      "start_frame": 1715,
      "end_frame": 1806,
      "keyframes": [
        "001715.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Sự kết hợp này sẽ giúp cho cơ thể của chúng ta hấp thu được chất sắt tốt hơn.",
      "start": 72.44,
