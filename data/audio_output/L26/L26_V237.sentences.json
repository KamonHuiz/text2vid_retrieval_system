      "keyframes": [
        "000735.webp",
        "000736.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 32.36,
      "end": 36.32,
      "n_words": 11,
