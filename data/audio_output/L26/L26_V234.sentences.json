        "000942.webp",
        "000943.webp",
        "001004.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mà cái này là hình như là mình vô trong những tiệm bánh mình mua là có đúng không anh?",
      "start": 42.52,
      "end": 45.56,
