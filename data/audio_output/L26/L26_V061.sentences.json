        "000607.webp",
        "000608.webp",
        "000698.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Rất vui khi được gặp lại các bạn khán giả đang xem chương trình Món ngon mỗi ngày, nấu chuẩn ăn lành.",
      "start": 29.24,
      "end": 36.56,
      "n_words": 22,
      "start_frame": 731,
      "end_frame": 914,
      "keyframes": [
        "000788.webp",
        "000789.webp",
        "000909.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam, trà Kim Thảo và Trên Bàn.",
      "start": 36.56,
      "end": 43.48,
      "n_words": 17,
      "start_frame": 914,
      "end_frame": 1087,
      "keyframes": [
        "001029.webp",
        "001030.webp",
        "001057.webp",
        "001085.webp",
        "001086.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trong ngày hôm nay, chúng ta có nguyên liệu chính là cá lòng tông; Cá lòng tông hoặc cá cơm cũng được.",
      "start": 43.48,
      "end": 51.08,
      "n_words": 22,
      "start_frame": 1087,
      "end_frame": 1277,
      "keyframes": [
        "001110.webp",
        "001134.webp",
        "001135.webp",
        "001196.webp",
        "001257.webp",
        "001258.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình sẽ làm món gì nè?",
      "start": 51.08,
      "end": 52.52,
      "n_words": 6,
      "start_frame": 1277,
      "end_frame": 1313,
      "keyframes": [
        "001284.webp",
        "001310.webp",
        "001311.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cá lòng tông thì thường là sẽ kho và ăn rất bắt cơm.",
      "start": 52.52,
      "end": 55.92,
      "n_words": 13,
      "start_frame": 1313,
      "end_frame": 1398,
      "keyframes": [
        "001338.webp",
        "001365.webp",
        "001366.webp",
        "001381.webp",
        "001397.webp",
        "001398.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Món cá lòng tông hôm nay chúng ta không kho các bạn ơi, mà chúng ta rim đậm nước mắm.",
      "start": 55.92,
      "end": 59.28,
      "n_words": 20,
      "start_frame": 1398,
      "end_frame": 1482,
      "keyframes": [
        "001398.webp",
        "001440.webp",
        "001482.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nước mắm ok, chúng ta nên ướp cá với một ít muối trước để cho cá thấm vị nè và cá được săn chắc, khi chiên sẽ giòn hơn.",
      "start": 59.28,
      "end": 68.44,
      "n_words": 29,
      "start_frame": 1482,
      "end_frame": 1711,
      "keyframes": [
        "001482.webp",
        "001483.webp",
        "001497.webp",
        "001512.webp",
        "001513.webp",
        "001609.webp",
        "001706.webp",
        "001707.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta sẽ bật một cái chảo dầu trước, dầu đã nóng rồi thì các bạn chúng ta cho vào để một ít rượu trắng trần thật là nhanh nha các bạn.",
      "start": 68.44,
      "end": 76.44,
      "n_words": 32,
      "start_frame": 1711,
      "end_frame": 1911,
      "keyframes": [
        "001736.webp",
        "001766.webp",
        "001767.webp",
        "001795.webp",
        "001824.webp",
        "001825.webp",
        "001847.webp",
        "001870.webp",
        "001871.webp",
        "001911.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Thưa các bạn, chúng ta trần nhanh cá qua nước pha rượu để cá được thơm, không bị tanh và sau khi chiên cá sẽ được giòn lâu hơn nha các bạn. Cá lòng tông như mọi người biết là đặc sản của vùng miền Tây sông nước đúng không ạ?",
      "start": 76.44,
      "end": 89.08,
      "n_words": 51,
      "start_frame": 1911,
      "end_frame": 2227,
      "keyframes": [
        "001911.webp",
        "001951.webp",
        "001952.webp",
        "002025.webp",
        "002099.webp",
        "002100.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nhưng mà đặc biệt hơn nữa là cá lòng tông ở Phong Điền, Cần Thơ thì thường được mọi người nhắc đến rất là nhiều, cho cá săn và thơm.",
      "start": 89.08,
      "end": 96.92,
      "n_words": 30,
      "start_frame": 2227,
      "end_frame": 2423,
      "keyframes": [
        "002245.webp",
        "002390.webp",
        "002391.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta ngâm qua đá lạnh để cá săn chắc lại.",
      "start": 96.92,
      "end": 100.16,
      "n_words": 11,
      "start_frame": 2423,
      "end_frame": 2504,
      "keyframes": [
        "002425.webp",
        "002460.webp",
        "002461.webp",
        "002492.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cá lòng tông có độ dinh dưỡng rất là cao, ví dụ như là có protein, vitamin A nè và cả canxi nữa, cho nên ăn sẽ rất tốt cho sức khỏe và bổ xương.",
      "start": 100.16,
      "end": 110.52,
      "n_words": 35,
      "start_frame": 2504,
      "end_frame": 2763,
      "keyframes": [
        "002523.webp",
        "002524.webp",
        "002596.webp",
        "002668.webp",
        "002669.webp",
        "002715.webp",
        "002762.webp",
        "002763.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta có ở đây ba muỗng canh nước lọc, nêm vào đây nửa muỗng cà phê bột ngọt Ajinomoto, thêm một muỗng canh đường, thêm một muỗng canh nước mắm, phải khuấy đều giúp anh cho nó tan.",
      "start": 110.52,
      "end": 123.12,
      "n_words": 39,
      "start_frame": 2763,
      "end_frame": 3078,
      "keyframes": [
        "002763.webp",
        "002793.webp",
        "002823.webp",
        "002824.webp",
        "002862.webp",
        "002900.webp",
        "002901.webp",
        "002931.webp",
        "002962.webp",
