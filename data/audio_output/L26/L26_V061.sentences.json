        "005993.webp",
        "005994.webp",
        "006039.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Thế là món ăn chúng ta đã hoàn tất.",
      "start": 242.04,
      "end": 244.24,
      "n_words": 9,
      "start_frame": 6051,
      "end_frame": 6106,
      "keyframes": [
        "006084.webp",
        "006085.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Món ăn ngày hôm nay xong trong tích tắc luôn ạ và một số những cái bí kíp cũng đã được lưu lại rồi phải không các bạn khán giả?",
      "start": 244.24,
