        "004053.webp"
      ],
      "keyframe_count": 21
    },
    {
      "text": "Chúng ta bật đây một cái chảo và một cái điều chia sẻ này các bạn: đối với món ăn này thì chúng ta dùng cá lòng tong đá thì nó sẽ to hơn và nó ngọt hơn.",
      "start": 162.88,
      "end": 172.96,
      "n_words": 38,
      "start_frame": 4072,
      "end_frame": 4324,
      "keyframes": [
        "004076.webp",
        "004077.webp",
        "004116.webp",
        "004155.webp",
