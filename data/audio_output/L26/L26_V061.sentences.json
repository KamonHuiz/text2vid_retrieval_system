        "005718.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó, bắt đầu thấy miếng cá nó bóng bẩy lại rồi đó.",
      "start": 228.8,
      "end": 233.48,
      "n_words": 12,
