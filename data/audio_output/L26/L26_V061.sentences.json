        "002989.webp",
        "003016.webp",
        "003017.webp",
        "003052.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Kế tiếp chúng ta sẽ chuẩn bị các cái gia vị để chúng ta cho vào sau cùng: vài nhánh hành lá cắt nhỏ như vậy, khoảng năm ly, đừng cắt nhỏ quá.",
      "start": 123.12,
      "end": 135.36,
      "n_words": 33,
      "start_frame": 3078,
      "end_frame": 3384,
      "keyframes": [
        "003087.webp",
        "003088.webp",
        "003143.webp",
        "003199.webp",
        "003200.webp",
        "003273.webp",
        "003346.webp",
        "003347.webp",
        "003364.webp",
        "003382.webp",
        "003383.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Ớt sừng chúng ta cũng cắt miếng nhỏ ha, khoảng năm ly.",
      "start": 135.36,
      "end": 143.56,
      "n_words": 12,
      "start_frame": 3384,
      "end_frame": 3589,
      "keyframes": [
        "003465.webp",
        "003547.webp",
        "003548.webp",
        "003571.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và cá làm sẵn chúng ta để ráo, chúng ta cho ở đây đầu hành lá, ớt, nửa muỗng cà phê bột ngọt cho vào đây, khoảng nửa gói gia vị Nam Sản, bột tẩm khô chiên giòn rồi đó, xắt nhỏ đều như vậy.",
      "start": 143.56,
      "end": 162.88,
      "n_words": 45,
      "start_frame": 3589,
      "end_frame": 4072,
      "keyframes": [
        "003595.webp",
        "003596.webp",
        "003633.webp",
        "003670.webp",
        "003671.webp",
