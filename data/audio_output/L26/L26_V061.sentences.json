        "004755.webp",
        "004756.webp",
        "004830.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đúng rồi, rất là nhanh vàng luôn á anh Vũ.",
      "start": 195.16,
      "end": 198.28,
      "n_words": 10,
      "start_frame": 4879,
      "end_frame": 4957,
      "keyframes": [
        "004905.webp",
        "004906.webp",
        "004933.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, bớt ra để giấy thấm dầu như vậy.",
      "start": 198.28,
      "end": 205.4,
      "n_words": 10,
      "start_frame": 4957,
      "end_frame": 5135,
      "keyframes": [
