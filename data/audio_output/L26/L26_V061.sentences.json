        "005325.webp",
        "005326.webp",
        "005356.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Đây là công đoạn hấp dẫn nhất ạ: đổ nước rim vô bạn.",
      "start": 215.28,
      "end": 222.72,
      "n_words": 13,
