        "006454.webp",
        "006479.webp",
        "006480.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và thưa các bạn, thấy là chúng ta đã có ngay một món ăn dân dã và rất là dễ làm đúng không nào?",
      "start": 263.36,
      "end": 268.64,
      "n_words": 24,
      "start_frame": 6584,
      "end_frame": 6716,
      "keyframes": [
        "006634.webp",
        "006714.webp",
        "006715.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và món này chúng ta dùng kèm với cơm hoặc là xôi cũng rất là hợp.",
      "start": 268.64,
      "end": 272.0,
      "n_words": 16,
      "start_frame": 6716,
