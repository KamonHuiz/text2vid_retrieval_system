        "005134.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chúng ta rim cá này, cho ớt cho nó trông lên, cho cá vào chúng ta sắp đều.",
      "start": 205.4,
      "end": 215.28,
      "n_words": 18,
      "start_frame": 5135,
      "end_frame": 5382,
