        "002829.webp",
        "002875.webp",
        "002876.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Đây trong thời gian chờ cái phần protein này nó ngấm đó, biết làm gì rồi hen.",
      "start": 115.16,
      "end": 120.32,
