        "000457.webp",
        "000468.webp",
        "000469.webp",
        "000480.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Em có thấy ai xay sinh tố hành không? Chắc có.",
      "start": 19.32,
      "end": 21.56,
      "n_words": 11,
      "start_frame": 483,
      "end_frame": 539,
      "keyframes": [
        "000492.webp",
