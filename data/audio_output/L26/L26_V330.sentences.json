        "001214.webp",
        "001300.webp",
        "001387.webp",
        "001388.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 57.84,
      "end": 61.36,
      "n_words": 11,
      "start_frame": 1446,
      "end_frame": 1534,
      "keyframes": [
        "001461.webp",
        "001534.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thì công việc khó là em nhờ anh Tuấn sẽ cắt rau củ quả giùm em chứ anh thấy cái thớt đây là anh hiểu rồi.",
      "start": 61.36,
      "end": 66.32,
      "n_words": 26,
      "start_frame": 1534,
      "end_frame": 1658,
      "keyframes": [
        "001534.webp",
        "001535.webp",
        "001597.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phần của em thì bây giờ em sẽ cắt bản lớn cái phần tim và gan để mình tẩm ướp trước cho nó thấm ha. Độ dày khoảng nhiêu hả?",
      "start": 66.32,
