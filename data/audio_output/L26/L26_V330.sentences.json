      "start_frame": 2879,
      "end_frame": 3008,
      "keyframes": [
        "002940.webp",
        "003005.webp",
        "003006.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ thì mình sẽ xào thơm, mình cắt thơm hình rẻ quạt nhỏ ra nha rồi tiếp tục.",
      "start": 120.32,
      "end": 124.84,
      "n_words": 19,
      "start_frame": 3008,
      "end_frame": 3121,
      "keyframes": [
        "003051.webp",
        "003096.webp",
        "003097.webp",
        "003116.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Làm cái phần ớt chuông thì chúng ta sẽ cắt sợi, tiếp tục ớt chuông vàng luôn.",
      "start": 124.84,
      "end": 129.08,
      "n_words": 17,
      "start_frame": 3121,
      "end_frame": 3227,
      "keyframes": [
        "003135.webp",
        "003136.webp",
        "003162.webp",
        "003189.webp",
        "003190.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đúng là cái món này đầy màu sắc đúng không anh Tuấn? Đúng rồi.",
      "start": 129.08,
      "end": 131.28,
