        "001699.webp",
        "001700.webp",
        "001730.webp",
        "001761.webp",
        "001762.webp",
        "001796.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Xin cái này là chắc khoảng 3 ly để nó có cái cảm giác á.",
      "start": 72.92,
      "end": 75.68,
      "n_words": 15,
      "start_frame": 1823,
      "end_frame": 1892,
      "keyframes": [
        "001831.webp",
        "001832.webp",
        "001873.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, bên ngoài thì nó sẽ cứng bên trong nó mềm thì nó mới ngon.",
      "start": 75.68,
      "end": 78.96,
      "n_words": 16,
      "start_frame": 1892,
      "end_frame": 1974,
      "keyframes": [
        "001915.webp",
        "001916.webp",
        "001943.webp",
        "001971.webp",
        "001972.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tới cái phần tim heo này thì mình sẽ cắt bản lớn nhưng mà cái này nó lớn quá thì mình cắt nó làm đôi ha.",
      "start": 78.96,
      "end": 83.28,
      "n_words": 26,
      "start_frame": 1974,
      "end_frame": 2082,
      "keyframes": [
        "002072.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mình cũng sẽ cắt những cái miếng mà nó tương đương với lại cái phần gan bên kia ha, nó gần bằng cái size với gan để cho thứ nhất là chín đều và thứ hai là nhìn nó hấp dẫn hơn, nhìn món ăn mà đẹp mắt hơn, nó đều hơn.",
      "start": 83.28,
      "end": 94.68,
      "n_words": 52,
      "start_frame": 2082,
      "end_frame": 2367,
      "keyframes": [
        "002172.webp",
        "002173.webp",
        "002253.webp",
        "002334.webp",
        "002335.webp",
        "002364.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Để chọn được tim heo ngon chúng ta nên chọn trọng lượng từ 300 tới 350 gam là tim heo ngon và bây giờ thì chúng ta sẽ tiến hành tẩm ướp cái phần tim gan nha.",
      "start": 94.68,
      "end": 102.72,
      "n_words": 37,
      "start_frame": 2367,
      "end_frame": 2568,
      "keyframes": [
        "002393.webp",
        "002394.webp",
        "002444.webp",
        "002494.webp",
        "002495.webp",
        "002530.webp",
        "002566.webp",
        "002567.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đầu tiên thì xin sẽ có một muỗng canh hành tỏi băm, một muỗng canh nước tương Phú Sĩ nha cho thơm, thêm phần đậm đà hơn thì xin cũng có thêm một muỗng canh dầu hào, có nửa muỗng cà phê tiêu xay, rồi bây giờ chúng ta trộn đều lên.",
      "start": 102.72,
      "end": 115.16,
      "n_words": 52,
      "start_frame": 2568,
      "end_frame": 2879,
      "keyframes": [
        "002598.webp",
