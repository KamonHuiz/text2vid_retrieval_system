      "n_words": 27,
      "start_frame": 4060,
      "end_frame": 4244,
      "keyframes": [
        "004061.webp",
        "004062.webp",
        "004110.webp",
        "004159.webp",
        "004160.webp",
        "004201.webp",
        "004242.webp",
        "004243.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta đảo đi cho nó thơm lên, thơm thôi không cần vàng đâu.",
      "start": 169.76,
      "end": 173.36,
      "n_words": 14,
      "start_frame": 4244,
      "end_frame": 4334,
      "keyframes": [
        "004283.webp",
        "004324.webp",
        "004325.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi lửa đang lớn thì bây giờ mình sẽ cho thêm cái phần gan và tim đã tẩm ướp vào nha.",
      "start": 173.36,
      "end": 177.64,
      "n_words": 21,
      "start_frame": 4334,
      "end_frame": 4441,
      "keyframes": [
        "004357.webp",
        "004389.webp",
        "004390.webp",
        "004421.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi mình xào lửa lớn để giữ được nước ngọt bên trong đúng không? Đúng rồi.",
      "start": 177.64,
