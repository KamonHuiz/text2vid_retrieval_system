      "keyframes": [
        "004453.webp",
        "004454.webp",
        "004490.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình xào tới khi mà cái phần gan và tim này nó hơi xém một chút xíu thôi.",
      "start": 181.04,
      "end": 185.2,
