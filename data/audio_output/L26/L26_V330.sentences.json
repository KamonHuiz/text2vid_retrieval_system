      "start_frame": 3227,
      "end_frame": 3282,
      "keyframes": [
        "003236.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hành tây tím nó sẽ ngon hơn là hành tây trắng đúng không?",
      "start": 131.28,
      "end": 133.24,
      "n_words": 13,
      "start_frame": 3282,
      "end_frame": 3331,
      "keyframes": [
        "003283.webp",
        "003284.webp",
        "003308.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sẽ ngọt hơn nè.",
      "start": 133.24,
      "end": 134.2,
      "n_words": 4,
      "start_frame": 3331,
      "end_frame": 3355,
      "keyframes": [
        "003332.webp",
        "003333.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đúng rồi, vị nó sẽ rõ ràng hơn, đúng luôn, đậm đà hơn.",
      "start": 134.2,
      "end": 137.16,
