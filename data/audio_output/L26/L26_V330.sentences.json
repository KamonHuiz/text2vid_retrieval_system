      "keyframes": [
        "004969.webp",
        "004992.webp",
        "004993.webp",
        "005026.webp",
        "005059.webp",
        "005060.webp",
        "005079.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đối với món này chúng ta xào tim gan rồi xào rau củ sau đó chúng ta trộn chung lại để nguyên liệu được chín đều và giữ được độ ngọt cho món ăn nha.",
      "start": 203.28,
