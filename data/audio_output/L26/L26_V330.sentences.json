      "start_frame": 3355,
      "end_frame": 3429,
      "keyframes": [
        "003379.webp",
        "003425.webp",
        "003426.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi đậu que này thì mình cắt xéo làm đôi là được.",
