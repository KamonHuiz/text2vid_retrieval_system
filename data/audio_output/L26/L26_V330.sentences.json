      "end": 146.36,
      "n_words": 9,
      "start_frame": 3610,
      "end_frame": 3659,
      "keyframes": [
        "003626.webp",
        "003652.webp",
        "003653.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Món xào thì mình không có cắt hành nhuyễn quá.",
      "start": 146.36,
      "end": 149.0,
      "n_words": 10,
      "start_frame": 3659,
