        "000571.webp",
        "000591.webp",
        "000611.webp",
        "000612.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thôi thì mình xào đi.",
      "start": 24.56,
      "end": 26.2,
      "n_words": 5,
      "start_frame": 614,
      "end_frame": 655,
      "keyframes": [
        "000631.webp",
        "000650.webp",
        "000651.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thiếu đạm em ơi, lâu lâu ăn chay bữa đi anh, khỏi đem ơn em bằng em ơi.",
      "start": 26.2,
      "end": 29.6,
      "n_words": 18,
      "start_frame": 655,
      "end_frame": 740,
      "keyframes": [
        "000660.webp",
        "000670.webp",
        "000671.webp",
        "000687.webp",
        "000704.webp",
        "000705.webp",
        "000721.webp",
        "000738.webp",
        "000739.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi xong luôn, em có tim gan tươi mình nấu luôn.",
      "start": 29.6,
      "end": 32.88,
      "n_words": 11,
      "start_frame": 740,
      "end_frame": 822,
      "keyframes": [
        "000761.webp",
        "000783.webp",
        "000784.webp",
        "000818.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trời ơi quá lời, xào nóng hổi với dầu cua ve xào tim heo. Chào các bạn khán giả đến với chương trình Món ngon mỗi ngày.",
      "start": 32.88,
      "end": 57.84,
      "n_words": 27,
      "start_frame": 822,
      "end_frame": 1446,
      "keyframes": [
        "000852.webp",
        "000853.webp",
        "000877.webp",
        "000902.webp",
