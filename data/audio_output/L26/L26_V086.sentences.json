        "004191.webp",
        "004192.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sau khi mà sả dậy mùi thơm rồi á thì chúng ta sẽ tắt cái lửa này, chúng ta sẽ cho cá vào đây.",
      "start": 167.68,
      "end": 173.52,
      "n_words": 24,
      "start_frame": 4192,
      "end_frame": 4338,
      "keyframes": [
        "004192.webp",
        "004233.webp",
        "004274.webp",
        "004275.webp",
        "004288.webp",
        "004301.webp",
        "004302.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cái bước này mình gọi là khử mùi thơm là khử mùi thơm cho cá.",
      "start": 173.52,
      "end": 176.72,
      "n_words": 15,
      "start_frame": 4338,
      "end_frame": 4418,
      "keyframes": [
        "004360.webp",
        "004418.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ chúng ta sẽ cho gia vị nêm sẵn Aji-Quick lẩu Thái vào đây ha.",
      "start": 176.72,
      "end": 180.76,
