        "001777.webp",
        "001830.webp",
        "001883.webp",
        "001884.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Rồi em cắt cái muối cao, cái quả cà chua là được rồi.",
      "start": 75.44,
      "end": 80.72,
      "n_words": 13,
