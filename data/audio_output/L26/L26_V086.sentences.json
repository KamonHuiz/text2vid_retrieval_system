        "003785.webp",
        "003812.webp",
        "003813.webp",
        "003863.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình sẽ cho sả đã đập dập vào đây, mình phi cho cái sả ra mùi thơm.",
      "start": 156.24,
      "end": 162.0,
      "n_words": 17,
      "start_frame": 3906,
      "end_frame": 4050,
      "keyframes": [
        "003913.webp",
        "003914.webp",
        "003983.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn lưu ý là chúng ta phi sả để khử mùi cho đầu cá và lòng cá không bị tanh nhé.",
      "start": 162.0,
      "end": 167.68,
