        "003062.webp",
        "003063.webp",
        "003133.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nấu lẩu thì cô sẽ đặt lên trên bếp một nồi có một nước rưỡi.",
      "start": 128.0,
      "end": 131.92,
