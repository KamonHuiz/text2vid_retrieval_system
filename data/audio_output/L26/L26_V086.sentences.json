        "005013.webp",
        "005038.webp",
        "005039.webp",
        "005076.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Cho nấm rơm vô đây mình xào cho thơm và cà chua qua đây mình cũng chỉ cần sóc sơ thôi.",
      "start": 204.72,
