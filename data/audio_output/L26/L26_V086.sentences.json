      "end_frame": 5925,
      "keyframes": [
        "005823.webp",
        "005887.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Dạ rồi bây giờ thì em tắt lửa đi, cuối cùng mình sẽ cho một muỗng canh nước mắm vô đây.",
      "start": 237.0,
      "end": 244.88,
      "n_words": 21,
