        "005976.webp",
        "006001.webp",
        "006002.webp",
        "006063.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cá lóc rất là lành tính và nhiều dưỡng chất.",
      "start": 244.88,
      "end": 247.92,
      "n_words": 10,
      "start_frame": 6122,
