        "005727.webp",
        "005822.webp",
        "005823.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp tục là cô sẽ cho cái phần lá chanh thái luôn và ớt đã đập dập vô đây luôn.",
      "start": 232.92,
