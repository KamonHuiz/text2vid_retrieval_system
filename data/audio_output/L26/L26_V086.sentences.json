        "001288.webp",
        "001318.webp",
        "001319.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Theo yêu cầu của Kim Thảo sẽ là món lẩu Thái đầu cá lóc bông.",
      "start": 52.92,
      "end": 56.88,
      "n_words": 15,
