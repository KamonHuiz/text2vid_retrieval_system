      "end_frame": 5443,
      "keyframes": [
        "005327.webp",
        "005380.webp",
        "005381.webp",
        "005413.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cá vừa chín tới thực ra là nó lẩu thì mình cá mình trừ hao cái độ chín lên chút ha, rồi mình sẽ cho luôn cái phần này vô.",
      "start": 217.72,
      "end": 225.2,
      "n_words": 30,
      "start_frame": 5443,
