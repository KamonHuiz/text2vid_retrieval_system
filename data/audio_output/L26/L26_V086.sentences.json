        "002286.webp",
        "002287.webp",
        "002308.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ để ngon thêm thì mình sẽ khứa chữ thập ở đầu nấm.",
      "start": 92.64,
      "end": 95.68,
      "n_words": 14,
