      "keyframes": [
        "001946.webp",
        "002008.webp",
        "002009.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thơm thì em chỉ cần cắt ngang thôi rồi em để chung dĩa cũng được.",
      "start": 80.72,
      "end": 89.08,
