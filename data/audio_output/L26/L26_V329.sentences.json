      "end_frame": 1622,
      "keyframes": [
        "001545.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ Phước Hưng sẽ cắt hình thỏi cái phần ớt chuông xanh và đỏ này rồi và bây giờ chúng ta sẽ cho ra dĩa luôn.",
      "start": 64.88,
