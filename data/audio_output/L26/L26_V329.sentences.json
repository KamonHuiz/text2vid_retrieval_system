      "end_frame": 2470,
      "keyframes": [
        "002462.webp",
        "002463.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi Minh Phương cũng đã cắt xong cái phần cần tây rồi.",
