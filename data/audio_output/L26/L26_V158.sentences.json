        "002766.webp",
        "002801.webp",
        "002802.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Quốc Nghị sử dụng mè trắng và mè đen trong món ăn này.",
      "start": 112.2,
      "end": 116.52,
      "n_words": 13,
