        "002869.webp",
        "002893.webp",
        "002894.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Quốc Nghị đã sử dụng hai loại mè, sử dụng hai loại mè thưa quý vị đó là mè trắng và mè đen.",
      "start": 116.52,
      "end": 120.24,
      "n_words": 23,
