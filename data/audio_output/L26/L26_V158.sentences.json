        "001281.webp",
        "001429.webp",
        "001430.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chính xác đó Kim Thảo, cá kèo thì nó rất là thơm ngon và ngọt.",
      "start": 57.24,
      "end": 61.44,
      "n_words": 15,
      "start_frame": 1431,
      "end_frame": 1536,
      "keyframes": [
        "001482.webp",
        "001535.webp",
        "001536.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hôm nay Quốc Nghị sẽ thử làm món cá kèo chiên mè để xem vị nó như thế nào các bạn nhé.",
      "start": 61.44,
      "end": 67.04,
      "n_words": 22,
      "start_frame": 1536,
      "end_frame": 1676,
      "keyframes": [
        "001536.webp",
        "001578.webp",
        "001621.webp",
        "001622.webp",
        "001650.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta nên chọn những con cá kèo nó đều con với nhau, xương mềm có thể ăn được, mình sẽ cảm nhận được cái vị béo bùi và khi món ăn trình bày ra nó sẽ đồng đều và đẹp hơn đó các bạn.",
      "start": 67.04,
      "end": 77.8,
      "n_words": 45,
      "start_frame": 1676,
      "end_frame": 1945,
      "keyframes": [
        "001679.webp",
        "001680.webp",
        "001812.webp",
        "001944.webp",
        "001945.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thịt cá kèo á thì chúng ta sẽ cắt phần đuôi nè, phần đầu nè, rửa một ít nước muối cho nó sạch rồi bây giờ chúng ta sẽ ướp với hai muỗng canh gia vị nem sẵn Ajinomoto, bột chiên giòn.",
      "start": 77.8,
      "end": 88.72,
      "n_words": 42,
      "start_frame": 1945,
      "end_frame": 2218,
      "keyframes": [
