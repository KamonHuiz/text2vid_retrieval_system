        "000892.webp",
        "000893.webp",
        "001012.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 41.2,
      "end": 45.28,
      "n_words": 11,
