        "005276.webp",
        "005353.webp",
        "005354.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bí quyết của đầu bếp Quốc Nghị rất là hay đúng không ạ?",
      "start": 214.16,
      "end": 216.72,
      "n_words": 13,
