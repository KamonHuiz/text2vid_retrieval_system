      "keyframes": [
        "000726.webp",
        "000764.webp",
        "000765.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, nhưng mà Kim Thảo muốn kết hợp loại thịt gì với mắc khén này?",
      "start": 30.64,
      "end": 35.68,
