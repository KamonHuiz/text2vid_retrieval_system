      "start_frame": 446,
      "end_frame": 524,
      "keyframes": [
        "000499.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mà bật mí luôn nha, đây là loại mà nhà Kim Thảo ai cũng thích hết: hạt mắc khén.",
      "start": 20.96,
      "end": 25.72,
