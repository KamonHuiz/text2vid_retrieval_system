      "start_frame": 892,
      "end_frame": 922,
      "keyframes": [
        "000893.webp",
        "000919.webp",
        "000920.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Gà mà đi với mắc khén thì còn gì bằng nữa.",
