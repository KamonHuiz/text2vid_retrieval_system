        "001001.webp",
        "001026.webp",
        "001027.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Súp ốc heo tóc tiên, nếm là mê, ăn là ghiền.",
      "start": 41.08,
      "end": 61.28,
      "n_words": 11,
      "start_frame": 1027,
