        "002220.webp",
        "002269.webp",
        "002270.webp",
        "002316.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Không chính xác luôn đó Minh Phương, nước cũng đã sôi rồi Phước Hưng ơi.",
      "start": 92.84,
      "end": 96.32,
