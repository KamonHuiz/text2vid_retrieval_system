      "end_frame": 627,
      "keyframes": [
        "000626.webp",
        "000627.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ủa hôm nay Phước Hưng tính trổ tài nấu món gì mà đi kiếm nước tương vậy?",
      "start": 25.08,
      "end": 28.48,
