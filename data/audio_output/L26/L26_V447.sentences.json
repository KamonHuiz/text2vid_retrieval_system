        "000332.webp",
        "000333.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hưng: Chào Minh Phương, đang đi kiếm nước tương Phú Sĩ mà chưa có nữa nè.",
      "start": 14.24,
      "end": 20.96,
