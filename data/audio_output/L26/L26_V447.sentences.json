        "002487.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ chưng cách thủy ốc heo với gừng giúp cho ốc heo khử được mùi tanh và thơm ngon hơn.",
      "start": 100.04,
