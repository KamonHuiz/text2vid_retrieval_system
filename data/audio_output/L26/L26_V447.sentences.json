        "002362.webp",
        "002363.webp",
        "002400.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi, và bây giờ chúng ta sẽ cho phần ốc heo vào, chúng ta chưng cách thủy nè.",
      "start": 96.32,
