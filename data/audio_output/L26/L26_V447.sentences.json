        "000471.webp",
        "000516.webp",
        "000517.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Tính cà khịa mấy người mà coi bộ không có dễ hèn chứ.",
      "start": 20.96,
      "end": 24.2,
      "n_words": 13,
