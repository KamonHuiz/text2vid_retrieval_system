      "end_frame": 1452,
      "keyframes": [
        "001449.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Món chay hôm nay có tên gọi là sườn chay ôm nấm đùi gà.",
      "start": 58.08,
      "end": 61.56,
      "n_words": 14,
