        "001337.webp",
        "001360.webp",
        "001361.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "- Đáp ứng theo yêu cầu của Minh Tuấn, chúng ta sẽ làm một món chay.",
      "start": 54.96,
      "end": 58.08,
