        "001588.webp",
        "001629.webp",
        "001670.webp",
        "001671.webp",
        "001690.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chính xác, người ta hay gọi là sà bấu đó các bạn.",
      "start": 67.92,
      "end": 70.8,
      "n_words": 12,
      "start_frame": 1698,
      "end_frame": 1770,
      "keyframes": [
        "001710.webp",
        "001711.webp",
        "001745.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi ngay bây giờ mời các bạn cùng theo dõi thực hiện món canh sườn đậu phộng sá sậu.",
      "start": 70.8,
      "end": 75.04,
      "n_words": 19,
      "start_frame": 1770,
      "end_frame": 1876,
      "keyframes": [
        "001779.webp",
        "001780.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Món ăn này thì rất là đơn giản, mà bên cạnh đó theo chuyên gia dinh dưỡng thì món ăn này còn giúp hỗ trợ cho việc bổ máu rất là tốt nha các bạn.",
      "start": 75.04,
      "end": 82.0,
      "n_words": 35,
      "start_frame": 1876,
      "end_frame": 2050,
      "keyframes": [
        "001913.webp",
        "002047.webp",
        "002048.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đầu tiên thì chúng ta sẽ xử lý phần protein trước, chúng ta ướp sườn với lại một muỗng cà phê hạt nêm Ajinomoto, một muỗng cà phê bột ngọt Ajinomoto và một muỗng cà phê đường, thêm vào đây nửa muỗng cà phê bột năng nha các bạn.",
      "start": 82.0,
      "end": 96.92,
      "n_words": 49,
      "start_frame": 2050,
      "end_frame": 2423,
      "keyframes": [
