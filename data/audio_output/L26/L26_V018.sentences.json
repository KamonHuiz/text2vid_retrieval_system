      "start_frame": 3070,
      "end_frame": 3100,
      "keyframes": [
        "003088.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cho củ hành tím vô đây, chúng ta rang không dầu cho dậy mùi thơm.",
