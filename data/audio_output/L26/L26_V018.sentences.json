      "end_frame": 2546,
      "keyframes": [
        "002483.webp",
        "002544.webp",
        "002545.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong đây khoảng chừng một muỗng cà phê dầu ăn.",
      "start": 101.84,
      "end": 104.36,
      "n_words": 10,
      "start_frame": 2546,
      "end_frame": 2609,
      "keyframes": [
        "002580.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn cải sa bấu này để xả bớt cái vị mặn trong cải sa bấu, chúng ta nhớ ngâm trong nước muối pha loãng.",
