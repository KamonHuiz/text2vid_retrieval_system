        "003617.webp",
        "003618.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Khúc này chúng ta nổi lửa lên, chúng ta sẽ cho cải sá bấu vào, chúng ta xào luôn.",
      "start": 147.72,
      "end": 153.4,
