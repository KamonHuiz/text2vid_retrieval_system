        "003395.webp",
        "003439.webp",
        "003440.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ cho dầu ăn vào và chúng ta cho sườn vào, chúng ta xào cho thấm vị sá bấu.",
      "start": 137.8,
