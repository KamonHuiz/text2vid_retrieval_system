        "001202.webp",
        "001238.webp",
        "001239.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Có thịt cua nè.",
      "start": 49.6,
      "end": 50.84,
      "n_words": 4,
      "start_frame": 1240,
      "end_frame": 1271,
      "keyframes": [
        "001269.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi anh hỏi nha, em thích ăn cua không? Dạ thích.",
      "start": 50.84,
      "end": 53.6,
      "n_words": 11,
      "start_frame": 1271,
      "end_frame": 1340,
      "keyframes": [
        "001299.webp",
        "001300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Em thích ăn súp không? Cũng thích luôn.",
      "start": 53.6,
      "end": 55.68,
      "n_words": 8,
      "start_frame": 1340,
      "end_frame": 1392,
      "keyframes": [
        "001359.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em thích ăn mùi Thái không? Món này là hết sảy luôn.",
      "start": 55.68,
      "end": 58.16,
      "n_words": 12,
      "start_frame": 1392,
      "end_frame": 1454,
      "keyframes": [
        "001418.webp",
        "001419.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hôm nay anh sẽ nấu em ba món trong một, ba món trong một luôn.",
      "start": 58.16,
      "end": 61.8,
      "n_words": 15,
      "start_frame": 1454,
      "end_frame": 1545,
      "keyframes": [
        "001458.webp",
        "001498.webp",
        "001499.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi hôm nay chúng ta thực hiện món súp cua vị Thái.",
      "start": 61.8,
      "end": 64.92,
      "n_words": 12,
      "start_frame": 1545,
      "end_frame": 1623,
      "keyframes": [
        "001561.webp",
        "001623.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi bây giờ mình chuẩn bị khâu chế biến nha, phần mà dễ nhất là cắt thái để chế biến rồi, Thanh Phương làm nha.",
      "start": 64.92,
      "end": 70.16,
      "n_words": 25,
      "start_frame": 1623,
      "end_frame": 1754,
      "keyframes": [
        "001623.webp",
