        "002195.webp",
        "002246.webp",
        "002298.webp",
        "002299.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nấm đông cô thì mình cắt lát, cà rốt loãng sẽ cắt thành những sợi nhỏ kệ.",
      "start": 92.08,
      "end": 105.12,
      "n_words": 17,
