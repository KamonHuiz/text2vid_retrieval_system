        "004781.webp",
        "004937.webp",
        "004938.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và ba muỗng canh bột năng với lại một phần ba chén nước vào từ từ trong nồi súp của mình.",
      "start": 197.56,
      "end": 203.0,
      "n_words": 21,
