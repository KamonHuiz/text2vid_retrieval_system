        "001651.webp",
        "001679.webp",
        "001680.webp",
        "001721.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Dạ.",
      "start": 70.16,
      "end": 70.56,
      "n_words": 1,
      "start_frame": 1754,
      "end_frame": 1764,
      "keyframes": [
        "001763.webp",
        "001764.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nấm thì mình sẽ nhặt ra xong mình cắt làm đôi.",
      "start": 70.56,
      "end": 73.12,
      "n_words": 11,
      "start_frame": 1764,
