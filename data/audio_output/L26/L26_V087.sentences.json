      "keyframes": [
        "000916.webp",
        "000917.webp",
        "001041.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh Long nè, hôm nay mình sẽ làm món gì mà Thanh Phương thấy hấp dẫn quá?",
      "start": 46.48,
      "end": 49.6,
      "n_words": 17,
