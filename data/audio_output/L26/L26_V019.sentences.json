      "n_words": 22,
      "start_frame": 1024,
      "end_frame": 1154,
      "keyframes": [
        "001031.webp",
        "001032.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 46.16,
      "end": 49.8,
      "n_words": 11,
      "start_frame": 1154,
      "end_frame": 1245,
      "keyframes": [
        "001155.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ vâng, chào Minh Tuấn.",
      "start": 49.8,
      "end": 51.24,
      "n_words": 5,
      "start_frame": 1245,
      "end_frame": 1281,
      "keyframes": [
        "001279.webp",
        "001280.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Dạo này không khí mình nó nóng quá, rất là nóng đúng không?",
      "start": 51.24,
      "end": 53.92,
      "n_words": 13,
      "start_frame": 1281,
      "end_frame": 1348,
      "keyframes": [
        "001297.webp",
        "001314.webp",
        "001315.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mà hai đứa mình dạo này thấy cũng có vẻ phát tướng hơn.",
      "start": 53.92,
      "end": 57.08,
      "n_words": 13,
      "start_frame": 1348,
      "end_frame": 1427,
      "keyframes": [
        "001389.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, liệu có một cái món nào đó mà nó vừa thanh nhiệt, nào mà nó vừa giúp cho hai đứa mình có thể giảm bớt cái khối mỡ thừa của mình thì càng tuyệt vời.",
      "start": 57.08,
      "end": 66.12,
      "n_words": 37,
      "start_frame": 1427,
      "end_frame": 1653,
      "keyframes": [
        "001463.webp",
        "001464.webp",
        "001491.webp",
        "001519.webp",
        "001520.webp",
        "001557.webp",
        "001595.webp",
        "001596.webp",
        "001625.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Có luôn!",
      "start": 66.12,
      "end": 66.56,
      "n_words": 2,
      "start_frame": 1653,
      "end_frame": 1664,
      "keyframes": [
        "001655.webp",
        "001656.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Vậy thì ngày hôm nay, Phước Hương sẽ hướng dẫn cho Minh Tuấn cũng như là các bạn một cái món canh đó là món canh tôm bồ ngót.",
      "start": 66.56,
      "end": 73.04,
      "n_words": 29,
      "start_frame": 1664,
      "end_frame": 1826,
      "keyframes": [
        "001740.webp",
        "001824.webp",
        "001825.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và cũng theo lời của chuyên gia dinh dưỡng, món ăn ngày hôm nay giảm khối mỡ thừa trong cơ thể rất tốt.",
      "start": 73.04,
      "end": 77.68,
      "n_words": 23,
      "start_frame": 1826,
      "end_frame": 1942,
      "keyframes": [
        "001881.webp",
        "001937.webp",
        "001938.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sơ chế cũng như là ướp phần tôm trước.",
      "start": 77.68,
      "end": 80.24,
      "n_words": 11,
      "start_frame": 1942,
      "end_frame": 2006,
      "keyframes": [
        "001961.webp",
        "001985.webp",
        "001986.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tôm đất chúng ta lột hết vỏ, lấy chỉ lưng và băm.",
      "start": 80.24,
      "end": 83.4,
      "n_words": 12,
      "start_frame": 2006,
      "end_frame": 2085,
      "keyframes": [
        "002021.webp",
        "002057.webp",
        "002058.webp",
        "002078.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Hương sẽ cho vào đây nửa muỗng cà phê muối, nửa muỗng cà phê bột ngọt Ajinomoto, nửa muỗng cà phê tiêu, một muỗng cà phê hành tím băm.",
      "start": 83.84,
      "end": 92.28,
      "n_words": 29,
      "start_frame": 2096,
      "end_frame": 2307,
      "keyframes": [
        "002099.webp",
        "002100.webp",
        "002129.webp",
        "002159.webp",
        "002160.webp",
        "002173.webp",
        "002186.webp",
        "002187.webp",
        "002200.webp",
        "002214.webp",
        "002215.webp",
        "002234.webp",
        "002254.webp",
        "002255.webp",
        "002283.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Chúng ta sẽ trộn đều gia vị lên cho tôm được thấm vị.",
      "start": 92.28,
      "end": 96.4,
      "n_words": 13,
      "start_frame": 2307,
      "end_frame": 2410,
      "keyframes": [
        "002311.webp",
        "002312.webp",
        "002361.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tôm thì là một loại hải sản có rất là nhiều chất đạm ở bên trong và có cực kỳ ít chất béo luôn, nên là nó rất là phù hợp cho những người mà chúng ta có cái nhu cầu là giảm khối mỡ thừa hoặc là tăng cơ trong cơ thể thì mình sẽ bổ sung tôm các bạn ha.",
      "start": 96.4,
      "end": 109.36,
      "n_words": 62,
      "start_frame": 2410,
      "end_frame": 2734,
      "keyframes": [
        "002411.webp",
        "002412.webp",
        "002558.webp",
        "002704.webp",
        "002705.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta để thấm khoảng năm phút.",
      "start": 109.36,
      "end": 110.96,
      "n_words": 7,
      "start_frame": 2734,
      "end_frame": 2774,
      "keyframes": [
        "002738.webp",
        "002771.webp",
        "002772.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tiếp theo chúng ta nấu canh, sẽ cho vào đây khoảng một muỗng hành tím băm để chúng ta phi thơm.",
      "start": 110.96,
      "end": 117.04,
      "n_words": 21,
      "start_frame": 2774,
      "end_frame": 2926,
      "keyframes": [
        "002812.webp",
        "002852.webp",
        "002853.webp",
        "002879.webp",
        "002905.webp",
        "002906.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ta phi thơm, bắt đầu thơm rồi đó, mùi dậy lên rồi đó.",
      "start": 117.04,
      "end": 122.48,
      "n_words": 13,
      "start_frame": 2926,
      "end_frame": 3062,
      "keyframes": [
        "002954.webp",
        "003002.webp",
        "003003.webp",
        "003032.webp",
        "003062.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cho hết cái phần tôm mà mình đã ướp ha.",
      "start": 122.48,
      "end": 125.52,
      "n_words": 10,
      "start_frame": 3062,
      "end_frame": 3138,
      "keyframes": [
        "003062.webp",
        "003063.webp",
        "003122.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ xào quả là thơm, phần tôm cũng đã săn dậy lên mùi thơm rồi.",
      "start": 125.52,
      "end": 131.64,
      "n_words": 16,
      "start_frame": 3138,
      "end_frame": 3291,
      "keyframes": [
        "003181.webp",
        "003182.webp",
        "003221.webp",
        "003260.webp",
        "003261.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hương sẽ cho vào đây một lít nước dùng để chúng ta nấu canh, sẽ vớt một ít bọt ở bên trên.",
      "start": 131.64,
      "end": 141.16,
      "n_words": 22,
      "start_frame": 3291,
      "end_frame": 3529,
      "keyframes": [
        "003318.webp",
        "003376.webp",
        "003377.webp",
        "003450.webp",
        "003523.webp",
        "003524.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cho cái phần bắp mà mình đã bào vào, và đối với món ăn ngày hôm nay thì chúng ta sẽ bào bắp dày khoảng 2 mm, không bào sát cùi để bị lẫn xơ, khi ăn thì bắp sẽ giòn và ngon hơn.",
      "start": 141.16,
      "end": 151.2,
      "n_words": 44,
      "start_frame": 3529,
      "end_frame": 3780,
      "keyframes": [
        "003552.webp",
        "003581.webp",
        "003582.webp",
        "003681.webp",
        "003780.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bắp là một nguyên liệu mà vừa làm ngọt nước nè, vừa lại có rất ít calo nên là chúng ta ăn những món ăn mà có bắp thì sẽ hỗ trợ giảm cân các bạn nhé.",
      "start": 151.2,
      "end": 158.44,
      "n_words": 37,
      "start_frame": 3780,
      "end_frame": 3961,
      "keyframes": [
        "003780.webp",
        "003781.webp",
        "003869.webp",
        "003958.webp",
        "003959.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phần lá bồ ngót trước khi nấu thì chúng ta sẽ vò sơ giúp cho rau mềm và rau bồ ngót không bị chát.",
      "start": 158.44,
      "end": 164.0,
      "n_words": 24,
      "start_frame": 3961,
      "end_frame": 4100,
      "keyframes": [
        "003995.webp",
        "004031.webp",
        "004032.webp",
        "004065.webp",
        "004098.webp",
        "004099.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Lá bồ ngót này thì có rất là nhiều chất xơ giúp cho chúng ta có thể hỗ trợ cho quá trình tiêu hóa, giúp cho mình giảm cân cũng rất là tốt.",
      "start": 164.0,
      "end": 171.12,
      "n_words": 33,
      "start_frame": 4100,
      "end_frame": 4278,
      "keyframes": [
        "004125.webp",
        "004151.webp",
        "004152.webp",
        "004216.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cho vào đây nửa muỗng cà phê bột ngọt Ajinomoto, một muỗng cà phê muối.",
      "start": 171.12,
      "end": 176.24,
      "n_words": 15,
      "start_frame": 4278,
      "end_frame": 4406,
      "keyframes": [
        "004280.webp",
        "004281.webp",
        "004294.webp",
        "004308.webp",
        "004309.webp",
        "004338.webp",
        "004367.webp",
        "004368.webp",
        "004388.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Cuối cùng Hương sẽ cho vào đây nửa muỗng canh nước mắm.",
      "start": 176.24,
      "end": 179.4,
      "n_words": 12,
      "start_frame": 4406,
      "end_frame": 4485,
      "keyframes": [
        "004409.webp",
        "004410.webp",
        "004448.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ khuấy đều lên cho gia vị được tan.",
      "start": 179.4,
      "end": 183.52,
      "n_words": 11,
      "start_frame": 4485,
      "end_frame": 4588,
      "keyframes": [
        "004487.webp",
        "004488.webp",
        "004538.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bồ ngót thì rất là nhanh chín, gần như là bỏ luôn cái là nó chín luôn rồi.",
      "start": 183.52,
      "end": 187.64,
      "n_words": 18,
      "start_frame": 4588,
      "end_frame": 4691,
      "keyframes": [
        "004589.webp",
        "004590.webp",
        "004639.webp",
        "004688.webp",
        "004689.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đúng rồi, sau khi mà chúng ta đã nêm gia vị vừa ăn vào đây rồi và nước canh sôi trở lại và bây giờ Phước Hương sẽ tắt bếp lại là xong một món canh thanh mát và rất nhanh chóng luôn.",
      "start": 187.64,
      "end": 197.96,
      "n_words": 43,
      "start_frame": 4691,
      "end_frame": 4949,
      "keyframes": [
        "004782.webp",
        "004876.webp",
        "004877.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bên cạnh món canh này là một mã QR đang xuất hiện trên màn hình, các bạn quét mã để có công thức nấu ăn của ngày hôm nay ha.",
      "start": 197.96,
      "end": 204.92,
      "n_words": 30,
      "start_frame": 4949,
      "end_frame": 5123,
      "keyframes": [
        "004977.webp",
        "005078.webp",
        "005079.webp",
        "005103.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ thì Phước Hương cũng đã chuẩn bị sẵn một cái tô với lại một ít cơm trắng để chúng ta trình bày ra món ăn, Hương sẽ múc canh ra.",
      "start": 204.92,
      "end": 223.0,
      "n_words": 32,
      "start_frame": 5123,
      "end_frame": 5575,
      "keyframes": [
        "005128.webp",
        "005129.webp",
        "005160.webp",
        "005191.webp",
        "005192.webp",
        "005249.webp",
        "005307.webp",
        "005384.webp",
        "005385.webp",
        "005386.webp",
        "005451.webp",
        "005514.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Cuối cùng Hương sẽ rắc lên trên đây một ít tiêu.",
      "start": 223.0,
      "end": 225.68,
      "n_words": 11,
      "start_frame": 5575,
      "end_frame": 5642,
      "keyframes": [
        "005578.webp",
        "005579.webp",
        "005608.webp",
        "005638.webp",
        "005639.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Không thể nhanh hơn mà nhìn cái món canh nó đơn sơ nhưng mà nó rất là hấp dẫn.",
      "start": 225.68,
      "end": 231.04,
      "n_words": 19,
      "start_frame": 5642,
      "end_frame": 5776,
      "keyframes": [
        "005727.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mời Minh Tuấn ăn thử coi nó thanh mát tới đâu.",
      "start": 231.04,
      "end": 233.44,
      "n_words": 11,
      "start_frame": 5776,
      "end_frame": 5836,
      "keyframes": [
        "005816.webp",
        "005817.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Một cái món canh mà mình nhìn vô một cái là cả cái thiên nhiên nằm trong đây.",
      "start": 233.44,
      "end": 237.64,
      "n_words": 18,
      "start_frame": 5836,
      "end_frame": 5941,
      "keyframes": [
        "005875.webp",
        "005934.webp",
        "005935.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tuyệt vời!",
      "start": 237.64,
      "end": 241.48,
      "n_words": 2,
      "start_frame": 5941,
      "end_frame": 6037,
      "keyframes": [
        "005988.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cái nước canh nó cực kỳ thanh đạm, ngọt thanh, cái phần rau ngót thì hả là nó rất là thơm mùi đặc trưng của nó, tôm thì dai ngọt thịt, cái phần bắp bỏ vào rất là tinh tế luôn.",
      "start": 241.48,
      "end": 253.8,
      "n_words": 41,
      "start_frame": 6037,
      "end_frame": 6345,
      "keyframes": [
        "006041.webp",
        "006042.webp",
        "006071.webp",
        "006101.webp",
        "006102.webp",
        "006146.webp",
        "006191.webp",
        "006192.webp",
        "006258.webp",
        "006324.webp",
        "006325.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Một cái món mà đơn giản như vậy nhưng mà Tuấn lại không ngờ nó lại cho mình một cái trải nghiệm vị giác rất là hấp dẫn luôn.",
