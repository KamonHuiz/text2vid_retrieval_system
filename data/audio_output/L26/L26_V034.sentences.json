      "end": 54.72,
      "n_words": 29,
      "start_frame": 1141,
      "end_frame": 1368,
      "keyframes": [
        "001144.webp",
        "001145.webp",
        "001257.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Em chào cô.",
      "start": 54.72,
      "end": 55.76,
      "n_words": 3,
      "start_frame": 1368,
      "end_frame": 1394,
      "keyframes": [
        "001369.webp",
        "001370.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Để Tuấn nói cho các bạn nghe, cô Thu Hà là người Tây Ninh đó.",
      "start": 56.24,
      "end": 59.08,
      "n_words": 15,
      "start_frame": 1406,
      "end_frame": 1477,
      "keyframes": [
        "001459.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Người Tây Ninh mà lại làm đầu bếp nữa, nên là cái gì là món đặc sản của vùng đó mình phải trao lại cho chính chủ.",
      "start": 59.08,
      "end": 66.4,
