      "end": 38.64,
      "n_words": 5,
      "start_frame": 899,
      "end_frame": 966,
      "keyframes": [
        "000921.webp",
        "000949.webp",
        "000950.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "À, củ sen!",
      "start": 38.64,
