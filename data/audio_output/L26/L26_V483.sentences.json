      "keyframes": [
        "003809.webp",
        "003810.webp",
        "003862.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Khi mà mình thấy bắp non và cà rốt chín vừa chín tới thì mình sẽ cho thêm đậu Hà Lan vô.",
      "start": 156.56,
