        "002203.webp",
        "002231.webp",
        "002232.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Còn phần cà rốt này thì chúng ta sẽ tỉa hoa, chúng ta sẽ cắt lát dày khoảng chừng 2 ly thôi.",
      "start": 89.48,
      "end": 94.68,
      "n_words": 22,
      "start_frame": 2237,
      "end_frame": 2367,
      "keyframes": [
        "002252.webp",
