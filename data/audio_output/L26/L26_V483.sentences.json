        "003170.webp",
        "003171.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Ớt sừng mình chỉ cắt lát để mình dọn vô trong cái nước tương ăn kèm thôi.",
      "start": 127.32,
      "end": 132.36,
