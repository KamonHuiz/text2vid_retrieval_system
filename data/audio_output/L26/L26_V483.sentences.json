        "003614.webp",
        "003615.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ nước sôi rồi, mình sẽ cho một chút xíu hạt nêm Aji-ngon nấm hương và hạt sen.",
      "start": 144.76,
      "end": 149.24,
      "n_words": 19,
      "start_frame": 3619,
      "end_frame": 3731,
      "keyframes": [
        "003629.webp",
        "003643.webp",
        "003644.webp",
        "003688.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bắp nó sẽ lâu chín nhất cho nên là cô sẽ cho bắp vô luộc trước.",
      "start": 149.24,
      "end": 152.32,
      "n_words": 16,
      "start_frame": 3731,
      "end_frame": 3808,
      "keyframes": [
        "003732.webp",
        "003733.webp",
        "003771.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bắp sôi được một lúc thì mình cho tiếp là cà rốt vô mình luộc luôn.",
      "start": 152.32,
      "end": 156.56,
      "n_words": 16,
