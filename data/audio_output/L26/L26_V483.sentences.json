      "keyframes": [
        "002676.webp",
        "002710.webp",
        "002711.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Với những món chay thường là rau củ quả nhiều màu sắc trông hấp dẫn và thưởng thức hương vị nó cũng thơm ngon nữa cô ha?",
      "start": 108.52,
      "end": 116.08,
      "n_words": 27,
      "start_frame": 2713,
      "end_frame": 2902,
      "keyframes": [
        "002755.webp",
        "002800.webp",
        "002801.webp",
        "002858.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng rồi, đối với những món ăn chay thì mình sẽ sử dụng bơ mà em thấy là trong những món ăn dưỡng sinh hay là món ăn của người Nhật, người ta cũng sử dụng cái bơ này rất là nhiều.",
      "start": 116.08,
      "end": 127.32,
      "n_words": 42,
      "start_frame": 2902,
      "end_frame": 3183,
