        "003559.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Cà chua bi thì mình sẽ cắt làm đôi.",
      "start": 142.36,
      "end": 144.76,
      "n_words": 9,
      "start_frame": 3559,
