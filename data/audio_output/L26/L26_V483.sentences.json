        "004052.webp",
        "004094.webp",
        "004095.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rồi cùng với cô, mình sẽ pha cái nước sốt để mình xào.",
      "start": 163.8,
      "end": 167.2,
      "n_words": 13,
