      "end": 251.04,
      "n_words": 17,
      "start_frame": 6209,
      "end_frame": 6276,
      "keyframes": [
        "006218.webp",
        "006263.webp",
        "006264.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn có thể theo dõi lại công thức của món ăn bằng cách là quét mã QR đang hiển thị trên màn hình.",
      "start": 251.04,
      "end": 257.48,
      "n_words": 24,
      "start_frame": 6276,
      "end_frame": 6437,
      "keyframes": [
        "006328.webp",
        "006393.webp",
        "006394.webp",
        "006418.webp"
      ],
      "keyframe_count": 4
    },
    {
