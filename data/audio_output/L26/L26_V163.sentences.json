      "n_words": 4,
      "start_frame": 262,
      "end_frame": 320,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Gan xào lá cà ri thơm đặc trưng, ngon bừng từng vị.",
      "start": 12.8,
      "end": 36.32,
      "n_words": 12,
      "start_frame": 320,
      "end_frame": 908,
      "keyframes": [
        "000361.webp",
        "000423.webp",
