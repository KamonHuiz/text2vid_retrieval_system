      "end_frame": 1406,
      "keyframes": [
        "001259.webp",
        "001359.webp",
        "001360.webp",
        "001383.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Món ăn ngày hôm nay chúng ta sẽ làm đó là món bê cuộn khìa nước dừa tươi.",
      "start": 56.24,
      "end": 59.0,
