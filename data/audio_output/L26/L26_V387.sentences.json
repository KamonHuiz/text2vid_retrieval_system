        "001670.webp",
        "001751.webp",
        "001752.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sẽ chẻ dập những trái dưa ra làm đôi.",
      "start": 70.12,
      "end": 72.04,
      "n_words": 9,
      "start_frame": 1753,
      "end_frame": 1801,
      "keyframes": [
        "001780.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mình có bí quyết gì để cho món dưa ngâm này nó được giòn ngon hơn cô?",
      "start": 72.04,
      "end": 75.52,
