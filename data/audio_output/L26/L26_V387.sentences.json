      "start_frame": 4010,
      "end_frame": 4046,
      "keyframes": [
        "004042.webp",
        "004043.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và cô đã vớt cái phần dưa ra để cho dưa thật ráo nước.",
      "start": 161.84,
      "end": 166.16,
      "n_words": 14,
      "start_frame": 4046,
      "end_frame": 4154,
      "keyframes": [
        "004094.webp",
        "004146.webp",
        "004147.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các món ngâm chua thì chúng ta cần phải làm ráo nước nguyên liệu bằng cách là chúng ta sẽ phơi nắng nè, đây thì mình sẽ chọn cái phương án là mình ướp muối đường và mình để thật ráo.",
      "start": 166.16,
      "end": 175.04,
