      "end": 160.4,
      "n_words": 8,
      "start_frame": 3973,
      "end_frame": 4010,
      "keyframes": [
        "003973.webp",
        "003974.webp",
        "004008.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi cắt đi, cảm ơn em.",
