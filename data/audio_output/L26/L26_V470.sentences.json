        "005355.webp",
        "005374.webp",
        "005375.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Thì có nhìn cái món này chiên xong hấp dẫn kinh khủng, hấp dẫn, ngon quá ngon.",
      "start": 215.04,
      "end": 221.44,
      "n_words": 17,
      "start_frame": 5376,
      "end_frame": 5536,
      "keyframes": [
        "005406.webp",
        "005438.webp",
