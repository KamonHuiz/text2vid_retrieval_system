        "003898.webp",
        "003924.webp",
        "003925.webp",
        "003938.webp",
        "003951.webp",
        "003952.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Bây giờ thì mình đã làm mình tẩm ướp mực rồi cũng như là mình khuấy bột xong.",
      "start": 158.96,
      "end": 163.04,
      "n_words": 18,
      "start_frame": 3974,
      "end_frame": 4076,
      "keyframes": [
        "003980.webp",
        "004009.webp",
        "004010.webp",
        "004055.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ Minh Tuấn hãy giúp Long là lấy một chảo dầu nha.",
      "start": 163.04,
      "end": 165.36,
      "n_words": 13,
      "start_frame": 4076,
      "end_frame": 4134,
      "keyframes": [
        "004101.webp",
        "004102.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi, ủa nhưng mà Long ơi, Tuấn thấy là mình có cái xà lách son đó nè, cái này thì mình sẽ làm cái gì Long?",
      "start": 165.36,
      "end": 170.08,
      "n_words": 26,
      "start_frame": 4134,
      "end_frame": 4252,
      "keyframes": [
        "004158.webp",
        "004214.webp",
        "004215.webp",
        "004233.webp",
        "004252.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ khi mà dầu sôi lên thì Long sẽ thấy xà lách son này Long tẩm vào bột sau đó mình thả vào chiên, cho một cái lượng vừa phải bột để áo ở trong cái phần xà lách son thôi, tại vì khi mà mình nhúng trực tiếp vào trong bột thì nó sẽ làm dày cái phần bột lên.",
      "start": 170.08,
      "end": 183.36,
      "n_words": 62,
      "start_frame": 4252,
      "end_frame": 4584,
      "keyframes": [
        "004252.webp",
        "004253.webp",
        "004270.webp",
        "004288.webp",
        "004289.webp",
        "004315.webp",
        "004341.webp",
        "004342.webp",
        "004374.webp",
        "004407.webp",
        "004408.webp",
        "004463.webp",
        "004519.webp",
        "004520.webp",
        "004549.webp",
        "004578.webp",
        "004579.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Thông thường là Tuấn thấy là người ta sẽ gọi là chiên cái món chính trước, rồi sau đó người ta mới chiên những cái phần mà trang trí hay là ăn kèm sau.",
      "start": 183.36,
      "end": 190.04,
      "n_words": 34,
      "start_frame": 4584,
      "end_frame": 4751,
      "keyframes": [
        "004614.webp",
        "004650.webp",
        "004651.webp",
        "004684.webp",
        "004718.webp",
        "004719.webp",
        "004736.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Nhưng bên này Tuấn thấy là Long chiên cái phần rau trước không biết là Long có ý gì hay không?",
      "start": 190.04,
      "end": 193.68,
      "n_words": 21,
      "start_frame": 4751,
      "end_frame": 4842,
      "keyframes": [
        "004754.webp",
        "004755.webp",
        "004775.webp",
        "004796.webp",
        "004797.webp",
        "004820.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tranh thủ mà lúc mà dầu nó còn rất là trong, rất là đẹp thì mình sẽ chiên rau này, có nghĩa là mình sẽ chiên trước bởi vì lúc đó thì cái dầu của mình nó vẫn còn chưa có bị thay đổi màu đúng không?",
      "start": 193.68,
      "end": 203.16,
      "n_words": 47,
      "start_frame": 4842,
      "end_frame": 5079,
      "keyframes": [
        "004843.webp",
        "004844.webp",
        "004892.webp",
        "004940.webp",
        "004941.webp",
        "005015.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi, thì cái phần trang trí của mình nó sẽ ra đúng cái màu của nó và nó sẽ đẹp hơn.",
      "start": 203.16,
      "end": 207.92,
      "n_words": 22,
      "start_frame": 5079,
      "end_frame": 5198,
      "keyframes": [
        "005090.webp",
