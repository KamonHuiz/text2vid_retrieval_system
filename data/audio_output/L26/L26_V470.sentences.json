        "003618.webp",
        "003639.webp",
        "003640.webp",
        "003664.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bây giờ thì bột đã có một cái độ sánh sệt vừa phải.",
      "start": 147.52,
      "end": 151.08,
      "n_words": 13,
      "start_frame": 3688,
      "end_frame": 3777,
      "keyframes": [
        "003689.webp",
        "003690.webp",
        "003734.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Long cho vào đây một muỗng canh nước cam để cho tăng hương vị món ăn lên và một muỗng cà phê ngò tây và mình khuấy đều lên.",
      "start": 151.08,
      "end": 158.96,
      "n_words": 29,
      "start_frame": 3777,
      "end_frame": 3974,
      "keyframes": [
        "003779.webp",
