        "005493.webp",
        "005494.webp",
        "005514.webp",
        "005535.webp",
        "005536.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Có nghe mùi cam không?",
      "start": 221.44,
      "end": 222.36,
      "n_words": 5,
      "start_frame": 5536,
      "end_frame": 5559,
      "keyframes": [
        "005536.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nhưng mà phải có cái sốt cam rồi.",
      "start": 222.36,
      "end": 223.88,
      "n_words": 8,
      "start_frame": 5559,
