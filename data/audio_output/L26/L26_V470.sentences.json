  "n_sentences": 55,
  "total_words": 943,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.52,
      "end": 12.12,
      "n_words": 4,
      "start_frame": 263,
      "end_frame": 303,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ủa Long, dắt cam hả?",
      "start": 12.12,
      "end": 15.08,
      "n_words": 5,
      "start_frame": 303,
      "end_frame": 377,
      "keyframes": [
        "000335.webp",
        "000371.webp",
        "000372.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trời tính đem cam qua cho Long mà có cam thôi.",
      "start": 15.08,
      "end": 17.12,
      "n_words": 11,
      "start_frame": 377,
      "end_frame": 428,
      "keyframes": [
        "000395.webp",
        "000419.webp",
        "000420.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đi về, ô đi đâu, đi đâu?",
      "start": 17.12,
      "end": 18.12,
      "n_words": 7,
      "start_frame": 428,
      "end_frame": 453,
      "keyframes": [
        "000434.webp",
        "000449.webp",
        "000450.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đâu, vô đây chứ sao?",
      "start": 18.12,
      "end": 20.04,
      "n_words": 5,
      "start_frame": 453,
      "end_frame": 501,
      "keyframes": [
        "000462.webp",
        "000474.webp",
        "000475.webp",
        "000479.webp",
        "000484.webp",
        "000485.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cam này là Long chắc con uống.",
      "start": 20.04,
      "end": 21.64,
      "n_words": 7,
      "start_frame": 501,
      "end_frame": 541,
      "keyframes": [
        "000516.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Còn Tuấn đem tới thì mình làm cái khác.",
      "start": 21.64,
      "end": 23.52,
      "n_words": 9,
      "start_frame": 541,
      "end_frame": 588,
      "keyframes": [
        "000548.webp",
        "000549.webp",
        "000569.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Làm cái khác là làm gì?",
      "start": 23.52,
      "end": 24.84,
      "n_words": 6,
      "start_frame": 588,
      "end_frame": 621,
      "keyframes": [
        "000590.webp",
        "000591.webp",
        "000618.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ủa, nấu ăn cũng được vậy?",
      "start": 24.84,
      "end": 26.16,
      "n_words": 6,
      "start_frame": 621,
      "end_frame": 654,
      "keyframes": [
        "000646.webp",
        "000647.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ồ, được được.",
      "start": 26.16,
      "end": 27.68,
      "n_words": 3,
      "start_frame": 654,
      "end_frame": 692,
      "keyframes": [
        "000678.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tự nhiên cái gọi là trùng hợp hai đứa đều có cam hết, vậy thì mình sẽ nấu một món ăn ngon với cam, mình nhâm nhi với lại nước cam, quá chuẩn luôn.",
      "start": 27.68,
      "end": 35.84,
      "n_words": 34,
      "start_frame": 692,
      "end_frame": 896,
      "keyframes": [
        "000709.webp",
        "000710.webp",
        "000788.webp",
        "000866.webp",
        "000867.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bắt tay làm thôi: mực chiên giòn sốt cam. Chào quý vị và các bạn đã quay trở lại với chương trình Món ngon mỗi ngày.",
      "start": 35.84,
      "end": 59.04,
      "n_words": 26,
      "start_frame": 896,
      "end_frame": 1476,
      "keyframes": [
        "000898.webp",
        "000929.webp",
        "000930.webp",
        "000954.webp",
        "000979.webp",
        "000980.webp",
        "001008.webp",
        "001037.webp",
        "001038.webp",
        "001088.webp",
        "001139.webp",
        "001159.webp",
        "001209.webp",
        "001260.webp",
        "001261.webp",
        "001348.webp",
        "001436.webp",
        "001437.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Chương trình Món ngon mỗi ngày được sự tài trợ của công ty Ajinomoto Việt Nam.",
      "start": 59.04,
      "end": 63.76,
      "n_words": 16,
      "start_frame": 1476,
      "end_frame": 1594,
      "keyframes": [
        "001510.webp",
        "001584.webp",
        "001585.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mực thì rất là tươi nha, mình đã làm mình để thật là ráo.",
      "start": 63.76,
      "end": 67.12,
      "n_words": 14,
      "start_frame": 1594,
      "end_frame": 1678,
      "keyframes": [
        "001628.webp",
        "001671.webp",
        "001672.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đối với mực thì bây giờ Long sẽ cắt khứa.",
      "start": 67.12,
      "end": 69.92,
      "n_words": 10,
      "start_frame": 1678,
      "end_frame": 1748,
      "keyframes": [
        "001711.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Khi mình khứa như vậy thì cái phần bột cũng như gia vị nó sẽ thấm vào bên trong con mực nha.",
      "start": 69.92,
      "end": 74.4,
      "n_words": 22,
      "start_frame": 1748,
      "end_frame": 1860,
      "keyframes": [
        "001751.webp",
        "001752.webp",
        "001821.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ mình sẽ khứa, nhìn khứa mực mà cảm giác đê mê luôn.",
      "start": 74.4,
      "end": 78.16,
      "n_words": 14,
      "start_frame": 1860,
      "end_frame": 1954,
      "keyframes": [
        "001890.webp",
        "001891.webp",
        "001915.webp",
        "001939.webp",
        "001940.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thay vì khứa nhiều quá, Ủa sao mình phải khứa mà nhuyễn rồi khứa dọc này rồi lật lại lật kia để mà mình khứa thành hình caro như vậy hả Long? Khi mình khứa mực caro như vậy thì phần mực sẽ dễ dàng tẩm bột hơn.",
      "start": 78.16,
      "end": 91.56,
      "n_words": 48,
      "start_frame": 1954,
      "end_frame": 2289,
      "keyframes": [
        "001989.webp",
        "002038.webp",
        "002039.webp",
        "002079.webp",
        "002119.webp",
        "002120.webp",
        "002205.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rồi bây giờ này, mà Tuấn hả, mình sẽ cắt que tùy là Minh Tuấn thích ăn dài hay ngắn nha.",
      "start": 91.56,
      "end": 101.28,
      "n_words": 21,
      "start_frame": 2289,
      "end_frame": 2532,
      "keyframes": [
        "002290.webp",
        "002291.webp",
        "002302.webp",
        "002314.webp",
        "002315.webp",
        "002354.webp",
        "002393.webp",
        "002394.webp",
        "002412.webp",
        "002430.webp",
        "002431.webp",
        "002462.webp",
        "002494.webp",
        "002495.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Phần mực thì mình đã cắt ra thì bây giờ mình sẽ băm nhuyễn hành tây trước.",
      "start": 101.28,
      "end": 104.64,
      "n_words": 17,
      "start_frame": 2532,
      "end_frame": 2616,
      "keyframes": [
        "002534.webp",
        "002574.webp",
        "002575.webp",
        "002592.webp",
        "002610.webp",
        "002611.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Khi mình tẩm ướp mình sẽ bỏ mấy cái phần mà gốc to đi đúng không?",
      "start": 104.64,
      "end": 108.12,
      "n_words": 16,
      "start_frame": 2616,
      "end_frame": 2703,
      "keyframes": [
        "002695.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nó hơi cứng thì mình sẽ bỏ, mình lấy phần lá để mình tạo mùi thơm.",
      "start": 108.12,
      "end": 112.08,
      "n_words": 16,
      "start_frame": 2703,
      "end_frame": 2802,
      "keyframes": [
        "002780.webp",
        "002781.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Mình sẽ băm nhuyễn, mình sẽ ướp mực nha Minh Tuấn.",
      "start": 112.08,
      "end": 121.92,
      "n_words": 11,
      "start_frame": 2802,
      "end_frame": 3048,
      "keyframes": [
        "002838.webp",
        "002896.webp",
        "002897.webp",
        "002918.webp",
        "002939.webp",
        "002940.webp",
        "002958.webp",
        "002977.webp",
        "002978.webp",
        "003007.webp",
        "003037.webp",
        "003038.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Long sẽ cho đây là một muỗng canh rượu trắng.",
      "start": 121.92,
      "end": 124.44,
      "n_words": 10,
      "start_frame": 3048,
      "end_frame": 3111,
      "keyframes": [
        "003069.webp",
        "003101.webp",
        "003102.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rượu trắng sẽ giúp khử đi cái mùi tanh của mực.",
      "start": 124.44,
      "end": 127.04,
      "n_words": 11,
      "start_frame": 3111,
      "end_frame": 3176,
      "keyframes": [
        "003139.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Một muỗng cà phê tiêu, một muỗng cà phê hạt nêm Aji-ngon heo, trộn đều lên.",
      "start": 127.04,
      "end": 134.48,
      "n_words": 16,
      "start_frame": 3176,
      "end_frame": 3362,
      "keyframes": [
        "003177.webp",
        "003178.webp",
        "003196.webp",
        "003214.webp",
        "003215.webp",
        "003249.webp",
        "003283.webp",
        "003284.webp",
        "003305.webp",
        "003327.webp",
        "003328.webp",
        "003348.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Bây giờ Long sẽ dùng một muỗng canh bột chiên giòn mình cho vào mực, trộn đều lên.",
      "start": 134.48,
      "end": 141.6,
      "n_words": 18,
      "start_frame": 3362,
      "end_frame": 3540,
      "keyframes": [
        "003368.webp",
        "003369.webp",
        "003410.webp",
        "003451.webp",
        "003452.webp",
        "003497.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần bột còn lại thì mình sẽ pha với nước vừa đủ độ sệt để mình tẩm mực chiên.",
      "start": 141.6,
      "end": 147.52,
      "n_words": 19,
      "start_frame": 3540,
      "end_frame": 3688,
      "keyframes": [
        "003543.webp",
        "003544.webp",
        "003570.webp",
        "003597.webp",
