        "000325.webp",
        "000350.webp",
        "000351.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ủa nhưng mà anh thích ăn khoai lang luôn?",
      "start": 14.72,
      "end": 16.16,
      "n_words": 9,
      "start_frame": 368,
      "end_frame": 404,
      "keyframes": [
        "000395.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Để Phước đem đi luộc cho. Gì?",
