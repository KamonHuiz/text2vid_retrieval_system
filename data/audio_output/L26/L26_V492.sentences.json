      "end": 18.28,
      "n_words": 7,
      "start_frame": 404,
      "end_frame": 457,
      "keyframes": [
        "000439.webp",
        "000440.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ủa tự nhiên cái đầu bếp thiên tài cứ đem luộc khoai?",
      "start": 18.28,
      "end": 20.8,
      "n_words": 12,
      "start_frame": 457,
      "end_frame": 520,
      "keyframes": [
        "000480.webp",
        "000520.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khoai lang đem đi luộc thì hơi thường đúng không?",
