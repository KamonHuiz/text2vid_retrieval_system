        "002207.webp",
        "002224.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Cái hỗn hợp bột này Phước Hương sẽ để bột sang một bên.",
      "start": 89.28,
      "end": 94.4,
      "n_words": 13,
