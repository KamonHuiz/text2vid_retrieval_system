        "001760.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ Phước Hương sẽ cho khoai lang vào, bây giờ chúng ta sẽ tán thật là mịn nè.",
      "start": 71.64,
      "end": 76.6,
