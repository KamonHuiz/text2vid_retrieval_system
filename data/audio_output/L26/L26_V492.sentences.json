        "002561.webp",
        "002582.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Tiếp theo đó Phước Hương sẽ cho 30 g bơ lạt, 50 g mật ong và 70 g kem béo.",
      "start": 104.0,
      "end": 110.08,
