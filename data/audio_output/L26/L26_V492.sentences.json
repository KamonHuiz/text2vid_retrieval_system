        "002861.webp",
        "002886.webp",
        "002887.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Công nhận khoai lang tím lúc nào cũng cho ra những cái món ăn mà có màu sắc rất là hài hòa.",
      "start": 115.56,
