        "002363.webp",
        "002364.webp",
        "002395.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đặt lên trên bếp một cái chảo để chúng ta xào, nhưng đầu tiên Hương sẽ cho vào đây là 200 g khoai lang.",
      "start": 97.0,
