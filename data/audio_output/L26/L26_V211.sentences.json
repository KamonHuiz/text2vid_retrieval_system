        "002820.webp",
        "002821.webp",
        "002852.webp",
        "002884.webp",
        "002885.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi cô cũng pha bột xong rồi nè, em đặt lên nè, em đặt lên trên bếp cho cô một cái chảo dầu để mình chiên nha, mình chờ dầu nóng nha.",
      "start": 115.52,
      "end": 121.84,
      "n_words": 32,
      "start_frame": 2888,
      "end_frame": 3046,
      "keyframes": [
        "002906.webp",
        "002927.webp",
        "002928.webp",
        "002945.webp",
        "002962.webp",
        "002963.webp",
        "002987.webp",
        "003012.webp",
        "003013.webp",
        "003034.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Rồi cái phần bột này thì mình sẽ trộn đều với cá, cá nó sẽ có một cái lớp bột khô mỏng mỏng bên ngoài, còn cái phần bột nước này nè bây giờ cô sẽ cho vào đây khoảng chừng một muỗng canh mè.",
      "start": 121.84,
      "end": 131.52,
      "n_words": 45,
      "start_frame": 3046,
      "end_frame": 3288,
      "keyframes": [
