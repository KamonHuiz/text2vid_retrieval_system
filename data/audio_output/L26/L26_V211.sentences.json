        "000605.webp",
        "000606.webp",
        "000696.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày, nấu chuẩn ăn lành.",
      "start": 29.56,
