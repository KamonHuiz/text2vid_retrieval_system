      "start_frame": 3490,
      "end_frame": 3798,
      "keyframes": [
        "003643.webp",
        "003797.webp",
        "003798.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Giờ mình sẽ bỏ một nửa cá vô trong cái phần bột này trộn cho nó thấm bột, sau đó thì mình sẽ lấy từng con cá mình bỏ vô trong cái chảo dầu mình chiên.",
      "start": 151.92,
      "end": 159.64,
      "n_words": 36,
      "start_frame": 3798,
      "end_frame": 3991,
      "keyframes": [
