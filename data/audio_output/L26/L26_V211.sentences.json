        "001959.webp",
        "001996.webp",
        "002034.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Ướp cá với lại một muỗng canh nước cốt tắc, trộn đều phần cá.",
      "start": 81.36,
      "end": 85.28,
