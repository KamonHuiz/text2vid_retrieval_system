        "002307.webp",
        "002348.webp",
        "002349.webp",
        "002377.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bây giờ thì chúng ta sẽ chuẩn bị bột, chúng ta sẽ dùng gia vị nêm sẵn Ajinomoto bột chiên giòn.",
      "start": 95.16,
      "end": 100.64,
      "n_words": 21,
      "start_frame": 2379,
      "end_frame": 2516,
      "keyframes": [
        "002405.webp",
        "002406.webp",
        "002459.webp",
        "002512.webp",
        "002513.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đầu tiên là chúng ta sẽ lấy ra chừng hai muỗng canh ướp với lại phần cá, phần còn lại thì chúng ta sẽ cho vào tô để pha với nước.",
      "start": 100.64,
      "end": 109.08,
      "n_words": 31,
      "start_frame": 2516,
      "end_frame": 2727,
      "keyframes": [
        "002536.webp",
