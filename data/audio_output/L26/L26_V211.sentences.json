        "004281.webp",
        "004282.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ra đi rồi ráo dầu.",
      "start": 172.0,
      "end": 173.96,
      "n_words": 5,
      "start_frame": 4300,
      "end_frame": 4349,
      "keyframes": [
        "004315.webp",
        "004348.webp",
        "004349.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ thì chúng ta sẽ pha sốt mắm, sẽ pha sốt mắm tắc để ăn kèm.",
      "start": 173.96,
      "end": 177.28,
      "n_words": 17,
      "start_frame": 4349,
      "end_frame": 4432,
      "keyframes": [
        "004349.webp",
        "004389.webp",
