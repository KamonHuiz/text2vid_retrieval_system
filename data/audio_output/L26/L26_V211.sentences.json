        "003258.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Phần bột của chúng ta sẽ có lấm tấm mè đen nhìn sẽ đẹp mắt hơn.",
      "start": 131.52,
      "end": 135.96,
      "n_words": 16,
      "start_frame": 3288,
      "end_frame": 3399,
      "keyframes": [
        "003341.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cô Hà ha đúng rồi, và thực ra thì nó cũng thêm cái dinh dưỡng nữa đó em.",
      "start": 135.96,
      "end": 139.6,
      "n_words": 18,
      "start_frame": 3399,
      "end_frame": 3490,
      "keyframes": [
        "003424.webp",
        "003425.webp",
        "003456.webp",
        "003488.webp",
        "003489.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trong cá này có nhiều vitamin A nè, vitamin này là những vitamin nó tan trong chất béo cho nên là nếu như mà mình sử dụng cái phương pháp chiên thì cơ thể chúng ta sẽ hấp thụ cái cá này tốt hơn.",
