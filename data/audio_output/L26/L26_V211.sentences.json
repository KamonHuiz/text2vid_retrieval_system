        "001246.webp",
        "001247.webp",
        "001391.webp",
        "001535.webp",
        "001536.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Mình sẽ bỏ cái phần đầu đi và mình sẽ nặn bỏ bớt cái phần ruột ở trong bụng cá.",
      "start": 61.44,
