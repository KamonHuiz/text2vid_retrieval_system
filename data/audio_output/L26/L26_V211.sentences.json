        "001572.webp",
        "001613.webp",
        "001654.webp",
        "001655.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đầu tiên thì chúng ta sẽ ướp vào đây nửa muỗng cà phê tiêu, trộn đều lên.",
      "start": 66.24,
      "end": 70.24,
