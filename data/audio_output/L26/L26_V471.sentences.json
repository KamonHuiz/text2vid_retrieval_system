        "002451.webp",
        "002472.webp",
        "002494.webp",
        "002495.webp",
        "002516.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Giai đoạn tiếp theo thì Phước Hưng sẽ hướng dẫn cho quý vị chúng ta sơ chế phần nhân.",
      "start": 101.28,
      "end": 105.44,
      "n_words": 19,
