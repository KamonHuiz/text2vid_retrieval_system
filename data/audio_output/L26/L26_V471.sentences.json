        "000916.webp",
        "000935.webp",
        "000936.webp",
        "001000.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vào bếp đây sẽ có một câu tuyệt vời, rồi để coi sao nha.",
      "start": 40.64,
      "end": 46.6,
      "n_words": 14,
      "start_frame": 1016,
      "end_frame": 1165,
      "keyframes": [
        "001065.webp",
