      "keyframes": [
        "002933.webp",
        "002960.webp",
        "002961.webp",
        "002996.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Được chứ, nhưng mà giò sống sẽ không có độ dai và ngon như cá thác lác.",
      "start": 120.88,
      "end": 124.84,
      "n_words": 17,
