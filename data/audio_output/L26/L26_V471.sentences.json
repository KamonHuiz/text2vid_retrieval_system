        "003786.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Công đoạn tiếp theo thì Phương sẽ hướng dẫn cho quý vị chúng ta sẽ tạo hình cho món ăn.",
      "start": 152.04,
