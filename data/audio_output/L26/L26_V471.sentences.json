        "002053.webp",
        "002054.webp",
        "002078.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta sẽ trần cọng cải thảo qua nước sôi để giúp cho cải mềm, sẽ dễ tạo hình hơn.",
      "start": 83.96,
      "end": 88.32,
      "n_words": 20,
      "start_frame": 2099,
      "end_frame": 2208,
      "keyframes": [
        "002102.webp",
        "002103.webp",
        "002156.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sau khi mà quý vị chúng ta cho phần cọng cứng vào trong nước sôi rồi thì chúng ta luộc.",
      "start": 88.32,
      "end": 92.36,
      "n_words": 20,
      "start_frame": 2208,
      "end_frame": 2309,
      "keyframes": [
        "002210.webp",
        "002211.webp",
        "002305.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Quý vị lưu ý, chúng ta thấy có cái độ trong của cải là được, là cải đã dẻo rồi.",
      "start": 92.36,
      "end": 96.0,
      "n_words": 20,
      "start_frame": 2309,
      "end_frame": 2400,
      "keyframes": [
        "002400.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tiếp theo chúng ta sẽ cho hết cái phần lá vào luôn, cho sôi trở lại và vớt ra ngay, màu đẹp hết trơn.",
      "start": 96.0,
      "end": 101.28,
      "n_words": 24,
