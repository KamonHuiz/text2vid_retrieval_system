      "end": 116.48,
      "n_words": 7,
      "start_frame": 2855,
      "end_frame": 2912,
      "keyframes": [
        "002879.webp",
        "002905.webp",
        "002906.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cái phần nhân này mình không dùng cá thác lác, mình vẫn dùng giò sống như các món khác được không Phương?",
      "start": 116.48,
