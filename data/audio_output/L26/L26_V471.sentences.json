        "003076.webp",
        "003119.webp",
        "003120.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ chúng ta sẽ quết cho cái cá thác lác này nó dai nè.",
      "start": 124.84,
      "end": 127.88,
      "n_words": 15,
