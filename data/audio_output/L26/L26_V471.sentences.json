  "total_words": 1050,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.56,
      "end": 13.24,
      "n_words": 4,
      "start_frame": 264,
      "end_frame": 331,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trời đất ơi, sủi cảo nè!",
      "start": 13.24,
      "end": 15.56,
      "n_words": 6,
      "start_frame": 331,
      "end_frame": 389,
      "keyframes": [
        "000347.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trời, kỳ vậy sao lạ vậy sao?",
      "start": 15.56,
      "end": 17.68,
      "n_words": 7,
      "start_frame": 389,
      "end_frame": 442,
      "keyframes": [
        "000395.webp",
        "000396.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bữa nay thấy cái gì cũng thèm hết trơn vậy, bởi vậy tự nhiên lạc miệng, muốn ăn cái gì với nước tương ghê luôn.",
