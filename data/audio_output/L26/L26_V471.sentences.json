        "001481.webp",
        "001482.webp",
        "001569.webp",
        "001657.webp",
        "001658.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Chào các bạn đang đến với chương trình Món ngon mỗi ngày, chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 66.44,
      "end": 72.92,
      "n_words": 23,
      "start_frame": 1661,
      "end_frame": 1823,
      "keyframes": [
        "001743.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên Phước Hưng sẽ bắc lên trên bếp một cái chảo nước để chúng ta trần sơ qua cái phần bắp cải thảo.",
      "start": 72.92,
      "end": 77.68,
      "n_words": 24,
      "start_frame": 1823,
      "end_frame": 1942,
      "keyframes": [
        "001829.webp",
        "001830.webp",
        "001886.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phần bắp cải thảo này rất là đơn giản thôi, ở đây Phước Hưng sẽ cắt ra thành ba đoạn đều nhau, cho vào trong nước trần một ít muối.",
      "start": 77.68,
      "end": 83.96,
      "n_words": 30,
      "start_frame": 1942,
      "end_frame": 2099,
