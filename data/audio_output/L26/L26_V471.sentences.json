        "001090.webp",
        "001114.webp",
        "001115.webp",
        "001139.webp",
        "001164.webp",
        "001165.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cải thảo cuộn tôm cá ngọt thơm trọn vị mến.",
      "start": 46.6,
      "end": 66.44,
      "n_words": 10,
      "start_frame": 1165,
      "end_frame": 1661,
      "keyframes": [
        "001165.webp",
