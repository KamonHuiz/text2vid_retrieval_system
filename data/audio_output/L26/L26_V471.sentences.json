        "002580.webp",
        "002606.webp",
        "002632.webp",
        "002633.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Phần tôm này chúng ta rửa sạch và bỏ đầu bỏ đuôi, lột vỏ hết và chúng ta lấy cái phần chỉ lưng.",
      "start": 105.44,
      "end": 110.76,
      "n_words": 23,
      "start_frame": 2636,
      "end_frame": 2769,
      "keyframes": [
        "002697.webp",
        "002761.webp",
        "002762.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ chúng ta sẽ cắt hạt lựu, sẽ bỏ vô một cái tô.",
      "start": 110.76,
      "end": 114.2,
      "n_words": 14,
      "start_frame": 2769,
