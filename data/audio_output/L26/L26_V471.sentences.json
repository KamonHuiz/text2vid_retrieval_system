      "end": 22.44,
      "n_words": 25,
      "start_frame": 442,
      "end_frame": 561,
      "keyframes": [
        "000443.webp",
        "000490.webp",
        "000491.webp",
        "000537.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Á vậy là thèm nước tương rồi chứ đâu phải thèm món ăn đúng không?",
      "start": 22.44,
      "end": 25.24,
      "n_words": 15,
      "start_frame": 561,
      "end_frame": 631,
      "keyframes": [
        "000583.webp",
        "000584.webp",
        "000608.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nước tương thì dễ rồi, món ăn mới là quan trọng chứ.",
      "start": 25.24,
      "end": 27.6,
      "n_words": 12,
      "start_frame": 631,
      "end_frame": 690,
      "keyframes": [
        "000633.webp",
        "000634.webp",
        "000660.webp",
        "000686.webp",
        "000687.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ cho chai nước tương xách mang về, rồi giờ cho 10 chai nước tương luôn, nhưng mà phải cho tôi là cái gì có Bữa nay Hương có cải thảo nè, cải thảo không?",
      "start": 27.6,
      "end": 35.16,
      "n_words": 36,
      "start_frame": 690,
      "end_frame": 879,
      "keyframes": [
        "000710.webp",
        "000734.webp",
        "000735.webp",
        "000766.webp",
        "000797.webp",
        "000798.webp",
        "000819.webp",
        "000841.webp",
        "000842.webp",
        "000869.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Nước tương bình thường quá, đơn giản không bao giờ mà Phước Hưng tặng cho ai một cái món ăn mà bình thường hết trơn á.",
      "start": 35.44,
