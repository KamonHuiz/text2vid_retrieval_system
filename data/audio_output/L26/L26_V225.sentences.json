        "004485.webp",
        "004486.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Xếp những cái que sườn lên trên vỉ nướng này, hấp dẫn chưa?",
      "start": 179.52,
      "end": 183.08,
      "n_words": 13,
