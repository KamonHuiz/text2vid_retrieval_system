        "004010.webp",
        "004042.webp",
        "004043.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Rồi chúng ta sẽ dùng muỗng khuấy đều cho tất cả gia vị này nó tan vào nhau.",
      "start": 161.88,
      "end": 167.56,
