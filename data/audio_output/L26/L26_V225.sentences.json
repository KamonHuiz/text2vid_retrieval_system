      "n_words": 19,
      "start_frame": 4577,
      "end_frame": 4701,
      "keyframes": [
        "004642.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ chúng ta sẽ nướng sườn ở nhiệt độ là 180 độ, thời gian nướng là 20 phút.",
      "start": 188.04,
      "end": 192.4,
