        "004994.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Khoai tây thì Thanh Phương cũng đã để ráo rồi để khi mà chúng ta chiên không bị bắn dầu nhé.",
      "start": 199.76,
