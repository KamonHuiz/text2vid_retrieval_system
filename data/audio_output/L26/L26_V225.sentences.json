        "000577.webp",
        "000578.webp",
        "000668.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Rất vui khi được gặp lại các bạn khán giả đang theo dõi chương trình Món ngon mỗi ngày.",
      "start": 30.24,
