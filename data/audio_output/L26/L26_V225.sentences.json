      "keyframes": [
        "002104.webp",
        "002105.webp",
        "002157.webp",
        "002209.webp",
        "002210.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và trong thịt sườn thì có đến 70% là lượng protein, ngoài ra còn có thêm một số những cái dinh dưỡng khác như là canxi, magie, kali và cả vitamin B, vì vậy rất là tốt cho sức khỏe đấy ạ.",
      "start": 88.4,
      "end": 101.32,
      "n_words": 42,
      "start_frame": 2210,
      "end_frame": 2533,
      "keyframes": [
        "002210.webp",
        "002260.webp",
        "002311.webp",
        "002312.webp",
        "002349.webp",
        "002387.webp",
        "002388.webp",
        "002421.webp",
        "002454.webp",
        "002455.webp",
        "002456.webp",
        "002458.webp",
        "002459.webp",
        "002509.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Xong cái phần sườn, và với món sườn nướng này thì chúng ta ăn kèm với khoai tây là hết ý.",
      "start": 101.32,
