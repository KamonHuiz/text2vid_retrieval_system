        "000999.webp",
        "001032.webp",
        "001033.webp",
        "001162.webp",
        "001291.webp",
        "001292.webp",
        "001315.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và trong ẩm thực Việt Nam thì có đến ba loại tiêu đó là tiêu xanh, tiêu đen và tiêu trắng.",
      "start": 53.44,
      "end": 58.08,
      "n_words": 21,
      "start_frame": 1336,
      "end_frame": 1452,
      "keyframes": [
        "001338.webp",
        "001339.webp",
        "001450.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vì vậy hôm nay chúng ta sẽ cùng nhau thực hiện một món ăn mà kết hợp với cả ba loại tiêu đó luôn nhé.",
      "start": 58.08,
      "end": 62.52,
      "n_words": 25,
      "start_frame": 1452,
      "end_frame": 1563,
      "keyframes": [
        "001562.webp",
        "001563.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và đặc biệt, sự kết hợp giữa ba loại tiêu nó sẽ tạo ra cái mùi thơm đặc trưng cho món nướng của chúng ta đó.",
      "start": 62.52,
      "end": 68.04,
      "n_words": 26,
      "start_frame": 1563,
      "end_frame": 1701,
      "keyframes": [
        "001563.webp",
        "001600.webp",
        "001637.webp",
        "001638.webp",
        "001668.webp",
        "001698.webp",
        "001699.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Và nguyên liệu chính cho món ăn ngày hôm nay Quốc Nghị sẽ chọn là sườn non.",
      "start": 68.04,
      "end": 71.4,
      "n_words": 17,
      "start_frame": 1701,
      "end_frame": 1785,
      "keyframes": [
        "001754.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn sẽ chặt khoảng khúc khoảng 10 cm như thế này.",
      "start": 72.12,
      "end": 75.76,
      "n_words": 12,
      "start_frame": 1803,
      "end_frame": 1894,
      "keyframes": [
        "001809.webp",
        "001810.webp",
        "001849.webp",
        "001889.webp",
        "001890.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sau đó chúng ta dùng mũi dao nè, cái phần mỏng của sườn này chúng ta dùng mũi dao chúng ta sẽ khía một đường dọc cái sườn như thế này này.",
      "start": 75.76,
      "end": 82.96,
      "n_words": 32,
      "start_frame": 1894,
      "end_frame": 2074,
      "keyframes": [
        "001912.webp",
        "001935.webp",
        "001936.webp",
        "002020.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đó, việc Quốc Nghị khía dọc miếng sườn giúp khi thưởng thức nó sẽ dễ dàng hơn đó.",
      "start": 82.96,
