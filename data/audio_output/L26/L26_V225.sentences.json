        "005056.webp",
        "005080.webp",
        "005081.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Và để khoai tây chiên được giòn ngon hơn thì các bạn nhớ là chúng ta phải chiên hai lần nhé.",
      "start": 204.0,
