        "003414.webp",
        "003437.webp",
        "003438.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Một muỗng cà phê bột hành, một muỗng cà phê bột tỏi.",
      "start": 137.64,
      "end": 140.76,
      "n_words": 12,
