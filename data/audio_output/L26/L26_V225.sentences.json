        "003241.webp",
        "003276.webp",
        "003277.webp",
        "003305.webp",
        "003333.webp",
        "003334.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nửa hũ sữa chua có đường giúp sườn chúng ta mềm, béo và ngon hơn.",
      "start": 133.44,
      "end": 137.64,
