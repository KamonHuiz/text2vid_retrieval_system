        "005990.webp",
        "006027.webp",
        "006028.webp",
        "006073.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi em tắt lửa giúp cô đi.",
      "start": 243.12,
      "end": 244.84,
      "n_words": 7,
      "start_frame": 6078,
      "end_frame": 6121,
      "keyframes": [
