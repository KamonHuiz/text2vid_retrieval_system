        "000967.webp",
        "000968.webp",
        "001002.webp"
      ],
      "keyframe_count": 25
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày - Nấu chuẩn ăn lành.",
      "start": 41.28,
      "end": 45.32,
      "n_words": 18,
      "start_frame": 1032,
      "end_frame": 1133,
      "keyframes": [
        "001037.webp",
        "001038.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam. Em chào cô! Chào mừng Tuấn.",
      "start": 45.32,
      "end": 50.44,
      "n_words": 17,
      "start_frame": 1133,
      "end_frame": 1261,
      "keyframes": [
        "001160.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cô ơi bây giờ cô biết một cái xu thế không, là xu thế chữa lành?",
      "start": 50.44,
      "end": 54.68,
      "n_words": 16,
      "start_frame": 1261,
      "end_frame": 1367,
      "keyframes": [
        "001282.webp",
        "001283.webp",
        "001312.webp",
        "001341.webp",
        "001342.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ai cũng cần đi chữa lành và sắp tới là mùa mưa, em nghĩ là người ta cần chữa lành nhiều.",
      "start": 54.68,
      "end": 59.04,
      "n_words": 21,
      "start_frame": 1367,
      "end_frame": 1476,
      "keyframes": [
        "001395.webp",
        "001449.webp",
        "001450.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chữa lành nhiều, chữa lành tâm hồn khi mà trời đang mưa nè, lãng đãng nên thơ nè.",
      "start": 59.04,
      "end": 63.88,
      "n_words": 18,
      "start_frame": 1476,
      "end_frame": 1597,
      "keyframes": [
        "001522.webp",
        "001594.webp",
        "001595.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó, bây giờ cô làm một cái món nào đó mà để chữa lành cả tâm hồn lẫn thể chất đi cô.",
      "start": 63.88,
      "end": 70.4,
      "n_words": 22,
      "start_frame": 1597,
      "end_frame": 1760,
      "keyframes": [
        "001622.webp",
        "001649.webp",
        "001650.webp",
        "001673.webp",
        "001696.webp",
        "001697.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Được rồi, thôi thì món ăn này sẽ chữa lành bởi vì sao nó rất là dễ làm mà nó rất là ngon nữa nè, đúng không?",
      "start": 70.4,
      "end": 78.08,
      "n_words": 27,
      "start_frame": 1760,
      "end_frame": 1952,
      "keyframes": [
        "001845.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "À, có thể là ăn vào lúc nào cũng được hết.",
      "start": 78.08,
      "end": 80.24,
      "n_words": 11,
      "start_frame": 1952,
      "end_frame": 2006,
      "keyframes": [
        "001993.webp",
        "001994.webp",
        "002001.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Á, hôm nay thì chúng ta cùng nhau thực hiện một món súp nha: súp gà mọc nấm hương.",
      "start": 80.24,
      "end": 84.68,
      "n_words": 19,
      "start_frame": 2006,
      "end_frame": 2117,
      "keyframes": [
        "002009.webp",
        "002010.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và theo chuyên gia dinh dưỡng thì món ăn ngày hôm nay sẽ là một món mà có công dụng là hỗ trợ bổ máu rất là tốt.",
      "start": 84.68,
      "end": 90.88,
      "n_words": 28,
      "start_frame": 2117,
      "end_frame": 2272,
      "keyframes": [
        "002140.webp",
        "002270.webp",
        "002271.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ thì mình sẽ đem gà mình sẽ luộc chín cùng với lại củ hành tím nướng.",
      "start": 90.88,
      "end": 95.64,
      "n_words": 18,
      "start_frame": 2272,
      "end_frame": 2391,
      "keyframes": [
        "002332.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tiếp theo thì chúng ta sẽ sơ chế cái phần mọc mà trộn với lại nấm á.",
      "start": 95.64,
      "end": 99.2,
      "n_words": 17,
      "start_frame": 2391,
      "end_frame": 2480,
      "keyframes": [
        "002393.webp",
        "002394.webp",
        "002438.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì đầu tiên chúng ta sẽ sử dụng 100g mọc nấm hương nè, mình ngâm mềm và mình cắt ra một ít, lấy khoảng một muỗng canh nấm hương.",
      "start": 99.2,
      "end": 106.08,
      "n_words": 29,
      "start_frame": 2480,
      "end_frame": 2652,
      "keyframes": [
        "002482.webp",
        "002483.webp",
        "002514.webp",
        "002545.webp",
        "002546.webp",
        "002592.webp",
        "002639.webp",
        "002640.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Không chỉ là ngon mà bên cạnh đó còn có nhiều sắt và vitamin B sẽ giúp tái tạo lại hồng cầu, nên là cũng sẽ giúp chúng ta hỗ trợ bổ máu nữa.",
      "start": 106.08,
      "end": 113.16,
      "n_words": 34,
      "start_frame": 2652,
      "end_frame": 2829,
      "keyframes": [
        "002699.webp",
        "002759.webp",
        "002760.webp",
        "002793.webp",
        "002827.webp",
        "002828.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nấm mèo chúng ta cũng sẽ cắt nhỏ khoảng chừng nửa muỗng canh thôi.",
      "start": 113.16,
      "end": 116.92,
      "n_words": 14,
      "start_frame": 2829,
      "end_frame": 2923,
      "keyframes": [
        "002875.webp",
        "002923.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cà rốt cắt nhỏ, nửa muỗng cà phê hành tím băm.",
      "start": 116.92,
      "end": 121.12,
      "n_words": 11,
      "start_frame": 2923,
      "end_frame": 3028,
      "keyframes": [
        "002923.webp",
        "002924.webp",
        "002954.webp",
        "002985.webp",
        "002986.webp",
        "003007.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đậu phộng luộc sẽ cắt nhỏ, mình sẽ cho vào đây luôn.",
      "start": 121.12,
      "end": 123.96,
      "n_words": 12,
      "start_frame": 3028,
      "end_frame": 3099,
      "keyframes": [
        "003029.webp",
        "003030.webp",
        "003064.webp",
        "003099.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cọng ngò rí băm chúng ta sẽ cho vào đây khoảng nửa muỗng cà phê.",
      "start": 123.96,
      "end": 126.8,
      "n_words": 15,
      "start_frame": 3099,
      "end_frame": 3170,
      "keyframes": [
        "003099.webp",
        "003100.webp",
        "003133.webp",
        "003166.webp",
        "003167.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ thêm một ít đậu phộng luộc băm nhỏ vào trong nhân để khi chúng ta ăn có cảm giác là sần sật nhai vui miệng và đậu béo bùi nữa.",
      "start": 126.8,
      "end": 134.92,
      "n_words": 33,
      "start_frame": 3170,
      "end_frame": 3373,
      "keyframes": [
        "003269.webp",
        "003372.webp",
        "003373.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho vào đây 1/3 muỗng cà phê hạt nêm Ajinomoto nấm, một chút xíu tiêu trộn đều lên.",
      "start": 134.92,
      "end": 141.0,
      "n_words": 18,
      "start_frame": 3373,
      "end_frame": 3525,
      "keyframes": [
        "003373.webp",
        "003388.webp",
        "003403.webp",
        "003404.webp",
        "003425.webp",
        "003447.webp",
        "003448.webp",
        "003469.webp",
        "003490.webp",
        "003491.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Khi mà chúng ta đã chuẩn bị phần nhân xong cũng như là thịt gà đã chín thì mình sẽ vớt gà ra mình xé lấy cái phần thịt, rồi phần xương thì chúng ta sẽ cho lại vào trong nồi nước dùng mình nấu tiếp khoảng chừng 20 phút nữa để cho cái phần nước dùng nó ngọt.",
      "start": 141.0,
      "end": 155.2,
      "n_words": 59,
      "start_frame": 3525,
      "end_frame": 3880,
      "keyframes": [
        "003533.webp",
        "003576.webp",
        "003577.webp",
        "003636.webp",
        "003696.webp",
        "003697.webp",
        "003729.webp",
        "003761.webp",
        "003762.webp",
        "003821.webp",
        "003880.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Sau đó mình lọc lấy một lít hai nước dùng, chúng ta sẽ ướp vào đây nửa muỗng cà phê hạt nêm Ajinomoto nấm.",
      "start": 155.2,
      "end": 160.72,
      "n_words": 24,
      "start_frame": 3880,
      "end_frame": 4018,
      "keyframes": [
        "003880.webp",
        "003881.webp",
        "003908.webp",
        "003936.webp",
        "003937.webp",
        "003950.webp",
        "003963.webp",
        "003964.webp",
        "003993.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hạt nêm Ajinomoto nấm sẽ làm cho món súp thơm hơn, dậy mùi nấm và đặc biệt là hạt nêm này thì chúng ta có thể sử dụng mua một lần mà mình dùng cho cả món chay, món mặn đều ngon luôn.",
      "start": 160.72,
      "end": 170.36,
      "n_words": 43,
      "start_frame": 4018,
      "end_frame": 4259,
      "keyframes": [
        "004022.webp",
        "004023.webp",
        "004138.webp",
        "004254.webp",
        "004255.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Một muỗng cà phê nước mắm, mình sẽ trộn đều lên mình để cho nó thấm gia vị.",
      "start": 170.36,
      "end": 178.32,
      "n_words": 18,
      "start_frame": 4259,
      "end_frame": 4458,
      "keyframes": [
        "004286.webp",
        "004318.webp",
        "004319.webp",
        "004389.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Phần nước dùng gà chúng ta sẽ lấy một ít.",
      "start": 178.32,
      "end": 180.6,
      "n_words": 10,
      "start_frame": 4458,
      "end_frame": 4515,
      "keyframes": [
        "004460.webp",
        "004461.webp",
        "004492.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ mình sẽ cho phần nấm hương mà cắt sợi này vô mình nấu trước nha.",
      "start": 180.92,
      "end": 185.6,
      "n_words": 17,
      "start_frame": 4523,
      "end_frame": 4640,
      "keyframes": [
        "004523.webp",
        "004524.webp",
        "004584.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phần mọc nấm hương này thì chúng ta sẽ nặn viên nó cỡ như một trái cherry nhỏ nhỏ thôi, mình sẽ nặn tròn nó.",
      "start": 185.6,
      "end": 192.96,
      "n_words": 25,
      "start_frame": 4640,
      "end_frame": 4824,
      "keyframes": [
        "004644.webp",
        "004645.webp",
        "004676.webp",
        "004708.webp",
        "004709.webp",
        "004735.webp",
        "004762.webp",
        "004763.webp",
        "004796.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bây giờ thì mình sẽ cho những cái viên này vào trong nồi súp.",
      "start": 192.96,
      "end": 196.36,
      "n_words": 14,
      "start_frame": 4824,
      "end_frame": 4909,
      "keyframes": [
        "004830.webp",
        "004831.webp",
        "004862.webp",
        "004894.webp",
        "004895.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Khi mình cho chế miếng nước sôi như vậy thì nó đỡ dính hơn.",
      "start": 196.36,
      "end": 202.32,
      "n_words": 14,
      "start_frame": 4909,
      "end_frame": 5058,
      "keyframes": [
        "004973.webp",
        "005051.webp",
        "005052.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi mình cho nấm mèo vô.",
      "start": 202.32,
      "end": 204.68,
      "n_words": 6,
      "start_frame": 5058,
      "end_frame": 5117,
      "keyframes": [
        "005087.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chúng ta sẽ cho hai muỗng cà phê hạt nêm Ajinomoto nấm.",
      "start": 204.68,
      "end": 208.72,
      "n_words": 12,
      "start_frame": 5117,
      "end_frame": 5218,
      "keyframes": [
        "005122.webp",
        "005123.webp",
        "005137.webp",
        "005151.webp",
        "005152.webp",
        "005187.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trong món ăn này thì chúng ta sẽ dùng hạt nêm Ajinomoto nấm để giúp cho món ăn ngon và thơm mùi nấm đặc trưng.",
      "start": 208.72,
      "end": 216.32,
      "n_words": 25,
      "start_frame": 5218,
      "end_frame": 5408,
      "keyframes": [
        "005223.webp",
        "005224.webp",
        "005313.webp",
        "005402.webp",
        "005403.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nửa muỗng cà phê bột ngọt Ajinomoto, nửa muỗng cà phê đường.",
      "start": 216.32,
      "end": 222.0,
      "n_words": 12,
      "start_frame": 5408,
      "end_frame": 5550,
      "keyframes": [
        "005417.webp",
        "005431.webp",
        "005432.webp",
        "005462.webp",
        "005492.webp",
        "005493.webp",
        "005524.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Tiếp theo thì chúng ta sẽ cho bột năng vô đây, mình sẽ khuấy đều tay để đừng bị vón cục.",
      "start": 222.0,
      "end": 227.32,
      "n_words": 21,
      "start_frame": 5550,
      "end_frame": 5683,
      "keyframes": [
        "005556.webp",
        "005557.webp",
        "005616.webp",
        "005675.webp",
        "005676.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Mình sẽ cho phần cà rốt cắt sợi vô nha.",
      "start": 227.32,
      "end": 231.04,
      "n_words": 10,
      "start_frame": 5683,
      "end_frame": 5776,
      "keyframes": [
        "005728.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tiếp theo thì mình sẽ cho trứng vô rồi mình sẽ cho rẽ qua cái rây nha cho nó chảy xuống từ từ.",
      "start": 231.04,
      "end": 237.96,
      "n_words": 23,
      "start_frame": 5776,
      "end_frame": 5949,
      "keyframes": [
        "005780.webp",
        "005781.webp",
        "005867.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tiếp tục thì mình sẽ cho vào đây 2/3 lượng thịt gà xé, cho vào đây nửa muỗng canh nước mắm nè.",
      "start": 237.96,
      "end": 243.12,
      "n_words": 22,
      "start_frame": 5949,
      "end_frame": 6078,
      "keyframes": [
        "005953.webp",
