        "005346.webp",
        "005427.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thả vô đây ít đậu phộng các bạn.",
      "start": 217.08,
      "end": 219.76,
      "n_words": 8,
      "start_frame": 5427,
