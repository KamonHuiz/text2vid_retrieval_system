      "start_frame": 1157,
      "end_frame": 1176,
      "keyframes": [
        "001159.webp",
        "001160.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Anh Vũ ơi, lễ Quốc khánh thì chắc chắn không thể thiếu được những bữa cơm quây quần bên gia đình.",
      "start": 47.04,
      "end": 51.6,
      "n_words": 21,
      "start_frame": 1176,
      "end_frame": 1290,
      "keyframes": [
        "001216.webp",
        "001272.webp",
        "001273.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh Vũ có thể giúp cho Kim Thảo và các bạn khán giả có một món nào đó ngon để trổ tài được không?",
      "start": 51.6,
      "end": 56.08,
      "n_words": 24,
      "start_frame": 1290,
      "end_frame": 1402,
      "keyframes": [
        "001298.webp",
        "001324.webp",
