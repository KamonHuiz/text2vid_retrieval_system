        "001350.webp",
        "001376.webp",
        "001377.webp",
        "001397.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Dễ thôi em.",
      "start": 56.08,
      "end": 56.88,
      "n_words": 3,
      "start_frame": 1402,
      "end_frame": 1422,
      "keyframes": [
        "001418.webp",
        "001419.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và trên bàn đây là một con cá chép.",
      "start": 56.88,
      "end": 59.24,
      "n_words": 9,
      "start_frame": 1422,
      "end_frame": 1481,
      "keyframes": [
        "001449.webp",
        "001480.webp",
        "001481.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngay bây giờ, mời các bạn cùng theo dõi thực hiện món cá chép chiên giòn cuốn bánh tráng.",
      "start": 59.24,
      "end": 63.8,
      "n_words": 19,
      "start_frame": 1481,
      "end_frame": 1595,
      "keyframes": [
        "001481.webp",
        "001514.webp",
        "001547.webp",
        "001548.webp",
        "001570.webp",
        "001592.webp",
        "001593.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Món này rất là dễ làm.",
      "start": 63.8,
      "end": 65.2,
      "n_words": 6,
      "start_frame": 1595,
      "end_frame": 1630,
      "keyframes": [
        "001611.webp",
        "001629.webp",
        "001630.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Theo các chuyên gia dinh dưỡng thì món ăn ngày hôm nay hỗ trợ xây dựng khối cơ xương rất là tốt nhé.",
      "start": 65.2,
      "end": 69.96,
      "n_words": 23,
      "start_frame": 1630,
      "end_frame": 1749,
      "keyframes": [
        "001630.webp",
        "001688.webp",
        "001746.webp",
        "001747.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Dĩ nhiên để cho cá được bớt mùi tanh, nhớ ngâm cá trong nước pha tí xíu muối và nước cốt chanh, như vậy sẽ khử được mùi tanh của cá.",
      "start": 69.96,
      "end": 78.12,
      "n_words": 31,
      "start_frame": 1749,
      "end_frame": 1953,
      "keyframes": [
        "001785.webp",
        "001823.webp",
        "001824.webp",
        "001850.webp",
        "001877.webp",
        "001878.webp",
        "001913.webp",
        "001949.webp",
        "001950.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Có nhiều canxi và phốt pho sẽ giúp cho chúng ta hỗ trợ cơ xương rất là tốt, và hạn chế được nguy cơ loãng xương ở người lớn tuổi và nguy cơ còi xương ở trẻ em.",
      "start": 78.68,
      "end": 87.84,
      "n_words": 38,
      "start_frame": 1967,
      "end_frame": 2196,
      "keyframes": [
        "002073.webp",
        "002196.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Sẵn dầu nóng, chúng ta múc ít dầu vô đây, chúng ta làm hành lá, chúng ta cắt ra như vậy.",
      "start": 87.84,
      "end": 92.56,
      "n_words": 21,
      "start_frame": 2196,
      "end_frame": 2314,
      "keyframes": [
        "002196.webp",
        "002197.webp",
        "002231.webp",
        "002266.webp",
        "002267.webp",
        "002290.webp",
        "002314.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cho vào đây một phần ba muỗng cà phê hạt nêm Aji-ngon theo dầu nóng.",
      "start": 92.56,
      "end": 95.92,
      "n_words": 15,
      "start_frame": 2314,
      "end_frame": 2398,
      "keyframes": [
        "002314.webp",
        "002315.webp",
        "002327.webp",
        "002340.webp",
        "002341.webp",
        "002363.webp",
        "002385.webp",
        "002386.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rồi bây giờ chúng ta cho bớt dầu vào trong cái chén, chúng ta cho một gói Ajicru bột tẩm khô chiên giòn.",
      "start": 95.92,
      "end": 103.76,
      "n_words": 23,
      "start_frame": 2398,
      "end_frame": 2594,
      "keyframes": [
        "002438.webp",
        "002491.webp",
        "002492.webp",
        "002532.webp",
        "002573.webp",
        "002574.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta tẩm áo đều cá và chúng ta nhớ là chọn gói to có trọng lượng là 84 g.",
      "start": 103.76,
      "end": 110.08,
      "n_words": 20,
      "start_frame": 2594,
      "end_frame": 2752,
      "keyframes": [
        "002627.webp",
        "002680.webp",
        "002681.webp",
        "002724.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta dùng Ajicru bột tẩm khô chiên giòn để cá thêm đậm đà và giòn ngon hơn.",
      "start": 110.72,
      "end": 115.88,
      "n_words": 18,
      "start_frame": 2768,
      "end_frame": 2897,
      "keyframes": [
        "002768.webp",
        "002832.webp",
        "002896.webp",
        "002897.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Như vậy là chúng ta sẽ sử dụng Ajicru bột tẩm khô chiên giòn, rất là tiện lợi bởi vì mình sẽ không cần phải nêm nếm hay là canh bất kỳ một công thức nào cả nhưng mà vẫn chuẩn vị.",
      "start": 115.88,
      "end": 125.48,
      "n_words": 42,
      "start_frame": 2897,
      "end_frame": 3137,
      "keyframes": [
        "002897.webp",
        "003018.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng ta tẩm với bột tẩm khô chiên giòn thì sẽ thấm được hết cái phần nước ở trong cái da cá thưa các bạn.",
      "start": 125.48,
      "end": 132.36,
      "n_words": 25,
      "start_frame": 3137,
      "end_frame": 3309,
      "keyframes": [
        "003140.webp",
        "003141.webp",
        "003217.webp",
        "003293.webp",
        "003294.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta nên thả từ từ phần đuôi cá vào trong chảo như vậy thì dầu sẽ không bắn vào người.",
      "start": 132.36,
      "end": 141.24,
      "n_words": 21,
      "start_frame": 3309,
      "end_frame": 3531,
      "keyframes": [
        "003363.webp",
        "003433.webp",
        "003434.webp",
        "003484.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng là hay thiệt các bạn khán giả ơi, bởi vì chúng ta sử dụng Ajicru bột tẩm khô chiên giòn và bí quyết mà đầu bếp Thanh Vũ vừa nói lúc nãy thì cá không hề bị bắn dầu ra ngoài, rất là an toàn cho chị em.",
      "start": 141.24,
      "end": 152.76,
      "n_words": 49,
      "start_frame": 3531,
      "end_frame": 3819,
      "keyframes": [
        "003534.webp",
        "003535.webp",
        "003683.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta dùng cây đũa cả nha, đây để lên giấy thấm dầu.",
      "start": 152.76,
      "end": 164.04,
      "n_words": 13,
      "start_frame": 3819,
      "end_frame": 4101,
      "keyframes": [
        "003831.webp",
        "003832.webp",
        "003879.webp",
        "003927.webp",
        "003928.webp",
        "003982.webp",
        "004036.webp",
        "004037.webp",
        "004068.webp",
        "004099.webp",
        "004100.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Bây giờ chúng ta sẽ pha phần nước chấm.",
      "start": 164.04,
      "end": 165.56,
      "n_words": 9,
      "start_frame": 4101,
      "end_frame": 4139,
      "keyframes": [
        "004117.webp",
        "004135.webp",
        "004136.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta cho vào đây một muỗng canh tỏi băm, một muỗng canh ớt băm, một muỗng canh nước cốt tắc và một muỗng canh đường.",
      "start": 165.56,
      "end": 174.16,
      "n_words": 26,
      "start_frame": 4139,
      "end_frame": 4354,
      "keyframes": [
        "004172.webp",
        "004208.webp",
