      "start_frame": 4354,
      "end_frame": 4506,
      "keyframes": [
        "004430.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ chúng ta sẽ cho một muỗng canh nước mắm và hai muỗng canh nước lọc rồi chúng ta hòa tan.",
      "start": 180.24,
