      "n_words": 22,
      "start_frame": 4736,
      "end_frame": 4880,
      "keyframes": [
        "004777.webp",
        "004778.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cảm ơn anh Vũ rất là nhiều.",
