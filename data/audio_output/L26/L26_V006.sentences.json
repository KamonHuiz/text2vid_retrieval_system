        "004326.webp",
        "004350.webp",
        "004351.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chúng ta hòa tan đường và nước cốt tắc trước để cho có cái vị chua và ngọt.",
      "start": 174.16,
      "end": 180.24,
