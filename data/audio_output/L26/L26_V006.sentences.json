      "keyframes": [
        "005093.webp",
        "005094.webp",
        "005143.webp",
        "005193.webp",
        "005194.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cuốn bánh tráng thì không thể thiếu phần mỡ hành rưới lên đây để xanh tươi luôn, dạ sẽ làm cho món cá thơm hơn.",
      "start": 207.84,
