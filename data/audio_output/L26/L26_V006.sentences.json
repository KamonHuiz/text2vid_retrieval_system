        "001026.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em chào anh Vũ.",
      "start": 45.12,
      "end": 46.28,
      "n_words": 4,
      "start_frame": 1128,
      "end_frame": 1157,
      "keyframes": [
        "001134.webp",
        "001135.webp",
        "001147.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Em chào Kim Thảo.",
      "start": 46.28,
      "end": 47.04,
