        "003334.webp",
        "003352.webp",
        "003353.webp",
        "003370.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Bây giờ phần ớt em chỉ lấy một trái ớt đỏ em cắt lát giùm cô.",
      "start": 139.76,
      "end": 143.84,
      "n_words": 16,
      "start_frame": 3494,
      "end_frame": 3596,
      "keyframes": [
        "003501.webp",
        "003502.webp",
        "003539.webp",
        "003576.webp",
        "003577.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dạ, nếu mà mình muốn trong cái phần nước này có vị cay nhiều thì mình đập dập mấy trái ớt, còn nếu mình muốn bình thường thôi, ít cay thì mình sẽ cho hết cái phần ớt xanh, ớt đỏ nè và một trái ớt cắt lát vào đây.",
      "start": 143.84,
      "end": 155.2,
      "n_words": 50,
      "start_frame": 3596,
      "end_frame": 3880,
      "keyframes": [
        "003605.webp",
        "003634.webp",
        "003635.webp",
        "003696.webp",
        "003758.webp",
        "003759.webp",
        "003778.webp",
        "003797.webp",
        "003798.webp",
        "003851.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Mình nấu sôi khoảng chừng hai phút cho cái phần nước giấm này thơm mùi sả và thơm mùi ớt thì mình sẽ tắt lửa và mình để nguội.",
      "start": 155.2,
      "end": 163.92,
      "n_words": 29,
      "start_frame": 3880,
      "end_frame": 4098,
      "keyframes": [
        "003904.webp",
        "003905.webp",
        "003999.webp",
        "004093.webp",
        "004094.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Lá chanh em nữa, em để nguyên cho cô còn một nửa đó thì em cắt sợi giùm cô rồi.",
      "start": 163.92,
      "end": 169.04,
      "n_words": 20,
      "start_frame": 4098,
      "end_frame": 4226,
      "keyframes": [
        "004161.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cảm ơn Kim Thảo.",
      "start": 169.04,
      "end": 170.0,
      "n_words": 4,
      "start_frame": 4226,
      "end_frame": 4250,
      "keyframes": [
        "004228.webp",
        "004229.webp",
        "004245.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Còn cái phần lá chanh còn lại đó em xé xé ra và em giò cho nó nát giùm cô.",
      "start": 170.0,
      "end": 174.12,
      "n_words": 20,
      "start_frame": 4250,
      "end_frame": 4353,
      "keyframes": [
