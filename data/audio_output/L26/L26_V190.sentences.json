        "004332.webp",
        "004333.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tiếp theo thì chúng ta sẽ pha phần muối chấm nha.",
      "start": 174.12,
      "end": 176.68,
      "n_words": 11,
      "start_frame": 4353,
      "end_frame": 4417,
      "keyframes": [
        "004355.webp",
