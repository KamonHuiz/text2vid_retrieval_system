        "005035.webp",
        "005036.webp",
        "005050.webp",
        "005065.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Nước này đã nguội rồi nè, bây giờ chúng ta sẽ cho vào đây luôn.",
      "start": 202.84,
      "end": 205.64,
