        "005084.webp",
        "005102.webp",
        "005103.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nếu chúng ta làm như này, chúng ta ngâm khoảng chừng 5 tiếng đồng hồ là chúng ta có thể ăn được rồi đó.",
      "start": 205.64,
