      "keyframes": [
        "004720.webp",
        "004810.webp",
        "004811.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cánh gà sau khi ngâm nước đá cho nguội thì mình sẽ vớt ra mình để ráo, và bây giờ chúng ta sẽ cho ra đây lá chanh giò và lá chanh mà đã cắt sợi, tắc cắt lát.",
      "start": 192.56,
      "end": 202.6,
      "n_words": 39,
      "start_frame": 4814,
      "end_frame": 5065,
      "keyframes": [
        "004859.webp",
