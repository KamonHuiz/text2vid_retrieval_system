        "003064.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Chúng ta sẽ chọn miếng mít có kết cấu chặt chẽ, phần xơ và múi không tách rời là mít non ngon nhé.",
      "start": 123.88,
