        "003970.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ chiên sơ mít giúp mít thơm và định hình sau khi kho nhé.",
      "start": 159.4,
      "end": 164.4,
