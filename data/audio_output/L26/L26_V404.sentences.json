        "004080.webp",
        "004096.webp",
        "004097.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Các bạn nên nhớ áp chảo cá trước khi nấu để cá được thơm và không bị tanh.",
      "start": 164.12,
      "end": 168.2,
