        "002948.webp",
        "002949.webp",
        "002969.webp",
        "002990.webp",
        "002991.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Cắt cái cà chua thành múi cau để chúng ta nấu phần canh.",
