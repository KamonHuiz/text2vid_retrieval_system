        "003019.webp",
        "003039.webp",
        "003060.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi cà chua cũng đã xong, bây giờ là chúng ta sẽ tiến hành chiên cái phần đậu hũ này trước khi nấu canh.",
      "start": 122.4,
      "end": 127.88,
      "n_words": 24,
      "start_frame": 3060,
      "end_frame": 3197,
      "keyframes": [
        "003060.webp",
        "003061.webp",
