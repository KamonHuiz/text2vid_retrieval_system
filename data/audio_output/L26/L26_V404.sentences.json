        "003116.webp",
        "003117.webp",
        "003137.webp",
        "003157.webp",
        "003158.webp",
        "003175.webp",
        "003192.webp",
        "003193.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Xin ơi, vì sao mà mình cần phải chiên đậu hũ trước hả xin?",
