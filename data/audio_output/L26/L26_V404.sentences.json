      "keyframes": [
        "001763.webp",
        "001855.webp",
        "001856.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cá mú thì xin đã sơ chế và làm sạch rồi, mình cắt ra làm ba khúc để cá được thấm vị hơn.",
      "start": 74.4,
      "end": 78.64,
      "n_words": 23,
      "start_frame": 1860,
      "end_frame": 1966,
      "keyframes": [
        "001882.webp",
