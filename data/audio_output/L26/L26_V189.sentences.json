        "001693.webp",
        "001757.webp",
        "001821.webp",
        "001822.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ngâm khoảng độ chừng năm phút thôi, sau đó chúng ta rửa sạch.",
      "start": 72.88,
      "end": 75.88,
      "n_words": 13,
