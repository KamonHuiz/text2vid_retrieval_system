        "003556.webp",
        "003591.webp",
        "003592.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Gà ác tiềm thuốc bắc sẽ rất là bổ gan thận và bổ khí huyết.",
      "start": 143.68,
      "end": 147.88,
