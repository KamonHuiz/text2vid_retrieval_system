        "002525.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta ướp khoảng 15 phút như vậy.",
      "start": 101.24,
      "end": 103.0,
      "n_words": 8,
      "start_frame": 2531,
      "end_frame": 2575,
      "keyframes": [
