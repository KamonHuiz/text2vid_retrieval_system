        "000755.webp",
        "000756.webp",
        "000883.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và ngày hôm nay thì chúng ta có món gà ác.",
      "start": 40.16,
      "end": 43.4,
      "n_words": 11,
      "start_frame": 1004,
