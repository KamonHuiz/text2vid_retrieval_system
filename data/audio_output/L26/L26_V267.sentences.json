      "keyframes": [
        "002841.webp",
        "002860.webp",
        "002861.webp",
        "002894.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi phần sả thì chúng ta sẽ đập dập và cắt khúc.",
