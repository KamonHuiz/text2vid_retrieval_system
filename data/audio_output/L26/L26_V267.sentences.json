        "002073.webp",
        "002084.webp",
        "002085.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Cảm ơn Tuấn.",
      "start": 83.96,
      "end": 85.04,
      "n_words": 3,
      "start_frame": 2099,
      "end_frame": 2126,
      "keyframes": [
        "002105.webp",
        "002125.webp",
        "002126.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho vào đây một phần ba muỗng cà phê muối, một muỗng canh đường.",
      "start": 85.04,
      "end": 88.64,
      "n_words": 14,
