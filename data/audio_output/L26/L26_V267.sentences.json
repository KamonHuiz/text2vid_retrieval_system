        "004659.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rồi bây giờ thì em tắt lửa đi, cô sẽ vớt ra, vớt tất cả ra.",
      "start": 186.72,
      "end": 191.12,
