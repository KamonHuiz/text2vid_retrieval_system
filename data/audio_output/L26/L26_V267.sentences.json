        "002560.webp",
        "002605.webp",
        "002606.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và để giảm cái độ hăng của cần tây thì mình sẽ ngâm vào cái tô đá lạnh.",
      "start": 104.24,
      "end": 107.96,
      "n_words": 18,
      "start_frame": 2606,
