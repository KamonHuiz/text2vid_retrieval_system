        "003424.webp",
        "003471.webp",
        "003472.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Món ăn này thì tai, mũi và lưỡi mình chỉ cần luộc vừa chín thôi nha.",
      "start": 139.4,
      "end": 143.96,
      "n_words": 16,
      "start_frame": 3485,
      "end_frame": 3599,
      "keyframes": [
        "003523.webp",
        "003575.webp",
        "003576.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, lưỡi giúp cô.",
