      "end_frame": 2804,
      "keyframes": [
        "002752.webp",
        "002787.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Còn nữa cái củ hành tây còn lại thì mình sẽ cắt muối cao nha.",
      "start": 113.16,
      "end": 117.04,
