        "000485.webp",
        "000486.webp",
        "000548.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cô hiểu rồi, triệu chứng thừa đạm thiếu xơ, đầy năng lượng đó.",
      "start": 22.88,
      "end": 27.2,
      "n_words": 13,
