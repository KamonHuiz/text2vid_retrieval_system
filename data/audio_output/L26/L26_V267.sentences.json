      "end_frame": 680,
      "keyframes": [
        "000611.webp",
        "000612.webp",
        "000652.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng mà su hào thì làm được nhiều món ngon lắm á.",
      "start": 27.2,
      "end": 29.84,
      "n_words": 12,
      "start_frame": 680,
      "end_frame": 746,
      "keyframes": [
        "000693.webp",
