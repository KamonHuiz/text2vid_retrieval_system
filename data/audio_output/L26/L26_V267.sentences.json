        "002305.webp",
        "002348.webp",
        "002349.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trộn đều trước khi mình trộn gỏi thì chúng ta ép cho ráo nước.",
      "start": 94.0,
      "end": 97.32,
      "n_words": 14,
