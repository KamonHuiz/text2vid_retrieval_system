      "start_frame": 746,
      "end_frame": 776,
      "keyframes": [
        "000759.webp",
        "000774.webp",
        "000775.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cô biết mà, em thì lúc nào cũng gá kèo hết.",
      "start": 31.04,
      "end": 33.12,
      "n_words": 11,
      "start_frame": 776,
      "end_frame": 828,
      "keyframes": [
        "000798.webp",
        "000821.webp",
        "000822.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Một món nộm theo kiểu hương vị miền Bắc: nộm lưỡi lợn su hào.",
      "start": 33.12,
      "end": 39.56,
      "n_words": 14,
      "start_frame": 828,
      "end_frame": 989,
      "keyframes": [
