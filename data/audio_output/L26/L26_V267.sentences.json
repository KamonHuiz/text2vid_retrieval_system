        "004108.webp",
        "004109.webp",
        "004154.webp"
      ],
      "keyframe_count": 24
    },
    {
      "text": "Mình sẽ nấu cái hỗn hợp này sôi khoảng chừng năm phút.",
      "start": 167.8,
      "end": 171.2,
      "n_words": 12,
