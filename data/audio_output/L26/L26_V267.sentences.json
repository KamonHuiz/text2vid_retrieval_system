        "001271.webp",
        "001272.webp",
        "001362.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 57.92,
      "end": 60.8,
      "n_words": 13,
      "start_frame": 1448,
      "end_frame": 1520,
      "keyframes": [
        "001452.webp",
        "001453.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 60.8,
      "end": 64.84,
      "n_words": 11,
      "start_frame": 1520,
      "end_frame": 1621,
      "keyframes": [
        "001539.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ở kia mình có dưa leo bỏ ruột ha, cắt xéo mình sẵn răng cưa.",
      "start": 64.84,
      "end": 70.8,
      "n_words": 15,
