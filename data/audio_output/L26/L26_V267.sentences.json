        "001891.webp",
        "001892.webp",
        "001915.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Su hào thì em sắn theo chiều đó luôn rồi.",
      "start": 77.44,
      "end": 83.96,
      "n_words": 10,
      "start_frame": 1936,
      "end_frame": 2099,
