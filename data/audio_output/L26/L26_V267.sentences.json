      "start_frame": 3155,
      "end_frame": 3210,
      "keyframes": [
        "003159.webp",
        "003160.webp",
        "003199.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ luộc tai và mũi heo từ nước lạnh giúp các nguyên liệu này trắng và chín đều.",
      "start": 128.4,
      "end": 135.04,
