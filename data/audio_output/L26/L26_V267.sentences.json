        "002365.webp",
        "002398.webp",
        "002431.webp",
        "002432.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đây là cần tây sau khi đã rửa sạch và bào hết những cái xơ ở phía bên ngoài này thì giờ chúng ta chỉ cần cắt lát thôi.",
      "start": 97.32,
      "end": 104.24,
      "n_words": 29,
      "start_frame": 2433,
      "end_frame": 2606,
      "keyframes": [
        "002473.webp",
