        "001279.webp",
        "001366.webp",
        "001367.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Anoto Việt Nam.",
      "start": 57.28,
      "end": 61.28,
      "n_words": 11,
      "start_frame": 1432,
      "end_frame": 1532,
      "keyframes": [
        "001452.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Với món bánh ngày hôm nay thì đầu tiên chúng ta sẽ pha bột trước.",
      "start": 61.28,
      "end": 65.0,
      "n_words": 15,
