        "001233.webp",
        "001234.webp",
        "001259.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hay là một món lẩu đúng không? Chính xác, nhưng mà không phải là một món lẩu thông thường đâu.",
      "start": 51.08,
      "end": 56.32,
      "n_words": 20,
