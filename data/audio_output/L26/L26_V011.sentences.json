      "keyframes": [
        "001080.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Anh Quốc Nghị: Gian bếp của mình hôm nay sao nhiều topping dữ vậy?",
      "start": 47.2,
      "end": 51.08,
      "n_words": 14,
