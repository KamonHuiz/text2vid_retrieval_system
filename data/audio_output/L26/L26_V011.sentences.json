      "end_frame": 1408,
      "keyframes": [
        "001285.webp",
        "001286.webp",
        "001307.webp",
        "001329.webp",
        "001330.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hôm nay Quốc Nghị sẽ hướng dẫn các bạn khán giả cùng Minh Phương làm một món lẩu chuẩn Hàn Quốc luôn: lẩu kim chi phô mai nha.",
      "start": 56.32,
      "end": 63.52,
      "n_words": 28,
      "start_frame": 1408,
      "end_frame": 1588,
      "keyframes": [
        "001435.webp",
        "001540.webp",
        "001541.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và theo chuyên gia dinh dưỡng, món ăn này sẽ giúp hỗ trợ xây dựng khối cơ xương rất là tốt luôn đó.",
      "start": 63.52,
      "end": 68.32,
      "n_words": 23,
      "start_frame": 1588,
      "end_frame": 1708,
      "keyframes": [
        "001624.webp",
        "001708.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hành baro thì cái phần gốc hành nè các bạn sẽ cắt lát, cái phần ngọn của hành baro thì các bạn sẽ cắt sợi ra.",
      "start": 68.32,
      "end": 78.8,
      "n_words": 26,
      "start_frame": 1708,
      "end_frame": 1970,
      "keyframes": [
        "001708.webp",
        "001709.webp",
        "001745.webp",
        "001781.webp",
        "001782.webp",
        "001830.webp",
        "001878.webp",
        "001879.webp",
        "001926.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Cải thảo phần lá chúng ta để dài một chút, cái phần gốc này các bạn cắt đôi.",
      "start": 78.8,
      "end": 83.44,
      "n_words": 18,
      "start_frame": 1970,
      "end_frame": 2086,
      "keyframes": [
        "001974.webp",
        "001975.webp",
        "002041.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong cải thảo đó các bạn rất là giàu canxi, vì thế nếu như các bạn muốn bổ sung canxi trong những bữa ăn hàng ngày thì đây là nguyên liệu rất tốt giúp cho xương khớp của mình chắc khỏe.",
      "start": 83.44,
      "end": 93.32,
      "n_words": 41,
      "start_frame": 2086,
      "end_frame": 2333,
      "keyframes": [
        "002108.webp",
        "002109.webp",
        "002124.webp",
        "002140.webp",
        "002141.webp",
        "002236.webp",
        "002331.webp",
        "002332.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ chúng ta nấu lẩu.",
      "start": 93.32,
      "end": 95.4,
      "n_words": 6,
      "start_frame": 2333,
      "end_frame": 2385,
      "keyframes": [
        "002358.webp",
        "002385.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Dầu đã nóng thì cho hành baro vào phi thơm, đảo đều nè.",
