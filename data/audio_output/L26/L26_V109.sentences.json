        "005596.webp",
        "005597.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Nổi lửa lên áp chảo cái phần xôi bên ngoài cho nó giòn đó, nó thành bánh dày.",
      "start": 225.4,
      "end": 232.16,
