      "end": 186.28,
      "n_words": 27,
      "start_frame": 4502,
      "end_frame": 4657,
      "keyframes": [
        "004563.webp",
        "004642.webp",
        "004643.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta tới công đoạn trộn nhân vô và chúng ta sẽ áp chảo.",
      "start": 186.28,
      "end": 189.52,
      "n_words": 14,
      "start_frame": 4657,
      "end_frame": 4738,
      "keyframes": [
        "004688.webp",
        "004734.webp",
        "004735.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi, cái lá chuối gói chúng ta lót cẩm bằng như vậy là được rồi các bạn.",
