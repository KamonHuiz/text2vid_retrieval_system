      "start_frame": 5004,
      "end_frame": 5068,
      "keyframes": [
        "005019.webp",
        "005020.webp",
        "005049.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, trời làm khéo quá Tuấn ơi!",
