      "end": 200.16,
      "n_words": 10,
      "start_frame": 4900,
      "end_frame": 5004,
      "keyframes": [
        "004900.webp",
        "004959.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi mình đảo đều qua cái chảo nè.",
