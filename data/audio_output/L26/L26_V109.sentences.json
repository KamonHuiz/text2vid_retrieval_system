        "003754.webp",
        "003776.webp",
        "003799.webp"
      ],
      "keyframe_count": 26
    },
    {
      "text": "Chúng ta đảo đều, cho hành lá vào đi.",
      "start": 151.96,
      "end": 154.88,
      "n_words": 9,
      "start_frame": 3799,
      "end_frame": 3872,
