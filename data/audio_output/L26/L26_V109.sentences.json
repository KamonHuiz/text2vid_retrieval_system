      "end_frame": 2192,
      "keyframes": [
        "002055.webp",
        "002056.webp",
        "002089.webp",
        "002123.webp",
        "002124.webp",
        "002160.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thì chúng ta sẽ xào cái nhân thịt cua.",
