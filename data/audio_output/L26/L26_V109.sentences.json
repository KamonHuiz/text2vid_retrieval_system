        "002222.webp",
        "002247.webp",
        "002248.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đợi chảo nóng chúng ta cho dầu ăn vào, rồi đó, như vậy được rồi.",
      "start": 90.16,
