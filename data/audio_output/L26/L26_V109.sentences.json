        "001686.webp",
        "001716.webp",
        "001717.webp",
        "001749.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bây giờ chúng ta sẽ hấp xôi.",
      "start": 71.08,
      "end": 73.4,
      "n_words": 7,
      "start_frame": 1777,
      "end_frame": 1835,
      "keyframes": [
        "001782.webp",
        "001783.webp",
        "001811.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta nên phủ lên đây một miếng lá chuối để cho sau khi hấp thì hạt xôi sẽ nở mềm dẻo đều luôn nha các bạn.",
      "start": 73.4,
      "end": 80.48,
      "n_words": 27,
      "start_frame": 1835,
      "end_frame": 2012,
      "keyframes": [
