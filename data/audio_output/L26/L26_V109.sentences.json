        "002474.webp",
        "002475.webp",
        "002583.webp",
        "002692.webp",
        "002693.webp",
        "002714.webp",
        "002736.webp",
        "002737.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chúng ta phi hành phi vừa vàng như vậy thôi nha, quá đẹp rồi anh ơi.",
      "start": 109.72,
      "end": 113.16,
      "n_words": 16,
      "start_frame": 2743,
      "end_frame": 2829,
      "keyframes": [
        "002785.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi cho hành phi ra đây.",
      "start": 113.16,
      "end": 116.28,
      "n_words": 6,
      "start_frame": 2829,
      "end_frame": 2907,
      "keyframes": [
        "002834.webp",
        "002835.webp",
        "002873.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta dùng cái dầu này luôn, cái dầu này luôn đó.",
