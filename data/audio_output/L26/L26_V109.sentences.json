      "keyframes": [
        "002012.webp",
        "002033.webp",
        "002055.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ cắt hành lá, minh tuấn cắt nhỏ ra để giống như chúng ta làm hành thôi.",
      "start": 82.2,
      "end": 87.68,
      "n_words": 19,
