        "000661.webp",
        "000662.webp",
        "000752.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Rất vui khi được gặp lại quý vị khán giả của chương trình Món ngon mỗi ngày, nấu chuẩn an lành.",
      "start": 33.52,
      "end": 38.32,
      "n_words": 21,
      "start_frame": 838,
      "end_frame": 958,
      "keyframes": [
        "000842.webp",
        "000843.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 38.32,
      "end": 42.72,
      "n_words": 11,
      "start_frame": 958,
      "end_frame": 1068,
      "keyframes": [
        "000966.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chào Minh Tuấn!",
      "start": 42.72,
      "end": 43.56,
      "n_words": 3,
      "start_frame": 1068,
      "end_frame": 1089,
      "keyframes": [
        "001089.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em chào anh.",
      "start": 43.56,
      "end": 44.24,
      "n_words": 3,
      "start_frame": 1089,
      "end_frame": 1106,
      "keyframes": [
        "001089.webp",
        "001090.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi, ngày hôm nay mình sẽ làm một cái món gì đặc biệt đây anh?",
      "start": 44.24,
      "end": 47.08,
      "n_words": 15,
      "start_frame": 1106,
      "end_frame": 1177,
      "keyframes": [
        "001133.webp",
        "001176.webp",
        "001177.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta có thịt cua, tôm khô và hành tím.",
      "start": 47.08,
      "end": 49.96,
      "n_words": 10,
      "start_frame": 1177,
      "end_frame": 1249,
      "keyframes": [
        "001177.webp",
        "001198.webp",
        "001219.webp",
        "001220.webp",
        "001242.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Món ăn ngày hôm nay của chúng ta có tên gọi là xôi cẩm thịt cua.",
      "start": 49.96,
      "end": 53.92,
      "n_words": 16,
      "start_frame": 1249,
      "end_frame": 1348,
      "keyframes": [
        "001265.webp",
        "001266.webp",
        "001308.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vậy thì chắc chắn là em nghĩ là mình sẽ dùng đến lá cẩm, nó vừa tạo màu đẹp nè mà nó lại tốt cho sức khỏe nữa, nó hỗ trợ những cái vấn đề liên quan đến viêm họng hay là làm cho mình thanh nhiệt.",
      "start": 53.92,
      "end": 63.4,
      "n_words": 47,
      "start_frame": 1348,
      "end_frame": 1585,
      "keyframes": [
        "001350.webp",
        "001351.webp",
        "001386.webp",
        "001421.webp",
        "001422.webp",
        "001437.webp",
        "001452.webp",
        "001453.webp",
        "001469.webp",
        "001485.webp",
        "001486.webp",
        "001533.webp",
        "001581.webp",
        "001582.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Và đây là nếp nương đã ngâm sẵn trong cái nước lá cẩm trong vòng 4 giờ.",
      "start": 63.4,
      "end": 71.08,
      "n_words": 17,
      "start_frame": 1585,
      "end_frame": 1777,
      "keyframes": [
        "001619.webp",
