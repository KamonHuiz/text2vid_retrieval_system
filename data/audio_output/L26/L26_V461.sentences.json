        "001866.webp",
        "001898.webp",
        "001899.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta khứa hình saro như vậy đó, nghiêng dao tí nha, nghiêng dao như vậy đó.",
      "start": 76.0,
