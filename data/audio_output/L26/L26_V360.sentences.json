        "000413.webp",
        "000440.webp",
        "000441.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Có nghe \"chim thu nhụ đế\"?",
      "start": 17.84,
      "end": 20.36,
      "n_words": 6,
      "start_frame": 446,
      "end_frame": 509,
      "keyframes": [
        "000472.webp",
        "000504.webp",
        "000505.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, cho nên là ngày hôm nay mang cực phẩm đứng đầu danh sách đến tặng Hoàng Long: cá chim.",
      "start": 20.36,
      "end": 25.04,
      "n_words": 21,
      "start_frame": 509,
      "end_frame": 626,
      "keyframes": [
        "000553.webp",
        "000601.webp",
        "000602.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chim đúng rồi.",
      "start": 25.04,
      "end": 26.48,
      "n_words": 3,
      "start_frame": 626,
      "end_frame": 662,
      "keyframes": [
        "000632.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Có thêm câu này nữa: \"Nhất nướng, nhì chiên, tam xào, tứ nấu\".",
      "start": 26.48,
      "end": 31.36,
      "n_words": 13,
      "start_frame": 662,
      "end_frame": 784,
      "keyframes": [
        "000663.webp",
        "000664.webp",
        "000714.webp",
        "000764.webp",
        "000765.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Mình phải nhất nhất thôi đúng không nào?",
      "start": 31.36,
      "end": 33.24,
      "n_words": 8,
      "start_frame": 784,
      "end_frame": 831,
      "keyframes": [
        "000792.webp",
        "000820.webp",
        "000821.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cá chim nướng, không phải là nướng ớt sim xanh mới hái ngoài vườn luôn.",
      "start": 33.24,
      "end": 36.96,
      "n_words": 15,
      "start_frame": 831,
      "end_frame": 924,
      "keyframes": [
        "000871.webp",
        "000922.webp",
        "000923.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ớt sim mới vừa hái ở ngoài vườn đúng rồi.",
      "start": 36.96,
      "end": 39.16,
      "n_words": 10,
      "start_frame": 924,
      "end_frame": 979,
      "keyframes": [
        "000944.webp",
        "000965.webp",
        "000966.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ mình sẽ làm món cá chim nướng ớt sim vị đậm đà tỏa hương xa với cá chim nướng ớt sim.",
      "start": 39.16,
      "end": 63.36,
      "n_words": 23,
      "start_frame": 979,
      "end_frame": 1584,
      "keyframes": [
        "000987.webp",
        "001008.webp",
        "001009.webp",
        "001033.webp",
        "001058.webp",
        "001059.webp",
        "001083.webp",
        "001108.webp",
        "001109.webp",
        "001163.webp",
        "001217.webp",
        "001218.webp",
        "001265.webp",
        "001313.webp",
        "001328.webp",
        "001370.webp",
        "001412.webp",
        "001413.webp",
        "001499.webp"
      ],
      "keyframe_count": 19
    },
    {
      "text": "Mừng quý vị đã quay trở lại với chương trình Món ngon mỗi ngày.",
      "start": 63.36,
      "end": 65.84,
      "n_words": 14,
      "start_frame": 1584,
      "end_frame": 1646,
      "keyframes": [
        "001586.webp",
        "001587.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 65.84,
      "end": 69.2,
      "n_words": 11,
      "start_frame": 1646,
      "end_frame": 1730,
      "keyframes": [
        "001661.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và bây giờ Long sẽ làm cái phần hỗn hợp gia vị để ướp cá.",
      "start": 69.2,
      "end": 72.28,
      "n_words": 15,
      "start_frame": 1730,
      "end_frame": 1807,
      "keyframes": [
        "001736.webp",
        "001737.webp",
        "001753.webp",
        "001770.webp",
        "001771.webp",
        "001788.webp",
        "001805.webp",
        "001806.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đầu tiên chúng ta sẽ cho vào đây một muỗng cà phê bột canh Ajinomoto, nửa muỗng cà phê bột ngọt Ajinomoto, một phần ba muỗng cà phê tiêu nếu muốn, một ít ớt bột khô, một muỗng canh dầu điều.",
      "start": 72.28,
      "end": 84.52,
      "n_words": 41,
      "start_frame": 1807,
      "end_frame": 2113,
      "keyframes": [
        "001849.webp",
        "001893.webp",
        "001894.webp",
        "001928.webp",
        "001963.webp",
        "001964.webp",
        "001987.webp",
        "002010.webp",
        "002011.webp",
        "002040.webp",
        "002070.webp",
        "002071.webp",
        "002092.webp",
        "002113.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Chúng ta sẽ sử dụng ba trái ớt xiêm xanh băm đập nhẹ một cái.",
      "start": 84.52,
      "end": 89.84,
      "n_words": 15,
      "start_frame": 2113,
      "end_frame": 2246,
      "keyframes": [
        "002113.webp",
        "002114.webp",
        "002155.webp",
        "002196.webp",
        "002197.webp",
        "002208.webp",
        "002220.webp",
        "002221.webp",
        "002240.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nếu như mà thích cay thì băm thêm, bỏ thêm ớt xiêm xanh vô cũng được đúng không nào?",
      "start": 89.84,
      "end": 94.96,
      "n_words": 19,
      "start_frame": 2246,
      "end_frame": 2374,
      "keyframes": [
        "002259.webp",
        "002260.webp",
        "002298.webp",
        "002336.webp",
        "002337.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hoặc là mình đập dập thêm nhiều cũng được nữa.",
      "start": 94.96,
      "end": 97.76,
      "n_words": 10,
      "start_frame": 2374,
      "end_frame": 2444,
      "keyframes": [
        "002389.webp",
        "002442.webp",
        "002443.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho vào đây là một muỗng hành tím băm.",
      "start": 97.76,
      "end": 100.08,
      "n_words": 9,
      "start_frame": 2444,
      "end_frame": 2502,
      "keyframes": [
        "002472.webp",
        "002502.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ trộn đều lên chúng ta sẽ có hỗn hợp để ướp vào cá.",
      "start": 100.08,
      "end": 104.92,
      "n_words": 15,
      "start_frame": 2502,
      "end_frame": 2623,
      "keyframes": [
        "002502.webp",
        "002503.webp",
        "002538.webp",
        "002574.webp",
        "002575.webp",
        "002597.webp",
        "002620.webp",
        "002621.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Cá ở đây thì Long sẽ khứa thêm hai cái đường bên hông để mình ướp cá vào nó mau thấm hơn và mình sẽ lóc thêm bên trong này để mình dựng con cá đứng lên. Lát nữa nướng thì mình sẽ tạo hình luôn.",
      "start": 104.92,
      "end": 115.08,
      "n_words": 46,
      "start_frame": 2623,
      "end_frame": 2877,
      "keyframes": [
        "002697.webp",
        "002774.webp",
        "002775.webp",
        "002803.webp",
        "002832.webp",
        "002833.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hả Hoàng Long?",
      "start": 115.08,
      "end": 115.72,
      "n_words": 3,
      "start_frame": 2877,
      "end_frame": 2893,
      "keyframes": [
        "002878.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Mình sẽ tạo hình trước nướng luôn.",
      "start": 115.72,
      "end": 117.2,
      "n_words": 7,
      "start_frame": 2893,
      "end_frame": 2930,
      "keyframes": [
        "002923.webp",
        "002924.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Long sẽ đập dập gốc hành và mình nhét vào bên trong bụng cá và có tắc nữa.",
      "start": 117.2,
      "end": 121.44,
      "n_words": 18,
      "start_frame": 2930,
      "end_frame": 3036,
      "keyframes": [
        "002940.webp",
        "002956.webp",
        "002957.webp",
        "002969.webp",
        "002982.webp",
        "002983.webp",
        "002997.webp",
        "003011.webp",
        "003012.webp",
        "003029.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Long sẽ ướp cái hỗn hợp ướp cá vào bên trong cá, mình sẽ dùng tay đúng không nào?",
      "start": 121.44,
      "end": 126.64,
      "n_words": 19,
      "start_frame": 3036,
      "end_frame": 3166,
      "keyframes": [
        "003047.webp",
        "003048.webp",
        "003064.webp",
        "003081.webp",
        "003082.webp",
        "003118.webp",
        "003155.webp",
        "003156.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Làm như vậy thì cái phần gia vị nó sẽ bám chắc vào cái phần thịt hơn ha?",
      "start": 126.64,
      "end": 129.92,
      "n_words": 18,
      "start_frame": 3166,
      "end_frame": 3248,
      "keyframes": [
        "003185.webp",
        "003215.webp",
        "003216.webp",
        "003248.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đúng rồi.",
      "start": 129.92,
      "end": 131.44,
      "n_words": 2,
      "start_frame": 3248,
      "end_frame": 3286,
      "keyframes": [
        "003248.webp",
        "003281.webp",
        "003282.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Kế đến đó chính là phần hành lá và tắc.",
      "start": 131.44,
      "end": 134.68,
      "n_words": 10,
      "start_frame": 3286,
      "end_frame": 3367,
      "keyframes": [
        "003311.webp",
        "003341.webp",
        "003342.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Khi mình ướp cá mình sẽ cho hành lá vào, tắc vào bụng cá để khử mùi tanh, đồng thời sẽ giúp món nướng thơm hơn.",
      "start": 134.68,
      "end": 140.08,
      "n_words": 26,
      "start_frame": 3367,
      "end_frame": 3502,
      "keyframes": [
        "003390.webp",
        "003438.webp",
        "003439.webp",
        "003468.webp",
        "003497.webp",
        "003498.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ sẽ thoa thêm bên ngoài đây.",
      "start": 140.08,
      "end": 143.84,
      "n_words": 8,
      "start_frame": 3502,
      "end_frame": 3596,
      "keyframes": [
        "003536.webp",
        "003575.webp",
        "003576.webp",
        "003595.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Phụ bếp chuẩn bị một cái khay.",
      "start": 143.84,
      "end": 145.8,
      "n_words": 7,
      "start_frame": 3596,
      "end_frame": 3645,
      "keyframes": [
        "003614.webp",
        "003615.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hay quá Long chuẩn bị lá chuối luôn nè, rất là thích lá chuối lên xong rồi mình sẽ xếp cá vào.",
      "start": 145.8,
      "end": 152.72,
      "n_words": 22,
      "start_frame": 3645,
      "end_frame": 3818,
      "keyframes": [
        "003658.webp",
        "003701.webp",
        "003702.webp",
        "003729.webp",
        "003756.webp",
        "003757.webp",
        "003758.webp",
        "003759.webp",
        "003760.webp",
        "003807.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "À, khi nãy mình rắc một chút cái phần sả ở bên trong cái bụng đúng không để dễ dàng hơn trong cái việc tạo hình đúng không nào?",
      "start": 152.72,
      "end": 159.44,
      "n_words": 29,
      "start_frame": 3818,
      "end_frame": 3986,
      "keyframes": [
        "003854.webp",
        "003855.webp",
        "003889.webp",
        "003923.webp",
        "003924.webp",
        "003956.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Dễ dựng đứng lên thấy không?",
      "start": 159.44,
      "end": 160.84,
      "n_words": 6,
      "start_frame": 3986,
      "end_frame": 4021,
      "keyframes": [
        "003988.webp",
        "003989.webp",
        "004010.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hay quá. Bây giờ thì chỉ việc mang đi nướng thôi.",
      "start": 160.84,
      "end": 163.6,
      "n_words": 11,
      "start_frame": 4021,
      "end_frame": 4090,
      "keyframes": [
        "004032.webp",
        "004033.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thế nhưng thời gian và nhiệt độ nướng sẽ là bao lâu hả Hoàng Long?",
      "start": 163.6,
      "end": 166.36,
      "n_words": 15,
      "start_frame": 4090,
      "end_frame": 4159,
      "keyframes": [
        "004092.webp",
        "004152.webp",
        "004153.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ nướng ở nhiệt độ 230 °C trong thời gian là 25 phút.",
      "start": 166.36,
      "end": 169.96,
      "n_words": 15,
      "start_frame": 4159,
      "end_frame": 4249,
      "keyframes": [
        "004182.webp",
        "004212.webp",
        "004213.webp",
        "004247.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi sở dĩ chúng ta phải lót lá chuối bên dưới để ngăn cái phần thịt cá và khay không dính vào nhau, đồng thời là cái hương lá chuối sẽ làm cho thịt cá thơm hơn.",
      "start": 169.96,
      "end": 177.12,
      "n_words": 37,
      "start_frame": 4249,
      "end_frame": 4428,
      "keyframes": [
        "004282.webp",
        "004283.webp",
        "004354.webp",
        "004425.webp",
        "004426.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Món nướng thì chúng ta vẫn thích là sẽ chấm một cái gì đó đúng không?",
      "start": 177.12,
      "end": 180.68,
      "n_words": 16,
      "start_frame": 4428,
      "end_frame": 4517,
      "keyframes": [
        "004446.webp",
        "004466.webp",
        "004467.webp",
        "004513.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nhưng mà có cái cối thì mình sẽ giã muối.",
      "start": 180.68,
      "end": 182.44,
      "n_words": 10,
      "start_frame": 4517,
      "end_frame": 4561,
      "keyframes": [
        "004560.webp",
        "004561.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng ta mới cho vào đây là hai muỗng canh bột canh Ajinomoto, kế đến mình cho vào trên đây hai trái ớt sim linh hồn của món ăn đúng không nào?",
      "start": 182.44,
      "end": 189.56,
      "n_words": 32,
      "start_frame": 4561,
      "end_frame": 4739,
      "keyframes": [
        "004561.webp",
        "004600.webp",
        "004640.webp",
        "004641.webp",
        "004658.webp",
        "004676.webp",
        "004677.webp",
        "004718.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đúng rồi.",
      "start": 189.56,
      "end": 190.68,
      "n_words": 2,
      "start_frame": 4739,
      "end_frame": 4767,
      "keyframes": [
        "004760.webp",
        "004761.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cho ngò gai vào đây và giã chung luôn.",
      "start": 190.68,
      "end": 192.6,
      "n_words": 9,
      "start_frame": 4767,
      "end_frame": 4815,
      "keyframes": [
        "004803.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, hay quá.",
      "start": 192.6,
      "end": 193.84,
      "n_words": 4,
      "start_frame": 4815,
      "end_frame": 4846,
      "keyframes": [
        "004845.webp",
        "004846.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ mình sẽ giã nhuyễn cái phần này ra.",
      "start": 193.84,
      "end": 195.72,
      "n_words": 10,
      "start_frame": 4846,
