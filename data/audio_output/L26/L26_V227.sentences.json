        "001312.webp",
        "001331.webp",
        "001332.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Lột bỏ cái phần vỏ của mình thôi các bạn.",
      "start": 53.4,
      "end": 56.2,
      "n_words": 10,
      "start_frame": 1335,
      "end_frame": 1405,
      "keyframes": [
        "001369.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cái đầu, cái đuôi, những cái phần vỏ tôm này chúng ta không bỏ đi nha các bạn, giữ lại nha các bạn.",
      "start": 56.2,
      "end": 60.04,
      "n_words": 23,
      "start_frame": 1405,
      "end_frame": 1501,
      "keyframes": [
        "001407.webp",
        "001408.webp",
        "001452.webp",
        "001497.webp",
        "001498.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dùng dao chúng ta chẻ lấy chỉ lưng.",
      "start": 60.04,
      "end": 62.44,
      "n_words": 8,
      "start_frame": 1501,
