        "000596.webp",
        "000597.webp",
        "000687.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Hân hoan chào đón quý vị khán giả đang xem chương trình Món ngon mỗi ngày.",
      "start": 31.04,
      "end": 34.84,
      "n_words": 16,
