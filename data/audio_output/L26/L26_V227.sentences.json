        "002264.webp",
        "002285.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi, gọn rẽ luôn.",
      "start": 91.96,
      "end": 94.4,
      "n_words": 5,
      "start_frame": 2299,
      "end_frame": 2360,
