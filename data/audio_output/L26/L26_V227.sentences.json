        "001969.webp",
        "001999.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Chính xác, sau đó thì mình chỉ cần chẻ lưng và lấy chỉ rồi xong.",
      "start": 81.12,
      "end": 87.2,
      "n_words": 15,
