        "000360.webp",
        "000420.webp",
        "000421.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ mấy bạn nhỏ ở nhà muốn ăn một món thiệt là ngon, không biết làm món gì để chiều lòng đây.",
      "start": 17.84,
