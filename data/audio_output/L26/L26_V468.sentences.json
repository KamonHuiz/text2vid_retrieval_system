        "001840.webp",
        "001873.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ở đây Phước Hưng cũng đã bào sả hàu ra thành từng sợi nhỏ vừa ăn rồi.",
      "start": 74.92,
