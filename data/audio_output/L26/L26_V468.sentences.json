      "start_frame": 300,
      "end_frame": 353,
      "keyframes": [
        "000300.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hôm nay nhờ Hưng một chuyện nhỏ xíu xíu được không? Rất là đơn giản.",
      "start": 14.12,
      "end": 17.84,
