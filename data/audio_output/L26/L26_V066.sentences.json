      "end_frame": 6369,
      "keyframes": [
        "006340.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Kim Thảo ơi, quá 25 phút rồi đó, bây giờ món ăn chúng ta đã hoàn thành nha.",
