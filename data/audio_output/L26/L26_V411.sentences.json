      "end_frame": 4555,
      "keyframes": [
        "004496.webp",
        "004546.webp",
        "004547.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi mình sẽ để ra đây phần còn lại là Kim Thảo sẽ cuốn nha.",
      "start": 182.2,
      "end": 186.24,
      "n_words": 15,
