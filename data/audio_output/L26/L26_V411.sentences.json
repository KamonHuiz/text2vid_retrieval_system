        "000895.webp",
        "000896.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trời ơi phù hợp gì đâu!",
      "start": 35.88,
      "end": 37.96,
      "n_words": 6,
      "start_frame": 897,
      "end_frame": 949,
      "keyframes": [
        "000935.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Á cô Hà ơi trời ơi tưởng gì chứ món cháo cá ám là món ruột của cô đó.",
      "start": 37.96,
      "end": 43.44,
