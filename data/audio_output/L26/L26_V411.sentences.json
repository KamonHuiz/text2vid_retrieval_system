        "001548.webp",
        "001549.webp",
        "001636.webp"
      ],
      "keyframe_count": 19
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 67.84,
      "end": 71.76,
      "n_words": 13,
      "start_frame": 1696,
      "end_frame": 1794,
      "keyframes": [
        "001723.webp",
        "001724.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 71.76,
      "end": 76.0,
      "n_words": 11,
      "start_frame": 1794,
      "end_frame": 1900,
      "keyframes": [
        "001811.webp",
        "001899.webp",
        "001900.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đầu tiên thì chúng ta sẽ luộc cái phần thịt ba chỉ với gói gia vị này thì chúng ta sẽ luộc thịt từ khi nước lạnh để thịt được trắng nha các bạn.",
      "start": 76.0,
      "end": 83.08,
      "n_words": 34,
      "start_frame": 1900,
      "end_frame": 2077,
      "keyframes": [
        "001900.webp",
