        "002053.webp",
        "002075.webp",
        "002076.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Đây là phi lê cá lóc, tôi sẽ cắt thành phần như thế này đó.",
      "start": 83.08,
      "end": 88.32,
      "n_words": 15,
