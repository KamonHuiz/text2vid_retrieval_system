        "002113.webp",
        "002135.webp",
        "002157.webp",
        "002158.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thì mình cắt vậy thì mình sẽ loại bỏ được hết phần xương dọc theo đây rồi bây giờ thì mình sẽ cắt thành những cái cặp miếng thịt nó sẽ dính nhau ở một phần da như thế này.",
      "start": 88.32,
      "end": 99.32,
      "n_words": 40,
      "start_frame": 2208,
      "end_frame": 2483,
      "keyframes": [
        "002220.webp",
        "002283.webp",
