        "000807.webp",
        "000827.webp",
        "000828.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bánh mì nóng, nóng giòn, giò anh thấy hợp đó nhưng mà em rau hơi sai rồi.",
