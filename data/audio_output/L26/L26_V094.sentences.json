        "003287.webp",
        "003314.webp",
        "003315.webp",
        "003362.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Các bạn nên phi thơm xuyên tiêu với một ít dầu ăn trước khi nấu giúp cho tăng cái mùi thơm đặc trưng của xuyên tiêu nha.",
      "start": 135.64,
      "end": 141.52,
      "n_words": 27,
      "start_frame": 3391,
      "end_frame": 3538,
      "keyframes": [
        "003410.webp",
        "003411.webp",
        "003472.webp",
        "003533.webp",
        "003534.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sau khi nghe xuyên tiêu dậy mùi thơm á, các bạn sẽ cho sườn vào nè, đảo sườn nè, mình đảo sườn một lượt.",
      "start": 141.52,
      "end": 155.0,
      "n_words": 24,
      "start_frame": 3538,
      "end_frame": 3875,
      "keyframes": [
        "003571.webp",
        "003608.webp",
        "003609.webp",
        "003643.webp",
        "003677.webp",
        "003678.webp",
        "003710.webp",
        "003742.webp",
        "003743.webp",
        "003786.webp",
        "003830.webp",
        "003831.webp",
        "003875.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Khi mà sườn non đã dậy lên mùi thơm thì chúng ta sẽ cho vào đây 1.5 lít nước, các bạn sẽ đậy nắp và nấu 10 phút.",
      "start": 160.76,
      "end": 168.64,
      "n_words": 28,
      "start_frame": 4019,
      "end_frame": 4216,
      "keyframes": [
        "004030.webp",
        "004139.webp",
        "004140.webp",
        "004179.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Các bạn nhìn thấy có quen thuộc không ạ? Đây là kỷ tử.",
      "start": 168.64,
      "end": 171.04,
      "n_words": 13,
      "start_frame": 4216,
      "end_frame": 4276,
      "keyframes": [
        "004218.webp",
        "004219.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thanh Phương rất là thích luôn bởi vì nó có vị ngọt nè, ngoài ra nó còn chứa vitamin A, vitamin C.",
      "start": 171.04,
      "end": 175.12,
      "n_words": 22,
      "start_frame": 4276,
      "end_frame": 4378,
      "keyframes": [
        "004337.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vitamin C giúp đẹp da mà còn bổ máu nữa ạ.",
      "start": 175.12,
      "end": 178.32,
      "n_words": 11,
      "start_frame": 4378,
      "end_frame": 4458,
      "keyframes": [
        "004456.webp",
        "004457.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Sau khi nấu sườn 10 phút, bây giờ chúng ta sẽ cho đẳng sâm, kỷ tử vào ninh cùng sườn nha.",
      "start": 178.32,
      "end": 183.56,
      "n_words": 21,
      "start_frame": 4458,
      "end_frame": 4589,
      "keyframes": [
        "004505.webp",
        "004553.webp",
        "004554.webp",
        "004568.webp",
        "004583.webp",
        "004584.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đầu tiên các bạn sẽ cho vào đây táo đỏ nè, theo sau táo đỏ đó là đẳng sâm rất bổ dưỡng và nấm đông cô.",
      "start": 183.56,
      "end": 192.08,
      "n_words": 26,
      "start_frame": 4589,
      "end_frame": 4802,
      "keyframes": [
        "004614.webp",
        "004644.webp",
        "004645.webp",
        "004663.webp",
        "004682.webp",
        "004683.webp",
        "004711.webp",
        "004739.webp",
        "004740.webp",
        "004769.webp",
        "004799.webp",
        "004800.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Đậy nắp tiếp tục các bạn nấu canh thêm 20 phút nữa.",
      "start": 192.08,
      "end": 196.2,
      "n_words": 12,
      "start_frame": 4802,
      "end_frame": 4905,
      "keyframes": [
        "004854.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Như vậy là 20 phút đã trôi qua, bây giờ chúng ta sẽ cho nấm kim châm và kỷ tử vào.",
      "start": 196.2,
      "end": 206.4,
      "n_words": 21,
      "start_frame": 4905,
      "end_frame": 5160,
      "keyframes": [
        "004908.webp",
        "004909.webp",
        "004971.webp",
        "005033.webp",
        "005034.webp",
        "005059.webp",
        "005084.webp",
        "005085.webp",
        "005125.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nêm vào đây một phần ba muỗng cà phê muối, hai muỗng cà phê hạt nêm Ajinomoto, một muỗng cà phê đường cát, cuối cùng là một muỗng cà phê bột ngọt Ajinomoto.",
      "start": 206.4,
      "end": 216.72,
      "n_words": 33,
      "start_frame": 5160,
      "end_frame": 5418,
      "keyframes": [
        "005165.webp",
        "005166.webp",
        "005191.webp",
        "005216.webp",
        "005217.webp",
        "005252.webp",
        "005287.webp",
        "005288.webp",
        "005316.webp",
        "005345.webp",
        "005346.webp",
        "005381.webp",
        "005417.webp",
        "005418.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Khởi động một lần nữa nè.",
      "start": 216.72,
      "end": 218.32,
      "n_words": 6,
      "start_frame": 5418,
      "end_frame": 5458,
      "keyframes": [
        "005418.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vâng, quả thật là một món canh thanh mát và bổ dưỡng, đúng là nấu chuẩn an lành.",
      "start": 218.32,
      "end": 223.04,
      "n_words": 18,
      "start_frame": 5458,
      "end_frame": 5576,
      "keyframes": [
        "005463.webp",
        "005509.webp",
        "005510.webp",
        "005542.webp",
        "005575.webp",
        "005576.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ chúng ta chuẩn bị tô để thưởng thức món canh sườn xuyên tiêu đặc biệt ngày hôm nay nhé. Và để xem lại công thức của món ăn này, chúng ta có thể quét mã QR đang hiển thị trên màn hình.",
      "start": 223.04,
      "end": 233.08,
      "n_words": 44,
      "start_frame": 5576,
      "end_frame": 5827,
      "keyframes": [
        "005576.webp",
        "005707.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ chúng ta sẽ trình bày món canh ra tô để thưởng thức cùng với cơm trắng, hấp dẫn quá luôn đấy ạ.",
      "start": 235.04,
      "end": 243.64,
      "n_words": 24,
      "start_frame": 5876,
      "end_frame": 6091,
      "keyframes": [
        "005889.webp",
        "005890.webp",
        "005938.webp",
        "005987.webp",
        "005988.webp",
        "006032.webp",
        "006076.webp",
        "006077.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Một bát canh rất nhiều màu sắc đúng không?",
      "start": 243.64,
      "end": 245.84,
      "n_words": 9,
      "start_frame": 6091,
      "end_frame": 6146,
      "keyframes": [
        "006123.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Màu đen của nấm đông cô rồi màu đỏ của táo đỏ, và cuối cùng canh thì không thể thiếu một ít rau nêm đó là hành lá và ngò rí.",
      "start": 247.44,
      "end": 262.44,
      "n_words": 31,
      "start_frame": 6186,
      "end_frame": 6561,
      "keyframes": [
        "006242.webp",
        "006314.webp",
