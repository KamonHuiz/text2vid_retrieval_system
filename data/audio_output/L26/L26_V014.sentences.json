        "003154.webp",
        "003162.webp",
        "003163.webp",
        "003193.webp",
        "003223.webp",
        "003224.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Phần rau mồng tơi thì các bạn chỉ cần cắt đôi thôi.",
      "start": 129.0,
      "end": 133.68,
      "n_words": 12,
      "start_frame": 3225,
      "end_frame": 3342,
      "keyframes": [
        "003260.webp",
        "003296.webp",
        "003297.webp",
        "003323.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ chúng ta sẽ đi ướp thịt ốc: cho vào đây 75 g giò sống, một muỗng cà phê gừng băm.",
      "start": 133.68,
      "end": 140.28,
      "n_words": 22,
      "start_frame": 3342,
      "end_frame": 3507,
      "keyframes": [
        "003349.webp",
        "003350.webp",
        "003374.webp",
        "003399.webp",
        "003400.webp",
        "003425.webp",
        "003450.webp",
        "003451.webp",
        "003479.webp",
        "003507.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Và có một điểm các bạn cần lưu ý trong món ăn ngày hôm nay đó là chọn ốc bươu cỡ vừa để thịt ốc nó không bị dai.",
      "start": 140.28,
      "end": 146.8,
      "n_words": 29,
      "start_frame": 3507,
      "end_frame": 3670,
      "keyframes": [
        "003507.webp",
        "003508.webp",
        "003589.webp",
        "003670.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trong thịt ốc thì có rất là nhiều omega-3 giúp điều hòa huyết áp, tăng tuần hoàn máu, từ đó giúp cho tim và mạch máu khỏe hơn.",
      "start": 146.8,
      "end": 153.64,
      "n_words": 28,
      "start_frame": 3670,
      "end_frame": 3841,
      "keyframes": [
        "003670.webp",
