        "003792.webp",
        "003816.webp",
        "003840.webp",
        "003841.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Bây giờ ta sẽ nhồi vào trong cái mướp, cắt bằng hai cái đầu này tại vì cái phần thịt ốc và phần giò sống nó sẽ nở ra.",
      "start": 153.64,
      "end": 163.68,
      "n_words": 29,
      "start_frame": 3841,
      "end_frame": 4092,
      "keyframes": [
        "003841.webp",
