        "005330.webp",
        "005356.webp",
        "005383.webp",
        "005384.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Với cách làm này thì chắc chắn là chúng ta không cần phải thêm bất kỳ một gia vị nào nữa.",
      "start": 215.4,
      "end": 219.6,
      "n_words": 21,
      "start_frame": 5385,
      "end_frame": 5490,
      "keyframes": [
        "005444.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đừng quên để lưu lại công thức của một món canh vừa nhanh gọn vừa hấp dẫn như thế này thì các bạn hãy dùng điện thoại quét mã QR đang hiển thị trên màn hình nhé.",
      "start": 220.24,
      "end": 230.52,
