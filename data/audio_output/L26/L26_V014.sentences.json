        "000893.webp",
        "000931.webp",
        "000932.webp"
      ],
      "keyframe_count": 16
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 41.96,
      "end": 45.92,
      "n_words": 11,
      "start_frame": 1049,
      "end_frame": 1148,
      "keyframes": [
        "001056.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Anh Quốc Nghị ơi, tháng này nhà mình vừa mua được một ít ốc bươu, sơ chế xong xuôi lấy thịt ra sẵn sàng luôn rồi.",
      "start": 45.92,
      "end": 53.12,
      "n_words": 26,
      "start_frame": 1148,
      "end_frame": 1328,
      "keyframes": [
        "001181.webp",
        "001182.webp",
        "001233.webp",
        "001284.webp",
        "001285.webp",
        "001305.webp",
        "001325.webp",
        "001326.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ chỉ đợi anh gợi ý một cái món nào ngon ngon nữa thôi.",
      "start": 53.12,
      "end": 56.0,
      "n_words": 15,
      "start_frame": 1328,
      "end_frame": 1400,
      "keyframes": [
        "001362.webp",
        "001398.webp",
        "001399.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nhắc đến thịt ốc bươu thì chế biến rất là nhiều món ngon, nhưng mà thịt ốc này hợp với lại mướp và mồng tơi, vậy nên hôm nay Quốc Nghị sẽ hướng dẫn các bạn khán giả của Món ngon mỗi ngày cùng với Minh Phương thực hiện món canh ốc mồng tơi.",
      "start": 56.0,
      "end": 67.56,
      "n_words": 54,
      "start_frame": 1400,
      "end_frame": 1689,
      "keyframes": [
        "001466.webp",
        "001533.webp",
        "001534.webp",
        "001610.webp",
        "001686.webp",
        "001687.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Theo chuyên gia dinh dưỡng á, thì món này giúp hỗ trợ sức khỏe tim và mạch máu các bạn nha.",
      "start": 67.56,
      "end": 72.48,
      "n_words": 21,
      "start_frame": 1689,
      "end_frame": 1812,
      "keyframes": [
        "001717.webp",
        "001747.webp",
        "001748.webp",
        "001777.webp",
        "001807.webp",
        "001808.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và Quốc Nghị đố Minh Phương một câu nè: cái ốc bươu chúng ta sẽ sơ chế như thế nào để bớt tanh nè, bớt nhớt nè?",
      "start": 72.48,
      "end": 78.76,
      "n_words": 27,
      "start_frame": 1812,
      "end_frame": 1969,
      "keyframes": [
        "001831.webp",
        "001854.webp",
        "001855.webp",
        "001868.webp",
        "001882.webp",
        "001883.webp",
        "001903.webp",
        "001923.webp",
        "001924.webp",
        "001945.webp",
        "001967.webp",
        "001968.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Thông thường khi mà chúng ta mua ốc bươu về thì rửa sạch, sau đó sẽ ngâm vào nước vo gạo.",
      "start": 78.76,
      "end": 84.56,
      "n_words": 21,
      "start_frame": 1969,
      "end_frame": 2114,
      "keyframes": [
        "002028.webp",
        "002088.webp",
        "002089.webp",
        "002106.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chính xác, để cho cái phần ốc sẽ nhả bớt cái cát bụi bẩn ra, có đúng không anh?",
      "start": 84.56,
      "end": 89.76,
      "n_words": 19,
      "start_frame": 2114,
      "end_frame": 2244,
      "keyframes": [
        "002123.webp",
        "002124.webp",
        "002156.webp",
        "002189.webp",
        "002190.webp",
        "002203.webp",
        "002216.webp",
        "002217.webp",
        "002230.webp",
        "002244.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Thịt ốc bươu chúng ta nên ngâm với nước pha một ít giấm khoảng 15 phút, sau đó rửa sạch để khử mùi tanh cũng như là cái độ nhờn của thịt.",
      "start": 89.76,
      "end": 96.88,
      "n_words": 32,
      "start_frame": 2244,
      "end_frame": 2422,
      "keyframes": [
        "002244.webp",
        "002245.webp",
        "002336.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mướp thì chúng ta nên chọn những cái mướp thân nó đều nha các bạn, nên chọn trái mướp suông đều, đường kính khoảng 3 centimet để khi làm viên mướp nó sẽ chín đều và đẹp mắt hơn.",
      "start": 97.16,
      "end": 107.04,
      "n_words": 39,
      "start_frame": 2429,
      "end_frame": 2676,
      "keyframes": [
        "002467.webp",
        "002507.webp",
        "002508.webp",
        "002590.webp",
        "002672.webp",
        "002673.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tiếp theo, chúng ta sẽ dùng muỗng nạo cái phần ruột mướp ra.",
      "start": 107.04,
      "end": 110.08,
      "n_words": 13,
      "start_frame": 2676,
      "end_frame": 2752,
      "keyframes": [
        "002711.webp",
        "002750.webp",
        "002751.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Lát nữa là anh Nghị sẽ nhồi cái thịt ốc vào đúng không?",
      "start": 110.08,
      "end": 112.56,
      "n_words": 13,
      "start_frame": 2752,
      "end_frame": 2814,
      "keyframes": [
        "002781.webp",
        "002811.webp",
        "002812.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đó là một cái sự biến tấu trong món ăn ngày hôm nay.",
      "start": 112.56,
      "end": 114.72,
      "n_words": 13,
      "start_frame": 2814,
      "end_frame": 2868,
      "keyframes": [
        "002839.webp",
        "002866.webp",
        "002867.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Với cái phần mướp ngày hôm nay thì Minh Phương thấy là anh Quốc Nghị lựa cái trái nó không có quá già đúng không?",
      "start": 114.72,
      "end": 120.28,
      "n_words": 25,
      "start_frame": 2868,
      "end_frame": 3007,
      "keyframes": [
        "002942.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, trong mướp thì có rất là nhiều vitamin B5 giúp giảm cholesterol trong máu, từ đó hỗ trợ ngăn ngừa các bệnh về tim mạch rất tốt.",
      "start": 120.28,
      "end": 129.0,
      "n_words": 29,
      "start_frame": 3007,
      "end_frame": 3225,
      "keyframes": [
        "003017.webp",
        "003018.webp",
        "003037.webp",
        "003057.webp",
        "003058.webp",
        "003101.webp",
        "003145.webp",
