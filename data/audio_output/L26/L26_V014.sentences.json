        "005041.webp",
        "005069.webp",
        "005070.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Nước sôi lại nè, chúng ta sẽ cho lần lượt những cái mướp mà nhồi chả ốc vào nè.",
      "start": 202.88,
      "end": 207.56,
      "n_words": 19,
      "start_frame": 5072,
      "end_frame": 5189,
      "keyframes": [
        "005085.webp",
        "005101.webp",
        "005102.webp",
        "005145.webp",
        "005189.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sau khi quan sát thấy mướp vừa chín tới thì các bạn sẽ cho rau mồng tơi vào, nên chỉ cần nước canh nó sôi lại là được.",
      "start": 207.56,
      "end": 215.4,
      "n_words": 28,
      "start_frame": 5189,
      "end_frame": 5385,
      "keyframes": [
        "005189.webp",
