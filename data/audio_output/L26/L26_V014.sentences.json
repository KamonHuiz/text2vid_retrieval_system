        "004006.webp",
        "004047.webp",
        "004048.webp",
        "004071.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Bây giờ chúng ta nấu canh.",
      "start": 163.68,
      "end": 165.28,
      "n_words": 6,
      "start_frame": 4092,
      "end_frame": 4132,
      "keyframes": [
        "004094.webp",
        "004095.webp",
        "004124.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn sẽ cho vào đây một muỗng cà phê hành tím băm, đảo đều cho hành tím nó dậy mùi thơm nè.",
      "start": 165.92,
      "end": 171.08,
      "n_words": 23,
      "start_frame": 4148,
      "end_frame": 4277,
      "keyframes": [
