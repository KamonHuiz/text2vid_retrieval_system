      "start_frame": 5506,
      "end_frame": 5763,
      "keyframes": [
        "005610.webp",
        "005715.webp",
        "005716.webp",
        "005740.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thật sự cái mùi thơm của riêu cua mà nó ngào ngạt, nó ngào ngạt cả căn bếp luôn đó Minh Phương.",
      "start": 230.52,
