        "000898.webp",
        "000959.webp",
        "000960.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Nấm mỡ cũng kháng stress oxy hóa hả cô Hà?",
      "start": 39.0,
      "end": 41.8,
      "n_words": 10,
      "start_frame": 975,
      "end_frame": 1045,
      "keyframes": [
        "001002.webp",
        "001045.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Vậy ngày hôm nay chúng ta sẽ có cà rốt kết hợp với nấm mỡ như vậy là cái món ăn này sẽ bổ gấp đôi luôn và ngon luôn gấp đôi phải không cô?",
      "start": 41.8,
