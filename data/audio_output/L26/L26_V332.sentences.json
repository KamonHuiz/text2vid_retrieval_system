      "keyframes": [
        "003061.webp",
        "003062.webp",
        "003101.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tên của món ăn là canh gà nấm mỡ, nghe rất là đơn giản phải không ạ?",
