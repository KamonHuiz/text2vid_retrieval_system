        "001222.webp",
        "001223.webp",
        "001256.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi giờ mình làm nha, canh gà nấm mỡ bắt mắt như mộng, vị đỉnh như mơ.",
      "start": 50.6,
      "end": 73.84,
