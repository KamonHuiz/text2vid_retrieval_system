      "start_frame": 4853,
      "end_frame": 4903,
      "keyframes": [
        "004900.webp",
        "004901.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ á thì cuộn gà chín rồi đó, bây giờ mình sẽ vớt cái cuộn gà ra nha.",
      "start": 196.12,
      "end": 200.88,
