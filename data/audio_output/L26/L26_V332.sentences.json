      "start_frame": 2024,
      "end_frame": 2145,
      "keyframes": [
        "002082.webp",
        "002144.webp",
        "002145.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn lưu ý là chúng ta lạng mỏng đều miếng má đùi gà trước khi cuốn giúp định hình món ăn đẹp hơn nhé.",
      "start": 85.8,
      "end": 91.52,
      "n_words": 25,
      "start_frame": 2145,
      "end_frame": 2288,
      "keyframes": [
        "002145.webp",
        "002215.webp",
        "002286.webp",
        "002287.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cô sẽ cho vào đây một ít tiêu, tiếp theo thì mình sẽ cho vào đây một muỗng cà phê hạt nêm Aji-ngon gà.",
      "start": 91.52,
      "end": 96.96,
      "n_words": 24,
      "start_frame": 2288,
      "end_frame": 2424,
      "keyframes": [
        "002308.webp",
