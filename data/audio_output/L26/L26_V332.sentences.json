        "003633.webp",
        "003634.webp",
        "003682.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Rồi trong lúc đó thì mình đun sôi lên một lít hai nước.",
      "start": 147.28,
      "end": 151.16,
      "n_words": 13,
