        "002739.webp",
        "002812.webp",
        "002813.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Cà rốt mình sẽ cắt que như thế này, mình cho lên đây.",
      "start": 112.64,
      "end": 115.2,
      "n_words": 13,
      "start_frame": 2816,
      "end_frame": 2880,
      "keyframes": [
        "002846.webp",
        "002880.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ở đây là mình dùng tôm, mà tôm sú đông lạnh, sú đông lạnh á, sau đó thì mình sẽ cuộn lại đó.",
      "start": 115.2,
      "end": 122.4,
      "n_words": 23,
      "start_frame": 2880,
      "end_frame": 3060,
      "keyframes": [
