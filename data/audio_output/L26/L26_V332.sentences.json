        "003450.webp",
        "003499.webp",
        "003500.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Rồi mình cuộn cái cuộn thứ hai nữa rồi mình sẽ lấy hành mình cột lại.",
      "start": 140.32,
      "end": 147.28,
