        "002363.webp",
        "002364.webp",
        "002415.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Mình ướp cái này nó hơi đậm vị một chút vì chút nữa mình sẽ luộc cho nó thấm gia vị.",
      "start": 96.96,
      "end": 102.64,
      "n_words": 21,
