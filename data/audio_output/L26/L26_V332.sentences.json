      "n_words": 22,
      "start_frame": 1854,
      "end_frame": 2024,
      "keyframes": [
        "001932.webp",
        "002020.webp",
        "002021.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình sẽ có hai cái miếng má đùi gà như thế này, mình sẽ lóc bỏ xương đi.",
      "start": 80.96,
      "end": 85.8,
