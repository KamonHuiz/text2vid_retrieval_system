        "003140.webp",
        "003141.webp",
        "003216.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nhưng mà với cái phần chế biến của thịt gà cô Hà còn có cuộn vào cà rốt và có con tôm ở bên trong, còn có thêm phần giò sống nữa thì cái phần thịt trong canh của ngày hôm nay sẽ rất là ngon.",
      "start": 128.68,
      "end": 140.32,
      "n_words": 46,
      "start_frame": 3217,
      "end_frame": 3508,
      "keyframes": [
        "003292.webp",
