        "002992.webp",
        "002993.webp",
        "003027.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Mình sẽ dùng hành lá mình cột lại đây.",
      "start": 122.4,
      "end": 124.52,
      "n_words": 9,
      "start_frame": 3060,
