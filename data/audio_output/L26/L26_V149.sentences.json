        "005866.webp",
        "005938.webp",
        "005939.webp",
        "005963.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ thì chúng ta sẽ trình bày bánh ra đĩa nha.",
      "start": 239.28,
      "end": 246.44,
      "n_words": 12,
      "start_frame": 5982,
      "end_frame": 6161,
      "keyframes": [
        "005988.webp",
        "005989.webp",
        "006021.webp",
        "006054.webp",
        "006055.webp",
        "006099.webp",
        "006143.webp",
        "006144.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chiếc bánh kếp này vừa thơm ngon lại cực kỳ hấp dẫn, bổ dưỡng, tốt cho sức khỏe.",
      "start": 246.44,
