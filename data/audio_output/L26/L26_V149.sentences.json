        "000881.webp",
        "000882.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 39.68,
      "end": 44.0,
      "n_words": 11,
