      "end": 32.52,
      "n_words": 7,
      "start_frame": 763,
      "end_frame": 813,
      "keyframes": [
        "000792.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đảm bảo là ăn với rau rừng này là sẽ rất là tuyệt vời luôn.",
      "start": 32.52,
      "end": 38.2,
      "n_words": 15,
      "start_frame": 813,
      "end_frame": 955,
      "keyframes": [
        "000830.webp",
        "000831.webp",
        "000859.webp",
        "000887.webp",
        "000888.webp",
        "000897.webp",
        "000907.webp",
        "000908.webp",
        "000932.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Bánh xèo hải sản, giòn ngon, mỹ mãn.",
      "start": 38.2,
      "end": 56.84,
      "n_words": 8,
      "start_frame": 955,
      "end_frame": 1421,
      "keyframes": [
        "000957.webp",
