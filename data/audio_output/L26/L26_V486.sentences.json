        "003415.webp",
        "003416.webp",
        "003471.webp",
        "003527.webp",
        "003528.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ phi hành tỏi với dầu ăn cho thơm rồi lấy dầu đó chiên bánh xèo để bánh được thơm ngon nha.",
      "start": 141.12,
      "end": 147.24,
      "n_words": 29,
      "start_frame": 3528,
