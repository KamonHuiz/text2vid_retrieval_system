      "end": 19.64,
      "n_words": 6,
      "start_frame": 443,
      "end_frame": 491,
      "keyframes": [
        "000455.webp",
        "000483.webp",
        "000484.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thịt heo luộc quá hả?",
      "start": 19.64,
      "end": 22.04,
      "n_words": 5,
      "start_frame": 491,
      "end_frame": 551,
      "keyframes": [
        "000519.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em nghĩ cái món đó nó thường quá rồi, thôi bây giờ mình làm một cái món nào nó mới lạ đi, là chắc phải nhờ cô rồi đó.",
      "start": 22.04,
      "end": 28.68,
      "n_words": 29,
      "start_frame": 551,
      "end_frame": 717,
      "keyframes": [
        "000554.webp",
