        "000573.webp",
        "000592.webp",
        "000593.webp",
        "000655.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hay hải sản đi cô?",
      "start": 28.68,
      "end": 30.52,
      "n_words": 5,
      "start_frame": 717,
      "end_frame": 763,
      "keyframes": [
        "000718.webp",
        "000719.webp",
        "000736.webp",
        "000753.webp",
        "000754.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi cô nghĩ ra món gì rồi?",
