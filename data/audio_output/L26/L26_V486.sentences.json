      "end_frame": 3243,
      "keyframes": [
        "003161.webp",
        "003162.webp",
        "003200.webp",
        "003238.webp",
        "003239.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ cho vào đây khoảng chừng một chén dầu ăn, mình đun cho dầu vừa nóng thôi, không có đợi phải sôi thì mình sẽ cho vào đây là một ít cái hành và tỏi đập dập.",
      "start": 129.72,
      "end": 141.12,
      "n_words": 39,
      "start_frame": 3243,
      "end_frame": 3528,
      "keyframes": [
