      "start_frame": 4315,
      "end_frame": 4355,
      "keyframes": [
        "004334.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi mình đợi cho cái chảo nóng lên xíu á, rồi cô sẽ cho lên đây dầu, láng dầu khắp chảo cho đều.",
      "start": 174.2,
      "end": 181.28,
      "n_words": 23,
      "start_frame": 4355,
      "end_frame": 4532,
      "keyframes": [
        "004357.webp",
