        "003596.webp",
        "003622.webp",
        "003623.webp",
        "003652.webp",
        "003681.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Múc một ít dầu cho vô chảo rồi cô sẽ cho cái phần tôm vào đây, mình xào tôm.",
      "start": 147.24,
      "end": 152.72,
      "n_words": 19,
      "start_frame": 3681,
      "end_frame": 3818,
      "keyframes": [
        "003681.webp",
