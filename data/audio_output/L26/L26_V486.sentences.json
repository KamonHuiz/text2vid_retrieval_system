      "end_frame": 3161,
      "keyframes": [
        "003067.webp",
        "003068.webp",
        "003114.webp",
        "003161.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Còn cái phần rau củ quả nè, trời ơi có củ sắn nữa.",
      "start": 126.44,
      "end": 129.72,
      "n_words": 13,
