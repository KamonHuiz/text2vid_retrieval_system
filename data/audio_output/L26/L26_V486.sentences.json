        "004724.webp",
        "004757.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi, tiếp theo cho vào đây tôm và mực, cho rau giá vào trong này.",
      "start": 190.56,
      "end": 196.2,
      "n_words": 16,
      "start_frame": 4764,
      "end_frame": 4905,
      "keyframes": [
