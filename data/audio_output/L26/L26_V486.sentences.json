        "003020.webp",
        "003043.webp",
        "003067.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Bánh xèo này chất lượng quá, tôm mực là tươi ngon luôn.",
      "start": 122.68,
      "end": 126.44,
      "n_words": 12,
