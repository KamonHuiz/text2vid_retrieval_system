      "end_frame": 299,
      "keyframes": [
        "000299.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trà Thanh Phương, một rổ rau xanh tươi luôn nè.",
      "start": 11.96,
      "end": 14.64,
      "n_words": 10,
      "start_frame": 299,
      "end_frame": 366,
      "keyframes": [
        "000299.webp",
        "000300.webp",
        "000313.webp",
        "000326.webp",
        "000327.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cô rau rừng đó cô?",
