        "001685.webp",
        "001720.webp",
        "001721.webp",
        "001743.webp",
        "001765.webp",
        "001766.webp",
        "001799.webp",
        "001832.webp",
        "001833.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Tiếp theo thì cô sẽ cho vào đây một quả trứng gà, trứng gà mình đã đánh tan qua cái rây và mình nêm vào đây một muỗng cà phê hạt nêm Ajinomoto ngon heo, cho vào đây một ít hành lá cắt nhỏ.",
      "start": 73.44,
      "end": 83.8,
      "n_words": 44,
      "start_frame": 1836,
      "end_frame": 2095,
      "keyframes": [
        "001894.webp",
