        "001124.webp",
        "001134.webp",
        "001168.webp",
        "001203.webp",
        "001204.webp",
        "001318.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 56.84,
      "end": 59.2,
      "n_words": 13,
      "start_frame": 1421,
      "end_frame": 1480,
      "keyframes": [
        "001432.webp",
        "001433.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Ngon mỗi ngày được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 59.2,
      "end": 63.52,
      "n_words": 12,
      "start_frame": 1480,
      "end_frame": 1588,
      "keyframes": [
        "001510.webp",
        "001588.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi đầu tiên thì mình sẽ pha bột ha.",
      "start": 63.52,
      "end": 65.72,
      "n_words": 9,
      "start_frame": 1588,
      "end_frame": 1643,
      "keyframes": [
        "001588.webp",
        "001589.webp",
        "001616.webp",
        "001643.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cô chuẩn bị là 200 gram bột bánh xèo, có 200 ml nước cốt dừa, cô cho thêm khoảng 250 ml nước nữa.",
      "start": 65.72,
      "end": 73.44,
      "n_words": 23,
      "start_frame": 1643,
      "end_frame": 1836,
      "keyframes": [
        "001643.webp",
        "001644.webp",
        "001646.webp",
