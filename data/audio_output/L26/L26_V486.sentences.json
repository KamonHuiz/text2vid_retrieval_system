        "001957.webp",
        "001997.webp",
        "002038.webp",
        "002039.webp",
        "002067.webp",
        "002095.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Và các bạn cũng lưu ý là sau khi mà mình pha bột xong thì chúng ta sẽ để cho bột nghỉ khoảng chừng 30 phút đến một tiếng, bánh xèo sẽ phồng xốp ngon hơn.",
      "start": 83.8,
      "end": 92.44,
      "n_words": 36,
      "start_frame": 2095,
      "end_frame": 2311,
      "keyframes": [
        "002095.webp",
        "002096.webp",
        "002175.webp",
        "002254.webp",
        "002255.webp",
        "002282.webp",
        "002309.webp",
        "002310.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Tôm cô đã sơ chế sạch, mực cũng đã sơ chế sạch luôn.",
      "start": 92.44,
      "end": 95.04,
      "n_words": 13,
      "start_frame": 2311,
      "end_frame": 2376,
      "keyframes": [
        "002342.webp",
        "002374.webp",
        "002375.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong món ăn này thì các bạn lưu ý là chúng ta sẽ dùng tôm bạc hoặc là tôm đất thì món ăn sẽ ngon hơn.",
      "start": 95.04,
      "end": 100.08,
      "n_words": 26,
      "start_frame": 2376,
      "end_frame": 2502,
      "keyframes": [
        "002437.webp",
        "002499.webp",
        "002500.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hải sản là mình phải cho chút xíu tiêu ha và nửa muỗng cà phê hạt nêm Ajinomoto ngon heo.",
      "start": 100.08,
      "end": 105.12,
      "n_words": 20,
      "start_frame": 2502,
      "end_frame": 2628,
      "keyframes": [
        "002527.webp",
        "002554.webp",
        "002555.webp",
        "002590.webp",
        "002626.webp",
        "002627.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trong lúc mà chờ tôm và mực thấm gia vị thì chúng ta sẽ sơ chế đến cái phần rau củ.",
      "start": 105.12,
      "end": 110.24,
