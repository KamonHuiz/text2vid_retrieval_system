        "001464.webp",
        "001504.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Đúng rồi, trong ngày Noel chúng ta phải làm cái gì đó hoành tráng một tí xíu đúng không các bạn?",
      "start": 61.16,
