        "001505.webp",
        "001566.webp",
        "001567.webp",
        "001653.webp"
      ],
      "keyframe_count": 19
    },
    {
      "text": "Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 67.84,
      "end": 72.32,
      "n_words": 13,
      "start_frame": 1696,
      "end_frame": 1808,
      "keyframes": [
        "001740.webp",
        "001741.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 72.32,
      "end": 76.4,
      "n_words": 11,
      "start_frame": 1808,
      "end_frame": 1910,
      "keyframes": [
        "001828.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ đầu tiên em cắt giùm cô măng tây cắt khúc 5 phân.",
      "start": 76.4,
      "end": 80.2,
      "n_words": 14,
      "start_frame": 1910,
      "end_frame": 2005,
      "keyframes": [
        "001915.webp",
        "001916.webp",
        "001938.webp",
        "001961.webp",
        "001962.webp",
        "001981.webp",
        "002001.webp",
        "002002.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mà cô Hà ơi, cô Hà chỉ cho em biết cách chọn măng tây được không?",
      "start": 80.2,
      "end": 83.68,
      "n_words": 16,
      "start_frame": 2005,
      "end_frame": 2092,
      "keyframes": [
        "002015.webp",
        "002028.webp",
        "002029.webp",
        "002059.webp",
        "002090.webp",
        "002091.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Kim Thảo và các bạn lưu ý là chúng ta sẽ chọn măng tây có màu xanh mướt nè, suông nè và mập mạp, phần gốc không có bị teo héo là măng tây ngon á cô.",
      "start": 83.68,
      "end": 92.56,
      "n_words": 37,
      "start_frame": 2092,
      "end_frame": 2314,
      "keyframes": [
        "002199.webp",
        "002307.webp",
        "002308.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đã bào bỏ bớt cái phần già bên ngoài và giữ lại cái phần ruột bên trong mình vẫn sử dụng rồi.",
      "start": 92.56,
      "end": 97.84,
      "n_words": 22,
      "start_frame": 2314,
      "end_frame": 2446,
      "keyframes": [
        "002360.webp",
        "002412.webp",
        "002413.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ ớt chuông, hành tây mình cắt quả trám.",
      "start": 97.84,
      "end": 102.48,
      "n_words": 10,
      "start_frame": 2446,
      "end_frame": 2562,
      "keyframes": [
        "002447.webp",
        "002481.webp",
        "002482.webp",
        "002508.webp",
        "002535.webp",
        "002536.webp",
        "002548.webp",
        "002560.webp",
        "002561.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Em thấy là trong rau củ quả đó cô chú ý chọn cả màu sắc nữa cho nên là khi mình cho vào chung với nhau á cô là em thấy cái món ăn của mình nó hấp dẫn, nó bắt mắt lắm.",
      "start": 102.48,
      "end": 113.56,
      "n_words": 43,
      "start_frame": 2562,
      "end_frame": 2839,
      "keyframes": [
        "002576.webp",
        "002592.webp",
        "002593.webp",
        "002612.webp",
        "002631.webp",
        "002632.webp",
        "002671.webp",
        "002711.webp",
        "002712.webp",
        "002747.webp",
        "002783.webp",
        "002784.webp",
        "002811.webp",
        "002839.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Nồi nước này là để cho chúng ta sẽ trần bắp nè và măng tây, cô sẽ cho vào đây chút xíu muối đợi nước sôi ha.",
      "start": 113.56,
      "end": 120.96,
      "n_words": 27,
      "start_frame": 2839,
      "end_frame": 3024,
      "keyframes": [
        "002839.webp",
        "002840.webp",
        "002899.webp",
        "002958.webp",
        "002959.webp",
        "002991.webp",
        "003023.webp",
        "003024.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta sẽ sơ chế đến hải sản mực, bây giờ thì mình sẽ khứa caro ở mặt trong.",
      "start": 120.96,
      "end": 125.84,
      "n_words": 19,
      "start_frame": 3024,
      "end_frame": 3146,
      "keyframes": [
        "003024.webp",
        "003046.webp",
        "003069.webp",
        "003070.webp",
        "003106.webp",
        "003143.webp",
        "003144.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cô Hà tâm lý quá trời luôn khi mà kết hợp măng tây cùng với tôm và mực là hai loại hải sản rất là dễ ăn và hầu như là ai cũng rất là thích đó cô Hà.",
      "start": 125.84,
      "end": 135.64,
      "n_words": 39,
      "start_frame": 3146,
      "end_frame": 3391,
      "keyframes": [
        "003199.webp",
        "003254.webp",
        "003255.webp",
        "003343.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Với lại thực ra đó thì cô cũng thích ăn hải sản một chút bởi vì hải sản nó cũng không có quá nhiều cái chất béo, vừa có nhiều canxi nữa.",
      "start": 135.64,
      "end": 142.88,
      "n_words": 32,
      "start_frame": 3391,
      "end_frame": 3572,
      "keyframes": [
        "003431.webp",
        "003432.webp",
        "003487.webp",
        "003543.webp",
        "003544.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Nước sôi rồi, bỏ bắp vô em trụng trước cho cô đi khoảng 5 phút đi.",
      "start": 142.88,
      "end": 146.56,
      "n_words": 16,
      "start_frame": 3572,
      "end_frame": 3664,
      "keyframes": [
        "003588.webp",
        "003633.webp",
        "003634.webp",
        "003647.webp",
        "003660.webp",
        "003661.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ chúng ta sẽ cho tôm vào chung với mực và mình sẽ ướp gia vị, mình sẽ cho vào đây một ít tiêu, một ít hạt nêm Aji-ngon heo, dạ cuối cùng một ít dầu hào, mình sẽ trộn đều lên rồi vớt bắp ra ha em ha, măng tây mình chỉ cần nhanh qua thôi.",
      "start": 146.56,
      "end": 162.8,
      "n_words": 58,
      "start_frame": 3664,
      "end_frame": 4070,
      "keyframes": [
        "003712.webp",
        "003763.webp",
        "003764.webp",
        "003786.webp",
        "003809.webp",
