        "004573.webp",
        "004641.webp",
        "004709.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Bây giờ thì chảo nóng rồi, mình sẽ cho dầu ăn vào đây, cho vào một ít hành và tỏi băm rồi cho hải sản vô đây xào thơm quá.",
      "start": 188.36,
      "end": 200.16,
      "n_words": 30,
      "start_frame": 4709,
      "end_frame": 5004,
      "keyframes": [
        "004709.webp",
