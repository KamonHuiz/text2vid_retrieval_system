        "004454.webp",
        "004455.webp",
        "004483.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ trộn bột năng khô vào hải sản để giúp cho hải sản không bị mất nước thì như vậy thì sẽ giữ được độ ngọt nè và không bị dai.",
      "start": 179.44,
      "end": 188.36,
      "n_words": 38,
      "start_frame": 4486,
      "end_frame": 4709,
      "keyframes": [
        "004512.webp",
