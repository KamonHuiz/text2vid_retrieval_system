        "004045.webp",
        "004069.webp",
        "004070.webp"
      ],
      "keyframe_count": 21
    },
    {
      "text": "Đúng rồi, cái măng tây ra để một bên với lại bắp chừng khô rồi.",
      "start": 162.8,
      "end": 166.56,
      "n_words": 15,
      "start_frame": 4070,
      "end_frame": 4164,
      "keyframes": [
        "004070.webp",
        "004112.webp",
        "004154.webp",
        "004155.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ thì cô sẽ đặt chảo lên trên bếp, em mở lửa giúp cô.",
      "start": 166.56,
      "end": 169.6,
      "n_words": 15,
      "start_frame": 4164,
      "end_frame": 4240,
      "keyframes": [
        "004196.webp",
        "004238.webp",
        "004239.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong lúc chờ chảo nóng thì các bạn lưu ý nè, chúng ta sẽ trộn vào trong cái phần hải sản này gồm có một muỗng cà phê bột năng trộn với dạng khô nha.",
      "start": 169.6,
      "end": 179.44,
      "n_words": 35,
      "start_frame": 4240,
      "end_frame": 4486,
      "keyframes": [
        "004273.webp",
