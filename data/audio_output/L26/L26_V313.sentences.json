        "005675.webp",
        "005705.webp",
        "005706.webp",
        "005751.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Những rau củ này rất là nhanh chín, ngoại trừ bắp, chín ngoại trừ bắp thì mình đã trần rồi ha.",
      "start": 231.8,
      "end": 235.76,
      "n_words": 21,
      "start_frame": 5795,
      "end_frame": 5894,
      "keyframes": [
        "005796.webp",
