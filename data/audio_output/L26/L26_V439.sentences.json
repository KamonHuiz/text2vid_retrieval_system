        "003871.webp",
        "003872.webp",
        "003909.webp",
        "003946.webp",
        "003947.webp",
        "003978.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Đúng rồi.",
      "start": 159.88,
      "end": 160.48,
      "n_words": 2,
      "start_frame": 3997,
      "end_frame": 4012,
      "keyframes": [
        "004009.webp",
        "004010.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nấm mèo thì chúng ta sẽ cắt sợi, hành tây thì mình sẽ cắt múi, rau ôm và ngò gai mình cũng sẽ cắt khúc.",
      "start": 160.48,
      "end": 169.56,
      "n_words": 25,
      "start_frame": 4012,
      "end_frame": 4239,
      "keyframes": [
        "004041.webp",
