        "004139.webp",
        "004140.webp",
        "004192.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Vậy là chúng ta đã sơ chế xong các nguyên liệu và bây giờ là chúng ta chỉ cần bật chảo lên và chúng ta sẽ xào ốc.",
      "start": 169.84,
      "end": 175.4,
      "n_words": 28,
      "start_frame": 4246,
      "end_frame": 4385,
      "keyframes": [
        "004246.webp",
