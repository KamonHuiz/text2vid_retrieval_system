        "005837.webp",
        "005862.webp",
        "005863.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Mình sẽ múc ra dĩa, nước này chỉ hơi ít thôi ha, sâm sấp thôi.",
      "start": 234.92,
      "end": 241.76,
