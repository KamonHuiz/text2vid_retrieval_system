        "002247.webp",
        "002276.webp",
        "002277.webp",
        "002298.webp",
        "002319.webp",
        "002320.webp",
        "002372.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Em là thấy sả với lại là có cà ri là em thấy hấp dẫn.",
      "start": 95.52,
      "end": 100.0,
      "n_words": 15,
      "start_frame": 2388,
      "end_frame": 2500,
      "keyframes": [
        "002424.webp",
        "002425.webp",
        "002458.webp",
        "002492.webp",
        "002493.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đây là một cái đặc trưng của các cái món xào lăn.",
      "start": 100.0,
      "end": 103.92,
      "n_words": 12,
      "start_frame": 2500,
      "end_frame": 2598,
      "keyframes": [
        "002540.webp",
        "002588.webp",
        "002589.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong lúc chờ ốc thấm gia vị thì chúng ta sẽ sơ chế các nguyên liệu khác.",
      "start": 103.92,
      "end": 107.64,
      "n_words": 17,
      "start_frame": 2598,
      "end_frame": 2691,
      "keyframes": [
        "002638.webp",
        "002688.webp",
        "002689.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tuấn và các bạn quan sát là đối với món ăn này thì chúng ta sẽ chọn lá cách bánh tẻ, tức là lá cách không quá non cũng không quá già thì món ăn sẽ ngon hơn.",
      "start": 107.64,
      "end": 116.88,
      "n_words": 38,
      "start_frame": 2691,
      "end_frame": 2922,
      "keyframes": [
        "002804.webp",
        "002920.webp",
        "002921.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Giờ em cắt, giờ em cắt dày khoảng chừng một phân cho cô ha.",
      "start": 117.04,
      "end": 120.2,
      "n_words": 14,
      "start_frame": 2926,
      "end_frame": 3005,
      "keyframes": [
        "002977.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi tiếp theo là bún tàu thì chúng ta sẽ ngâm mềm, chúng ta ngâm với nước lạnh thôi cho vừa mềm thôi, bây giờ mình sẽ cắt khúc khoảng chừng năm phân đây, đã xong rồi.",
      "start": 120.2,
      "end": 136.4,
      "n_words": 37,
      "start_frame": 3005,
      "end_frame": 3410,
      "keyframes": [
        "003033.webp",
