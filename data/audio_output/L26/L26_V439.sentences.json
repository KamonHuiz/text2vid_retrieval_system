      "end": 204.32,
      "n_words": 7,
      "start_frame": 5060,
      "end_frame": 5108,
      "keyframes": [
        "005060.webp",
        "005061.webp",
        "005083.webp",
        "005106.webp",
        "005107.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cô sẽ cho tiếp vào đây một muỗng cà phê đường, một muỗng cà phê hạt nêm Ajinomoto ngon gà.",
      "start": 204.32,
      "end": 211.44,
      "n_words": 20,
      "start_frame": 5108,
      "end_frame": 5286,
      "keyframes": [
        "005159.webp",
        "005212.webp",
