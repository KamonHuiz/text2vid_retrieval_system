        "004677.webp",
        "004724.webp",
        "004725.webp",
        "004778.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rồi cô sẽ cho vào đây khoảng chừng một chén nước cốt dừa, tiếp tục cô cho cái phần bạc hà và nấm mèo vô luôn, bún tàu, hành tây luôn.",
      "start": 193.2,
      "end": 202.4,
      "n_words": 31,
      "start_frame": 4830,
      "end_frame": 5060,
      "keyframes": [
        "004832.webp",
