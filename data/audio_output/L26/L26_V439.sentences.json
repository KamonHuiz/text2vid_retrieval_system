        "005249.webp",
        "005285.webp",
        "005286.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cuối cùng cô cho vào đây là đầu hành lá nè, rau ôm, ngò gai, ớt sừng và cả lá cách nữa.",
      "start": 211.44,
