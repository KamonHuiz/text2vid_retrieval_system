      "end_frame": 1330,
      "keyframes": [
        "001159.webp",
        "001325.webp",
        "001326.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đầu tiên thì chúng ta sẽ dùng bột bánh crepe pha sẵn vị truyền thống một gói.",
      "start": 53.2,
      "end": 58.08,
