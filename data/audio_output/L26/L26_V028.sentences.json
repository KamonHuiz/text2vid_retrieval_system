        "004248.webp",
        "004309.webp",
        "004310.webp",
        "004334.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Cuối cùng Hưng sẽ cho vào đây một muỗng rưỡi canh nước mắm, một ít rau nêm nè và ớt sừng cắt lát nè, ớt hiểm đập rạch nè. Chúng ta sẽ tắt bếp.",
      "start": 174.32,
      "end": 186.88,
      "n_words": 34,
      "start_frame": 4358,
      "end_frame": 4672,
      "keyframes": [
        "004359.webp",
        "004360.webp",
        "004408.webp",
        "004457.webp",
        "004458.webp",
        "004511.webp",
        "004564.webp",
        "004565.webp",
        "004621.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nhanh gọn trong tích tắc chúng ta đã có một nồi canh chua rất là hấp dẫn, đầy đủ màu sắc và mùi thơm.",
      "start": 186.88,
      "end": 192.68,
      "n_words": 24,
      "start_frame": 4672,
      "end_frame": 4817,
      "keyframes": [
        "004677.webp",
        "004678.webp",
        "004800.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì thiệt sự phải nói luôn là chắc có lẽ là làm cho mọi người phải đói bụng ngay lập tức.",
      "start": 192.68,
      "end": 196.92,
      "n_words": 21,
      "start_frame": 4817,
      "end_frame": 4923,
      "keyframes": [
        "004923.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Để xem lại công thức của món ăn ngày hôm nay, các bạn chỉ cần lấy điện thoại ra và quét mã QR trên màn hình của chúng tôi.",
      "start": 196.92,
      "end": 204.56,
      "n_words": 29,
