        "000960.webp",
        "000961.webp",
        "000997.webp"
      ],
      "keyframe_count": 21
    },
    {
      "text": "Rất vui được gặp lại các bạn khán giả đang đến với chương trình Món ngon mỗi ngày, nấu chuẩn ăn lành.",
      "start": 41.04,
      "end": 46.56,
      "n_words": 22,
      "start_frame": 1026,
      "end_frame": 1164,
      "keyframes": [
        "001034.webp",
        "001035.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam. Chào Phước Hưng, chào Kim Thảo.",
      "start": 46.56,
      "end": 52.76,
      "n_words": 17,
      "start_frame": 1164,
      "end_frame": 1319,
      "keyframes": [
        "001193.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và ngày hôm nay, Kim Thảo đã đi chợ thấy lươn rất là ngon, sau đó là đưa cho Phước Hưng.",
      "start": 52.76,
      "end": 57.52,
      "n_words": 21,
      "start_frame": 1319,
      "end_frame": 1438,
      "keyframes": [
        "001352.webp",
        "001353.webp",
        "001373.webp",
        "001393.webp",
        "001394.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đã chuẩn bị thêm là bông bồn, không biết có sự kết hợp gì đặc biệt dữ vậy ta?",
      "start": 57.52,
      "end": 61.24,
      "n_words": 19,
      "start_frame": 1438,
      "end_frame": 1531,
      "keyframes": [
        "001449.webp",
        "001504.webp",
        "001505.webp",
        "001525.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Vậy thì ngày hôm nay Phước Hưng sẽ hướng dẫn cho các bạn một cái sự kết hợp rất là độc đáo đó chính là món canh lươn bông bồn.",
      "start": 61.24,
      "end": 67.24,
      "n_words": 30,
      "start_frame": 1531,
      "end_frame": 1681,
      "keyframes": [
        "001545.webp",
        "001546.webp",
        "001655.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và cũng như theo lời của chuyên gia dinh dưỡng Tiến sĩ Đào Thị Yến Phi, món ăn ngày hôm nay rất tốt hỗ trợ xây dựng khối cơ xương.",
      "start": 67.24,
      "end": 73.88,
      "n_words": 30,
      "start_frame": 1681,
      "end_frame": 1847,
      "keyframes": [
        "001764.webp",
        "001765.webp",
        "001806.webp",
        "001847.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta sơ chế cái phần rau củ trước.",
      "start": 73.88,
      "end": 76.0,
      "n_words": 9,
      "start_frame": 1847,
      "end_frame": 1900,
      "keyframes": [
        "001847.webp",
        "001848.webp",
        "001873.webp",
        "001899.webp",
        "001900.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hưng sẽ cắt muối cao, đậu bắp.",
      "start": 76.72,
      "end": 78.92,
      "n_words": 7,
      "start_frame": 1918,
      "end_frame": 1973,
      "keyframes": [
        "001932.webp",
        "001933.webp",
        "001944.webp",
        "001955.webp",
        "001956.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phước Hưng sẽ cắt lát xéo ớt sừng thì Phước Hưng sẽ cắt lát xéo, ớt hiểm thì chúng ta sẽ đập rạch.",
      "start": 78.92,
      "end": 85.04,
      "n_words": 23,
      "start_frame": 1973,
      "end_frame": 2126,
      "keyframes": [
        "001983.webp",
        "002010.webp",
        "002011.webp",
        "002041.webp",
        "002071.webp",
        "002072.webp",
        "002101.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Phần rau nêm chúng ta sẽ cắt nhỏ.",
      "start": 85.04,
      "end": 89.16,
      "n_words": 8,
      "start_frame": 2126,
      "end_frame": 2229,
      "keyframes": [
        "002130.webp",
        "002131.webp",
        "002182.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cắt lươn ra thành từng khúc khoảng 5 centimet.",
      "start": 89.16,
      "end": 91.84,
      "n_words": 9,
      "start_frame": 2229,
      "end_frame": 2296,
      "keyframes": [
        "002233.webp",
        "002234.webp",
        "002290.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Với các gia đình mà có con nhỏ chắc có lẽ là không xa lạ gì với các món ăn được chế biến từ lươn, tại vì lươn rất là tốt và có nhiều protein cũng như là khoáng chất giúp xây dựng khối cơ xương trong cơ thể, cho nên là món ăn này vừa ngon lại vừa bổ dưỡng.",
      "start": 91.84,
      "end": 106.6,
      "n_words": 61,
      "start_frame": 2296,
      "end_frame": 2665,
      "keyframes": [
        "002347.webp",
        "002348.webp",
        "002471.webp",
        "002595.webp",
        "002596.webp",
        "002631.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ chúng ta sẽ nêm ướp gia vị vào đây: một muỗng cà phê bột ngọt Ajinomoto và một muỗng cà phê hạt nêm Ajinomoto ngon.",
      "start": 106.6,
      "end": 113.92,
      "n_words": 27,
      "start_frame": 2665,
      "end_frame": 2848,
      "keyframes": [
        "002666.webp",
        "002667.webp",
        "002694.webp",
        "002722.webp",
        "002723.webp",
        "002752.webp",
        "002782.webp",
        "002783.webp",
        "002802.webp",
        "002821.webp",
        "002822.webp",
        "002841.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chúng ta nên ướp thịt lươn trước để cho lươn thấm vị, khi nấu canh sẽ ngon hơn.",
      "start": 114.36,
      "end": 118.88,
      "n_words": 18,
      "start_frame": 2859,
      "end_frame": 2972,
      "keyframes": [
        "002861.webp",
        "002862.webp",
        "002916.webp",
        "002970.webp",
        "002971.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Phần dầu cũng đã nóng, Hưng sẽ cho vào đây khoảng hai muỗng canh tỏi băm.",
      "start": 118.88,
      "end": 123.8,
      "n_words": 16,
      "start_frame": 2972,
      "end_frame": 3095,
      "keyframes": [
        "002984.webp",
        "002998.webp",
        "002999.webp",
        "003041.webp",
        "003083.webp",
        "003084.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ chúng ta sẽ tắt bếp, sẽ lấy cái phần tỏi này ra.",
      "start": 123.8,
      "end": 129.96,
      "n_words": 14,
      "start_frame": 3095,
      "end_frame": 3249,
      "keyframes": [
        "003111.webp",
        "003138.webp",
        "003139.webp",
        "003189.webp",
        "003240.webp",
        "003241.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hưng sẽ cho vào lươn, trộn đều cái phần tỏi phi này ở đây.",
      "start": 129.96,
      "end": 135.48,
      "n_words": 14,
      "start_frame": 3249,
      "end_frame": 3387,
      "keyframes": [
        "003265.webp",
        "003290.webp",
        "003291.webp",
        "003333.webp",
        "003376.webp",
        "003377.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phước Hưng cũng đã chuẩn bị sẵn là một lít rưỡi nước, phần nước cũng đã sôi chúng ta sẽ cho lươn vào.",
      "start": 135.48,
      "end": 142.64,
      "n_words": 23,
      "start_frame": 3387,
      "end_frame": 3566,
      "keyframes": [
        "003412.webp",
        "003447.webp",
        "003448.webp",
        "003510.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tiếp theo Phước Hưng sẽ cho bồn bồn vào.",
      "start": 142.64,
      "end": 146.12,
      "n_words": 9,
      "start_frame": 3566,
      "end_frame": 3653,
      "keyframes": [
        "003573.webp",
        "003574.webp",
        "003617.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta nên sử dụng bồn bồn ngâm chua, khi mua về thì chúng ta bỏ bớt đi phần già, rửa sạch và vắt ráo để giảm bớt đi cái vị chua chát.",
      "start": 146.12,
      "end": 154.36,
      "n_words": 33,
      "start_frame": 3653,
      "end_frame": 3859,
      "keyframes": [
        "003661.webp",
        "003662.webp",
        "003756.webp",
        "003850.webp",
        "003851.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Vitamin và khoáng chất có trong bồn bồn sẽ giúp cho chúng ta hỗ trợ hệ miễn dịch và ngăn ngừa táo bón, cho nên món ăn này rất là bổ dưỡng đó nha.",
      "start": 154.96,
      "end": 163.52,
      "n_words": 34,
      "start_frame": 3874,
      "end_frame": 4088,
      "keyframes": [
        "003924.webp",
        "003997.webp",
        "003998.webp",
        "004042.webp",
        "004087.webp",
        "004088.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Hưng sẽ cho vào đây nửa chén nước cốt me, một muỗng cà phê muối, ba muỗng canh đường, cho hết phần đậu bắp vào.",
      "start": 163.52,
      "end": 174.32,
      "n_words": 25,
      "start_frame": 4088,
      "end_frame": 4358,
      "keyframes": [
        "004088.webp",
        "004117.webp",
        "004147.webp",
        "004148.webp",
        "004167.webp",
        "004187.webp",
