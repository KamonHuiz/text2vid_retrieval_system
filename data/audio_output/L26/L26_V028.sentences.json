        "005092.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ chúng ta sẽ trình bày món ăn ra thôi.",
      "start": 204.56,
      "end": 213.68,
      "n_words": 11,
      "start_frame": 5114,
      "end_frame": 5342,
      "keyframes": [
        "005117.webp",
