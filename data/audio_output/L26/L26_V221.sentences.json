      "keyframes": [
        "000782.webp",
        "000783.webp",
        "000899.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Món dồi trường hấp nghe thì có vẻ là đơn giản đúng không?",
      "start": 40.48,
      "end": 43.56,
      "n_words": 13,
      "start_frame": 1012,
      "end_frame": 1089,
      "keyframes": [
        "001016.webp",
        "001017.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nhưng mà cách chế biến cũng như là cách lựa chọn nguyên liệu như thế nào thì mới quyết định được chất lượng của món ăn. Khi mà các bạn mua dồi trường ở ngoài chợ về thì chúng ta luộc dồi trường.",
      "start": 43.56,
      "end": 53.52,
      "n_words": 43,
      "start_frame": 1089,
      "end_frame": 1338,
      "keyframes": [
        "001124.webp",
        "001232.webp",
        "001233.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong nước luộc là có rượu nè, gừng để khử mùi tanh của dồi trường.",
      "start": 53.76,
      "end": 58.0,
      "n_words": 15,
      "start_frame": 1344,
      "end_frame": 1450,
      "keyframes": [
        "001380.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Khi mà luộc rồi thì chúng ta sẽ vớt ngay, chúng ta sẽ vớt ngay qua ngâm nước đá lạnh.",
      "start": 58.0,
      "end": 61.2,
      "n_words": 20,
      "start_frame": 1450,
      "end_frame": 1530,
      "keyframes": [
        "001527.webp",
        "001528.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng ta sẽ ngâm dồi trường trong nước đá lạnh giúp cho dồi trường trắng sáng, khi ăn sẽ giòn hơn.",
      "start": 61.2,
      "end": 66.32,
      "n_words": 21,
      "start_frame": 1530,
      "end_frame": 1658,
      "keyframes": [
        "001592.webp",
        "001657.webp",
        "001658.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn cắt thành từng miếng vừa ăn như vậy.",
      "start": 66.32,
      "end": 68.64,
      "n_words": 10,
      "start_frame": 1658,
      "end_frame": 1716,
      "keyframes": [
        "001658.webp",
        "001685.webp",
        "001712.webp",
        "001713.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Phước Hưng ơi, thế thì khi mà chúng ta sơ chế xong và chúng ta luộc thì chúng ta chỉ luộc sơ thôi đúng không?",
      "start": 68.64,
      "end": 74.0,
      "n_words": 25,
      "start_frame": 1716,
      "end_frame": 1850,
      "keyframes": [
        "001786.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, vì đây là một món hấp, chúng ta chỉ luộc sơ từ 4 đến 5 phút là được rồi.",
      "start": 74.0,
      "end": 78.72,
      "n_words": 21,
      "start_frame": 1850,
      "end_frame": 1968,
      "keyframes": [
