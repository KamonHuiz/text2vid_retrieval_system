        "004881.webp",
        "005019.webp",
        "005020.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vậy là một cái món ăn tuy là nhanh và đơn giản nhưng mà đầy đủ chất dinh dưỡng.",
      "start": 200.84,
