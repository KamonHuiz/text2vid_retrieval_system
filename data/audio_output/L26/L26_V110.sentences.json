      "keyframes": [
        "000931.webp",
        "000932.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 41.6,
      "end": 45.96,
      "n_words": 11,
