        "001752.webp",
        "001800.webp",
        "001801.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Cho cái phần tép, giờ đây chúng ta ướp gia vị cho tép trước ha.",
      "start": 72.2,
      "end": 76.32,
      "n_words": 15,
