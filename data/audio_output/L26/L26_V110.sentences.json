      "start_frame": 1149,
      "end_frame": 1190,
      "keyframes": [
        "001150.webp",
        "001151.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hôm nay em thấy cái không khí mình hơi hương đồng gió nội, nó hương vị quê nhà.",
      "start": 47.6,
      "end": 52.64,
