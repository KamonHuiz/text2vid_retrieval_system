        "002965.webp",
        "002993.webp",
        "003021.webp",
        "003022.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi và giữ được độ ngọt của sò điệp, ăn rất là ngon.",
      "start": 121.0,
      "end": 124.0,
      "n_words": 14,
      "start_frame": 3025,
      "end_frame": 3100,
      "keyframes": [
        "003060.webp",
        "003099.webp",
        "003100.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cho vào đây là nửa muỗng canh tỏi băm.",
      "start": 124.0,
      "end": 126.0,
      "n_words": 9,
      "start_frame": 3100,
      "end_frame": 3150,
      "keyframes": [
        "003100.webp",
        "003123.webp",
        "003146.webp",
        "003147.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta sẽ áp chảo cồi sò điệp vàng xém mặt thì sau đó chúng ta hãy cho tỏi băm vào.",
      "start": 126.0,
      "end": 130.56,
      "n_words": 21,
      "start_frame": 3150,
      "end_frame": 3264,
      "keyframes": [
        "003235.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Làm như vậy thì giúp cho tỏi băm sẽ không bị cháy rồi.",
      "start": 130.56,
      "end": 135.44,
      "n_words": 13,
      "start_frame": 3264,
      "end_frame": 3386,
      "keyframes": [
        "003323.webp",
        "003324.webp",
        "003356.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và tiếp tục Phước Hương sẽ cho vào đây nửa muỗng canh dầu hào, một ít rượu trắng nè.",
      "start": 135.44,
      "end": 140.04,
      "n_words": 19,
      "start_frame": 3386,
      "end_frame": 3501,
      "keyframes": [
        "003388.webp",
        "003389.webp",
        "003429.webp",
        "003469.webp",
        "003470.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tại sao trong món ăn này lại có cả rượu trắng?",
      "start": 140.04,
      "end": 142.28,
      "n_words": 11,
      "start_frame": 3501,
      "end_frame": 3557,
      "keyframes": [
        "003529.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và Phước Hương chúng ta sẽ áp chảo cồi sò điệp với lại dầu hào và rượu trắng giúp cho cồi sò điệp giảm đi mùi tanh và thơm ngon hơn.",
      "start": 142.28,
      "end": 149.16,
      "n_words": 31,
      "start_frame": 3557,
      "end_frame": 3729,
      "keyframes": [
        "003588.webp",
        "003589.webp",
        "003658.webp",
        "003727.webp",
        "003728.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Áp chảo thật là nhanh tay và chúng ta sẽ cho ra dĩa.",
      "start": 149.16,
      "end": 152.52,
      "n_words": 13,
      "start_frame": 3729,
      "end_frame": 3813,
      "keyframes": [
        "003745.webp",
        "003762.webp",
        "003763.webp",
        "003779.webp",
        "003796.webp",
        "003797.webp",
        "003810.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Phước Hương vẫn sử dụng cái chảo này, bây giờ Phước Hương sẽ cho vào đây một ít dầu ăn để chúng ta phi tỏi, khoảng một muỗng canh tỏi băm.",
      "start": 152.52,
      "end": 159.16,
      "n_words": 31,
      "start_frame": 3813,
      "end_frame": 3979,
      "keyframes": [
        "003823.webp",
        "003824.webp",
        "003862.webp",
        "003900.webp",
        "003901.webp",
        "003922.webp",
        "003944.webp",
        "003945.webp",
        "003971.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta phi thơm.",
      "start": 159.16,
      "end": 160.8,
      "n_words": 4,
      "start_frame": 3979,
      "end_frame": 4020,
      "keyframes": [
        "003997.webp",
        "003998.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thơm quá!",
      "start": 160.8,
      "end": 161.52,
      "n_words": 2,
      "start_frame": 4020,
      "end_frame": 4038,
      "keyframes": [
        "004022.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và quả thật là đối với những cái món xào thì luôn luôn là sử dụng tỏi để phi để tăng cái hương thơm của món ăn. Đúng rồi, đúng rồi.",
      "start": 161.52,
      "end": 168.32,
      "n_words": 31,
      "start_frame": 4038,
      "end_frame": 4208,
      "keyframes": [
        "004046.webp",
        "004047.webp",
        "004073.webp",
        "004099.webp",
        "004100.webp",
        "004154.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Khi mà các bạn thấy dậy mùi thơm của tỏi lên rồi thì tiếp tục Phước Hương sẽ cho phần cà rốt mà chúng ta đã cắt hình thoi vào, tại vì cà rốt sẽ lâu chín hơn các nguyên liệu còn lại. Đúng rồi, chính xác luôn.",
      "start": 168.32,
      "end": 179.08,
      "n_words": 48,
      "start_frame": 4208,
      "end_frame": 4477,
      "keyframes": [
        "004209.webp",
        "004210.webp",
        "004261.webp",
        "004312.webp",
        "004313.webp",
        "004372.webp",
        "004432.webp",
        "004433.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Nhưng mà chúng ta cũng chỉ xào sơ thôi nha để giữ được độ giòn của phần cà rốt thì ăn sẽ rất ngon.",
      "start": 179.08,
      "end": 185.36,
      "n_words": 24,
      "start_frame": 4477,
      "end_frame": 4634,
      "keyframes": [
        "004534.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi bây giờ cũng đã được rồi, chúng ta tăng lửa lớn lên, cho hoa thiên lý vào nè, giá nè, bông điên điển.",
      "start": 185.36,
      "end": 193.04,
      "n_words": 24,
      "start_frame": 4634,
      "end_frame": 4826,
      "keyframes": [
        "004636.webp",
