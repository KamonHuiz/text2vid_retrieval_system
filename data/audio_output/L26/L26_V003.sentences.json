      "keyframes": [
        "001626.webp",
        "001737.webp",
        "001738.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Miếng phi lê ức gà chúng ta sẽ xẻ theo chiều dọc nhưng không cho đứt nhé.",
      "start": 70.12,
      "end": 75.68,
