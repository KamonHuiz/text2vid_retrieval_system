        "002780.webp",
        "002808.webp",
        "002837.webp",
        "002838.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chúng ta nên ướp hành tây trước với ít đường để hành tây bớt hăng, bớt mùi hăng.",
      "start": 114.2,
      "end": 118.24,
      "n_words": 18,
