        "005608.webp",
        "005658.webp",
        "005659.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đúng rồi, cầm mầm bơ vào chúng ta sẽ để cái phần trứng lên trên.",
      "start": 228.0,
      "end": 240.2,
