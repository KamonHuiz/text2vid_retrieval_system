      "keyframes": [
        "006684.webp",
        "006685.webp",
        "006823.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thưa các bạn, món này sẽ rất hợp với món cánh gà chiên lá chanh, cùng thử nha.",
      "start": 273.6,
      "end": 279.04,
      "n_words": 18,
