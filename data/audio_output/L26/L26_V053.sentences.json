        "003987.webp",
        "004032.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Trứng gà luộc cắt đôi, cho trứng vô trong hành.",
      "start": 161.28,
      "end": 166.32,
      "n_words": 10,
      "start_frame": 4032,
      "end_frame": 4158,
      "keyframes": [
        "004032.webp",
