      "start_frame": 1875,
      "end_frame": 2126,
      "keyframes": [
        "001916.webp",
        "001962.webp",
        "001963.webp",
        "002026.webp",
        "002089.webp",
        "002090.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta cắt làm đôi theo chiều dọc luôn các bạn.",
      "start": 85.36,
      "end": 92.8,
      "n_words": 11,
      "start_frame": 2134,
      "end_frame": 2320,
      "keyframes": [
        "002149.webp",
        "002208.webp",
        "002209.webp",
        "002266.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi dưa lê bây giờ nhờ Kim Thảo cắt thành hình nửa vầng trăng.",
      "start": 92.8,
      "end": 104.32,
      "n_words": 14,
      "start_frame": 2320,
