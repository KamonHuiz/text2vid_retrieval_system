      "keyframes": [
        "000858.webp",
        "000859.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 38.8,
      "end": 44.68,
      "n_words": 11,
