        "003709.webp",
        "003734.webp",
        "003735.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Lựu chúng ta cắt nhỏ.",
      "start": 150.16,
      "end": 155.52,
      "n_words": 5,
      "start_frame": 3754,
      "end_frame": 3888,
      "keyframes": [
        "003805.webp",
        "003876.webp",
        "003877.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thưa các bạn, chúng ta nên chọn rau củ nhiều màu sắc để ăn bắt mắt hơn và được nhiều dinh dưỡng hơn nha các bạn.",
      "start": 155.52,
      "end": 161.28,
      "n_words": 26,
      "start_frame": 3888,
      "end_frame": 4032,
      "keyframes": [
