        "003178.webp",
        "003210.webp",
        "003211.webp",
        "003212.webp",
        "003213.webp",
        "003214.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Ngày hôm nay có cà chua bi rồi cả cà rốt nữa sẽ cung cấp được lượng vitamin A, vitamin C rất là tốt cho sức khỏe và một món salad chắc chắn sẽ rất thanh mát.",
      "start": 128.64,
      "end": 138.0,
      "n_words": 37,
      "start_frame": 3216,
      "end_frame": 3450,
      "keyframes": [
        "003327.webp",
        "003441.webp",
        "003442.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bơ là một loại nguyên liệu mà cung cấp cho chúng ta chất béo không bão hòa và tốt cho tim mạch cũng như là có nhiều chất chống oxy hóa.",
      "start": 138.0,
