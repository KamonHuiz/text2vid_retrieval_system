        "004763.webp",
        "004817.webp",
        "004818.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ chúng ta sẽ cho vào trứng và hành tây, chúng ta trộn đều ha.",
      "start": 192.84,
      "end": 201.16,
      "n_words": 16,
