        "002898.webp",
        "002925.webp",
        "002952.webp",
        "002953.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần cà rốt thì chúng ta cắt sợi, cà chua bi chúng ta cắt đôi các bạn.",
      "start": 118.24,
      "end": 128.64,
      "n_words": 17,
      "start_frame": 2956,
      "end_frame": 3216,
