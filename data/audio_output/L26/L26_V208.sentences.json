        "001999.webp",
        "002000.webp",
        "002067.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Măng tây có chứa vitamin E giúp cho cơ thể của chúng ta chống lại các gốc tự do và bảo vệ các tế bào, rất là tốt cho sức khỏe đấy ạ.",
      "start": 83.76,
      "end": 90.72,
      "n_words": 33,
      "start_frame": 2094,
      "end_frame": 2268,
      "keyframes": [
        "002134.webp",
