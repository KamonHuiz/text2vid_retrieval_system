        "001609.webp",
        "001654.webp",
        "001655.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Ta mua về chúng ta cắt đôi, rửa sạch những cái phần máu đọng lại bên trong.",
      "start": 66.64,
      "end": 71.76,
