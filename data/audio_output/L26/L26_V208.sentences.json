        "002601.webp",
        "002602.webp",
        "002627.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các bạn chúng ta sẽ cho vào trong tô, chúng ta chuẩn bị ướp.",
      "start": 105.76,
      "end": 108.84,
      "n_words": 14,
