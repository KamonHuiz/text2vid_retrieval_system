      "end_frame": 1794,
      "keyframes": [
        "001688.webp",
        "001722.webp",
        "001723.webp",
        "001764.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Như vậy, măng tây xanh bây giờ bán rất là nhiều ở chợ.",
      "start": 71.76,
      "end": 74.52,
      "n_words": 13,
