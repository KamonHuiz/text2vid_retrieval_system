        "004152.webp",
        "004153.webp",
        "004183.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn bước đầu làm chín măng tây xanh bằng cách chúng ta chiên áp chảo không dầu thưa các bạn.",
      "start": 168.16,
