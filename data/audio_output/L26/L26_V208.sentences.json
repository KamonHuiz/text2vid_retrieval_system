        "001195.webp",
        "001306.webp",
        "001418.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Và thưa các bạn, theo như tôi biết thì trong tim heo còn có nhiều hàm lượng choline, các bạn, tăng cường chức năng gan, thải các loại chất béo có hại cho cơ thể và giúp cho chúng ta có trái tim khỏe hơn.",
      "start": 56.72,
      "end": 66.48,
      "n_words": 45,
      "start_frame": 1418,
      "end_frame": 1662,
      "keyframes": [
        "001418.webp",
