        "001040.webp",
        "001078.webp",
        "001079.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Em chú ý nhiều nhất cái này gọi là cái tương ớt gì cô?",
      "start": 43.24,
      "end": 46.92,
      "n_words": 14,
      "start_frame": 1081,
      "end_frame": 1173,
      "keyframes": [
        "001097.webp",
        "001115.webp",
        "001116.webp",
        "001150.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cái này gọi là tương hột ớt, còn gọi là tương đậu nành, tức là người ta đã lên men tương đậu nành với lại ớt và nhiều gia vị khác, nó sẽ làm nên hương vị đặc biệt của món ăn ngày hôm nay, thành phần tinh túy em yêu thích.",
      "start": 46.92,
      "end": 59.4,
      "n_words": 52,
      "start_frame": 1173,
      "end_frame": 1485,
      "keyframes": [
        "001184.webp",
