        "000777.webp",
        "000778.webp",
        "000890.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và ngày hôm nay, cô đem đến một món ăn mà em nhìn là đúng gu của em luôn.",
      "start": 39.96,
      "end": 43.24,
      "n_words": 19,
