        "002560.webp",
        "002561.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Vì là món súp cho nên là măng thì mình cắt sợi nó nhuyễn á thì ăn vô nó sẽ ngon.",
      "start": 102.56,
      "end": 109.44,
