        "001565.webp",
        "001596.webp",
        "001597.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Các bạn lưu ý là chúng ta sẽ ngâm pha tiết để đuôi bò được sạch và thơm nhé.",
      "start": 63.92,
      "end": 68.52,
