      "n_words": 8,
      "start_frame": 1740,
      "end_frame": 1780,
      "keyframes": [
        "001778.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cá kèo thì rất là ngon nhưng mà nó hay bị nhớt.",
