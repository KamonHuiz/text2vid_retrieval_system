        "002802.webp",
        "002841.webp",
        "002842.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Long sẽ gọt vỏ cái phần hành tây này, sau đó mình chẻ thành thoi.",
      "start": 113.84,
      "end": 117.2,
