        "000463.webp",
        "000464.webp",
        "000518.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ái chà hay quá, đố Kim Thảo nha, tại sao cái trái thơm lại có nhiều mắt như vậy?",
      "start": 22.72,
      "end": 28.44,
      "n_words": 19,
      "start_frame": 568,
      "end_frame": 711,
      "keyframes": [
        "000572.webp",
