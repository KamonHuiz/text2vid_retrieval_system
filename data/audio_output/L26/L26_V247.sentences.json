      "start_frame": 1804,
      "end_frame": 1970,
      "keyframes": [
        "001884.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên chúng ta sẽ ướp gà.",
      "start": 78.8,
      "end": 80.72,
      "n_words": 7,
      "start_frame": 1970,
      "end_frame": 2018,
      "keyframes": [
        "001972.webp",
        "001973.webp",
        "001996.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đây là gà lóc tứ mà Long đã lóc xương ra rồi.",
