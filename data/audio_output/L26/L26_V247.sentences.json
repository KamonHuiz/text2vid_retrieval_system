      "end": 31.04,
      "n_words": 11,
      "start_frame": 711,
      "end_frame": 776,
      "keyframes": [
        "000730.webp",
        "000757.webp",
        "000758.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phải hỏi những bạn nhỏ nhưng mà thôi lỡ hỏi rồi Kim Thảo trả lời cho nghe.",
      "start": 31.04,
      "end": 34.56,
      "n_words": 17,
      "start_frame": 776,
      "end_frame": 864,
      "keyframes": [
        "000782.webp",
        "000806.webp",
        "000807.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thực ra mọi người biết không, hồi xưa là thơm chỉ có hai mắt thôi, nhưng mà qua thời gian bởi vì nó thơm quá, nó ngọt quá cho nên nó phải mọc ra nhiều mắt để nó canh những người nào ăn trộm.",
