        "000586.webp",
        "000600.webp",
        "000601.webp",
        "000651.webp",
        "000702.webp",
        "000703.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Câu hỏi này quá là đơn giản, cô biết luôn hả?",
