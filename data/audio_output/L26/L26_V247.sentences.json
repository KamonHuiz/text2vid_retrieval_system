        "002660.webp",
        "002711.webp",
        "002762.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trong khi chờ đợi thì Long sẽ cắt thái các phần rau củ ăn kèm.",
      "start": 110.48,
      "end": 113.84,
      "n_words": 15,
