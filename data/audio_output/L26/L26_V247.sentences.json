      "start_frame": 2846,
      "end_frame": 2930,
      "keyframes": [
        "002903.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi ớt chuông chúng ta cũng cắt hình thoi.",
      "start": 123.36,
      "end": 126.56,
      "n_words": 9,
      "start_frame": 3084,
