        "002644.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sau khi Kim Thảo trộn đều thì mình sẽ ướp khoảng 15 phút trước khi mình đem áp chảo phần gà này.",
      "start": 105.76,
      "end": 110.48,
      "n_words": 22,
      "start_frame": 2644,
      "end_frame": 2762,
