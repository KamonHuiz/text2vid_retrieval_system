        "000958.webp",
        "000979.webp",
        "000980.webp",
        "001055.webp",
        "001130.webp",
        "001131.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Trời ơi câu trả lời là nghe một lú luôn mà rất là dễ thương.",
      "start": 45.24,
      "end": 47.52,
      "n_words": 15,
      "start_frame": 1131,
      "end_frame": 1188,
      "keyframes": [
        "001131.webp",
        "001159.webp",
        "001187.webp",
        "001188.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thì Long sẽ là một món ăn để từ thơm tặng cho Kim Thảo: đùi gà áp chảo sốt thơm, mùi thơm ngon vị đậm đà.",
