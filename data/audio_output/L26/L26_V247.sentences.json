        "003579.webp",
        "003606.webp",
        "003607.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Kế đến là cái phần gừng này Long cũng cắt mỏng xong lát hình thoi luôn.",
      "start": 144.36,
      "end": 150.12,
