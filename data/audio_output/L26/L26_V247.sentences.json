      "end_frame": 305,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Làm gì đó giờ mua dùm trái thơm ngọt nhiệt tình vậy luôn hả?",
      "start": 12.2,
      "end": 16.24,
      "n_words": 14,
