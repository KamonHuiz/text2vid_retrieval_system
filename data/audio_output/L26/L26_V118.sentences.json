        "003744.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Sau đó Quốc Nghị sẽ ướp cái gia vị nêm sẵn Ajinomoto bột tẩm khô chiên giòn.",
      "start": 149.84,
      "end": 154.12,
