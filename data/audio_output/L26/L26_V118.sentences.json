      "end_frame": 1011,
      "keyframes": [
        "000878.webp",
        "000879.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 40.44,
      "end": 44.32,
      "n_words": 11,
      "start_frame": 1011,
      "end_frame": 1108,
      "keyframes": [
        "001087.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Hôm nay, Quốc Nghị sẽ hướng dẫn các bạn khán giả và Minh Phương thực hiện một món rất ngon nhưng mà cực kỳ dễ, đó là món ba rọi sả ớt tẩm bột chiên giòn.",
      "start": 44.32,
      "end": 53.6,
      "n_words": 36,
      "start_frame": 1108,
      "end_frame": 1340,
      "keyframes": [
        "001295.webp",
        "001296.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Wow, nghe thôi là thấy hấp dẫn rồi!",
      "start": 53.6,
      "end": 56.16,
      "n_words": 8,
      "start_frame": 1340,
      "end_frame": 1404,
      "keyframes": [
        "001348.webp",
        "001401.webp",
        "001402.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Công đoạn đầu tiên là anh Nghị phải hướng dẫn Minh Phương cũng như là quý vị khán giả lựa chọn ba rọi làm sao cho ngon.",
      "start": 56.16,
      "end": 62.88,
      "n_words": 27,
      "start_frame": 1404,
      "end_frame": 1572,
      "keyframes": [
        "001533.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cái việc lựa chọn ba rọi thì chúng ta sẽ chọn nè: thớ thịt hồng nè, chạm vào cái độ đàn hồi nè, quan trọng đó là mỡ nạc nó đan xen lẫn nhau.",
      "start": 62.88,
      "end": 71.44,
      "n_words": 34,
      "start_frame": 1572,
      "end_frame": 1786,
      "keyframes": [
        "001665.webp",
        "001666.webp",
        "001726.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cái miếng ba rọi nè các bạn sẽ cắt có độ dày khoảng một centimet như thế này nè.",
      "start": 71.44,
      "end": 78.4,
