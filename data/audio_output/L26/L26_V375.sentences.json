      "end_frame": 624,
      "keyframes": [
        "000605.webp",
        "000606.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nhiệm vụ của em là phải làm những món ăn ngon, làm cho mọi người ăn vào cảm thấy yêu thương.",
      "start": 24.96,
