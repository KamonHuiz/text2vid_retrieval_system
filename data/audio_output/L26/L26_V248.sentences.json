        "004152.webp",
        "004175.webp",
        "004176.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Tiếp theo chúng ta sẽ dùng bột tẩm khô chiên giòn này nè, mình sẽ đổ ra dĩa một ít như thế này.",
      "start": 167.12,
      "end": 173.92,
      "n_words": 23,
      "start_frame": 4178,
      "end_frame": 4348,
      "keyframes": [
        "004218.webp",
