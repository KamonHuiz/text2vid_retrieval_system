        "002768.webp",
        "002801.webp",
        "002802.webp",
        "002833.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các bạn lưu ý là trong món ăn này chúng ta sẽ kết hợp thịt gà cùng với trứng muối, mè trắng, hạt sen để tạo hương vị mới lạ cho món ăn nhé.",
      "start": 114.44,
      "end": 122.48,
      "n_words": 34,
      "start_frame": 2861,
      "end_frame": 3062,
      "keyframes": [
        "002864.webp",
        "002865.webp",
        "002963.webp",
        "003061.webp",
        "003062.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cuối cùng chúng ta sẽ thêm một muỗng cà phê bột ngọt Ajinomoto.",
      "start": 122.48,
      "end": 126.12,
      "n_words": 13,
      "start_frame": 3062,
      "end_frame": 3153,
      "keyframes": [
        "003062.webp",
        "003083.webp",
