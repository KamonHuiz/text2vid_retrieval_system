        "002361.webp",
        "002381.webp",
        "002401.webp",
        "002402.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Rồi ở đây là bắp hạt bắp Mỹ, chúng ta cắt nhỏ hai muỗng, hành tím phi, mè rang xay 50 g, chúng ta sẽ chừa lại một chút xíu nha, cộng ngò rí hai muỗng, chanh, một trái ớt sừng cắt sợi.",
      "start": 96.12,
      "end": 109.32,
      "n_words": 43,
      "start_frame": 2403,
      "end_frame": 2733,
      "keyframes": [
        "002442.webp",
