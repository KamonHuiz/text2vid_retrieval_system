        "006220.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Đầu tiên mình sẽ cắt cái miếng bánh gà này ra làm tám phần, cô chỉ cần bày nó ra thôi.",
      "start": 249.24,
