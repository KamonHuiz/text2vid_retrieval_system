        "002193.webp",
        "002232.webp",
        "002271.webp",
        "002272.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hạt sen mình sẽ luộc chín sau đó mình tán bể sơ vậy thôi nha, đừng có xay nhuyễn quá.",
      "start": 90.96,
      "end": 96.12,
      "n_words": 20,
