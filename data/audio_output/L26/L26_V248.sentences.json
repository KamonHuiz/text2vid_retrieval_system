        "004638.webp",
        "004657.webp",
        "004658.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Nóng chưa?",
      "start": 186.64,
      "end": 187.16,
      "n_words": 2,
      "start_frame": 4666,
      "end_frame": 4679,
      "keyframes": [
        "004679.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ nóng rồi. Nóng rồi thì chúng ta cũng sẽ thả nó vào chiên.",
      "start": 187.16,
      "end": 190.2,
      "n_words": 14,
      "start_frame": 4679,
      "end_frame": 4755,
      "keyframes": [
        "004679.webp",
        "004700.webp",
        "004701.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tuấn canh cái chảo này chiên giùm cô luôn, cô sẽ làm cho ba phần còn lại.",
      "start": 190.2,
      "end": 194.64,
      "n_words": 17,
      "start_frame": 4755,
      "end_frame": 4866,
      "keyframes": [
        "004772.webp",
        "004844.webp",
        "004845.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thơm quá cô ơi!",
