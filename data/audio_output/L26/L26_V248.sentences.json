        "004410.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đổ thêm một cái lớp bột ở trên nữa, mình sẽ bỏ nó vào trong cái dĩa rồi.",
      "start": 177.4,
      "end": 186.64,
