        "003616.webp",
        "003634.webp",
        "003635.webp"
      ],
      "keyframe_count": 22
    },
    {
      "text": "Một cái chén sốt vừa béo béo, thơm thơm và đậm thơm mùi mè.",
      "start": 145.4,
      "end": 150.96,
