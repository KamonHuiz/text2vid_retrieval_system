        "005263.webp",
        "005297.webp",
        "005332.webp",
        "005333.webp",
        "005369.webp",
        "005405.webp",
        "005406.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Tuấn biết không, thịt gà thì rất là quen thuộc trong bữa ăn của người Việt Nam mình và nếu như mà mình biết cách chế biến, mình thay đổi sáng tạo thì mình sẽ được rất là nhiều món ăn ngon từ thịt gà.",
      "start": 216.24,
      "end": 228.08,
      "n_words": 45,
      "start_frame": 5406,
      "end_frame": 5702,
      "keyframes": [
        "005406.webp",
        "005505.webp",
        "005604.webp",
        "005605.webp",
        "005652.webp",
        "005699.webp",
        "005700.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Được rồi đó Tuấn, bây giờ cô sẽ vớt ra, em tắt lửa đi Tuấn.",
      "start": 228.08,
      "end": 231.36,
      "n_words": 15,
      "start_frame": 5702,
      "end_frame": 5784,
      "keyframes": [
        "005747.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dạ. Và như vậy là chúng ta đã hoàn thành.",
      "start": 231.36,
      "end": 233.68,
      "n_words": 10,
      "start_frame": 5784,
      "end_frame": 5842,
      "keyframes": [
        "005795.webp",
        "005796.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ chúng ta chỉ cần trình bày món ăn là xong.",
