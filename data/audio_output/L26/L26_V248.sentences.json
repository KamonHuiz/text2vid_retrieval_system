        "005111.webp",
        "005154.webp",
        "005155.webp",
        "005181.webp",
        "005207.webp",
        "005208.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Được rồi đó Tuấn ra đi, em chiên cái thứ hai rồi.",
      "start": 208.6,
      "end": 216.24,
      "n_words": 12,
      "start_frame": 5215,
      "end_frame": 5406,
      "keyframes": [
        "005222.webp",
