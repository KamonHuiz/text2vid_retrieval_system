        "004048.webp",
        "004075.webp",
        "004076.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Đầu tiên là mình sẽ vo viên lại, nắn lại cho nó chặt cái đi đã.",
      "start": 163.36,
      "end": 167.12,
      "n_words": 16,
      "start_frame": 4084,
