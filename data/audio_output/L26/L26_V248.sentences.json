        "003771.webp",
        "003772.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chảo dầu của cô để lửa lên ha và cái phần nhân bánh gà đó thì bây giờ chúng ta sẽ chia làm hai phần.",
      "start": 150.96,
      "end": 157.24,
      "n_words": 25,
      "start_frame": 3774,
      "end_frame": 3931,
      "keyframes": [
        "003807.webp",
