      "start_frame": 4866,
      "end_frame": 4897,
      "keyframes": [
        "004882.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đó bây giờ bắt đầu những cái nguyên liệu nó chín đó, xong rồi nó thơm lừng lên, đã vàng rồi đó.",
      "start": 195.88,
      "end": 202.64,
      "n_words": 22,
      "start_frame": 4897,
      "end_frame": 5066,
      "keyframes": [
        "004920.webp",
        "004921.webp",
        "004994.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi phần còn lại thì chúng ta cũng sẽ tạo hình bánh như thế này rồi tẩm lớp bột tẩm khô chiên giòn.",
      "start": 202.64,
      "end": 208.6,
      "n_words": 23,
      "start_frame": 5066,
      "end_frame": 5215,
      "keyframes": [
        "005068.webp",
