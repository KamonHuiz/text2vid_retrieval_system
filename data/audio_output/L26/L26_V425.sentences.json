        "000646.webp",
        "000693.webp",
        "000694.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mà em nghĩ là với tài năng của cô thì phải làm cái món chiên gì đó mà độc đáo.",
      "start": 29.44,
      "end": 33.16,
