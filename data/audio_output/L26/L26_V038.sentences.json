      "start_frame": 1606,
      "end_frame": 1706,
      "keyframes": [
        "001690.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn gọt vỏ nè, cắt khối vuông khoảng 1 centimet.",
