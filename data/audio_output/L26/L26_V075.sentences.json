      "end_frame": 1086,
      "keyframes": [
        "000996.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Anh Long nè, hôm nay Tân Phương để ý thấy có tần ô.",
      "start": 43.44,
      "end": 46.04,
      "n_words": 13,
      "start_frame": 1086,
      "end_frame": 1151,
      "keyframes": [
        "001129.webp",
        "001130.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đây là món ruột của Tân Phương đấy ạ.",
