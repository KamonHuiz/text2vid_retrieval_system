      "end": 59.68,
      "n_words": 28,
      "start_frame": 1350,
      "end_frame": 1492,
      "keyframes": [
        "001350.webp",
        "001351.webp",
        "001443.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nghe là đã thấy thích rồi đó, chúng ta thực hiện ngay thôi.",
      "start": 59.68,
      "end": 62.44,
      "n_words": 13,
