      "keyframes": [
        "000862.webp",
        "000863.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 39.24,
      "end": 43.44,
      "n_words": 11,
