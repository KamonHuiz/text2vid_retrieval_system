        "002293.webp",
        "002340.webp",
        "002341.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chúng ta sẽ cần khoảng hai muỗng cà phê dầu ăn, chảo cũng đã nóng.",
      "start": 95.04,
      "end": 98.88,
