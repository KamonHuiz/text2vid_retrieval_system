      "end_frame": 4047,
      "keyframes": [
        "003923.webp",
        "003954.webp",
        "003955.webp",
        "004000.webp",
        "004046.webp",
        "004047.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta có một ít hành phi mà trước khi chúng ta bỏ vào thì chúng ta bóp nhỏ nó ra.",
      "start": 161.88,
      "end": 165.88,
      "n_words": 21,
      "start_frame": 4047,
      "end_frame": 4147,
      "keyframes": [
        "004047.webp",
        "004082.webp",
        "004117.webp",
        "004118.webp",
        "004133.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cái nguyên liệu cuối cùng cho phần chả này Thanh Phương biết cái gì không? Là cái xốt này đúng không?",
