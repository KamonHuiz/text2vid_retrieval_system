        "002812.webp",
        "002842.webp",
        "002843.webp",
        "002877.webp"
      ],
      "keyframe_count": 24
    },
    {
      "text": "Giống như là một cái hỗn hợp để ướp đúng không?",
      "start": 116.56,
      "end": 118.84,
      "n_words": 11,
      "start_frame": 2914,
      "end_frame": 2971,
      "keyframes": [
        "002946.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi khi mà chúng ta thấy hành tây trong lại như vậy và các gia vị đã tan đều ra, tắt bếp và để qua một bên để chờ cho cái hỗn hợp gia vị này nó nguội đi.",
