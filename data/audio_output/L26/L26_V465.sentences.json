      "end_frame": 1749,
      "keyframes": [
        "001679.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chúng ta sẽ làm khoai tây trước.",
      "start": 69.96,
      "end": 72.04,
      "n_words": 7,
      "start_frame": 1749,
      "end_frame": 1801,
      "keyframes": [
        "001756.webp",
        "001757.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Phần khoai tây thì chúng ta sẽ mua về gọt vỏ, cắt đôi hoặc cắt làm tư và chúng ta sẽ đem đi hấp chín, tán nhuyễn.",
      "start": 72.04,
      "end": 78.56,
      "n_words": 27,
      "start_frame": 1801,
      "end_frame": 1964,
      "keyframes": [
        "001815.webp",
