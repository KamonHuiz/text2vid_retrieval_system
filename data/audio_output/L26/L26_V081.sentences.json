      "keyframes": [
        "000838.webp",
        "000839.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 38.04,
      "end": 42.96,
      "n_words": 11,
      "start_frame": 951,
      "end_frame": 1074,
      "keyframes": [
        "001004.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Kim Thảo biết không, hôm nay cô Hà sẽ giới thiệu một món ăn rất là nổi tiếng của dân miền Tây, món ăn rất là bắt cơm, đó là món cá he kho rệu.",
      "start": 42.96,
      "end": 52.24,
      "n_words": 35,
      "start_frame": 1074,
      "end_frame": 1306,
      "keyframes": [
        "001170.webp",
