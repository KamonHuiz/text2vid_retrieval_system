        "004685.webp",
        "004718.webp",
        "004719.webp",
        "004806.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Khi mà gia vị nó đã sôi rồi, em thấy không? Dạ.",
      "start": 195.6,
      "end": 198.12,
      "n_words": 12,
      "start_frame": 4890,
      "end_frame": 4953,
      "keyframes": [
        "004894.webp",
        "004895.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ cô sẽ cho vào đây khoảng chừng một trái nước dừa và nước dừa thiếu thì chúng ta có thể là cho thêm nước nóng nữa, rồi đậy nồi áp suất lại ha.",
      "start": 198.12,
      "end": 207.52,
      "n_words": 35,
      "start_frame": 4953,
      "end_frame": 5188,
      "keyframes": [
        "004972.webp",
