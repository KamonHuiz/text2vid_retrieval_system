        "004234.webp",
        "004279.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ thì chúng ta sẽ cho cá vào trong nồi áp suất để mình kho ha.",
      "start": 172.76,
      "end": 176.8,
      "n_words": 17,
