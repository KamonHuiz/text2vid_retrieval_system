      "end_frame": 6057,
      "keyframes": [
        "005875.webp",
        "006012.webp",
        "006013.webp",
        "006037.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ thì chúng ta cùng trình bày món ăn nha các bạn.",
