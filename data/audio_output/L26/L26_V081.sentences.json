        "006550.webp",
        "006595.webp",
        "006596.webp",
        "006680.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Và như vậy là chúng ta đã hoàn thành món ăn ngày hôm nay.",
      "start": 267.68,
      "end": 270.56,
      "n_words": 14,
      "start_frame": 6692,
      "end_frame": 6764,
      "keyframes": [
        "006764.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Với món ăn ngày hôm nay, chúng ta nên kết hợp với món canh chua sườn non để có một bữa ăn hoàn chỉnh nha các bạn.",
      "start": 270.56,
