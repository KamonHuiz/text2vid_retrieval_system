        "001194.webp",
        "001218.webp",
        "001219.webp",
        "001260.webp",
        "001301.webp",
        "001302.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Kho rệu nghĩa là kho rục phải không cô?",
      "start": 52.24,
      "end": 54.92,
      "n_words": 9,
      "start_frame": 1306,
      "end_frame": 1373,
      "keyframes": [
        "001343.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi.",
      "start": 54.92,
      "end": 55.4,
      "n_words": 2,
      "start_frame": 1373,
      "end_frame": 1385,
      "keyframes": [
        "001384.webp",
        "001385.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đầu tiên thì lựa cá he, thì chúng ta sẽ chọn những con cá he nó còn tươi nè, nó còn dẩy, nó bóng sáng, bám chặt vào thân và mắt nó trong.",
      "start": 55.4,
      "end": 63.52,
      "n_words": 33,
      "start_frame": 1385,
      "end_frame": 1588,
      "keyframes": [
        "001385.webp",
        "001408.webp",
        "001431.webp",
        "001432.webp",
        "001491.webp",
        "001551.webp",
        "001552.webp",
        "001570.webp",
        "001588.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và đặc biệt là phía trong bụng của cá he thì thường thường sẽ có một cái màng bám sát vào cái thành bụng mà màu đen.",
      "start": 63.52,
      "end": 69.68,
      "n_words": 27,
      "start_frame": 1588,
      "end_frame": 1742,
      "keyframes": [
        "001588.webp",
        "001589.webp",
        "001618.webp",
        "001647.webp",
        "001648.webp",
        "001694.webp",
        "001740.webp",
        "001741.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Khi sơ chế, chúng ta lưu ý là cạo sạch màng đen trong bụng cá để cá không bị hôi rong nhé các bạn.",
      "start": 69.68,
      "end": 75.32,
      "n_words": 24,
      "start_frame": 1742,
      "end_frame": 1883,
      "keyframes": [
        "001774.webp",
        "001808.webp",
        "001809.webp",
        "001845.webp",
        "001881.webp",
        "001882.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cho vào đây khoảng chừng 3 muỗng canh dầu ăn, khoảng 3 cái đầu hành, rồi chúng ta sẽ cho cá vào đây.",
      "start": 75.32,
      "end": 82.16,
      "n_words": 23,
      "start_frame": 1883,
      "end_frame": 2054,
      "keyframes": [
        "001913.webp",
        "001945.webp",
        "001946.webp",
        "001974.webp",
        "002003.webp",
        "002004.webp",
        "002052.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chúng ta sẽ áp chảo cá để cho cái phần vẩy cá nó săn, nó thơm ha.",
      "start": 82.16,
      "end": 86.48,
      "n_words": 17,
      "start_frame": 2054,
      "end_frame": 2162,
      "keyframes": [
        "002100.webp",
        "002101.webp",
        "002150.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Với bước này thì tự nhiên em nhớ đến món riêu cá chép.",
      "start": 86.48,
      "end": 89.36,
      "n_words": 13,
      "start_frame": 2162,
      "end_frame": 2234,
      "keyframes": [
        "002199.webp",
        "002200.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Khi mà mình chế biến cá chép thì mình cũng sẽ để nguyên vẩy và chúng ta cũng sẽ chiên sơ như thế này để vẩy được giòn và ăn rất là ngon.",
      "start": 89.36,
      "end": 97.36,
      "n_words": 33,
      "start_frame": 2234,
      "end_frame": 2434,
      "keyframes": [
        "002313.webp",
        "002427.webp",
        "002428.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vậy là được rồi đó, giờ cô sẽ vớt ra.",
      "start": 97.36,
      "end": 102.4,
      "n_words": 10,
      "start_frame": 2434,
      "end_frame": 2560,
      "keyframes": [
        "002458.webp",
