        "003675.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Chúng ta sẽ khuấy chút xíu cho nó tan bớt gia vị, sau đó mình sẽ cho cá vào.",
      "start": 148.48,
      "end": 152.76,
