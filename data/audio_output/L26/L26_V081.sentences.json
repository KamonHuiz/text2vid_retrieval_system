        "005311.webp",
        "005398.webp",
        "005399.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Mình sẽ xì bớt cái áp suất ở trong này ra.",
      "start": 216.12,
      "end": 223.28,
      "n_words": 11,
      "start_frame": 5403,
      "end_frame": 5582,
      "keyframes": [
        "005457.webp",
