        "002767.webp",
        "002784.webp",
        "002785.webp",
        "002795.webp",
        "002805.webp",
        "002806.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Phần lá với lại ngò gai, ngò gai mình cắt nhỏ lát mình làm rau nêm, mình nêm vô.",
      "start": 112.24,
      "end": 117.84,
      "n_words": 19,
      "start_frame": 2806,
      "end_frame": 2946,
      "keyframes": [
        "002806.webp",
        "002859.webp",
        "002913.webp",
        "002914.webp",
        "002933.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi chúng ta ướp sườn với lại bí đỏ, hành băm, 1/4 muỗng cà phê muối, 1/4 muỗng cà phê tiêu (nên dùng tiêu trắng xay nha các bạn), 1/4 muỗng cà phê đường và nửa muỗng cà phê hạt nêm.",
      "start": 117.84,
      "end": 129.84,
      "n_words": 41,
      "start_frame": 2946,
      "end_frame": 3246,
      "keyframes": [
        "002952.webp",
        "002953.webp",
        "002982.webp",
        "003011.webp",
        "003012.webp",
        "003028.webp",
        "003045.webp",
        "003046.webp",
        "003083.webp",
        "003120.webp",
        "003121.webp",
        "003147.webp",
        "003174.webp",
        "003175.webp",
        "003220.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Rồi trộn đều lên như vậy tất cả các gia vị nó sẽ thấm vào trong sườn.",
      "start": 129.84,
      "end": 134.16,
      "n_words": 17,
      "start_frame": 3246,
      "end_frame": 3354,
      "keyframes": [
        "003266.webp",
        "003267.webp",
        "003307.webp",
        "003347.webp",
        "003348.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Kinh nghiệm nấu ăn nữa, chúng ta sẽ cho đây một ít bột năng, đây là cái cách ướp thịt của người Hoa.",
      "start": 134.16,
      "end": 140.44,
      "n_words": 23,
      "start_frame": 3354,
      "end_frame": 3511,
      "keyframes": [
        "003369.webp",
