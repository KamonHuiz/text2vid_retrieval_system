        "004560.webp",
        "004594.webp",
        "004629.webp",
        "004630.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Một loại rau biển lá mà người ta làm khô, chúng ta ngâm nước nó nở ra như vậy chén lớn cái này ăn rất là mát nha các bạn.",
      "start": 187.44,
      "end": 195.16,
      "n_words": 30,
      "start_frame": 4686,
