        "004060.webp",
        "004086.webp",
        "004087.webp",
        "004110.webp",
        "004133.webp",
        "004134.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Phần cuối cùng đây một quả lê chúng ta cần khoảng nửa quả thôi nấu canh này.",
      "start": 165.76,
      "end": 171.6,
      "n_words": 17,
      "start_frame": 4144,
      "end_frame": 4290,
      "keyframes": [
        "004178.webp",
        "004223.webp",
        "004224.webp",
        "004249.webp",
        "004274.webp",
        "004275.webp",
        "004289.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Chúng ta bỏ lê vô em nghe có lạ không?",
      "start": 171.6,
      "end": 173.64,
      "n_words": 10,
      "start_frame": 4290,
      "end_frame": 4341,
      "keyframes": [
        "004304.webp",
        "004305.webp",
        "004318.webp",
        "004332.webp",
        "004333.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Dạ hơi lạ nha.",
      "start": 173.64,
      "end": 175.08,
      "n_words": 4,
      "start_frame": 4341,
      "end_frame": 4377,
      "keyframes": [
        "004352.webp",
        "004372.webp",
        "004373.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trong kim chi đó, Hàn Quốc người ta dùng lê tẩm ướp để biến món ăn rất là nhiều.",
      "start": 175.08,
      "end": 181.4,
      "n_words": 19,
