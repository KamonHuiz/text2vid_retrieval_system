        "003566.webp",
        "003586.webp",
        "003587.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta nên ướp vô sườn một chút dầu mê để cho sườn được thơm hơn.",
      "start": 143.56,
      "end": 147.36,
      "n_words": 16,
      "start_frame": 3589,
      "end_frame": 3684,
      "keyframes": [
        "003616.webp",
        "003645.webp",
        "003646.webp",
        "003664.webp",
        "003682.webp",
        "003683.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Để đây khoảng chừng 15 phút thôi các bạn.",
      "start": 147.36,
      "end": 148.92,
      "n_words": 9,
      "start_frame": 3684,
      "end_frame": 3723,
      "keyframes": [
        "003703.webp",
        "003723.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi ở đây thì chúng ta bào sạch vỏ, chúng ta cắt làm đôi.",
      "start": 149.08,
      "end": 153.44,
      "n_words": 14,
