      "end_frame": 3836,
      "keyframes": [
        "003742.webp",
        "003761.webp",
        "003762.webp",
        "003777.webp",
        "003793.webp",
        "003794.webp",
        "003821.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Trước khi chúng ta cắt các loại củ mà có cái độ rắn chắc như vậy mình chỉ cần đưa từ phần mũi dao nè, rớt là nhẹ nhàng cắt nhỏ nhỏ vậy đây để cho vô miệng là nó vừa luôn rồi.",
      "start": 153.44,
      "end": 165.76,
      "n_words": 43,
      "start_frame": 3836,
      "end_frame": 4144,
      "keyframes": [
        "003848.webp",
