        "000964.webp",
        "000965.webp",
        "000989.webp",
        "001014.webp",
        "001015.webp",
        "001032.webp",
        "001049.webp",
        "001050.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Cái mùa hè này ha, nóng được ăn những nguyên liệu rất là mát và đặc biệt rất là đẹp da đó nha.",
      "start": 42.0,
      "end": 46.88,
      "n_words": 23,
      "start_frame": 1050,
      "end_frame": 1172,
      "keyframes": [
        "001050.webp",
        "001107.webp",
        "001165.webp",
        "001166.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Trời ơi, vậy mà em cứ tưởng hôm nay anh Vũ trúng số lớn.",
      "start": 46.88,
      "end": 53.04,
      "n_words": 14,
      "start_frame": 1172,
      "end_frame": 1326,
      "keyframes": [
        "001193.webp",
        "001221.webp",
        "001222.webp",
        "001285.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đành em đi du lịch thôi kệ, không được đi du lịch mình ăn mấy cái món của mấy nước đó cũng an ủi.",
      "start": 53.04,
      "end": 58.24,
      "n_words": 24,
      "start_frame": 1326,
      "end_frame": 1456,
      "keyframes": [
        "001348.webp",
        "001349.webp",
        "001411.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vào bếp anh ơi, canh sườn bí đỏ rong biển mát dịu cho mùa hè nhé.",
      "start": 58.24,
      "end": 80.48,
      "n_words": 16,
      "start_frame": 1456,
      "end_frame": 2012,
      "keyframes": [
        "001473.webp",
        "001474.webp",
        "001498.webp",
        "001523.webp",
        "001524.webp",
        "001567.webp",
        "001610.webp",
        "001611.webp",
        "001644.webp",
        "001678.webp",
        "001696.webp",
        "001738.webp",
        "001780.webp",
        "001781.webp",
        "001895.webp",
        "002009.webp",
        "002010.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Chào các bạn của chương trình Món ngon mỗi ngày được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 80.48,
      "end": 85.6,
      "n_words": 19,
      "start_frame": 2012,
      "end_frame": 2140,
      "keyframes": [
        "002077.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Thì đầu tiên nguyên liệu mà tạo nên cái vị ngọt của món canh đó là sườn ngon.",
      "start": 85.6,
      "end": 90.36,
      "n_words": 18,
      "start_frame": 2140,
      "end_frame": 2259,
      "keyframes": [
        "002144.webp",
        "002145.webp",
        "002199.webp",
        "002253.webp",
        "002254.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta mua sườn ngon về đó là chúng ta cắt khúc khoảng độ chừng 2 cm như vậy thôi các bạn.",
      "start": 90.36,
      "end": 95.0,
      "n_words": 22,
      "start_frame": 2259,
      "end_frame": 2375,
      "keyframes": [
        "002341.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn lưu ý nha để cho nước canh chúng ta được ngọt và trong, chúng ta ngâm và xả sườn trong nước lạnh nhiều lần cho tới khi nước trong.",
      "start": 95.0,
      "end": 103.32,
      "n_words": 31,
      "start_frame": 2375,
      "end_frame": 2583,
      "keyframes": [
        "002428.webp",
        "002429.webp",
        "002504.webp",
        "002579.webp",
        "002580.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ chúng ta sẽ ướp sườn.",
      "start": 103.32,
      "end": 105.08,
      "n_words": 7,
      "start_frame": 2583,
      "end_frame": 2627,
      "keyframes": [
        "002603.webp",
        "002627.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Sẽ ướp với lại hành lá nè, cắt nhỏ lại, chúng ta bằm nhuyễn nè bỏ vô đây.",
      "start": 105.08,
      "end": 112.24,
      "n_words": 18,
      "start_frame": 2627,
      "end_frame": 2806,
      "keyframes": [
        "002627.webp",
        "002628.webp",
        "002644.webp",
        "002661.webp",
        "002662.webp",
        "002686.webp",
        "002710.webp",
