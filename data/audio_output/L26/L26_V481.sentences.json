      "end": 17.96,
      "n_words": 7,
      "start_frame": 409,
      "end_frame": 449,
      "keyframes": [
        "000421.webp",
        "000434.webp",
        "000435.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh trúng số hay sao mà tự nhiên cứ rủ em đi du lịch?",
      "start": 17.96,
      "end": 20.04,
      "n_words": 14,
      "start_frame": 449,
      "end_frame": 501,
      "keyframes": [
        "000467.webp",
        "000499.webp",
        "000500.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tại vì anh xem đây thấy những cái tour du lịch đó Nhật Bản nè, Hàn Quốc nè, rất hấp dẫn.",
      "start": 20.04,
      "end": 24.84,
      "n_words": 21,
      "start_frame": 501,
      "end_frame": 621,
      "keyframes": [
        "000525.webp",
