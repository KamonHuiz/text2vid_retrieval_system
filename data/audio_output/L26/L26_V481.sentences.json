      "keyframes": [
        "004418.webp",
        "004464.webp",
        "004465.webp",
        "004498.webp",
        "004531.webp",
        "004532.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thiếu cái gì chủ nhật nè, đây là rong biển khô kiểu Nhật, chính là ta gọi là wakame đó.",
      "start": 181.4,
      "end": 187.44,
