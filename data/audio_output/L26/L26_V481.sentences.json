      "end": 25.52,
      "n_words": 3,
      "start_frame": 621,
      "end_frame": 638,
      "keyframes": [
        "000638.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Nhưng mà khi nào mình đi?",
      "start": 25.52,
      "end": 26.6,
      "n_words": 6,
      "start_frame": 638,
      "end_frame": 665,
      "keyframes": [
        "000638.webp",
        "000639.webp",
        "000650.webp",
        "000661.webp",
        "000662.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Mình đi ngay bây giờ nè.",
      "start": 26.6,
      "end": 28.04,
      "n_words": 6,
      "start_frame": 665,
      "end_frame": 701,
      "keyframes": [
        "000679.webp",
        "000697.webp",
        "000698.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi chưa có visa gì cho sau đi anh?",
      "start": 28.04,
      "end": 29.92,
      "n_words": 9,
      "start_frame": 701,
      "end_frame": 748,
      "keyframes": [
        "000722.webp",
        "000747.webp",
        "000748.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Trời ơi, nóng ăn đâu cần visa đâu?",
