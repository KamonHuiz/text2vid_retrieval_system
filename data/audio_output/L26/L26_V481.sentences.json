      "end": 31.36,
      "n_words": 8,
      "start_frame": 748,
      "end_frame": 784,
      "keyframes": [
        "000748.webp",
        "000765.webp",
        "000782.webp",
        "000783.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Ủa là sao vậy nè?",
      "start": 31.36,
      "end": 33.96,
      "n_words": 5,
      "start_frame": 784,
      "end_frame": 849,
      "keyframes": [
        "000800.webp",
        "000818.webp",
        "000819.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh đang xem trên mạng.",
      "start": 33.96,
      "end": 35.84,
      "n_words": 5,
      "start_frame": 849,
      "end_frame": 896,
      "keyframes": [
        "000857.webp",
        "000895.webp",
        "000896.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh nghĩ mình nên kết hợp một số nguyên liệu, ví dụ như là mê nè, cái rong biển của Nhật, trái lê của Hàn Quốc.",
      "start": 35.84,
      "end": 42.0,
      "n_words": 26,
      "start_frame": 896,
      "end_frame": 1050,
      "keyframes": [
        "000896.webp",
