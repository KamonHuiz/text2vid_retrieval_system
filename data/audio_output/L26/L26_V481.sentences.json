        "000324.webp",
        "000349.webp",
        "000350.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Anh đang xem mấy cái tour du lịch nè.",
      "start": 14.32,
      "end": 16.36,
      "n_words": 9,
      "start_frame": 358,
      "end_frame": 409,
      "keyframes": [
        "000378.webp",
        "000407.webp",
        "000408.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Em đi du lịch không hôm nay?",
