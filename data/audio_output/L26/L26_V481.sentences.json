        "003403.webp",
        "003415.webp",
        "003416.webp",
        "003436.webp",
        "003456.webp",
        "003457.webp",
        "003483.webp",
        "003509.webp",
        "003510.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Trộn lên cho đây một muỗng cà phê dầu mê.",
      "start": 140.44,
      "end": 143.56,
      "n_words": 10,
      "start_frame": 3511,
      "end_frame": 3589,
      "keyframes": [
        "003527.webp",
