        "004837.webp",
        "004875.webp",
        "004876.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi cho tí xíu dầu vô xào nhanh để xém thôi chứ đừng có để cho có màu nha các bạn.",
      "start": 195.16,
      "end": 200.64,
      "n_words": 21,
      "start_frame": 4879,
      "end_frame": 5016,
      "keyframes": [
        "004889.webp",
