        "004976.webp",
        "005010.webp",
        "005011.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Mỗi món canh chúng ta nó có cái mùi xào nó ngắn gấp, có bột năng vô á cho nên mình xào mình cũng để ý xíu nha các bạn.",
      "start": 200.64,
      "end": 206.72,
      "n_words": 30,
      "start_frame": 5016,
      "end_frame": 5168,
      "keyframes": [
        "005044.webp",
