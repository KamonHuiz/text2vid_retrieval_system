        "001096.webp",
        "001127.webp",
        "001158.webp",
        "001159.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Không biết là ngày hôm nay mình sẽ làm món gì đây ạ?",
      "start": 46.4,
      "end": 48.56,
      "n_words": 13,
      "start_frame": 1160,
      "end_frame": 1214,
      "keyframes": [
        "001184.webp",
        "001209.webp",
        "001210.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "- À, mình sẽ làm cái món cá ngừ cuộn phô mai nha.",
      "start": 48.56,
      "end": 51.8,
      "n_words": 13,
      "start_frame": 1214,
      "end_frame": 1295,
      "keyframes": [
        "001253.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Quý vị ơi, cá ngừ ở trong đó nó có chứa nhiều DHA và axit béo, sẽ rất là tốt cho hệ thần kinh nè, phát triển trí não và đặc biệt là giúp tái tạo lại tế bào não đó.",
      "start": 51.8,
      "end": 61.12,
      "n_words": 41,
      "start_frame": 1295,
      "end_frame": 1528,
      "keyframes": [
        "001296.webp",
        "001297.webp",
        "001410.webp",
        "001524.webp",
        "001525.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cái phần củ hồi này một nửa là mình sẽ băm nhỏ và một nửa là mình sẽ thái chỉ.",
      "start": 61.12,
      "end": 69.12,
