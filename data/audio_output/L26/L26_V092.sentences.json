        "004025.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "- Thanh Phương em hiểu rồi.",
      "start": 163.2,
      "end": 164.92,
      "n_words": 6,
      "start_frame": 4080,
      "end_frame": 4123,
      "keyframes": [
        "004123.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Tiếp theo thì mình sẽ làm lần lượt cho hết cái bốn cuộn của chúng ta nha.",
      "start": 164.92,
      "end": 169.32,
      "n_words": 18,
      "start_frame": 4123,
      "end_frame": 4233,
      "keyframes": [
        "004123.webp",
