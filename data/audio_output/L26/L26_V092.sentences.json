        "004615.webp",
        "004672.webp",
        "004673.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ cho nguyên cái gói bột ra đây, mình sẽ lăn đều cái bột này qua cái cuốn cá nha.",
      "start": 188.04,
      "end": 194.8,
      "n_words": 22,
      "start_frame": 4701,
      "end_frame": 4870,
      "keyframes": [
        "004724.webp",
