        "001829.webp",
        "001851.webp",
        "001874.webp",
        "001875.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Ngày hôm nay, với sự kết hợp của cá ngừ với lại củ hồi, một món ăn vừa mới vừa lạ.",
      "start": 77.36,
      "end": 81.76,
      "n_words": 21,
      "start_frame": 1934,
      "end_frame": 2044,
      "keyframes": [
        "001959.webp",
        "002043.webp",
        "002044.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nhờ Thanh Phương trụng giúp mình cái cà rốt và đậu cô ve nha.",
      "start": 81.76,
      "end": 86.16,
      "n_words": 14,
      "start_frame": 2044,
      "end_frame": 2154,
      "keyframes": [
        "002044.webp",
        "002068.webp",
        "002092.webp",
        "002093.webp",
        "002130.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hành mình sẽ trụng sơ qua và vớt ra liền để cho cọng hành mềm và lúc đó mình sẽ cuộn cho nó dễ hơn.",
      "start": 86.16,
      "end": 93.0,
      "n_words": 25,
      "start_frame": 2154,
      "end_frame": 2325,
      "keyframes": [
        "002168.webp",
