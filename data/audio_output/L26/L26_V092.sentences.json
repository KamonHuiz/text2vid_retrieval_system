      "end_frame": 1728,
      "keyframes": [
        "001569.webp",
        "001614.webp",
        "001615.webp",
        "001642.webp",
        "001669.webp",
        "001670.webp",
        "001701.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Phần còn lại băm nhỏ, ở trong củ hồi thì có chứa nhiều vitamin C nè, rất là tốt cho sức khỏe.",
      "start": 69.12,
      "end": 77.36,
      "n_words": 22,
      "start_frame": 1728,
      "end_frame": 1934,
      "keyframes": [
        "001733.webp",
        "001734.webp",
