      "n_words": 30,
      "start_frame": 843,
      "end_frame": 1052,
      "keyframes": [
        "000949.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "- Anh Minh ơi, em thấy cái phần cá ngừ trời ơi sao mà nó tươi ngon hấp dẫn quá vậy?",
      "start": 42.08,
      "end": 46.4,
      "n_words": 21,
      "start_frame": 1052,
      "end_frame": 1160,
      "keyframes": [
        "001057.webp",
