        "002504.webp",
        "002543.webp",
        "002582.webp",
        "002583.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi đó Thanh Phương, vớt ra nha.",
      "start": 103.36,
      "end": 105.96,
      "n_words": 7,
      "start_frame": 2584,
      "end_frame": 2649,
      "keyframes": [
        "002618.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chúng ta nên trụng rau củ trước khi cuộn giúp cá và các nguyên liệu được chín đều hơn.",
      "start": 105.96,
      "end": 110.4,
      "n_words": 19,
      "start_frame": 2649,
      "end_frame": 2760,
      "keyframes": [
        "002653.webp",
        "002654.webp",
        "002684.webp",
        "002715.webp",
        "002716.webp",
        "002738.webp",
        "002760.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Cá ngừ ở đây mình sẽ cắt một cái lát rất là mỏng.",
      "start": 110.4,
      "end": 113.88,
      "n_words": 13,
      "start_frame": 2760,
      "end_frame": 2847,
      "keyframes": [
        "002760.webp",
        "002761.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Với 300 gram cá ngừ đại dương như thế này mình sẽ cắt làm khoảng bốn miếng là đẹp.",
      "start": 113.88,
      "end": 120.56,
      "n_words": 19,
      "start_frame": 2847,
      "end_frame": 3014,
      "keyframes": [
        "002851.webp",
        "002942.webp",
        "002943.webp",
        "002981.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta sẽ cho vào trong đây một ít mù tạt xanh.",
      "start": 120.56,
      "end": 123.52,
      "n_words": 12,
      "start_frame": 3014,
      "end_frame": 3088,
      "keyframes": [
        "003019.webp",
        "003020.webp",
        "003049.webp",
        "003078.webp",
        "003079.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sử dụng mù tạt xanh cho vào trong cá giúp khử mùi tanh của cá nha.",
      "start": 123.52,
      "end": 127.12,
      "n_words": 16,
      "start_frame": 3088,
      "end_frame": 3178,
      "keyframes": [
        "003108.webp",
