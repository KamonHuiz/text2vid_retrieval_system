        "003042.webp",
        "003165.webp",
        "003166.webp",
        "003195.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thịt cua và tôm đều cung cấp canxi và chất đạm cho cơ thể.",
      "start": 128.0,
      "end": 131.68,
      "n_words": 14,
      "start_frame": 3200,
      "end_frame": 3292,
      "keyframes": [
        "003224.webp",
