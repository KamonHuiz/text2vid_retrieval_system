        "003532.webp",
        "003563.webp",
        "003564.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Phần bánh gạo cũng đã sôi được 2 phút rồi, bây giờ thì chúng ta sẽ vớt bánh gạo ra.",
      "start": 142.72,
      "end": 147.04,
      "n_words": 20,
      "start_frame": 3568,
      "end_frame": 3676,
      "keyframes": [
        "003588.webp",
