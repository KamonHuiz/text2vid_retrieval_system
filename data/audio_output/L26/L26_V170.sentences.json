        "002664.webp",
        "002699.webp",
        "002700.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đây là bánh gạo, chúng ta sẽ cho vô, chúng ta trụng luôn.",
      "start": 108.04,
      "end": 111.28,
      "n_words": 13,
      "start_frame": 2701,
      "end_frame": 2782,
      "keyframes": [
        "002746.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chúng ta sẽ nấu bánh gạo khoảng 3 phút để cho bánh gạo thấm vị thì món ăn sẽ ngon hơn nhé.",
      "start": 111.28,
      "end": 116.76,
      "n_words": 22,
