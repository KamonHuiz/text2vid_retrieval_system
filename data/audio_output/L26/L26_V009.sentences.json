      "end": 49.12,
      "n_words": 29,
      "start_frame": 1030,
      "end_frame": 1228,
      "keyframes": [
        "001034.webp",
        "001035.webp",
        "001134.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Em chào cô Hà Tuấn!",
      "start": 49.12,
      "end": 50.88,
      "n_words": 5,
      "start_frame": 1228,
      "end_frame": 1272,
      "keyframes": [
        "001233.webp",
        "001234.webp",
        "001251.webp",
        "001268.webp",
        "001269.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Hôm nay mình đổi cái không khí mình làm một cái món gì đó mà nó thật là trẻ, thật là tươi mới đi cô. Một món hơi mang hơi hướng của món châu Âu xíu ha?",
      "start": 50.88,
      "end": 60.0,
      "n_words": 37,
      "start_frame": 1272,
      "end_frame": 1500,
      "keyframes": [
        "001303.webp",
        "001338.webp",
        "001339.webp",
        "001378.webp",
        "001417.webp",
        "001418.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Ủa sao em chưa yêu cầu mà nhà hàng Thu Hà đã trả lời luôn rồi ý?",
      "start": 60.0,
      "end": 63.24,
      "n_words": 17,
      "start_frame": 1500,
      "end_frame": 1581,
      "keyframes": [
        "001562.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em là vậy đó, em muốn mua cái món mà nó tây, nó dễ làm, các bạn trẻ có thể làm tại nhà bất cứ lúc nào.",
      "start": 63.24,
      "end": 69.68,
      "n_words": 27,
      "start_frame": 1581,
      "end_frame": 1742,
      "keyframes": [
        "001706.webp",
        "001707.webp",
        "001737.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Hôm nay chúng ta hãy cùng nhau thực hiện món bò cuộn xúc xích chiên.",
      "start": 69.68,
      "end": 73.12,
      "n_words": 15,
      "start_frame": 1742,
      "end_frame": 1828,
      "keyframes": [
        "001767.webp",
        "001768.webp",
        "001798.webp",
        "001828.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và theo chuyên gia dinh dưỡng thì món ăn này có công dụng hỗ trợ bổ máu.",
      "start": 73.12,
      "end": 77.24,
      "n_words": 17,
      "start_frame": 1828,
      "end_frame": 1931,
      "keyframes": [
        "001828.webp",
        "001829.webp",
        "001879.webp",
        "001929.webp",
        "001930.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đầu tiên thì chúng ta sẽ có ba chỉ bò, thì chúng ta sẽ mua ba chỉ bò cắt lát sẵn á.",
      "start": 77.24,
      "end": 82.68,
      "n_words": 22,
      "start_frame": 1931,
      "end_frame": 2067,
      "keyframes": [
        "001953.webp",
        "001977.webp",
        "001978.webp",
        "001996.webp",
        "002014.webp",
        "002015.webp",
        "002036.webp",
        "002058.webp",
        "002059.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi bây giờ trải miếng ba chỉ bò ra, sau khi mình trải xong các miếng thịt bò đó, nó bằng với lại chiều dài của cây xúc xích thì chúng ta sẽ cuốn nó lại.",
      "start": 82.68,
      "end": 90.88,
      "n_words": 36,
      "start_frame": 2067,
      "end_frame": 2272,
      "keyframes": [
        "002085.webp",
        "002112.webp",
        "002113.webp",
        "002133.webp",
        "002154.webp",
        "002155.webp",
        "002216.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Trong món ăn này thì có nguyên liệu chính là thịt bò, mà trong thịt bò thì có rất là nhiều chất dinh dưỡng hỗ trợ bổ máu nên các bạn có thể bổ sung thịt bò vào trong khẩu phần ăn ha.",
      "start": 90.88,
      "end": 98.88,
      "n_words": 43,
      "start_frame": 2272,
      "end_frame": 2472,
      "keyframes": [
        "002277.webp",
        "002278.webp",
        "002320.webp",
        "002363.webp",
        "002364.webp",
        "002390.webp",
        "002416.webp",
        "002417.webp",
        "002441.webp",
        "002465.webp",
        "002466.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Tẩm cái cuộn bò này qua một lớp Ajinomoto bột tẩm khô chiên giòn.",
      "start": 98.88,
      "end": 103.12,
      "n_words": 14,
      "start_frame": 2472,
      "end_frame": 2578,
      "keyframes": [
        "002521.webp",
        "002576.webp",
        "002577.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta dùng Ajinomoto bột tẩm khô chiên giòn để tạo độ giòn và đậm đà cho món ăn mà không cần phải nêm thêm gia vị.",
      "start": 103.12,
      "end": 109.2,
      "n_words": 27,
      "start_frame": 2578,
      "end_frame": 2730,
      "keyframes": [
        "002653.webp",
        "002730.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Các bạn thấy là món ăn này rất là nhanh gọn, nguyên liệu thì đơn giản và đặc biệt là chúng ta sử dụng Ajinomoto bột tẩm khô chiên giòn, chỉ một lần dùng thôi, chúng ta sẽ đảm bảo được là mùi vị cân bằng và không có quá nhiều gia vị nêm nếm.",
      "start": 109.2,
      "end": 121.52,
      "n_words": 55,
      "start_frame": 2730,
      "end_frame": 3038,
      "keyframes": [
        "002730.webp",
        "002731.webp",
        "002896.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mà chúng ta phải nhớ chúng ta sẽ cho vào đây khoảng chừng hai muỗng canh dầu ăn thôi, vừa vừa thôi.",
      "start": 121.52,
      "end": 128.08,
      "n_words": 22,
      "start_frame": 3038,
      "end_frame": 3202,
      "keyframes": [
        "003062.webp",
        "003063.webp",
        "003119.webp",
        "003175.webp",
        "003176.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ chúng ta sẽ cho từng cái cuộn xúc xích cuộn thịt bò này vô.",
      "start": 128.08,
      "end": 135.16,
      "n_words": 16,
      "start_frame": 3202,
      "end_frame": 3379,
      "keyframes": [
        "003213.webp",
        "003250.webp",
        "003251.webp",
        "003291.webp",
        "003332.webp",
        "003333.webp",
        "003359.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Các bạn lưu ý là trong khi cuốn cũng như khi mà chúng ta áp chảo, nhớ đặt miếng bò ở bên dưới để định hình cuộn bò được đẹp mắt nha.",
      "start": 135.16,
      "end": 143.24,
      "n_words": 32,
      "start_frame": 3379,
      "end_frame": 3581,
      "keyframes": [
        "003386.webp",
        "003387.webp",
        "003482.webp",
        "003577.webp",
        "003578.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ thì chúng ta sẽ pha công thức dầu giấm.",
      "start": 143.24,
      "end": 145.44,
      "n_words": 11,
      "start_frame": 3581,
      "end_frame": 3636,
      "keyframes": [
        "003606.webp",
        "003634.webp",
        "003635.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta cho một chút xíu muối, một phần năm muỗng cà phê bột ngọt Ajinomoto, một phần tư muỗng cà phê tiêu, một muỗng cà phê đường, một muỗng canh giấm gạo lên men Ajinomoto, một muỗng canh nước lọc, một muỗng canh dầu phi hành tím, một muỗng hành tím xắt lát.",
      "start": 145.44,
      "end": 164.72,
      "n_words": 54,
      "start_frame": 3636,
      "end_frame": 4118,
      "keyframes": [
        "003656.webp",
