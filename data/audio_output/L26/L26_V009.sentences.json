        "004771.webp",
        "004772.webp",
        "004796.webp",
        "004821.webp",
        "004822.webp",
        "004866.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Như vậy là chúng ta đã hoàn thành xong món ăn của ngày hôm nay rồi đúng không cô? Đúng rồi đó Minh Tuấn, là bây giờ chúng ta chỉ cần trình bày nữa là thưởng thức.",
      "start": 195.04,
      "end": 202.52,
      "n_words": 37,
      "start_frame": 4876,
      "end_frame": 5063,
      "keyframes": [
        "004910.webp",
        "004911.webp",
        "004947.webp",
        "004983.webp",
        "004984.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Á dạ, còn các bạn nào mà chúng ta không kịp theo dõi công thức của ngày hôm nay thì ngay bây giờ có thể dùng điện thoại của mình quét mã QR đang xuất hiện trên màn hình để chúng ta sẽ có ngay công thức của món ăn ngày hôm nay và thực hiện tại nhà.",
      "start": 202.52,
      "end": 214.56,
      "n_words": 58,
      "start_frame": 5063,
      "end_frame": 5364,
      "keyframes": [
        "005151.webp",
        "005318.webp",
        "005319.webp",
        "005343.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Sau khi mà xúc xích tới hơi nguội rồi thì chúng ta sẽ cắt khúc ra như thế này, sẽ rưới cái phần dầu giấm lên trên rau.",
      "start": 214.56,
      "end": 227.88,
      "n_words": 28,
      "start_frame": 5364,
      "end_frame": 5697,
      "keyframes": [
        "005368.webp",
        "005369.webp",
        "005393.webp",
        "005417.webp",
