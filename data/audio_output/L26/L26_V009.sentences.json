        "004056.webp",
        "004085.webp",
        "004115.webp",
        "004116.webp"
      ],
      "keyframe_count": 27
    },
    {
      "text": "Cô sẽ cho vào đây một muỗng cà phê vỏ chanh mài.",
      "start": 164.72,
      "end": 167.52,
      "n_words": 12,
      "start_frame": 4118,
      "end_frame": 4188,
      "keyframes": [
        "004152.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Trong món ăn này thì chúng ta dùng vỏ chanh vàng mài nhuyễn để tạo hương vị đặc trưng cho phần nước sốt.",
      "start": 167.52,
      "end": 172.64,
      "n_words": 23,
      "start_frame": 4188,
      "end_frame": 4316,
      "keyframes": [
        "004189.webp",
        "004190.webp",
        "004251.webp",
        "004313.webp",
        "004314.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Vỏ chanh vàng thì nó rất là thơm mà nó lại không có nhiều vị đắng giống như là chanh xanh nên là chúng ta có thể sử dụng chanh vàng trong nhiều món ăn để tận dụng mùi hương rất là quyến rũ này nha.",
      "start": 172.64,
