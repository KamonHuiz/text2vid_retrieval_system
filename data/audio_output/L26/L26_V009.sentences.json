        "004497.webp",
        "004559.webp",
        "004560.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ thì chúng ta sẽ pha sốt chấm nhé.",
      "start": 182.48,
      "end": 184.44,
      "n_words": 10,
      "start_frame": 4562,
      "end_frame": 4611,
      "keyframes": [
        "004584.webp",
        "004608.webp",
        "004609.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ sử dụng hai muỗng canh sốt Mayonnaise Ajinomoto vị nguyên bản cùng với một muỗng canh tương ớt, một muỗng cà phê vỏ chanh vàng rồi trộn đều lên.",
      "start": 184.44,
      "end": 195.04,
      "n_words": 32,
      "start_frame": 4611,
      "end_frame": 4876,
      "keyframes": [
        "004659.webp",
        "004710.webp",
        "004711.webp",
