        "005637.webp",
        "005681.webp",
        "005682.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Em sẽ thử ngay, thật là nhiều sốt, thật là nhiều sốt vô.",
      "start": 227.88,
      "end": 234.36,
      "n_words": 13,
      "start_frame": 5697,
      "end_frame": 5859,
      "keyframes": [
        "005719.webp",
        "005756.webp",
        "005757.webp",
        "005823.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Mọi người ơi, ngon mười điểm!",
      "start": 234.36,
      "end": 237.6,
      "n_words": 6,
      "start_frame": 5859,
      "end_frame": 5940,
      "keyframes": [
        "005890.webp",
        "005891.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thơm, cái phần mà bò bên ngoài vẫn giữ được cái độ giòn rụm luôn, rất là vừa miệng.",
      "start": 237.6,
      "end": 247.68,
      "n_words": 19,
      "start_frame": 5940,
      "end_frame": 6192,
      "keyframes": [
        "005971.webp",
        "006052.webp",
        "006053.webp",
        "006102.webp",
        "006151.webp",
        "006152.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình cắn vào trong, bắt đầu xúc xích nha, thơm mùi xông khói này, sần sật và hòa với lại cái vị béo của sốt Mayonnaise Ajinomoto, nó rất là cân bằng, rất là đã miệng luôn cái món này nha.",
      "start": 247.68,
      "end": 258.8,
      "n_words": 41,
      "start_frame": 6192,
      "end_frame": 6470,
      "keyframes": [
        "006214.webp",
        "006277.webp",
        "006278.webp",
        "006364.webp",
        "006451.webp",
        "006452.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mà mình xem phim nè, hay là mình ngồi mà gọi là nhâm nhi với bạn bè này, không còn gì bằng luôn.",
      "start": 258.8,
      "end": 263.24,
      "n_words": 23,
      "start_frame": 6470,
      "end_frame": 6581,
      "keyframes": [
        "006515.webp",
        "006579.webp",
        "006580.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Để đạt được hiệu quả dinh dưỡng thì các bạn có thể áp dụng món ăn này theo bản thực đơn gợi ý sau đây.",
      "start": 263.24,
      "end": 272.08,
      "n_words": 25,
      "start_frame": 6581,
      "end_frame": 6802,
      "keyframes": [
        "006631.webp",
        "006683.webp",
        "006684.webp",
        "006746.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nếu bạn cần một món ăn chuẩn bị trong tích tắc thì đó chính xác là món ăn của ngày hôm nay.",
      "start": 272.08,
