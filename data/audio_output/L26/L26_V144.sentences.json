      "start_frame": 1236,
      "end_frame": 1259,
      "keyframes": [
        "001254.webp",
        "001255.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nhưng mà chúng ta phải biến tấu lại một ít để cho ra một cái món ăn rất là độc đáo.",
      "start": 50.36,
      "end": 55.28,
      "n_words": 21,
