      "n_words": 32,
      "start_frame": 934,
      "end_frame": 1149,
      "keyframes": [
        "000989.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Phương biết món gì rồi? Món gì?",
      "start": 45.96,
      "end": 47.4,
      "n_words": 7,
      "start_frame": 1149,
      "end_frame": 1185,
      "keyframes": [
        "001169.webp",
        "001170.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trứng cúc ốp la ăn với bánh mì sandwich.",
