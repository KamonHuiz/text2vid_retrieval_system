      "end": 49.04,
      "n_words": 9,
      "start_frame": 1185,
      "end_frame": 1226,
      "keyframes": [
        "001188.webp",
        "001207.webp",
        "001208.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chính xác luôn!",
