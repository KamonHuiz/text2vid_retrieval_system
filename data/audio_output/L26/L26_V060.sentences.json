        "003079.webp",
        "003122.webp",
        "003166.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần cà rốt thì Quốc Nghị sẽ khứa thành hoa mai sau đó cắt lát khoảng 0.5 cm.",
      "start": 126.64,
      "end": 135.2,
      "n_words": 18,
