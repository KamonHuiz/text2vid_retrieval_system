      ],
      "keyframe_count": 5
    },
    {
      "text": "Xong, nó ngập tràn hương thơm cả gian bếp luôn.",
      "start": 226.32,
      "end": 230.24,
      "n_words": 10,
      "start_frame": 5658,
      "end_frame": 5756,
      "keyframes": [
        "005724.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ chúng ta cùng chiêm ngưỡng canh gà tứ quý, hấp dẫn quá, xuất sắc!",
