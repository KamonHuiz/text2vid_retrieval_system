        "001466.webp",
        "001493.webp",
        "001494.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Còn Quốc Nghị thì chuẩn bị một con gà ta để hướng dẫn các bạn khán giả cùng Thanh Phương nấu món canh gà tứ quý, mong muốn một năm mới đầy đủ, ấm no và tràn đầy sức khỏe.",
      "start": 59.76,
      "end": 69.76,
      "n_words": 40,
      "start_frame": 1494,
      "end_frame": 1744,
      "keyframes": [
        "001494.webp",
        "001602.webp",
        "001711.webp",
        "001712.webp",
        "001734.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đó, theo như chuyên gia dinh dưỡng Tiến sĩ Đào Thị Yến Phi cho rằng đây là một món ăn rất là bổ máu, chúng ta hãy cùng nhau thực hiện thôi. Nhắc đến Tết cổ truyền thì không thể thiếu gà ta.",
      "start": 69.76,
      "end": 80.68,
      "n_words": 43,
      "start_frame": 1744,
      "end_frame": 2017,
      "keyframes": [
        "001756.webp",
        "001757.webp",
        "001910.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ, món ăn này Quốc Nghị sử dụng nửa con gà ta nè, rửa sạch sau đó chặt miếng vừa ăn nha các bạn.",
      "start": 80.68,
      "end": 86.16,
      "n_words": 24,
      "start_frame": 2017,
      "end_frame": 2154,
      "keyframes": [
        "002063.webp",
        "002064.webp",
        "002109.webp",
        "002154.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Về phần đậu ngự và đậu phộng, á Quốc Nghị sẽ luộc khoảng 30 phút trước.",
      "start": 86.16,
      "end": 90.04,
      "n_words": 16,
      "start_frame": 2154,
      "end_frame": 2251,
      "keyframes": [
        "002154.webp",
        "002155.webp",
        "002186.webp",
        "002217.webp",
        "002218.webp",
        "002238.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Luộc sơ qua đậu như thế sẽ giúp cho phần nấu canh sẽ nhanh hơn và ngoài ra nước dùng cũng sẽ trong hơn.",
      "start": 90.04,
      "end": 94.92,
      "n_words": 24,
      "start_frame": 2251,
      "end_frame": 2373,
      "keyframes": [
        "002258.webp",
        "002259.webp",
        "002315.webp",
        "002371.webp",
        "002372.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đối với đậu phộng thì các bạn nên ngâm trước ba tiếng giúp cho đậu phộng mềm hơn.",
      "start": 94.92,
      "end": 98.56,
      "n_words": 18,
      "start_frame": 2373,
      "end_frame": 2464,
      "keyframes": [
        "002416.webp",
        "002461.webp",
        "002462.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và bây giờ nhờ Thanh Phương sơ chế giúp Quốc Nghị nấm đông cô tươi nè, dạ khứa chữ thập.",
      "start": 98.56,
      "end": 104.2,
      "n_words": 20,
      "start_frame": 2464,
      "end_frame": 2605,
      "keyframes": [
        "002535.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và các bạn biết vì sao Quốc Nghị gọi món này là canh gà tứ quý không?",
      "start": 104.2,
      "end": 108.08,
      "n_words": 17,
      "start_frame": 2605,
      "end_frame": 2702,
      "keyframes": [
        "002608.webp",
        "002609.webp",
        "002667.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Vì trong món này Quốc Nghị sử dụng bốn loại đậu: đậu đỏ nè, đậu trắng nè, đậu phộng và đậu ngự.",
      "start": 108.08,
      "end": 113.68,
      "n_words": 22,
      "start_frame": 2702,
      "end_frame": 2842,
      "keyframes": [
        "002726.webp",
        "002727.webp",
        "002784.webp",
        "002842.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nó vừa dinh dưỡng mà nó vừa có ý nghĩa về ngày Tết ngày xuân đó.",
      "start": 113.68,
      "end": 117.96,
      "n_words": 16,
      "start_frame": 2842,
      "end_frame": 2949,
      "keyframes": [
        "002842.webp",
        "002843.webp",
        "002895.webp",
        "002948.webp",
        "002949.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Về phần hành lá và ngò rí thì các bạn sẽ cắt khúc nhỏ để làm rau nêm cho món canh.",
      "start": 117.96,
      "end": 126.64,
      "n_words": 21,
      "start_frame": 2949,
      "end_frame": 3166,
      "keyframes": [
        "002949.webp",
