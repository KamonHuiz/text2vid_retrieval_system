        "004074.webp",
        "004075.webp",
        "004099.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Chúng ta nên luộc đậu ngự và đậu phộng từ lúc nước nguội sẽ giúp cho đậu chín mềm hơn.",
      "start": 164.24,
      "end": 168.8,
      "n_words": 20,
      "start_frame": 4106,
      "end_frame": 4220,
      "keyframes": [
        "004123.webp",
        "004124.webp",
        "004172.webp",
        "004220.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Các loại đậu thì giàu protein và đặc biệt là với đậu đỏ thì có chứa nhiều chất sắt, rất là bổ máu các bạn ạ.",
      "start": 168.8,
      "end": 174.16,
      "n_words": 26,
