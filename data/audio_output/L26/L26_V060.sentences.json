      "end_frame": 3861,
      "keyframes": [
        "003766.webp",
        "003811.webp",
        "003812.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sau khi nước sôi thì chúng ta sẽ cho bốn loại đậu vào: đầu tiên đó là đậu ngự nè, đậu phộng nè, đậu đỏ tươi nè, đậu trắng tươi.",
      "start": 154.44,
      "end": 164.24,
      "n_words": 30,
      "start_frame": 3861,
      "end_frame": 4106,
      "keyframes": [
        "003873.webp",
        "003935.webp",
        "003936.webp",
        "003960.webp",
