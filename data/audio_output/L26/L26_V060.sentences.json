      "keyframes": [
        "005177.webp",
        "005240.webp",
        "005241.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Một món ăn bổ dưỡng nè, bổ máu và giúp tuần hoàn máu được tốt hơn nữa.",
      "start": 213.4,
      "end": 218.28,
