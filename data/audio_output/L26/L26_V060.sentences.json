        "003257.webp",
        "003348.webp",
        "003349.webp",
        "003370.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Một món ăn dinh dưỡng bổ máu và rất tốt cho trẻ em, đặc biệt là trong độ tuổi dậy thì.",
      "start": 135.2,
      "end": 140.16,
      "n_words": 21,
      "start_frame": 3380,
      "end_frame": 3504,
      "keyframes": [
        "003391.webp",
        "003413.webp",
        "003416.webp",
        "003420.webp",
        "003421.webp",
        "003462.webp",
        "003504.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Nhất là trong những ngày Tết như thế này thì có đậu đỏ sẽ làm cho năm mới thêm phần may mắn hơn.",
      "start": 140.16,
      "end": 144.44,
      "n_words": 23,
      "start_frame": 3504,
      "end_frame": 3611,
      "keyframes": [
        "003504.webp",
        "003505.webp",
        "003568.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và bây giờ chuẩn bị một nồi nước để chúng ta nấu canh gà tứ quý.",
      "start": 144.44,
      "end": 148.88,
      "n_words": 16,
      "start_frame": 3611,
      "end_frame": 3722,
      "keyframes": [
        "003632.webp",
        "003633.webp",
        "003676.webp",
        "003720.webp",
        "003721.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Các bạn sẽ chuẩn bị là 1.8 lít nước lọc, 200 ml nước dừa.",
      "start": 148.88,
      "end": 154.44,
      "n_words": 14,
