        "003099.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và tiếp theo Phước Hưng sẽ hướng dẫn cho quý vị chúng ta sơ chế đến những cái phần rau củ.",
      "start": 126.6,
