        "001474.webp",
        "001475.webp",
        "001562.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Mến chào các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 65.68,
      "end": 68.56,
      "n_words": 13,
