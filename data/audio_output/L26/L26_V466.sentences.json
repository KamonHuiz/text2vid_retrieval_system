      "end_frame": 1047,
      "keyframes": [
        "000936.webp",
        "000987.webp",
        "001039.webp",
        "001040.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Nghe có vẻ thú vị nha, giờ làm liền luôn ha.",
      "start": 41.88,
      "end": 44.08,
      "n_words": 11,
      "start_frame": 1047,
      "end_frame": 1102,
      "keyframes": [
        "001078.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Vào bếp lạ miệng và bổ dưỡng cùng cá ngừ đại dương lúc lắc.",
      "start": 44.08,
      "end": 65.68,
      "n_words": 14,
