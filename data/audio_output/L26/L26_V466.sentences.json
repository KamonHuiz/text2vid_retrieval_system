        "002895.webp",
        "002896.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thì chúng ta sẽ ướp cá khoảng năm tới bảy phút là được.",
      "start": 117.12,
      "end": 119.84,
      "n_words": 13,
