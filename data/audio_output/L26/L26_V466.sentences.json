      "keyframes": [
        "001650.webp",
        "001651.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 68.56,
      "end": 72.48,
      "n_words": 11,
      "start_frame": 1714,
      "end_frame": 1812,
      "keyframes": [
        "001755.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Công đoạn đầu tiên cho món ăn này thì cái phần cá ngừ đại dương, Phước Hưng sẽ cắt vuông góc.",
      "start": 72.48,
      "end": 76.84,
      "n_words": 21,
