        "001901.webp",
        "001917.webp",
        "001918.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta sẽ khứa dao thì cá nó không bị bể, sẽ đẹp hơn.",
      "start": 76.84,
      "end": 81.36,
      "n_words": 14,
