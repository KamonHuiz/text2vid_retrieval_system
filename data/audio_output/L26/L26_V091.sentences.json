      "n_words": 11,
      "start_frame": 4376,
      "end_frame": 4426,
      "keyframes": [
        "004397.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Cô sẽ đặt lên đây một cái nồi và Thảo giúp cô mở lửa nha.",
      "start": 177.04,
      "end": 180.68,
