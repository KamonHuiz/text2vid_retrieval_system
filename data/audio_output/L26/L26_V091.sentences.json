      "keyframes": [
        "000882.webp",
        "000883.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 39.88,
      "end": 44.8,
      "n_words": 11,
      "start_frame": 997,
      "end_frame": 1120,
      "keyframes": [
        "001005.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ngày hôm nay em thấy là cô Hà đã chuẩn bị thịt bê và tên của món ăn là \"kim thoải\", phải nhẩm đi nhẩm lại rất nhiều lần.",
      "start": 44.8,
      "end": 52.24,
      "n_words": 29,
      "start_frame": 1120,
      "end_frame": 1306,
      "keyframes": [
        "001128.webp",
