        "001270.webp",
        "001298.webp",
        "001299.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Thịt bê om giấm nghệ nghe là thấy nguyên liệu kết hợp rất là lạ rồi đó cô ạ.",
      "start": 52.24,
      "end": 58.64,
      "n_words": 19,
      "start_frame": 1306,
      "end_frame": 1466,
      "keyframes": [
        "001328.webp",
