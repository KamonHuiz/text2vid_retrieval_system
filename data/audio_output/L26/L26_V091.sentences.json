        "001396.webp",
        "001435.webp",
        "001436.webp",
        "001464.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Thịt bê thì là thịt con bê, và về thành phần dinh dưỡng thì nó cũng tương đương như là thịt bò.",
      "start": 58.64,
      "end": 65.48,
      "n_words": 22,
      "start_frame": 1466,
      "end_frame": 1637,
      "keyframes": [
        "001493.webp",
