        "002148.webp",
        "002149.webp",
        "002190.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bây giờ chúng ta sẽ ướp gia vị vào trong thịt bê nha.",
      "start": 89.12,
      "end": 91.52,
      "n_words": 13,
