      "end_frame": 475,
      "keyframes": [
        "000359.webp",
        "000418.webp",
        "000419.webp",
        "000447.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tóm lại là Phương muốn ăn hay muốn ngắm?",
      "start": 19.0,
      "end": 21.44,
      "n_words": 9,
      "start_frame": 475,
      "end_frame": 536,
      "keyframes": [
        "000476.webp",
