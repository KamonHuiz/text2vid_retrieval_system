        "003832.webp",
        "003890.webp",
        "003891.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Dễ đó.",
      "start": 156.28,
      "end": 158.08,
      "n_words": 2,
      "start_frame": 3907,
      "end_frame": 3952,
      "keyframes": [
        "003916.webp",
        "003942.webp",
        "003943.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ thấy công dụng của cái bột ớt chưa?",
