        "004214.webp",
        "004242.webp",
        "004243.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vì mình không muốn nó quá thẳng cho nên là cái hình dáng nó rất là đẹp ha.",
      "start": 170.52,
      "end": 174.08,
      "n_words": 18,
      "start_frame": 4263,
      "end_frame": 4352,
      "keyframes": [
        "004296.webp",
        "004350.webp",
        "004351.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì cái phần con tôm không có to lắm, mà dễ chín nữa, và cái phần vỏ ở ngoài cũng rất là mỏng cho nên tôm chín rất là đều.",
      "start": 174.08,
      "end": 180.64,
      "n_words": 30,
      "start_frame": 4352,
      "end_frame": 4516,
      "keyframes": [
        "004386.webp",
        "004421.webp",
