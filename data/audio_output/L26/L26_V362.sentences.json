      "end": 160.2,
      "n_words": 10,
      "start_frame": 3952,
      "end_frame": 4005,
      "keyframes": [
        "003971.webp",
        "003999.webp",
        "004000.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, con tôm có màu sắc hơn và đẹp nữa.",
