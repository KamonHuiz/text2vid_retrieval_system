        "004861.webp",
        "004918.webp",
        "004919.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bây giờ xin sẽ chia sẻ cho mọi người cách pha sốt với húng bạc hà nha.",
      "start": 196.8,
      "end": 200.92,
