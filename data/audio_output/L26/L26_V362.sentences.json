  "n_sentences": 50,
  "total_words": 1022,
  "sentences": [
    {
      "text": "Món ngon mỗi ngày.",
      "start": 10.48,
      "end": 12.04,
      "n_words": 4,
      "start_frame": 262,
      "end_frame": 301,
      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Hai tay Phương bưng cái chậu bạc hà, một là để ngắm, hai là để ăn.",
      "start": 12.04,
      "end": 19.0,
