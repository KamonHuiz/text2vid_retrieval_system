      "end": 163.12,
      "n_words": 11,
      "start_frame": 4005,
      "end_frame": 4078,
      "keyframes": [
        "004037.webp",
        "004074.webp",
        "004075.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và với cái thao tác ngay từ đầu mà chúng ta khứa cái phần bụng tôm nè và nhấn xuống như vậy thì cái con tôm đúng như xin nói là nó không bị cong lại.",
