      "end_frame": 4688,
      "keyframes": [
        "004575.webp",
        "004613.webp",
        "004651.webp",
        "004652.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thì bây giờ chúng ta sẽ để qua giấy thấm dầu.",
