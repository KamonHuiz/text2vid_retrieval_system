        "001048.webp",
        "001065.webp",
        "001082.webp",
        "001083.webp",
        "001107.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Tôm chiên dừa sốt bạc hà phá cách, the cay, tắm tắc khen.",
      "start": 45.24,
      "end": 49.96,
      "n_words": 13,
      "start_frame": 1131,
      "end_frame": 1249,
      "keyframes": [
        "001132.webp",
        "001133.webp",
        "001195.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ngay sau đây mời chào các bạn khán giả đến với chương trình Món ngon mỗi ngày.",
      "start": 49.96,
      "end": 67.68,
      "n_words": 17,
      "start_frame": 1249,
      "end_frame": 1692,
      "keyframes": [
        "001257.webp",
        "001258.webp",
        "001292.webp",
        "001326.webp",
        "001341.webp",
        "001396.webp",
        "001452.webp",
        "001453.webp",
        "001539.webp",
        "001626.webp",
        "001627.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 67.68,
      "end": 71.2,
      "n_words": 11,
      "start_frame": 1692,
      "end_frame": 1780,
      "keyframes": [
        "001706.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đầu tiên chúng ta sẽ sơ chế tôm.",
      "start": 71.2,
      "end": 73.24,
      "n_words": 8,
      "start_frame": 1780,
      "end_frame": 1831,
      "keyframes": [
        "001785.webp",
        "001786.webp",
        "001822.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì phần tôm thì chúng ta bóc vỏ, lấy chỉ lưng và cái đặc biệt là chúng ta nên lấy bỏ luôn cái phần gai tôm ở sau.",
      "start": 73.24,
      "end": 79.52,
      "n_words": 28,
      "start_frame": 1831,
      "end_frame": 1988,
      "keyframes": [
        "001859.webp",
        "001860.webp",
        "001902.webp",
        "001944.webp",
        "001945.webp",
        "001968.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta nên cắt bỏ gai nhọn của tôm để an toàn khi sơ chế và khi ăn.",
      "start": 79.76,
      "end": 83.76,
      "n_words": 18,
      "start_frame": 1994,
      "end_frame": 2094,
      "keyframes": [
        "002012.webp",
        "002031.webp",
        "002032.webp",
        "002058.webp",
        "002085.webp",
        "002086.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và bây giờ tôi sẽ tiến hành cắt một vài đường ở dưới bụng con tôm.",
      "start": 83.76,
      "end": 87.44,
      "n_words": 16,
      "start_frame": 2094,
      "end_frame": 2186,
      "keyframes": [
        "002129.webp",
        "002173.webp",
        "002174.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Với cái cách này thì như xin nói là mình không có cần phải xiên cái que tăm vào khi chiên đúng không? Đúng rồi.",
      "start": 87.44,
      "end": 93.08,
      "n_words": 25,
      "start_frame": 2186,
      "end_frame": 2327,
      "keyframes": [
        "002198.webp",
        "002223.webp",
        "002224.webp",
        "002277.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Và chúng ta sẽ ấn nhẹ con tôm tay của mình, mình nhấn xuống mình nghe nó kêu hơi cắt kiểu nhẹ nhẹ là được.",
      "start": 93.08,
      "end": 99.2,
      "n_words": 25,
      "start_frame": 2327,
      "end_frame": 2480,
      "keyframes": [
        "002331.webp",
        "002332.webp",
        "002353.webp",
        "002374.webp",
        "002375.webp",
        "002397.webp",
        "002420.webp",
        "002421.webp",
        "002451.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và đây là con tôm cuối cùng nha.",
      "start": 99.2,
      "end": 101.12,
      "n_words": 8,
      "start_frame": 2480,
      "end_frame": 2528,
      "keyframes": [
        "002482.webp",
        "002483.webp",
        "002506.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "À con tôm sẽ cong như này, ô đẹp quá.",
      "start": 101.12,
      "end": 104.96,
      "n_words": 10,
      "start_frame": 2528,
      "end_frame": 2624,
      "keyframes": [
        "002529.webp",
        "002530.webp",
        "002548.webp",
        "002566.webp",
        "002567.webp",
        "002597.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ tẩm ướp với khoảng một muỗng canh nước chanh nha.",
      "start": 104.96,
      "end": 109.04,
      "n_words": 13,
      "start_frame": 2624,
      "end_frame": 2726,
      "keyframes": [
        "002627.webp",
        "002628.webp",
        "002677.webp",
        "002726.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khi làm các món tôm thì chúng ta nên ướp tôm với nước chanh để khử bỏ mùi tanh của tôm nha.",
      "start": 109.04,
      "end": 113.64,
      "n_words": 22,
      "start_frame": 2726,
      "end_frame": 2841,
      "keyframes": [
        "002726.webp",
        "002727.webp",
        "002779.webp",
        "002832.webp",
        "002833.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ngoài cái phần mà nước chanh thì chúng ta cần thêm một muỗng cà phê ớt bột nữa và chúng ta sẽ trộn đều cái phần hỗn hợp tôm nước chanh.",
      "start": 113.64,
      "end": 120.64,
      "n_words": 31,
      "start_frame": 2841,
      "end_frame": 3016,
      "keyframes": [
        "002886.webp",
        "002940.webp",
        "002941.webp",
        "002963.webp",
        "002986.webp",
        "002987.webp",
        "003001.webp",
        "003015.webp",
        "003016.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Sau cái phần này thì xin sẽ trộn cái phần gia vị nêm sẵn Ajinomoto, bột tẩm khô chiên giòn và 70 g dừa sấy nha.",
      "start": 120.64,
      "end": 126.68,
      "n_words": 26,
      "start_frame": 3016,
      "end_frame": 3167,
      "keyframes": [
        "003016.webp",
        "003035.webp",
        "003054.webp",
        "003055.webp",
        "003091.webp",
        "003128.webp",
        "003129.webp",
        "003151.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trong thời gian xin trộn phần đó thì chắc là nhờ Minh Phương lấy giùm cái chảo dầu.",
      "start": 126.68,
      "end": 129.88,
      "n_words": 18,
      "start_frame": 3167,
      "end_frame": 3247,
      "keyframes": [
        "003173.webp",
        "003174.webp",
        "003207.webp",
        "003240.webp",
        "003241.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta bắt lên chúng ta tẩm và chiên tại chỗ luôn.",
      "start": 129.88,
      "end": 132.36,
      "n_words": 12,
      "start_frame": 3247,
      "end_frame": 3309,
      "keyframes": [
        "003274.webp",
        "003307.webp",
        "003308.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Xin ơi, đối với món ăn này Phương rất là háo hức biết sao không?",
      "start": 132.36,
      "end": 136.56,
      "n_words": 15,
      "start_frame": 3309,
      "end_frame": 3414,
      "keyframes": [
        "003406.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Tự nhiên phần tôm chiên giòn nghe là hấp dẫn rồi nha, nhưng mà đặc biệt là có cái phần dừa sấy nữa đúng không?",
      "start": 136.56,
      "end": 143.28,
      "n_words": 25,
      "start_frame": 3414,
      "end_frame": 3582,
      "keyframes": [
        "003504.webp",
        "003505.webp",
        "003561.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Rồi mấy phần béo béo, thơm thơm đặc trưng của dừa khô nữa, hấp dẫn quá, hấp dẫn quá.",
      "start": 143.28,
      "end": 147.32,
      "n_words": 19,
      "start_frame": 3582,
      "end_frame": 3683,
      "keyframes": [
        "003618.webp",
        "003619.webp",
