        "000686.webp",
        "000776.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Rất vui khi được gặp lại các bạn đang xem chương trình Món ngon mỗi ngày.",
      "start": 32.52,
      "end": 38.48,
