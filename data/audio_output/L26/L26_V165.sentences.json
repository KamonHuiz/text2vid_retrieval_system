      "start_frame": 962,
      "end_frame": 1090,
      "keyframes": [
        "001057.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Anh Vũ Biết: \"Khi mà những dịp Tết cổ truyền của mình á, thì em có rất nhiều những người bạn nước ngoài.",
      "start": 43.6,
      "end": 50.2,
      "n_words": 23,
      "start_frame": 1090,
      "end_frame": 1255,
      "keyframes": [
        "001247.webp",
        "001248.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Những người bạn nước ngoài của em thì họ ở Việt Nam và họ ăn Tết, thì phải nói một điều rằng là văn hóa ẩm thực của Việt Nam mình rất là tinh tế luôn.",
      "start": 50.2,
      "end": 58.64,
      "n_words": 36,
      "start_frame": 1255,
      "end_frame": 1466,
      "keyframes": [
        "001300.webp",
        "001352.webp",
        "001353.webp",
        "001393.webp",
        "001433.webp",
        "001434.webp",
        "001454.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Và để giới thiệu một cái món để mà họ thấy được cái văn hóa truyền thống của Việt Nam, và đặc biệt là sự tinh tế trong ẩm thực và liên quan đến ngày Tết nữa, thì em thường chọn món thịt kho trứng.\"",
      "start": 58.64,
      "end": 68.0,
      "n_words": 45,
      "start_frame": 1466,
      "end_frame": 1700,
      "keyframes": [
        "001474.webp",
