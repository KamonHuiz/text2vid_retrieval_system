        "000982.webp",
        "001054.webp",
        "001055.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cảm ơn em, ăn lấy sức.",
      "start": 42.92,
      "end": 44.16,
      "n_words": 6,
      "start_frame": 1073,
      "end_frame": 1104,
      "keyframes": [
        "001094.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Còn em cầm trái này cho cô, mình làm cái táo đúng rồi, mê mẩn với bánh dân táo mừng.",
      "start": 44.16,
