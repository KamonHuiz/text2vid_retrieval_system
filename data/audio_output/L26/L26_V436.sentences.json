      "keyframes": [
        "003235.webp",
        "003236.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cắt hạt lựu nè, ướp với đường nó sẽ tươm nước lên như thế này.",
      "start": 129.68,
      "end": 132.64,
