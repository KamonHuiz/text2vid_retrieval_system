        "002268.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Rồi hạt lựu đẹp xuất sắc, em tự ngưỡng mộ em luôn.",
      "start": 90.72,
      "end": 96.64,
      "n_words": 12,
