        "002587.webp",
        "002588.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Các bạn nhớ là whipping mà muốn đánh nổi thì chúng ta sẽ giữ lạnh đó nha.",
      "start": 103.6,
      "end": 107.2,
      "n_words": 17,
      "start_frame": 2590,
      "end_frame": 2680,
