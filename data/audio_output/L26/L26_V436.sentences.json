      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chào Minh Tú, bữa nay rảnh quá ha, ngồi đây ăn táo hả?",
      "start": 12.6,
      "end": 15.68,
      "n_words": 13,
