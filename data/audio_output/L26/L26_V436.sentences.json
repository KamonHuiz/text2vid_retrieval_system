        "000658.webp",
        "000682.webp",
        "000683.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cô muốn là cung cấp cho em thêm một món ăn từ trái táo, đó là cô sẽ kết hợp táo và làm bánh, thay vì em ăn táo không, nó buồn chán quá đúng không?",
      "start": 27.4,
      "end": 36.08,
      "n_words": 36,
      "start_frame": 685,
      "end_frame": 902,
      "keyframes": [
        "000765.webp",
        "000847.webp",
        "000848.webp",
        "000878.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cô rồi bây giờ hai cô trò mình mỗi người một miếng táo hả?",
      "start": 36.08,
      "end": 42.92,
      "n_words": 14,
      "start_frame": 902,
      "end_frame": 1073,
      "keyframes": [
        "000909.webp",
