      "keyframes": [
        "000342.webp",
        "000384.webp",
        "000385.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chào cô.",
      "start": 15.68,
      "end": 16.8,
      "n_words": 2,
      "start_frame": 392,
      "end_frame": 420,
      "keyframes": [
        "000399.webp",
        "000413.webp",
        "000414.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bởi vì em nghe nói là trong táo có rất là nhiều vitamin tốt cho sức khỏe, còn đẹp da nữa.",
      "start": 16.8,
      "end": 21.68,
      "n_words": 21,
      "start_frame": 420,
      "end_frame": 542,
      "keyframes": [
        "000510.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em ăn đến khi nào mà em xanh tươi như trái táo thì em mới chịu, trái nha.",
      "start": 21.68,
      "end": 25.08,
      "n_words": 18,
      "start_frame": 542,
      "end_frame": 627,
      "keyframes": [
        "000606.webp",
        "000607.webp",
        "000620.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ủa sao tự nhiên cái vô cái cô xin táo của em?",
      "start": 25.08,
      "end": 27.4,
      "n_words": 12,
      "start_frame": 627,
      "end_frame": 685,
      "keyframes": [
        "000634.webp",
