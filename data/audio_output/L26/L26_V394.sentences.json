        "005040.webp",
        "005066.webp",
        "005067.webp",
        "005092.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Khi mình cho xong hết thì bây giờ mình bắt đầu bỏ bánh vào trong chảo dầu nha.",
      "start": 204.48,
      "end": 208.44,
      "n_words": 18,
      "start_frame": 5112,
      "end_frame": 5211,
      "keyframes": [
        "005117.webp",
        "005118.webp",
        "005157.webp",
        "005196.webp",
        "005197.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Đó, bỏ cái khuôn bánh vô, nghe tiếng bánh xèo xèo thiệt là đói bụng luôn á mọi người.",
      "start": 208.44,
      "end": 214.72,
      "n_words": 19,
      "start_frame": 5211,
      "end_frame": 5368,
      "keyframes": [
        "005253.webp",
        "005310.webp",
        "005311.webp",
        "005337.webp",
        "005364.webp",
        "005365.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đặt vô xong rồi mình bắt đầu mình chỉnh lại, chỉnh lại luôn miếng ớt, mình lại cho cái khuôn thứ hai vào trong cái chảo dầu.",
      "start": 214.72,
      "end": 224.52,
      "n_words": 27,
      "start_frame": 5368,
      "end_frame": 5613,
      "keyframes": [
        "005429.webp",
        "005494.webp",
        "005495.webp",
        "005507.webp",
        "005520.webp",
        "005521.webp",
        "005568.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Đối với lại món bánh này thì mình chiên lửa vừa vừa thôi để cho bột chín tới ở bên trong bột luôn ha, chứ mình đừng có chiên lửa lớn quá.",
      "start": 224.52,
      "end": 231.52,
      "n_words": 32,
      "start_frame": 5613,
      "end_frame": 5788,
      "keyframes": [
        "005615.webp",
        "005616.webp",
        "005705.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, cái nào mà nó chín nó vàng thì em sẽ gắp ra, quá đẹp.",
      "start": 231.52,
