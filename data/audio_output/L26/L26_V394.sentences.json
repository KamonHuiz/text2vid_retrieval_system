        "000593.webp",
        "000670.webp",
        "000671.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hôm nay cô chuẩn bị cho em một món nhưng mà không có chuẩn bị củ sắn thôi, mà thôi nhân cái em yêu cầu như vậy thì bây giờ mình cho thêm củ sắn vô, tôi nghĩ là sẽ rất là ngon.",
      "start": 27.28,
      "end": 36.48,
      "n_words": 43,
      "start_frame": 682,
      "end_frame": 912,
      "keyframes": [
        "000777.webp",
        "000883.webp",
        "000884.webp",
        "000896.webp",
        "000909.webp",
        "000910.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mở tủ lạnh lấy củ sắn ra giùm cô đi, có liền.",
      "start": 36.48,
      "end": 41.76,
      "n_words": 12,
      "start_frame": 912,
      "end_frame": 1044,
      "keyframes": [
        "000939.webp",
        "000969.webp",
        "000970.webp",
        "000982.webp",
        "000994.webp",
        "000995.webp",
        "001019.webp",
        "001044.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bánh tôm chiên củ sắn giòn rụm ngọt ngay.",
      "start": 41.76,
      "end": 61.12,
      "n_words": 9,
      "start_frame": 1044,
      "end_frame": 1528,
      "keyframes": [
        "001044.webp",
