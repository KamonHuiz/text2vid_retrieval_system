        "001354.webp",
        "001355.webp",
        "001442.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Mừng các bạn đang đến với chương trình Món ngon mỗi ngày.",
      "start": 61.12,
      "end": 64.0,
      "n_words": 12,
      "start_frame": 1528,
      "end_frame": 1600,
      "keyframes": [
        "001529.webp",
        "001530.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 64.0,
      "end": 67.92,
      "n_words": 11,
      "start_frame": 1600,
      "end_frame": 1698,
      "keyframes": [
        "001617.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ thì cô sẽ cắt cái phần thịt này cắt thành những cái miếng nho nhỏ.",
      "start": 67.92,
      "end": 72.68,
      "n_words": 17,
      "start_frame": 1698,
      "end_frame": 1817,
      "keyframes": [
        "001704.webp",
        "001705.webp",
        "001760.webp",
        "001815.webp",
        "001816.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cái này những thành phần hơi giống với lại món bánh tôm đúng không cô?",
      "start": 72.68,
      "end": 75.92,
      "n_words": 15,
      "start_frame": 1817,
      "end_frame": 1898,
      "keyframes": [
        "001853.webp",
        "001891.webp",
        "001892.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nhưng mà lại có củ sắn, cái sự kết hợp này đúng là lạ lùng ghê luôn.",
      "start": 75.92,
      "end": 79.64,
      "n_words": 17,
      "start_frame": 1898,
      "end_frame": 1991,
      "keyframes": [
        "001939.webp",
        "001987.webp",
        "001988.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mình sẽ cho vào đây 1/3 muỗng cà phê tiêu, một muỗng cà phê hành tím băm, một muỗng cà phê tỏi băm rồi mình trộn đều.",
      "start": 79.64,
      "end": 87.76,
      "n_words": 27,
      "start_frame": 1991,
      "end_frame": 2194,
      "keyframes": [
        "002023.webp",
        "002059.webp",
        "002060.webp",
        "002083.webp",
        "002106.webp",
        "002107.webp",
        "002132.webp",
        "002157.webp",
        "002158.webp",
        "002170.webp",
        "002183.webp",
        "002184.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Sẽ đặt một cái chảo nho nhỏ lên trên bếp nha, cho vào đây một ít dầu ăn.",
      "start": 87.76,
      "end": 91.76,
      "n_words": 18,
      "start_frame": 2194,
      "end_frame": 2294,
      "keyframes": [
        "002202.webp",
        "002220.webp",
        "002221.webp",
        "002236.webp",
        "002252.webp",
        "002253.webp",
        "002273.webp",
        "002293.webp",
        "002294.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Dầu nóng thì bây giờ chúng ta sẽ cho tỏi vào trong dầu, mình phi cho thơm.",
      "start": 91.76,
      "end": 95.44,
      "n_words": 17,
      "start_frame": 2294,
      "end_frame": 2386,
      "keyframes": [
        "002294.webp",
        "002340.webp",
        "002386.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tôm khô sau khi mua về thì các bạn lưu ý là chúng ta sẽ ngâm vào trong nước nóng, sau đó thì mình sẽ giã cho nó bể ra như thế này rồi em tắt lửa giúp cô đi, rồi mình sẽ rút ra dĩa này.",
      "start": 95.44,
      "end": 107.36,
      "n_words": 47,
      "start_frame": 2386,
      "end_frame": 2684,
      "keyframes": [
        "002386.webp",
        "002387.webp",
        "002476.webp",
        "002565.webp",
        "002566.webp",
        "002586.webp",
        "002606.webp",
        "002607.webp",
        "002623.webp",
        "002640.webp",
        "002641.webp",
        "002665.webp"
      ],
      "keyframe_count": 12
    },
    {
      "text": "Chúng ta chọn củ sắn thì chúng ta lưu ý là chúng ta sẽ chọn củ sắn có cái vỏ mà nó hơi màu đen đen nâu nâu á, là những củ sắn già thì nó sẽ ít nước.",
      "start": 107.36,
      "end": 117.4,
      "n_words": 39,
      "start_frame": 2684,
      "end_frame": 2935,
      "keyframes": [
        "002689.webp",
        "002690.webp",
        "002839.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Như vậy thì bánh mình sẽ giòn lâu hơn ha.",
      "start": 117.4,
      "end": 119.96,
      "n_words": 10,
      "start_frame": 2935,
      "end_frame": 2999,
      "keyframes": [
        "002988.webp",
        "002989.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cắt sợi, sau đó mình cắt khúc lại và mình sẽ trộn vô nồi một chút xíu muối, một chút xíu đường, vắt ráo nước thì chúng ta sẽ được phần củ sắn như thế này.",
      "start": 119.96,
      "end": 127.28,
      "n_words": 36,
      "start_frame": 2999,
      "end_frame": 3182,
      "keyframes": [
        "003056.webp",
        "003124.webp",
        "003125.webp",
        "003152.webp",
        "003179.webp",
        "003180.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Trộn một nửa tôm khô này rồi với lại củ sắn, cái mùi tôm khô bốc lên thơm quá cô ơi.",
      "start": 127.28,
      "end": 132.64,
      "n_words": 21,
      "start_frame": 3182,
      "end_frame": 3316,
      "keyframes": [
        "003196.webp",
        "003212.webp",
        "003213.webp",
        "003234.webp",
        "003256.webp",
        "003257.webp",
        "003292.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Rồi để pha bột thì đầu tiên chúng ta sẽ đập hai quả trứng gà vào chén.",
      "start": 132.64,
      "end": 136.72,
      "n_words": 17,
      "start_frame": 3316,
      "end_frame": 3418,
      "keyframes": [
        "003327.webp",
        "003328.webp",
        "003372.webp",
        "003416.webp",
        "003417.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Em giúp cô là em đánh hai quả trứng gà này lên đi ha cô ta.",
      "start": 136.72,
      "end": 140.12,
      "n_words": 16,
      "start_frame": 3418,
      "end_frame": 3503,
      "keyframes": [
        "003435.webp",
        "003454.webp",
        "003455.webp",
        "003477.webp",
        "003499.webp",
        "003500.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ dùng hai gói gia vị nêm sẵn bột chiên giòn, rồi mình sẽ cho vào trong tô, cho tiếp vào đây là 200 ml nước.",
      "start": 140.12,
      "end": 149.52,
      "n_words": 28,
      "start_frame": 3503,
      "end_frame": 3738,
      "keyframes": [
        "003528.webp",
        "003557.webp",
