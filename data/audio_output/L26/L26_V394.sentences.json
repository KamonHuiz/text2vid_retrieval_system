        "003594.webp",
        "003630.webp",
        "003631.webp",
        "003650.webp",
        "003669.webp",
        "003670.webp",
        "003709.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Cô sẽ pha bột hơi đặc hơn so với công thức hướng dẫn trên bao bì.",
      "start": 149.52,
      "end": 153.68,
      "n_words": 16,
      "start_frame": 3738,
      "end_frame": 3842,
      "keyframes": [
        "003748.webp",
        "003749.webp",
        "003794.webp",
        "003839.webp",
        "003840.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ cho trứng gà vô trộn chung với phần bột này luôn ha.",
      "start": 153.68,
      "end": 157.16,
      "n_words": 15,
      "start_frame": 3842,
      "end_frame": 3929,
      "keyframes": [
        "003882.webp",
        "003924.webp",
        "003925.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bột bánh mà còn có trứng gà nữa thì lúc nào cũng làm cho bánh được mềm hơn đúng không cô?",
      "start": 157.16,
      "end": 161.28,
      "n_words": 21,
      "start_frame": 3929,
      "end_frame": 4032,
      "keyframes": [
        "003960.webp",
        "003996.webp",
        "003997.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đúng rồi, rất là ngon luôn.",
      "start": 161.28,
      "end": 163.36,
      "n_words": 6,
      "start_frame": 4032,
      "end_frame": 4084,
      "keyframes": [
        "004039.webp",
        "004082.webp",
        "004083.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì bây giờ mình sẽ cho thêm vào trong bột này gồm có bắp mà mình đã nấu chín rồi, hẹ lá mình cắt khúc, tôm khô thì mình cũng sẽ cho vào đây luôn, ớt cắt sợi.",
      "start": 163.36,
      "end": 173.44,
      "n_words": 38,
      "start_frame": 4084,
      "end_frame": 4336,
      "keyframes": [
        "004124.webp",
        "004165.webp",
        "004166.webp",
        "004185.webp",
        "004204.webp",
        "004205.webp",
        "004224.webp",
        "004244.webp",
        "004245.webp",
        "004272.webp",
        "004300.webp",
        "004301.webp",
        "004318.webp",
        "004335.webp",
        "004336.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Chúng ta sẽ thêm là bắp rồi hẹ rồi ớt vân vân vào trong cái món ăn để giúp cân bằng dinh dưỡng và đồng thời cũng tăng hương vị cho món ăn nữa.",
      "start": 173.44,
      "end": 181.28,
      "n_words": 34,
      "start_frame": 4336,
      "end_frame": 4532,
      "keyframes": [
        "004336.webp",
        "004371.webp",
        "004407.webp",
        "004408.webp",
        "004469.webp",
        "004530.webp",
        "004531.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Và để làm cho món bánh này thì chúng ta sẽ cần hai cái vá như thế này.",
      "start": 181.28,
      "end": 185.76,
      "n_words": 18,
      "start_frame": 4532,
      "end_frame": 4644,
      "keyframes": [
        "004568.webp",
        "004605.webp",
        "004606.webp",
        "004624.webp",
        "004642.webp",
        "004643.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta sẽ làm nóng khuôn trước khi chiên giúp bánh sẽ dễ tróc ra nha.",
      "start": 185.76,
      "end": 190.12,
      "n_words": 16,
      "start_frame": 4644,
      "end_frame": 4753,
      "keyframes": [
        "004671.webp",
        "004699.webp",
        "004700.webp",
        "004725.webp",
        "004750.webp",
        "004751.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình sẽ cho vào đây một lớp bột tráng đều xung quanh.",
      "start": 190.12,
      "end": 193.04,
      "n_words": 12,
      "start_frame": 4753,
      "end_frame": 4826,
      "keyframes": [
        "004788.webp",
        "004826.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Tiếp theo thì mình sẽ đặt lên đây thịt rồi một ít củ sắn và tôm khô sẽ múc lên đây, thêm một lớp bột nữa, rồi trên cùng thì mình sẽ đặt hai con tôm, một miếng ớt hình tam giác.",
      "start": 193.04,
      "end": 204.48,
      "n_words": 42,
      "start_frame": 4826,
      "end_frame": 5112,
      "keyframes": [
        "004826.webp",
        "004827.webp",
        "004845.webp",
        "004863.webp",
        "004864.webp",
        "004893.webp",
        "004923.webp",
