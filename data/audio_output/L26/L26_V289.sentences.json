      "end": 34.08,
      "n_words": 8,
      "start_frame": 818,
      "end_frame": 852,
      "keyframes": [
        "000833.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ đằng kia đem tỏi lại thì bây giờ mình kết hợp lại đi.",
