      "end": 30.2,
      "n_words": 5,
      "start_frame": 726,
      "end_frame": 755,
      "keyframes": [
        "000749.webp",
        "000750.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Có luôn, bây giờ mới mua về hai ổ mì nè.",
