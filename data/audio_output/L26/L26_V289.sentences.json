      "end_frame": 1760,
      "keyframes": [
        "001670.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi bây giờ đầu tiên nha, bánh mì mình cắt ra từng miếng cái đã.",
      "start": 70.4,
      "end": 73.84,
