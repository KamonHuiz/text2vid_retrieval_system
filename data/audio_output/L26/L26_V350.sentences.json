        "001655.webp",
        "001742.webp",
        "001743.webp"
      ],
      "keyframe_count": 20
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 72.56,
      "end": 76.16,
      "n_words": 11,
