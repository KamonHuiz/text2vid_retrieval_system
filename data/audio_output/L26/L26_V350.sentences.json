      "end_frame": 704,
      "keyframes": [
        "000670.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Anh đã nghe rồi.",
      "start": 28.16,
      "end": 28.92,
      "n_words": 4,
      "start_frame": 704,
      "end_frame": 723,
      "keyframes": [
        "000707.webp",
        "000708.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ em muốn ăn bí đỏ ba mươi của anh đúng không? Dạ.",
