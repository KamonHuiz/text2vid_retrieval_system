        "000633.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ủa cái tin này bí mật lắm mà sao tự nhiên anh biết ta?",
      "start": 25.56,
      "end": 28.16,
      "n_words": 14,
