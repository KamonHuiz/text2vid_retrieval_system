      "end": 78.2,
      "n_words": 24,
      "start_frame": 1785,
      "end_frame": 1955,
      "keyframes": [
        "001785.webp",
        "001872.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thưa các bạn, để tiết kiệm thời gian các bạn thấy tôi đã bật sẵn lên đây trên bếp một cái chảo nước, mình cho vào đây khoảng hai lát gừng nha.",
      "start": 78.2,
      "end": 85.68,
      "n_words": 32,
      "start_frame": 1955,
      "end_frame": 2142,
      "keyframes": [
        "001960.webp",
        "001961.webp",
        "001975.webp",
        "001989.webp",
        "001990.webp",
        "002046.webp",
        "002103.webp",
        "002104.webp",
        "002126.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Các bạn có muối không ạ?",
      "start": 85.68,
      "end": 86.88,
      "n_words": 6,
      "start_frame": 2142,
      "end_frame": 2172,
      "keyframes": [
        "002148.webp",
        "002149.webp",
        "002167.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chính xác, mình cho vào đây một ít muối nha, một tí xíu rượu trắng.",
      "start": 86.88,
      "end": 90.92,
      "n_words": 15,
      "start_frame": 2172,
      "end_frame": 2273,
      "keyframes": [
        "002185.webp",
        "002186.webp",
        "002209.webp",
        "002232.webp",
        "002233.webp",
        "002266.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta nên trần chân gà sơ qua với lại nước pha chút xíu muối, rượu trắng và gừng để chân gà được thơm hơn và sạch hơn nha các bạn.",
      "start": 90.92,
      "end": 98.32,
      "n_words": 31,
      "start_frame": 2273,
      "end_frame": 2458,
      "keyframes": [
        "002300.webp",
        "002301.webp",
        "002379.webp",
        "002458.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi bây giờ sau khi nước sôi thì chúng ta cho chân gà vào đây, mà các bạn thấy nè, đó, chân gà đã khứa ra một đường dọc như vậy, chúng ta chỉ cần nhanh thôi khoảng độ chừng hai phút rồi mình xả qua nước lạnh.",
      "start": 98.32,
      "end": 110.12,
      "n_words": 48,
      "start_frame": 2458,
      "end_frame": 2753,
      "keyframes": [
        "002458.webp",
        "002459.webp",
        "002499.webp",
        "002540.webp",
