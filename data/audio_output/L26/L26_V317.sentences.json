        "003147.webp",
        "003180.webp",
        "003214.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Củ sen thì lâu chín hơn nên chúng ta cắt lát dày khoảng chừng 3 ly thôi.",
      "start": 128.56,
      "end": 131.96,
