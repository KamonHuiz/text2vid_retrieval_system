  "sentences": [
    {
      "text": "Món ngon mỗi ngày. Anh Vũ ơi, em mới săn được mấy cái thố tim dễ thương chưa nè, mà có thể nói đây là chứa đựng tinh hoa ẩm thực của món tim được luôn.",
      "start": 10.52,
      "end": 20.16,
      "n_words": 36,
      "start_frame": 263,
      "end_frame": 504,
      "keyframes": [
        "000299.webp",
        "000300.webp",
        "000364.webp",
        "000429.webp",
        "000430.webp",
        "000468.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Anh rất là sành điệu nha, biết cả phương pháp chế biến tim luôn.",
      "start": 20.16,
      "end": 24.44,
      "n_words": 14,
      "start_frame": 504,
      "end_frame": 611,
      "keyframes": [
        "000507.webp",
        "000508.webp",
        "000566.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Mà phương pháp hầm tim là gì biết không?",
      "start": 24.44,
      "end": 27.84,
      "n_words": 9,
      "start_frame": 611,
      "end_frame": 696,
      "keyframes": [
        "000624.webp",
        "000625.webp",
        "000646.webp",
        "000667.webp",
        "000668.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thì giống như là mình chưng cách thủy vậy đó, nhưng mà cái thời gian nó lâu hơn, phải không ạ?",
      "start": 27.84,
      "end": 31.64,
      "n_words": 21,
      "start_frame": 696,
      "end_frame": 791,
      "keyframes": [
        "000727.webp",
        "000786.webp",
        "000787.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Cũng đúng, lát chút xíu anh sẽ hướng dẫn cho em kỹ thế nào là phương pháp hầm.",
      "start": 31.64,
      "end": 35.12,
      "n_words": 18,
      "start_frame": 791,
      "end_frame": 878,
      "keyframes": [
        "000832.webp",
        "000877.webp",
        "000878.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Quan trọng là em có biết nấu không nè?",
      "start": 35.12,
      "end": 38.32,
      "n_words": 9,
      "start_frame": 878,
      "end_frame": 958,
      "keyframes": [
        "000878.webp",
        "000907.webp",
        "000936.webp",
        "000937.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khái niệm thì em biết, còn thực hành thì chắc là phải nhờ anh Vũ thôi.",
      "start": 38.32,
      "end": 42.68,
      "n_words": 16,
      "start_frame": 958,
      "end_frame": 1067,
      "keyframes": [
        "001000.webp",
        "001063.webp",
        "001064.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Nếu vậy thì em sẽ theo anh vào bếp, anh sẽ hướng dẫn cho em cũng như khán giả một món hầm hết sức là đặc sắc luôn mà vô cùng dễ làm nha các bạn: chân gà hầm đậu đen thơm ngon bất bại.",
      "start": 42.68,
      "end": 71.4,
      "n_words": 45,
      "start_frame": 1067,
      "end_frame": 1785,
      "keyframes": [
        "001163.webp",
        "001263.webp",
        "001264.webp",
        "001288.webp",
        "001313.webp",
        "001314.webp",
