        "003299.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đậu đen thì chúng ta nên luộc trước.",
      "start": 131.96,
      "end": 133.76,
      "n_words": 8,
      "start_frame": 3299,
      "end_frame": 3344,
      "keyframes": [
        "003299.webp",
        "003300.webp",
        "003301.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thì ở đây thì ba thố thì anh cần khoảng chừng hai muỗng canh đậu đen, chúng ta nên luộc đậu đen trước để sau khi hầm, đậu đen được chín, thấm vị và bùi hơn nha các bạn.",
      "start": 133.76,
      "end": 143.2,
      "n_words": 39,
      "start_frame": 3344,
      "end_frame": 3580,
      "keyframes": [
        "003374.webp",
