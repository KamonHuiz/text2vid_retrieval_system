        "003006.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Sau đó chúng ta cắt lát dày khoảng chừng 5 ly, chúng ta cho loại ra đây củ sen nữa.",
      "start": 121.0,
      "end": 128.56,
