        "002653.webp",
        "002672.webp",
        "002673.webp",
        "002692.webp",
        "002711.webp",
        "002712.webp",
        "002750.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Xả cái nước lạnh để cho mình loại bỏ bớt những cái chất nhờn.",
      "start": 110.12,
      "end": 113.6,
      "n_words": 14,
      "start_frame": 2753,
      "end_frame": 2840,
      "keyframes": [
        "002788.webp",
        "002789.webp",
        "002818.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Giờ chúng ta sẽ tới phần xử lý nguyên liệu thôi.",
      "start": 114.08,
      "end": 117.24,
      "n_words": 11,
      "start_frame": 2852,
      "end_frame": 2931,
      "keyframes": [
        "002876.webp",
        "002903.webp",
        "002904.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tỉa hoa nhanh, anh tỉa hoa nhanh tí xíu như vậy rất là đơn giản như vậy.",
      "start": 117.24,
      "end": 121.0,
      "n_words": 17,
      "start_frame": 2931,
      "end_frame": 3025,
      "keyframes": [
        "002945.webp",
