        "005142.webp",
        "005183.webp",
        "005184.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Rồi biết để nắp lại chúng ta bắt lên chúng ta hầm.",
      "start": 207.44,
      "end": 214.6,
      "n_words": 12,
