        "003511.webp",
        "003575.webp",
        "003576.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Bật anh đây một cái nồi nước anh đã đun nóng sẵn để xíu chúng ta hầm nha.",
      "start": 143.2,
      "end": 146.72,
      "n_words": 18,
      "start_frame": 3580,
      "end_frame": 3668,
      "keyframes": [
        "003654.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Ở đây một cái chảo để chúng ta rang ba tép tỏi, chúng ta đập giập hai cái hoa hồi thôi, hạt tiêu chúng ta cũng cà bể như vậy đó, chúng ta rang không dầu như này.",
      "start": 146.72,
      "end": 156.2,
      "n_words": 38,
      "start_frame": 3668,
      "end_frame": 3905,
      "keyframes": [
        "003732.webp",
        "003733.webp",
        "003818.webp",
        "003904.webp",
        "003905.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "À, anh Vũ ơi, tại sao mình phải rang sơ qua những cái loại gia vị này thế ạ?",
      "start": 156.2,
      "end": 159.72,
      "n_words": 19,
      "start_frame": 3905,
      "end_frame": 3993,
      "keyframes": [
        "003905.webp",
        "003947.webp",
        "003990.webp",
        "003991.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Thưa các bạn, chúng ta nên rang sơ các loại gia vị này: hoa hồi nè, tỏi nè, tiêu nè, như vậy thì món hầm chúng ta mới dậy cái mùi thơm nha các bạn.",
      "start": 159.72,
      "end": 167.64,
      "n_words": 35,
      "start_frame": 3993,
      "end_frame": 4191,
      "keyframes": [
        "004027.webp",
        "004063.webp",
        "004064.webp",
        "004126.webp",
        "004189.webp",
        "004190.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Vừa dậy mùi thơm như vậy thôi, giờ chúng ta sẽ chia phần ra mỗi cái thố đều hai cái chân gà, tỏi nè, chia đều ra tại vì có hai cái thì chúng ta tách ra tí, bỏ đi ít tiêu cũng vậy luôn.",
      "start": 167.64,
      "end": 183.48,
      "n_words": 45,
      "start_frame": 4191,
      "end_frame": 4587,
      "keyframes": [
