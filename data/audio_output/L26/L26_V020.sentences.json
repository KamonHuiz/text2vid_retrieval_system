        "003613.webp",
        "003686.webp",
        "003687.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và bắp này thì chúng ta cũng luộc cho vừa chín rồi và chúng ta rắc lại tí xíu muối.",
      "start": 147.56,
