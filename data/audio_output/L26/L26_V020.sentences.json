        "006892.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Bất cứ lúc nào chúng ta có thể truy cập vào đây để tìm hiểu thêm thật nhiều những công thức nấu ăn ngon hấp dẫn tại nhà.",
      "start": 281.04,
      "end": 286.44,
      "n_words": 28,
      "start_frame": 7026,
      "end_frame": 7161,
      "keyframes": [
        "007074.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Chúc các bạn thành công và luôn luôn có những món ngon với Món ngon mỗi ngày.",
      "start": 286.44,
