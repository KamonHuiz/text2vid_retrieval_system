        "005435.webp",
        "005480.webp",
        "005481.webp"
      ],
      "keyframe_count": 17
    },
    {
      "text": "Gắp một miếng tim vào đây nè, rồi mình cho thêm một ít đậu bắp đó.",
      "start": 221.32,
      "end": 229.0,
      "n_words": 16,
      "start_frame": 5533,
      "end_frame": 5725,
      "keyframes": [
        "005544.webp",
