        "006131.webp",
        "006132.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ mà với cái món này nha đảm bảo luôn là từ chủ đến khách đến tất cả các thành viên trong gia đình đều thích luôn, nên mọi người hãy chuẩn bị để thết đãi mọi người vào dịp cuối tuần nha.",
      "start": 245.28,
      "end": 254.2,
      "n_words": 44,
      "start_frame": 6132,
      "end_frame": 6355,
      "keyframes": [
        "006132.webp",
        "006186.webp",
        "006241.webp",
        "006242.webp",
        "006307.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cảm ơn anh Vũ.",
      "start": 254.2,
      "end": 255.0,
      "n_words": 4,
      "start_frame": 6355,
      "end_frame": 6375,
      "keyframes": [
        "006373.webp",
        "006374.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Và thưa các bạn, để đạt được hiệu quả dinh dưỡng hơn thì chúng ta có thể kết hợp món ăn này cùng với thực đơn tham khảo như sau.",
