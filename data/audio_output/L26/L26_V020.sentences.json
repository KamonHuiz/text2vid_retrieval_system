        "000959.webp"
      ],
      "keyframe_count": 25
    },
    {
      "text": "Rất vui khi được gặp lại quý vị khán giả đang xem chương trình Món ngon mỗi ngày, nấu chỗ ăn lành.",
      "start": 38.56,
