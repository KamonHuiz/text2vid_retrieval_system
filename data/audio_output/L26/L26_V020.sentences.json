        "002530.webp",
        "002598.webp",
        "002599.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Và thưa các bạn, chúng ta ướp đầu tiên trong đây là hành tím với lại tỏi băm cho vào đây khoảng hai loại khoảng một muỗng canh, một muỗng canh, một muỗng cà phê, một muỗng cà phê dầu hào một muỗng canh sữa đặc có đường.",
      "start": 104.2,
      "end": 117.8,
      "n_words": 48,
      "start_frame": 2605,
      "end_frame": 2945,
      "keyframes": [
        "002626.webp",
        "002654.webp",
        "002655.webp",
        "002689.webp",
        "002723.webp",
        "002724.webp",
        "002754.webp",
        "002784.webp",
