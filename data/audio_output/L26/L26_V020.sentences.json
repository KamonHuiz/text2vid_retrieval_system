        "001923.webp",
        "001936.webp",
        "001950.webp",
        "001951.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Và thưa các bạn, món ngày hôm nay có tên gọi là tim heo nướng ngũ vị.",
      "start": 78.04,
      "end": 81.44,
      "n_words": 17,
      "start_frame": 1951,
      "end_frame": 2036,
      "keyframes": [
        "001951.webp",
        "001993.webp",
        "002036.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Theo các chuyên gia dinh dưỡng, món này toàn hỗ trợ giảm khối mỡ.",
      "start": 81.44,
      "end": 84.92,
      "n_words": 14,
      "start_frame": 2036,
      "end_frame": 2123,
      "keyframes": [
        "002036.webp",
        "002037.webp",
        "002083.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Thường tim heo này chúng ta cần mổ quả rồi bây giờ chúng ta cắt lát và chúng ta cắt dọc theo cái quả tim như vậy.",
      "start": 84.92,
      "end": 91.2,
      "n_words": 27,
      "start_frame": 2123,
      "end_frame": 2280,
      "keyframes": [
        "002129.webp",
        "002130.webp",
        "002218.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Với lại cái món này mình dùng tim heo thì đây là một cái bộ phận mà có rất là nhiều đạm nhưng mà lại có rất là ít mỡ, rất phù hợp dành cho những bạn nào mà chúng ta muốn giảm mỡ thừa nè hay là tăng cơ dành cho cơ thể của mình.",
      "start": 91.4,
      "end": 104.2,
      "n_words": 56,
      "start_frame": 2285,
      "end_frame": 2605,
      "keyframes": [
        "002307.webp",
