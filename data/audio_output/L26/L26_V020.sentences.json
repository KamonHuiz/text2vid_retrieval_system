        "003806.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Các bạn thấm gia vị, chúng ta điều chỉnh nhiệt độ khoảng 180 độ.",
      "start": 153.24,
      "end": 157.88,
      "n_words": 14,
