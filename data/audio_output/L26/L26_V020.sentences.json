        "001485.webp",
        "001507.webp",
        "001529.webp",
        "001530.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hôm nay nguyên liệu chúng ta là có tim heo nè, tim heo là thấy cái vẻ cũng bắt mồi nha, rồi chúng ta có đậu bắp nè.",
      "start": 62.16,
      "end": 71.0,
      "n_words": 28,
      "start_frame": 1554,
      "end_frame": 1775,
      "keyframes": [
        "001593.webp",
        "001657.webp",
        "001658.webp",
        "001677.webp",
        "001696.webp",
        "001697.webp",
        "001756.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Và bắp thấy quen quen chưa, cái này là giống như là mình nướng chao phải không anh?",
      "start": 71.0,
      "end": 76.12,
      "n_words": 18,
      "start_frame": 1775,
      "end_frame": 1903,
      "keyframes": [
