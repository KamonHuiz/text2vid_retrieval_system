      "n_words": 30,
      "start_frame": 6375,
      "end_frame": 6612,
      "keyframes": [
        "006434.webp",
        "006494.webp",
        "006495.webp",
        "006557.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Cuối tuần rồi mà vẫn còn loay hoay không biết nấu món gì để thết đãi gia đình và bạn bè của mình, mọi người hãy chọn ngay món ăn của ngày hôm nay: tim heo nướng ngũ vị, đảm bảo tất cả mọi người đều hài lòng. Công thức sẽ luôn có trên YouTube, website và fanpage của chương trình Món ngon mỗi ngày.",
      "start": 264.48,
      "end": 281.04,
      "n_words": 65,
      "start_frame": 6612,
      "end_frame": 7026,
      "keyframes": [
        "006619.webp",
        "006620.webp",
        "006755.webp",
