      "keyframes": [
        "001001.webp",
        "001002.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Azino Việt Nam.",
      "start": 44.88,
      "end": 48.64,
      "n_words": 11,
      "start_frame": 1122,
      "end_frame": 1216,
      "keyframes": [
        "001127.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Em chào anh Dũng, chào Minh Tuấn.",
      "start": 48.64,
      "end": 50.2,
      "n_words": 7,
      "start_frame": 1216,
      "end_frame": 1255,
      "keyframes": [
        "001253.webp",
        "001254.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Lâu lâu hai anh em, hai người đàn ông tụ họp trong một chương trình và vào dịp cuối tuần thì không ai như mình làm cái món gì đó để mình lai rai, mình lai rai nâng chén được không anh? Được chứ.",
      "start": 50.2,
      "end": 62.16,
      "n_words": 44,
      "start_frame": 1255,
      "end_frame": 1554,
      "keyframes": [
        "001280.webp",
