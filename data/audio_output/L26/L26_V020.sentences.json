        "005211.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ chúng ta sẽ cho món ăn ra dĩa đó rồi giờ em thưởng thức anh ha.",
      "start": 209.4,
      "end": 221.32,
