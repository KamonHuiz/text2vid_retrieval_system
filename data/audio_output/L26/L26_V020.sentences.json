        "001846.webp",
        "001847.webp",
        "001884.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Đúng rồi, đây là một món nướng.",
      "start": 76.12,
      "end": 78.04,
      "n_words": 7,
      "start_frame": 1903,
      "end_frame": 1951,
      "keyframes": [
