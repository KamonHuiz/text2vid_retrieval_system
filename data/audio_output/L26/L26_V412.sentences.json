        "001745.webp",
        "001832.webp",
        "001833.webp"
      ],
      "keyframe_count": 21
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 75.92,
      "end": 79.72,
      "n_words": 11,
      "start_frame": 1898,
      "end_frame": 1993,
      "keyframes": [
        "001915.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ mình làm cua, còn Tuấn sẽ làm rau củ nha.",
      "start": 79.72,
      "end": 83.28,
      "n_words": 12,
      "start_frame": 1993,
