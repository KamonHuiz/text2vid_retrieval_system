        "002651.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Xong, cua này khi mà mua về thì mình sẽ sơ chế, mình rửa lại thật là sạch, bỏ phần yếm cua đi.",
      "start": 106.24,
      "end": 111.04,
      "n_words": 23,
      "start_frame": 2656,
      "end_frame": 2776,
