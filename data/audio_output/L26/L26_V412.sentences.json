        "003013.webp",
        "003056.webp",
        "003057.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ cho vào cua một muỗng canh gia vị nêm sẵn, bột chiên giòn.",
      "start": 122.32,
      "end": 127.32,
      "n_words": 16,
