        "003982.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Con cua này thì nó cũng đã chín rồi nè, Long ơi nha, để nó lau dọn Tuấn ha.",
      "start": 159.76,
      "end": 165.6,
