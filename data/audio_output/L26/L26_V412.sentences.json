        "003340.webp",
        "003372.webp",
        "003373.webp",
        "003392.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khi các nguyên liệu đã xong thì bây giờ mình chuẩn bị chiên cua, sẽ chiên ngập dầu nha.",
      "start": 136.36,
      "end": 140.68,
      "n_words": 19,
      "start_frame": 3409,
