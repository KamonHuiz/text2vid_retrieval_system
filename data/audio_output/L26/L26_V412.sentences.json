        "002747.webp",
        "002761.webp",
        "002776.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Trong đây có phần phổi cua nên mình sẽ dùng kéo mình cắt cái viền này đi.",
      "start": 111.04,
      "end": 116.48,
