        "002489.webp",
        "002532.webp",
        "002533.webp"
      ],
      "keyframe_count": 27
    },
    {
      "text": "Tiếp theo thì chúng ta sẽ sơ chế măng.",
      "start": 101.44,
      "end": 104.12,
      "n_words": 9,
      "start_frame": 2536,
      "end_frame": 2603,
      "keyframes": [
        "002563.webp",
        "002594.webp",
        "002595.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ luộc từ nước lạnh và luộc chín kỹ để măng không bị đắng nha.",
      "start": 104.12,
      "end": 107.64,
      "n_words": 17,
      "start_frame": 2603,
      "end_frame": 2691,
      "keyframes": [
        "002642.webp",
        "002690.webp",
        "002691.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Măng đã luộc rồi thì bây giờ chúng ta chỉ cần cắt miếng vừa ăn thôi.",
      "start": 107.64,
      "end": 111.24,
      "n_words": 16,
      "start_frame": 2691,
      "end_frame": 2781,
      "keyframes": [
        "002691.webp",
        "002730.webp",
        "002769.webp",
        "002770.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Đó cái phần gốc này nè cô sẽ cắt ngang để nó không bị dai, không bị cứng, còn cái phần trên này thì cô sẽ cắt dập ở phía trên thì nó non và nó mềm hơn cô.",
      "start": 111.24,
      "end": 120.44,
      "n_words": 39,
      "start_frame": 2781,
      "end_frame": 3011,
      "keyframes": [
