        "002932.webp",
        "002933.webp",
        "002972.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Rồi mình sẽ đập dập ớt hiểm.",
      "start": 120.44,
      "end": 128.28,
      "n_words": 7,
      "start_frame": 3011,
      "end_frame": 3207,
      "keyframes": [
        "003012.webp",
        "003013.webp",
        "003040.webp",
        "003068.webp",
