        "000468.webp",
        "000486.webp",
        "000487.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Được tại vì ngon quá em ăn trước miếng.",
      "start": 20.84,
      "end": 23.6,
      "n_words": 9,
      "start_frame": 521,
      "end_frame": 590,
      "keyframes": [
        "000537.webp",
        "000588.webp",
        "000589.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Người thích ăn măng, mì nó có độ ngọt nè và nó có độ giòn, chính xác, măng ngon quá à.",
      "start": 23.76,
