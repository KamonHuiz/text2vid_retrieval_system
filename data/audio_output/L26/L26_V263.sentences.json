        "005508.webp",
        "005527.webp",
        "005528.webp"
      ],
      "keyframe_count": 19
    },
    {
      "text": "Thì bây giờ đủ thời gian rồi đó, bây giờ em tắt lửa đi. Tắt hả cô?",
      "start": 221.12,
      "end": 225.0,
      "n_words": 17,
      "start_frame": 5528,
      "end_frame": 5625,
      "keyframes": [
        "005528.webp",
        "005566.webp",
        "005604.webp",
        "005605.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tại vì em thấy mình còn một nguyên liệu là lá quế nữa.",
      "start": 225.0,
      "end": 227.48,
      "n_words": 13,
      "start_frame": 5625,
      "end_frame": 5687,
      "keyframes": [
        "005644.webp",
        "005683.webp",
        "005684.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Các bạn lưu ý là lá quế rất là dễ xuống màu cho nên sau khi cắt thì mình sẽ cho vào liền và đảo nhanh với thịt ếch nha.",
