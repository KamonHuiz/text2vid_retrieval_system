        "001146.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Dạ, cơm quê cực mê, vị ít khoăn lá quế.",
      "start": 47.12,
      "end": 66.12,
      "n_words": 10,
      "start_frame": 1178,
      "end_frame": 1653,
