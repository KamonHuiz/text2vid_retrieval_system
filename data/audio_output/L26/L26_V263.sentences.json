        "003104.webp",
        "003152.webp",
        "003201.webp",
        "003202.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Cái phần sơ chế đã xong thì bây giờ chúng ta bắt đầu kho thịt ếch nha.",
      "start": 128.28,
      "end": 131.6,
      "n_words": 17,
      "start_frame": 3207,
      "end_frame": 3290,
      "keyframes": [
        "003244.webp",
        "003287.webp",
        "003288.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Em lấy giùm cô một cái nồi lên trên này nha để cô mở lửa.",
      "start": 131.6,
      "end": 135.92,
      "n_words": 15,
      "start_frame": 3290,
      "end_frame": 3398,
      "keyframes": [
        "003310.webp",
        "003333.webp",
        "003334.webp",
        "003365.webp",
        "003397.webp",
        "003398.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Màu dầu điều cô cho khoảng chừng một muỗng canh, nghệ cắt lát mình sẽ cho vô trong này nha, cho tiếp là hành và tỏi băm vô xào lên cho thơm.",
      "start": 135.92,
      "end": 146.16,
      "n_words": 32,
      "start_frame": 3398,
      "end_frame": 3654,
      "keyframes": [
        "003398.webp",
        "003427.webp",
        "003456.webp",
        "003457.webp",
        "003493.webp",
        "003530.webp",
        "003531.webp",
        "003575.webp",
        "003620.webp",
        "003621.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Đối với món kho thì lúc nào chúng ta cũng có cái phần gia vị là tỏi và hành băm.",
      "start": 146.16,
      "end": 150.28,
      "n_words": 20,
      "start_frame": 3654,
      "end_frame": 3757,
      "keyframes": [
        "003698.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Rồi và ngày hôm nay thì có thêm cả nghệ nữa, cái mùi thơm của nghệ cũng rất là đặc trưng là nó sẽ cho ra màu ha.",
      "start": 150.92,
      "end": 158.36,
      "n_words": 28,
      "start_frame": 3773,
      "end_frame": 3959,
      "keyframes": [
        "003776.webp",
        "003777.webp",
        "003827.webp",
        "003877.webp",
        "003878.webp",
        "003917.webp",
        "003957.webp",
        "003958.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Bây giờ tiếp tục mình sẽ cho cái phần thịt ếch đã ướp vô đây, mình xào cho săn lại.",
      "start": 158.6,
      "end": 166.16,
      "n_words": 20,
      "start_frame": 3965,
      "end_frame": 4154,
      "keyframes": [
        "003999.webp",
        "004040.webp",
        "004041.webp",
        "004098.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khi thịt ếch săn lại á thì bây giờ mình sẽ cho thêm cái phần măng vô và cả cái phần ớt hiểm đập dập vô luôn, đảo cho măng thấm vị khoảng chừng một phút.",
      "start": 166.16,
      "end": 174.56,
      "n_words": 36,
      "start_frame": 4154,
      "end_frame": 4364,
      "keyframes": [
        "004155.webp",
        "004156.webp",
        "004168.webp",
        "004181.webp",
        "004182.webp",
        "004206.webp",
        "004230.webp",
        "004231.webp",
        "004264.webp",
        "004297.webp",
        "004298.webp",
        "004315.webp",
        "004333.webp",
        "004334.webp",
        "004356.webp"
      ],
      "keyframe_count": 15
    },
    {
      "text": "Bây giờ mình sẽ cho vô là nước, sẽ cho vô là nước dừa tươi khoảng chừng một chén, một chén rưỡi nước dừa tươi vô đây.",
      "start": 174.56,
      "end": 179.2,
      "n_words": 27,
      "start_frame": 4364,
      "end_frame": 4480,
      "keyframes": [
        "004378.webp",
        "004379.webp",
        "004406.webp",
        "004434.webp",
        "004435.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Kho mà sử dụng phần nước dừa tươi để kho thì cái hương vị sẽ rất là ngon cô.",
      "start": 179.2,
      "end": 183.2,
      "n_words": 19,
      "start_frame": 4480,
      "end_frame": 4580,
      "keyframes": [
        "004482.webp",
        "004529.webp",
        "004530.webp",
        "004578.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Hết rồi, hương vị rất là ngon dạ.",
      "start": 183.2,
      "end": 185.08,
      "n_words": 8,
      "start_frame": 4580,
      "end_frame": 4627,
      "keyframes": [
        "004627.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và bây giờ đợi sôi lại và chúng ta sẽ kho thêm trong bao lâu nữa hả cô Hà?",
      "start": 185.08,
      "end": 189.28,
      "n_words": 19,
      "start_frame": 4627,
      "end_frame": 4732,
      "keyframes": [
        "004627.webp",
        "004628.webp",
        "004675.webp",
        "004723.webp",
        "004724.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Chúng ta sẽ kho với lửa vừa và thỉnh thoảng thì mình sẽ đảo để cho cái phần ếch nó nằm ở bên dưới nó chín và thấm vị, kho cho đến khi cái nước kho này hơi sánh sánh lại.",
      "start": 189.28,
      "end": 197.96,
      "n_words": 41,
      "start_frame": 4732,
      "end_frame": 4949,
      "keyframes": [
        "004748.webp",
        "004772.webp",
        "004773.webp",
        "004822.webp",
        "004871.webp",
        "004872.webp",
        "004910.webp",
        "004949.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Thế cô Hà ơi khi mà chúng ta lựa chọn thịt ếch á cần có những cái lưu ý gì không cô?",
      "start": 197.96,
      "end": 202.56,
      "n_words": 22,
      "start_frame": 4949,
      "end_frame": 5064,
      "keyframes": [
        "004949.webp",
        "004950.webp",
        "005006.webp",
        "005062.webp",
        "005063.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Thì những cái con ếch nó có thịt trong và nó bóng bẩy và nó căng thì sẽ là ếch ngon dạ.",
      "start": 202.56,
      "end": 208.16,
      "n_words": 22,
      "start_frame": 5064,
      "end_frame": 5204,
      "keyframes": [
        "005094.webp",
        "005125.webp",
        "005126.webp",
        "005164.webp",
        "005203.webp",
        "005204.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thịt ếch thì có rất là nhiều chất dinh dưỡng đặc biệt là protein rất là cao, thịt ếch thì nó vừa ngon dễ ăn và nó cũng dễ dàng hấp thu phù hợp cho trẻ con nè hoặc là những người lớn tuổi thì ăn nó rất là tốt.",
      "start": 208.16,
      "end": 221.12,
      "n_words": 50,
      "start_frame": 5204,
      "end_frame": 5528,
      "keyframes": [
        "005204.webp",
        "005231.webp",
        "005258.webp",
        "005259.webp",
        "005284.webp",
        "005310.webp",
        "005311.webp",
        "005355.webp",
