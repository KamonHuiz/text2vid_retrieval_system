        "000408.webp",
        "000409.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Em chào cô, ngon quá mà không rủ sao? Mà em không rủ cô hả?",
      "start": 16.48,
      "end": 20.84,
      "n_words": 15,
