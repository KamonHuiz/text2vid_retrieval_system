        "002028.webp",
        "002045.webp",
        "002046.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Ở đây là cô Hà dùng ớt hiểm hả cô?",
      "start": 83.24,
      "end": 85.52,
      "n_words": 10,
      "start_frame": 2081,
      "end_frame": 2138,
      "keyframes": [
        "002097.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi.",
