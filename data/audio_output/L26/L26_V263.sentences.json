      "end": 86.04,
      "n_words": 2,
      "start_frame": 2138,
      "end_frame": 2151,
      "keyframes": [
        "002148.webp",
        "002149.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng ta sẽ ướp thêm một muỗng cà phê bột ngọt Ajinomoto, nửa muỗng canh hạt nêm Aji-ngon heo, một muỗng canh đường, cô cho khoảng chừng 1/3 muỗng cà phê tiêu thôi, cho thêm một muỗng canh nước mắm, trộn đều lên sẽ để thấm khoảng chừng 15 cho đến 30 phút.",
      "start": 86.04,
      "end": 101.44,
      "n_words": 53,
      "start_frame": 2151,
      "end_frame": 2536,
      "keyframes": [
        "002174.webp",
