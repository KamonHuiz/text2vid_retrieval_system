        "000851.webp",
        "000900.webp",
        "000901.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Dễ đây: \"Con gà cục tác lá chanh\", đúng không ạ? Chính xác!",
      "start": 36.2,
      "end": 41.32,
      "n_words": 13,
