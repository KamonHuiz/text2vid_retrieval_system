      "end_frame": 605,
      "keyframes": [
        "000600.webp",
        "000601.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Vì Quốc Nghị có một thử thách dành cho Thanh Phương ngày hôm nay.",
      "start": 24.2,
      "end": 27.28,
      "n_words": 14,
