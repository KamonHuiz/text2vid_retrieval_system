      "end_frame": 1910,
      "keyframes": [
        "001831.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ Quốc Nghị sẽ hướng dẫn các bạn cùng Thanh Phương sơ chế cái phần cánh gà này.",
      "start": 76.4,
