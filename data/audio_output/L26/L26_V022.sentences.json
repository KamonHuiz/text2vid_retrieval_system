      "end": 51.88,
      "n_words": 9,
      "start_frame": 1224,
      "end_frame": 1297,
      "keyframes": [
        "001248.webp",
        "001274.webp",
        "001275.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Đi biển về em có nghêu cho anh, nó wow, rất là hợp lý các bạn.",
