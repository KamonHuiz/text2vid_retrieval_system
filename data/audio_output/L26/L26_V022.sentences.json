        "001946.webp",
        "001970.webp",
        "001971.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Rồi bây giờ thì chúng ta sẽ ướp thịt nghêu.",
      "start": 78.84,
      "end": 80.88,
      "n_words": 10,
      "start_frame": 1971,
      "end_frame": 2022,
      "keyframes": [
        "001971.webp",
        "002008.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Thưa các bạn, món này chúng ta có thể thay bằng thịt nghêu tươi luộc xong gỡ lấy thịt thì cũng rất là phù hợp.",
      "start": 80.88,
      "end": 86.56,
      "n_words": 25,
      "start_frame": 2022,
      "end_frame": 2164,
      "keyframes": [
        "002045.webp",
        "002046.webp",
        "002104.webp",
        "002163.webp",
        "002164.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ướp ở đây một muỗng canh đường, một muỗng cà phê bột ngọt Ajinomoto, bốn muỗng canh nước tương Phú Sĩ.",
