        "003601.webp",
        "003602.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Chúng ta cho nghêu vào kho luôn như vậy, chúng ta kho lửa liu riêu ha các bạn, cho cái nước kho nó rút lại.",
      "start": 144.16,
      "end": 152.0,
      "n_words": 25,
