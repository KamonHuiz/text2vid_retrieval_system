        "001354.webp",
        "001386.webp",
        "001387.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Nhưng mà em có yêu cầu là không có hấp thường, xào thường, giờ mình kho đi anh.",
      "start": 55.64,
      "end": 62.44,
