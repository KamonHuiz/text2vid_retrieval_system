      "start_frame": 3089,
      "end_frame": 3130,
      "keyframes": [
        "003109.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Dầu nóng chúng ta sẽ cho hành tím, tỏi băm, đầu hành lá băm, cần băm thả vào đây, ớt khô luôn các bạn.",
      "start": 125.2,
