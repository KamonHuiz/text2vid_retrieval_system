      "keyframes": [
        "002545.webp",
        "002546.webp",
        "002609.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Ớt khô thì chúng ta cắt rồi làm đôi như vậy hoặc làm ba.",
      "start": 106.88,
      "end": 111.36,
      "n_words": 14,
      "start_frame": 2672,
      "end_frame": 2784,
      "keyframes": [
        "002673.webp",
