        "001480.webp",
        "001544.webp",
        "001545.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Kho nghe lạ lạ thì chúng ta sẽ làm món nghêu kho nước tương.",
      "start": 62.44,
      "end": 66.16,
      "n_words": 14,
