      "end": 115.0,
      "n_words": 11,
      "start_frame": 2784,
      "end_frame": 2875,
      "keyframes": [
        "002840.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Như vậy chúng ta cắt một cao bề bảng, cao bề bảng như vậy.",
