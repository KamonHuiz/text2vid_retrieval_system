        "002496.webp",
        "002497.webp",
        "002521.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cải ngọt chúng ta cắt khúc khoảng chừng 6 centimet phần lá và phần thân.",
      "start": 101.68,
      "end": 106.88,
