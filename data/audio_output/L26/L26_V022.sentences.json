      "end_frame": 1201,
      "keyframes": [
        "001191.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đây em tươi mới không?",
      "start": 48.04,
      "end": 48.96,
      "n_words": 5,
      "start_frame": 1201,
      "end_frame": 1224,
      "keyframes": [
        "001222.webp",
        "001223.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Trời ơi mới đi biển về ạ, nở nở.",
