        "001243.webp",
        "001273.webp",
        "001274.webp",
        "001329.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ Thanh Phương sẽ cắt lát rồi sau đó thái sợi đó nha.",
