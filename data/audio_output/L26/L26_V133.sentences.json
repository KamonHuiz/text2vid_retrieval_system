        "005806.webp",
        "005824.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Các bạn lưu ý chúng ta nướng lửa vừa để cuộn ốc chín tận vào bên trong nha.",
      "start": 233.68,
