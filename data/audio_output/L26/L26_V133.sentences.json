        "004921.webp",
        "004922.webp",
        "004944.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "- Xong rồi đó.",
      "start": 197.92,
      "end": 198.88,
      "n_words": 4,
      "start_frame": 4948,
      "end_frame": 4972,
      "keyframes": [
        "004967.webp",
        "004968.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Tiếp theo thì chúng ta sẽ làm một công đoạn rất là quan trọng của món ăn này là pha nước chấm.",
      "start": 198.88,
      "end": 202.96,
      "n_words": 22,
      "start_frame": 4972,
      "end_frame": 5074,
      "keyframes": [
        "004997.webp",
        "005026.webp",
        "005027.webp",
        "005049.webp",
        "005072.webp",
        "005073.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Mình sẽ cho hai muỗng canh nước tương Phú Sĩ, hai muỗng canh tương ớt, một muỗng cà phê gừng băm, mình trộn đều lên.",
      "start": 202.96,
      "end": 213.32,
      "n_words": 25,
      "start_frame": 5074,
      "end_frame": 5333,
      "keyframes": [
        "005110.webp",
        "005147.webp",
        "005148.webp",
        "005174.webp",
        "005200.webp",
