        "003149.webp",
        "003182.webp",
        "003183.webp",
        "003212.webp",
        "003241.webp",
        "003242.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "Là chả lá lốt cho nên chúng ta sẽ sử dụng những cái lá lốt nhỏ nhỏ đó, mình sẽ cắt ra khoảng chừng nửa chén như thế này, mình trộn vô thì phần nhân mình sẽ thơm rất là đặc biệt.",
      "start": 129.92,
      "end": 138.16,
      "n_words": 42,
      "start_frame": 3248,
      "end_frame": 3454,
      "keyframes": [
        "003300.webp",
        "003358.webp",
        "003359.webp",
        "003406.webp",
        "003453.webp",
        "003454.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Cho vào đây nửa muỗng cà phê hạt nêm Aji-goma ngon heo, một muỗng cà phê đường, một muỗng cà phê nước tương kusi.",
      "start": 138.16,
      "end": 144.8,
      "n_words": 24,
      "start_frame": 3454,
      "end_frame": 3620,
      "keyframes": [
        "003454.webp",
