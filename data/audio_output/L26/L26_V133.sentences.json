      "end": 48.16,
      "n_words": 27,
      "start_frame": 999,
      "end_frame": 1204,
      "keyframes": [
        "001080.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và như tất cả quý vị và các bạn biết thì ốc bươu là một nguyên liệu có chứa nhiều canxi, bên cạnh đó còn bổ sung protein và mangan nữa, rất là tốt cho xương và đặc biệt là các bạn nhỏ ăn thì sẽ tăng trưởng được chiều cao, đúng không cô Hà?",
      "start": 48.16,
      "end": 61.76,
      "n_words": 55,
      "start_frame": 1204,
      "end_frame": 1544,
      "keyframes": [
        "001273.webp",
