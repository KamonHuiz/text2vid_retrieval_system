        "006154.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Phết dầu hành lên như vậy là bây giờ các cuốn chả lá lốt chín hết rồi đó.",
      "start": 246.6,
      "end": 253.4,
