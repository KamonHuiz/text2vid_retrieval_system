        "004100.webp",
        "004137.webp",
        "004138.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mỗi một cuốn lá lốt thì mình cho vô khoảng chừng nửa muỗng canh như thế này, sau đó mình gấp hai đầu lại và mình cuốn thôi.",
      "start": 165.52,
      "end": 173.44,
      "n_words": 28,
      "start_frame": 4138,
      "end_frame": 4336,
      "keyframes": [
        "004138.webp",
        "004193.webp",
        "004249.webp",
        "004250.webp",
        "004295.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Sau đó thì mình sẽ ghim vào trong cái que này.",
      "start": 173.44,
      "end": 176.16,
      "n_words": 11,
      "start_frame": 4336,
      "end_frame": 4404,
      "keyframes": [
        "004340.webp",
        "004341.webp",
        "004370.webp",
        "004399.webp",
        "004400.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Khi mình xiên đó thì mình sẽ để cái phần lá này bên trong chút nữa, mình ụp thêm một cái phần mép lá này vô nữa thì là nó ổn thôi, làm từ từ cho nó đẹp, nó đều ha.",
      "start": 176.16,
      "end": 188.72,
      "n_words": 41,
      "start_frame": 4404,
      "end_frame": 4718,
      "keyframes": [
        "004496.webp",
        "004593.webp",
        "004594.webp",
        "004619.webp",
        "004645.webp",
        "004646.webp",
        "004700.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "- Dạ thảo xong chưa cô?",
      "start": 188.72,
      "end": 197.92,
      "n_words": 6,
      "start_frame": 4718,
      "end_frame": 4948,
      "keyframes": [
