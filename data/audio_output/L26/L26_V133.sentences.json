        "003525.webp",
        "003526.webp",
        "003546.webp",
        "003567.webp",
        "003568.webp",
        "003601.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Chúng ta sẽ trộn đều tất cả các nguyên liệu của phần nhân này lại.",
      "start": 145.48,
      "end": 152.12,
      "n_words": 15,
      "start_frame": 3637,
      "end_frame": 3803,
      "keyframes": [
        "003678.webp",
        "003721.webp",
        "003722.webp",
        "003767.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ thì chúng ta sẽ tiếp tục đến công đoạn tạo hình, tức là cuốn chả.",
      "start": 152.12,
      "end": 156.36,
      "n_words": 17,
      "start_frame": 3803,
      "end_frame": 3909,
      "keyframes": [
        "003812.webp",
        "003813.webp",
        "003862.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ chúng ta sẽ dùng lại những cái lá lốt to mình sẽ cuốn ha.",
      "start": 156.36,
      "end": 159.36,
      "n_words": 16,
      "start_frame": 3909,
      "end_frame": 3984,
      "keyframes": [
        "003911.webp",
        "003912.webp",
        "003948.webp",
        "003984.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Khi cuốn thì mình sẽ đặt một cái lá lốt và cái phần lá đậm thì xuống bên dưới ha.",
      "start": 159.36,
      "end": 165.52,
