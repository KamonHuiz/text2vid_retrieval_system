        "005290.webp",
        "005315.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Khi ăn thì chúng ta sẽ thêm đồ chua gồm củ cà rốt và củ cải trắng ngâm với giấm đường.",
      "start": 213.32,
      "end": 220.88,
      "n_words": 21,
      "start_frame": 5333,
      "end_frame": 5522,
      "keyframes": [
