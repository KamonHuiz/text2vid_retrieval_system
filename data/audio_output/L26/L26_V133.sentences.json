        "001416.webp",
        "001499.webp",
        "001500.webp",
        "001526.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và đặc biệt ốc bươu ăn nó có cái độ giòn sần sật rất là ngon.",
      "start": 61.76,
      "end": 65.28,
      "n_words": 16,
      "start_frame": 1544,
      "end_frame": 1632,
      "keyframes": [
        "001552.webp",
        "001553.webp",
        "001592.webp",
        "001631.webp",
        "001632.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Ốc chúng ta mua về rửa cho sạch nhớt, sau đó thì mình sẽ cắt vừa thôi để khi ăn còn cảm nhận được vị ốc nhé.",
      "start": 65.28,
      "end": 72.52,
      "n_words": 27,
      "start_frame": 1632,
      "end_frame": 1813,
      "keyframes": [
        "001632.webp",
        "001652.webp",
        "001673.webp",
        "001674.webp",
        "001695.webp",
        "001716.webp",
