        "001735.webp",
        "001753.webp",
        "001754.webp",
        "001782.webp",
        "001810.webp",
        "001811.webp"
      ],
      "keyframe_count": 13
    },
    {
      "text": "Bây giờ thì mình sẽ ướp gia vị vào ốc.",
      "start": 72.52,
      "end": 74.76,
      "n_words": 10,
      "start_frame": 1813,
      "end_frame": 1869,
      "keyframes": [
        "001840.webp",
        "001869.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cô sẽ cho vào đây một muỗng cà phê gừng băm.",
      "start": 74.76,
      "end": 78.32,
      "n_words": 11,
      "start_frame": 1869,
      "end_frame": 1958,
      "keyframes": [
        "001869.webp",
        "001870.webp",
        "001918.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Phần mỡ, chúng ta sẽ sử dụng mỡ khổ hoặc là mỡ gáy, mình sẽ luộc qua sau đó mình cắt nhỏ như thế này.",
      "start": 78.32,
      "end": 85.12,
      "n_words": 25,
      "start_frame": 1958,
      "end_frame": 2128,
      "keyframes": [
        "001967.webp",
        "001968.webp",
        "002020.webp",
        "002073.webp",
        "002074.webp",
        "002104.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Và để cho phần mỡ được trong ngon thì mình sẽ ướp vào một muỗng cà phê đường.",
      "start": 85.12,
      "end": 90.08,
      "n_words": 18,
