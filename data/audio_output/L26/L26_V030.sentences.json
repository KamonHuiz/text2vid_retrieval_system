        "003138.webp",
        "003151.webp",
        "003152.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Cho vào đây một ít dầu, chúng ta nhúng từng miếng phi lê cá này qua hỗn hợp trứng đó.",
      "start": 126.6,
      "end": 133.92,
      "n_words": 20,
      "start_frame": 3165,
      "end_frame": 3348,
      "keyframes": [
        "003185.webp",
