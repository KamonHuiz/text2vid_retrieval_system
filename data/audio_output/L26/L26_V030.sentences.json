      "end_frame": 1018,
      "keyframes": [
        "000891.webp",
        "000892.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam. Em chào anh Vũ.",
      "start": 40.72,
      "end": 45.96,
      "n_words": 15,
      "start_frame": 1018,
      "end_frame": 1149,
      "keyframes": [
        "001032.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bây giờ người ta có cái xu hướng là \"cơm lười\", có nghĩa là cơm mà phải nấu nhanh hay là dùng những cái nguyên liệu gì đó mà nó dễ tìm.",
      "start": 46.32,
      "end": 53.04,
      "n_words": 32,
      "start_frame": 1158,
      "end_frame": 1326,
      "keyframes": [
        "001173.webp",
