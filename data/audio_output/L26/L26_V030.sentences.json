        "003027.webp",
        "003028.webp",
        "003051.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Thưa các bạn, ngay bây giờ thì chúng ta sẽ tới phần chiên cá.",
      "start": 122.72,
      "end": 126.6,
      "n_words": 14,
