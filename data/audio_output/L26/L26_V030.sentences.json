        "002777.webp",
        "002778.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Cho phần hành lá và ngò rí, chúng ta đánh tan trứng, cho vào đây khoảng hai muỗng canh bột mì.",
      "start": 111.12,
      "end": 122.72,
