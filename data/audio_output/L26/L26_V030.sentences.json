        "003554.webp",
        "003582.webp",
        "003583.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Đối với miếng cá này thì khoảng độ chừng 10 phút là cá chúng ta sẽ chín.",
      "start": 143.44,
      "end": 147.88,
      "n_words": 17,
      "start_frame": 3586,
      "end_frame": 3697,
      "keyframes": [
        "003661.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Áp chảo cá với lửa vừa để cá không bị ngấm dầu và chín kỹ bên trong nha các bạn.",
      "start": 147.88,
      "end": 154.56,
      "n_words": 20,
      "start_frame": 3697,
      "end_frame": 3864,
      "keyframes": [
