        "002340.webp",
        "002364.webp",
        "002365.webp"
      ],
      "keyframe_count": 14
    },
    {
      "text": "Cho vào đây một ít nước cốt chanh như vậy thì cá sẽ không bị tanh nha các bạn.",
      "start": 94.6,
      "end": 97.8,
      "n_words": 19,
      "start_frame": 2365,
      "end_frame": 2445,
      "keyframes": [
        "002365.webp",
        "002404.webp",
        "002444.webp",
        "002445.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Bây giờ chúng ta sẽ làm cái hỗn hợp trứng để chúng ta tẩm từng miếng cá vô.",
      "start": 97.8,
      "end": 102.12,
      "n_words": 18,
      "start_frame": 2445,
      "end_frame": 2553,
      "keyframes": [
        "002445.webp",
        "002502.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chúng ta chia nha, chúng ta cần ở đây hai quả trứng gà, nêm vào đây một muỗng cà phê hạt nêm Aji-ngon, khoảng nửa muỗng cà phê tiêu trắng xay.",
      "start": 102.12,
