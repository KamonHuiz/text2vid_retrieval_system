        "001197.webp",
        "001220.webp",
        "001221.webp",
        "001257.webp",
        "001293.webp",
        "001294.webp",
        "001310.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Anh chỉ cho em một cái món đại loại như vậy để em làm nhanh ở nhà được không?",
      "start": 53.04,
      "end": 56.08,
      "n_words": 19,
      "start_frame": 1326,
      "end_frame": 1402,
      "keyframes": [
        "001327.webp",
