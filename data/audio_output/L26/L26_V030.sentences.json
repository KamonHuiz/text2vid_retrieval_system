        "004776.webp",
        "004777.webp",
        "004827.webp"
      ],
      "keyframe_count": 19
    },
    {
      "text": "Món ăn đã hoàn thành rồi.",
      "start": 194.88,
      "end": 195.96,
      "n_words": 6,
      "start_frame": 4872,
      "end_frame": 4899,
      "keyframes": [
        "004878.webp",
        "004879.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Bây giờ cho anh biết, bé Tuấn ơi, anh cảm nhận món này như thế nào?",
      "start": 195.96,
      "end": 199.76,
      "n_words": 16,
      "start_frame": 4899,
      "end_frame": 4994,
      "keyframes": [
        "004942.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Bé Tuấn à, một cái món mà đầy đủ hả mọi người, thấy là áo vàng bên ngoài và bên ngoài là sốt Mayonnaise Ajinomoto vị nguyên bản.",
      "start": 199.76,
      "end": 206.52,
      "n_words": 28,
      "start_frame": 4994,
