        "001362.webp",
        "001396.webp",
        "001397.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Được, cái này là cực kỳ nhanh luôn.",
      "start": 56.08,
      "end": 57.84,
      "n_words": 8,
      "start_frame": 1402,
      "end_frame": 1446,
      "keyframes": [
        "001420.webp",
        "001444.webp",
        "001445.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Món ngày hôm nay của chúng ta có tên gọi là cá basa phi lê chiên trứng.",
      "start": 57.84,
      "end": 61.64,
      "n_words": 17,
      "start_frame": 1446,
      "end_frame": 1541,
      "keyframes": [
        "001492.webp",
        "001540.webp",
        "001541.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Theo chuyên gia dinh dưỡng Tiến sĩ Đào Thị Yến Phi thì món ngày hôm nay của chúng ta sẽ hỗ trợ xây dựng khối cơ xương.",
      "start": 61.64,
      "end": 68.36,
      "n_words": 27,
      "start_frame": 1541,
      "end_frame": 1709,
      "keyframes": [
        "001541.webp",
        "001573.webp",
        "001605.webp",
        "001606.webp",
        "001657.webp",
        "001708.webp",
        "001709.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Bây giờ chúng ta sẽ chuẩn bị phần gia vị để ướp cá: 2-3 nhánh hành lá đập dập phần gốc sau đó cắt nhỏ, chúng ta cho vô tô để chúng ta ướp cá.",
      "start": 68.36,
      "end": 79.04,
      "n_words": 35,
      "start_frame": 1709,
      "end_frame": 1976,
      "keyframes": [
        "001709.webp",
        "001748.webp",
        "001787.webp",
        "001788.webp",
        "001882.webp",
        "001976.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần lá của hành lá và ngò rí chúng ta cắt nhỏ.",
      "start": 79.04,
      "end": 82.2,
      "n_words": 12,
      "start_frame": 1976,
      "end_frame": 2055,
      "keyframes": [
        "001976.webp",
        "001977.webp",
        "002016.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Và phần cá phi lê chúng ta cắt ra thành những miếng vừa ăn rồi mình cho vô.",
      "start": 82.2,
      "end": 88.72,
      "n_words": 18,
      "start_frame": 2055,
      "end_frame": 2218,
      "keyframes": [
        "002056.webp",
        "002057.webp",
        "002117.webp",
        "002177.webp",
        "002178.webp",
        "002200.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Chúng ta ướp vào đây một muỗng cà phê hạt nêm Aji-ngon, khoảng một muỗng cà phê nước cốt chanh.",
      "start": 88.72,
      "end": 94.6,
      "n_words": 20,
      "start_frame": 2218,
      "end_frame": 2365,
      "keyframes": [
        "002222.webp",
