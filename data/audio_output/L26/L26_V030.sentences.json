        "005135.webp",
        "005160.webp",
        "005161.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Anh mà ăn món này hả, anh phải bắt vài tương ớt nữa.",
      "start": 206.52,
      "end": 209.72,
      "n_words": 13,
      "start_frame": 5163,
      "end_frame": 5243,
      "keyframes": [
        "005215.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn, cái phần cá bên ngoài nó giòn, ở bên trong nó rất là mọng nước luôn.",
      "start": 209.72,
      "end": 216.16,
      "n_words": 18,
      "start_frame": 5243,
      "end_frame": 5404,
      "keyframes": [
        "005270.webp",
