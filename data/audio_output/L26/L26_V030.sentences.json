        "003958.webp",
        "003959.webp",
        "004040.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thế là chúng ta đã hoàn thành xong.",
      "start": 163.08,
      "end": 164.88,
      "n_words": 8,
      "start_frame": 4077,
      "end_frame": 4122,
      "keyframes": [
        "004122.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Các bạn thân mến, bên cạnh một chảo cá rất hấp dẫn này thì chúng ta sẽ có một mã QR, các bạn quét mã này để ngay lập tức chúng ta sẽ có công thức món ăn của ngày hôm nay. Mặc dù là công thức rất dễ nhưng mà lâu lâu mình quên thì mình cũng có thể lưu lại công thức này, các bạn lưu lại công thức này các bạn nhé.",
      "start": 164.88,
      "end": 176.32,
      "n_words": 75,
      "start_frame": 4122,
      "end_frame": 4408,
      "keyframes": [
        "004122.webp",
        "004123.webp",
        "004291.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Còn bây giờ thì mình đem ra mình trang trí anh hả.",
      "start": 176.32,
      "end": 180.32,
      "n_words": 12,
      "start_frame": 4408,
      "end_frame": 4508,
      "keyframes": [
        "004459.webp",
        "004460.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Rồi bây giờ thì chúng ta chỉ cần xếp các miếng cá ra một cái đĩa và trang trí thêm với lại cà chua, bắt lên đây một ít sốt Mayonnaise Ajinomoto vị nguyên bản này tạo sự béo béo hấp dẫn cho món ăn nữa.",
      "start": 180.32,
      "end": 194.64,
      "n_words": 46,
      "start_frame": 4508,
      "end_frame": 4866,
      "keyframes": [
        "004509.webp",
