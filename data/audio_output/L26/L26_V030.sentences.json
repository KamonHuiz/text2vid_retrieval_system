        "003301.webp",
        "003331.webp",
        "003332.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Như vậy, chúng ta chở cá qua như vậy.",
      "start": 136.08,
      "end": 143.44,
      "n_words": 9,
      "start_frame": 3402,
      "end_frame": 3586,
      "keyframes": [
        "003413.webp",
