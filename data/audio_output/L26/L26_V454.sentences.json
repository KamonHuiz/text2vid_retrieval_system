      "end": 203.68,
      "n_words": 2,
      "start_frame": 5082,
      "end_frame": 5092,
      "keyframes": [
        "005089.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, chúng ta sẽ cho bên dưới nha.",
