      "keyframes": [
        "000299.webp",
        "000300.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Nguyên liệu ngày hôm nay của chúng ta rất là tươi nè, nhìn nè, nhìn nè!",
      "start": 13.56,
      "end": 17.6,
      "n_words": 16,
      "start_frame": 339,
      "end_frame": 440,
      "keyframes": [
        "000368.webp",
        "000437.webp",
        "000438.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Những con hàu rất là mập.",
