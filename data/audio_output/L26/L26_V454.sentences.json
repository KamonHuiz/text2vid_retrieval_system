      "end": 165.84,
      "n_words": 15,
      "start_frame": 4057,
      "end_frame": 4146,
      "keyframes": [
        "004062.webp",
        "004063.webp",
        "004124.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Chúng ta sẽ xay mịn ra luôn rồi.",
      "start": 165.84,
      "end": 175.04,
      "n_words": 8,
      "start_frame": 4146,
      "end_frame": 4376,
      "keyframes": [
