      "keyframes": [
        "003034.webp",
        "003062.webp",
        "003063.webp",
        "003108.webp",
        "003153.webp",
        "003154.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Phần nước trần hàu có gừng và giấm gạo lên men Lisa có tác dụng gì hả Phước Hưng?",
      "start": 126.2,
      "end": 131.04,
      "n_words": 19,
      "start_frame": 3155,
      "end_frame": 3276,
      "keyframes": [
        "003179.webp",
        "003204.webp",
        "003205.webp",
        "003250.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Có chứ Minh Phương, chúng ta sẽ trần hàu nhanh qua nước có gừng nè và giấm gạo lên men Lisa giúp cho hàu giữ được độ ngọt và tăng thêm hương vị đặc trưng hơn.",
      "start": 131.04,
