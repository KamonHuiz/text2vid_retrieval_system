        "004244.webp",
        "004245.webp",
        "004343.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Thơm quá, quá thơm mùi gừng và tỏi nè, và mùi đặc trưng của giấm gạo nữa.",
      "start": 175.04,
      "end": 179.88,
