      "end_frame": 2368,
      "keyframes": [
        "002201.webp",
        "002222.webp",
        "002244.webp",
        "002245.webp",
        "002306.webp",
        "002367.webp",
        "002368.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Phần hành tây thì bây giờ chúng ta sẽ cắt lát mỏng và Phước Hưng cũng đã chuẩn bị sẵn một cái tô nước đá.",
      "start": 94.72,
      "end": 99.16,
      "n_words": 25,
      "start_frame": 2368,
      "end_frame": 2479,
      "keyframes": [
        "002368.webp",
        "002406.webp",
        "002444.webp",
        "002445.webp",
        "002463.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Khi mà các bạn cắt hành tây và củ rá đi, chúng ta ngâm vào nước đá để giúp cho hành tây giảm độ hăng và rá đi thì có độ giòn hơn.",
      "start": 99.16,
      "end": 106.28,
      "n_words": 33,
      "start_frame": 2479,
      "end_frame": 2657,
      "keyframes": [
        "002482.webp",
        "002483.webp",
        "002508.webp",
        "002533.webp",
        "002534.webp",
        "002569.webp",
        "002605.webp",
        "002606.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Mỏng như vậy được chưa Phước?",
      "start": 106.28,
      "end": 107.64,
      "n_words": 6,
      "start_frame": 2657,
      "end_frame": 2691,
      "keyframes": [
        "002669.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Được rồi đó, Minh Phương rất là đẹp luôn, cho vào tô nước đá rồi.",
      "start": 107.64,
      "end": 112.2,
      "n_words": 15,
      "start_frame": 2691,
      "end_frame": 2805,
      "keyframes": [
        "002733.webp",
        "002734.webp",
        "002767.webp",
        "002800.webp",
        "002801.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Cảm ơn Minh Phương quá khéo tay luôn á.",
      "start": 112.2,
      "end": 114.12,
      "n_words": 9,
      "start_frame": 2805,
      "end_frame": 2853,
      "keyframes": [
        "002825.webp",
        "002850.webp",
        "002851.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Bây giờ thì phần nước trần hàu cũng sôi rồi, Phước Hưng cho mở nắp ra nè, cho vào trong cái phần nước trần một ít gừng đập dập.",
      "start": 114.12,
      "end": 120.96,
      "n_words": 29,
