      "start_frame": 1314,
      "end_frame": 1921,
      "keyframes": [
        "001327.webp",
        "001328.webp",
        "001344.webp",
        "001361.webp",
        "001362.webp",
        "001377.webp",
        "001393.webp",
        "001394.webp",
        "001418.webp",
        "001443.webp",
        "001444.webp",
        "001480.webp",
        "001516.webp",
        "001517.webp",
