      "end": 29.44,
      "n_words": 8,
      "start_frame": 646,
      "end_frame": 736,
      "keyframes": [
        "000708.webp",
        "000709.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Không biết giờ đăng lên có ai like không ta?",
      "start": 29.44,
      "end": 32.48,
      "n_words": 10,
      "start_frame": 736,
      "end_frame": 812,
      "keyframes": [
        "000763.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Thôi kệ, đăng đi.",
