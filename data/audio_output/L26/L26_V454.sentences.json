      "end": 21.2,
      "n_words": 6,
      "start_frame": 440,
      "end_frame": 530,
      "keyframes": [
        "000456.webp",
        "000475.webp",
        "000476.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Sao mà mình nói nó không có dễ thương, không có hay bằng mấy bạn trẻ ta?",
      "start": 21.2,
      "end": 25.84,
      "n_words": 17,
      "start_frame": 530,
      "end_frame": 646,
      "keyframes": [
        "000592.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Đúng rồi, tại vì người ta còn trẻ.",
