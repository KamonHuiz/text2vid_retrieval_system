        "001648.webp",
        "001693.webp",
        "001739.webp",
        "001740.webp",
        "001827.webp",
        "001915.webp",
        "001916.webp"
      ],
      "keyframe_count": 23
    },
    {
      "text": "Chào các bạn đang đến với chương trình Món ngon mỗi ngày, chương trình được tài trợ bởi công ty Anoto Việt Nam.",
      "start": 76.84,
      "end": 83.64,
      "n_words": 23,
      "start_frame": 1921,
      "end_frame": 2091,
      "keyframes": [
        "002003.webp",
        "002091.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Đầu tiên thì Phước Hưng sẽ bật lên trên bếp một cái nồi nước để chúng ta trần sơ qua phần hàu.",
      "start": 83.64,
      "end": 88.04,
      "n_words": 22,
      "start_frame": 2091,
      "end_frame": 2201,
      "keyframes": [
        "002091.webp",
        "002092.webp",
        "002124.webp",
        "002157.webp",
        "002158.webp",
        "002179.webp",
        "002200.webp",
        "002201.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Trong khi mà chúng ta đợi nước sôi thì phải nhờ đến Minh Phương, rồi chúng ta sẽ sơ chế cái phần hành tây và củ ráy đi.",
      "start": 88.04,
      "end": 94.72,
      "n_words": 28,
