        "003389.webp",
        "003430.webp",
        "003471.webp",
        "003472.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Trần nhanh sơ qua thôi thì hàu mới còn giữ được độ ngọt.",
      "start": 138.96,
      "end": 142.16,
      "n_words": 13,
      "start_frame": 3474,
      "end_frame": 3554,
      "keyframes": [
        "003513.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Sẽ vớt ra nè, Hưng sẽ cho qua một cái tô nước đá.",
      "start": 142.16,
      "end": 146.48,
      "n_words": 13,
      "start_frame": 3554,
      "end_frame": 3662,
      "keyframes": [
        "003555.webp",
        "003556.webp",
        "003570.webp",
        "003584.webp",
        "003585.webp",
        "003594.webp",
        "003604.webp",
        "003605.webp",
        "003637.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Và bây giờ tiếp theo, Phước Hưng sẽ hướng dẫn cho quý vị chúng ta sẽ xây cái hỗn hợp xốt để mà chúng ta trộn với cái phần salad.",
      "start": 146.48,
