        "000863.webp",
        "000933.webp",
        "000934.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "À, bí đỏ non này đặc biệt là khi mà cô nấu, cô giữ nguyên cái phần vỏ đi.",
      "start": 37.4,
      "end": 41.76,
      "n_words": 19,
