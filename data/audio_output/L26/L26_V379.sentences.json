      "keyframes": [
        "001791.webp",
        "001792.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam.",
      "start": 74.24,
      "end": 78.32,
      "n_words": 11,
