      "n_words": 11,
      "start_frame": 1531,
      "end_frame": 1628,
      "keyframes": [
        "001546.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Và bây giờ mình sẽ chuẩn bị cho phần nhân.",
