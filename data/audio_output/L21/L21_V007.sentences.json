        "017845.webp",
        "017871.webp",
        "017872.webp",
        "017948.webp",
        "018025.webp",
        "018026.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Tác động của biến đổi khí hậu ngày càng trở nên rõ rệt trên thế giới.",
      "start": 601.44,
      "end": 605.12,
      "n_words": 16,
      "start_frame": 18043,
      "end_frame": 18154,
      "keyframes": [
        "018071.webp",
        "018116.webp",
        "018117.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Tại Seoul, Hàn Quốc, nước có khí hậu ôn đới, những người nông dân vừa vui mừng vừa lo lắng khi thấy cây chuối ra hoa và kết trái.",
      "start": 605.12,
      "end": 614.04,
      "n_words": 29,
      "start_frame": 18154,
      "end_frame": 18421,
      "keyframes": [
        "018183.webp",
