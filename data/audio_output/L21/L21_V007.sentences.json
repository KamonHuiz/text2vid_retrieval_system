        "021427.webp",
        "021471.webp",
        "021516.webp",
        "021517.webp",
        "021547.webp",
        "021577.webp",
        "021578.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nắng nóng ở Nhật Bản được dự báo sẽ tiếp tục kéo dài trong tháng 8 này.",
      "start": 719.84,
      "end": 729.84,
      "n_words": 17,
      "start_frame": 21595,
      "end_frame": 21895,
      "keyframes": [
        "021607.webp",
        "021637.webp",
        "021638.webp",
        "021703.webp",
        "021768.webp",
        "021778.webp",
        "021828.webp",
        "021878.webp",
        "021879.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Thủ đô Roma của Italia vừa tổ chức một màn trình diễn ánh sáng kết hợp tuyết nhân tạo phía trước Vương cung thánh đường Đức Bà Cả bất chấp cái nóng của mùa hè.",
      "start": 729.84,
      "end": 738.72,
      "n_words": 35,
      "start_frame": 21895,
      "end_frame": 22162,
      "keyframes": [
        "021930.webp",
        "021981.webp",
        "021982.webp",
        "022017.webp",
        "022052.webp",
        "022053.webp",
        "022086.webp",
        "022119.webp",
        "022120.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nhiều người dân và du khách vẫn đổ về đây để theo dõi buổi biểu diễn mang tên \"Phép màu của Đức Mẹ Tuyết\".",
      "start": 738.72,
      "end": 746.6,
      "n_words": 24,
      "start_frame": 22162,
      "end_frame": 22398,
      "keyframes": [
        "022174.webp",
        "022229.webp",
        "022230.webp",
        "022252.webp",
        "022274.webp",
        "022287.webp",
        "022346.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Theo truyền thuyết, vào đêm 5 tháng 8 năm 358 công nguyên, Đức Mẹ Maria đã xuất hiện trong giấc mơ của Giáo hoàng Liberio lúc bấy giờ và đề nghị ngài xây dựng một nhà thờ tại địa điểm mà Đức Mẹ chỉ định.",
      "start": 750.52,
      "end": 764.32,
      "n_words": 45,
      "start_frame": 22516,
      "end_frame": 22930,
      "keyframes": [
        "022520.webp",
        "022521.webp",
        "022582.webp",
        "022643.webp",
        "022644.webp",
        "022712.webp",
        "022781.webp",
        "022782.webp",
        "022845.webp",
        "022908.webp",
        "022909.webp"
      ],
      "keyframe_count": 11
    },
    {
      "text": "Khi tỉnh dậy, Giáo hoàng đã phát hiện ngọn đồi Esquiline bao phủ trong tuyết ngay giữa tháng 8.",
      "start": 764.32,
      "end": 770.48,
      "n_words": 19,
      "start_frame": 22930,
      "end_frame": 23114,
      "keyframes": [
        "023010.webp",
        "023111.webp",
        "023112.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Kể từ năm 1983 đến nay, cứ vào ngày 5 tháng 8, người ta lại tổ chức màn trình diễn với tuyết nhân tạo để tái hiện câu chuyện trong truyền thuyết. Rạng sáng nay theo giờ Việt Nam, nhóm vũ trang Hamas thông báo đã lựa chọn Yahya Sinwar làm thủ lĩnh chính trị mới của nhóm này.",
      "start": 770.48,
      "end": 790.2,
      "n_words": 59,
      "start_frame": 23114,
      "end_frame": 23706,
      "keyframes": [
        "023179.webp",
        "023246.webp",
        "023247.webp",
        "023363.webp",
        "023479.webp",
        "023480.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Israel vốn cho rằng Sinwar là kẻ chủ mưu thực hiện vụ tấn công vào lãnh thổ Israel ngày 7 tháng 10 năm ngoái.",
      "start": 790.2,
      "end": 796.76,
      "n_words": 24,
      "start_frame": 23706,
      "end_frame": 23903,
      "keyframes": [
        "023721.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Theo truyền thông phương Tây, Sinwar là nhân vật có quan điểm cứng rắn và thân Iran.",
      "start": 796.76,
      "end": 801.44,
      "n_words": 17,
      "start_frame": 23903,
      "end_frame": 24043,
      "keyframes": [
        "023963.webp",
        "023964.webp",
        "024001.webp",
        "024039.webp",
        "024040.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Việc lựa chọn Sinwar làm thủ lĩnh mới cho thấy Hamas sẵn sàng tiếp tục chiến đấu sau vụ ám sát thủ lĩnh chính trị Ismail Haniyeh.",
      "start": 801.44,
      "end": 808.8,
      "n_words": 27,
      "start_frame": 24043,
      "end_frame": 24264,
      "keyframes": [
        "024107.webp",
        "024174.webp",
        "024175.webp",
        "024196.webp",
        "024217.webp",
        "024218.webp",
        "024262.webp"
      ],
      "keyframe_count": 7
    },
    {
      "text": "Quyết định này cũng nhằm khiêu khích Israel vì Sinwar vốn là mục tiêu hàng đầu của nước này trong cuộc chiến ở Gaza.",
      "start": 808.8,
      "end": 815.24,
      "n_words": 24,
      "start_frame": 24264,
      "end_frame": 24457,
      "keyframes": [
        "024306.webp",
        "024307.webp",
        "024322.webp",
        "024337.webp",
        "024338.webp",
        "024389.webp",
        "024440.webp",
        "024441.webp"
      ],
      "keyframe_count": 8
    },
    {
      "text": "Không giống với Haniyeh thường xuyên đi lại giữa Qatar và Thổ Nhĩ Kỳ, Sinwar luôn sống ẩn mình ở dải Gaza. Những thông tin vừa rồi cũng đã kết thúc chương trình 60 giây sáng nay của chúng tôi.",
      "start": 815.24,
      "end": 831.44,
      "n_words": 40,
      "start_frame": 24457,
      "end_frame": 24943,
      "keyframes": [
        "024500.webp",
        "024560.webp",
        "024561.webp",
        "024608.webp",
        "024655.webp",
        "024656.webp",
        "024733.webp",
        "024811.webp",
        "024812.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Hẹn gặp lại quý vị trong chương trình 60 giây chiều nay. Còn bây giờ xin kính chào tạm biệt.",
      "start": 831.44,
      "end": 836.6,
