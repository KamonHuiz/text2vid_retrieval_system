        "020510.webp",
        "020560.webp",
        "020611.webp",
        "020612.webp",
        "020651.webp",
        "020690.webp",
        "020691.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Nhà chức trách cho biết hơn 37.000 người đã phải nhập viện để điều trị sốc nhiệt từ ngày 1 đến ngày 28 tháng 7.",
      "start": 690.4,
      "end": 697.12,
      "n_words": 25,
      "start_frame": 20712,
      "end_frame": 20914,
      "keyframes": [
        "020749.webp",
        "020807.webp",
        "020808.webp",
        "020872.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Người dân và du khách được khuyến cáo uống đủ nước để giảm nguy cơ sốc nhiệt.",
      "start": 697.12,
      "end": 701.88,
      "n_words": 17,
      "start_frame": 20914,
      "end_frame": 21056,
      "keyframes": [
        "020937.webp",
        "020938.webp",
        "020992.webp",
        "021047.webp",
        "021048.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "\"Lúc trước nhiệt độ tối đa chỉ là 35 °C, giờ thì 38 hay 39 là điều bình thường.",
      "start": 701.88,
      "end": 707.92,
      "n_words": 19,
      "start_frame": 21056,
      "end_frame": 21238,
      "keyframes": [
        "021198.webp"
      ],
      "keyframe_count": 1
    },
    {
      "text": "Điều này đã trở thành bình thường mới, tôi thấy rất lo lắng.\"",
      "start": 707.92,
      "end": 711.84,
      "n_words": 13,
      "start_frame": 21238,
      "end_frame": 21355,
      "keyframes": [
        "021349.webp",
        "021350.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Cơ quan khí tượng Nhật Bản cho biết một vùng áp cao tại Thái Bình Dương và không khí nóng thổi từ phía nam là nguyên nhân khiến nhiệt độ tăng cao tại nước này.",
      "start": 711.84,
      "end": 719.84,
      "n_words": 35,
      "start_frame": 21355,
      "end_frame": 21595,
      "keyframes": [
        "021388.webp",
