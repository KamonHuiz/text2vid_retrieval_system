        "018250.webp",
        "018284.webp",
        "018318.webp",
        "018319.webp",
        "018342.webp",
        "018366.webp",
        "018417.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Cây chuối thường mọc ở những vùng nhiệt đới và cận nhiệt đới trên thế giới.",
      "start": 614.04,
      "end": 617.92,
      "n_words": 16,
      "start_frame": 18421,
      "end_frame": 18538,
      "keyframes": [
        "018460.webp",
        "018503.webp",
        "018504.webp",
        "018538.webp"
      ],
      "keyframe_count": 4
    },
    {
      "text": "Tại Hàn Quốc, chuối vốn khó trồng do nước này thuộc vùng ôn đới với bốn mùa rõ rệt.",
      "start": 617.92,
      "end": 623.84,
      "n_words": 19,
      "start_frame": 18538,
      "end_frame": 18715,
      "keyframes": [
        "018538.webp",
        "018573.webp",
        "018574.webp",
        "018616.webp",
        "018659.webp",
        "018660.webp",
        "018669.webp",
        "018679.webp",
        "018680.webp",
        "018709.webp"
      ],
      "keyframe_count": 10
    },
    {
      "text": "\"Chúng tôi đã trồng những cây chuối này được 10 năm và thấy rất tò mò khi nhìn chúng ra trái.",
      "start": 623.84,
      "end": 629.16,
      "n_words": 21,
      "start_frame": 18715,
      "end_frame": 18875,
      "keyframes": [
        "018738.webp",
        "018739.webp",
        "018801.webp",
        "018864.webp",
        "018865.webp"
      ],
      "keyframe_count": 5
    },
    {
      "text": "Tuy nhiên đồng thời tôi cũng cảm thấy cuộc khủng hoảng khí hậu đã trở nên nghiêm trọng hơn.\"",
      "start": 629.16,
      "end": 633.76,
      "n_words": 19,
      "start_frame": 18875,
      "end_frame": 19013,
      "keyframes": [
        "018930.webp",
        "018996.webp",
        "018997.webp"
      ],
      "keyframe_count": 3
    },
    {
      "text": "Theo cơ quan khí tượng Hàn Quốc, kể từ năm 2012 đến nay, nhiệt độ trung bình hàng năm tại nước này có xu hướng ấm lên liên tục.",
      "start": 633.76,
      "end": 641.88,
      "n_words": 29,
      "start_frame": 19013,
      "end_frame": 19256,
      "keyframes": [
        "019029.webp",
        "019061.webp",
        "019062.webp",
        "019087.webp",
        "019113.webp",
        "019114.webp",
        "019148.webp",
        "019183.webp",
        "019184.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Chuối thường mọc ở vùng cận nhiệt nơi có độ ẩm và nhiệt độ cao trong mùa hè, còn trong mùa đông nhiệt độ vẫn ở mức tương đối cao.",
      "start": 641.88,
      "end": 649.36,
      "n_words": 30,
      "start_frame": 19256,
      "end_frame": 19481,
      "keyframes": [
        "019279.webp",
        "019374.webp",
        "019375.webp",
        "019426.webp",
        "019477.webp",
        "019478.webp"
      ],
      "keyframe_count": 6
    },
    {
      "text": "Những cây chuối ra trái ở Seoul cho thấy điều kiện khí hậu ở Hàn Quốc đang trở nên giống các vùng cận nhiệt.",
      "start": 649.36,
      "end": 655.4,
      "n_words": 24,
      "start_frame": 19481,
      "end_frame": 19662,
      "keyframes": [
        "019501.webp",
        "019524.webp",
        "019525.webp",
        "019559.webp",
        "019593.webp",
        "019594.webp",
        "019625.webp",
        "019656.webp",
        "019657.webp"
      ],
      "keyframe_count": 9
    },
    {
      "text": "Theo cơ quan phát triển nông thôn Hàn Quốc, diện tích trồng nông sản cận nhiệt đới ở nước này đã tăng gấp 10 lần từ năm 2021 đến năm 2023, đạt hơn 3.305 ha. Nhật Bản đã ghi nhận nhiệt độ tháng 7 nóng nhất kể từ khi số liệu bắt đầu được thu thập từ năm 1898.",
      "start": 655.4,
      "end": 674.16,
      "n_words": 59,
      "start_frame": 19662,
      "end_frame": 20225,
      "keyframes": [
        "019686.webp",
        "019716.webp",
        "019717.webp",
        "019786.webp",
        "019856.webp",
        "019857.webp",
        "019880.webp",
        "019904.webp",
        "019905.webp",
        "019930.webp",
        "019955.webp",
        "019956.webp",
        "019980.webp",
        "020004.webp",
        "020005.webp",
        "020029.webp",
        "020054.webp",
        "020055.webp"
      ],
      "keyframe_count": 18
    },
    {
      "text": "Nhiều khu vực có mức nhiệt vượt hơn 40 °C vào ban ngày.",
      "start": 675.52,
      "end": 680.16,
      "n_words": 13,
      "start_frame": 20266,
      "end_frame": 20405,
      "keyframes": [
        "020403.webp",
        "020404.webp"
      ],
      "keyframe_count": 2
    },
    {
      "text": "Giới chức thủ đô Tokyo của Nhật Bản cho biết chỉ trong tháng 7 đã ghi nhận 123 người tử vong nghi do sốc nhiệt, hầu hết các nạn nhân đều trên 60 tuổi.",
      "start": 680.16,
      "end": 690.4,
      "n_words": 34,
      "start_frame": 20405,
      "end_frame": 20712,
      "keyframes": [
        "020456.webp",
